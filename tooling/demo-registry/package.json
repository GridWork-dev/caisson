{
  "name": "@caisson-sh/demo-registry",
  "version": "0.2.17",
  "private": true,
  "description": "A private cross-package component-demo registry: one Zod-typed catalog of every @caisson-sh/ui, @caisson-sh/ui-pro, and per-package ./ui surface, with sample data and a live demo renderer per entry. Never published; apps/site's /ui gallery reads it. Kept out of the registry index.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson-sh/ai-meter": "workspace:*",
    "@caisson-sh/audit-harness": "workspace:*",
    "@caisson-sh/audit-worm": "workspace:*",
    "@caisson-sh/local-store": "workspace:*",
    "@caisson-sh/prompt-registry": "workspace:*",
    "@caisson-sh/ui": "workspace:*",
    "@caisson-sh/ui-pro": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson-sh/testing": "workspace:*",
    "@caisson-sh/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
