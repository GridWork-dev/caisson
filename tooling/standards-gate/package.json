{
  "name": "@caisson/standards-gate",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "description": "The ONE standards gate (ADR-0021/0022): license-boundary (AGPL) + down-only dependency + manifest validation. The only registry ingress runs through this.",
  "bin": {
    "caisson-gate": "./src/cli.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "bun test ./src",
    "gate": "bun run ./src/cli.ts"
  },
  "dependencies": {
    "@caisson/registry-schema": "workspace:*",
    "@caisson/tenancy-rls": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson/eslint-config": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "dependency-cruiser": "^16.0.0",
    "eslint": "catalog:",
    "typescript": "^6.0.3"
  }
}
