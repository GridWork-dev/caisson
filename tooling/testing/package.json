{
  "name": "@caisson-sh/testing",
  "version": "0.0.4",
  "private": true,
  "description": "Shared test harness: golden-file regression (BLESS) + the PGlite fail-closed-RLS harness, plus a module golden-fixture contract (golden-module.ts).",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./golden-module": "./golden-module.ts",
    "./module-graph": {
      "bun": "./src/module-graph.ts",
      "types": "./dist/module-graph.d.ts",
      "default": "./dist/module-graph.js"
    }
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "devDependencies": {
    "@caisson-sh/tsconfig": "workspace:*",
    "@electric-sql/pglite": "0.5.4",
    "@types/jsdom": "^28.0.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "axe-core": "^4.12.1",
    "jsdom": "^30.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
