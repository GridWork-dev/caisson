{
  "name": "@caisson/eslint-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The single ESLint standards source (ADR-0002) + the import-boundary rules (ADR-0022). Every package extends index.js.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./boundaries": "./boundaries.js",
    "./boundary-policy.cjs": "./boundary-policy.cjs"
  },
  "scripts": {
    "lint": "echo 'eslint-config: config package, no self-lint'",
    "test": "bun test --timeout 60000 boundaries.test.ts"
  },
  "dependencies": {
    "@eslint/js": "^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "typescript-eslint": "^8.10.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  }
}
