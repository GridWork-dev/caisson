{
  "name": "@caisson-sh/audit-harness",
  "version": "1.0.5",
  "private": true,
  "description": "Cross-domain audit/validate harness (ADR-0134, generalizes ADR-0101): audit surface manifest + append-only reconciling ledger + workflow-scope guard + high-risk /validate spine (Challenger port, majority-kills, default-to-refuted). Internal engineering tooling — NON-BLOCKING, not a sellable module.",
  "license": "Apache-2.0",
  "bin": {
    "audit-harness": "./src/cli.ts"
  },
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": "./src/ui/index.ts"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json && tscn -p tsconfig.ui.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "devDependencies": {
    "@caisson-sh/testing": "workspace:*",
    "@caisson-sh/tsconfig": "workspace:*",
    "@caisson-sh/ui": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@caisson-sh/ui": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@caisson-sh/ui": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
