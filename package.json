{
  "name": "caisson",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "tooling/*",
      "packages/*",
      "apps/*",
      "registry",
      "services/license",
      "services/docs"
    ],
    "catalog": {
      "zod": "^3.23.8",
      "typescript": "^5.7.3",
      "eslint": "^9.13.0",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "pg": "^8.16.0",
      "next": "^16.2.9",
      "lucide-react": "^1.22.0",
      "@types/node": "^22.10.5",
      "@electric-sql/pglite": "^0.5.3",
      "@types/pg": "^8.11.10",
      "@types/bun": "^1.1.14",
      "@aws-sdk/client-s3": "^3.1075.0",
      "culori": "^4.0.1",
      "@types/culori": "^2.1.1",
      "sqlite-vec": "^0.1.9",
      "drizzle-orm": "^0.45.0"
    },
    "catalogs": {
      "zod4": {
        "zod": "^4.0.0"
      }
    }
  },
  "scripts": {
    "build": "turbo run build --no-daemon",
    "lint": "turbo run lint --no-daemon",
    "test": "turbo run test --no-daemon",
    "test:live": "turbo run test:live --no-daemon",
    "test:live:all": "turbo run test:live --no-daemon",
    "eval": "turbo run eval --no-daemon",
    "gate": "bun packages/kernel/src/gate.ts",
    "check": "turbo run build lint test --no-daemon && bun run gate",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "knip": "knip"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@caisson/eslint-config": "workspace:*",
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.13.0",
    "@types/bun": "^1.1.14",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.13.0",
    "knip": "^6.24.0",
    "prettier": "^3.3.3",
    "turbo": "~2.5.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "zod": "^3.23.8"
  },
  "packageManager": "bun@1.3.14"
}
