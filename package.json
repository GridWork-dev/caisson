{
  "name": "stack",
  "private": true,
  "type": "module",
  "workspaces": [
    "tooling/*",
    "packages/*",
    "apps/*",
    "services/license",
    "services/docs"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "gate": "bun packages/kernel/src/gate.ts",
    "check": "turbo run build lint test && bun run gate",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.13.0",
    "@types/bun": "^1.1.14",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0"
  },
  "packageManager": "bun@1.3.14"
}
