{
  "name": "caisson",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": {
    "packages": [
      "tooling/*",
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "zod": "^4.0.0",
      "typescript": "^6.0.3",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "pg": "^8.16.0",
      "next": "^16.3.3",
      "lucide-react": "^1.22.0",
      "@types/node": "^26.0.0",
      "@electric-sql/pglite": "^0.5.3",
      "@types/pg": "^8.11.10",
      "@types/bun": "^1.1.14",
      "@aws-sdk/client-s3": "^3.1075.0",
      "culori": "^4.0.1",
      "@types/culori": "^4.0.1",
      "sqlite-vec": "^0.1.9",
      "drizzle-orm": "^0.45.0"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build --no-daemon",
    "lint": "turbo run lint --no-daemon",
    "lint:repo": "oxlint .",
    "test": "turbo run test --no-daemon",
    "test:e2e": "turbo run test:e2e --no-daemon",
    "test:live": "turbo run test:live --no-daemon --env-mode=loose",
    "test:live:all": "turbo run test:live --no-daemon --env-mode=loose",
    "eval": "turbo run eval --no-daemon",
    "gate": "bun packages/kernel/src/gate.ts",
    "typecheck": "turbo run typecheck --no-daemon",
    "check": "turbo run build lint typecheck test --no-daemon && bun run gate",
    "sot": "bun tooling/scripts/sot-check.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "security:scan": "bash tools/security/scan.sh --layer ci",
    "security:test": "semgrep test tools/security/semgrep-rules/",
    "lint:canary": "bun tooling/scripts/lint-canary.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@caisson/lint-policy": "workspace:*",
    "@changesets/cli": "^2.27.9",
    "@types/bun": "^1.4.0",
    "dependency-cruiser": "^18.2.0",
    "eslint-plugin-storybook": "10.5.10",
    "knip": "^6.32.2",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "turbo": "~2.10.0",
    "typescript": "catalog:",
    "zod": "catalog:",
    "zod-to-json-schema": "^3.24.1"
  },
  "overrides": {
    "@hono/node-server": "^2.0.10",
    "browserslist": "^4.28.7",
    "engine.io": "^6.6.9",
    "fast-uri": "^4.1.3",
    "ip-address": "^10.3.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.18",
    "sharp": "^0.35.4",
    "systeminformation": "^5.31.6",
    "undici": "^7.29.0",
    "valibot": "^1.4.2",
    "ws": "^8.21.0"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "dependency-cruiser@18.2.0": "patches/dependency-cruiser@18.2.0.patch"
  }
}
