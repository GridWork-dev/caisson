# Single source of truth for the pinned security-scanner versions + artifact digests
# (CAISSON-95 — kills the curl|sh-from-a-moving-main-branch installs). Sourced by BOTH
# .github/workflows/security-scan.yml and tools/security/install.sh. Bump a version here and
# refresh its SHA256 from the project's official release checksums file in the SAME commit:
#   trivy       → trivy_<V>_checksums.txt        (asset: trivy_<V>_Linux-64bit.tar.gz)
#   trufflehog  → trufflehog_<V>_checksums.txt   (asset: trufflehog_<V>_linux_amd64.tar.gz)
#   osv-scanner → osv-scanner_SHA256SUMS         (asset: osv-scanner_linux_amd64)
# semgrep installs from PyPI via uv (version-pinned; PyPI wheels carry their own hashes).
SEMGREP_VERSION="1.169.0"
TRIVY_VERSION="0.72.0"
TRIVY_SHA256="bbb64b9695866ce4a7a8f5c9592002c5961cab378577fa3f8a040df362b9b2ea"
TRUFFLEHOG_VERSION="3.95.9"
TRUFFLEHOG_SHA256="f6d1106b85107d79527ed7a5b98b592beadd8b770dc3c9e8c1ad99e1b2cf127e"
OSV_SCANNER_VERSION="2.4.0"
OSV_SCANNER_SHA256="15314940c10d26af9c6649f150b8a47c1262e8fc7e17b1d1029b0e479e8ed8a0"
# zizmor (GitHub Actions workflow auditor, Kickoff T task 2). Asset:
# zizmor-x86_64-unknown-linux-gnu.tar.gz. The project attaches no checksums file to its
# releases — this SHA256 is GitHub's release-asset digest, independently confirmed by
# downloading the artifact and hashing it locally (2026-07-13). Refresh the same way on bump.
ZIZMOR_VERSION="1.26.1"
ZIZMOR_SHA256="8556289a64e7aaf2400cd516f61a471aa91c5902cc56ad96a82fd12f90c2ef73"
