{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba scripts/release-readiness.test.ts'","aggregated_output":"     1\t// Guards the required-check SET itself, not any one gate's logic. REQUIRED_CHECKS is a bare string\n     2\t// list that release-readiness.ts compares against the GitHub check-runs API: a name here that no\n     3\t// workflow defines makes every release \"missing\" that check forever, and a job here that can be\n     4\t// skipped reds readiness on every release whose diff happened not to reach it. Both failures are\n     5\t// silent until a release is already in flight, which is the wrong time to find out.\n     6\t//\n     7\t// Parsed with Bun.YAML, not regex. A first pass matched job KEYS with `^ {2}<name>:` and grepped\n     8\t// for a 4-space `paths:`; the SHIP review defeated it three ways that this repo could plausibly\n     9\t// produce — a `needs: changes` + `if: needs.changes.outputs.x` gate (quality.yml already has that\n    10\t// `changes` job), a `paths:` at 6-space indent under a nested `on:`, and flow-style\n    11\t// `push: { paths: [...] }`. A text heuristic over YAML is the wrong tool when a parser is in hand.\n    12\timport {\n    13\t  mkdtempSync,\n    14\t  mkdirSync,\n    15\t  readdirSync,\n    16\t  readFileSync,\n    17\t  rmSync,\n    18\t  writeFileSync,\n    19\t} from \"node:fs\";\n    20\timport { tmpdir } from \"node:os\";\n    21\timport { execFileSync, spawnSync } from \"node:child_process\";\n    22\timport { dirname, join } from \"node:path\";\n    23\t\n    24\timport { afterAll, describe, expect, test } from \"bun:test\";\n    25\t\n    26\timport {\n    27\t  checkChecklist,\n    28\t  auditArtifactIsValid,\n    29\t  auditSuccessorIsValid,\n    30\t  ATTESTATION_ONLY_PATHS,\n    31\t  REQUIRED_CHECKS,\n    32\t} from \"./release-readiness.ts\";\n    33\t\n    34\tdescribe(\"R4 audit attestation\", () => {\n    35\t  const dir = mkdtempSync(join(tmpdir(), \"caisson-r4-\"));\n    36\t  afterAll(() => rmSync(dir, { recursive: true, force: true }));\n    37\t  function git(repo: string, ...args: string[]): string {\n    38\t    return execFileSync(\"git\", args, {\n    39\t      cwd: repo,\n    40\t      env: {\n    41\t        ...process.env,\n    42\t        GIT_CONFIG_GLOBAL: \"/dev/null\",\n    43\t        GIT_CONFIG_NOSYSTEM: \"1\",\n    44\t      },\n    45\t      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    46\t    })\n    47\t      .toString()\n    48\t      .trim();\n    49\t  }\n    50\t  function scratch(): string {\n    51\t    const repo = mkdtempSync(join(dir, \"repo-\"));\n    52\t    git(repo, \"init\", \"--quiet\");\n    53\t    git(repo, \"config\", \"user.name\", \"R4 lifecycle fixture\");\n    54\t    git(repo, \"config\", \"user.email\", \"r4@example.invalid\");\n    55\t    writeFileSync(join(repo, \"product.ts\"), \"export const version = 1;\\n\");\n    56\t    commit(repo);\n    57\t    git(repo, \"tag\", \"v2026.08.18\");\n    58\t    writeFileSync(join(repo, \"product.ts\"), \"export const version = 2;\\n\");\n    59\t    commit(repo);\n    60\t    return repo;\n    61\t  }\n    62\t  function commit(repo: string): string {\n    63\t    git(repo, \"add\", \".\");\n    64\t    git(repo, \"commit\", \"--quiet\", \"-m\", \"test: lifecycle fixture\");\n    65\t    return git(repo, \"rev-parse\", \"HEAD\");\n    66\t  }\n    67\t  const fixtureRepo = scratch();\n    68\t  const binding = {\n    69\t    base: \"v2026.08.18\",\n    70\t    tag: \"v2026.09.16\",\n    71\t    reviewed_sha: git(fixtureRepo, \"rev-parse\", \"HEAD\"),\n    72\t  };\n    73\t  const clean = {\n    74\t    schema_version: 2,\n    75\t    ...binding,\n    76\t    status: \"clean\",\n    77\t    critical: 0,\n    78\t    reviewed_scope: [\"scripts/release-readiness.ts\"],\n    79\t    reviewers: [\n    80\t      {\n    81\t        role: \"code_review\",\n    82\t        identity: \"gw-code-reviewer\",\n    83\t        reviewed_at: \"2026-09-16T02:37:11Z\",\n    84\t      },\n    85\t      {\n    86\t        role: \"security_audit\",\n    87\t        identity: \"gw-security-auditor\",\n    88\t        reviewed_at: \"2026-09-16T02:37:11Z\",\n    89\t      },\n    90\t    ],\n    91\t  };\n    92\t  function fixture(text: string): string {\n    93\t    const path = join(dir, `${crypto.randomUUID()}.md`);\n    94\t    writeFileSync(path, text);\n    95\t    return path;\n    96\t  }\n    97\t  const document = (value: unknown) =>\n    98\t    `---\\n${JSON.stringify(value)}\\n---\\n# Audit\\n`;\n    99\t\n   100\t  function attestation(repo: string, reviewedSha: string): void {\n   101\t    mkdirSync(join(repo, \"outputs/audit\"), { recursive: true });\n   102\t    mkdirSync(join(repo, \"docs/releases\"), { recursive: true });\n   103\t    writeFileSync(\n   104\t      join(repo, `outputs/audit/release-audit-${binding.tag}.md`),\n   105\t      document({ ...clean, reviewed_sha: reviewedSha }),\n   106\t    );\n   107\t    writeFileSync(\n   108\t      join(repo, `docs/releases/${binding.tag}-checklist.md`),\n   109\t      \"- [x] fixture\\n\",\n   110\t    );\n   111\t  }\n   112\t\n   113\t  test(\"R4 real Git lifecycle accepts review A then attestation-only B\", () => {\n   114\t    const repo = scratch();\n   115\t    const a = git(repo, \"rev-parse\", \"HEAD\");\n   116\t    attestation(repo, a);\n   117\t    const b = commit(repo);\n   118\t    expect(a).not.toBe(b);\n   119\t    expect(auditSuccessorIsValid(repo, binding.tag, b)).toBe(true);\n   120\t    // Working-tree tampering cannot replace the committed attestation.\n   121\t    attestation(repo, git(repo, \"rev-parse\", \"HEAD^\"));\n   122\t    writeFileSync(\n   123\t      join(repo, `outputs/audit/release-audit-${binding.tag}.md`),\n   124\t      \"invalid\",\n   125\t    );\n   126\t    expect(auditSuccessorIsValid(repo, binding.tag, b)).toBe(true);\n   127\t  });\n   128\t  test(\"R373 rejects committed audit with leading newline before frontmatter\", () => {\n   129\t    const repo = scratch();\n   130\t    attestation(repo, git(repo, \"rev-parse\", \"HEAD\"));\n   131\t    const path = join(repo, `outputs/audit/release-audit-${binding.tag}.md`);\n   132\t    writeFileSync(path, `\\n${readFileSync(path, \"utf8\")}`);\n   133\t    const candidate = commit(repo);\n   134\t    // A clean working copy must not rescue malformed committed bytes either.\n   135\t    writeFileSync(path, readFileSync(path, \"utf8\").trimStart());\n   136\t    expect(auditSuccessorIsValid(repo, binding.tag, candidate)).toBe(false);\n   137\t  });\n   138\t\n   139\t  test(\"R373 accepts committed complete checklist despite incomplete dirty copy\", () => {\n   140\t    const repo = scratch();\n   141\t    attestation(repo, git(repo, \"rev-parse\", \"HEAD\"));\n   142\t    const candidate = commit(repo);\n   143\t    writeFileSync(\n   144\t      join(repo, `docs/releases/${binding.tag}-checklist.md`),\n   145\t      \"- [ ] dirty copy\\n\",\n   146\t    );\n   147\t    expect(checkChecklist(binding.tag, candidate, repo)).toBe(true);\n   148\t  });\n   149\t  test(\"R373 rejects checklist absent from candidate despite complete working copy\", () => {\n   150\t    const repo = scratch();\n   151\t    const candidate = git(repo, \"rev-parse\", \"HEAD\");\n   152\t    attestation(repo, candidate);\n   153\t    expect(checkChecklist(binding.tag, candidate, repo)).toBe(false);\n   154\t  });\n   155\t\n   156\t  test(\"R373 rejects committed incomplete checklist despite completed dirty copy\", () => {\n   157\t    const repo = scratch();\n   158\t    attestation(repo, git(repo, \"rev-parse\", \"HEAD\"));\n   159\t    const path = join(repo, `docs/releases/${binding.tag}-checklist.md`);\n   160\t    writeFileSync(path, \"- [ ] live evidence pending\\n\");\n   161\t    const candidate = commit(repo);\n   162\t    writeFileSync(path, \"- [x] live evidence complete\\n\");\n   163\t    expect(auditSuccessorIsValid(repo, binding.tag, candidate)).toBe(true);\n   164\t    expect(checkChecklist(binding.tag, candidate, repo)).toBe(false);\n   165\t  });\n   166\t\n   167\t  test.each([\n   168\t    \"product.ts\",\n   169\t    \"outputs/audit/unreviewed.md\",\n   170\t    \"docs/releases/other-checklist.md\",\n   171\t    \" outputs/audit/other.md\",\n   172\t  ])(\"R4 real Git lifecycle rejects unreviewed successor path %s\", (path) => {\n   173\t    const repo = scratch();\n   174\t    const a = git(repo, \"rev-parse\", \"HEAD\");\n   175\t    attestation(repo, a);\n   176\t    mkdirSync(dirname(join(repo, path)), { recursive: true });\n   177\t    writeFileSync(join(repo, path), \"unreviewed product or policy byte\\n\");\n   178\t    const b = commit(repo);\n   179\t    expect(auditSuccessorIsValid(repo, binding.tag, b)).toBe(false);\n   180\t  });\n   181\t  test(\"R4 real Git lifecycle rejects an audit naming C instead of parent A\", () => {\n   182\t    const repo = scratch();\n   183\t    const a = git(repo, \"rev-parse\", \"HEAD\");\n   184\t    // C is a real distinct existing commit, not an invented forty-character fixture.\n   185\t    const c = git(repo, \"rev-parse\", `${a}^`);\n   186\t    attestation(repo, c);\n   187\t    const b = commit(repo);\n   188\t    expect(auditSuccessorIsValid(repo, binding.tag, b)).toBe(false);\n   189\t  });\n   190\t  test(\"R4 attestation allowlist names exactly the audit and checklist\", () => {\n   191\t    expect(ATTESTATION_ONLY_PATHS).toEqual([\n   192\t      \"outputs/audit/release-audit-{tag}.md\",\n   193\t      \"docs/releases/{tag}-checklist.md\",\n   194\t    ]);\n   195\t  });\n   196\t\n   197\t  test(\"R4 rejects an existing empty audit instead of accepting its filename\", () => {\n   198\t    expect(auditArtifactIsValid(fixture(\"\"), binding)).toBe(false);\n   199\t  });\n   200\t  test(\"R4 accepts a clean audit bound to the exact base, tag and reviewed parent SHA\", () => {\n   201\t    expect(auditArtifactIsValid(fixture(document(clean)), binding)).toBe(true);\n   202\t  });\n   203\t  test.each([\n   204\t    [\"failed verdict\", { status: \"issues_found\" }],\n   205\t    [\"blocking finding\", { critical: 1 }],\n   206\t    [\"wrong SHA\", { reviewed_sha: git(fixtureRepo, \"rev-parse\", \"HEAD^\") }],\n   207\t    [\"wrong base\", { base: \"v2026.07.30\" }],\n   208\t    [\"wrong tag\", { tag: \"v2026.09.17\" }],\n   209\t    [\"empty scope\", { reviewed_scope: [] }],\n   210\t    [\"blank scope\", { reviewed_scope: [\"  \"] }],\n   211\t    [\"no reviewers\", { reviewers: [] }],\n   212\t    [\n   213\t      \"duplicate roles\",\n   214\t      { reviewers: [clean.reviewers[0], clean.reviewers[0]] },\n   215\t    ],\n   216\t    [\n   217\t      \"blank identity\",\n   218\t      {\n   219\t        reviewers: [\n   220\t          { ...clean.reviewers[0], identity: \" \" },\n   221\t          clean.reviewers[1],\n   222\t        ],\n   223\t      },\n   224\t    ],\n   225\t    [\n   226\t      \"invalid timestamp\",\n   227\t      {\n   228\t        reviewers: [\n   229\t          { ...clean.reviewers[0], reviewed_at: \"yesterday\" },\n   230\t          clean.reviewers[1],\n   231\t        ],\n   232\t      },\n   233\t    ],\n   234\t    [\"unknown metadata\", { bypass: true }],\n   235\t  ] as const)(\"R4 rejects %s\", (_label, patch) => {\n   236\t    expect(\n   237\t      auditArtifactIsValid(fixture(document({ ...clean, ...patch })), binding),\n   238\t    ).toBe(false);\n   239\t  });\n   240\t  test(\"R4 fails closed for absent, malformed and prose-only artifacts\", () => {\n   241\t    expect(auditArtifactIsValid(join(dir, \"absent.md\"), binding)).toBe(false);\n   242\t    expect(auditArtifactIsValid(fixture(\"---\\n[invalid\\n---\\n\"), binding)).toBe(\n   243\t      false,\n   244\t    );\n   245\t    expect(\n   246\t      auditArtifactIsValid(fixture(\"Reviewed and approved\"), binding),\n   247\t    ).toBe(false);\n   248\t  });\n   249\t});\n   250\t\n   251\tconst WORKFLOWS_DIR = join(import.meta.dir, \"..\", \".github\", \"workflows\");\n   252\t\n   253\t/** The ONE `if:` a required job may carry — the CAISSON-96 draft guard, per ci.yml's header. */\n   254\tconst DRAFT_GUARD =\n   255\t  \"github.event_name != 'pull_request' || github.event.pull_request.draft == false\";\n   256\t\n   257\tinterface Job {\n   258\t  name?: string;\n   259\t  if?: string;\n   260\t  needs?: string | string[];\n   261\t  \"continue-on-error\"?: boolean;\n   262\t  steps?: {\n   263\t    name?: string;\n   264\t    run?: string;\n   265\t    env?: Record<string, string>;\n   266\t    if?: string;\n   267\t    \"continue-on-error\"?: boolean;\n   268\t  }[];\n   269\t}\n   270\tinterface Trigger {\n   271\t  paths?: string[];\n   272\t  \"paths-ignore\"?: string[];\n   273\t}\n   274\tinterface Workflow {\n   275\t  on?: Record<string, Trigger | null>;\n   276\t  true?: Record<string, Trigger | null>; // YAML 1.1: a bare `on:` key parses as boolean true\n   277\t  jobs?: Record<string, Job>;\n   278\t}\n   279\t\n   280\tinterface Found {\n   281\t  file: string;\n   282\t  key: string;\n   283\t  job: Job;\n   284\t  triggers: Record<string, Trigger | null>;\n   285\t}\n   286\t\n   287\t/** Parse every workflow once, and index by the check-run NAME each job reports under — which is\n   288\t *  `name:` when present and the job key otherwise. release-readiness.ts matches on that reported\n   289\t *  name, so indexing by job key alone would go green while every release reported it missing. */\n   290\tconst unparsable: string[] = [];\n   291\t\n   292\tfunction jobsByReportedName(): Map<string, Found> {\n   293\t  const found = new Map<string, Found>();\n   294\t  for (const file of readdirSync(WORKFLOWS_DIR).filter(\n   295\t    (f) => f.endsWith(\".yml\") || f.endsWith(\".yaml\"),\n   296\t  )) {\n   297\t    let wf: Workflow;\n   298\t    try {\n   299\t      wf = Bun.YAML.parse(\n   300\t        readFileSync(join(WORKFLOWS_DIR, file), \"utf8\"),\n   301\t      ) as Workflow;\n   302\t    } catch (err) {\n   303\t      // Collected, not thrown. A parse error at module scope takes the whole suite down as\n   304\t      // \"0 pass / 0 fail\" — technically non-zero, but it reads as \"no tests ran\" rather than\n   305\t      // \"this workflow is malformed\", and it hides every other check in this file.\n   306\t      unparsable.push(`${file}: ${String(err)}`);\n   307\t      continue;\n   308\t    }\n   309\t    const triggers = wf.on ?? wf.true ?? {};\n   310\t    for (const [key, job] of Object.entries(wf.jobs ?? {})) {\n   311\t      found.set(job.name ?? key, { file, key, job, triggers });\n   312\t    }\n   313\t  }\n   314\t  return found;\n   315\t}\n   316\t\n   317\tdescribe(\"REQUIRED_CHECKS — the release-readiness gate's own input\", () => {\n   318\t  const byName = jobsByReportedName();\n   319\t\n   320\t  test(\"every workflow file parses — a throw here would blank the whole suite\", () => {\n   321\t    expect(unparsable).toEqual([]);\n   322\t  });\n   323\t\n   324\t  test(\"the set is non-empty, deduplicated, and at full strength\", () => {\n   325\t    // Guard the guard: a floor below the real size lets one silently drop out.\n   326\t    expect(REQUIRED_CHECKS.length).toBeGreaterThanOrEqual(7);\n   327\t    expect(new Set(REQUIRED_CHECKS).size).toBe(REQUIRED_CHECKS.length);\n   328\t    // And the parse itself must have found something, or every check below is vacuous.\n   329\t    expect(byName.size).toBeGreaterThan(10);\n   330\t  });\n   331\t\n   332\t  test(\"every required check is a job some workflow actually reports under that name\", () => {\n   333\t    expect(REQUIRED_CHECKS.filter((name) => !byName.has(name))).toEqual([]);\n   334\t  });\n   335\t\n   336\t  test(\"no required check is path-scoped — a skipped check never reports and reads as missing\", () => {\n   337\t    // ci.yml's header states the rule from the PR side (a path-skipped required job never reports\n   338\t    // and the PR blocks forever); release-readiness.ts enforces it from the release side, where a\n   339\t    // check with zero runs lands in `missing`. Same constraint, both directions.\n   340\t    const scoped = REQUIRED_CHECKS.flatMap((name) => {\n   341\t      const hit = byName.get(name);\n   342\t      if (!hit) return [];\n   343\t      return Object.entries(hit.triggers)\n   344\t        .filter(([, t]) => t?.paths ?? t?.[\"paths-ignore\"])\n   345\t        .map(([event]) => `${name} (${hit.file}, on.${event})`);\n   346\t    });\n   347\t    expect(scoped).toEqual([]);\n   348\t  });\n   349\t\n   350\t  test(\"no required check is conditionally skippable — only the CAISSON-96 draft guard is allowed\", () => {\n   351\t    // The other way a required job silently stops reporting: a job-level `if:` or a `needs:` on a\n   352\t    // path-filter job. quality.yml already has a `changes` job of exactly that shape, so this is a\n   353\t    // pattern the repo can produce, not a hypothetical.\n   354\t    const conditional = REQUIRED_CHECKS.flatMap((name) => {\n   355\t      // The fail-closed aggregate is tested structurally and behaviorally below.\n   356\t      if (name === \"runtime-images-gate\") return [];\n   357\t      const hit = byName.get(name);\n   358\t      if (!hit) return [];\n   359\t      const reasons: string[] = [];\n   360\t      if (hit.job.if !== undefined && hit.job.if.trim() !== DRAFT_GUARD) {\n   361\t        reasons.push(`if: ${hit.job.if}`);\n   362\t      }\n   363\t      if (hit.job.needs !== undefined) {\n   364\t        reasons.push(`needs: ${String(hit.job.needs)}`);\n   365\t      }\n   366\t      return reasons.map((r) => `${name} (${hit.file}) — ${r}`);\n   367\t    });\n   368\t    expect(conditional).toEqual([]);\n   369\t  });\n   370\t\n   371\t  test(\"support-bot is in the set — ADR-0414 promoted it before automating its deploy\", () => {\n   372\t    // Pinned by name, not just by the structural rules above: the promotion is the whole reason\n   373\t    // deploy-railway.yml is allowed to ship this service automatically. Dropping it back to\n   374\t    // advisory silently restores \"a red bot deploys anyway\", which no structural check would catch.\n   375\t    expect(REQUIRED_CHECKS).toContain(\"support-bot\");\n   376\t    expect(byName.get(\"support-bot\")?.file).toBe(\"support-bot.yml\");\n   377\t  });\n   378\t\n   379\t  test(\"runtime images aggregate is required by release readiness\", () => {\n   380\t    expect(REQUIRED_CHECKS).toContain(\"runtime-images-gate\");\n   381\t  });\n   382\t\n   383\t  test(\"runtime aggregate always consumes the selector and complete matrix\", () => {\n   384\t    const hit = byName.get(\"runtime-images-gate\");\n   385\t    expect(hit?.file).toBe(\"security-scan.yml\");\n   386\t    expect(hit?.job.if).toBe(\"always()\");\n   387\t    expect(hit?.job.needs).toEqual([\"runtime-select\", \"runtime-images\"]);\n   388\t    expect(hit?.job[\"continue-on-error\"]).not.toBe(true);\n   389\t    expect(hit?.job.steps).toHaveLength(1);\n   390\t    const step = hit?.job.steps?.[0];\n   391\t    expect(step?.if).toBeUndefined();\n   392\t    expect(step?.[\"continue-on-error\"]).not.toBe(true);\n   393\t    expect(step?.env).toEqual({\n   394\t      SELECT_RESULT: \"${{ needs.runtime-select.result }}\",\n   395\t      MATRIX_RESULT: \"${{ needs.runtime-images.result }}\",\n   396\t    });\n   397\t  });\n   398\t\n   399\t  function aggregate(select: string, matrix: string): number | null {\n   400\t    const script = byName.get(\"runtime-images-gate\")?.job.steps?.[0]?.run;\n   401\t    if (!script) throw new Error(\"runtime aggregate script missing\");\n   402\t    // Execute the actual workflow gate with synthetic outcomes; no scanners or credentials.\n   403\t    return spawnSync(\"bash\", [\"-c\", script], {\n   404\t      env: {\n   405\t        PATH: process.env.PATH,\n   406\t        SELECT_RESULT: select,\n   407\t        MATRIX_RESULT: matrix,\n   408\t      },\n   409\t    }).status;\n   410\t  }\n   411\t\n   412\t  test(\"runtime aggregate rejects a failed matrix member\", () => {\n   413\t    expect(aggregate(\"success\", \"failure\")).toBe(1);\n   414\t  });\n   415\t\n   416\t  test(\"runtime aggregate is green only when both dependencies succeed\", () => {\n   417\t    for (const select of [\"success\", \"failure\", \"cancelled\", \"skipped\", \"\"]) {\n   418\t      for (const matrix of [\"success\", \"failure\", \"cancelled\", \"skipped\", \"\"]) {\n   419\t        expect(aggregate(select, matrix)).toBe(\n   420\t          select === \"success\" && matrix === \"success\" ? 0 : 1,\n   421\t        );\n   422\t      }\n   423\t    }\n   424\t  });\n   425\t});\n","exit_code":0,"status":"completed"}}
