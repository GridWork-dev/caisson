{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/kernel/src/origin-gate.ts'","aggregated_output":"     1\timport { timingSafeEqual } from \"node:crypto\";\n     2\timport { z } from \"zod\";\n     3\timport { ConfigError } from \"./errors.ts\";\n     4\t\n     5\texport const ORIGIN_SECRET_HEADER = \"x-gridwork-origin-secret\";\n     6\t\n     7\tconst encodedSecretSchema = z\n     8\t  .string()\n     9\t  .regex(/^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$/);\n    10\t\n    11\tconst originEnvSchema = z\n    12\t  .object({\n    13\t    runtime: z.string().optional(),\n    14\t    mode: z.string().optional(),\n    15\t    current: z.string().optional(),\n    16\t    next: z.string().optional(),\n    17\t  })\n    18\t  .strict();\n    19\t\n    20\tconst presentedHeaderSchema = z\n    21\t  .object({ secret: encodedSecretSchema })\n    22\t  .strict();\n    23\t\n    24\texport interface OriginGateConfig {\n    25\t  required: boolean;\n    26\t  secrets: readonly Buffer[];\n    27\t}\n    28\t\n    29\texport interface OriginGateEnv {\n    30\t  readonly [key: string]: string | undefined;\n    31\t  NODE_ENV?: string;\n    32\t  ORIGIN_SECRET_MODE?: string;\n    33\t  ORIGIN_SECRET?: string;\n    34\t  ORIGIN_SECRET_NEXT?: string;\n    35\t}\n    36\t\n    37\texport function originVerificationDisabledFor(\n    38\t  nodeEnvironment: string | undefined,\n    39\t  mode: string | undefined,\n    40\t): boolean {\n    41\t  return (\n    42\t    mode === \"disabled\" &&\n    43\t    (nodeEnvironment === \"development\" || nodeEnvironment === \"test\")\n    44\t  );\n    45\t}\n    46\t\n    47\texport function loadOriginGateConfig(env: OriginGateEnv): OriginGateConfig {\n    48\t  const parsed = originEnvSchema.safeParse({\n    49\t    runtime: env.NODE_ENV,\n    50\t    mode: env.ORIGIN_SECRET_MODE,\n    51\t    current: env.ORIGIN_SECRET,\n    52\t    next: env.ORIGIN_SECRET_NEXT,\n    53\t  });\n    54\t  if (!parsed.success) {\n    55\t    throw new ConfigError(\"Invalid origin verification configuration\");\n    56\t  }\n    57\t  // Doc 04 §4: fail closed by construction. An absent mode is armed, and production cannot opt\n    58\t  // out under any mode value. Only an explicit local/test opt-out disables verification.\n    59\t  if (originVerificationDisabledFor(parsed.data.runtime, parsed.data.mode)) {\n    60\t    return { required: false, secrets: [] };\n    61\t  }\n    62\t\n    63\t  const current = encodedSecretSchema.safeParse(parsed.data.current);\n    64\t  const next =\n    65\t    parsed.data.next === undefined\n    66\t      ? undefined\n    67\t      : encodedSecretSchema.safeParse(parsed.data.next);\n    68\t  if (!current.success || (next !== undefined && !next.success)) {\n    69\t    throw new ConfigError(\n    70\t      \"Origin verification requires canonical 32-byte base64url secrets\",\n    71\t    );\n    72\t  }\n    73\t\n    74\t  const secrets = [\n    75\t    Buffer.from(current.data, \"base64url\"),\n    76\t    ...(next === undefined ? [] : [Buffer.from(next.data, \"base64url\")]),\n    77\t  ];\n    78\t  return { required: true, secrets };\n    79\t}\n    80\t\n    81\texport function originRequestAuthorized(\n    82\t  request: Request,\n    83\t  config: OriginGateConfig,\n    84\t): boolean {\n    85\t  if (!config.required) return true;\n    86\t\n    87\t  const parsed = presentedHeaderSchema.safeParse({\n    88\t    secret: request.headers.get(ORIGIN_SECRET_HEADER),\n    89\t  });\n    90\t  if (!parsed.success) return false;\n    91\t\n    92\t  const presented = Buffer.from(parsed.data.secret, \"base64url\");\n    93\t  let matched = false;\n    94\t  for (const expected of config.secrets) {\n    95\t    if (\n    96\t      presented.length === expected.length &&\n    97\t      timingSafeEqual(presented, expected)\n    98\t    ) {\n    99\t      matched = true;\n   100\t    }\n   101\t  }\n   102\t  return matched;\n   103\t}\n","exit_code":0,"status":"completed"}}
