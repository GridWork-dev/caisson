7\t    accessClientId: z.string().min(1).max(2_048).regex(HEADER_VALUE).optional(),\n    48\t    accessClientSecret: z\n    49\t      .string()\n    50\t      .min(1)\n    51\t      .max(2_048)\n    52\t      .regex(HEADER_VALUE)\n    53\t      .optional(),\n    54\t  })\n    55\t  .strict();\n    56\t\n    57\texport type SmokeConfig = {\n    58\t  environment: string;\n    59\t  mode: string;\n    60\t  canaryTag?: string | undefined;\n    61\t  canaryUrls?: Record<string, string> | undefined;\n    62\t  stagingOriginUrls?: Record<string, string> | undefined;\n    63\t  originSecrets?: Record<string, string> | undefined;\n    64\t  service?: string | undefined;\n    65\t  accessClientId?: string | undefined;\n    66\t  accessClientSecret?: string | undefined;\n    67\t};\n    68\t\n    69\texport type TimedFetcher = (\n    70\t  input: string | URL | Request,\n    71\t  init?: RequestInit,\n    72\t  options?: FetchTimeoutOptions,\n    73\t) => Promise<Response>;\n    74\t\n    75\texport type IdentityTokenProvider = (audience: string) => Promise<string>;\n    76\t\n    77\ttype Environment = \"staging\" | \"production\";\n    78\ttype ServiceKey = z.infer<typeof ServiceKeySchema>;\n    79\ttype Target = {\n    80\t  key: ServiceKey;\n    81\t  origin: string;\n    82\t  healthPath: string;\n    83\t  canaryHealthPath: string;\n    84\t  originProtected: boolean;\n    85\t  accessProtected: boolean;\n    86\t};\n    87\t\n    88\tconst TARGETS: Record<Environment, Target[]> = {\n    89\t  production: [\n    90\t    {\n    91\t      key: \"caisson-site\",\n    92\t      origin: \"https://caisson.sh\",\n    93\t      healthPath: \"/healthz\",\n    94\t      canaryHealthPath: \"/healthz\",\n    95\t      originProtected: true,\n    96\t      accessProtected: false,\n    97\t    },\n    98\t    {\n    99\t      key: \"caisson-admin\",\n   100\t      origin: \"https://admin.caisson.sh\",\n   101\t      healthPath: \"/healthz\",\n   102\t      canaryHealthPath: \"/healt