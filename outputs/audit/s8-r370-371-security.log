{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/lib/auth-server.ts'","aggregated_output":"     1\t// The better-auth sign-in runtime (ADR-0015: better-auth is the self-hosted SessionProvider that\n     2\t// owns its user/session/account/verification tables). This is the SERVER instance the Next route\n     3\t// handler mounts and the dashboard resolves sessions from. It is built LAZILY and is boot/build\n     4\t// safe: with no `DATABASE_URL` + `BETTER_AUTH_SECRET` it returns `null` (sign-in simply\n     5\t// unavailable — dev/CI/build with no Postgres), never throwing at import so `next build` and\n     6\t// `bunx tsc` stay green without a live database.\n     7\t//\n     8\t// Auth methods:\n     9\t//  - Magic link (PRIMARY, always on): the link email is sent through `@caisson/email`'s `Emailer`\n    10\t//    port — the Resend driver in prod (`RESEND_API_KEY`), the in-memory capture driver otherwise.\n    11\t//  - Email + password: a signed-up password account requires email verification before it can\n    12\t//    sign in (`requireEmailVerification`) — unlike the magic link, a password alone never proves\n    13\t//    inbox ownership, so the trust boundary needs the extra round trip. Both the verification and\n    14\t//    password-reset emails route through the SAME injected `Emailer`.\n    15\t//  - GitHub + Google OAuth: offered ONLY when their credentials are present (`resolveSocialProviders`).\n    16\t//\n    17\t// The session cookie is hardened per the security floor: `SameSite=Strict`, `HttpOnly`, and\n    18\t// `Secure` (better-auth sets Secure automatically in production). OAuth's short-lived state\n    19\t// cookies keep better-auth's default `SameSite=Lax` — they MUST survive the provider's top-level\n    20\t// cross-site redirect back to our callback, which a Strict cookie would drop; only the durable\n    21\t// SESSION cookie is pinned to Strict.\n    22\timport { createPgPool } from \"@caisson/tenancy-rls\";\n    23\timport type { Pool } from \"pg\";\n    24\timport { betterAuth } from \"better-auth\";\n    25\timport { createAuthMiddleware } from \"better-auth/api\";\n    26\timport { magicLink } from \"better-auth/plugins\";\n    27\timport type { BetterAuthOptions } from \"better-auth/types\";\n    28\t// ADR-0366: better-auth exposes no public `database`-construction subpath (its own internal\n    29\t// `getAdapter` reaches into this same package), so the session-token wrap depends on it\n    30\t// directly, pinned to better-auth's OWN exact version below — the two ship in lockstep upstream.\n    31\timport {\n    32\t  createKyselyAdapter,\n    33\t  kyselyAdapter,\n    34\t} from \"@better-auth/kysely-adapter\";\n    35\timport {\n    36\t  type CaptureEmailer,\n    37\t  type Emailer,\n    38\t  createCaptureEmailer,\n    39\t  createResendEmailer,\n    40\t} from \"@caisson/email\";\n    41\timport { resolveSocialProviders } from \"./auth-config.ts\";\n    42\timport { SESSION_HINT_COOKIE_NAME } from \"./session-hint-cookie.ts\";\n    43\timport { wrapSessionAdapter } from \"./session-adapter.ts\";\n    44\t\n    45\texport { SESSION_HINT_COOKIE_NAME } from \"./session-hint-cookie.ts\";\n    46\t\n    47\t/** The prefixed session cookie name the security floor pins (`${cookiePrefix}.session_token`). */\n    48\texport const SESSION_COOKIE_NAME = \"caisson.session_token\";\n    49\t\n    50\t/** Legacy HttpOnly hint mint/clear compatibility (ADR-0418). ADR-0424 removes the ownership\n    51\t * short-circuit: this cookie never establishes session absence or controls checkout. */\n    52\tconst sessionHintCookieHook = createAuthMiddleware(async (ctx) => {\n    53\t  if (ctx.context.newSession) {\n    54\t    // Unconditionally Secure (unlike the real session cookie, which only forces it in production —\n    55\t    // see `advanced.cookies.session_token` below): this cookie carries no secret, so there's no\n    56\t    // production/dev split to preserve, and modern browsers exempt `localhost` from the\n    57\t    // https-only restriction on Secure cookies, so local dev keeps working.\n    58\t    ctx.setCookie(SESSION_HINT_COOKIE_NAME, \"1\", {\n    59\t      secure: true,\n    60\t      sameSite: \"strict\",\n    61\t      httpOnly: true,\n    62\t      path: \"/\",\n    63\t      expires: ctx.context.newSession.session.expiresAt,\n    64\t    });\n    65\t  } else if (ctx.path === \"/sign-out\") {\n    66\t    // Fail-open in the other direction: a stray hint cookie left behind by a client that ignored\n    67\t    // this Set-Cookie just costs one wasted `/api/cart/owned` fetch (the provider's own fail-open\n    68\t    // contract), never a false \"owned\" marking.\n    69\t    ctx.setCookie(SESSION_HINT_COOKIE_NAME, \"\", {\n    70\t      secure: true,\n    71\t      sameSite: \"strict\",\n    72\t      httpOnly: true,\n    73\t      path: \"/\",\n    74\t      maxAge: 0,\n    75\t    });\n    76\t  }\n    77\t});\n    78\t\n    79\t/**\n    80\t * Resolve the magic-link transport: the Resend driver when `RESEND_API_KEY` is configured, an\n    81\t * in-memory capture driver otherwise (so a dev/CI instance never hits the network and tests can\n    82\t * assert the sent link). The `from` address is env-driven (`RESEND_FROM`) with a safe default —\n    83\t * never a hardcoded secret. Replies to the no-reply sender land in the support inbox.\n    84\t */\n    85\tfunction resolveEmailer(): Emailer | CaptureEmailer {\n    86\t  const apiKey = process.env.RESEND_API_KEY?.trim();\n    87\t  if (apiKey !== undefined && apiKey.length > 0) {\n    88\t    return createResendEmailer({\n    89\t      apiKey,\n    90\t      from: process.env.RESEND_FROM?.trim() ?? \"Caisson <no-reply@caisson.sh>\",\n    91\t      replyTo: \"support@caisson.sh\",\n    92\t    });\n    93\t  }\n    94\t  return createCaptureEmailer();\n    95\t}\n    96\t\n    97\t/**\n    98\t * Build a better-auth instance over a Postgres pool. Exported so tests can construct an instance\n    99\t * against an in-memory database with a capture transport, exercising the real magic-link →\n   100\t * session flow without a live Postgres. `emailer` is injected; `baseURL` is optional (better-auth\n   101\t * infers it from the request when absent).\n   102\t *\n   103\t * `hmacKey` (ADR-0366) is REQUIRED and checked here too (construction-time fail-closed), not just\n   104\t * by `getAuth()`'s env read below — any other caller that forgets it gets the same loud throw\n   105\t * instead of a silent raw-token fallback. The session-token adapter wrap (`session-adapter.ts`)\n   106\t * is built from the SAME `database` here via `createKyselyAdapter`/`kyselyAdapter` (the exact\n   107\t * dialect-detection better-auth itself uses internally), so it works against both a real `pg.Pool`\n   108\t * (production) and the in-memory `bun:sqlite` double used by this app's own tests — a hand-rolled\n   109\t * `PostgresDialect` would only work against the former and break the latter.\n   110\t *\n   111\t * NOTE for callers that also run `getMigrations(auth.options)` (schema DDL, e.g.\n   112\t * `deploy-migrate.ts`): `auth.options.database` below is the WRAPPED adapter FACTORY, which\n   113\t * `getMigrations`'s own dialect detection cannot introspect (it only recognizes a raw\n   114\t * Pool/Dialect/Kysely shape). Substitute the raw `database` value back in for that call:\n   115\t * `getMigrations({ ...auth.options, database })`. Schema DDL is unaffected by the session-token\n   116\t * wrap either way — this is purely about `createKyselyAdapter`'s dialect-detection reach.\n   117\t */\n   118\texport async function createAuth(params: {\n   119\t  database: Pool;\n   120\t  secret: string;\n   121\t  emailer: Emailer;\n   122\t  hmacKey: string;\n   123\t  baseURL?: string | undefined;\n   124\t}) {\n   125\t  const { database, secret, emailer, baseURL, hmacKey } = params;\n   126\t  if (hmacKey.trim().length === 0) {\n   127\t    throw new Error(\n   128\t      \"SESSION_TOKEN_HMAC_KEY is required to construct the auth runtime (ADR-0366) — refusing to start rather than fall back to storing raw session tokens.\",\n   129\t    );\n   130\t  }\n   131\t  // Safe partial cast: `createKyselyAdapter` reads only `config.database` (verified against\n   132\t  // `@better-auth/kysely-adapter`'s source) — the rest of `BetterAuthOptions` is irrelevant to\n   133\t  // dialect detection.\n   134\t  const { kysely, databaseType, transaction } = await createKyselyAdapter({\n   135\t    database,\n   136\t  } as BetterAuthOptions);\n   137\t  if (!kysely) {\n   138\t    throw new Error(\n   139\t      \"session-adapter: failed to initialize the database adapter for the ADR-0366 session-token wrap.\",\n   140\t    );\n   141\t  }\n   142\t  const baseAdapterFactory = kyselyAdapter(kysely, {\n   143\t    type: databaseType ?? \"postgres\",\n   144\t    transaction,\n   145\t  });\n   146\t  return betterAuth({\n   147\t    database: (options: BetterAuthOptions) =>\n   148\t      wrapSessionAdapter(baseAdapterFactory(options), hmacKey),\n   149\t    secret,\n   150\t    basePath: \"/api/auth\",\n   151\t    ...(baseURL !== undefined && baseURL.length > 0 ? { baseURL } : {}),\n   152\t    plugins: [\n   153\t      magicLink({\n   154\t        // PRIMARY sign-in. The link is emailed through the injected transport; the URL better-auth\n   155\t        // generates carries the one-time token and the post-verify redirect (callbackURL).\n   156\t        sendMagicLink: async ({ email, url }): Promise<void> => {\n   157\t          await emailer.send({\n   158\t            to: email,\n   159\t            template: \"magic-link\",\n   160\t            data: { url },\n   161\t          });\n   162\t        },\n   163\t      }),\n   164\t    ],\n   165\t    emailAndPassword: {\n   166\t      enabled: true,\n   167\t      // A password alone doesn't prove inbox ownership the way a clicked magic link does —\n   168\t      // require verification before a password account can sign in.\n   169\t      requireEmailVerification: true,\n   170\t      sendResetPassword: async ({ user, url }): Promise<void> => {\n   171\t        await emailer.send({\n   172\t          to: user.email,\n   173\t          template: \"password-reset\",\n   174\t          data: { url },\n   175\t        });\n   176\t      },\n   177\t    },\n   178\t    emailVerification: {\n   179\t      sendVerificationEmail: async ({ user, url }): Promise<void> => {\n   180\t        await emailer.send({\n   181\t          to: user.email,\n   182\t          template: \"verify-email\",\n   183\t          data: { url },\n   184\t        });\n   185\t      },\n   186\t      sendOnSignUp: true,\n   187\t      autoSignInAfterVerification: true,\n   188\t    },\n   189\t    socialProviders: resolveSocialProviders(process.env),\n   190\t    // ADR-0418: mint/refresh the HttpOnly hint cookie alongside every real session\n   191\t    // create/refresh, clear it on sign-out. See `sessionHintCookieHook` above.\n   192\t    hooks: { after: sessionHintCookieHook },\n   193\t    advanced: {\n   194\t      cookiePrefix: \"caisson\",\n   195\t      cookies: {\n   196\t        session_token: {\n   197\t          // Security floor: the durable session cookie is Strict + HttpOnly. `Secure` is added by\n   198\t          // better-auth in production (NODE_ENV=production).\n   199\t          attributes: { sameSite: \"strict\", httpOnly: true, path: \"/\" },\n   200\t        },\n   201\t      },\n   202\t    },\n   203\t  });\n   204\t}\n   205\t\n   206\ttype AuthInstance = Awaited<ReturnType<typeof createAuth>>;\n   207\t\n   208\t// `undefined` = not yet resolved this process; a resolved promise carries `null` for\n   209\t// resolved-but-unavailable (no DB/secret). `createAuth` is now async (ADR-0366: it awaits\n   210\t// `createKyselyAdapter` to build the session-token-wrapped adapter), so the cache holds the\n   211\t// in-flight/settled PROMISE itself, not its result — every caller `await`s the same one.\n   212\tlet cached: Promise<AuthInstance | null> | undefined;\n   213\t\n   214\t/**\n   215\t * The process-wide better-auth instance, or `null` when the runtime is not configured for\n   216\t * sign-in (`DATABASE_URL` or `BETTER_AUTH_SECRET` absent). Callers MUST treat `null` as \"sign-in\n   217\t * unavailable\" — the route handler answers 503, `getSession` returns no session. Resolved once and\n   218\t * cached (one Postgres pool per process).\n   219\t */\n   220\texport function getAuth(): Promise<AuthInstance | null> {\n   221\t  if (cached !== undefined) return cached;\n   222\t  const url = process.env.DATABASE_URL?.trim();\n   223\t  const secret = process.env.BETTER_AUTH_SECRET?.trim();\n   224\t  if (\n   225\t    url === undefined ||\n   226\t    url.length === 0 ||\n   227\t    secret === undefined ||\n   228\t    secret.length === 0\n   229\t  ) {\n   230\t    cached = Promise.resolve(null);\n   231\t    return cached;\n   232\t  }\n   233\t  const hmacKey = process.env.SESSION_TOKEN_HMAC_KEY?.trim();\n   234\t  if (hmacKey === undefined || hmacKey.length === 0) {\n   235\t    // Fail-closed (ADR-0366): DATABASE_URL + BETTER_AUTH_SECRET ARE configured (this would\n   236\t    // otherwise be a live auth runtime), so a missing HMAC key is an operator misconfiguration,\n   237\t    // never a silent \"sign-in unavailable\" degrade or a raw-token fallback. Throwing here surfaces\n   238\t    // loudly (a crashed boot / a failed health check) instead of masking a forgotten env var as an\n   239\t    // ordinary DB-down outage.\n   240\t    throw new Error(\n   241\t      \"SESSION_TOKEN_HMAC_KEY is required once DATABASE_URL/BETTER_AUTH_SECRET are configured (ADR-0366) — refusing to start auth with raw session-token storage.\",\n   242\t    );\n   243\t  }\n   244\t  const pool = createPgPool(url);\n   245\t  cached = createAuth({\n   246\t    database: pool,\n   247\t    secret,\n   248\t    emailer: resolveEmailer(),\n   249\t    hmacKey,\n   250\t    baseURL: process.env.BETTER_AUTH_URL?.trim(),\n   251\t  });\n   252\t  return cached;\n   253\t}\n","exit_code":0,"status":"completed"}}
