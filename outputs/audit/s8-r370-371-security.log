026-07-17 before the flip.\n.github/workflows/security-scan.yml-111-          bash tools/security/scan.sh --layer ci --strict-digests\n.github/workflows/security-scan.yml-112-      - name: report raw Dockerfile base digests (informational, anonymous)\n.github/workflows/security-scan.yml-113-        if: ${{ !cancelled() && steps.scanners.outcome == 'success' }}\n.github/workflows/security-scan.yml:114:        continue-on-error: true # R335: raw-base results never gate the job.\n.github/workflows/security-scan.yml-115-        run: |\n.github/workflows/security-scan.yml-116-          export PATH=\"$HOME/.local/bin:$PATH\"\n.github/workflows/security-scan.yml-117-          python3 tools/security/rescan_base_images.py --output \"$RUNNER_TEMP/security-out\"\n.github/workflows/security-scan.yml-118-      - name: upload SARIF artifacts\n.github/workflows/security-scan.yml-119-        if: always()\n.github/workflows/security-scan.yml-120-        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7\n.github/workflows/security-scan.yml-121-        with:\n.github/workflows/security-scan.yml-122-          name: security-sarif-${{ github.sha }}\n.github/workflows/security-scan.yml-123-          path: ${{ runner.temp }}/security-out\n.github/workflows/security-scan.yml-124-          if-no-files-found: warn\n.github/workflows/security-scan.yml-125-          retention-days: 30\n.github/workflows/security-scan.yml-126-\n.github/workflows/security-scan.yml-127-  # R359 / CR-05: one stable check consumes every matrix member's result, including\n.github/workflows/security-scan.yml-128-  # cancellation/failure/skips. always() prevents a red dependency from skipping the gate.\n.github/workflows/security-scan.yml:129:  runtime-images-gate:\n.github/workflows/security-scan.yml:130:    name: runtime-images-gate\n.github/workflows/security-scan.yml-131-    if: always()\n.github/workflows/security-scan.yml-132-    needs: [runtime-select, runtime-images]\n.github/workflows/security-scan.yml-133-    runs-on: ${{ vars.CI_RUNNER_LINUX || 'ubuntu-latest' }}\n.github/workflows/security-scan.yml-134-    timeout-minutes: 5\n.github/workflows/security-scan.yml-135-    steps:\n.github/workflows/security-scan.yml-136-      - name: require successful runtime selection and every image\n.github/workflows/security-scan.yml-137-        env:\n.github/workflows/security-scan.yml-138-          SELECT_RESULT: ${{ needs.runtime-select.result }}\n.github/workflows/security-scan.yml-139-          MATRIX_RESULT: ${{ needs.runtime-images.result }}\n.github/workflows/security-scan.yml-140-        run: |\n.github/workflows/security-scan.yml-141-          set -euo pipefail\n.github/workflows/security-scan.yml-142-          test \"$SELECT_RESULT\" = success\n.github/workflows/security-scan.yml-143-          test \"$MATRIX_RESULT\" = success\n.github/workflows/security-scan.yml-144-\n.github/workflows/security-scan.yml-145-  # Semgrep PRO (interfile / cross-function taint). Dormant until SEMGREP_APP_TOKEN is set. The job\n.github/workflows/security-scan.yml-146-  # ALWAYS runs — a job-level `if` CANNOT reference the `secrets` context (doing so is a parse-time\n.github/workflows/security-scan.yml-147-  # \"Unrecognized named-value: secrets\" that invalidates the ENTIRE workflow file, killing the\n.github/workflows/security-scan.yml-148-  # deterministic job too) — but the single step below no-ops without a token. `semgrep ci`\n--\n.github/workflows/security-scan.yml-223-          # Online audits (impostor-commit, ref-confusion, stale-action-refs) need read access to\n.github/workflows/security-scan.yml-224-          # public commit graphs; the default token's `contents: read` suffices.\n.github/workflows/security-scan.yml-225-          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n.github/workflows/security-scan.yml-226-        run: |\n.github/workflows/security-scan.yml-227-          export PATH=\"$HOME/.local/bin:$PATH\"\n.github/workflows/security-scan.yml-228-          mkdir -p \"$RUNNER_TEMP/zizmor-out\"\n.github/workflows/security-scan.yml-229-          zizmor --persona=regular --format=sarif --no-exit-codes .github/workflows/ > \"$RUNNER_TEMP/zizmor-out/zizmor.sarif\"\n.github/workflows/security-scan.yml-230-          # Human-readable echo for the job log (advisory visibility without downloading the SARIF).\n.github/workflows/security-scan.yml-231-          zizmor --persona=regular --no-exit-codes .github/workflows/ || true\n.github/workflows/security-scan.yml-232-      - name: upload zizmor SARIF artifact\n.github/workflows/security-scan.yml-233-        if: always()\n.github/workflows/security-scan.yml-234-        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7\n.github/workflows/security-scan.yml-235-        with:\n.github/workflows/security-scan.yml-236-          name: zizmor-sarif-${{ github.sha }}\n.github/workflows/security-scan.yml-237-          path: ${{ runner.temp }}/zizmor-out\n.github/workflows/security-scan.yml-238-          if-no-files-found: warn\n.github/workflows/security-scan.yml-239-          retention-days: 30\n.github/workflows/security-scan.yml-240-\n.github/workflows/security-scan.yml:241:  runtime-select:\n.github/workflows/security-scan.yml-242-    if: github.event_name != 'pull_request' || github.event.pull_request.draft == false\n.github/workflows/security-scan.yml-243-    runs-on: ${{ vars.CI_RUNNER_LINUX || 'ubuntu-latest' }}\n.github/workflows/security-scan.yml-244-    outputs:\n.github/workflows/security-scan.yml-245-      matrix: ${{ steps.select.outputs.matrix }}\n.github/workflows/security-scan.yml-246-    steps:\n.github/workflows/security-scan.yml-247-      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7\n.github/workflows/security-scan.yml-248-        with:\n.github/workflows/security-scan.yml-249-          persist-credentials: false\n.github/workflows/security-scan.yml-250-      - id: select\n.github/workflows/security-scan.yml-251-        run: |\n.github/workflows/security-scan.yml:252:          matrix=\"$(python3 -B tools/security/rescan_runtime_images.py --matrix)\"\n.github/workflows/security-scan.yml-253-          printf 'matrix=%s\\n' \"$matrix\" >> \"$GITHUB_OUTPUT\"\n.github/workflows/security-scan.yml-254-\n.github/workflows/security-scan.yml:255:  runtime-images:\n.github/workflows/security-scan.yml-256-    name: runtime image (${{ matrix.name }})\n.github/workflows/security-scan.yml-257-    needs: runtime-select\n.github/workflows/security-scan.yml-258-    runs-on: ${{ vars.CI_RUNNER_LINUX || 'ubuntu-latest' }}\n.github/workflows/security-scan.yml-259-    timeout-minutes: 35\n.github/workflows/security-scan.yml-260-    strategy:\n.github/workflows/security-scan.yml-261-      fail-fast: false\n.github/workflows/security-scan.yml-262-      max-parallel: 4\n.github/workflows/security-scan.yml-263-      matrix: ${{ fromJSON(needs.runtime-select.outputs.matrix) }}\n.github/workflows/security-scan.yml-264-    env:\n.github/workflows/security-scan.yml-265-      IMAGE: caisson-runtime-rescan:${{ matrix.name }}\n.github/workflows/security-scan.yml-266-    steps:\n.github/workflows/security-scan.yml-267-      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7\n.github/workflows/security-scan.yml-268-        with:\n.github/workflows/security-scan.yml-269-          persist-credentials: false\n.github/workflows/security-scan.yml-270-      - name: prepare disposable runner disk\n.github/workflows/security-scan.yml-271-        run: |\n.github/workflows/security-scan.yml-272-          # Same fixed SDK set proven by PR 483. This job needs its own cleanup\n.github/workflows/security-scan.yml-273-          # before that sibling PR merges; neither PR may merge independently (R336).\n--\n.github/workflows/security-scan.yml-294-          target: ${{ matrix.target }}\n.github/workflows/security-scan.yml-295-          platforms: linux/amd64\n.github/workflows/security-scan.yml-296-          no-cache: true # Execute apt update/upgrade on every scheduled rebuild.\n.github/workflows/security-scan.yml-297-          pull: true\n.github/workflows/security-scan.yml-298-          push: false\n.github/workflows/security-scan.yml-299-          load: true\n.github/workflows/security-scan.yml-300-          tags: ${{ env.IMAGE }}\n.github/workflows/security-scan.yml-301-      - name: record built image provenance\n.github/workflows/security-scan.yml-302-        env:\n.github/workflows/security-scan.yml-303-          DOCKERFILE: ${{ matrix.dockerfile }}\n.github/workflows/security-scan.yml-304-          TARGET: ${{ matrix.target }}\n.github/workflows/security-scan.yml-305-        run: |\n.github/workflows/security-scan.yml-306-          mkdir -p \"$RUNNER_TEMP/runtime-scan\"\n.github/workflows/security-scan.yml-307-          git rev-parse HEAD > \"$RUNNER_TEMP/runtime-scan/source-sha.txt\"\n.github/workflows/security-scan.yml-308-          printf '%s\\n' \"$DOCKERFILE\" \"$TARGET\" > \"$RUNNER_TEMP/runtime-scan/build-target.txt\"\n.github/workflows/security-scan.yml-309-          docker image inspect \"$IMAGE\" > \"$RUNNER_TEMP/runtime-scan/image-inspect.json\"\n.github/workflows/security-scan.yml-310-          df -B1 / \"$RUNNER_TEMP\" > \"$RUNNER_TEMP/runtime-scan/disk-before.txt\"\n.github/workflows/security-scan.yml-311-      - name: enforce runtime OS vulnerabilities and report application residual\n.github/workflows/security-scan.yml:312:        run: python3 -B tools/security/rescan_runtime_images.py --image \"$IMAGE\" --output \"$RUNNER_TEMP/runtime-scan/image.json\"\n.github/workflows/security-scan.yml-313-      - name: upload runtime reports and application/unfixed residuals\n.github/workflows/security-scan.yml-314-        if: always()\n.github/workflows/security-scan.yml-315-        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7\n.github/workflows/security-scan.yml-316-        with:\n.github/workflows/security-scan.yml-317-          name: runtime-rescan-${{ matrix.name }}\n.github/workflows/security-scan.yml-318-          path: ${{ runner.temp }}/runtime-scan\n.github/workflows/security-scan.yml-319-          if-no-files-found: error\n.github/workflows/security-scan.yml-320-          retention-days: 30\n","exit_code":0,"status":"completed"}}
