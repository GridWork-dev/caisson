{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/tenancy-rls/src/rls.ts'","aggregated_output":"     1\t// Fail-closed multi-tenant RLS (ADR-0005). `withTenant` is the SOLE entry to tenant data: it\n     2\t// opens a transaction, drops to the non-superuser `app` role, and binds `app.current_account`\n     3\t// for the life of the transaction. RLS policies read that GUC, so a query that forgets its\n     4\t// `WHERE account_id = …` still returns only the caller's rows — and a code path that forgets\n     5\t// `withTenant` entirely has no GUC bound and sees nothing. Fail-closed, by construction.\n     6\timport { TenancyError } from \"@caisson/kernel\";\n     7\t\n     8\t/** The Postgres GUC that carries the active account id into RLS policies. */\n     9\texport const TENANT_GUC = \"app.current_account\";\n    10\t\n    11\t/**\n    12\t * The Postgres GUC that carries the active USER id into RLS policies. Used only for the\n    13\t * identity→account resolution bootstrap (ADR-0176): \"which accounts does this user belong to?\" is a\n    14\t * cross-account read keyed by user, which the tenant GUC cannot express. A table that participates\n    15\t * in that lookup (e.g. `account_member`) carries a policy clause `user_id = current_setting(USER_GUC)`\n    16\t * ORed with the tenant clause. `withUser` binds this GUC and leaves the tenant GUC null (and vice\n    17\t * versa), so the two access paths never widen each other.\n    18\t */\n    19\texport const USER_GUC = \"app.current_user\";\n    20\t\n    21\t/** Minimal query surface — satisfied by PGlite, a PGlite transaction, and a pg/Drizzle client. */\n    22\texport interface TenantExecutor {\n    23\t  query<T = Record<string, unknown>>(\n    24\t    sql: string,\n    25\t    params?: unknown[],\n    26\t  ): Promise<{ rows: T[] }>;\n    27\t  exec(sql: string): Promise<unknown>;\n    28\t}\n    29\t\n    30\t/** A client that can open a transaction (PGlite, node-postgres pool, Drizzle db). */\n    31\texport interface Transactor {\n    32\t  transaction<T>(fn: (tx: TenantExecutor) => Promise<T>): Promise<T>;\n    33\t}\n    34\t\n    35\t/**\n    36\t * One-time, fail-closed role pre-flight (ADR-0005 hardening): `withTenant`/`withUser` trust the\n    37\t * role they `SET LOCAL ROLE` into is genuinely unprivileged. A SUPERUSER or BYPASSRLS role\n    38\t * silently no-ops `FORCE ROW LEVEL SECURITY`, reopening the cross-tenant leak with zero runtime\n    39\t * signal — this throws before that role is ever assumed. Never warns; a missing role is\n    40\t * refused too (fail-closed, not fail-open on a typo).\n    41\t */\n    42\tasync function assertRoleNotPrivileged(\n    43\t  tx: TenantExecutor,\n    44\t  role: string,\n    45\t): Promise<void> {\n    46\t  const { rows } = await tx.query<{\n    47\t    rolsuper: boolean;\n    48\t    rolbypassrls: boolean;\n    49\t  }>(`SELECT rolsuper, rolbypassrls FROM pg_roles WHERE rolname = $1`, [role]);\n    50\t  const row = rows[0];\n    51\t  if (!row || row.rolsuper || row.rolbypassrls) {\n    52\t    throw new TenancyError(\n    53\t      `Refusing to use role \"${role}\" for tenant isolation: it must exist and be neither SUPERUSER nor BYPASSRLS`,\n    54\t    );\n    55\t  }\n    56\t}\n    57\t\n    58\t/**\n    59\t * Runs once per distinct `(Transactor, role)` pair — the guard costs one extra catalog query per\n    60\t * role per `Transactor`, not per call. Kept keyed per-ROLE (not just per-db): `withTenant`/`withUser`\n    61\t * only ever vet `app` here today (the cross-tenant `admin_write` guard moved to @caisson/org-controls\n    62\t * with the admin-write seam, ADR-0257 §1.3, keeping its OWN independent guard), but the per-role shape\n    63\t * is the correct general form and costs nothing extra for a single role. A failed check is never\n    64\t * cached: fixing the misconfig un-wedges the very next call with no restart.\n    65\t */\n    66\tconst roleGuardChecked = new WeakMap<Transactor, Set<string>>();\n    67\t\n    68\tasync function ensureRoleGuard(\n    69\t  db: Transactor,\n    70\t  tx: TenantExecutor,\n    71\t  role: string,\n    72\t): Promise<void> {\n    73\t  const seen = roleGuardChecked.get(db);\n    74\t  if (seen?.has(role) === true) return;\n    75\t  await assertRoleNotPrivileged(tx, role);\n    76\t  if (seen === undefined) {\n    77\t    roleGuardChecked.set(db, new Set([role]));\n    78\t  } else {\n    79\t    seen.add(role);\n    80\t  }\n    81\t}\n    82\t\n    83\t/**\n    84\t * Run `fn` inside a transaction scoped to `accountId`: `SET LOCAL ROLE app` +\n    85\t * `set_config('app.current_account', accountId, true)`. The account id must come from a verified\n    86\t * session/JWT (ADR-0015) — never from request params. An empty id is refused outright (never run\n    87\t * unscoped).\n    88\t */\n    89\texport async function withTenant<T>(\n    90\t  db: Transactor,\n    91\t  accountId: string,\n    92\t  fn: (tx: TenantExecutor) => Promise<T>,\n    93\t): Promise<T> {\n    94\t  if (accountId.length === 0) {\n    95\t    throw new TenancyError(\n    96\t      \"Refusing to run a tenant query without an account id\",\n    97\t    );\n    98\t  }\n    99\t  return db.transaction(async (tx) => {\n   100\t    // Bind the GUC first (as the privileged role), then drop to `app` for the actual work.\n   101\t    await tx.query(`SELECT set_config($1, $2, true)`, [TENANT_GUC, accountId]);\n   102\t    await ensureRoleGuard(db, tx, \"app\");\n   103\t    await tx.exec(`SET LOCAL ROLE app`);\n   104\t    return fn(tx);\n   105\t  });\n   106\t}\n   107\t\n   108\t/**\n   109\t * Run `fn` inside a transaction scoped to a USER (not an account): binds `app.current_user` +\n   110\t * `SET LOCAL ROLE app`. The ONLY sanctioned use is the identity→account bootstrap (ADR-0176) — a\n   111\t * signed-in user reading their own `account_member` rows across accounts to resolve which accounts\n   112\t * they belong to. Fail-closed like `withTenant`: an empty user id is refused, and a table without a\n   113\t * matching `user_id` policy clause returns nothing. The user id must come from a verified session,\n   114\t * never a request param.\n   115\t */\n   116\texport async function withUser<T>(\n   117\t  db: Transactor,\n   118\t  userId: string,\n   119\t  fn: (tx: TenantExecutor) => Promise<T>,\n   120\t): Promise<T> {\n   121\t  if (userId.length === 0) {\n   122\t    throw new TenancyError(\n   123\t      \"Refusing to run a user-scoped query without a user id\",\n   124\t    );\n   125\t  }\n   126\t  return db.transaction(async (tx) => {\n   127\t    await tx.query(`SELECT set_config($1, $2, true)`, [USER_GUC, userId]);\n   128\t    await ensureRoleGuard(db, tx, \"app\");\n   129\t    await tx.exec(`SET LOCAL ROLE app`);\n   130\t    return fn(tx);\n   131\t  });\n   132\t}\n   133\t\n   134\texport interface TenantPolicyOptions {\n   135\t  /** The tenant-key column. Default `account_id`. */\n   136\t  column?: string;\n   137\t  /** The role policies apply to (it must NOT be a superuser / BYPASSRLS). Default `app`. */\n   138\t  role?: string;\n   139\t}\n   140\t\n   141\t/**\n   142\t * SQL that makes `table` fail-closed tenant-isolated: ENABLE + **FORCE** RLS, GRANT CRUD to the\n   143\t * app role, and a policy that admits a row only when its tenant column equals the bound GUC.\n   144\t * Emitted into the table's migration (ADR-0014) so a tenant table can never ship without it.\n   145\t *\n   146\t * The GUC read is wrapped in `NULLIF(..., '')` (pgbouncer/pooler hardening): a pooled connection\n   147\t * that resets custom GUCs to `''` instead of fully unsetting them (a known transaction-pooling\n   148\t * behavior — some poolers' reset query converges a custom parameter to its declared default rather\n   149\t * than removing it) would otherwise compare `column = ''` — a coincidental deny only for as long as\n   150\t * no row's tenant column is literally the empty string. `NULLIF` folds `''` to `NULL` first, so the\n   151\t * comparison is always `NULL` (deny) regardless of what any row's column value happens to be.\n   152\t */\n   153\texport function buildTenantPolicySql(\n   154\t  table: string,\n   155\t  { column = \"account_id\", role = \"app\" }: TenantPolicyOptions = {},\n   156\t): string {\n   157\t  const guc = `NULLIF(current_setting('${TENANT_GUC}', true), '')`;\n   158\t  return [\n   159\t    `ALTER TABLE ${table} ENABLE ROW LEVEL SECURITY;`,\n   160\t    `ALTER TABLE ${table} FORCE ROW LEVEL SECURITY;`,\n   161\t    `GRANT SELECT, INSERT, UPDATE, DELETE ON ${table} TO ${role};`,\n   162\t    `CREATE POLICY ${table}_tenant_isolation ON ${table}`,\n   163\t    `  USING (${column} = ${guc})`,\n   164\t    `  WITH CHECK (${column} = ${guc});`,\n   165\t  ].join(\"\\n\");\n   166\t}\n   167\t\n   168\t// The cross-tenant admin-WRITE seam (ADMIN_WRITE_ROLE, ADMIN_WRITE_ROLE_BOOTSTRAP_SQL,\n   169\t// buildAdminWritePolicySql, buildAdminSelectPolicySql, withAdminWrite, AdminWritePolicyOptions) moved\n   170\t// to the commercial @caisson/org-controls (ADR-0257 §1.3). This open package keeps ONLY the buyer\n   171\t// tenant-isolation floor (withTenant/withUser + buildTenantPolicySql); the operator control plane\n   172\t// imports the admin-write layer from org-controls.\n","exit_code":0,"status":"completed"}}
