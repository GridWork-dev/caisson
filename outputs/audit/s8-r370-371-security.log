{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/lib/paddle-cart-transaction.ts'","aggregated_output":"     1\t// Server-only Paddle transaction creation. Secrets never cross the client boundary.\n     2\t// API contracts: developer.paddle.com/api-reference/{transactions/create-transaction,discounts/list-discounts}\n     3\timport { z } from \"zod\";\n     4\timport { fetchWithTimeout } from \"@caisson/kernel\";\n     5\t\n     6\tconst inputSchema = z\n     7\t  .object({\n     8\t    priceIds: z\n     9\t      .array(z.string().regex(/^pri_[a-z0-9]{26}$/))\n    10\t      .min(1)\n    11\t      .max(50),\n    12\t    accountId: z.string().trim().min(1).max(256),\n    13\t    promoCode: z\n    14\t      .string()\n    15\t      .trim()\n    16\t      .min(1)\n    17\t      .max(64)\n    18\t      .regex(/^[A-Za-z0-9_-]+$/)\n    19\t      .optional(),\n    20\t  })\n    21\t  .strict();\n    22\t// Third-party responses tolerate additive provider fields, validating only consumed fields.\n    23\tconst transactionSchema = z.object({\n    24\t  data: z.object({ id: z.string().regex(/^txn_[a-z0-9]{26}$/) }),\n    25\t});\n    26\tconst discountsSchema = z.object({\n    27\t  data: z.array(\n    28\t    z.object({\n    29\t      id: z.string().regex(/^dsc_[a-z0-9]{26}$/),\n    30\t      code: z.string().nullable(),\n    31\t      status: z.string(),\n    32\t      enabled_for_checkout: z.boolean(),\n    33\t    }),\n    34\t  ),\n    35\t});\n    36\t\n    37\texport async function createPaddleCartTransaction(\n    38\t  raw: z.infer<typeof inputSchema>,\n    39\t  fetchImpl: typeof fetchWithTimeout = fetchWithTimeout,\n    40\t): Promise<string> {\n    41\t  const input = inputSchema.parse(raw);\n    42\t  const key = process.env.PADDLE_API_KEY;\n    43\t  if (!key) throw new Error(\"Checkout is not configured\");\n    44\t  const base =\n    45\t    process.env.PADDLE_ENV === \"production\"\n    46\t      ? \"https://api.paddle.com\"\n    47\t      : \"https://sandbox-api.paddle.com\";\n    48\t  const headers = {\n    49\t    authorization: `Bearer ${key}`,\n    50\t    \"content-type\": \"application/json\",\n    51\t  };\n    52\t  let discountId: string | undefined;\n    53\t  if (input.promoCode !== undefined) {\n    54\t    const url = new URL(`${base}/discounts`);\n    55\t    url.searchParams.set(\"code\", input.promoCode);\n    56\t    url.searchParams.set(\"status\", \"active\");\n    57\t    const response = await fetchImpl(\n    58\t      url.toString(),\n    59\t      { headers, redirect: \"error\" },\n    60\t      { timeoutMs: 15_000 },\n    61\t    );\n    62\t    if (!response.ok) throw new Error(\"Discount lookup unavailable\");\n    63\t    const discounts = discountsSchema.parse(await response.json()).data;\n    64\t    const matches = discounts.filter(\n    65\t      (item) =>\n    66\t        item.status === \"active\" &&\n    67\t        item.enabled_for_checkout &&\n    68\t        item.code?.toLowerCase() === input.promoCode?.toLowerCase(),\n    69\t    );\n    70\t    if (matches.length !== 1) throw new Error(\"Discount unavailable\");\n    71\t    discountId = matches[0]!.id;\n    72\t  }\n    73\t  const response = await fetchImpl(\n    74\t    `${base}/transactions`,\n    75\t    {\n    76\t      method: \"POST\",\n    77\t      headers,\n    78\t      redirect: \"error\",\n    79\t      body: JSON.stringify({\n    80\t        collection_mode: \"automatic\",\n    81\t        items: input.priceIds.map((price_id) => ({ price_id, quantity: 1 })),\n    82\t        custom_data: { account_id: input.accountId },\n    83\t        ...(discountId === undefined ? {} : { discount_id: discountId }),\n    84\t      }),\n    85\t    },\n    86\t    { timeoutMs: 15_000 },\n    87\t  );\n    88\t  if (!response.ok) throw new Error(\"Transaction creation unavailable\");\n    89\t  return transactionSchema.parse(await response.json()).data.id;\n    90\t}\n","exit_code":0,"status":"completed"}}
