{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba tools/security/rescan_runtime_images.py'","aggregated_output":"     1\t\"\"\"Build matrix and enforcing scanner for actual first-party runtime images.\"\"\"\n     2\t\n     3\timport argparse\n     4\timport json\n     5\tfrom pathlib import Path\n     6\timport re\n     7\t\n     8\tfrom image_scan_policy import scan_image\n     9\tfrom rescan_base_images import census\n    10\t\n    11\t\n    12\tdef runtime_targets(root: Path) -> dict:\n    13\t    report = census(root)\n    14\t    targets = []\n    15\t    for path in report[\"dockerfiles\"]:\n    16\t        # census has already rejected unsupported FROM syntax and unpinned sources.\n    17\t        stages = []\n    18\t        for line in (root / path).read_text().splitlines():\n    19\t            if re.match(r\"^\\s*FROM\\s\", line, re.IGNORECASE):\n    20\t                parts = line.split()\n    21\t                stages.append(parts[-1] if len(parts) >= 4 and parts[-2].lower() == \"as\" else \"\")\n    22\t        if not stages:\n    23\t            raise ValueError(f\"{path}: no runtime stage\")\n    24\t        selected = list(dict.fromkeys([stages[-1], *[s for s in stages if s.lower() == \"migrate\"]]))\n    25\t        for stage in selected:\n    26\t            name = re.sub(r\"[^a-z0-9-]\", \"-\", path.lower()) + \"-\" + (stage or \"final\")\n    27\t            targets.append({\"name\": name, \"dockerfile\": path, \"target\": stage, \"context\": \".\"})\n    28\t    return {\"include\": targets}\n    29\t\n    30\t\n    31\tdef main() -> int:\n    32\t    parser = argparse.ArgumentParser(description=__doc__)\n    33\t    parser.add_argument(\"--matrix\", action=\"store_true\")\n    34\t    parser.add_argument(\"--image\")\n    35\t    parser.add_argument(\"--output\", type=Path)\n    36\t    args = parser.parse_args()\n    37\t    root = Path(__file__).resolve().parents[2]\n    38\t    if args.matrix:\n    39\t        print(json.dumps(runtime_targets(root)))\n    40\t        return 0\n    41\t    if not args.image or args.output is None:\n    42\t        parser.error(\"--image and --output are required for runtime scans\")\n    43\t    if not re.fullmatch(r\"caisson-runtime-rescan:[a-z0-9-]+\", args.image):\n    44\t        parser.error(\"runtime image must be a local caisson-runtime-rescan tag\")\n    45\t    return scan_image(args.image, args.output.resolve(), \"runtime\")\n    46\t\n    47\t\n    48\tif __name__ == \"__main__\":\n    49\t    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n -C 10 \\\"workflow_dispatch|release:|permissions:|uses: actions/checkout|persist-credentials|ref:|tag|dry_run|confirm|npm|publish|attest|provenance|TOKEN|secrets\\\\.|github\\\\.sha|github\\\\.event|pull_request_target|contents: write|id-token\\\" .github/workflows/publish.yml .github/workflows/version-pr.yml .github/workflows/mirror-sync.yml .github/workflows/publish-image.yml .github/workflows/release-train.yml .github/workflows/deploy-railway.yml registry/scripts/ci-publish-step.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n -C 10 \\\"workflow_dispatch|release:|permissions:|uses: actions/checkout|persist-credentials|ref:|tag|dry_run|confirm|npm|publish|attest|provenance|TOKEN|secrets\\\\.|github\\\\.sha|github\\\\.event|pull_request_target|contents: write|id-token\\\" .github/workflows/publish.yml .github/workflows/version-pr.yml .github/workflows/mirror-sync.yml .github/workflows/publish-image.yml .github/workflows/release-train.yml .github/workflows/deploy-railway.yml registry/scripts/ci-publish-step.ts\"","aggregated_output":".github/workflows/deploy-railway.yml-1-name: deploy-railway\n.github/workflows/deploy-railway.yml-2-# Automated redeploy of the apps/site Next app (marketing + docs + /dashboard), the apps/demos\n.github/workflows/deploy-railway.yml-3-# service it rewrites /demos/* to (ADR-0400), apps/admin, and — since ADR-0414 — the two services\n.github/workflows/deploy-railway.yml-4-# that had NO automated deploy path at all: services/docs (the RAG API) and services/support-bot\n.github/workflows/deploy-railway.yml-5-# (the Discord bot). Plus services/license on dispatch. This is the whole Railway fleet.\n.github/workflows/deploy-railway.yml-6-# Build-on-Railway via the service's RAILWAY_DOCKERFILE_PATH=apps/site/Dockerfile env var (set on the\n.github/workflows/deploy-railway.yml-7-# Railway service, not here). Touches NO DNS and NO CF Access.\n.github/workflows/deploy-railway.yml-8-#\n.github/workflows/deploy-railway.yml:9:# ARMED since 2026-07-29: RAILWAY_TOKEN (a project token scoped to caisson-prod) is a repo secret and\n.github/workflows/deploy-railway.yml-10-# this workflow deploys for real. The arm guard below stays, because it is what keeps the workflow\n.github/workflows/deploy-railway.yml-11-# honest if the secret is ever rotated out or revoked: the guard step reads the token and SKIPS every\n.github/workflows/deploy-railway.yml-12-# real step when it is absent, so a push-triggered run degrades to a GREEN no-op rather than reddening\n.github/workflows/deploy-railway.yml-13-# main. ONE EXCEPTION: a caller that passes `require_armed=true` (the release train's leg 4) gets a hard\n.github/workflows/deploy-railway.yml-14-# FAILURE instead of the green skip, because a train that reports a deploy it never performed is worse\n.github/workflows/deploy-railway.yml-15-# than a red leg.\n.github/workflows/deploy-railway.yml-16-# The static-export deploy-site.yml (Cloudflare Pages) it once coexisted with is already retired (its\n.github/workflows/deploy-railway.yml-17-# CI half); deleting the Pages project itself is the DEPLOY-class teardown step C7.\n.github/workflows/deploy-railway.yml-18-on:\n.github/workflows/deploy-railway.yml-19-  push:\n--\n.github/workflows/deploy-railway.yml-41-      - \"packages/**\"\n.github/workflows/deploy-railway.yml-42-      - \"tooling/audit-harness/**\"\n.github/workflows/deploy-railway.yml-43-      - \"tooling/demo-registry/**\"\n.github/workflows/deploy-railway.yml-44-      - \".github/workflows/deploy-railway.yml\"\n.github/workflows/deploy-railway.yml-45-      # Root dep manifests: a root-only dependency bump (override/lockfile) changes every\n.github/workflows/deploy-railway.yml-46-      # service's built bytes but matched nothing above — the 2026-08-10 dep wave (#425,\n.github/workflows/deploy-railway.yml-47-      # dompurify XSS fix in the site bundle) shipped with no auto-deploy and needed a\n.github/workflows/deploy-railway.yml-48-      # manual dispatch.\n.github/workflows/deploy-railway.yml-49-      - \"package.json\"\n.github/workflows/deploy-railway.yml-50-      - \"bun.lock\"\n.github/workflows/deploy-railway.yml:51:  workflow_dispatch:\n.github/workflows/deploy-railway.yml-52-    inputs:\n.github/workflows/deploy-railway.yml:53:      ref:\n.github/workflows/deploy-railway.yml-54-        description: \"The git ref to deploy (checked out, ancestry-verified, archived clean)\"\n.github/workflows/deploy-railway.yml-55-        required: false\n.github/workflows/deploy-railway.yml-56-        default: \"\"\n.github/workflows/deploy-railway.yml-57-      require_armed:\n.github/workflows/deploy-railway.yml:58:        description: \"Set 'true' to FAIL when RAILWAY_TOKEN is absent instead of skipping green (the release train passes this)\"\n.github/workflows/deploy-railway.yml-59-        required: false\n.github/workflows/deploy-railway.yml-60-        default: \"false\"\n.github/workflows/deploy-railway.yml-61-\n.github/workflows/deploy-railway.yml:62:permissions:\n.github/workflows/deploy-railway.yml-63-  contents: read\n.github/workflows/deploy-railway.yml-64-\n.github/workflows/deploy-railway.yml-65-concurrency:\n.github/workflows/deploy-railway.yml-66-  group: deploy-railway\n.github/workflows/deploy-railway.yml-67-  cancel-in-progress: false\n.github/workflows/deploy-railway.yml-68-\n.github/workflows/deploy-railway.yml-69-jobs:\n.github/workflows/deploy-railway.yml-70-  deploy:\n.github/workflows/deploy-railway.yml-71-    # Blacksmith-only fleet (operator directive 2026-07-19, ADR-0365 lock-1 provision): the last\n.github/workflows/deploy-railway.yml-72-    # hosted job followed the rest after the free-minute exhaustion made it a permanent zero-step\n.github/workflows/deploy-railway.yml:73:    # red. Operator lock ADR-0367: this job STAYS on Blacksmith even once RAILWAY_TOKEN arms —\n.github/workflows/deploy-railway.yml-74-    # VM-per-job isolation + a Railway-scoped revocable deploy credential is the accepted posture.\n.github/workflows/deploy-railway.yml-75-    runs-on: ${{ vars.CI_RUNNER_LINUX || 'ubuntu-latest' }}\n.github/workflows/deploy-railway.yml-76-    # This cap MUST exceed the sum of the steps' own poll budgets, or it silently reintroduces at\n.github/workflows/deploy-railway.yml-77-    # the JOB level the exact defect it was raised to fix at the STEP level. The budgets are 15 min\n.github/workflows/deploy-railway.yml-78-    # each (railway-deploy.ts's default) except docs at 40:\n.github/workflows/deploy-railway.yml-79-    #   push path      admin 15 + demos 15 + site 15 + docs 40 + bot 15  = 100 min\n.github/workflows/deploy-railway.yml-80-    #   dispatch path  + license 15                                      = 115 min\n.github/workflows/deploy-railway.yml-81-    # plus setup (a fetch-depth:0 checkout of a 72-workspace monorepo, setup-bun, the railway CLI\n.github/workflows/deploy-railway.yml-82-    # install) ≈ 2-5 min. 125 covers the dispatch ceiling with headroom.\n.github/workflows/deploy-railway.yml-83-    #\n.github/workflows/deploy-railway.yml-84-    # 25 was the original value, already EXACTLY equal to caisson-docs' railway.toml\n.github/workflows/deploy-railway.yml-85-    # healthcheckTimeout (1500s). A first pass raised it to 70 reasoning \"five fast services plus\n.github/workflows/deploy-railway.yml-86-    # one docs boot\" — self-refuting arithmetic: five services at the 15-minute default is 75\n.github/workflows/deploy-railway.yml-87-    # before docs' 40 is counted at all. A job-level cancel is strictly worse than a step timeout:\n.github/workflows/deploy-railway.yml-88-    # no \"timed out waiting for the X deployment\" diagnostic is printed (that only fires when a\n.github/workflows/deploy-railway.yml-89-    # STEP budget expires), and the likeliest cancellation point is the LAST step — leaving a new\n.github/workflows/deploy-railway.yml-90-    # docs API serving an old bot, the exact skew the docs -> support-bot order exists to prevent.\n.github/workflows/deploy-railway.yml-91-    timeout-minutes: 125\n.github/workflows/deploy-railway.yml-92-    steps:\n.github/workflows/deploy-railway.yml:93:      # Inert-until-armed guard: `secrets` can't be referenced in a job/step `if:`, so map RAILWAY_TOKEN\n.github/workflows/deploy-railway.yml:94:      # to an env here and publish an `armed` output. Absent token → armed=false → every step below skips\n.github/workflows/deploy-railway.yml-95-      # → the job succeeds as a no-op. This is what keeps main GREEN before the operator provisions the\n.github/workflows/deploy-railway.yml-96-      # token; it does NOT arm the deploy (no token is added here — it self-arms when the secret is set).\n.github/workflows/deploy-railway.yml:97:      - name: arm check (RAILWAY_TOKEN present?)\n.github/workflows/deploy-railway.yml-98-        id: guard\n.github/workflows/deploy-railway.yml-99-        env:\n.github/workflows/deploy-railway.yml:100:          RAILWAY_TOKEN: ${{ secrets.RAILWAY_TOKEN }}\n.github/workflows/deploy-railway.yml:101:          REQUIRE_ARMED: ${{ github.event.inputs.require_armed || 'false' }}\n.github/workflows/deploy-railway.yml-102-        run: |\n.github/workflows/deploy-railway.yml:103:          if [ -n \"${RAILWAY_TOKEN}\" ]; then\n.github/workflows/deploy-railway.yml-104-            echo \"armed=true\" >> \"$GITHUB_OUTPUT\"\n.github/workflows/deploy-railway.yml-105-          elif [ \"${REQUIRE_ARMED}\" = \"true\" ]; then\n.github/workflows/deploy-railway.yml-106-            # Called by an ARMED release train. A green skip here is a false green of the worst\n.github/workflows/deploy-railway.yml-107-            # kind: the train reports every leg passed while the site still serves the previous\n.github/workflows/deploy-railway.yml-108-            # image, and the only thing that catches it is someone reading the live page. Leg 1\n.github/workflows/deploy-railway.yml:109:            # (registry publish) already refuses to no-op with missing credentials for exactly\n.github/workflows/deploy-railway.yml-110-            # this reason; this is that rule applied to the deploy leg.\n.github/workflows/deploy-railway.yml:111:            echo \"::error::deploy-railway was called with require_armed=true but RAILWAY_TOKEN is not set — refusing to report a green deploy that shipped nothing. Arm the secret, or deploy from the operator box with tooling/scripts/railway-deploy.ts.\"\n.github/workflows/deploy-railway.yml-112-            exit 1\n.github/workflows/deploy-railway.yml-113-          else\n.github/workflows/deploy-railway.yml-114-            echo \"armed=false\" >> \"$GITHUB_OUTPUT\"\n.github/workflows/deploy-railway.yml:115:            echo \"::notice::deploy-railway is inert — RAILWAY_TOKEN not set; skipping deploy (operator arms at cutover C2)\"\n.github/workflows/deploy-railway.yml-116-          fi\n.github/workflows/deploy-railway.yml:117:      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7\n.github/workflows/deploy-railway.yml-118-        if: steps.guard.outputs.armed == 'true'\n.github/workflows/deploy-railway.yml-119-        with:\n.github/workflows/deploy-railway.yml-120-          # Full history: tooling/scripts/railway-deploy.ts resolves --ref and checks its ancestry\n.github/workflows/deploy-railway.yml-121-          # against origin/main itself, so the checkout needs every commit + branch it might touch.\n.github/workflows/deploy-railway.yml-122-          fetch-depth: 0\n.github/workflows/deploy-railway.yml-123-      # A manual dispatch can leave `ref` blank; default to the SHA that triggered this run (the\n.github/workflows/deploy-railway.yml:124:      # push SHA, or the workflow_dispatch ref's tip) — mirrors publish.yml's tag-defaulting.\n.github/workflows/deploy-railway.yml-125-      - name: resolve deploy ref\n.github/workflows/deploy-railway.yml-126-        if: steps.guard.outputs.armed == 'true'\n.github/workflows/deploy-railway.yml-127-        id: resolve-ref\n.github/workflows/deploy-railway.yml-128-        env:\n.github/workflows/deploy-railway.yml:129:          RAW_REF: ${{ github.event.inputs.ref }}\n.github/workflows/deploy-railway.yml-130-        run: |\n.github/workflows/deploy-railway.yml:131:          echo \"ref=${RAW_REF:-${{ github.sha }}}\" >> \"$GITHUB_OUTPUT\"\n.github/workflows/deploy-railway.yml-132-      - name: fetch origin/main (ancestry check needs it)\n.github/workflows/deploy-railway.yml-133-        if: steps.guard.outputs.armed == 'true'\n.github/workflows/deploy-railway.yml-134-        run: git fetch origin main --quiet\n.github/workflows/deploy-railway.yml-135-      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0\n.github/workflows/deploy-railway.yml-136-        if: steps.guard.outputs.armed == 'true'\n.github/workflows/deploy-railway.yml-137-        with:\n.github/workflows/deploy-railway.yml-138-          bun-version: \"1.4.2\"\n.github/workflows/deploy-railway.yml-139-      - name: install Railway CLI\n.github/workflows/deploy-railway.yml-140-        if: steps.guard.outputs.armed == 'true'\n.github/workflows/deploy-railway.yml-141-        run: bun add -g @railway/cli@5.23.3\n.github/workflows/deploy-railway.yml-142-      # Immutable-input deploy: resolves the ref to a commit, refuses one that isn't an ancestor\n.github/workflows/deploy-railway.yml:143:      # of origin/main, stages a CLEAN `git archive` tree (no dirty working-tree state, no\n.github/workflows/deploy-railway.yml:144:      # untracked cruft, git's own normalized file modes), runs `railway up` from that staging\n.github/workflows/deploy-railway.yml-145-      # dir, and appends a single-use receipt — never a bare `railway up` off the live checkout.\n.github/workflows/deploy-railway.yml-146-      #\n.github/workflows/deploy-railway.yml-147-      # ORDER IS LOAD-BEARING: admin -> license -> site. Two independent constraints pin it:\n.github/workflows/deploy-railway.yml-148-      #\n.github/workflows/deploy-railway.yml-149-      # 1. Verifier before issuer, on BOTH credential layers. admin verifies the internal-proof\n.github/workflows/deploy-railway.yml-150-      #    bearer that site issues, and admin + the registry Worker (leg 1b, already live) verify\n.github/workflows/deploy-railway.yml:151:      #    the license TOKENS that services/license mints. The verifier must already understand\n.github/workflows/deploy-railway.yml-152-      #    every format the live issuer can send, which only verifier-first guarantees: a new\n.github/workflows/deploy-railway.yml-153-      #    issuer against an old verifier is a hard 401 on every buyer's evidence dashboard (the\n.github/workflows/deploy-railway.yml-154-      #    pre-F3 verifier regex `^Bearer ([0-9a-f]{64})$` could not match a\n.github/workflows/deploy-railway.yml-155-      #    `<unix-seconds>.<hmac>` credential at all). Found by the v2026.07.30 release audit:\n.github/workflows/deploy-railway.yml-156-      #    until then this job deployed ONLY caisson-site, so no admin change had ever ridden the\n.github/workflows/deploy-railway.yml-157-      #    train and admin silently drifted behind main. The dual-format acceptance that made the\n.github/workflows/deploy-railway.yml-158-      #    F3 rollout itself safe is GONE as of 2026-07-31 (see internal-proof-auth.ts) — that was\n.github/workflows/deploy-railway.yml-159-      #    a one-release transition, not the rule. The rule is this ordering.\n.github/workflows/deploy-railway.yml-160-      #\n.github/workflows/deploy-railway.yml-161-      # 2. Schema before the image that reads it. license's `preDeployCommand`\n--\n.github/workflows/deploy-railway.yml-168-      #\n.github/workflows/deploy-railway.yml-169-      # admin -> license -> demos -> site satisfies both: admin (verifier of both credentials)\n.github/workflows/deploy-railway.yml-170-      # leads, license follows its verifiers and applies the schema, demos lands before the image\n.github/workflows/deploy-railway.yml-171-      # whose rewrite points at it (ADR-0400), and site lands last on the schema it needs. The\n.github/workflows/deploy-railway.yml-172-      # launch runbook's \"license issuer last\" was only safe because its step 5 applies the\n.github/workflows/deploy-railway.yml-173-      # migration chain BY HAND before step 6 — this workflow has no hand-applied step 5, so the\n.github/workflows/deploy-railway.yml-174-      # migration carrier cannot go last here.\n.github/workflows/deploy-railway.yml-175-      #\n.github/workflows/deploy-railway.yml-176-      # 3. ADR-0414 appends docs -> support-bot AFTER site, in that order, on the same\n.github/workflows/deploy-railway.yml-177-      #    dependency-before-dependent rule that puts demos before site: the bot READS the docs\n.github/workflows/deploy-railway.yml:178:      #    service (DOCS_SERVICE_URL=https://docs-api.caisson.sh, DOCS_SERVICE_TOKEN shared —\n.github/workflows/deploy-railway.yml-179-      #    services/support-bot/railway.toml), so the API it queries must already be serving this\n.github/workflows/deploy-railway.yml-180-      #    release before the client that queries it goes live. They go after site rather than\n.github/workflows/deploy-railway.yml-181-      #    before it because nothing in the site image points at either, and because docs is the\n.github/workflows/deploy-railway.yml-182-      #    slowest leg by an order of magnitude — putting a 20-minute cold-boot re-embed ahead of\n.github/workflows/deploy-railway.yml-183-      #    the buyer-facing site deploy would delay every release's most visible surface behind\n.github/workflows/deploy-railway.yml-184-      #    the least visible one.\n.github/workflows/deploy-railway.yml-185-      - name: deploy apps/admin to Railway (verifier — MUST precede both issuers)\n.github/workflows/deploy-railway.yml-186-        if: steps.guard.outputs.armed == 'true'\n.github/workflows/deploy-railway.yml-187-        env:\n.github/workflows/deploy-railway.yml:188:          RAILWAY_TOKEN: ${{ secrets.RAILWAY_TOKEN }}\n.github/workflows/deploy-railway.yml-189-          DEPLOY_REF: ${{ steps.resolve-ref.outputs.ref }}\n.github/workflows/deploy-railway.yml-190-        run: |\n.github/workflows/deploy-railway.yml-191-          bun tooling/scripts/railway-deploy.ts \\\n.github/workflows/deploy-railway.yml-192-            --service caisson-admin \\\n.github/workflows/deploy-railway.yml-193-            --ref \"$DEPLOY_REF\"\n.github/workflows/deploy-railway.yml-194-      # Including license AT ALL is the fix for a class the parity probe caught 2026-07-31: license\n.github/workflows/deploy-railway.yml-195-      # bakes registry/index.json into its image exactly as the Worker bundle and the admin image\n.github/workflows/deploy-railway.yml-196-      # do, but leg 4 deployed only admin and site. So every release moved repo, Worker and admin\n.github/workflows/deploy-railway.yml-197-      # onto the new index and left license serving the previous one (`4810e38157c1` vs\n.github/workflows/deploy-railway.yml-198-      # `dc5ee000aebf`, one full release behind, closed by a hand redeploy).\n.github/workflows/deploy-railway.yml-199-      #\n.github/workflows/deploy-railway.yml-200-      # DISPATCH-ONLY, deliberately. license is the ONLY one of the three carrying a\n.github/workflows/deploy-railway.yml-201-      # preDeployCommand, so putting it on the automatic push-triggered path would run schema\n.github/workflows/deploy-railway.yml-202-      # migrations against production on any merge touching packages/**, unattended. A\n.github/workflows/deploy-railway.yml:203:      # workflow_dispatch is an explicit act: the release train's leg 4, or an operator by hand.\n.github/workflows/deploy-railway.yml-204-      # Push-triggered runs keep deploying admin and site only, exactly as before — which also\n.github/workflows/deploy-railway.yml-205-      # means a push-triggered site deploy carrying a new migration still needs the operator (or\n.github/workflows/deploy-railway.yml-206-      # the train) to run the license leg; that gap is the price of never migrating unattended.\n.github/workflows/deploy-railway.yml-207-      - name: deploy services/license to Railway (token issuer + migration carrier; dispatch only)\n.github/workflows/deploy-railway.yml:208:        if: steps.guard.outputs.armed == 'true' && github.event_name == 'workflow_dispatch'\n.github/workflows/deploy-railway.yml-209-        env:\n.github/workflows/deploy-railway.yml:210:          RAILWAY_TOKEN: ${{ secrets.RAILWAY_TOKEN }}\n.github/workflows/deploy-railway.yml-211-          DEPLOY_REF: ${{ steps.resolve-ref.outputs.ref }}\n.github/workflows/deploy-railway.yml-212-        run: |\n.github/workflows/deploy-railway.yml-213-          bun tooling/scripts/railway-deploy.ts \\\n.github/workflows/deploy-railway.yml-214-            --service caisson-license \\\n.github/workflows/deploy-railway.yml-215-            --ref \"$DEPLOY_REF\"\n.github/workflows/deploy-railway.yml-216-      # apps/demos (ADR-0400) — the demo surface apps/site rewrites /demos/* to. It deploys BEFORE\n.github/workflows/deploy-railway.yml-217-      # site for the same reason license does: site's image points at it, so the target must\n.github/workflows/deploy-railway.yml-218-      # already be serving the release the pointer is shipped with. Deploying site first would put\n.github/workflows/deploy-railway.yml-219-      # a new set of embed URLs live against the previous demos image.\n.github/workflows/deploy-railway.yml-220-      #\n--\n.github/workflows/deploy-railway.yml-224-      # failure, which on an ARMED token would redden this job and skip the site deploy below it.\n.github/workflows/deploy-railway.yml-225-      # A missing entry would have been the safer failure, so the entry gates itself: the repo\n.github/workflows/deploy-railway.yml-226-      # variable CAISSON_DEMOS_ARMED must read exactly \"true\". `vars` (unlike `secrets`) is\n.github/workflows/deploy-railway.yml-227-      # readable in an `if:`, so this needs no guard step of its own. That variable has read \"true\"\n.github/workflows/deploy-railway.yml-228-      # since 2026-08-09, so the step now runs on every armed deploy; the gate stays because\n.github/workflows/deploy-railway.yml-229-      # clearing the variable is the documented way to take the demos surface out of the fleet\n.github/workflows/deploy-railway.yml-230-      # without editing this file.\n.github/workflows/deploy-railway.yml-231-      - name: deploy apps/demos to Railway (rewrite target — MUST precede site)\n.github/workflows/deploy-railway.yml-232-        if: steps.guard.outputs.armed == 'true' && vars.CAISSON_DEMOS_ARMED == 'true'\n.github/workflows/deploy-railway.yml-233-        env:\n.github/workflows/deploy-railway.yml:234:          RAILWAY_TOKEN: ${{ secrets.RAILWAY_TOKEN }}\n.github/workflows/deploy-railway.yml-235-          DEPLOY_REF: ${{ steps.resolve-ref.outputs.ref }}\n.github/workflows/deploy-railway.yml-236-        run: |\n.github/workflows/deploy-railway.yml-237-          bun tooling/scripts/railway-deploy.ts \\\n.github/workflows/deploy-railway.yml-238-            --service caisson-demos \\\n.github/workflows/deploy-railway.yml-239-            --ref \"$DEPLOY_REF\"\n.github/workflows/deploy-railway.yml-240-      - name: deploy apps/site to Railway (immutable-input, receipt-gated)\n.github/workflows/deploy-railway.yml-241-        if: steps.guard.outputs.armed == 'true'\n.github/workflows/deploy-railway.yml-242-        env:\n.github/workflows/deploy-railway.yml:243:          RAILWAY_TOKEN: ${{ secrets.RAILWAY_TOKEN }}\n.github/workflows/deploy-railway.yml-244-          DEPLOY_REF: ${{ steps.resolve-ref.outputs.ref }}\n.github/workflows/deploy-railway.yml-245-        run: |\n.github/workflows/deploy-railway.yml-246-          bun tooling/scripts/railway-deploy.ts \\\n.github/workflows/deploy-railway.yml-247-            --service caisson-site \\\n.github/workflows/deploy-railway.yml-248-            --ref \"$DEPLOY_REF\"\n.github/workflows/deploy-railway.yml-249-      # services/docs — the RAG API behind docs-api.caisson.sh (ADR-0096/0105). ONE guard only,\n.github/workflows/deploy-railway.yml-250-      # the same `armed` check every other step uses: the service has existed and been Online\n.github/workflows/deploy-railway.yml-251-      # since 2026-06-30, so there is no missing-service hazard of the kind that earned demos its\n.github/workflows/deploy-railway.yml-252-      # second CAISSON_DEMOS_ARMED gate.\n.github/workflows/deploy-railway.yml-253-      #\n.github/workflows/deploy-railway.yml-254-      # --wait-minutes 40 is load-bearing, not padding. This service answers /health with a 503\n.github/workflows/deploy-railway.yml-255-      # {\"warming\":true} while it embeds its corpus, its railway.toml sets healthcheckTimeout=1500\n.github/workflows/deploy-railway.yml-256-      # (25 min), and DOCS_EMBED_PHASE_DEADLINE_MS is 20 min in the service env because the volume\n.github/workflows/deploy-railway.yml-257-      # embed-cache does not persist across boots — so a cold boot legitimately re-embeds from\n.github/workflows/deploy-railway.yml-258-      # scratch. railway-deploy.ts's default poll budget is 15 minutes; at the default this step\n.github/workflows/deploy-railway.yml-259-      # would throw \"timed out waiting for the deployment to reach a terminal state\" on a deploy\n.github/workflows/deploy-railway.yml-260-      # that was still succeeding, and take the support-bot step down with it.\n.github/workflows/deploy-railway.yml-261-      - name: deploy services/docs to Railway (RAG API — slow cold boot, see --wait-minutes)\n.github/workflows/deploy-railway.yml-262-        if: steps.guard.outputs.armed == 'true'\n.github/workflows/deploy-railway.yml-263-        env:\n.github/workflows/deploy-railway.yml:264:          RAILWAY_TOKEN: ${{ secrets.RAILWAY_TOKEN }}\n.github/workflows/deploy-railway.yml-265-          DEPLOY_REF: ${{ steps.resolve-ref.outputs.ref }}\n.github/workflows/deploy-railway.yml-266-        run: |\n.github/workflows/deploy-railway.yml-267-          bun tooling/scripts/railway-deploy.ts \\\n.github/workflows/deploy-railway.yml-268-            --service caisson-docs \\\n.github/workflows/deploy-railway.yml-269-            --ref \"$DEPLOY_REF\" \\\n.github/workflows/deploy-railway.yml-270-            --wait-minutes 40\n.github/workflows/deploy-railway.yml-271-      # services/support-bot — the Discord bot (ADR-0009/0105), the repo's only Python service.\n.github/workflows/deploy-railway.yml-272-      # LAST, and after docs on purpose: it is a CLIENT of the docs service above, so the API must\n.github/workflows/deploy-railway.yml-273-      # already serve this release before the bot that calls it restarts against it.\n.github/workflows/deploy-railway.yml-274-      - name: deploy services/support-bot to Railway (docs client — MUST follow docs)\n.github/workflows/deploy-railway.yml-275-        if: steps.guard.outputs.armed == 'true'\n.github/workflows/deploy-railway.yml-276-        env:\n.github/workflows/deploy-railway.yml:277:          RAILWAY_TOKEN: ${{ secrets.RAILWAY_TOKEN }}\n.github/workflows/deploy-railway.yml-278-          DEPLOY_REF: ${{ steps.resolve-ref.outputs.ref }}\n.github/workflows/deploy-railway.yml-279-        run: |\n.github/workflows/deploy-railway.yml-280-          bun tooling/scripts/railway-deploy.ts \\\n.github/workflows/deploy-railway.yml-281-            --service caisson-support-bot \\\n.github/workflows/deploy-railway.yml-282-            --ref \"$DEPLOY_REF\"\n--\n.github/workflows/mirror-sync.yml-5-# fresh export, and pushes ONE new commit (\"chore: mirror sync from <source sha>\") on top.\n.github/workflows/mirror-sync.yml-6-#\n.github/workflows/mirror-sync.yml-7-# APPEND-ONLY MODEL (ADR-0318 F2/F3 — supersedes the original force-push snapshot model): the\n.github/workflows/mirror-sync.yml-8-# mirror's history was backfilled once at the 2026-07-10 cut-over (gate-passing exporter runs at\n.github/workflows/mirror-sync.yml-9-# real historical SHAs, committed at cut-over — NEVER backdated; the real milestone date lives in\n.github/workflows/mirror-sync.yml-10-# the commit message only) and every sync since APPENDS. Never force-push here again — a rewrite\n.github/workflows/mirror-sync.yml-11-# would break clones/stars and violate the append-only lock. Development, blame, and PRs still\n.github/workflows/mirror-sync.yml-12-# live in THIS (private) repo; the mirror remains a generated read-only artifact (see\n.github/workflows/mirror-sync.yml-13-# scripts/mirror-assets/CONTRIBUTING.md).\n.github/workflows/mirror-sync.yml-14-#\n.github/workflows/mirror-sync.yml:15:# STAYS INERT UNTIL ARMED: MIRROR_PUSH_TOKEN (a fine-grained PAT scoped to contents:write on\n.github/workflows/mirror-sync.yml-16-# caisson-sh/caisson-oss ONLY) gates every real step via the guard below — absent token, the job\n.github/workflows/mirror-sync.yml-17-# runs as a GREEN no-op (same posture as deploy-railway.yml).\n.github/workflows/mirror-sync.yml-18-# TRIGGER: the release train (ADR-0318 R1/R2 — release-train.yml dispatches this as leg 2) or a\n.github/workflows/mirror-sync.yml-19-# manual dispatch. The per-main-push trigger is RETIRED (Kickoff M, W4): under the append-only\n.github/workflows/mirror-sync.yml-20-# mirror model a sync per push would mint a mirror commit per merge; the mirror advances per\n.github/workflows/mirror-sync.yml-21-# RELEASE instead.\n.github/workflows/mirror-sync.yml-22-on:\n.github/workflows/mirror-sync.yml:23:  workflow_dispatch:\n.github/workflows/mirror-sync.yml-24-    inputs:\n.github/workflows/mirror-sync.yml:25:      ref:\n.github/workflows/mirror-sync.yml:26:        # ADR-0325: the release train passes the release tag so the mirror export is anchored to\n.github/workflows/mirror-sync.yml-27-        # the SAME SHA as the tarballs/ledger. Empty (a manual dispatch) = default branch tip.\n.github/workflows/mirror-sync.yml:28:        description: \"Tag or SHA to export from (the release train passes the release tag)\"\n.github/workflows/mirror-sync.yml-29-        required: false\n.github/workflows/mirror-sync.yml-30-        default: \"\"\n.github/workflows/mirror-sync.yml-31-\n.github/workflows/mirror-sync.yml:32:permissions:\n.github/workflows/mirror-sync.yml-33-  contents: read\n.github/workflows/mirror-sync.yml-34-\n.github/workflows/mirror-sync.yml-35-concurrency:\n.github/workflows/mirror-sync.yml-36-  group: mirror-sync\n.github/workflows/mirror-sync.yml-37-  cancel-in-progress: false\n.github/workflows/mirror-sync.yml-38-\n.github/workflows/mirror-sync.yml-39-jobs:\n.github/workflows/mirror-sync.yml-40-  mirror-sync:\n.github/workflows/mirror-sync.yml-41-    # Blacksmith per ADR-0365 (fleet-only sweep; the cross-repo push token accepted on VM-per-job runners) → a write cred to\n.github/workflows/mirror-sync.yml:42:    # an external repo stays off the fleet, same posture as deploy-railway.yml's RAILWAY_TOKEN.\n.github/workflows/mirror-sync.yml-43-    runs-on: ${{ vars.CI_RUNNER_LINUX || 'ubuntu-latest' }}\n.github/workflows/mirror-sync.yml-44-    # Raised from 20 when the pre-push verification gate landed: the job now installs, builds, tests,\n.github/workflows/mirror-sync.yml-45-    # lints and format-checks the exported artifact on top of exporting it (~10 min locally).\n.github/workflows/mirror-sync.yml-46-    timeout-minutes: 30\n.github/workflows/mirror-sync.yml:47:    environment: release # ADR-0327 rider 2 parity — this job reads MIRROR_PUSH_TOKEN (a release-propagation leg)\n.github/workflows/mirror-sync.yml-48-    steps:\n.github/workflows/mirror-sync.yml-49-      # Inert-until-armed guard (mirrors deploy-railway.yml): `secrets` can't be read in a job/step\n.github/workflows/mirror-sync.yml:50:      # `if:`, so map it to an env here and publish an `armed` output. Absent token → every step\n.github/workflows/mirror-sync.yml-51-      # below skips → the job succeeds as a no-op instead of failing (the mirror repo may not exist\n.github/workflows/mirror-sync.yml-52-      # yet). Does NOT arm the sync itself — it self-arms when the operator sets the secret.\n.github/workflows/mirror-sync.yml:53:      - name: arm check (MIRROR_PUSH_TOKEN present?)\n.github/workflows/mirror-sync.yml-54-        id: guard\n.github/workflows/mirror-sync.yml-55-        env:\n.github/workflows/mirror-sync.yml:56:          MIRROR_PUSH_TOKEN: ${{ secrets.MIRROR_PUSH_TOKEN }}\n.github/workflows/mirror-sync.yml-57-        run: |\n.github/workflows/mirror-sync.yml:58:          if [ -n \"${MIRROR_PUSH_TOKEN}\" ]; then\n.github/workflows/mirror-sync.yml-59-            echo \"armed=true\" >> \"$GITHUB_OUTPUT\"\n.github/workflows/mirror-sync.yml-60-          else\n.github/workflows/mirror-sync.yml-61-            echo \"armed=false\" >> \"$GITHUB_OUTPUT\"\n.github/workflows/mirror-sync.yml:62:            echo \"::notice::mirror-sync is inert — MIRROR_PUSH_TOKEN not set; skipping (mirror repo may not exist yet)\"\n.github/workflows/mirror-sync.yml-63-          fi\n.github/workflows/mirror-sync.yml:64:      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7\n.github/workflows/mirror-sync.yml-65-        if: steps.guard.outputs.armed == 'true'\n.github/workflows/mirror-sync.yml-66-        with:\n.github/workflows/mirror-sync.yml-67-          # Empty ref = the checkout action's default (the dispatching branch tip).\n.github/workflows/mirror-sync.yml:68:          ref: ${{ github.event.inputs.ref }}\n.github/workflows/mirror-sync.yml-69-      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0\n.github/workflows/mirror-sync.yml-70-        if: steps.guard.outputs.armed == 'true'\n.github/workflows/mirror-sync.yml-71-        with:\n.github/workflows/mirror-sync.yml-72-          bun-version: \"1.4.2\"\n.github/workflows/mirror-sync.yml-73-      - name: install\n.github/workflows/mirror-sync.yml-74-        if: steps.guard.outputs.armed == 'true'\n.github/workflows/mirror-sync.yml-75-        run: bun install --frozen-lockfile\n.github/workflows/mirror-sync.yml-76-      - name: export public mirror\n.github/workflows/mirror-sync.yml-77-        if: steps.guard.outputs.armed == 'true'\n.github/workflows/mirror-sync.yml-78-        run: |\n--\n.github/workflows/mirror-sync.yml-125-          set -e\n.github/workflows/mirror-sync.yml-126-          find mirror-out -name node_modules -type d -prune -exec rm -rf {} +\n.github/workflows/mirror-sync.yml-127-          find mirror-out -name dist -type d -prune -exec rm -rf {} +\n.github/workflows/mirror-sync.yml-128-          find mirror-out -name '.turbo' -type d -prune -exec rm -rf {} +\n.github/workflows/mirror-sync.yml-129-          find mirror-out -name '*.tsbuildinfo' -delete\n.github/workflows/mirror-sync.yml-130-          rm -f mirror-out/bun.lock\n.github/workflows/mirror-sync.yml-131-          rm -rf mirror-out/.git\n.github/workflows/mirror-sync.yml-132-      - name: append sync commit to caisson-sh/caisson-oss (never force)\n.github/workflows/mirror-sync.yml-133-        if: steps.guard.outputs.armed == 'true'\n.github/workflows/mirror-sync.yml-134-        env:\n.github/workflows/mirror-sync.yml:135:          MIRROR_PUSH_TOKEN: ${{ secrets.MIRROR_PUSH_TOKEN }}\n.github/workflows/mirror-sync.yml-136-        run: |\n.github/workflows/mirror-sync.yml-137-          set -e\n.github/workflows/mirror-sync.yml-138-          SOURCE_SHA=\"$(git rev-parse --short HEAD)\"\n.github/workflows/mirror-sync.yml-139-          git clone --depth 1 --branch main -q \\\n.github/workflows/mirror-sync.yml:140:            \"https://x-access-token:${MIRROR_PUSH_TOKEN}@github.com/caisson-sh/caisson-oss.git\" mirror-clone\n.github/workflows/mirror-sync.yml-141-          # Replace the clone's working tree with the fresh export; .git stays, so the new\n.github/workflows/mirror-sync.yml-142-          # tree lands as ONE appended commit on the existing history (ADR-0318 append-only).\n.github/workflows/mirror-sync.yml-143-          find mirror-clone -mindepth 1 -maxdepth 1 -not -name .git -exec rm -rf {} +\n.github/workflows/mirror-sync.yml-144-          cp -r mirror-out/. mirror-clone/\n.github/workflows/mirror-sync.yml-145-          cd mirror-clone\n.github/workflows/mirror-sync.yml-146-          git config user.name \"github-actions[bot]\"\n.github/workflows/mirror-sync.yml-147-          git config user.email \"github-actions[bot]@users.no