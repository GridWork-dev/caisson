{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/tool-exec/src/approval-lifecycle.test.ts'","aggregated_output":"     1\timport { expect, test } from \"bun:test\";\n     2\timport { z } from \"zod\";\n     3\timport { NotFoundError, ValidationError } from \"@caisson/kernel\";\n     4\timport {\n     5\t  APPROVAL_TTL_MS,\n     6\t  createMemoryApprovalStore,\n     7\t  createToolExec,\n     8\t  type StoredToolApproval,\n     9\t  type ToolApprovalStore,\n    10\t} from \"./index.ts\";\n    11\t\n    12\tconst spec = {\n    13\t  name: \"echo\",\n    14\t  command: \"/bin/echo\",\n    15\t  argsSchema: z.array(z.string()),\n    16\t};\n    17\tfunction fixture(approvalStore?: ToolApprovalStore) {\n    18\t  let at = 1_800_000_000_000;\n    19\t  let spawns = 0;\n    20\t  const now = () => at;\n    21\t  const gate = createToolExec({\n    22\t    allowlist: [spec],\n    23\t    ...(approvalStore === undefined ? {} : { approvalStore }),\n    24\t    now,\n    25\t    execFn: async () => {\n    26\t      spawns++;\n    27\t      return { stdout: \"\", stderr: \"\", exitCode: 0 };\n    28\t    },\n    29\t  });\n    30\t  return {\n    31\t    gate,\n    32\t    now,\n    33\t    advance: (ms: number) => {\n    34\t      at += ms;\n    35\t    },\n    36\t    spawns: () => spawns,\n    37\t  };\n    38\t}\n    39\t\n    40\ttest(\"1000 rejected approvals reclaim capacity without spawning or replay\", async () => {\n    41\t  const f = fixture();\n    42\t  const pending = await Promise.all(\n    43\t    Array.from({ length: 1000 }, () => f.gate.propose(\"echo\", [])),\n    44\t  );\n    45\t  await expect(f.gate.propose(\"echo\", [])).rejects.toThrow(\"excess pending\");\n    46\t  const rejected = await Promise.all(\n    47\t    pending.map((p) => f.gate.reject(p.approvalId)),\n    48\t  );\n    49\t  expect(rejected.filter(Boolean)).toHaveLength(1000);\n    50\t  expect(f.spawns()).toBe(0);\n    51\t  expect(await f.gate.reject(pending[0]!.approvalId)).toBe(false);\n    52\t  await expect(f.gate.execute(pending[0])).rejects.toThrow(NotFoundError);\n    53\t  const fresh = await f.gate.propose(\"echo\", [\"fresh\"]);\n    54\t  expect((await f.gate.execute(fresh)).ok).toBe(true);\n    55\t  expect(f.spawns()).toBe(1);\n    56\t});\n    57\t\n    58\ttest(\"1000 expired approvals reclaim capacity on the next proposal\", async () => {\n    59\t  const f = fixture();\n    60\t  const pending = await Promise.all(\n    61\t    Array.from({ length: 1000 }, () => f.gate.propose(\"echo\", [])),\n    62\t  );\n    63\t  f.advance(APPROVAL_TTL_MS);\n    64\t  const fresh = await f.gate.propose(\"echo\", [\"fresh\"]);\n    65\t  await expect(f.gate.execute(pending[0])).rejects.toThrow(NotFoundError);\n    66\t  expect((await f.gate.execute(fresh)).ok).toBe(true);\n    67\t  expect(f.spawns()).toBe(1);\n    68\t});\n    69\t\n    70\ttest(\"approval lifetime is fifteen minutes and expires at the exact boundary\", async () => {\n    71\t  const f = fixture();\n    72\t  const valid = await f.gate.propose(\"echo\", []);\n    73\t  const expired = await f.gate.propose(\"echo\", []);\n    74\t  expect(APPROVAL_TTL_MS).toBe(900000);\n    75\t  expect(valid.expiresAt).toBe(f.now() + 900000);\n    76\t  f.advance(899999);\n    77\t  expect((await f.gate.execute(valid)).ok).toBe(true);\n    78\t  f.advance(1);\n    79\t  await expect(f.gate.execute(expired)).rejects.toThrow(NotFoundError);\n    80\t  expect(f.spawns()).toBe(1);\n    81\t  expect(await f.gate.reject(expired.approvalId)).toBe(false);\n    82\t});\n    83\t\n    84\ttest(\"memory consume deletes an expired record and never returns it\", async () => {\n    85\t  let at = 100;\n    86\t  const store = createMemoryApprovalStore(() => at);\n    87\t  const f = fixture(store);\n    88\t  const pending = await f.gate.propose(\"echo\", []);\n    89\t  at = pending.expiresAt;\n    90\t  expect(await store.consume(pending.approvalId)).toBeUndefined();\n    91\t  expect(await store.reject(pending.approvalId)).toBe(false);\n    92\t});\n    93\t\n    94\ttest(\"executor rejects an expired record returned by a durable adapter\", async () => {\n    95\t  let record: StoredToolApproval | undefined;\n    96\t  const f = fixture({\n    97\t    put: async (value) => {\n    98\t      record = structuredClone(value);\n    99\t    },\n   100\t    consume: async () => {\n   101\t      const found = record;\n   102\t      record = undefined;\n   103\t      return found;\n   104\t    },\n   105\t    reject: async () => {\n   106\t      const found = record !== undefined;\n   107\t      record = undefined;\n   108\t      return found;\n   109\t    },\n   110\t  });\n   111\t  const pending = await f.gate.propose(\"echo\", []);\n   112\t  f.advance(APPROVAL_TTL_MS);\n   113\t  await expect(f.gate.execute(pending)).rejects.toThrow(NotFoundError);\n   114\t  expect(f.spawns()).toBe(0);\n   115\t});\n   116\t\n   117\ttest(\"client cannot extend the digest-bound expiration\", async () => {\n   118\t  const f = fixture();\n   119\t  const pending = await f.gate.propose(\"echo\", []);\n   120\t  await expect(\n   121\t    f.gate.execute({ ...pending, expiresAt: pending.expiresAt + 1 }),\n   122\t  ).rejects.toThrow(ValidationError);\n   123\t  expect(f.spawns()).toBe(0);\n   124\t});\n   125\t\n   126\ttest(\"atomic reject wins against a later concurrent consume without executing\", async () => {\n   127\t  const f = fixture();\n   128\t  const pending = await f.gate.propose(\"echo\", []);\n   129\t  const results = await Promise.allSettled([\n   130\t    f.gate.reject(pending.approvalId),\n   131\t    f.gate.execute(pending),\n   132\t  ]);\n   133\t  expect(results[0]).toEqual({ status: \"fulfilled\", value: true });\n   134\t  expect(results[1]?.status).toBe(\"rejected\");\n   135\t  expect(f.spawns()).toBe(0);\n   136\t});\n   137\t\n   138\ttest(\"a consume that already won cannot be retroactively revoked\", async () => {\n   139\t  const f = fixture();\n   140\t  const pending = await f.gate.propose(\"echo\", []);\n   141\t  const results = await Promise.all([\n   142\t    f.gate.execute(pending),\n   143\t    f.gate.reject(pending.approvalId),\n   144\t  ]);\n   145\t  expect(results[0].ok).toBe(true);\n   146\t  expect(results[1]).toBe(false);\n   147\t  expect(f.spawns()).toBe(1);\n   148\t});\n   149\t\n   150\ttest(\"reject validates IDs and unknown IDs return false without execution\", async () => {\n   151\t  const f = fixture();\n   152\t  await expect(f.gate.reject(\"not-an-id\")).rejects.toThrow(ValidationError);\n   153\t  expect(await f.gate.reject(crypto.randomUUID())).toBe(false);\n   154\t  expect(f.spawns()).toBe(0);\n   155\t});\n","exit_code":0,"status":"completed"}}
