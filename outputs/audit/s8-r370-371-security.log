{"type":"item.completed","item":{"id":"item_76","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/lib/owned-cart-items.ts'","aggregated_output":"     1\t// The signed-in account's OWNED cart-item ids (G16 — add-to-cart had zero ownership awareness).\n     2\t// A thin read of the SAME `entitlement_grant` store `/dashboard/plan`'s owned derivation reads\n     3\t// (`activeIds.has(entitlementId)`) — kept here rather than duplicated logic so the two owned-checks\n     4\t// can never diverge on what \"active\" means. Every real purchase row grants EXACTLY `[slug]`\n     5\t// (`packages/pricebook/src/purchases.ts` — a bundle row grants `[\"<bundle-slug>\"]`, a module row\n     6\t// `[\"<module-slug>\"]`), and `lib/catalog.ts` namespaces cart ids `bundle:<slug>` / `module:<slug>`\n     7\t// off the SAME slug — so \"owned\" is exactly \"the bare slug is an active entitlement id\".\n     8\timport { BUNDLE_CATALOG, MODULE_CATALOG } from \"./catalog.ts\";\n     9\timport { readEntitlementGrants } from \"./dashboard-reads.ts\";\n    10\timport { readScoped } from \"./db.ts\";\n    11\timport { getSession } from \"./auth.ts\";\n    12\t\n    13\t/**\n    14\t * Every catalog cart-item id (`bundle:<slug>` / `module:<slug>`) the signed-in account already\n    15\t * owns. Empty for a signed-out visitor — nothing to disable. Does NOT expand the Everything\n    16\t * bundle's implicit full-catalog coverage (matches the plan page's exact behavior, which this\n    17\t * mirrors on purpose — a parallel workstream owns widening that logic for both readers at once).\n    18\t */\n    19\texport async function getOwnedCartItemIds(): Promise<ReadonlySet<string>> {\n    20\t  const session = await getSession();\n    21\t  if (session === null) return new Set();\n    22\t  return getOwnedCartItemIdsForAccount(session.accountId);\n    23\t}\n    24\t\n    25\t/** Server-only: accountId must come from a verified session, never request input. */\n    26\texport async function getOwnedCartItemIdsForAccount(\n    27\t  accountId: string,\n    28\t): Promise<ReadonlySet<string>> {\n    29\t  const grants = await readScoped(accountId, (tx) =>\n    30\t    readEntitlementGrants(tx, accountId),\n    31\t  );\n    32\t  const activeIds = new Set(\n    33\t    grants.filter((g) => g.status === \"active\").map((g) => g.entitlementId),\n    34\t  );\n    35\t  const owned = new Set<string>();\n    36\t  for (const item of [...BUNDLE_CATALOG, ...MODULE_CATALOG]) {\n    37\t    const slug = item.id.split(\":\")[1];\n    38\t    if (slug !== undefined && activeIds.has(slug)) owned.add(item.id);\n    39\t  }\n    40\t  return owned;\n    41\t}\n","exit_code":0,"status":"completed"}}
