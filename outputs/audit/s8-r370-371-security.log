{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/lib/demos-proxy.ts'","aggregated_output":"     1\timport { fetchWithTimeout } from \"@caisson/kernel/fetch\";\n     2\timport { z } from \"zod\";\n     3\t\n     4\tconst demosOriginSchema = z\n     5\t  .object({ origin: z.string().trim().min(1).max(2_048) })\n     6\t  .strict();\n     7\tconst demosPathSchema = z\n     8\t  .array(\n     9\t    z\n    10\t      .string()\n    11\t      .min(1)\n    12\t      .max(512)\n    13\t      .refine(\n    14\t        (segment) =>\n    15\t          segment !== \".\" &&\n    16\t          segment !== \"..\" &&\n    17\t          !segment.includes(\"/\") &&\n    18\t          !segment.includes(\"\\\\\") &&\n    19\t          !segment.includes(\"\\0\"),\n    20\t      ),\n    21\t  )\n    22\t  .max(64);\n    23\t\n    24\tconst REQUEST_HEADER_DENYLIST = new Set([\n    25\t  \"authorization\",\n    26\t  \"connection\",\n    27\t  \"cookie\",\n    28\t  \"forwarded\",\n    29\t  \"host\",\n    30\t  \"keep-alive\",\n    31\t  \"proxy-authenticate\",\n    32\t  \"proxy-authorization\",\n    33\t  \"te\",\n    34\t  \"trailer\",\n    35\t  \"transfer-encoding\",\n    36\t  \"upgrade\",\n    37\t  \"x-forwarded-for\",\n    38\t  \"x-forwarded-host\",\n    39\t  \"x-forwarded-port\",\n    40\t  \"x-forwarded-proto\",\n    41\t  \"x-gridwork-origin-secret\",\n    42\t]);\n    43\t\n    44\tconst RESPONSE_HEADER_DENYLIST = new Set([\n    45\t  \"authorization\",\n    46\t  \"connection\",\n    47\t  \"content-encoding\",\n    48\t  \"content-length\",\n    49\t  \"keep-alive\",\n    50\t  \"proxy-authenticate\",\n    51\t  \"proxy-authorization\",\n    52\t  \"set-cookie\",\n    53\t  \"set-cookie2\",\n    54\t  \"te\",\n    55\t  \"trailer\",\n    56\t  \"transfer-encoding\",\n    57\t  \"upgrade\",\n    58\t]);\n    59\t\n    60\ttype FetchImpl = typeof fetchWithTimeout;\n    61\ttype DemosAuthorization = \"google-id-token\" | \"none\";\n    62\t\n    63\texport type DemosOrigin = {\n    64\t  origin: string;\n    65\t  authorization: DemosAuthorization;\n    66\t};\n    67\t\n    68\texport interface DemosProxyDependencies {\n    69\t  getAuthorizationHeaders: (audience: string) => Promise<Headers>;\n    70\t  fetchImpl: FetchImpl;\n    71\t}\n    72\t\n    73\ttype IdTokenClient = {\n    74\t  getRequestHeaders: () => Promise<Headers>;\n    75\t};\n    76\t\n    77\tconst idTokenClients = new Map<string, Promise<IdTokenClient>>();\n    78\t\n    79\tasync function googleAuthorizationHeaders(audience: string): Promise<Headers> {\n    80\t  let client = idTokenClients.get(audience);\n    81\t  if (client === undefined) {\n    82\t    client = import(\"google-auth-library\").then(async ({ GoogleAuth }) => {\n    83\t      const auth = new GoogleAuth();\n    84\t      return auth.getIdTokenClient(audience);\n    85\t    });\n    86\t    idTokenClients.set(audience, client);\n    87\t  }\n    88\t  try {\n    89\t    return await (await client).getRequestHeaders();\n    90\t  } catch (error) {\n    91\t    idTokenClients.delete(audience);\n    92\t    throw error;\n    93\t  }\n    94\t}\n    95\t\n    96\tconst defaultDependencies: DemosProxyDependencies = {\n    97\t  getAuthorizationHeaders: googleAuthorizationHeaders,\n    98\t  fetchImpl: fetchWithTimeout,\n    99\t};\n   100\t\n   101\t/** Resolve the Cloud Run IAM origin or the still-authoritative Railway private-mesh origin. */\n   102\texport function parseDemosOrigin(\n   103\t  raw: string | undefined,\n   104\t  environment: Readonly<Record<string, string | undefined>> = process.env,\n   105\t): DemosOrigin | null {\n   106\t  const value = raw?.trim();\n   107\t  if (!value) return null;\n   108\t\n   109\t  const { origin } = demosOriginSchema.parse({ origin: value });\n   110\t  let parsed: URL;\n   111\t  try {\n   112\t    parsed = new URL(origin);\n   113\t  } catch {\n   114\t    throw new Error(\"DEMOS_ORIGIN_URL is not a valid URL\");\n   115\t  }\n   116\t  if (parsed.username !== \"\" || parsed.password !== \"\") {\n   117\t    throw new Error(\"DEMOS_ORIGIN_URL must not contain credentials\");\n   118\t  }\n   119\t  if (\n   120\t    parsed.protocol === \"https:\" &&\n   121\t    parsed.hostname.endsWith(\".run.app\") &&\n   122\t    parsed.hostname !== \"run.app\"\n   123\t  ) {\n   124\t    return { origin: parsed.origin, authorization: \"google-id-token\" };\n   125\t  }\n   126\t\n   127\t  const railwayEnvironmentId = environment.RAILWAY_ENVIRONMENT_ID?.trim() ?? \"\";\n   128\t  const cloudRunService = environment.K_SERVICE?.trim() ?? \"\";\n   129\t  if (\n   130\t    parsed.protocol === \"http:\" &&\n   131\t    parsed.hostname.endsWith(\".railway.internal\") &&\n   132\t    parsed.hostname !== \"railway.internal\" &&\n   133\t    railwayEnvironmentId !== \"\" &&\n   134\t    cloudRunService === \"\"\n   135\t  ) {\n   136\t    return { origin: parsed.origin, authorization: \"none\" };\n   137\t  }\n   138\t  if (parsed.protocol === \"http:\") {\n   139\t    throw new Error(\"DEMOS_ORIGIN_URL private HTTP origin requires Railway\");\n   140\t  }\n   141\t  throw new Error(\"DEMOS_ORIGIN_URL must name an HTTPS Cloud Run service\");\n   142\t}\n   143\t\n   144\tfunction upstreamHeaders(\n   145\t  request: Request,\n   146\t  authorizationHeaders: Headers,\n   147\t  authorization: DemosAuthorization,\n   148\t): Headers {\n   149\t  const authorizationHeader = authorizationHeaders.get(\"authorization\");\n   150\t  if (\n   151\t    authorization === \"google-id-token\" &&\n   152\t    (authorizationHeader === null || !authorizationHeader.startsWith(\"Bearer \"))\n   153\t  ) {\n   154\t    throw new Error(\"Google identity client returned no Bearer token\");\n   155\t  }\n   156\t\n   157\t  const headers = new Headers();\n   158\t  for (const [name, value] of request.headers) {\n   159\t    const lower = name.toLowerCase();\n   160\t    if (\n   161\t      REQUEST_HEADER_DENYLIST.has(lower) ||\n   162\t      lower.startsWith(\"cf-\") ||\n   163\t      lower.startsWith(\"x-goog-\")\n   164\t    ) {\n   165\t      continue;\n   166\t    }\n   167\t    headers.set(name, value);\n   168\t  }\n   169\t  if (authorizationHeader !== null) {\n   170\t    headers.set(\"authorization\", authorizationHeader);\n   171\t  }\n   172\t  return headers;\n   173\t}\n   174\t\n   175\tfunction downstreamHeaders(\n   176\t  upstream: Response,\n   177\t  requestUrl: URL,\n   178\t  demosOrigin: string,\n   179\t): Headers {\n   180\t  const headers = new Headers();\n   181\t  for (const [name, value] of upstream.headers) {\n   182\t    if (!RESPONSE_HEADER_DENYLIST.has(name.toLowerCase())) {\n   183\t      headers.set(name, value);\n   184\t    }\n   185\t  }\n   186\t\n   187\t  const location = headers.get(\"location\");\n   188\t  if (location !== null) {\n   189\t    const resolved = new URL(location, demosOrigin);\n   190\t    if (resolved.origin === demosOrigin) {\n   191\t      headers.set(\n   192\t        \"location\",\n   193\t        `${requestUrl.origin}${resolved.pathname}${resolved.search}${resolved.hash}`,\n   194\t      );\n   195\t    } else {\n   196\t      headers.delete(\"location\");\n   197\t    }\n   198\t  }\n   199\t  return headers;\n   200\t}\n   201\t\n   202\t/**\n   203\t * Proxy one same-origin `/demos/*` GET/HEAD to the selected private service. The Google ID token\n   204\t * exists only on the Cloud Run path and is never copied into the browser response; Railway keeps\n   205\t * its existing unauthenticated private-mesh hop until cutover.\n   206\t */\n   207\texport async function proxyDemosRequest(\n   208\t  request: Request,\n   209\t  path: string[],\n   210\t  configuredOrigin: DemosOrigin | null,\n   211\t  dependencies: DemosProxyDependencies = defaultDependencies,\n   212\t): Promise<Response> {\n   213\t  if (configuredOrigin === null) {\n   214\t    return new Response(\"Not Found\", { status: 404 });\n   215\t  }\n   216\t  const demosOrigin = configuredOrigin.origin;\n   217\t  const parsedPath = demosPathSchema.safeParse(path);\n   218\t  if (!parsedPath.success) {\n   219\t    throw new Error(\"invalid demos path\");\n   220\t  }\n   221\t\n   222\t  const requestUrl = new URL(request.url);\n   223\t  const encodedPath = parsedPath.data\n   224\t    .map((segment) => encodeURIComponent(segment))\n   225\t    .join(\"/\");\n   226\t  const target = new URL(\n   227\t    encodedPath === \"\" ? \"/demos\" : `/demos/${encodedPath}`,\n   228\t    demosOrigin,\n   229\t  );\n   230\t  target.search = requestUrl.search;\n   231\t\n   232\t  const authorizationHeaders =\n   233\t    configuredOrigin.authorization === \"google-id-token\"\n   234\t      ? await dependencies.getAuthorizationHeaders(demosOrigin)\n   235\t      : new Headers();\n   236\t  const upstream = await dependencies.fetchImpl(\n   237\t    target,\n   238\t    {\n   239\t      method: request.method,\n   240\t      headers: upstreamHeaders(\n   241\t        request,\n   242\t        authorizationHeaders,\n   243\t        configuredOrigin.authorization,\n   244\t      ),\n   245\t      redirect: \"manual\",\n   246\t    },\n   247\t    { timeoutMs: 30_000 },\n   248\t  );\n   249\t\n   250\t  const noBody =\n   251\t    request.method === \"HEAD\" ||\n   252\t    upstream.status === 204 ||\n   253\t    upstream.status === 304;\n   254\t  return new Response(noBody ? null : upstream.body, {\n   255\t    status: upstream.status,\n   256\t    statusText: upstream.statusText,\n   257\t    headers: downstreamHeaders(upstream, requestUrl, demosOrigin),\n   258\t  });\n   259\t}\n","exit_code":0,"status":"completed"}}
