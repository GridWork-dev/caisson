{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/tenancy-rls/src/pool.ts'","aggregated_output":"     1\timport { ConfigError } from \"@caisson/kernel\";\n     2\timport { Pool, type PoolConfig } from \"pg\";\n     3\t\n     4\texport type PgPoolPurpose = \"runtime\" | \"migration\";\n     5\t\n     6\texport interface CreatePgPoolOptions {\n     7\t  /** Runtime request traffic uses the pooled endpoint; finite DDL jobs use the direct endpoint. */\n     8\t  purpose?: PgPoolPurpose;\n     9\t}\n    10\t\n    11\tconst RUNTIME_POOL_CONFIG = {\n    12\t  max: 2,\n    13\t  min: 0,\n    14\t  idleTimeoutMillis: 20_000,\n    15\t  connectionTimeoutMillis: 4_000,\n    16\t  statement_timeout: 25_000,\n    17\t  query_timeout: 28_000,\n    18\t  idle_in_transaction_session_timeout: 25_000,\n    19\t  allowExitOnIdle: true,\n    20\t} satisfies PoolConfig;\n    21\t\n    22\tconst MIGRATION_POOL_CONFIG = {\n    23\t  max: 1,\n    24\t  min: 0,\n    25\t  idleTimeoutMillis: 10_000,\n    26\t  connectionTimeoutMillis: 5_000,\n    27\t  statement_timeout: 300_000,\n    28\t  query_timeout: 310_000,\n    29\t  idle_in_transaction_session_timeout: 60_000,\n    30\t  allowExitOnIdle: true,\n    31\t} satisfies PoolConfig;\n    32\t\n    33\t/**\n    34\t * The only production node-postgres pool constructor. Pools start empty, cap Cloud Run's\n    35\t * per-instance connection budget, discard idle clients promptly, and bound connection/query time.\n    36\t */\n    37\texport function createPgPool(\n    38\t  connectionString: string,\n    39\t  { purpose = \"runtime\" }: CreatePgPoolOptions = {},\n    40\t): Pool {\n    41\t  const normalized = connectionString.trim();\n    42\t  if (normalized === \"\") {\n    43\t    throw new ConfigError(\n    44\t      \"createPgPool requires a non-empty connection string\",\n    45\t    );\n    46\t  }\n    47\t\n    48\t  const pool = new Pool({\n    49\t    connectionString: normalized,\n    50\t    ...(purpose === \"migration\" ? MIGRATION_POOL_CONFIG : RUNTIME_POOL_CONFIG),\n    51\t  });\n    52\t  // node-postgres removes an idle client after an error, but without this listener EventEmitter\n    53\t  // turns that recoverable network event into an uncaught process crash.\n    54\t  pool.on(\"error\", (error) => {\n    55\t    process.stderr.write(\n    56\t      `[tenancy-rls] idle pooled connection error (survived): ${error.message}\\n`,\n    57\t    );\n    58\t  });\n    59\t  return pool;\n    60\t}\n","exit_code":0,"status":"completed"}}
