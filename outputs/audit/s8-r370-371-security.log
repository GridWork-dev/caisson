{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/audit-worm/src/anchor-transparency.ts'","aggregated_output":"     1\t// src/anchor-transparency.ts — external anchoring for the audit-worm chain (SPEC external-anchoring,\n     2\t// ADR-0332 forks + ADR-0346 PLAN locks). V1 ships the TSA `trusted-timestamped` leg ONLY.\n     3\t//\n     4\t// This module supplies the external trust ROOT the per-tenant hash chain chains up to: each periodic\n     5\t// anchor's canonical bytes ({length, tipHash, genesisHash} — hashes only, zero payload/PII, produced\n     6\t// by chain-store's `encodeAnchor`) are imprint-submitted to an RFC-3161 TSA, and the returned receipt\n     7\t// is stored as a WORM evidence object. The load-bearing property is HONESTY, not reach: a TSA receipt\n     8\t// lives in the buyer's own trust domain, so it is `trusted-timestamped` — NEVER marketed as\n     9\t// \"externally verifiable\". Only the v1.1 `externally-transparent` grade (public log) unlocks that\n    10\t// claim; this file must never let v1 produce `externally-transparent` (Fork E, enforced in\n    11\t// verify-external's grade tag — a sibling stage).\n    12\t//\n    13\t// GRADES ARE TWO DISTINCT STRING LITERALS in ONE enum, used everywhere — never a boolean — so code\n    14\t// cannot conflate them (ADR-0332 Binding).\n    15\t//\n    16\t// This file is the T1 (types + schemas + port + shared key/hash helpers) layer. The implementations\n    17\t// (StubTrustedTimestampLog, TsaAnchorLog) land in the same file's T2 section; the durable outbox is\n    18\t// anchor-outbox.ts; the checkpoint handler is anchor-checkpoint.ts. `verifyExternal` (existence +\n    19\t// byte-match + full TSA CMS verification, ADR-0346 P2) is a sibling stage.\n    20\timport { createHash, randomBytes } from \"node:crypto\";\n    21\timport { z } from \"zod\";\n    22\timport { fromBER, Integer, Null, OctetString } from \"asn1js\";\n    23\timport {\n    24\t  AlgorithmIdentifier,\n    25\t  MessageImprint,\n    26\t  PKIStatus,\n    27\t  SignedData,\n    28\t  TimeStampReq,\n    29\t  TimeStampResp,\n    30\t  TSTInfo,\n    31\t} from \"pkijs\";\n    32\timport {\n    33\t  fetchWithTimeout,\n    34\t  safeEqualFixed,\n    35\t  strictObject,\n    36\t  ValidationError,\n    37\t} from \"@caisson/kernel/node\";\n    38\timport { buildArtifactKey } from \"./store.ts\";\n    39\t\n    40\t// --- trust grades (ADR-0332 CR-03) -------------------------------------------------------------\n    41\t\n    42\t/**\n    43\t * The two honestly-distinct trust grades. `trusted-timestamped` (RFC-3161 TSA, private receipt) is\n    44\t * the ONLY grade v1 produces; `externally-transparent` (public log) is v1.1. One enum of two string\n    45\t * literals — never a boolean — so a target can never silently upgrade its own claim.\n    46\t */\n    47\texport const anchorGradeSchema = z.enum([\n    48\t  \"trusted-timestamped\",\n    49\t  \"externally-transparent\",\n    50\t]);\n    51\texport type AnchorGrade = z.infer<typeof anchorGradeSchema>;\n    52\t\n    53\t// --- transparency target (Fork F — target-agnostic; v1 = TSA only) -----------------------------\n    54\t\n    55\t/**\n    56\t * A TSA anchor target (v1). `url` is buyer-injected deployment config (Fork C), never a module\n    57\t * constant; `grade` is pinned to `trusted-timestamped` at the type level so a TSA target can never\n    58\t * be constructed claiming the public-log grade.\n    59\t */\n    60\texport const tsaTargetSchema = strictObject({\n    61\t  kind: z.literal(\"tsa\"),\n    62\t  url: z.string().url(),\n    63\t  grade: z.literal(\"trusted-timestamped\"),\n    64\t});\n    65\texport type TsaTarget = z.infer<typeof tsaTargetSchema>;\n    66\t\n    67\t/**\n    68\t * A Rekor v2 public-log target (v1.1). Carries NO write URL — the shard URL is read from a\n    69\t * deployment-supplied SigningConfig at `RekorAnchorLog` construction (spike decision #3: never hardcode\n    70\t * `log2025-1…` in source; it rotates ~6-monthly). `grade` is pinned to `externally-transparent` at the\n    71\t * type level. Submission additionally requires the typed irreversible-publicity opt-in (Fork D, R10).\n    72\t */\n    73\texport const rekorTargetSchema = strictObject({\n    74\t  kind: z.literal(\"rekor\"),\n    75\t  grade: z.literal(\"externally-transparent\"),\n    76\t});\n    77\texport type RekorTarget = z.infer<typeof rekorTargetSchema>;\n    78\t\n    79\t/**\n    80\t * An OpenTimestamps public-log target (v1.1, Fork R-γ). Bitcoin-anchored via calendar servers;\n    81\t * `grade` is pinned to `externally-transparent`. Like the Rekor target it requires the irreversible-\n    82\t * publicity opt-in (R10). Its offline verify is a documented Bitcoin-header-dependent seam (v1.1 ships\n    83\t * the submit leg; full verify is out of scope — see `anchor-ots.ts`).\n    84\t */\n    85\texport const otsTargetSchema = strictObject({\n    86\t  kind: z.literal(\"ots\"),\n    87\t  grade: z.literal(\"externally-transparent\"),\n    88\t});\n    89\texport type OtsTarget = z.infer<typeof otsTargetSchema>;\n    90\t\n    91\t/**\n    92\t * The pluggable target union (Fork F). v1 carried ONLY the TSA variant; v1.1 adds the Rekor + OTS\n    93\t * public-log variants — the whole point of keeping this a discriminated union.\n    94\t */\n    95\texport const transparencyTargetSchema = z.discriminatedUnion(\"kind\", [\n    96\t  tsaTargetSchema,\n    97\t  rekorTargetSchema,\n    98\t  otsTargetSchema,\n    99\t]);\n   100\texport type TransparencyTarget = z.infer<typeof transparencyTargetSchema>;\n   101\t\n   102\t/**\n   103\t * The stable string id a target is keyed by (receipt key, outbox row). v1 uses the discriminant\n   104\t * `kind` because a deployment configures exactly one TSA.\n   105\t * ponytail: one target per kind in v1; if a buyer ever configures two same-kind targets, suffix a\n   106\t * short hash of the url here (and only here — every keyer routes through this fn).\n   107\t */\n   108\texport function targetId(target: TransparencyTarget): string {\n   109\t  return target.kind;\n   110\t}\n   111\t\n   112\t// --- RFC-3161 timestamp receipt (submit result) ------------------------------------------------\n   113\t\n   114\t/**\n   115\t * What `TrustedTimestampLog.submit` returns — the RFC-3161 token plus the imprint/time it attests.\n   116\t * Structurally the `TimestampToken` shape from signing-primitive's sign.ts (ADR-0346 P1 reimplements\n   117\t * the port locally rather than depend on that package). `token` is the opaque base64 DER\n   118\t * `TimeStampToken`; a sibling stage's `verifyExternal` does the full CMS parse + TSA cert-chain\n   119\t * validation against it (ADR-0346 P2).\n   120\t */\n   121\texport const timestampReceiptSchema = strictObject({\n   122\t  authority: z.string().min(1),\n   123\t  algorithm: z.literal(\"rfc3161\"),\n   124\t  hashAlgorithm: z.literal(\"sha256\"),\n   125\t  /** `sha256(anchorBytes)` — the RFC-3161 messageImprint the TSA attests (lowercase hex). */\n   126\t  messageImprint: z.string().regex(/^[0-9a-f]{64}$/),\n   127\t  /** Deterministic base64 for the stub; a live TSA returns base64 of the DER `TimeStampToken`. */\n   128\t  token: z.string().min(1),\n   129\t  /** The instant the TSA attests the imprint existed at (ISO-8601). */\n   130\t  timestampedAt: z.string().min(1),\n   131\t});\n   132\texport type TimestampReceipt = z.infer<typeof timestampReceiptSchema>;\n   133\t\n   134\t// --- self-contained Rekor transparency receipt (v1.1, spike decision #2) ------------------------\n   135\t\n   136\t/** Standard base64 (with padding) — the wire encoding for every byte field a Rekor receipt carries. */\n   137\tconst base64String = z\n   138\t  .string()\n   139\t  .min(1)\n   140\t  .regex(/^[A-Za-z0-9+/]+={0,2}$/, \"must be standard base64\");\n   141\t\n   142\t/**\n   143\t * The SELF-CONTAINED public-log receipt (`externally-transparent`). It carries EVERYTHING\n   144\t * `verifyExternal` needs to check offline — including the log's own checkpoint-signing key + origin —\n   145\t * because Rekor v2 removed online proof retrieval AND shards retire ~6-monthly while receipts are\n   146\t * WORM-retained for years (spike decision #2 + Q4): a stored receipt must verify with NO live TUF/Rekor\n   147\t * fetch, long after its shard is gone. `verifyExternal` verifies the checkpoint signature against\n   148\t * `logPublicKey` WITHOUT enforcing TUF timestamp freshness — a years-old-but-valid checkpoint still\n   149\t * verifies. The leaf's `data.digest` (inside `canonicalizedBody`) is `SHA-512(anchorBytes)`; the outer\n   150\t * `AnchorReceipt.anchorDigest` stays `sha256` (the target-agnostic join key), a distinct hash.\n   151\t */\n   152\texport const transparencyReceiptSchema = strictObject({\n   153\t  algorithm: z.literal(\"rekor-v2-hashedrekord\"),\n   154\t  /** The log origin string (the checkpoint's first line, e.g. `log2025-1.rekor.sigstore.dev`). */\n   155\t  origin: z.string().min(1),\n   156\t  /** The raw C2SP signed-note checkpoint envelope (origin/treeSize/rootHash + `— name sig`). */\n   157\t  checkpoint: z.string().min(1),\n   158\t  /** The log's checkpoint-signing algorithm. Only Ed25519 checkpoints are verifiable today. */\n   159\t  logKeyDetails: z.literal(\"PKIX_ED25519\"),\n   160\t  /** base64 DER SPKI of the log's checkpoint-signing key — snapshotted so the receipt self-verifies. */\n   161\t  logPublicKey: base64String,\n   162\t  /** base64 SHA-256 log id (`TransparencyLogEntry.logId.keyId`), bound to the fixture shard. */\n   163\t  logId: base64String,\n   164\t  /** The authoritative leaf position (`TransparencyLogEntry.logIndex`, top-level, int64 as string). */\n   165\t  logIndex: z.string().regex(/^\\d+$/),\n   166\t  /** The RFC-6962 inclusion-proof audit path (`inclusionProof.hashes[]`, base64). */\n   167\t  inclusionHashes: z.array(base64String),\n   168\t  /** base64 leaf preimage (`canonicalizedBody`): the `{data,signature}` the leaf hash is taken over. */\n   169\t  canonicalizedBody: base64String,\n   170\t  /** Optional RFC-3161 token composing the `trusted-timestamped` layer over the same anchor (Q5 #5). */\n   171\t  rfc3161Token: base64String.optional(),\n   172\t});\n   173\texport type TransparencyReceipt = z.infer<typeof transparencyReceiptSchema>;\n   174\t\n   175\t/**\n   176\t * An OpenTimestamps receipt (v1.1, Fork R-γ minimal drop-in). OTS needs NO per-entry signature — the\n   177\t * calendar Merkle-trees all submitters and commits to Bitcoin — so `signature`/`verifier` are absent.\n   178\t * `status: pending` holds the calendar's `PendingAttestation` (Bitcoin not yet confirmed); `complete`\n   179\t * holds the upgraded proof. FULL verification requires Bitcoin block headers (documented seam, out of\n   180\t * scope v1.1) — the persisted proof is durable evidence, upgraded/verified later.\n   181\t */\n   182\texport const otsReceiptSchema = strictObject({\n   183\t  algorithm: z.literal(\"opentimestamps\"),\n   184\t  /** `sha256(anchorBytes)` — the digest OTS calendars aggregate (lowercase hex). */\n   185\t  messageImprint: z.string().regex(/^[0-9a-f]{64}$/),\n   186\t  /** The calendar servers the digest was submitted to. */\n   187\t  calendars: z.array(z.string().url()).min(1),\n   188\t  /** base64 of the `.ots` proof bytes (a `PendingAttestation` while `pending`). */\n   189\t  proof: z.string().min(1),\n   190\t  /** `pending` = Bitcoin not yet confirmed; `complete` = upgraded proof landed. */\n   191\t  status: z.enum([\"pending\", \"complete\"]),\n   192\t  /** When the calendar accepted the digest (ISO-8601). */\n   193\t  submittedAt: z.string().min(1),\n   194\t});\n   195\texport type OtsReceipt = z.infer<typeof otsReceiptSchema>;\n   196\t\n   197\t/**\n   198\t * The receipt a `TransparencyLog.submit` returns, per target: a TSA `TimestampReceipt`, a self-contained\n   199\t * Rekor `TransparencyReceipt`, or an `OtsReceipt`. Discriminated on `algorithm`. Existing rfc3161\n   200\t * receipts parse unchanged — widening to a union is backward-compatible.\n   201\t */\n   202\texport const anchorSubmitReceiptSchema = z.discriminatedUnion(\"algorithm\", [\n   203\t  timestampReceiptSchema,\n   204\t  transparencyReceiptSchema,\n   205\t  otsReceiptSchema,\n   206\t]);\n   207\texport type AnchorSubmitReceipt = z.infer<typeof anchorSubmitReceiptSchema>;\n   208\t\n   209\t// --- the persisted WORM anchor receipt ---------------------------------------------------------\n   210\t\n   211\t/**\n   212\t * The evidence object written write-once to the tenant's WORM prefix under\n   213\t * `{account_id}/audit-chain/receipts/<len>.<target>.json`. It binds the timestamp receipt to a\n   214\t * SPECIFIC anchor (length + digest of that anchor's canonical bytes) and tags the grade. `anchorDigest`\n   215\t * equals `receipt.messageImprint` (both are `sha256(encodeAnchor(anchor))`) — the redundancy is\n   216\t * deliberate: the outer field is the join key, the inner is what the TSA signed over.\n   217\t */\n   218\texport const anchorReceiptSchema = strictObject({\n   219\t  accountId: z.string().min(1),\n   220\t  target: z.string().min(1),\n   221\t  anchorLength: z.number().int().nonnegative(),\n   222\t  anchorDigest: z.string().regex(/^[0-9a-f]{64}$/),\n   223\t  grade: anchorGradeSchema,\n   224\t  receipt: anchorSubmitReceiptSchema,\n   225\t  /** When Caisson persisted the receipt to WORM (ISO-8601). Distinct from `receipt.timestampedAt`. */\n   226\t  receiptedAt: z.string().min(1),\n   227\t});\n   228\texport type AnchorReceipt = z.infer<typeof anchorReceiptSchema>;\n   229\t\n   230\t// --- durable-outbox state model (CR-02 / ADR-0346 P4) ------------------------------------------\n   231\t\n   232\t/**\n   233\t * Outbox lifecycle. `pending` is persisted BEFORE any egress; `submitted` is persisted BEFORE the\n   234\t * network call resolves. A response-loss window (submitted, no receipt) resolves to `needs_reconcile`\n   235\t * — surfaced to the operator, NEVER blind-retried into a duplicate submission. `receipted`, `failed`,\n   236\t * and `needs_reconcile` are terminal.\n   237\t */\n   238\texport const anchorOutboxStateSchema = z.enum([\n   239\t  \"pending\",\n   240\t  \"submitted\",\n   241\t  \"receipted\",\n   242\t  \"failed\",\n   243\t  \"needs_reconcile\",\n   244\t]);\n   245\texport type AnchorOutboxState = z.infer<typeof anchorOutboxStateSchema>;\n   246\t\n   247\t/** The natural key of an outbox row / receipt: one (tenant, target, anchor) tuple. */\n   248\texport const anchorOutboxKeySchema = strictObject({\n   249\t  accountId: z.string().min(1),\n   250\t  target: z.string().min(1),\n   251\t  anchorLength: z.number().int().nonnegative(),\n   252\t  anchorDigest: z.string().regex(/^[0-9a-f]{64}$/),\n   253\t});\n   254\texport type AnchorOutboxKey = z.infer<typeof anchorOutboxKeySchema>;\n   255\t\n   256\t/** A row read back from `anchor_outbox` (mutable operational state — NOT a WORM object). */\n   257\texport const anchorOutboxRowSchema = strictObject({\n   258\t  id: z.string().uuid(),\n   259\t  accountId: z.string().min(1),\n   260\t  target: z.string().min(1),\n   261\t  anchorLength: z.number().int().nonnegative(),\n   262\t  anchorDigest: z.string().regex(/^[0-9a-f]{64}$/),\n   263\t  state: anchorOutboxStateSchema,\n   264\t  lastError: z.string().nullable(),\n   265\t  receiptVersionId: z.string().min(1).nullable(),\n   266\t  createdAt: z.coerce.date(),\n   267\t  updatedAt: z.coerce.date(),\n   268\t});\n   269\texport type AnchorOutboxRow = z.infer<typeof anchorOutboxRowSchema>;\n   270\t\n   271\t// --- the port (SPEC Design §1, verbatim shape) -------------------------------------------------\n   272\t\n   273\t/**\n   274\t * The v1 `trusted-timestamped` port. `submit` imprint-egresses `sha256(anchorBytes)` to a third-party\n   275\t * clock and returns its receipt. The v1.1 `externally-transparent` port is a DIFFERENT (signed)\n   276\t * shape, gated on the Rekor protocol spike — it does not appear here.\n   277\t */\n   278\texport interface TrustedTimestampLog {\n   279\t  submit(anchorBytes: Uint8Array): Promise<TimestampReceipt>;\n   280\t}\n   281\t\n   282\t/**\n   283\t * The target-agnostic anchoring port (Fork F). `submit` egresses the anchor bytes to SOME external log\n   284\t * and returns whichever receipt that target produces (TSA `TimestampReceipt` or Rekor\n   285\t * `TransparencyReceipt`). Every concrete log — `TsaAnchorLog`, `RekorAnchorLog`, `OpenTimestampsAnchorLog`\n   286\t * — implements this; the checkpoint handler and outbox are written against it and stay target-blind\n   287\t * (correction #3). `TrustedTimestampLog` is the narrower TSA-only shape; a `TsaAnchorLog` satisfies both.\n   288\t */\n   289\texport interface TransparencyLog {\n   290\t  submit(anchorBytes: Uint8Array): Promise<AnchorSubmitReceipt>;\n   291\t}\n   292\t\n   293\t/**\n   294\t * The minimal signer port `RekorAnchorLog` needs — the deployment ed25519ph anchoring signer\n   295\t * (`@caisson/signing-primitive`'s `Ed25519PhSigner`) is INJECTED as this structural shape, so audit-worm\n   296\t * keeps its down-only dependency set (no `signing-primitive` import; ADR-0346 P1 discipline). `sign`\n   297\t * returns a detached 64-byte ed25519ph signature over the exact anchor bytes; `publicKey` returns the\n   298\t * raw 32-byte Ed25519 key (this module DER-wraps it into the Rekor verifier material).\n   299\t */\n   300\texport interface AnchorSubmissionSigner {\n   301\t  readonly keyId: string;\n   302\t  readonly algorithm: \"ed25519ph\";\n   303\t  sign(anchorBytes: Uint8Array): Promise<Uint8Array>;\n   304\t  publicKey(): Promise<Uint8Array>;\n   305\t}\n   306\t\n   307\t// --- Fork D: typed irreversible-publicity opt-in (R10; mirrors store.s3 COMPLIANCE opt-in) ------\n   308\t\n   309\t/** The exact acknowledgement a deployment must echo to submit to a PUBLIC transparency log. */\n   310\texport const PUBLICITY_ACKNOWLEDGEMENT =\n   311\t  \"I acknowledge public transparency-log anchoring is irreversible: each submission is a permanent, \" +\n   312\t  \"publicly visible entry (existence, timing, and rough volume are disclosed) and cannot be deleted.\";\n   313\t\n   314\tconst PUBLICITY_OPT_IN_BRAND: unique symbol = Symbol(\n   315\t  \"audit-worm.irreversible-publicity-opt-in\",\n   316\t);\n   317\t\n   318\t/**\n   319\t * The typed, opaque proof that a deployment has acknowledged public-log anchoring is irreversible\n   320\t * (Fork D). Unforgeable in practice — the only constructor is {@link irreversiblePublicityOptIn}, which\n   321\t * demands the exact {@link PUBLICITY_ACKNOWLEDGEMENT}. No public-log target submits without one in hand,\n   322\t * so the irreversible public egress cannot be triggered by accident or by a default. TSA never needs it.\n   323\t */\n   324\texport interface IrreversiblePublicityOptIn {\n   325\t  readonly [PUBLICITY_OPT_IN_BRAND]: true;\n   326\t}\n   327\t\n   328\t/**\n   329\t * Mint the irreversible-publicity opt-in. Fail-closed: the acknowledgement must be the exact\n   330\t * {@link PUBLICITY_ACKNOWLEDGEMENT} string, so neither a typo nor a default ever yields one.\n   331\t */\n   332\texport function irreversiblePublicityOptIn(input: {\n   333\t  acknowledgement: string;\n   334\t}): IrreversiblePublicityOptIn {\n   335\t  if (input.acknowledgement !== PUBLICITY_ACKNOWLEDGEMENT) {\n   336\t    throw new ValidationError(\n   337\t      \"audit-worm: public-log anchoring requires the exact irreversible-publicity acknowledgement string\",\n   338\t    );\n   339\t  }\n   340\t  return { [PUBLICITY_OPT_IN_BRAND]: true };\n   341\t}\n   342\t\n   343\t/**\n   344\t * The runtime brand check a public-log target uses to refuse a forged/absent opt-in (a belt for untyped\n   345\t * JS callers; the type system is the primary gate — the brand symbol is module-private, so the only way\n   346\t * to obtain the value is {@link irreversiblePublicityOptIn}).\n   347\t */\n   348\texport function isIrreversiblePublicityOptIn(\n   349\t  value: unknown,\n   350\t): value is IrreversiblePublicityOptIn {\n   351\t  return (\n   352\t    typeof value === \"object\" &&\n   353\t    value !== null &&\n   354\t    (value as Record<PropertyKey, unknown>)[PUBLICITY_OPT_IN_BRAND] === true\n   355\t  );\n   356\t}\n   357\t\n   358\t// --- shared helpers (keyer + digest; imported by writer T4 and reader/verify siblings) ---------\n   359\t\n   360\t/** WORM key layout for a receipt: `{account_id}/audit-chain/receipts/<zero-padded len>.<target>.json`. */\n   361\tconst RECEIPT_SEGMENT = \"audit-chain\";\n   362\tconst RECEIPT_DIR = \"receipts\";\n   363\t/** Match chain-store's anchor zero-padding so receipts sort lexically alongside their anchors. */\n   364\tconst LENGTH_PAD = 12;\n   365\t\n   366\t/**\n   367\t * The write-once WORM key for the receipt of anchor `anchorLength` at `target`. The single sanctioned\n   368\t * builder — the checkpoint writer and `verifyExternal` reader MUST route through it so their keys can\n   369\t * never drift. Re-derives the `audit-chain` segment locally (chain-store's constant is file-private\n   370\t * and that file is owned by a parallel lane this wave) — a small, deliberate duplication.\n   371\t */\n   372\texport function anchorReceiptKey(\n   373\t  accountId: string,\n   374\t  anchorLength: number,\n   375\t  target: string,\n   376\t): string {\n   377\t  return buildArtifactKey(\n   378\t    accountId,\n   379\t    RECEIPT_SEGMENT,\n   380\t    RECEIPT_DIR,\n   381\t    `${String(anchorLength).padStart(LENGTH_PAD, \"0\")}.${target}.json`,\n   382\t  );\n   383\t}\n   384\t\n   385\t/** `sha256(bytes)` as lowercase hex — the anchor digest / RFC-3161 message imprint. */\n   386\texport function sha256Hex(bytes: Uint8Array): string {\n   387\t  return createHash(\"sha256\").update(bytes).digest(\"hex\");\n   388\t}\n   389\t\n   390\t// ===============================================================================================\n   391\t// T2 — TrustedTimestampLog implementations (deterministic stub + live RFC-3161 client).\n   392\t// ADR-0346 P1: the port is reimplemented LOCALLY here (mirroring signing-primitive's sign.ts\n   393\t// RFC-3161 pattern), no dependency on signing-primitive. P2: the live client uses a vetted ASN.1/CMS\n   394\t// dependency (pkijs) for real DER TimeStampReq encode + TimeStampResp/TSTInfo parse.\n   395\t// ===============================================================================================\n   396\t\n   397\t/**\n   398\t * A deterministic, network-free `TrustedTimestampLog` test double. Reproduces the imprint a real TSA\n   399\t * would attest (`sha256(anchorBytes)`) and stamps an injected clock, so the whole checkpoint flow is\n   400\t * exercised in CI without a live authority. Mirrors `StubTimestampAuthority` (sign.ts). NOT for prod.\n   401\t */\n   402\texport class StubTrustedTimestampLog implements TrustedTimestampLog {\n   403\t  readonly #authority: string;\n   404\t  readonly #clock: Date;\n   405\t\n   406\t  constructor(options?: { readonly authority?: string; readonly now?: Date }) {\n   407\t    this.#authority = options?.authority ?? \"urn:caisson:test-tsa\";\n   408\t    this.#clock = options?.now ?? new Date(0);\n   409\t  }\n   410\t\n   411\t  submit(anchorBytes: Uint8Array): Promise<TimestampReceipt> {\n   412\t    const messageImprint = sha256Hex(anchorBytes);\n   413\t    const timestampedAt = this.#clock.toISOString();\n   414\t    const token = Buffer.from(\n   415\t      `rfc3161|${this.#authority}|${messageImprint}|${timestampedAt}`,\n   416\t      \"utf8\",\n   417\t    ).toString(\"base64\");\n   418\t    return Promise.resolve({\n   419\t      authority: this.#authority,\n   420\t      algorithm: \"rfc3161\",\n   421\t      hashAlgorithm: \"sha256\",\n   422\t      messageImprint,\n   423\t      token,\n   424\t      timestampedAt,\n   425\t    });\n   426\t  }\n   427\t}\n   428\t\n   429\t/** The RFC-3161 SHA-256 OID (`id-sha256`). */\n   430\tconst SHA256_OID = \"2.16.840.1.101.3.4.2.1\";\n   431\t/** RFC-3161 blocks on token publication; the SPEC cadence section sets timeouts at >= 20s. */\n   432\tconst DEFAULT_TSA_TIMEOUT_MS = 20_000;\n   433\t\n   434\texport interface TsaAnchorLogConfig {\n   435\t  /** The buyer-injected TSA endpoint (Fork C) — never a module constant. http or https only. */\n   436\t  readonly url: string;\n   437\t  /** Outbound timeout (ms). Default 20s per the SPEC cadence; below 1s is refused. */\n   438\t  readonly timeoutMs?: number;\n   439\t  /** Optional TSA policy OID the request pins (`reqPolicy`). */\n   440\t  readonly reqPolicy?: string;\n   441\t}\n   442\t\n   443\t/**\n   444\t * The live RFC-3161 client (the `trusted-timestamped` grade). `submit` DER-encodes a `TimeStampReq`\n   445\t * with `messageImprint = sha256(anchorBytes)` and `certReq = true` (so the TSA returns its cert chain\n   446\t * for the sibling `verifyExternal`'s full CMS/chain validation — ADR-0346 P2), POSTs it over\n   447\t * `fetchWithTimeout` (NEVER the Bun-forbidden `AbortSignal.timeout`), then parses the `TimeStampResp`,\n   448\t * confirms it was granted, and reconfirms the attested imprint constant-time before returning.\n   449\t *\n   450\t * Egress is imprint-only (hashes, no payload/PII — SPEC data-custody). The trust of an RFC-3161 token\n   451\t * rides its SIGNATURE, not the transport, so http TSA endpoints (many public TSAs use them) are\n   452\t * accepted; the token itself is verified downstream. LIVE transport is un-exercised in CI — the DER\n   453\t * round-trip is proven only by the self-skipping `live/tsa.live.test.ts` (ADR-0047 live-test ethos).\n   454\t */\n   455\texport class TsaAnchorLog implements TrustedTimestampLog {\n   456\t  readonly #url: string;\n   457\t  readonly #timeoutMs: number;\n   458\t  readonly #reqPolicy: string | undefined;\n   459\t\n   460\t  constructor(config: TsaAnchorLogConfig) {\n   461\t    const parsed = new URL(config.url); // throws on a malformed url\n   462\t    if (parsed.protocol !== \"http:\" && parsed.protocol !== \"https:\") {\n   463\t      throw new ValidationError(\"TSA url must be an http(s) endpoint\", {\n   464\t        protocol: parsed.protocol,\n   465\t      });\n   466\t    }\n   467\t    const timeoutMs = config.timeoutMs ?? DEFAULT_TSA_TIMEOUT_MS;\n   468\t    if (!Number.isFinite(timeoutMs) || timeoutMs < 1_000) {\n   469\t      throw new ValidationError(\"TSA timeout must be a finite value >= 1000ms\");\n   470\t    }\n   471\t    this.#url = config.url;\n   472\t    this.#timeoutMs = timeoutMs;\n   473\t    this.#reqPolicy = config.reqPolicy;\n   474\t  }\n   475\t\n   476\t  async submit(anchorBytes: Uint8Array): Promise<TimestampReceipt> {\n   477\t    const imprint = createHash(\"sha256\").update(anchorBytes).digest();\n   478\t    const reqBer = buildTimeStampReqBer(imprint, this.#reqPolicy);\n   479\t    const resp = await fetchWithTimeout(\n   480\t      this.#url,\n   481\t      {\n   482\t        method: \"POST\",\n   483\t        headers: {\n   484\t          \"content-type\": \"application/timestamp-query\",\n   485\t          accept: \"application/timestamp-reply\",\n   486\t        },\n   487\t        body: reqBer,\n   488\t        // `http:` is a deliberate RFC-3161 decision here (only a sha256 imprint transits, and the\n   489\t        // CMS/EKU verification below is what establishes trust), and a private TSA is a supported\n   490\t        // deployment — so a public-host SSRF guard would be wrong on this seam. Refusing redirects\n   491\t        // is the part that is right regardless: it keeps the request on the configured endpoint.\n   492\t        redirect: \"error\",\n   493\t      },\n   494\t      { timeoutMs: this.#timeoutMs },\n   495\t    );\n   496\t    if (!resp.ok) {\n   497\t      throw new ValidationError(\"TSA request failed\", { status: resp.status });\n   498\t    }\n   499\t    const respDer = new Uint8Array(await resp.arrayBuffer());\n   500\t    return parseTimeStampResp(respDer, imprint, this.#url);\n   501\t  }\n   502\t}\n   503\t\n   504\t/** Build the DER `TimeStampReq` (RFC-3161): version 1, sha256 imprint, certReq, random nonce. */\n   505\tfunction buildTimeStampReqBer(\n   506\t  imprint: Uint8Array,\n   507\t  reqPolicy: string | undefined,\n   508\t): ArrayBuffer {\n   509\t  const messageImprint = new MessageImprint({\n   510\t    hashAlgorithm: new AlgorithmIdentifier({\n   511\t      algorithmId: SHA256_OID,\n   512\t      algorithmParams: new Null(),\n   513\t    }),\n   514\t    hashedMessage: new OctetString({ valueHex: imprint }),\n   515\t  });\n   516\t  const req = new TimeStampReq({\n   517\t    version: 1,\n   518\t    messageImprint,\n   519\t    certReq: true,\n   520\t    nonce: new Integer({ valueHex: randomBytes(16) }),\n   521\t    ...(reqPolicy !== undefined ? { reqPolicy } : {}),\n   522\t  });\n   523\t  return req.toSchema().toBER();\n   524\t}\n   525\t\n   526\t/**\n   527\t * Parse the DER `TimeStampResp`: require a granted status, extract the DER `TimeStampToken` (kept\n   528\t * opaque base64 for the sibling verify's full CMS/cert-chain validation), and reconfirm — via the\n   529\t * embedded TSTInfo — that the TSA attested the EXACT imprint we submitted (constant-time). The\n   530\t * `genTime` becomes the receipt's `timestampedAt`.\n   531\t */\n   532\tfunction parseTimeStampResp(\n   533\t  respDer: Uint8Array,\n   534\t  expectedImprint: Uint8Array,\n   535\t  authorityUrl: string,\n   536\t): TimestampReceipt {\n   537\t  const asn1 = fromBER(respDer);\n   538\t  if (asn1.offset === -1) {\n   539\t    throw new ValidationError(\"TSA response is not valid DER\");\n   540\t  }\n   541\t  const resp = new TimeStampResp({ schema: asn1.result });\n   542\t  if (\n   543\t    resp.status.status !== PKIStatus.granted &&\n   544\t    resp.status.status !== PKIStatus.grantedWithMods\n   545\t  ) {\n   546\t    throw new ValidationError(\"TSA did not grant the timestamp request\", {\n   547\t      status: resp.status.status,\n   548\t    });\n   549\t  }\n   550\t  const token = resp.timeStampToken;\n   551\t  if (token === undefined) {\n   552\t    throw new ValidationError(\"TSA response carried no timeStampToken\");\n   553\t  }\n   554\t  const tokenDer = new Uint8Array(token.toSchema().toBER());\n   555\t\n   556\t  // Reach the signed TSTInfo: CMS SignedData -> encapContentInfo.eContent (DER TSTInfo).\n   557\t  const signed = new SignedData({ schema: token.content });\n   558\t  const eContent = signed.encapContentInfo.eContent;\n   559\t  if (eContent === undefined) {\n   560\t    throw new ValidationError(\"TSA token carried no eContent\");\n   561\t  }\n   562\t  const tstAsn1 = fromBER(eContent.valueBlock.valueHexView);\n   563\t  if (tstAsn1.offset === -1) {\n   564\t    throw new ValidationError(\"TSA TSTInfo is not valid DER\");\n   565\t  }\n   566\t  const tstInfo = new TSTInfo({ schema: tstAsn1.result });\n   567\t  const attestedImprint = new Uint8Array(\n   568\t    tstInfo.messageImprint.hashedMessage.valueBlock.valueHexView,\n   569\t  );\n   570\t\n   571\t  const expectedHex = Buffer.from(expectedImprint).toString(\"hex\");\n   572\t  const attestedHex = Buffer.from(attestedImprint).toString(\"hex\");\n   573\t  if (!safeEqualFixed(expectedHex, attestedHex)) {\n   574\t    throw new ValidationError(\n   575\t      \"TSA attested a different imprint than submitted\",\n   576\t    );\n   577\t  }\n   578\t\n   579\t  return {\n   580\t    authority: authorityUrl,\n   581\t    algorithm: \"rfc3161\",\n   582\t    hashAlgorithm: \"sha256\",\n   583\t    messageImprint: expectedHex,\n   584\t    token: Buffer.from(tokenDer).toString(\"base64\"),\n   585\t    timestampedAt: tstInfo.genTime.toISOString(),\n   586\t  };\n   587\t}\n","exit_code":0,"status":"completed"}}
