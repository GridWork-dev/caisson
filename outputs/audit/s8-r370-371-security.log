edential file must never reach a Docker context.\n239:          # `create_credentials_file: false` is the mechanical guarantee; .dockerignore\n240-          # entries are the belt, this is the braces.\n241:          create_credentials_file: false\n242-\n243-      # `GCP_REGISTRY_HOST` is the host `docker login` sends the access token to, and\n244-      # `GCP_REGISTRY` is the host the image is actually pushed to. They are two\n245-      # independent repository variables that only happen to agree, and nothing checked\n246-      # that they did — so a principal who can write repository variables but cannot read\n247-      # secrets (a `repo`-scoped PAT, an org owner setting an org-level var) could point\n248-      # the login at a host they control and receive a live GCP access token for the\n249-      # image-publisher SA. The push to GCP_REGISTRY then fails and the run goes red,\n250:      # after the credential has already left. `create_credentials_file: false` does not\n251-      # help: it stops the credential reaching a Docker CONTEXT, not a login to the wrong\n252-      # host.\n253-      #\n254-      # Asserted rather than derived because `docker login` takes a host, not a\n255-      # host-plus-path, so GCP_REGISTRY cannot simply be passed through. The pair check is\n256-      # the property that matters: the token only ever goes to the host the image goes to.\n257-      - name: assert the login host is the registry's own host\n258-        env:\n259-          REGISTRY: ${{ vars.GCP_REGISTRY }}\n260-          REGISTRY_HOST: ${{ vars.GCP_REGISTRY_HOST }}\n261-        run: |\n262-          set -euo pipefail\n263-          case \"$REGISTRY_HOST\" in\n264-            *.pkg.dev) ;;\n265-            *) echo \"::error::GCP_REGISTRY_HOST is not an Artifact Registry host\"; exit 1 ;;\n266-          esac\n267-          case \"$REGISTRY\" in\n268-            \"$REGISTRY_HOST\"/*) ;;\n269-            *) echo \"::error::GCP_REGISTRY_HOST is not the host of GCP_REGISTRY — refusing to send a registry credential to it\"; exit 1 ;;\n270-          esac\n271-\n272:      - uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0\n273-        with:\n274-          registry: ${{ vars.GCP_REGISTRY_HOST }}\n275-          username: oauth2accesstoken\n276-          password: ${{ steps.auth.outputs.access_token }}\n277-\n278-      - uses: docker/setup-buildx-action@37fe631027851001ddb9b187196cc803df7f5f0e # v4.3.0\n279-\n280-      # CORE-73: a workflow_dispatch re-run of an already-published sha used to go RED at\n281-      # push time — the rebuild is not byte-reproducible, so the same :sha tag arrives\n282-      # with a new manifest and Artifact Registry's tag immutability refuses it. A red\n283-      # that reads as a regression while saying only \"this was already published\". The\n284-      # registry's existing digest IS the truth for that sha, so a re-run re-emits it and\n285-      # skips the build instead of failing. It is the truth about WHAT the bytes are —\n286-      # not about whether they were signed or scanned: the run that pushed may have died\n287-      # between the push and either claim, so the evidence chain below keys on the\n288:      # resolved digest (see `resolve digest`) and re-earns both on every run.\n289-      #\n290-      # Three outcomes, fail-closed: the tag resolves -> published=true plus its digest;\n291-      # the registry says the tag/repo does not exist -> published=false, build proceeds;\n292-      # anything else (auth, network, parse) -> red. \"Cannot tell\" must never build —\n293-      # guessing \"not published\" here would recreate the immutability red this exists to\n294-      # remove, one step later and with less context. `imagetools inspect` reads through\n295-      # the docker login above and returns the same index digest buildx emitted when it\n296-      # pushed, which is what every deploy and rollback consumes.\n297-      - name: already published at this sha?\n298:        id: preflight\n299-        env:\n300-          IMAGE: ${{ vars.GCP_REGISTRY }}/${{ matrix.service }}\n301-          TAG: ${{ github.sha }}\n302-        run: |\n303-          set -euo pipefail\n304:          if out=\"$(docker buildx imagetools inspect \"${IMAGE}:${TAG}\" --format '{{json .Manifest}}' 2>preflight-err.txt)\"; then\n305-            digest=\"$(printf '%s' \"$out\" | jq -r '.digest // empty')\"\n306-            case \"$digest\" in\n307-              sha256:?*) ;;\n308-              *) echo \"::error::registry answered for ${IMAGE}:${TAG} but returned no parseable digest\"; exit 1 ;;\n309-            esac\n310-            printf 'published=true\\ndigest=%s\\n' \"$digest\" >> \"$GITHUB_OUTPUT\"\n311-            echo \"::notice title=already published (CORE-73)::${IMAGE}:${TAG}@${digest} — build skipped, digest re-emitted\"\n312:          elif grep -qiE 'not found|NAME_UNKNOWN|MANIFEST_UNKNOWN' preflight-err.txt; then\n313-            printf 'published=false\\n' >> \"$GITHUB_OUTPUT\"\n314-          else\n315-            echo \"::error::cannot determine whether ${IMAGE}:${TAG} is already published — refusing to guess\"\n316:            cat preflight-err.txt >&2\n317-            exit 1\n318-          fi\n319-\n320-      # No `latest`. Doc 07 §4: human-readable tags may carry the full SHA, but nothing\n321-      # in a deploy or a rollback ever resolves a tag — they consume the digest this step\n322-      # emits. A floating tag in a rollback path is how you roll back to the thing you\n323-      # were trying to escape.\n324-      #\n325:      # Skipped when preflight found the tag (CORE-73). The evidence chain below does NOT\n326-      # skip with it: sign, SBOM, scan, manifest, and the evidence upload key on the\n327-      # resolved digest, not on this step — evidence follows the digest, whichever run\n328:      # pushed it (see `resolve digest`).\n329-      - name: build and push by digest\n330-        id: build\n331:        if: steps.preflight.outputs.published != 'true'\n332:        uses: docker/build-push-action@53b7df96c91f9c12dcc8a07bcb9ccacbed38856a # v7.3.0\n333-        with:\n334-          context: ${{ steps.svc.outputs.build_context }}\n335-          file: ${{ steps.svc.outputs.dockerfile }}\n336-          push: true\n337-          provenance: mode=max\n338-          sbom: true\n339-          tags: ${{ vars.GCP_REGISTRY }}/${{ matrix.service }}:${{ github.sha }}\n340-          build-args: |\n341-            GIT_SHA=${{ github.sha }}\n342-          labels: |\n343-            org.opencontainers.image.revision=${{ github.sha }}\n344-            org.opencontainers.image.source=${{ github.server_url }}/${{ github.repository }}\n345-\n346-      # One digest, one fact. `steps.build.outcome == 'success'` used to key all five\n347-      # attestation steps below (sign, SBOM, scan, manifest, evidence upload) — a proxy\n348-      # for three different facts (a digest exists / it is signed / it is scanned) that\n349-      # went wrong on the CORE-73 skip path: a skipped build's outcome is 'skipped', so\n350:      # all five guards skipped with it, `record digest` re-emitted the preflight digest\n351-      # ungated, and the re-run went green carrying an unearned \"already signed, already\n352-      # scanned\" claim. Two live shapes of that hole: a TRIVY_EXIT_CODE=1 repo whose run\n353-      # 1 pushed, signed, then went red on a CRITICAL — \"Re-run failed jobs\" published\n354-      # the blocked digest green, with production's cosign verify passing because run 1\n355-      # genuinely signed; and a sign that died after the push, whose digest no later run\n356-      # could ever sign — every re-run entered the skip path and skipped sign with it.\n357-      #\n358:      # This step resolves THE digest — the build's, or the one preflight read back —\n359-      # and everything below keys on its existence: `always() && steps.image.outputs.digest != ''`.\n360-      # A skipped step's outputs are empty strings, so a failed build still skips the\n361:      # chain and a red preflight still reds the job: fail-closed unchanged. On the skip\n362-      # path the run re-EARNS the claims instead of inheriting them: cosign sign is\n363-      # idempotent (one more Rekor entry, same verification), the SBOM and the scan read\n364-      # the digest from the registry by ref — no rebuild — and a repo that set\n365-      # TRIVY_EXIT_CODE=1 keeps its gate: a re-run of a scan-blocked publish re-scans\n366-      # and goes red again. The deliberate cost: with TRIVY_EXIT_CODE=1, a re-dispatch\n367-      # of an old green sha can go red on a CVE published since — that is the repo's own\n368-      # policy speaking, not a liveness failure; the unset-default ('0') re-dispatch\n369-      # stays green and keeps the liveness-probe property.\n370:      - name: resolve digest\n371-        id: image\n372-        env:\n373:          # Whichever path ran: the build's digest, or the one preflight read back from\n374-          # the registry (CORE-73). Exactly one is ever non-empty.\n375:          DIGEST: ${{ steps.build.outputs.digest || steps.preflight.outputs.digest }}\n376-        run: |\n377-          set -euo pipefail\n378-          printf 'digest=%s\\n' \"$DIGEST\" >> \"$GITHUB_OUTPUT\"\n379-\n380-      # doc 07 §4 asks for provenance on the published digest. This was\n381-      # `actions/attest-build-provenance`, and on three of the four repos it failed AFTER\n382-      # the push: the GitHub attestations API is plan-gated for private repositories, so\n383-      # the step went red with the digest already in the registry, `collect` was skipped,\n384-      # and `digests` never published — a good build made unshippable by a billing tier.\n385-      # Operator ruling R44 (2026-08-25): sign with Sigstore directly, no GitHub API in\n386-      # the path.\n387-      #\n388-      # Keyless. cosign trades this job's OIDC token for a short-lived Fulcio certificate\n389-      # whose subject IS this workflow file at this ref, signs the digest, and records the\n390-      # signature in the public Rekor log. There is no key to hold, rotate, or leak, and\n391-      # the verifier — deploy-production.yml, the one place these digests become\n392-      # production revisions — checks an identity STRING, not a key it has to fetch: a\n393-      # digest that this workflow at refs/heads/main did not sign is refused there before\n394-      # any revision exists. A key-based alternative (a KMS key) would trade that for new\n395-      # infra, IAM on two identities, and a verifier that must hold a credential.\n396-      #\n397-      # Residual, stated rather than implied: the Rekor entry is public and names this\n398-      # repository, this workflow path, the commit, and the image reference (registry\n399-      # host, GCP project, service). Nothing secret — but a private repo's name and its\n400-      # registry path become discoverable. Accepted by the ruling.\n401-      #\n402-      # Signed by DIGEST: a tag is a pointer, and signing the pointer proves nothing about\n403-      # what it points at today. `--yes` is the non-interactive consent to the Rekor\n--\n444-          # unset is the documented default, not a misconfiguration.\n445-          exit-code: ${{ vars.TRIVY_EXIT_CODE || '0' }}\n446-          severity: CRITICAL,HIGH\n447-\n448-      # doc 07 §11: the evidence IS the deliverable. A deploy that cannot show its\n449-      # digest, its tests and its scan is not a deploy you can reason about at 3am.\n450-      #\n451-      # Every value arrives through `env:` and is read as \"$VAR\" — including the output\n452-      # FILENAME. This was nine ${{ }} interpolations inside a `cat <<JSON` heredoc, the\n453-      # same defect class as the confirmed deploy-staging exploit: the runner substitutes\n454-      # ${{ }} into the script TEXT before a shell parses it, so a value containing $(...)\n455-      # arrived as executable source, after auth, with a live registry credential in\n456-      # reach. Quoting the delimiter is not the fix — a value carrying a quote still\n457-      # breaks out of the surrounding quoting, and one carrying the delimiter line still\n458-      # ends the heredoc early. env: is the fix: the value goes to the process\n459-      # environment, never into the script text.\n460-      #\n461-      # \"Those inputs are hard to reach\" is not a security property — `dockerfile` and\n462-      # `build_context` come from deploy/service-inputs.ts reading deploy/services.json,\n463-      # generated from a manifest a human edits. `jq -n --arg` builds the body for the\n464-      # same reason: a quote or backslash yields valid JSON, not a file collect cannot\n465-      # parse. No -c, deliberately — this file is read by a human, and the -c rule binds\n466-      # values captured into a variable or written to $GITHUB_OUTPUT.\n467-      #\n468-      # `if: always() && steps.image.outputs.digest != ''`, on the sign, SBOM, and scan\n469-      # above, here, and on the evidence upload below (2026-08-25, measured on studio run\n470-      # 32904680804 and dev-profile's red main; re-keyed 2026-08-26, see `resolve\n471-      # digest`): once a digest EXISTS in the registry — this run's build, or a prior\n472:      # run's read back by the preflight — the evidence runs, whatever fails around it.\n473-      # Under the default `success()` a failed attest, scan, or SBOM skipped them and\n474-      # the run ended with a live digest and no manifest, no SBOM, no SARIF — a CVE the\n475-      # run could not name, and a digest that had to be re-scanned by hand. Keyed to the\n476-      # DIGEST, not to any one predecessor: keying it to the scan is right for a repo\n477-      # whose scan fails and wrong for one whose attest fails, and keying it to the\n478-      # build was wrong for the run whose build correctly SKIPPED. `collect` is still\n479-      # gated on the whole job succeeding, so nothing downstream consumes a digest from\n480-      # a failed publish; this only keeps the evidence of what was pushed.\n481-      - name: source-to-image manifest\n482-        if: always() && steps.image.outputs.digest != ''\n483-        env:\n484-          SERVICE: ${{ matrix.service }}\n485-          REPOSITORY: ${{ github.repository }}\n486-          COMMIT: ${{ github.sha }}\n487-          REF: ${{ github.ref }}\n488-          RUN_ID: ${{ github.run_id }}\n489-          IMAGE: ${{ vars.GCP_REGISTRY }}/${{ matrix.service }}\n490-          DIGEST: ${{ steps.image.outputs.digest }}\n491-          DOCKERFILE: ${{ steps.svc.outputs.dockerfile }}\n492-          BUILD_CONTEXT: ${{ steps.svc.outputs.build_context }}\n493-        run: |\n494-          set -euo pipefail\n495-          jq -n \\\n496-            --arg service \"$SERVICE\" \\\n497-            --arg repository \"$REPOSITORY\" \\\n498-            --arg commit \"$COMMIT\" \\\n499-            --arg ref \"$REF\" \\\n500-            --arg run_id \"$RUN_ID\" \\\n--\n513-      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1\n514-        if: always() && steps.image.outputs.digest != ''\n515-        with:\n516-          name: publish-evidence-${{ matrix.service }}\n517-          path: |\n518-            image-manifest-${{ matrix.service }}.json\n519-            sbom-${{ matrix.service }}.spdx.json\n520-            trivy-${{ matrix.service }}.sarif\n521-          if-no-files-found: error\n522-          overwrite: true\n523-\n524-      # Both values through env:. This was `echo '${{ ... }}' > \"digests/${{ ... }}\"` —\n525-      # single quotes are not a sandbox, they are text the runner writes around text it\n526-      # already substituted, so one quote character in either value ends the quoting and\n527-      # the rest of the value is shell. `printf '%s\\n'` also beats `echo` here: echo\n528-      # interprets leading dashes and backslashes on some shells, printf does not.\n529-      - name: record digest\n530-        env:\n531-          SERVICE: ${{ matrix.service }}\n532-          # The one resolved digest — same value every attestation step above signed,\n533-          # SBOM'd, and scanned. Under the default `success()` this step is unreachable\n534-          # when any of them failed, so a recorded digest is one whose attestation ran\n535-          # and passed ON THIS RUN; the empty-digest refusal below is the belt for the\n536-          # pathological build-emitted-nothing path.\n537-          DIGEST: ${{ steps.image.outputs.digest }}\n538-        run: |\n539-          set -euo pipefail\n540-          if [ -z \"$DIGEST\" ]; then\n541:            echo \"::error::no digest from the build or the preflight — nothing to record\"\n542-            exit 1\n543-          fi\n544-          mkdir -p digests\n545-          printf '%s\\n' \"$DIGEST\" > \"digests/$SERVICE\"\n546-\n547-      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1\n548-        with:\n549-          name: digest-${{ matrix.service }}\n550-          path: digests/${{ matrix.service }}\n551-          if-no-files-found: error\n552-          overwrite: true\n553-\n554-  collect:\n555-    needs: publish\n556-    if: always() && needs.publish.result == 'success'\n557-    runs-on: ${{ vars.CI_RUNNER_LINUX || 'ubuntu-latest' }}\n558-    outputs:\n559-      digests: ${{ steps.collect.outputs.digests }}\n560-    steps:\n561-      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1\n562-        with:\n563-          pattern: digest-*\n564-          path: digests\n565-          merge-multiple: false\n566-      # `jq -c` is load-bearing, not a nicety. Without it jq pretty-prints, so the\n567-      # accumulator was MULTILINE from the first service onward and then written with\n568-      # `printf 'digests=%s\\n'` into $GITHUB_OUTPUT — a single-line key=value format.\n569-      # This was broken, not merely risky: the `digests` workflow_call output was corrupt\n","exit_code":0,"status":"completed"}}
