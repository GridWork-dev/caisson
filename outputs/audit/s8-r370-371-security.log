{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/lib/cart-routes.ts'","aggregated_output":"     1\t// ADR-0424: session and entitlement checks precede any Paddle transaction creation.\n     2\timport { z } from \"zod\";\n     3\timport type { SessionContext } from \"@caisson/auth\";\n     4\timport { BUNDLE_CATALOG, MODULE_CATALOG } from \"./catalog.ts\";\n     5\t\n     6\tconst bodySchema = z\n     7\t  .object({\n     8\t    itemIds: z.array(z.string().trim().min(1).max(128)).min(1).max(50),\n     9\t    promoCode: z\n    10\t      .string()\n    11\t      .trim()\n    12\t      .min(1)\n    13\t      .max(64)\n    14\t      .regex(/^[A-Za-z0-9_-]+$/)\n    15\t      .optional(),\n    16\t  })\n    17\t  .strict();\n    18\t\n    19\texport interface CartRouteDependencies {\n    20\t  session(request: Request): Promise<SessionContext | null>;\n    21\t  owned(accountId: string): Promise<ReadonlySet<string>>;\n    22\t  createTransaction(input: {\n    23\t    priceIds: string[];\n    24\t    accountId: string;\n    25\t    promoCode?: string;\n    26\t  }): Promise<string>;\n    27\t}\n    28\tconst json = (data: unknown, status = 200) =>\n    29\t  Response.json(data, {\n    30\t    status,\n    31\t    headers: { \"cache-control\": \"private, no-store\" },\n    32\t  });\n    33\t\n    34\texport function cartOwnedHandler(\n    35\t  deps: Pick<CartRouteDependencies, \"session\" | \"owned\">,\n    36\t) {\n    37\t  return async (request: Request): Promise<Response> => {\n    38\t    const session = await deps.session(request);\n    39\t    const owned =\n    40\t      session === null\n    41\t        ? new Set<string>()\n    42\t        : await deps.owned(session.accountId);\n    43\t    return json({ owned: [...owned] });\n    44\t  };\n    45\t}\n    46\t\n    47\texport function cartCheckoutHandler(deps: CartRouteDependencies) {\n    48\t  return async (request: Request): Promise<Response> => {\n    49\t    // Cookie-authenticated mutation: require same-origin JSON, never accept a posted account id.\n    50\t    if (request.headers.get(\"origin\") !== new URL(request.url).origin)\n    51\t      return json({ error: \"forbidden\" }, 403);\n    52\t    try {\n    53\t      const session = await deps.session(request);\n    54\t      if (session === null) return json({ error: \"unauthenticated\" }, 401);\n    55\t      if (\n    56\t        request.headers.get(\"content-type\")?.split(\";\")[0]?.trim() !==\n    57\t        \"application/json\"\n    58\t      )\n    59\t        return json({ error: \"invalid request\" }, 400);\n    60\t      const parsed = bodySchema.safeParse(\n    61\t        await request.json().catch(() => null),\n    62\t      );\n    63\t      if (!parsed.success) return json({ error: \"invalid request\" }, 400);\n    64\t      const catalog = new Map(\n    65\t        [...BUNDLE_CATALOG, ...MODULE_CATALOG].map((item) => [item.id, item]),\n    66\t      );\n    67\t      const ids = [...new Set(parsed.data.itemIds)];\n    68\t      if (ids.some((id) => !catalog.has(id)))\n    69\t        return json({ error: \"unknown catalog item\" }, 400);\n    70\t      const owned = await deps.owned(session.accountId);\n    71\t      const remaining = ids.filter((id) => !owned.has(id));\n    72\t      const removed = ids.filter((id) => owned.has(id));\n    73\t      if (remaining.length === 0)\n    74\t        return json({ error: \"already owned\", removed }, 409);\n    75\t      const transactionId = await deps.createTransaction({\n    76\t        priceIds: remaining.map((id) => catalog.get(id)!.priceId),\n    77\t        accountId: session.accountId,\n    78\t        ...(parsed.data.promoCode === undefined\n    79\t          ? {}\n    80\t          : { promoCode: parsed.data.promoCode }),\n    81\t      });\n    82\t      return json({ transactionId, removed });\n    83\t    } catch {\n    84\t      // Failed session/account/entitlement reads block checkout. Never echo provider errors.\n    85\t      return json({ error: \"checkout unavailable\" }, 503);\n    86\t    }\n    87\t  };\n    88\t}\n","exit_code":0,"status":"completed"}}
