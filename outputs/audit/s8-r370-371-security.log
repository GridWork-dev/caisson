rite(\n1127:            \"[service-license] abandoned checkout converted capture threw (ignored)\\n\",\n1128-          );\n1129-        }\n1130-      }\n1131-      // Post-commit purchase-confirmation email: same detached, never-throw contract as the\n1132-      // Discord push / PostHog capture above, gated identically (a granting, money-carrying,\n1133-      // non-re-delivery event only). Unlike those two, `purchaseEmailNotify` is never null\n1134-      // (server.ts always wires a real-or-capture `@caisson/email` transport) — the gate below is\n1135-      // what decides WHEN to send, not whether email is configured.\n1136-      //\n1137:      // INFO (SHIP review 2026-07-08): a credit-pack-only purchase grants no entitlement\n1138-      // (`grantedEntitlements` stays empty), so it never trips this gate and gets no BRANDED\n1139-      // receipt from Caisson. Deliberate, not a gap — Paddle is the merchant of record and already\n1140-      // sends its own transactional payment receipt for every charge, branded or not.\n1141-      if (\n1142-        result.event !== null &&\n1143:        \"amountTotal\" in result.event &&\n1144-        result.grantedEntitlements.length > 0\n1145-      ) {\n1146-        // distinguish a subscription-CYCLE charge from a first purchase. A Paddle\n1147-        // `transaction.completed` carrying a subscription_id whose subscription already granted\n1148-        // maps to `invoice.paid` with `billingReason: \"subscription_cycle\"` (origin\n1149-        // `subscription_recurring`); `subscription_create` (the first charge) and every one-time\n1150-        // `purchase.completed` stay first-purchase receipts. The mixed-cart rule is unaffected: a\n1151-        // subscription invoice is single-line by design and never carries a renewal-book line, so\n1152-        // this receipt always states its own grand total.\n1153-        const notice: PurchaseEmailNotice = {\n1154:          accountId: result.event.accountId,\n1155-          orderId: result.event.sourceEventId,\n1156-          currency: result.event.currency,\n1157:          amountTotalMinor: result.event.amountTotal,\n1158-          lines: result.skuLines.map((line) => ({\n1159-            productSlug: line.productSlug,\n1160-          })),\n1161-          subscriptionCycle:\n1162-            result.event.type === \"invoice.paid\" &&\n1163-            result.event.billingReason === \"subscription_cycle\",\n1164-          // ADR-0292: the already-awaited first-mint result rides along when it succeeded. A mint\n1165-          // failure (`null`, already logged as an operator ALERT) sends the receipt WITHOUT a token\n1166:          // rather than not sending at all — a missing license is recoverable (the next event, or\n1167-          // the admin first-mint lever); a missing receipt is not.\n1168:          ...(licenseToken !== null ? { licenseToken } : {}),\n1169-        };\n1170-        try {\n1171-          void deps.purchaseEmailNotify(notice).catch(() => {\n1172-            process.stderr.write(\n1173:              \"[service-license] purchase confirmation email rejected (ignored)\\n\",\n1174-            );\n1175-          });\n1176-        } catch {\n1177-          process.stderr.write(\n1178:            \"[service-license] purchase confirmation email threw (ignored)\\n\",\n1179-          );\n1180-        }\n1181-      }\n1182-      // Post-commit renewal-confirmation email (ADR-0251): the SIBLING send for a RENEWAL_BOOK\n1183-      // line, which grants nothing so it never trips the `grantedEntitlements.length > 0` gate\n1184-      // above. Same detached, never-throw contract, gated on `renewedEntitlements` instead. A\n1185-      // mixed cart (a purchase line + a renewal line in one event) fires BOTH emails — the\n1186-      // purchase receipt states the whole-event total, so THIS notice omits it (two emails each\n1187-      // claiming the full cart total would read as a double charge).\n1188-      if (\n1189-        result.event !== null &&\n1190:        \"amountTotal\" in result.event &&\n1191-        result.renewedEntitlements.length > 0\n1192-      ) {\n1193-        const notice: RenewalEmailNotice = {\n1194:          accountId: result.event.accountId,\n1195-          orderId: result.event.sourceEventId,\n1196-          currency: result.event.currency,\n1197:          amountTotalMinor:\n1198-            result.grantedEntitlements.length > 0\n1199-              ? undefined\n1200:              : result.event.amountTotal,\n1201-          lines: result.renewedEntitlements.map((r) => ({\n1202-            entitlementId: r.entitlementId,\n1203-            newWindowEnd: r.newWindowEnd,\n1204-          })),\n1205-        };\n1206-        try {\n1207-          void deps.renewalEmailNotify(notice).catch(() => {\n1208-            process.stderr.write(\n1209:              \"[service-license] renewal confirmation email rejected (ignored)\\n\",\n1210-            );\n1211-          });\n1212-        } catch {\n1213-          process.stderr.write(\n1214:            \"[service-license] renewal confirmation email threw (ignored)\\n\",\n1215-          );\n1216-        }\n1217-      }\n1218-      // Post-commit revoke/refund notice (G27): same detached, never-throw contract as every\n1219-      // push above, gated on `revokeNotices` — populated ONLY when `applyBillingEvent` actually\n1220-      // revoked an active grant this delivery (a redelivery or a Resend of an already-revoked\n1221-      // purchase revokes nothing further, so this stays empty with no separate idempotency gate).\n1222-      for (const revoke of result.revokeNotices) {\n1223-        try {\n1224-          void deps.revokeEmailNotify(revoke).catch(() => {\n1225-            process.stderr.write(\n1226:              \"[service-license] revoke notice email rejected (ignored)\\n\",\n1227-            );\n1228-          });\n1229-        } catch {\n1230-          process.stderr.write(\n1231:            \"[service-license] revoke notice email threw (ignored)\\n\",\n1232-          );\n1233-        }\n1234-      }\n1235-      // Post-commit chargeback/dispute operator alert (ADR-0294): same detached, never-throw\n1236-      // contract as every push above, gated on `chargebackAlerts` (populated ONLY by the\n1237-      // ALERT-ONLY `chargeback.detected` case in apply-billing-event.ts — no grant/revoke/claw\n1238-      // runs for it). `deps.chargebackAlert` is never `null` (server.ts always wires it; the\n1239-      // stderr ALERT floor fires even with no Discord layer configured).\n1240-      for (const alert of result.chargebackAlerts) {\n1241-        try {\n1242-          void deps.chargebackAlert(alert).catch(() => {\n1243-            process.stderr.write(\n1244:              \"[service-license] chargeback alert rejected (ignored)\\n\",\n1245-            );\n1246-          });\n1247-        } catch {\n1248-          process.stderr.write(\n1249:            \"[service-license] chargeback alert threw (ignored)\\n\",\n1250-          );\n1251-        }\n1252-      }\n1253-      // 2xx ONLY after the grant commits, so Paddle stops retrying only on a durable success.\n1254-      return json({ ok: true });\n1255-    }\n1256-\n1257-    return json({ error: \"not found\" }, 404);\n1258-  });\n1259-}\n","exit_code":0,"status":"completed"}}
