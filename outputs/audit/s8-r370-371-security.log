fore:ship\", use: \"code-reviewer\" },\npackages/agent-dev/src/golden.ts-95-  ],\npackages/agent-dev/src/golden.ts-96-  // Trusted-tier render: scripts emit alongside references/assets (the withheld path is covered in\npackages/agent-dev/src/golden.ts-97-  // emitter.test.ts). Pins the bundled-file layout under both SKILL.md directory targets.\npackages/agent-dev/src/golden.ts-98-  allowScripts: true,\npackages/agent-dev/src/golden.ts-99-};\npackages/agent-dev/src/golden.ts-100-\npackages/agent-dev/src/golden.ts-101-export const agentDevGolden = defineModuleGolden({\n--\npackages/agent-dev/src/index.ts-12-//     `AGENTS.md` base layer (read natively by Codex, Cursor, Devin, Zed, Gemini CLI, and the Copilot\npackages/agent-dev/src/index.ts-13-//     coding agent — ADR-0264, superseding the prior \"Codex harness\" framing) + per-artifact Cursor,\npackages/agent-dev/src/index.ts-14-//     Devin Desktop/legacy Windsurf, GitHub Copilot, and Cline bundles — Claude Code is ONE emit\npackages/agent-dev/src/index.ts-15-//     target among several, never the substrate (the ADR-0066 binding contract VERIFY re-asks);\npackages/agent-dev/src/index.ts-16-//   • the governed sandboxed tool-exec gate (@caisson/tool-exec, ADR-0178): a default-deny allowlist +\npackages/agent-dev/src/index.ts-17-//     Zod-strict argv schemas + execFile arg-arrays (never a shell) — wired as a live gate on the\npackages/agent-dev/src/index.ts-18-//     composed edition so a buyer gets the exec seam from this one import home;\npackages/agent-dev/src/index.ts-19-//   • the sandboxed, governed agent runner (@caisson/agent-runner, ADR-0186): spawns a headless agent\npackages/agent-dev/src/index.ts:20://     CLI in an isolated worktree behind a from-scratch, scrubbed environment, streaming an auditable\npackages/agent-dev/src/index.ts-21-//     run transcript — reachable from this one edition import home; a buyer supplies its own provider\npackages/agent-dev/src/index.ts-22-//     credential and endpoint for each run, so the edition never resolves or holds one itself.\npackages/agent-dev/src/index.ts-23-// Plus the curated Caisson-native default content and the @caisson/ai-config embedder-lane seam.\npackages/agent-dev/src/index.ts-24-// Engine-neutral end to end: no LLM call, no vendor SDK, no harness assumption lives in the kernel.\npackages/agent-dev/src/index.ts-25-\npackages/agent-dev/src/index.ts-26-// ── The composed base surfaces + curated content, re-exported as ONE edition import home ────────────\npackages/agent-dev/src/index.ts-27-export * from \"@caisson/agent-kernel\";\npackages/agent-dev/src/index.ts-28-export * from \"@caisson/local-store\";\n","exit_code":0,"status":"completed"}}
