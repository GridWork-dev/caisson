{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n -C 10 \\\"timingSafe|safeEqual|authorization|bearer|webhook|signature|accountId|tenant|withTenant|issue|license|credit|price|amount|parseStrict|\\\\.strict\\\\(|fetchWithTimeout|process\\\\.env\\\" services/license/src/app.ts\"","aggregated_output":"1:// src/app.ts — the license-ISSUER HTTP router (ADR-0110, implements ADR-0010). A pure\n2:// `Request → Response` function over injected deps (token, signer, registry index, tenant Transactor)\n3:// so it is testable without a live socket. Issuance is LAZY + bearer-gated: POST /issue mints a signed\n4:// license carrying the account's PURCHASED entitlement ids (the claims contract — every consumer\n5-// expands them against the index at verification: Worker resolveGate, MCP server). The read is\n6:// RLS-scoped inside `withTenant` and validated fail-closed via `expandEntitlements` before signing\n7:// (`@caisson/license-issue`); the expansion is VALIDATION ONLY, never the signed set — signing the\n8-// expansion would orphan the purchased-id-keyed `updatesWindows`/`entitledSince` maps at the edge\n9:// (the Worker's window fold matches token entitlements against those keys; audit F2 2026-07-06). POST /issue is\n10:// IDEMPOTENT per (accountId, major) (\"persist & reuse\"): the first call mints, signs, and persists the\n11:// token via `license-grant-store.ts`; every later call for the same (accountId, major) re-serves the\n12-// STORED token byte-identical — never proliferates fresh perpetual tokens for one purchase — UNLESS\n13-// the account's computed ADR-0244/0255 per-entitlement updates windows differ (canonically) from the\n14:// stored token's signed `updatesWindows` map (a renewal landed), in which case /issue RE-MINTS and\n15-// replaces the stored token in place (ADR-0251 Decision 3; still one row per (account, major)). A\n16:// different major always mints its own grant. POST /webhook is the Paddle Merchant-of-Record\n17:// destination (license.caisson.sh/webhook, ADR-0108/0116): it verifies the `Paddle-Signature` HMAC over\n18:// the RAW body (timing-safe, fail-closed) and provisions a verified purchase by running BOTH the credit\n19:// grant AND the entitlement grant in ONE tenant transaction. /health is public (like services/docs). Every\n20-// response carries the standard security-floor headers (nosniff / frame-deny / HSTS). The Bearer gate is\n21:// timing-safe over the VARIABLE-LENGTH token (SHA-256 → `timingSafeEqual`, the security-floor rule) and\n22-// fail-closed when the token is unset. Server-to-server contract — no CORS.\n23:import { createHash, randomUUID, timingSafeEqual } from \"node:crypto\";\n24-import { z } from \"zod\";\n25-import type { BillingProvider } from \"@caisson/billing\";\n26-import { AuthnError, ConflictError } from \"@caisson/kernel\";\n27-import {\n28-  loadOriginGateConfig,\n29-  originRequestAuthorized,\n30-  servingRevision,\n31-  REVISION_HEADER,\n32-  type OriginGateConfig,\n33-} from \"@caisson/kernel/node\";\n34:import { issueLicense, type Signer } from \"@caisson/license-issue\";\n35-import {\n36-  decodeToken,\n37:  licenseClaimsSchema,\n38:  licenseTierSchema,\n39-  type LicenseTier,\n40:} from \"@caisson/license-verify\";\n41-import { withRequestSpan } from \"@caisson/observability\";\n42-import { withAdminWrite } from \"@caisson/org-controls\";\n43-import {\n44-  expandEntitlements,\n45-  type RegistryIndex,\n46-} from \"@caisson/registry-schema\";\n47:import { type Transactor, withTenant } from \"@caisson/tenancy-rls\";\n48-import type { ChargebackAlert } from \"./chargeback-notify.ts\";\n49-import {\n50-  createEvalApplication,\n51-  readEvalApplication,\n52-  recordIssuedEval,\n53-} from \"./eval-store.ts\";\n54-import {\n55-  type DomainSignals,\n56-  type EvalConfig,\n57-  extractDomain,\n--\n66-} from \"./email-notify.ts\";\n67-import {\n68-  computeEntitledSince,\n69-  computeUpdatesWindows,\n70-  readEntitlements,\n71-} from \"./entitlement-store.ts\";\n72-import {\n73-  readLicenseGrant,\n74-  storeLicenseGrant,\n75-  updateLicenseGrantToken,\n76:} from \"./license-grant-store.ts\";\n77-import type { PurchaseCapture } from \"./posthog-capture.ts\";\n78-import { clientIp, type RateBucket, type RateLimiter } from \"./rate-limit.ts\";\n79:import { type BillingWebhookResult, handleBillingWebhook } from \"./webhook.ts\";\n80-import type {\n81-  RateLimiterFailureMode,\n82-  RateLimiterInfraAlert,\n83-} from \"./alerting.ts\";\n84-\n85-/** The one path exempt from the origin gate. MUST equal `healthcheckPath` in\n86: *  services/license/railway.toml — a test pins the pair, because a drift there silently re-freezes\n87- *  the fleet deploy with no local signal. */\n88-export const HEALTH_PROBE_PATH = \"/health\";\n89-\n90-export interface IssueAppDeps {\n91:  /** Bearer secret for POST /issue. Must be non-empty — server.ts fails closed if it is unset. */\n92-  token: string;\n93-  /**\n94:   * A SECOND, admin-scoped Bearer that also authorizes POST /issue (ADR-0220 Fork AM-5). Distinct\n95:   * from `token` (`LICENSE_ISSUE_TOKEN`) so the apps/admin reissue proxy authenticates WITHOUT ever\n96:   * holding the primary issue secret — routing a CF-Access session through the shared token would\n97:   * let any CF-Access identity mint licenses for any account. Empty/unset ⇒ no admin path (the\n98:   * default; a normal license service never sets it). Compared timing-safe like `token`.\n99-   */\n100-  adminToken?: string;\n101-  /** The signing identity (default Ed25519Signer over a PKCS8 env key; KMS is an un-wired seam). */\n102-  signer: Signer;\n103-  /** The built registry index — membership truth for entitlement expansion (ADR-0071). */\n104-  index: RegistryIndex;\n105:  /** The tenant Transactor — the /issue entitlement reads run inside `withTenant` over it (RLS). */\n106-  db: Transactor;\n107-  /**\n108-   * The Paddle Merchant-of-Record billing provider (verify + parse, ADR-0108/0116). `null` when\n109:   * `PADDLE_WEBHOOK_SECRET` is unset — POST /webhook then fails closed (401): an unverifiable payload\n110-   * must NEVER provision. server.ts builds it from env and injects it.\n111-   */\n112-  provider: BillingProvider | null;\n113-  /**\n114:   * Per-IP token-bucket limiter (services-hardening #4). Gates POST /webhook (the public grey-origin MoR\n115:   * surface) and POST /issue (defense-in-depth before the bearer check). The bearer / HMAC stay the\n116-   * primary auth — this only caps an abusive flood. server.ts injects it.\n117-   */\n118-  limiter: RateLimiter;\n119-  /** Cloudflare Worker origin gate. Omitted only when the runtime loader supplies the config. */\n120-  originGate?: OriginGateConfig;\n121-  /**\n122-   * Detached operational alert for limiter infrastructure failures. The payload is intentionally\n123-   * redacted to route bucket + applied failure policy; it never receives request or error data.\n124-   */\n125-  rateLimiterAlert: (alert: RateLimiterInfraAlert) => Promise<void>;\n126-  /**\n127-   * The post-grant Discord role push (ADR-0203). `null` when SUPPORT_BOT_URL /\n128-   * SUPPORT_BOT_GRANT_TOKEN are unset — the push is simply skipped. Fired DETACHED after the grant\n129:   * commits; it must never delay or fail the webhook response (the injected implementation —\n130-   * `notifyDiscordGrant` — never throws).\n131-   */\n132-  discordNotify: ((push: DiscordGrantPush) => Promise<void>) | null;\n133-  /**\n134-   * Server-side PostHog `purchase` capture (ADR-0237 F8). `null` when POSTHOG_CAPTURE_KEY is\n135-   * unset — the capture is simply skipped. Same post-commit detached contract as `discordNotify`\n136-   * (the injected implementation — `capturePostHogPurchase` — never throws).\n137-   */\n138-  posthogCapture: ((capture: PurchaseCapture) => Promise<void>) | null;\n139-  /**\n140-   * Abandoned-checkout conversion capture (SPEC outputs/specs/deferred-respec/\n141-   * SPEC-abandoned-checkout-email.md §e, 2026-07-10 lock). Optional and `null`-able like\n142-   * `posthogCapture` (absent when POSTHOG_CAPTURE_KEY is unset) — the injected implementation\n143-   * itself checks whether this account has a recent abandoned-checkout notice\n144-   * (`hasRecentAbandonedCheckoutNotice`) before firing anything, so this gate here is only \"did a\n145-   * real, granting purchase land,\" same as `posthogCapture`'s own gate.\n146-   */\n147:  abandonedCheckoutConverted?: ((accountId: string) => Promise<void>) | null;\n148-  /**\n149-   * The post-grant purchase-confirmation email. Unlike `discordNotify`/`posthogCapture` this is\n150-   * never `null` — `server.ts` always wires `email-notify.ts#resolveEmailer()` (Resend or the\n151-   * capture driver), so email is always \"sent\" somewhere. Same detached, never-throw contract as\n152-   * `discordNotify` (the injected implementation — `notifyPurchaseEmail` — never throws).\n153-   */\n154-  purchaseEmailNotify: (notice: PurchaseEmailNotice) => Promise<void>;\n155-  /**\n156-   * The post-grant renewal-confirmation email (ADR-0251) — the SIBLING send for a RENEWAL_BOOK\n157-   * line, which grants nothing so it never fires `purchaseEmailNotify`. Same never-`null`,\n158-   * always-wired, detached, never-throw contract. A mixed cart (a new entitlement line + a\n159-   * renewal line in one event) fires BOTH `purchaseEmailNotify` and this; only the purchase\n160:   * receipt carries the whole-event total (this notice's `amountTotalMinor` is omitted there).\n161-   */\n162-  renewalEmailNotify: (notice: RenewalEmailNotice) => Promise<void>;\n163-  /**\n164-   * G27 (buyer-lifecycle audit 2026-07-07) — the post-revoke \"your access changed\" email, fired\n165-   * only when a subscription cancel or a refund ACTUALLY revoked an active grant (see\n166-   * `RevokeNotice`). Same never-`null`, always-wired, detached, never-throw contract as\n167-   * `purchaseEmailNotify`/`renewalEmailNotify`.\n168-   */\n169-  revokeEmailNotify: (notice: RevokeEmailNotice) => Promise<void>;\n170-  /**\n--\n176-  chargebackAlert: (alert: ChargebackAlert) => Promise<void>;\n177-  /**\n178-   * Index-parity probe surface (the F-1 index-parity residual: three independently-baked copies of\n179-   * registry/index.json can drift). The sha256 (first 12 hex) of the index.json BYTES this service\n180-   * loaded at boot, plus the entry count — echoed additively on GET /health. Absent ⇒ /health keeps\n181-   * its bare `{ ok: true }` shape (existing probes grep it). server.ts always supplies both.\n182-   */\n183-  indexDigest?: string;\n184-  indexEntries?: number;\n185-  /**\n186:   * The evaluation-access surface (ADR-0274 §2 / ADR-0280 verified time-boxed eval licenses).\n187-   * `null`/absent ⇒ POST /eval/* returns 404 (a deploy without the eval tables provisioned simply\n188:   * does not serve them; /issue + /webhook are unaffected). server.ts always wires it.\n189-   */\n190-  eval?: EvalAppDeps | null;\n191-}\n192-\n193-/** Injected dependencies for the eval-access routes. */\n194-export interface EvalAppDeps {\n195-  /** Verification thresholds (ADR-0274/0280) — from `loadEvalConfig`. */\n196-  config: EvalConfig;\n197-  /**\n198-   * Resolve a domain's verification signals (MX / age / enrichment). INJECTED so scoring is\n199-   * network-free in tests and config-gated in prod (`eval-signals.ts#resolveDomainSignals`). Every\n200-   * failure resolves to an `undefined` field (uncertainty → review), never a pass.\n201-   */\n202-  resolveSignals: (domain: string) => Promise<DomainSignals>;\n203-}\n204-\n205-/**\n206: * POST /issue body. `.strict()` rejects unknown fields; the account id + version are bounded. The\n207: * tier is the SHARED `licenseTierSchema` (never re-declared). `entitlements` are NOT taken from the\n208- * caller — they are resolved server-side from the account's purchases (ADR-0071), so a caller cannot\n209- * mint itself entitlements it did not buy. `expiry` is an ISO-8601 instant or `null` (perpetual-per-major).\n210- *\n211- * TRUST ASSUMPTION (`tier`): unlike `entitlements`, `tier` is asserted by the caller. This is a\n212: * server-to-server, bearer-gated endpoint whose sole caller is the billing service, which derives the\n213: * tier from the same account-entitlement store. The bearer token (`LICENSE_ISSUE_TOKEN`) is the trust\n214- * boundary; there is no independent purchase→tier check here by design — downstream feature access gates\n215- * on the server-resolved `entitlements` list, not the `tier` label.\n216- */\n217-// Exported so tools/security/emit-openapi.ts can generate a true-to-code OpenAPI spec for schema\n218-// fuzzing (Schemathesis) without re-declaring the shape — the emit is the fuzz contract's source.\n219-export const IssueBody = z\n220-  .object({\n221:    accountId: z.string().trim().min(1).max(256),\n222:    tier: licenseTierSchema,\n223-    major: z.number().int().nonnegative(),\n224-    expiry: z.string().datetime({ offset: true }).nullable(),\n225-    // TRUE key rotation (the admin rotation lever): skip the idempotent re-serve and mint a FRESH\n226:    // token + licenseId even when the stored claims are unchanged, replacing the stored grant in\n227:    // place. The caller is responsible for denying the OLD licenseId (the edge deny-set) BEFORE\n228-    // requesting this mint — this flag only forces the re-mint. Grants no new privilege: both\n229:    // bearers can already mint; absent/false keeps the persist-and-reuse contract byte-identical.\n230-    rotate: z.boolean().optional(),\n231-  })\n232:  .strict();\n233-\n234-/**\n235: * POST /eval/apply body (ADR-0280). `.strict()` rejects unknown fields. `email` is the applicant's\n236- * WORK email (Zod-validated + bounded); the domain is derived server-side (never trusted from the\n237- * caller). `entitlements` is the purchased-id scope to evaluate (validated against the registry\n238: * index at /eval/issue). `accountId` is the buyer account (from a verified session upstream).\n239- */\n240-export const EvalApplyBody = z\n241-  .object({\n242:    accountId: z.string().trim().min(1).max(256),\n243-    email: z.string().trim().email().max(320),\n244-    entitlements: z.array(z.string().trim().min(1).max(128)).min(1).max(64),\n245-  })\n246:  .strict();\n247-\n248:/** POST /eval/issue body. `.strict()`. `evalId` is the application id; `major` the license major. */\n249-export const EvalIssueBody = z\n250-  .object({\n251-    evalId: z.string().uuid(),\n252-    major: z.number().int().nonnegative(),\n253-  })\n254:  .strict();\n255-\n256-/**\n257: * POST /admin/affiliate/mint body (ADR-0315/0320). `.strict()`. The admin-scoped, server-to-server\n258- * affiliate mint: apps/admin's mint proxy sends the redeemable `code` + an internal `description`\n259- * (the affiliate name); this endpoint holds `PADDLE_API_KEY` and calls the billing driver's\n260- * `createDiscount` so that credential never enters the admin app. The 10%/30% program parameters are\n261- * inlined in the driver (operator-locked, ADR-0320) — never taken from this body.\n262- */\n263-export const AffiliateMintBody = z\n264-  .object({\n265-    code: z\n266-      .string()\n267-      .trim()\n268-      .min(1)\n269-      .max(32)\n270-      .regex(/^[A-Za-z0-9]+$/, \"code must be letters and digits only\"),\n271-    description: z.string().trim().min(1).max(200),\n272-  })\n273:  .strict();\n274-\n275-const SECURITY_HEADERS: Record<string, string> = {\n276-  \"X-Content-Type-Options\": \"nosniff\",\n277-  \"X-Frame-Options\": \"DENY\",\n278-  \"Strict-Transport-Security\": \"max-age=63072000; includeSubDomains\",\n279-};\n280-\n281-function respond(\n282-  body: string,\n283-  status: number,\n--\n302-  respond(JSON.stringify(data), status, \"application/json; charset=utf-8\");\n303-const text = (\n304-  body: string,\n305-  status = 200,\n306-  extra?: Record<string, string>,\n307-): Response => respond(body, status, \"text/plain; charset=utf-8\", extra);\n308-\n309-/**\n310- * Timing-safe Bearer check. `LICENSE_ISSUE_TOKEN` is an opaque secret of not-guaranteed-fixed length, so\n311- * per the security floor's VARIABLE-LENGTH rule both sides are SHA-256-digested to fixed 32-byte buffers\n312: * before `timingSafeEqual` — avoiding the equal-length guard that would leak the token's byte length to a\n313- * remote timing oracle. Normalization is identical on both sides (raw bytes), so only the value compares.\n314- */\n315-function tokenMatches(presented: string, token: string): boolean {\n316-  if (token.length === 0) return false; // unconfigured ⇒ fail closed\n317-  const a = createHash(\"sha256\").update(presented).digest();\n318-  const b = createHash(\"sha256\").update(token).digest();\n319:  return timingSafeEqual(a, b);\n320-}\n321-\n322-/**\n323: * Timing-safe Bearer check against the primary issue token AND (if configured) the distinct\n324- * admin-scoped token (ADR-0220). BOTH digests are always computed before either compares, so the\n325- * presence of the admin token never changes the timing profile of a primary-token request. An\n326: * empty presented bearer matches neither (both configured secrets are non-empty by construction).\n327- */\n328-function authorized(req: Request, token: string, adminToken: string): boolean {\n329:  const header = req.headers.get(\"authorization\") ?? \"\";\n330-  const presented = header.startsWith(\"Bearer \") ? header.slice(7) : \"\";\n331-  const primary = tokenMatches(presented, token);\n332-  const admin = tokenMatches(presented, adminToken);\n333-  return primary || admin;\n334-}\n335-\n336-/**\n337- * The re-mint-relevant claims carried by a STORED wire token — the signed `entitlements` (sorted\n338- * purchased ids) plus the per-entitlement `updatesWindows` (ADR-0251 D3 / ADR-0255) AND\n339: * `entitledSince` snapshot instants (ADR-0257 §1.2). Decode-only (no signature verify — the stored\n340- * token was minted by THIS service and is re-verified offline by every consumer; the baked verify\n341- * key here is prod, which a dev/test-signed stored token would fail). An absent/null map field (a\n342- * pre-window / pre-snapshot token) normalizes to the EMPTY map, so a subscription-only account's\n343- * stored token keeps re-serving byte-identical. A decode/parse failure reads as empty claims — the\n344- * fresh comparison then differs (any entitled account has a non-empty purchased set) and the corrupt\n345- * stored token is RE-MINTED in place rather than re-served: a token the verifier would reject helps\n346- * nobody, and the grant row stays unique per (account, major).\n347- */\n348-function storedRemintClaims(token: string): {\n349-  entitlements: string[];\n350-  updatesWindows: Record<string, string>;\n351-  entitledSince: Record<string, string>;\n352-} {\n353-  try {\n354:    const claims = licenseClaimsSchema.parse(\n355-      JSON.parse(decodeToken(token).payload) as unknown,\n356-    );\n357-    return {\n358-      entitlements: [...claims.entitlements].sort(),\n359-      updatesWindows: claims.updatesWindows ?? {},\n360-      entitledSince: claims.entitledSince ?? {},\n361-    };\n362-  } catch {\n363-    return { entitlements: [], updatesWindows: {}, entitledSince: {} };\n364-  }\n--\n369- * Decision 4): sorted-key JSON, so key insertion order never fakes a change. Used for both the\n370- * `updatesWindows` and `entitledSince` maps.\n371- */\n372-function canonicalMap(map: Record<string, string>): string {\n373-  return JSON.stringify(\n374-    Object.entries(map).sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0)),\n375-  );\n376-}\n377-\n378-interface IssueOrReuseInput {\n379:  accountId: string;\n380-  tier: LicenseTier;\n381-  major: number;\n382-  expiry: string | null;\n383-  /** True → skip the re-serve equality check and ALWAYS mint fresh (key rotation). The stored\n384-   *  grant is still replaced in place — one row per (account, major) holds either way. */\n385-  forceRemint?: boolean;\n386-}\n387-\n388-/**\n389: * The discriminated outcome of {@link issueOrReuseLicense} — the SAME two failure modes the\n390: * POST /issue route has always mapped to a 422/500 JSON body (see the route below), returned as\n391: * data instead of a `Response` so the ADR-0292 webhook-push mint (`mintLicensePostCommit`) can map\n392- * a failure onto its own log-and-alert contract instead.\n393- */\n394-type IssueOutcome =\n395:  | { kind: \"ok\"; token: string; licenseId: string }\n396-  | { kind: \"unresolved\" }\n397-  | { kind: \"sign_failed\" };\n398-\n399-/**\n400: * The shared POST /issue core — ADR-0110's \"persist & reuse\" idempotent mint, extracted 2026-07-07\n401: * (ADR-0292) so the webhook-push first-mint reuses this EXACT signing + persistence path rather\n402: * than a second implementation. See the POST /issue route below for the full behavior contract\n403- * (idempotent re-serve, the ADR-0251 Decision 3 window-changed re-mint, the race-loser re-read).\n404- */\n405:async function issueOrReuseLicense(\n406-  deps: Pick<IssueAppDeps, \"db\" | \"signer\" | \"index\">,\n407-  input: IssueOrReuseInput,\n408-): Promise<IssueOutcome> {\n409:  const { accountId, tier, major, expiry } = input;\n410-  const { existing, updatesWindows, entitledSince, purchased } =\n411:    await withTenant(deps.db, accountId, async (tx) => ({\n412:      existing: await readLicenseGrant(tx, accountId, major),\n413:      updatesWindows: await computeUpdatesWindows(tx, accountId),\n414:      entitledSince: await computeEntitledSince(tx, accountId),\n415:      purchased: await readEntitlements(tx, accountId),\n416-    }));\n417-  // The SIGNED entitlements are the account's PURCHASED ids, sorted — the claims contract every\n418-  // consumer expands against the index at verification. Signing the EXPANSION instead orphans the\n419-  // purchased-id-keyed `updatesWindows`/`entitledSince` maps (audit F2, 2026-07-06).\n420-  const entitlements = [...purchased].sort();\n421-  if (existing !== null &