{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/test-fixtures/checkout-account.test.ts'","aggregated_output":"     1\t// Run only through lib/checkout-account.test.ts; these doubles must not escape this process.\n     2\timport { beforeEach, expect, mock, test } from \"bun:test\";\n     3\timport * as realAuth from \"@caisson/auth\";\n     4\timport * as realServer from \"../lib/auth-server.ts\";\n     5\timport * as realDb from \"../lib/db.ts\";\n     6\timport * as realOwned from \"../lib/owned-cart-items.ts\";\n     7\timport * as realPaddle from \"../lib/paddle-cart-transaction.ts\";\n     8\timport { MODULE_CATALOG } from \"../lib/catalog.ts\";\n     9\t\n    10\tlet requestedAccount: string | undefined;\n    11\tlet failure = false;\n    12\tlet sessionFailure = false;\n    13\tlet signedIn = true;\n    14\tlet memberships: realAuth.AccountMembership[];\n    15\tlet ownedCalls: string[];\n    16\tlet transactionCalls: string[];\n    17\tmock.module(\"next/headers\", () => ({\n    18\t  headers: async () => new Headers(),\n    19\t  cookies: async () => ({\n    20\t    get: (name: string) =>\n    21\t      name === \"cs_active_account\" && requestedAccount !== undefined\n    22\t        ? { name, value: requestedAccount }\n    23\t        : undefined,\n    24\t  }),\n    25\t}));\n    26\tmock.module(\"../lib/auth-server.ts\", () => ({\n    27\t  ...realServer,\n    28\t  getAuth: async () => ({\n    29\t    api: {\n    30\t      getSession: async () => {\n    31\t        if (sessionFailure) throw new Error(\"session unavailable\");\n    32\t        return signedIn ? { user: { id: \"buyer\" } } : null;\n    33\t      },\n    34\t    },\n    35\t  }),\n    36\t}));\n    37\tmock.module(\"../lib/db.ts\", () => ({ ...realDb, getDb: async () => ({}) }));\n    38\tmock.module(\"@caisson/auth\", () => ({\n    39\t  ...realAuth,\n    40\t  resolveUserAccounts: async () => {\n    41\t    if (failure) throw new Error(\"membership resolution failed\");\n    42\t    return memberships;\n    43\t  },\n    44\t  ensurePersonalAccount: async () => undefined,\n    45\t}));\n    46\tmock.module(\"../lib/owned-cart-items.ts\", () => ({\n    47\t  ...realOwned,\n    48\t  getOwnedCartItemIdsForAccount: async (id: string) => {\n    49\t    ownedCalls.push(id);\n    50\t    return new Set<string>();\n    51\t  },\n    52\t}));\n    53\tmock.module(\"../lib/paddle-cart-transaction.ts\", () => ({\n    54\t  ...realPaddle,\n    55\t  createPaddleCartTransaction: async (input: { accountId: string }) => {\n    56\t    transactionCalls.push(input.accountId);\n    57\t    return `txn_${\"a\".repeat(26)}`;\n    58\t  },\n    59\t}));\n    60\t\n    61\t// Import the actual route and both actual session resolvers after boundary doubles are installed.\n    62\tconst { POST } = await import(\"../app/api/cart/checkout/route.ts\");\n    63\tconst { getSession } = await import(\"../lib/auth.ts\");\n    64\tconst request = () =>\n    65\t  new Request(\"https://caisson.sh/api/cart/checkout\", {\n    66\t    method: \"POST\",\n    67\t    headers: {\n    68\t      origin: \"https://caisson.sh\",\n    69\t      \"content-type\": \"application/json\",\n    70\t    },\n    71\t    body: JSON.stringify({ itemIds: [MODULE_CATALOG[0]!.id] }),\n    72\t  });\n    73\tbeforeEach(() => {\n    74\t  requestedAccount = \"org\";\n    75\t  failure = false;\n    76\t  sessionFailure = false;\n    77\t  signedIn = true;\n    78\t  memberships = [\n    79\t    { accountId: \"buyer\", userId: \"buyer\", role: \"owner\" },\n    80\t    { accountId: \"org\", userId: \"buyer\", role: \"seat\" },\n    81\t  ];\n    82\t  ownedCalls = [];\n    83\t  transactionCalls = [];\n    84\t});\n    85\ttest(\"selected organization membership failure reaches neither entitlements nor Paddle\", async () => {\n    86\t  failure = true;\n    87\t  const result = await POST(request());\n    88\t  expect(result.status).toBe(503);\n    89\t  expect(await result.json()).toEqual({ error: \"checkout unavailable\" });\n    90\t  expect(ownedCalls).toEqual([]);\n    91\t  expect(transactionCalls).toEqual([]);\n    92\t});\n    93\ttest(\"dashboard preserves its personal-account availability fallback\", async () => {\n    94\t  failure = true;\n    95\t  expect(await getSession()).toEqual({\n    96\t    userId: \"buyer\",\n    97\t    accountId: \"buyer\",\n    98\t    role: \"owner\",\n    99\t  });\n   100\t});\n   101\ttest(\"verified organization is used for both entitlement and transaction scopes\", async () => {\n   102\t  expect((await POST(request())).status).toBe(200);\n   103\t  expect(ownedCalls).toEqual([\"org\"]);\n   104\t  expect(transactionCalls).toEqual([\"org\"]);\n   105\t});\n   106\ttest(\"an explicit unverified account never silently falls back for commerce\", async () => {\n   107\t  requestedAccount = \"stale-or-forged\";\n   108\t  expect((await POST(request())).status).toBe(503);\n   109\t  expect(ownedCalls).toEqual([]);\n   110\t  expect(transactionCalls).toEqual([]);\n   111\t});\n   112\ttest(\"session-provider errors are inside the checkout failure boundary\", async () => {\n   113\t  sessionFailure = true;\n   114\t  expect((await POST(request())).status).toBe(503);\n   115\t  expect(ownedCalls).toEqual([]);\n   116\t  expect(transactionCalls).toEqual([]);\n   117\t});\n   118\ttest(\"no verified session stays unauthorized\", async () => {\n   119\t  signedIn = false;\n   120\t  expect((await POST(request())).status).toBe(401);\n   121\t  expect(ownedCalls).toEqual([]);\n   122\t  expect(transactionCalls).toEqual([]);\n   123\t});\n   124\ttest(\"verified personal membership works without an account preference\", async () => {\n   125\t  requestedAccount = undefined;\n   126\t  expect((await POST(request())).status).toBe(200);\n   127\t  expect(ownedCalls).toEqual([\"buyer\"]);\n   128\t  expect(transactionCalls).toEqual([\"buyer\"]);\n   129\t});\n   130\ttest(\"empty membership after bootstrap cannot create a checkout\", async () => {\n   131\t  memberships = [];\n   132\t  requestedAccount = undefined;\n   133\t  expect((await POST(request())).status).toBe(503);\n   134\t  expect(ownedCalls).toEqual([]);\n   135\t  expect(transactionCalls).toEqual([]);\n   136\t});\n","exit_code":0,"status":"completed"}}
