the preflight — the evidence runs, whatever fails around it.\n.github/workflows/publish-image.yml:473:      # Under the default `success()` a failed attest, scan, or SBOM skipped them and\n.github/workflows/publish-image.yml-474-      # the run ended with a live digest and no manifest, no SBOM, no SARIF — a CVE the\n.github/workflows/publish-image.yml-475-      # run could not name, and a digest that had to be re-scanned by hand. Keyed to the\n.github/workflows/publish-image.yml-476-      # DIGEST, not to any one predecessor: keying it to the scan is right for a repo\n.github/workflows/publish-image.yml:477:      # whose scan fails and wrong for one whose attest fails, and keying it to the\n.github/workflows/publish-image.yml-478-      # build was wrong for the run whose build correctly SKIPPED. `collect` is still\n.github/workflows/publish-image.yml-479-      # gated on the whole job succeeding, so nothing downstream consumes a digest from\n.github/workflows/publish-image.yml:480:      # a failed publish; this only keeps the evidence of what was pushed.\n.github/workflows/publish-image.yml-481-      - name: source-to-image manifest\n.github/workflows/publish-image.yml-482-        if: always() && steps.image.outputs.digest != ''\n.github/workflows/publish-image.yml-483-        env:\n.github/workflows/publish-image.yml-484-          SERVICE: ${{ matrix.service }}\n.github/workflows/publish-image.yml-485-          REPOSITORY: ${{ github.repository }}\n.github/workflows/publish-image.yml:486:          COMMIT: ${{ github.sha }}\n.github/workflows/publish-image.yml-487-          REF: ${{ github.ref }}\n.github/workflows/publish-image.yml-488-          RUN_ID: ${{ github.run_id }}\n.github/workflows/publish-image.yml-489-          IMAGE: ${{ vars.GCP_REGISTRY }}/${{ matrix.service }}\n.github/workflows/publish-image.yml-490-          DIGEST: ${{ steps.image.outputs.digest }}\n.github/workflows/publish-image.yml-491-          DOCKERFILE: ${{ steps.svc.outputs.dockerfile }}\n.github/workflows/publish-image.yml-492-          BUILD_CONTEXT: ${{ steps.svc.outputs.build_context }}\n.github/workflows/publish-image.yml-493-        run: |\n.github/workflows/publish-image.yml-494-          set -euo pipefail\n.github/workflows/publish-image.yml-495-          jq -n \\\n.github/workflows/publish-image.yml-496-            --arg service \"$SERVICE\" \\\n.github/workflows/publish-image.yml-497-            --arg repository \"$REPOSITORY\" \\\n.github/workflows/publish-image.yml-498-            --arg commit \"$COMMIT\" \\\n.github/workflows/publish-image.yml-499-            --arg ref \"$REF\" \\\n.github/workflows/publish-image.yml-500-            --arg run_id \"$RUN_ID\" \\\n.github/workflows/publish-image.yml-501-            --arg image \"$IMAGE\" \\\n.github/workflows/publish-image.yml-502-            --arg digest \"$DIGEST\" \\\n.github/workflows/publish-image.yml-503-            --arg dockerfile \"$DOCKERFILE\" \\\n.github/workflows/publish-image.yml-504-            --arg build_context \"$BUILD_CONTEXT\" \\\n.github/workflows/publish-image.yml:505:            '{service: $service, repository: $repository, commit: $commit, ref: $ref, run_id: $run_id, image: $image, digest: $digest, dockerfile: $dockerfile, build_context: $build_context}' \\\n.github/workflows/publish-image.yml-506-            > \"image-manifest-$SERVICE.json\"\n.github/workflows/publish-image.yml-507-\n.github/workflows/publish-image.yml-508-      # Same guard as the manifest step. The manifest is the anchor: it exists whenever\n.github/workflows/publish-image.yml-509-      # a digest was resolved, so `if-no-files-found: error` still binds — an upload with\n.github/workflows/publish-image.yml-510-      # NOTHING to carry is a bug, an upload missing the SBOM because the SBOM step failed\n.github/workflows/publish-image.yml-511-      # is the evidence of that failure. A `hashFiles` guard would be wrong here: it goes\n.github/workflows/publish-image.yml-512-      # quiet on the day the manifest step itself breaks.\n.github/workflows/publish-image.yml-513-      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1\n.github/workflows/publish-image.yml-514-        if: always() && steps.image.outputs.digest != ''\n.github/workflows/publish-image.yml-515-        with:\n.github/workflows/publish-image.yml:516:          name: publish-evidence-${{ matrix.service }}\n.github/workflows/publish-image.yml-517-          path: |\n.github/workflows/publish-image.yml-518-            image-manifest-${{ matrix.service }}.json\n.github/workflows/publish-image.yml-519-            sbom-${{ matrix.service }}.spdx.json\n.github/workflows/publish-image.yml-520-            trivy-${{ matrix.service }}.sarif\n.github/workflows/publish-image.yml-521-          if-no-files-found: error\n.github/workflows/publish-image.yml-522-          overwrite: true\n.github/workflows/publish-image.yml-523-\n.github/workflows/publish-image.yml-524-      # Both values through env:. This was `echo '${{ ... }}' > \"digests/${{ ... }}\"` —\n.github/workflows/publish-image.yml-525-      # single quotes are not a sandbox, they are text the runner writes around text it\n.github/workflows/publish-image.yml-526-      # already substituted, so one quote character in either value ends the quoting and\n.github/workflows/publish-image.yml-527-      # the rest of the value is shell. `printf '%s\\n'` also beats `echo` here: echo\n.github/workflows/publish-image.yml-528-      # interprets leading dashes and backslashes on some shells, printf does not.\n.github/workflows/publish-image.yml-529-      - name: record digest\n.github/workflows/publish-image.yml-530-        env:\n.github/workflows/publish-image.yml-531-          SERVICE: ${{ matrix.service }}\n.github/workflows/publish-image.yml:532:          # The one resolved digest — same value every attestation step above signed,\n.github/workflows/publish-image.yml-533-          # SBOM'd, and scanned. Under the default `success()` this step is unreachable\n.github/workflows/publish-image.yml:534:          # when any of them failed, so a recorded digest is one whose attestation ran\n.github/workflows/publish-image.yml-535-          # and passed ON THIS RUN; the empty-digest refusal below is the belt for the\n.github/workflows/publish-image.yml-536-          # pathological build-emitted-nothing path.\n.github/workflows/publish-image.yml-537-          DIGEST: ${{ steps.image.outputs.digest }}\n.github/workflows/publish-image.yml-538-        run: |\n.github/workflows/publish-image.yml-539-          set -euo pipefail\n.github/workflows/publish-image.yml-540-          if [ -z \"$DIGEST\" ]; then\n.github/workflows/publish-image.yml-541-            echo \"::error::no digest from the build or the preflight — nothing to record\"\n.github/workflows/publish-image.yml-542-            exit 1\n.github/workflows/publish-image.yml-543-          fi\n.github/workflows/publish-image.yml-544-          mkdir -p digests\n.github/workflows/publish-image.yml-545-          printf '%s\\n' \"$DIGEST\" > \"digests/$SERVICE\"\n.github/workflows/publish-image.yml-546-\n.github/workflows/publish-image.yml-547-      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1\n.github/workflows/publish-image.yml-548-        with:\n.github/workflows/publish-image.yml-549-          name: digest-${{ matrix.service }}\n.github/workflows/publish-image.yml-550-          path: digests/${{ matrix.service }}\n.github/workflows/publish-image.yml-551-          if-no-files-found: error\n.github/workflows/publish-image.yml-552-          overwrite: true\n.github/workflows/publish-image.yml-553-\n.github/workflows/publish-image.yml-554-  collect:\n.github/workflows/publish-image.yml:555:    needs: publish\n.github/workflows/publish-image.yml:556:    if: always() && needs.publish.result == 'success'\n.github/workflows/publish-image.yml-557-    runs-on: ${{ vars.CI_RUNNER_LINUX || 'ubuntu-latest' }}\n.github/workflows/publish-image.yml-558-    outputs:\n.github/workflows/publish-image.yml-559-      digests: ${{ steps.collect.outputs.digests }}\n.github/workflows/publish-image.yml-560-    steps:\n.github/workflows/publish-image.yml-561-      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1\n.github/workflows/publish-image.yml-562-        with:\n.github/workflows/publish-image.yml-563-          pattern: digest-*\n.github/workflows/publish-image.yml-564-          path: digests\n.github/workflows/publish-image.yml-565-          merge-multiple: false\n.github/workflows/publish-image.yml-566-      # `jq -c` is load-bearing, not a nicety. Without it jq pretty-prints, so the\n.github/workflows/publish-image.yml-567-      # accumulator was MULTILINE from the first service onward and then written with\n.github/workflows/publish-image.yml-568-      # `printf 'digests=%s\\n'` into $GITHUB_OUTPUT — a single-line key=value format.\n.github/workflows/publish-image.yml-569-      # This was broken, not merely risky: the `digests` workflow_call output was corrupt\n.github/workflows/publish-image.yml:570:      # for every non-empty publish, and it is the exact input deploy-staging and\n.github/workflows/publish-image.yml-571-      # deploy-production consume. -c keeps the object on one line so the write is valid.\n.github/workflows/publish-image.yml-572-      - id: collect\n.github/workflows/publish-image.yml-573-        run: |\n.github/workflows/publish-image.yml-574-          set -euo pipefail\n.github/workflows/publish-image.yml-575-          # nullglob so an empty download expands to nothing rather than to the literal\n.github/workflows/publish-image.yml-576-          # pattern. Without it the loop runs once on `digests/digest-*/*`, `cat` fails\n.github/workflows/publish-image.yml-577-          # inside a --arg command substitution whose outer jq still exits 0, and the\n.github/workflows/publish-image.yml:578:          # output becomes `digests={\"*\":\"\"}`