{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/lib/checkout-account.test.ts'","aggregated_output":"     1\timport { expect, test } from \"bun:test\";\n     2\timport { spawnSync } from \"node:child_process\";\n     3\timport { fileURLToPath } from \"node:url\";\n     4\t\n     5\t// Keep module doubles in an isolated runner: Bun module mocks otherwise affect sibling suites.\n     6\ttest(\"production checkout account failure and dashboard compatibility\", () => {\n     7\t  const result = spawnSync(\n     8\t    process.execPath,\n     9\t    [\"test\", \"--timeout\", \"60000\", \"./test-fixtures/checkout-account.test.ts\"],\n    10\t    {\n    11\t      cwd: fileURLToPath(new URL(\"..\", import.meta.url)),\n    12\t      encoding: \"utf8\",\n    13\t      timeout: 60000,\n    14\t    },\n    15\t  );\n    16\t  if (result.status !== 0)\n    17\t    throw new Error(`${result.stdout}\\n${result.stderr}`);\n    18\t  expect(result.status).toBe(0);\n    19\t  expect(result.stderr).toContain(\"8 pass\");\n    20\t  expect(result.stderr).toContain(\"0 fail\");\n    21\t}, 65000);\n","exit_code":0,"status":"completed"}}
