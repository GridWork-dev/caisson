{"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/tenancy-rls/src/node-pg.ts'","aggregated_output":"     1\t// The caller-pool-owned node-postgres Transactor (consolidation C05): one canonical\n     2\t// BEGIN / COMMIT / best-effort-ROLLBACK / release adapter over the shared TenantExecutor port,\n     3\t// previously copy-pasted across site, admin, the license deploy entry, the CLI, and the\n     4\t// generated starter. Pool CONSTRUCTION and lifecycle stay with each caller on purpose — lazy\n     5\t// init, HMR caching, error listeners, shutdown, and `pool.end()` are caller policy, not\n     6\t// transaction policy.\n     7\timport type { Pool, PoolClient } from \"pg\";\n     8\timport type { TenantExecutor, Transactor } from \"./rls.ts\";\n     9\t\n    10\tfunction nodePgExecutor(client: PoolClient): TenantExecutor {\n    11\t  return {\n    12\t    // `pg`'s `query<T>` constrains `T extends QueryResultRow`; `TenantExecutor.query`'s `T` has\n    13\t    // no such bound (PGlite, the other driver behind this same port, carries no bound either) —\n    14\t    // call untyped and cast the rows rather than narrow the shared port to a `pg`-specific\n    15\t    // generic every other driver would then have to satisfy too.\n    16\t    async query<T = Record<string, unknown>>(sql: string, params?: unknown[]) {\n    17\t      const res = await client.query(sql, params);\n    18\t      return { rows: res.rows as T[] };\n    19\t    },\n    20\t    async exec(sql: string) {\n    21\t      // Return the driver result (typed `Promise<unknown>` on the port): five of the seven folded\n    22\t      // copies did, and PGlite — the test-double driver behind the same port — does too. Resolving\n    23\t      // `undefined` only in production would be an invisible divergence behind `unknown`.\n    24\t      return client.query(sql);\n    25\t    },\n    26\t  };\n    27\t}\n    28\t\n    29\t/**\n    30\t * Wrap a caller-owned `pg.Pool` as a `Transactor`: each `transaction(fn)` checks out one client,\n    31\t * runs BEGIN → `fn` → COMMIT, rolls back best-effort on any throw (the original error always\n    32\t * wins — the connection may already be unusable), and releases the client in every path.\n    33\t */\n    34\texport function createPgTransactor(pool: Pool): Transactor {\n    35\t  return {\n    36\t    async transaction<T>(fn: (tx: TenantExecutor) => Promise<T>): Promise<T> {\n    37\t      const client = await pool.connect();\n    38\t      try {\n    39\t        await client.query(\"BEGIN\");\n    40\t        const result = await fn(nodePgExecutor(client));\n    41\t        await client.query(\"COMMIT\");\n    42\t        return result;\n    43\t      } catch (err) {\n    44\t        try {\n    45\t          await client.query(\"ROLLBACK\");\n    46\t        } catch {\n    47\t          // Best-effort — the connection may already be unusable; the original error wins below.\n    48\t        }\n    49\t        throw err;\n    50\t      } finally {\n    51\t        client.release();\n    52\t      }\n    53\t    },\n    54\t  };\n    55\t}\n","exit_code":0,"status":"completed"}}
