  156\t      accessProtected: true,\n   157\t    },\n   158\t    {\n   159\t      key: \"caisson-docs\",\n   160\t      origin: \"https://caisson-docs.gwstg.dev\",\n   161\t      healthPath: \"/health\",\n   162\t      canaryHealthPath: \"/health\",\n   163\t      originProtected: true,\n   164\t      accessProtected: true,\n   165\t    },\n   166\t    {\n   167\t      key: \"caisson-demos\",\n   168\t      origin: \"https://caisson.gwstg.dev\",\n   169\t      healthPath: \"/demos/healthz\",\n   170\t      canaryHealthPath: \"/demos/healthz\",\n   171\t      originProtected: false,\n   172\t      accessProtected: true,\n   173\t    },\n   174\t  ],\n   175\t};\n   176\t\n   177\tfunction selectedTargets(\n   178\t  environment: Environment,\n   179\t  service: ServiceKey | undefined,\n   180\t): Target[] {\n   181\t  const targets = TARGETS[environment];\n   182\t  if (!service) return targets;\n   183\t  const selected = targets.find((target) => target.key === service);\n   184\t  if (!selected) throw new Error(`unknown service ${service}`);\n   185\t  return [selected];\n   186\t}\n   187\t\n   188\tfunction isCanaryMode(mode: string): boolean {\n   189\t  return mode === \"pre-migration\" || mode === \"post-migration\";\n   190\t}\n   191\t\n   192\tfunction normalizeCanaryUrls(\n   193\t  values: Record<string, string>,\n   194\t): Record<string, string> {\n   195\t  const entries = Object.entries(values);\n   196\t  if (\n   197\t    entries.length === 0 ||\n   198\t    entries.length > ServiceKeySchema.options.length\n   199\t  ) {\n   200\t    throw new Error(\"CANARY_URLS is invalid\");\n   201\t  }\n   202\t\n   203\t  const origins = new Set<string>();\n   204\t  const normalized: Array<[string, string]> = [];\n   205\t  for (const [service, value] of entries) {\n   206\t    if (!ServiceKeySchema.safeParse(service).success) {\n   207\t      throw new Error(\"CANARY_URLS is invalid\");\n   208\t    }\n   209\t    let url: URL;\n   210\t    try {\n   211\t      url = new URL(value);\n   212\t    } catch {\n   213\t      throw new Error(\"CANARY_URLS is invalid\");\n   214\t    }\n   215\t    if (\n   216\t      url.protocol !== \"https:\" ||\n   217\t      url.username !== \"\" ||\n   218\t      url.password !== \"\" ||\n   219\t      url.port !== \"\" ||\n   220\t      url.pathname !== \"/\" ||\n   221\t      url.search !== \"\" ||\n   222\t      url.hash !== \"\" ||\n   223\t      !url.hostname.endsWith(\".run.app\") ||\n   224\t      url.hostname === \"run.app\" ||\n   225\t      origins.has(url.origin)\n   226\t    ) {\n   227\t      throw new Error(\"CANARY_URLS is invalid\");\n   228\t    }\n   229\t    origins.add(url.origin);\n   230\t    normalized.push([service, url.origin]);\n   231\t  }\n   232\t  return Object.fromEntries(normalized);\n   233\t}\n   234\t\n   235\tfunction validateOriginSecrets(\n   236\t  values: Record<string, string>,\n   237\t): Record<string, string> {\n   238\t  const entries = Object.entries(values);\n   239\t  if (entries.length > ServiceKeySchema.options.length) {\n   240\t    throw new Error(\"ORIGIN_SECRETS is invalid\");\n   241\t  }\n   242\t  for (const [service, value] of entries) {\n   243\t    if (\n   244\t      !ServiceKeySchema.safeParse(service).success ||\n   245\t      !ENCODED_ORIGIN_SECRET.test(value)\n   246\t    ) {\n   247\t      throw new Error(\"ORIGIN_SECRETS is invalid\");\n   248\t    }\n   249\t  }\n   250\t  return Object.fromEntries(entries);\n   251\t}\n   252\t\n   253\tfunction validateConfig(\n   254\t  config: SmokeConfig,\n   255\t): z.infer<typeof SmokeConfigSchema> {\n   256\t  const result = SmokeConfigSchema.safeParse(config);\n   257\t  if (!result.success) {\n   258\t    if (\n   259\t      config.environment !== \"staging\" &&\n   260\t      config.environment !== \"production\"\n   261\t    ) {\n   262\t      throw new Error(\"ENVIRONMENT must be staging or production\");\n   263\t    }\n   264\t    if (\n   265\t      config.mode !== \"staging\" &&\n   266\t      config.mode !== \"pre-migration\" &&\n   267\t      config.mode !== \"post-migration\" &&\n   268\t      config.mode !== \"post-deploy\" &&\n   269\t      config.mode !== \"rollback\"\n   270\t    ) {\n   271\t      throw new Error(\"MODE is invalid\");\n   272\t    }\n   273\t    if (config.canaryTag !== undefined && !CANARY_TAG.test(config.canaryTag)) {\n   274\t      throw new Error(\"CANARY_TAG is invalid\");\n   275\t    }\n   276\t    throw new Error(\"smoke configuration is invalid\");\n   277\t  }\n   278\t\n   279\t  const parsed = result.data;\n   280\t  const canaryMode = isCanaryMode(parsed.mode);\n   281\t  if (parsed.mode === \"staging\" && parsed.environment !== \"staging\") {\n   282\t    throw new Error(\"staging smoke requires staging\");\n   283\t  }\n   284\t  if (canaryMode && !parsed.canaryTag)\n   285\t    throw new Error(\"CANARY_TAG is required\");\n   286\t  if (canaryMode && parsed.environment !== \"production\") {\n   287\t    throw new Error(\"canary smoke requires production\");\n   288\t  }\n   289\t  if (canaryMode && !parsed.canaryUrls) {\n   290\t    throw new Error(\"CANARY_URLS is required for canary smoke\");\n   291\t  }\n   292\t  if (canaryMode && !parsed.originSecrets) {\n   293\t    throw new Error(\"ORIGIN_SECRETS is required for canary smoke\");\n   294\t  }\n   295\t  if (!canaryMode && (parsed.canaryUrls || parsed.originSecrets)) {\n   296\t    throw new Error(`canary inputs are forbidden for ${parsed.mode} smoke`);\n   297\t  }\n   298\t  if (parsed.mode === \"rollback\" && !parsed.service) {\n   299\t    throw new Error(\"SERVICE is required for rollback smoke\");\n   300\t  }\n   301\t\n   302\t  if (canaryMode && parsed.stagingOriginUrls)\n   303\t    throw new Error(\"STAGING_ORIGIN_URLS is only valid for staging smoke\");\n   304\t  if (canaryMode) {\n   305\t    const canaryUrls = normalizeCanaryUrls(parsed.canaryUrls!);\n   306\t    const originSecrets = validateOriginSecrets(parsed.originSecrets!);\n   307\t    const targets = TARGETS.production.filter((target) =>\n   308\t      Object.hasOwn(canaryUrls, target.key),\n   309\t    );\n   310\t    for (const target of targets) {\n   311\t      if (target.originProtected && !Object.hasOwn(originSecrets, target.key)) {\n   312\t        throw new Error(`ORIGIN_SECRETS is missing ${target.key}`);\n   313\t      }\n   314\t    }\n   315\t    return { ...parsed, canaryUrls, originSecrets };\n   316\t  }\n   317\t\n   318\t  if (parsed.mode === \"staging\") {\n   319\t    if (!parsed.stagingOriginUrls)\n   320\t      throw new Error(\"STAGING_ORIGIN_URLS is required for staging smoke\");\n   321\t    parsed.stagingOriginUrls = validateStagingOrigins(parsed.stagingOriginUrls);\n   322\t  } else if (parsed.stagingOriginUrls) {\n   323\t    throw new Error(\"STAGING_ORIGIN_URLS is only valid for staging smoke\");\n   324\t  }\n   325\t\n   326\t  const targets = selectedTargets(parsed.environment, parsed.service);\n   327\t  if (\n   328\t    targets.some((target) => target.accessProtected) &&\n   329\t    (!parsed.accessClientId || !parsed.accessClientSecret)\n   330\t  ) {\n   331\t    throw new Error(\"Cloudflare Access service credentials are required\");\n   332\t  }\n   333\t  return parsed;\n   334\t}\n   335\t\n   336\tfunction canaryServiceAudience(\n   337\t  config: ReturnType<typeof validateConfig>,\n   338\t  target: Target,\n   339\t): string {\n   340\t  const url = new URL(config.canaryUrls![target.key]!);\n   341\t  const prefix = `${config.canaryTag!}---`;\n   342\t  if (!url.hostname.startsWith(prefix)) {\n   343\t    throw new Error(`CANARY_URLS tag does not match ${target.key}`);\n   344\t  }\n   345\t  url.hostname = url.hostname.slice(prefix.length);\n   346\t  return url.origin;\n   347\t}\n   348\t\n   349\tasync function gcloudIdentityToken(audience: string): Promise<string> {\n   350\t  const result = Bun.spawnSync([\n   351\t    \"gcloud\",\n   352\t    \"auth\",\n   353\t    \"print-identity-token\",\n   354\t    `--audiences=${audience}`,\n   355\t  ]);\n   356\t  if (result.exitCode !== 0) {\n   357\t    throw new Error(\"gcloud failed to mint the demos canary identity token\");\n   358\t  }\n   359\t  const token = new TextDecoder().decode(result.stdout).trim();\n   360\t  if (token.length > 8_192 || !ID_TOKEN.test(token)) {\n   361\t    throw new Error(\"gcloud returned an invalid demos canary identity token\");\n   362\t  }\n   363\t  return token;\n   364\t}\n   365\t\n   366\tasync function requestHeaders(\n   367\t  config: ReturnType<typeof validateConfig>,\n   368\t  target: Target,\n   369\t  identityTokenProvider: IdentityTokenProvider,\n   370\t): Promise<Headers> {\n   371\t  const headers = new Headers({ accept: \"application/json\" });\n   372\t  if (isCanaryMode(config.mode)) {\n   373\t    if (target.originProtected) {\n   374\t      headers.set(ORIGIN_SECRET_HEADER, config.originSecrets![target.key]!);\n   375\t    }\n   376\t    if (target.key === \"caisson-demos\") {\n   377\t      const token = await identityTokenProvider(\n   378\t        canaryServiceAudience(config, target),\n   379\t      );\n   380\t      if (token.length > 8_192 || !HEADER_VALUE.test(token)) {\n   381\t        throw new Error(\"demos canary identity token is invalid\");\n   382\t      }\n   383\t      headers.set(\"X-Serverless-Authorization\", `Bearer ${token}`);\n   384\t    }\n   385\t  } else if (target.accessProtected) {\n   386\t    headers.set(\"CF-Access-Client-Id\", config.accessClientId!);\n   387\t    headers.set(\"CF-Access-Client-Secret\", config.accessClientSecret!);\n   388\t  }\n   389\t  return headers;\n   390\t}\n   391\t\n   392\tfunction requestOrigin(\n   393\t  config: ReturnType<typeof validateConfig>,\n   394\t  target: Target,\n   395\t): string {\n   396\t  return isCanaryMode(config.mode)\n   397\t    ? config.canaryUrls![target.key]!\n   398\t    : target.origin;\n   399\t}\n   400\t\n   401\tfunction assertSecurityHeaders(response: Response, label: string): void {\n   402\t  for (const header of REQUIRED_HEADERS) {\n   403\t    if (!response.headers.has(header)) {\n   404\t      throw new Error(`${label} is missing ${header}`);\n   405\t    }\n   406\t  }\n   407\t  if (response.headers.has(\"x-powered-by\")) {\n   408\t    throw new Error(`${label} exposes x-powered-by`);\n   409\t  }\n   410\t}\n   411\t\n   412\tasync function getTarget(\n   413\t  config: ReturnType<typeof validateConfig>,\n   414\t  target: Target,\n   415\t  path: string,\n   416\t  label: string,\n   417\t  transport: TimedFetcher,\n   418\t  identityTokenProvider: IdentityTokenProvider,\n   419\t): Promise<void> {\n   420\t  const response = await transport(\n   421\t    `${requestOrigin(config, target)}${path}`,\n   422\t    {\n   423\t      method: \"GET\",\n   424\t      redirect: \"manual\",\n   425\t      headers: await requestHeaders(config, target, identityTokenProvider),\n   426\t    },\n   427\t    { timeoutMs: REQUEST_TIMEOUT_MS },\n   428\t  );\n   429\t  if (response.status !== 200) {\n   430\t    throw new Error(`${label} returned ${response.status}`);\n   431\t  }\n   432\t  assertSecurityHeaders(response, label);\n   433\t}\n   434\t\n   435\tasync function assertWriteBoundary(\n   436\t  config: ReturnType<typeof validateConfig>,\n   437\t  target: Target,\n   438\t  path: string,\n   439\t  body: object,\n   440\t  transport: TimedFetcher,\n   441\t  identityTokenProvider: IdentityTokenProvider,\n   442\t): Promise<void> {\n   443\t  const headers = await requestHeaders(config, target, identityTokenProvider);\n   444\t  headers.set(\"content-type\", \"application/json\");\n   445\t  const response = await transport(\n   446\t    `${requestOrigin(config, target)}${path}`,\n   447\t    {\n   448\t      method: \"POST\",\n   449\t      redirect: \"manual\",\n   450\t      headers,\n   451\t      body: JSON.stringify(body),\n   452\t    },\n   453\t    { timeoutMs: REQUEST_TIMEOUT_MS },\n   454\t  );\n   455\t  if (response.status !== 401) {\n   456\t    throw new Error(\n   457\t      `${target.key} write auth boundary returned ${response.status}`,\n   458\t    );\n   459\t  }\n   460\t  assertSecurityHeaders(response, `${target.key} write auth boundary`);\n   461\t}\n   462\t\n   463\t/** Negative legs use fresh headers: neither Access tokens, IAM tokens nor origin secrets. */\n   464\tasync function assertStagingDenials(\n   465\t  config: ReturnType<typeof validateConfig>,\n   466\t  target: Target,\n   467\t  transport: TimedFetcher,\n   468\t): Promise<void> {\n   469\t  const publicDenied = await transport(\n   470\t    `${target.origin}${target.healthPath}`,\n   471\t    {\n   472\t      method: \"GET\",\n   473\t      redirect: \"manual\",\n   474\t      headers: { accept: \"text/html, application/json\" },\n   475\t    },\n   476\t    { timeoutMs: REQUEST_TIMEOUT_MS },\n   477\t  );\n   478\t  let accessDenied = false;\n   479\t  if ([302, 303, 307].includes(publicDenied.status)) {\n   480\t    try {\n   481\t      const login = new URL(publicDenied.headers.get(\"location\") ?? \"\");\n   482\t      accessDenied =\n   483\t        login.protocol === \"https:\" &&\n   484\t        login.username === \"\" &&\n   485\t        login.password === \"\" &&\n   486\t        login.port === \"\" &&\n   487\t        /^[a-z0-9-]+\\.cloudflareaccess\\.com$/.test(login.hostname) &&\n   488\t        login.pathname.startsWith(\"/cdn-cgi/access/login\");\n   489\t    } catch {\n   490\t      /* Relative, malformed or unrelated redirects do not prove Access denial. */\n   491\t    }\n   492\t  } else if (publicDenied.status === 403) {\n   493\t    accessDenied =\n   494\t      publicDenied.headers.get(\"server\") === \"cloudflare\" &&\n   495\t      publicDenied.headers.has(\"cf-ray\");\n   496\t  }\n   497\t  if (!accessDenied)\n   498\t    throw new Error(\n   499\t      `${target.key} Access denial boundary returned ${publicDenied.status}`,\n   500\t    );\n   501\t\n   502\t  const rawDenied = await transport(\n   503\t    `${config.stagingOriginUrls![target.key]!}${target.canaryHealthPath}`,\n   504\t    {\n   505\t      method: \"GET\",\n   506\t      redirect: \"manual\",\n   507\t      headers: { accept: \"application/json\" },\n   508\t    },\n   509\t    { timeoutMs: REQUEST_TIMEOUT_MS },\n   510\t  );\n   511\t  if (rawDenied.status !== 401 && rawDenied.status !== 403) {\n   512\t    throw new Error(\n   513\t      `${target.key} raw origin/IAM denial boundary returned ${rawDenied.status}`,\n   514\t    );\n   515\t  }\n   516\t}\n   517\t\n   518\texport async function runSmoke(\n   519\t  rawConfig: SmokeConfig,\n   520\t  transport: TimedFetcher = fetchWithTimeout,\n   521\t  identityTokenProvider: IdentityTokenProvider = gcloudIdentityToken,\n   522\t): Promise<void> {\n   523\t  const config = validateConfig(rawConfig);\n   524\t  const canaryMode = isCanaryMode(config.mode);\n   525\t  const targets = canaryMode\n   526\t    ? TARGETS.production.filter((target) =>\n   527\t        Object.hasOwn(config.canaryUrls!, target.key),\n   528\t      )\n   529\t    : selectedTargets(config.environment, config.service);\n   530\t\n   531\t  // The workflow resolves tag URLs with gcloud; this code never synthesizes one.\n   532\t  // Pre/post-migration calls the zero-traffic revision directly with its origin\n   533\t  // credential. The IAM-only demos service additionally receives a Google ID token whose\n   534\t  // audience is the untagged service URL. Post-deploy and rollback remain public Cloudflare checks.\n   535\t  for (const target of targets) {\n   536\t    await getTarget(\n   537\t      config,\n   538\t      target,\n   539\t      canaryMode ? target.canaryHealthPath : target.healthPath,\n   540\t      `${target.key} health`,\n   541\t      transport,\n   542\t      identityTokenProvider,\n   543\t    );\n   544\t    if (target.key === \"caisson-site\") {\n   545\t      await getTarget(\n   546\t        config,\n   547\t        target,\n   548\t        \"/\",\n   549\t        \"caisson-site page\",\n   550\t        transport,\n   551\t        identityTokenProvider,\n   552\t      );\n   553\t    }\n   554\t    if (config.mode === \"staging\")\n   555\t      await assertStagingDenials(config, target, transport);\n   556\t  }\n   557\t\n   558\t  if (config.mode === \"pre-migration\") return;\n   559\t\n   560\t  const license = targets.find((target) => target.key === \"caisson-license\");\n   561\t  if (license) {\n   562\t    await assertWriteBoundary(\n   563\t      config,\n   564\t      license,\n   565\t      \"/issue\",\n   566\t      {},\n   567\t      transport,\n   568\t      identityTokenProvider,\n   569\t    );\n   570\t  }\n   571\t  const docs = targets.find((target) => target.key === \"caisson-docs\");\n   572\t  if (docs) {\n   573\t    await assertWriteBoundary(\n   574\t      config,\n   575\t      docs,\n   576\t      \"/query\",\n   577\t      { query: \"deployment smoke\", k: 1 },\n   578\t      transport,\n   579\t      identityTokenProvider,\n   580\t    );\n   581\t  }\n   582\t}\n   583\t\n   584\tfunction serviceMapFromEnvironment(\n   585\t  name: \"CANARY_URLS\" | \"ORIGIN_SECRETS\" | \"STAGING_ORIGIN_URLS\",\n   586\t  value: string | undefined,\n   587\t): Record<string, string> | undefined {\n   588\t  const source = value?.trim();\n   589\t  if (!source) return undefined;\n   590\t  if (source.length > 32_768) throw new Error(`${name} is too large`);\n   591\t\n   592\t  let parsed: unknown;\n   593\t  try {\n   594\t    parsed = JSON.parse(source) as unknown;\n   595\t  } catch {\n   596\t    throw new Error(`${name} must be valid JSON`);\n   597\t  }\n   598\t  if (typeof parsed !== \"object\" || parsed === null || Array.isArray(parsed)) {\n   599\t    throw new Error(`${name} must be a JSON object`);\n   600\t  }\n   601\t  const result = ServiceMapSchema.safeParse(parsed);\n   602\t  if (!result.success) throw new Error(`${name}