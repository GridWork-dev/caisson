{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba deploy/staging-origins.ts'","aggregated_output":"     1\t// R359 CR-04: resolve rather than synthesize raw staging URLs; no credential-bearing probe here.\n     2\timport { z } from \"zod\";\n     3\timport {\n     4\t  createToolExec,\n     5\t  type ExecFn,\n     6\t} from \"../packages/tool-exec/src/index.ts\";\n     7\timport { output, reportCliError } from \"./manifest.ts\";\n     8\t\n     9\texport const STAGING_SERVICES = [\n    10\t  \"caisson-site\",\n    11\t  \"caisson-admin\",\n    12\t  \"caisson-license\",\n    13\t  \"caisson-docs\",\n    14\t  \"caisson-demos\",\n    15\t] as const;\n    16\tconst serviceSchema = z.enum(STAGING_SERVICES);\n    17\tconst projectSchema = z.string().regex(/^[a-z][a-z0-9-]{4,28}[a-z0-9]$/);\n    18\tconst regionSchema = z.string().regex(/^[a-z]+-[a-z]+[0-9]$/);\n    19\t// Cloud Run supports both SERVICE-PROJECT.REGION.run.app and opaque hash-based hosts.\n    20\t// Validate the entire canonical URL, not a substring or a URL-parser-normalized hostname.\n    21\tconst rawOrigin =\n    22\t  /^https:\\/\\/(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.){1,3}run\\.app$/;\n    23\texport function validateStagingOrigins(\n    24\t  values: Record<string, string>,\n    25\t): Record<string, string> {\n    26\t  const keys = Object.keys(values);\n    27\t  if (\n    28\t    keys.length !== STAGING_SERVICES.length ||\n    29\t    keys.some((key) => !serviceSchema.safeParse(key).success)\n    30\t  )\n    31\t    throw new Error(\"STAGING_ORIGIN_URLS must cover the staging fleet\");\n    32\t  const seen = new Set<string>();\n    33\t  for (const service of STAGING_SERVICES) {\n    34\t    const value = values[service];\n    35\t    if (\n    36\t      !value ||\n    37\t      value.length > 253 ||\n    38\t      !rawOrigin.test(value) ||\n    39\t      value.includes(\"---\") ||\n    40\t      seen.has(value)\n    41\t    )\n    42\t      throw new Error(\n    43\t        \"STAGING_ORIGIN_URLS contains an invalid or duplicate raw service URL\",\n    44\t      );\n    45\t    seen.add(value);\n    46\t  }\n    47\t  return { ...values };\n    48\t}\n    49\t\n    50\texport async function resolveStagingOrigins(\n    51\t  project: string,\n    52\t  region: string,\n    53\t  execFn?: ExecFn,\n    54\t): Promise<Record<string, string>> {\n    55\t  projectSchema.parse(project);\n    56\t  regionSchema.parse(region);\n    57\t  const gate = createToolExec({\n    58\t    allowlist: [\n    59\t      {\n    60\t        name: \"describe-staging-service\",\n    61\t        command: \"gcloud\",\n    62\t        argsSchema: z.tuple([\n    63\t          z.literal(\"run\"),\n    64\t          z.literal(\"services\"),\n    65\t          z.literal(\"describe\"),\n    66\t          serviceSchema,\n    67\t          z.literal(\"--project\"),\n    68\t          projectSchema,\n    69\t          z.literal(\"--region\"),\n    70\t          regionSchema,\n    71\t          z.literal(\"--format=json\"),\n    72\t        ]),\n    73\t      },\n    74\t    ],\n    75\t    ...(execFn === undefined ? {} : { execFn }),\n    76\t  });\n    77\t  const urls: Record<string, string> = {};\n    78\t  for (const service of STAGING_SERVICES) {\n    79\t    const result = await gate.run(\n    80\t      \"describe-staging-service\",\n    81\t      [\n    82\t        \"run\",\n    83\t        \"services\",\n    84\t        \"describe\",\n    85\t        service,\n    86\t        \"--project\",\n    87\t        project,\n    88\t        \"--region\",\n    89\t        region,\n    90\t        \"--format=json\",\n    91\t      ],\n    92\t      \"Resolve staging denial-probe origin\",\n    93\t    );\n    94\t    if (!result.ok)\n    95\t      throw new Error(`Could not resolve staging origin for ${service}`);\n    96\t    const description = z\n    97\t      .object({\n    98\t        metadata: z.object({ name: z.literal(service) }),\n    99\t        status: z.object({ url: z.string().max(253) }),\n   100\t      })\n   101\t      .parse(JSON.parse(result.stdout) as unknown);\n   102\t    urls[service] = description.status.url;\n   103\t  }\n   104\t  return validateStagingOrigins(urls);\n   105\t}\n   106\t\n   107\tasync function main(): Promise<void> {\n   108\t  const urls = await resolveStagingOrigins(\n   109\t    process.env.GCP_NONPROD_PROJECT ?? \"\",\n   110\t    process.env.GCP_REGION ?? \"\",\n   111\t  );\n   112\t  output(\"staging_origin_urls\", JSON.stringify(urls));\n   113\t}\n   114\tif (import.meta.main) main().catch(reportCliError);\n","exit_code":0,"status":"completed"}}
