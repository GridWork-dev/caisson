{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba services/license/src/app.ts'","aggregated_output":"     1\t// src/app.ts — the license-ISSUER HTTP router (ADR-0110, implements ADR-0010). A pure\n     2\t// `Request → Response` function over injected deps (token, signer, registry index, tenant Transactor)\n     3\t// so it is testable without a live socket. Issuance is LAZY + bearer-gated: POST /issue mints a signed\n     4\t// license carrying the account's PURCHASED entitlement ids (the claims contract — every consumer\n     5\t// expands them against the index at verification: Worker resolveGate, MCP server). The read is\n     6\t// RLS-scoped inside `withTenant` and validated fail-closed via `expandEntitlements` before signing\n     7\t// (`@caisson/license-issue`); the expansion is VALIDATION ONLY, never the signed set — signing the\n     8\t// expansion would orphan the purchased-id-keyed `updatesWindows`/`entitledSince` maps at the edge\n     9\t// (the Worker's window fold matches token entitlements against those keys; audit F2 2026-07-06). POST /issue is\n    10\t// IDEMPOTENT per (accountId, major) (\"persist & reuse\"): the first call mints, signs, and persists the\n    11\t// token via `license-grant-store.ts`; every later call for the same (accountId, major) re-serves the\n    12\t// STORED token byte-identical — never proliferates fresh perpetual tokens for one purchase — UNLESS\n    13\t// the account's computed ADR-0244/0255 per-entitlement updates windows differ (canonically) from the\n    14\t// stored token's signed `updatesWindows` map (a renewal landed), in which case /issue RE-MINTS and\n    15\t// replaces the stored token in place (ADR-0251 Decision 3; still one row per (account, major)). A\n    16\t// different major always mints its own grant. POST /webhook is the Paddle Merchant-of-Record\n    17\t// destination (license.caisson.sh/webhook, ADR-0108/0116): it verifies the `Paddle-Signature` HMAC over\n    18\t// the RAW body (timing-safe, fail-closed) and provisions a verified purchase by running BOTH the credit\n    19\t// grant AND the entitlement grant in ONE tenant transaction. /health is public (like services/docs). Every\n    20\t// response carries the standard security-floor headers (nosniff / frame-deny / HSTS). The Bearer gate is\n    21\t// timing-safe over the VARIABLE-LENGTH token (SHA-256 → `timingSafeEqual`, the security-floor rule) and\n    22\t// fail-closed when the token is unset. Server-to-server contract — no CORS.\n    23\timport { createHash, randomUUID, timingSafeEqual } from \"node:crypto\";\n    24\timport { z } from \"zod\";\n    25\timport type { BillingProvider } from \"@caisson/billing\";\n    26\timport { AuthnError, ConflictError } from \"@caisson/kernel\";\n    27\timport {\n    28\t  loadOriginGateConfig,\n    29\t  originRequestAuthorized,\n    30\t  servingRevision,\n    31\t  REVISION_HEADER,\n    32\t  type OriginGateConfig,\n    33\t} from \"@caisson/kernel/node\";\n    34\timport { issueLicense, type Signer } from \"@caisson/license-issue\";\n    35\timport {\n    36\t  decodeToken,\n    37\t  licenseClaimsSchema,\n    38\t  licenseTierSchema,\n    39\t  type LicenseTier,\n    40\t} from \"@caisson/license-verify\";\n    41\timport { withRequestSpan } from \"@caisson/observability\";\n    42\timport { withAdminWrite } from \"@caisson/org-controls\";\n    43\timport {\n    44\t  expandEntitlements,\n    45\t  type RegistryIndex,\n    46\t} from \"@caisson/registry-schema\";\n    47\timport { type Transactor, withTenant } from \"@caisson/tenancy-rls\";\n    48\timport type { ChargebackAlert } from \"./chargeback-notify.ts\";\n    49\timport {\n    50\t  createEvalApplication,\n    51\t  readEvalApplication,\n    52\t  recordIssuedEval,\n    53\t} from \"./eval-store.ts\";\n    54\timport {\n    55\t  type DomainSignals,\n    56\t  type EvalConfig,\n    57\t  extractDomain,\n    58\t  scoreApplication,\n    59\t  validateEvalScope,\n    60\t} from \"./eval-verification.ts\";\n    61\timport type { DiscordGrantPush } from \"./discord-notify.ts\";\n    62\timport type {\n    63\t  PurchaseEmailNotice,\n    64\t  RenewalEmailNotice,\n    65\t  RevokeEmailNotice,\n    66\t} from \"./email-notify.ts\";\n    67\timport {\n    68\t  computeEntitledSince,\n    69\t  computeUpdatesWindows,\n    70\t  readEntitlements,\n    71\t} from \"./entitlement-store.ts\";\n    72\timport {\n    73\t  readLicenseGrant,\n    74\t  storeLicenseGrant,\n    75\t  updateLicenseGrantToken,\n    76\t} from \"./license-grant-store.ts\";\n    77\timport type { PurchaseCapture } from \"./posthog-capture.ts\";\n    78\timport { clientIp, type RateBucket, type RateLimiter } from \"./rate-limit.ts\";\n    79\timport { type BillingWebhookResult, handleBillingWebhook } from \"./webhook.ts\";\n    80\timport type {\n    81\t  RateLimiterFailureMode,\n    82\t  RateLimiterInfraAlert,\n    83\t} from \"./alerting.ts\";\n    84\t\n    85\t/** The one path exempt from the origin gate. MUST equal `healthcheckPath` in\n    86\t *  services/license/railway.toml — a test pins the pair, because a drift there silently re-freezes\n    87\t *  the fleet deploy with no local signal. */\n    88\texport const HEALTH_PROBE_PATH = \"/health\";\n    89\t\n    90\texport interface IssueAppDeps {\n    91\t  /** Bearer secret for POST /issue. Must be non-empty — server.ts fails closed if it is unset. */\n    92\t  token: string;\n    93\t  /**\n    94\t   * A SECOND, admin-scoped Bearer that also authorizes POST /issue (ADR-0220 Fork AM-5). Distinct\n    95\t   * from `token` (`LICENSE_ISSUE_TOKEN`) so the apps/admin reissue proxy authenticates WITHOUT ever\n    96\t   * holding the primary issue secret — routing a CF-Access session through the shared token would\n    97\t   * let any CF-Access identity mint licenses for any account. Empty/unset ⇒ no admin path (the\n    98\t   * default; a normal license service never sets it). Compared timing-safe like `token`.\n    99\t   */\n   100\t  adminToken?: string;\n   101\t  /** The signing identity (default Ed25519Signer over a PKCS8 env key; KMS is an un-wired seam). */\n   102\t  signer: Signer;\n   103\t  /** The built registry index — membership truth for entitlement expansion (ADR-0071). */\n   104\t  index: RegistryIndex;\n   105\t  /** The tenant Transactor — the /issue entitlement reads run inside `withTenant` over it (RLS). */\n   106\t  db: Transactor;\n   107\t  /**\n   108\t   * The Paddle Merchant-of-Record billing provider (verify + parse, ADR-0108/0116). `null` when\n   109\t   * `PADDLE_WEBHOOK_SECRET` is unset — POST /webhook then fails closed (401): an unverifiable payload\n   110\t   * must NEVER provision. server.ts builds it from env and injects it.\n   111\t   */\n   112\t  provider: BillingProvider | null;\n   113\t  /**\n   114\t   * Per-IP token-bucket limiter (services-hardening #4). Gates POST /webhook (the public grey-origin MoR\n   115\t   * surface) and POST /issue (defense-in-depth before the bearer check). The bearer / HMAC stay the\n   116\t   * primary auth — this only caps an abusive flood. server.ts injects it.\n   117\t   */\n   118\t  limiter: RateLimiter;\n   119\t  /** Cloudflare Worker origin gate. Omitted only when the runtime loader supplies the config. */\n   120\t  originGate?: OriginGateConfig;\n   121\t  /**\n   122\t   * Detached operational alert for limiter infrastructure failures. The payload is intentionally\n   123\t   * redacted to route bucket + applied failure policy; it never receives request or error data.\n   124\t   */\n   125\t  rateLimiterAlert: (alert: RateLimiterInfraAlert) => Promise<void>;\n   126\t  /**\n   127\t   * The post-grant Discord role push (ADR-0203). `null` when SUPPORT_BOT_URL /\n   128\t   * SUPPORT_BOT_GRANT_TOKEN are unset — the push is simply skipped. Fired DETACHED after the grant\n   129\t   * commits; it must never delay or fail the webhook response (the injected implementation —\n   130\t   * `notifyDiscordGrant` — never throws).\n   131\t   */\n   132\t  discordNotify: ((push: DiscordGrantPush) => Promise<void>) | null;\n   133\t  /**\n   134\t   * Server-side PostHog `purchase` capture (ADR-0237 F8). `null` when POSTHOG_CAPTURE_KEY is\n   135\t   * unset — the capture is simply skipped. Same post-commit detached contract as `discordNotify`\n   136\t   * (the injected implementation — `capturePostHogPurchase` — never throws).\n   137\t   */\n   138\t  posthogCapture: ((capture: PurchaseCapture) => Promise<void>) | null;\n   139\t  /**\n   140\t   * Abandoned-checkout conversion capture (SPEC outputs/specs/deferred-respec/\n   141\t   * SPEC-abandoned-checkout-email.md §e, 2026-07-10 lock). Optional and `null`-able like\n   142\t   * `posthogCapture` (absent when POSTHOG_CAPTURE_KEY is unset) — the injected implementation\n   143\t   * itself checks whether this account has a recent abandoned-checkout notice\n   144\t   * (`hasRecentAbandonedCheckoutNotice`) before firing anything, so this gate here is only \"did a\n   145\t   * real, granting purchase land,\" same as `posthogCapture`'s own gate.\n   146\t   */\n   147\t  abandonedCheckoutConverted?: ((accountId: string) => Promise<void>) | null;\n   148\t  /**\n   149\t   * The post-grant purchase-confirmation email. Unlike `discordNotify`/`posthogCapture` this is\n   150\t   * never `null` — `server.ts` always wires `email-notify.ts#resolveEmailer()` (Resend or the\n   151\t   * capture driver), so email is always \"sent\" somewhere. Same detached, never-throw contract as\n   152\t   * `discordNotify` (the injected implementation — `notifyPurchaseEmail` — never throws).\n   153\t   */\n   154\t  purchaseEmailNotify: (notice: PurchaseEmailNotice) => Promise<void>;\n   155\t  /**\n   156\t   * The post-grant renewal-confirmation email (ADR-0251) — the SIBLING send for a RENEWAL_BOOK\n   157\t   * line, which grants nothing so it never fires `purchaseEmailNotify`. Same never-`null`,\n   158\t   * always-wired, detached, never-throw contract. A mixed cart (a new entitlement line + a\n   159\t   * renewal line in one event) fires BOTH `purchaseEmailNotify` and this; only the purchase\n   160\t   * receipt carries the whole-event total (this notice's `amountTotalMinor` is omitted there).\n   161\t   */\n   162\t  renewalEmailNotify: (notice: RenewalEmailNotice) => Promise<void>;\n   163\t  /**\n   164\t   * G27 (buyer-lifecycle audit 2026-07-07) — the post-revoke \"your access changed\" email, fired\n   165\t   * only when a subscription cancel or a refund ACTUALLY revoked an active grant (see\n   166\t   * `RevokeNotice`). Same never-`null`, always-wired, detached, never-throw contract as\n   167\t   * `purchaseEmailNotify`/`renewalEmailNotify`.\n   168\t   */\n   169\t  revokeEmailNotify: (notice: RevokeEmailNotice) => Promise<void>;\n   170\t  /**\n   171\t   * ADR-0294 chargeback/dispute operator alert. Unlike `discordNotify`/`posthogCapture` this is\n   172\t   * never `null` — `server.ts` always wires `chargeback-notify.ts#notifyChargebackAlert`, which\n   173\t   * itself always logs the stderr ALERT floor and additionally posts to a Discord Incoming\n   174\t   * Webhook when configured. Same detached, never-throw contract as the other post-commit pushes.\n   175\t   */\n   176\t  chargebackAlert: (alert: ChargebackAlert) => Promise<void>;\n   177\t  /**\n   178\t   * Index-parity probe surface (the F-1 index-parity residual: three independently-baked copies of\n   179\t   * registry/index.json can drift). The sha256 (first 12 hex) of the index.json BYTES this service\n   180\t   * loaded at boot, plus the entry count — echoed additively on GET /health. Absent ⇒ /health keeps\n   181\t   * its bare `{ ok: true }` shape (existing probes grep it). server.ts always supplies both.\n   182\t   */\n   183\t  indexDigest?: string;\n   184\t  indexEntries?: number;\n   185\t  /**\n   186\t   * The evaluation-access surface (ADR-0274 §2 / ADR-0280 verified time-boxed eval licenses).\n   187\t   * `null`/absent ⇒ POST /eval/* returns 404 (a deploy without the eval tables provisioned simply\n   188\t   * does not serve them; /issue + /webhook are unaffected). server.ts always wires it.\n   189\t   */\n   190\t  eval?: EvalAppDeps | null;\n   191\t}\n   192\t\n   193\t/** Injected dependencies for the eval-access routes. */\n   194\texport interface EvalAppDeps {\n   195\t  /** Verification thresholds (ADR-0274/0280) — from `loadEvalConfig`. */\n   196\t  config: EvalConfig;\n   197\t  /**\n   198\t   * Resolve a domain's verification signals (MX / age / enrichment). INJECTED so scoring is\n   199\t   * network-free in tests and config-gated in prod (`eval-signals.ts#resolveDomainSignals`). Every\n   200\t   * failure resolves to an `undefined` field (uncertainty → review), never a pass.\n   201\t   */\n   202\t  resolveSignals: (domain: string) => Promise<DomainSignals>;\n   203\t}\n   204\t\n   205\t/**\n   206\t * POST /issue body. `.strict()` rejects unknown fields; the account id + version are bounded. The\n   207\t * tier is the SHARED `licenseTierSchema` (never re-declared). `entitlements` are NOT taken from the\n   208\t * caller — they are resolved server-side from the account's purchases (ADR-0071), so a caller cannot\n   209\t * mint itself entitlements it did not buy. `expiry` is an ISO-8601 instant or `null` (perpetual-per-major).\n   210\t *\n   211\t * TRUST ASSUMPTION (`tier`): unlike `entitlements`, `tier` is asserted by the caller. This is a\n   212\t * server-to-server, bearer-gated endpoint whose sole caller is the billing service, which derives the\n   213\t * tier from the same account-entitlement store. The bearer token (`LICENSE_ISSUE_TOKEN`) is the trust\n   214\t * boundary; there is no independent purchase→tier check here by design — downstream feature access gates\n   215\t * on the server-resolved `entitlements` list, not the `tier` label.\n   216\t */\n   217\t// Exported so tools/security/emit-openapi.ts can generate a true-to-code OpenAPI spec for schema\n   218\t// fuzzing (Schemathesis) without re-declaring the shape — the emit is the fuzz contract's source.\n   219\texport const IssueBody = z\n   220\t  .object({\n   221\t    accountId: z.string().trim().min(1).max(256),\n   222\t    tier: licenseTierSchema,\n   223\t    major: z.number().int().nonnegative(),\n   224\t    expiry: z.string().datetime({ offset: true }).nullable(),\n   225\t    // TRUE key rotation (the admin rotation lever): skip the idempotent re-serve and mint a FRESH\n   226\t    // token + licenseId even when the stored claims are unchanged, replacing the stored grant in\n   227\t    // place. The caller is responsible for denying the OLD licenseId (the edge deny-set) BEFORE\n   228\t    // requesting this mint — this flag only forces the re-mint. Grants no new privilege: both\n   229\t    // bearers can already mint; absent/false keeps the persist-and-reuse contract byte-identical.\n   230\t    rotate: z.boolean().optional(),\n   231\t  })\n   232\t  .strict();\n   233\t\n   234\t/**\n   235\t * POST /eval/apply body (ADR-0280). `.strict()` rejects unknown fields. `email` is the applicant's\n   236\t * WORK email (Zod-validated + bounded); the domain is derived server-side (never trusted from the\n   237\t * caller). `entitlements` is the purchased-id scope to evaluate (validated against the registry\n   238\t * index at /eval/issue). `accountId` is the buyer account (from a verified session upstream).\n   239\t */\n   240\texport const EvalApplyBody = z\n   241\t  .object({\n   242\t    accountId: z.string().trim().min(1).max(256),\n   243\t    email: z.string().trim().email().max(320),\n   244\t    entitlements: z.array(z.string().trim().min(1).max(128)).min(1).max(64),\n   245\t  })\n   246\t  .strict();\n   247\t\n   248\t/** POST /eval/issue body. `.strict()`. `evalId` is the application id; `major` the license major. */\n   249\texport const EvalIssueBody = z\n   250\t  .object({\n   251\t    evalId: z.string().uuid(),\n   252\t    major: z.number().int().nonnegative(),\n   253\t  })\n   254\t  .strict();\n   255\t\n   256\t/**\n   257\t * POST /admin/affiliate/mint body (ADR-0315/0320). `.strict()`. The admin-scoped, server-to-server\n   258\t * affiliate mint: apps/admin's mint proxy sends the redeemable `code` + an internal `description`\n   259\t * (the affiliate name); this endpoint holds `PADDLE_API_KEY` and calls the billing driver's\n   260\t * `createDiscount` so that credential never enters the admin app. The 10%/30% program parameters are\n   261\t * inlined in the driver (operator-locked, ADR-0320) — never taken from this body.\n   262\t */\n   263\texport const AffiliateMintBody = z\n   264\t  .object({\n   265\t    code: z\n   266\t      .string()\n   267\t      .trim()\n   268\t      .min(1)\n   269\t      .max(32)\n   270\t      .regex(/^[A-Za-z0-9]+$/, \"code must be letters and digits only\"),\n   271\t    description: z.string().trim().min(1).max(200),\n   272\t  })\n   273\t  .strict();\n   274\t\n   275\tconst SECURITY_HEADERS: Record<string, string> = {\n   276\t  \"X-Content-Type-Options\": \"nosniff\",\n   277\t  \"X-Frame-Options\": \"DENY\",\n   278\t  \"Strict-Transport-Security\": \"max-age=63072000; includeSubDomains\",\n   279\t};\n   280\t\n   281\tfunction respond(\n   282\t  body: string,\n   283\t  status: number,\n   284\t  contentType: string,\n   285\t  extra?: Record<string, string>,\n   286\t): Response {\n   287\t  return new Response(body, {\n   288\t    status,\n   289\t    headers: {\n   290\t      ...SECURITY_HEADERS,\n   291\t      // Ungated on purpose, unlike the health body's indexDigest: this must stay readable exactly\n   292\t      // when the origin gate is the thing misbehaving, which is the case it exists to diagnose.\n   293\t      // An opaque commit id for a private repo discloses nothing actionable on its own.\n   294\t      [REVISION_HEADER]: servingRevision(),\n   295\t      \"Content-Type\": contentType,\n   296\t      ...extra,\n   297\t    },\n   298\t  });\n   299\t}\n   300\t\n   301\tconst json = (data: unknown, status = 200): Response =>\n   302\t  respond(JSON.stringify(data), status, \"application/json; charset=utf-8\");\n   303\tconst text = (\n   304\t  body: string,\n   305\t  status = 200,\n   306\t  extra?: Record<string, string>,\n   307\t): Response => respond(body, status, \"text/plain; charset=utf-8\", extra);\n   308\t\n   309\t/**\n   310\t * Timing-safe Bearer check. `LICENSE_ISSUE_TOKEN` is an opaque secret of not-guaranteed-fixed length, so\n   311\t * per the security floor's VARIABLE-LENGTH rule both sides are SHA-256-digested to fixed 32-byte buffers\n   312\t * before `timingSafeEqual` — avoiding the equal-length guard that would leak the token's byte length to a\n   313\t * remote timing oracle. Normalization is identical on both sides (raw bytes), so only the value compares.\n   314\t */\n   315\tfunction tokenMatches(presented: string, token: string): boolean {\n   316\t  if (token.length === 0) return false; // unconfigured ⇒ fail closed\n   317\t  const a = createHash(\"sha256\").update(presented).digest();\n   318\t  const b = createHash(\"sha256\").update(token).digest();\n   319\t  return timingSafeEqual(a, b);\n   320\t}\n   321\t\n   322\t/**\n   323\t * Timing-safe Bearer check against the primary issue token AND (if configured) the distinct\n   324\t * admin-scoped token (ADR-0220). BOTH digests are always computed before either compares, so the\n   325\t * presence of the admin token never changes the timing profile of a primary-token request. An\n   326\t * empty presented bearer matches neither (both configured secrets are non-empty by construction).\n   327\t */\n   328\tfunction authorized(req: Request, token: string, adminToken: string): boolean {\n   329\t  const header = req.headers.get(\"authorization\") ?? \"\";\n   330\t  const presented = header.startsWith(\"Bearer \") ? header.slice(7) : \"\";\n   331\t  const primary = tokenMatches(presented, token);\n   332\t  const admin = tokenMatches(presented, adminToken);\n   333\t  return primary || admin;\n   334\t}\n   335\t\n   336\t/**\n   337\t * The re-mint-relevant claims carried by a STORED wire token — the signed `entitlements` (sorted\n   338\t * purchased ids) plus the per-entitlement `updatesWindows` (ADR-0251 D3 / ADR-0255) AND\n   339\t * `entitledSince` snapshot instants (ADR-0257 §1.2). Decode-only (no signature verify — the stored\n   340\t * token was minted by THIS service and is re-verified offline by every consumer; the baked verify\n   341\t * key here is prod, which a dev/test-signed stored token would fail). An absent/null map field (a\n   342\t * pre-window / pre-snapshot token) normalizes to the EMPTY map, so a subscription-only account's\n   343\t * stored token keeps re-serving byte-identical. A decode/parse failure reads as empty claims — the\n   344\t * fresh comparison then differs (any entitled account has a non-empty purchased set) and the corrupt\n   345\t * stored token is RE-MINTED in place rather than re-served: a token the verifier would reject helps\n   346\t * nobody, and the grant row stays unique per (account, major).\n   347\t */\n   348\tfunction storedRemintClaims(token: string): {\n   349\t  entitlements: string[];\n   350\t  updatesWindows: Record<string, string>;\n   351\t  entitledSince: Record<string, string>;\n   352\t} {\n   353\t  try {\n   354\t    const claims = licenseClaimsSchema.parse(\n   355\t      JSON.parse(decodeToken(token).payload) as unknown,\n   356\t    );\n   357\t    return {\n   358\t      entitlements: [...claims.entitlements].sort(),\n   359\t      updatesWindows: claims.updatesWindows ?? {},\n   360\t      entitledSince: claims.entitledSince ?? {},\n   361\t    };\n   362\t  } catch {\n   363\t    return { entitlements: [], updatesWindows: {}, entitledSince: {} };\n   364\t  }\n   365\t}\n   366\t\n   367\t/**\n   368\t * Canonical form of a `purchasedEntitlementId → ISO` map for the re-mint equality check (ADR-0255\n   369\t * Decision 4): sorted-key JSON, so key insertion order never fakes a change. Used for both the\n   370\t * `updatesWindows` and `entitledSince` maps.\n   371\t */\n   372\tfunction canonicalMap(map: Record<string, string>): string {\n   373\t  return JSON.stringify(\n   374\t    Object.entries(map).sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0)),\n   375\t  );\n   376\t}\n   377\t\n   378\tinterface IssueOrReuseInput {\n   379\t  accountId: string;\n   380\t  tier: LicenseTier;\n   381\t  major: number;\n   382\t  expiry: string | null;\n   383\t  /** True → skip the re-serve equality check and ALWAYS mint fresh (key rotation). The stored\n   384\t   *  grant is still replaced in place — one row per (account, major) holds either way. */\n   385\t  forceRemint?: boolean;\n   386\t}\n   387\t\n   388\t/**\n   389\t * The discriminated outcome of {@link issueOrReuseLicense} — the SAME two failure modes the\n   390\t * POST /issue route has always mapped to a 422/500 JSON body (see the route below), returned as\n   391\t * data instead of a `Response` so the ADR-0292 webhook-push mint (`mintLicensePostCommit`) can map\n   392\t * a failure onto its own log-and-alert contract instead.\n   393\t */\n   394\ttype IssueOutcome =\n   395\t  | { kind: \"ok\"; token: string; licenseId: string }\n   396\t  | { kind: \"unresolved\" }\n   397\t  | { kind: \"sign_failed\" };\n   398\t\n   399\t/**\n   400\t * The shared POST /issue core — ADR-0110's \"persist & reuse\" idempotent mint, extracted 2026-07-07\n   401\t * (ADR-0292) so the webhook-push first-mint reuses this EXACT signing + persistence path rather\n   402\t * than a second implementation. See the POST /issue route below for the full behavior contract\n   403\t * (idempotent re-serve, the ADR-0251 Decision 3 window-changed re-mint, the race-loser re-read).\n   404\t */\n   405\tasync function issueOrReuseLicense(\n   406\t  deps: Pick<IssueAppDeps, \"db\" | \"signer\" | \"index\">,\n   407\t  input: IssueOrReuseInput,\n   408\t): Promise<IssueOutcome> {\n   409\t  const { accountId, tier, major, expiry } = input;\n   410\t  const { existing, updatesWindows, entitledSince, purchased } =\n   411\t    await withTenant(deps.db, accountId, async (tx) => ({\n   412\t      existing: await readLicenseGrant(tx, accountId, major),\n   413\t      updatesWindows: await computeUpdatesWindows(tx, accountId),\n   414\t      entitledSince: await computeEntitledSince(tx, accountId),\n   415\t      purchased: await readEntitlements(tx, accountId),\n   416\t    }));\n   417\t  // The SIGNED entitlements are the account's PURCHASED ids, sorted — the claims contract every\n   418\t  // consumer expands against the index at verification. Signing the EXPANSION instead orphans the\n   419\t  // purchased-id-keyed `updatesWindows`/`entitledSince` maps (audit F2, 2026-07-06).\n   420\t  const entitlements = [...purchased].sort();\n   421\t  if (existing !== null && input.forceRemint !== true) {\n   422\t    const stored = storedRemintClaims(existing.token);\n   423\t    if (\n   424\t      stored.entitlements.join(\" \") === entitlements.join(\" \") &&\n   425\t      canonicalMap(stored.updatesWindows) === canonicalMap(updatesWindows) &&\n   426\t      canonicalMap(stored.entitledSince) === canonicalMap(entitledSince)\n   427\t    ) {\n   428\t      return {\n   429\t        kind: \"ok\",\n   430\t        token: existing.token,\n   431\t        licenseId: existing.licenseId,\n   432\t      };\n   433\t    }\n   434\t  }\n   435\t\n   436\t  // Fail-closed TM-E VALIDATION only (never the signed set): a stored purchased id absent from the\n   437\t  // index — and not reserved — throws; mapped to the generic \"unresolved\" outcome (never echoing\n   438\t  // internal ids).\n   439\t  try {\n   440\t    expandEntitlements(deps.index, purchased);\n   441\t  } catch {\n   442\t    return { kind: \"unresolved\" };\n   443\t  }\n   444\t\n   445\t  const claims = {\n   446\t    licenseId: randomUUID(),\n   447\t    tier,\n   448\t    entitlements,\n   449\t    major,\n   450\t    expiry,\n   451\t    updatesWindows,\n   452\t    entitledSince,\n   453\t  };\n   454\t  let token: string;\n   455\t  try {\n   456\t    token = await issueLicense(deps.signer, claims);\n   457\t  } catch {\n   458\t    // A signer failure (corrupted PKCS8 key, a future KMS adapter timeout) — never an unhandled\n   459\t    // async rejection.\n   460\t    return { kind: \"sign_failed\" };\n   461\t  }\n   462\t\n   463\t  // Window-changed RE-MINT (ADR-0251 Decision 3): a stored grant exists but its signed window is\n   464\t  // stale — replace the stored row's token in place (still exactly one row per (account, major)).\n   465\t  // Late-loser caveat: a mint that hit the `withDeadline` timeout but keeps running in the\n   466\t  // background (abandoned, not canceled) can still land HERE late — if two renewals for the SAME\n   467\t  // account race within seconds, the late one's UPDATE can clobber a newer token with a stale one.\n   468\t  // Self-heals on the account's next renewal event; only reachable once a slow KMS signer replaces\n   469\t  // the current instant local Ed25519 signer (which never triggers the deadline in the first place).\n   470\t  if (existing !== null) {\n   471\t    await withTenant(deps.db, accountId, (tx) =>\n   472\t      updateLicenseGrantToken(tx, {\n   473\t        accountId,\n   474\t        major,\n   475\t        licenseId: claims.licenseId,\n   476\t        tier,\n   477\t        expiry,\n   478\t        token,\n   479\t      }),\n   480\t    );\n   481\t    return { kind: \"ok\", token, licenseId: claims.licenseId };\n   482\t  }\n   483\t\n   484\t  // Persist, idempotently: a concurrent /issue for the same (accountId, major) may have minted its\n   485\t  // OWN token and stored it first — `storeLicenseGrant`'s unique-index ON CONFLICT silently drops\n   486\t  // the loser's insert. Re-read on a lost race so every caller converges on the SAME stored\n   487\t  // (winning) token, never two live tokens for one (account, major).\n   488\t  const stored = await withTenant(deps.db, accountId, (tx) =>\n   489\t    storeLicenseGrant(tx, {\n   490\t      accountId,\n   491\t      major,\n   492\t      licenseId: claims.licenseId,\n   493\t      tier,\n   494\t      expiry,\n   495\t      token,\n   496\t    }),\n   497\t  );\n   498\t  if (stored) {\n   499\t    return { kind: \"ok\", token, licenseId: claims.licenseId };\n   500\t  }\n   501\t  const winner = await withTenant(deps.db, accountId, (tx) =>\n   502\t    readLicenseGrant(tx, accountId, major),\n   503\t  );\n   504\t  // The unique-index insert just reported a conflict, so a row MUST exist; this null branch is an\n   505\t  // unreachable defensive fallback (never observed) rather than a silent re-mint on a read failure.\n   506\t  return winner !== null\n   507\t    ? { kind: \"ok\", token: winner.token, licenseId: winner.licenseId }\n   508\t    : { kind: \"ok\", token, licenseId: claims.licenseId };\n   509\t}\n   510\t\n   511\t// The local Ed25519 signer never blocks, but a future KMS-backed `Signer`\n   512\t// could — and `mintLicensePostCommit` is AWAITED inline in the webhook response path. This bounds\n   513\t// an otherwise-INFINITE hang and preserves the never-5xx contract (the mint always resolves one way\n   514\t// or another within this window). It does NOT guarantee the response stays inside Paddle's own ~5s\n   515\t// total webhook timeout on a slow signer: this deadline stacks on top of the grant transaction that\n   516\t// already ran before it, so a slow signer can still push the delivery past Paddle's window — Paddle\n   517\t// then retries, which is benign (both the grant and the mint are idempotent), not silent data loss.\n   518\tconst MINT_POST_COMMIT_TIMEOUT_MS = 5_000;\n   519\t\n   520\t/**\n   521\t * Race `work` against `timeoutMs` — REJECTS with a deadline error if `work` hasn't settled in time\n   522\t * (mirrors `packages/guardrails`'s `moderateWithDeadline` race idiom). A pending `work` that later\n   523\t * settles past the deadline must not surface as an unhandled rejection.\n   524\t */\n   525\tfunction withDeadline<T>(work: Promise<T>, timeoutMs: number): Promise<T> {\n   526\t  work.catch(() => {});\n   527\t  let timer: ReturnType<typeof setTimeout> | undefined;\n   528\t  const deadline = new Promise<never>((_, reject) => {\n   529\t    timer = setTimeout(\n   530\t      () =>\n   531\t        reject(new Error(`mint deadline exceeded (${String(timeoutMs)}ms)`)),\n   532\t      timeoutMs,\n   533\t    );\n   534\t  });\n   535\t  return Promise.race([work, deadline]).finally(() => {\n   536\t    if (timer !== undefined) clearTimeout(timer);\n   537\t  });\n   538\t}\n   539\t\n   540\t/**\n   541\t * ADR-0292 — license first-mint webhook-push. Mint (or idempotently re-serve, per\n   542\t * {@link issueOrReuseLicense}'s own persist-and-reuse discipline) the buyer's license post-commit,\n   543\t * called only after a GRANTING or RENEWING billing event has already durably committed. NEVER\n   544\t * throws — the grant already landed, so a mint failure (a signer outage, a transient DB error, OR\n   545\t * a signer that exceeds {@link MINT_POST_COMMIT_TIMEOUT_MS}) must not turn an already-successful\n   546\t * webhook into a needless Paddle retry; it logs one operator-visible ALERT line and resolves\n   547\t * `null`. major/tier mirror the launch runbook's manual first-mint curl and the eval-issue path's\n   548\t * own default (major 0, perpetual; tier \"pro\" — a cosmetic label only, downstream access gates on\n   549\t * the signed `entitlements` list, never `tier`). Self-healing by construction: a failed OR\n   550\t * timed-out mint recovers on the account's NEXT granting/renewing event, or via the admin\n   551\t * first-mint lever (`POST /issue` through the admin reissue proxy) — a timeout leaves the\n   552\t * underlying signer call simply abandoned (never canceled — Ed25519/KMS signing has no cancel\n   553\t * primitive), so it may still complete in the background; the NEXT recovery path re-mints\n   554\t * idempotently regardless.\n   555\t */\n   556\tasync function mintLicensePostCommit(\n   557\t  deps: Pick<IssueAppDeps, \"db\" | \"signer\" | \"index\">,\n   558\t  accountId: string,\n   559\t): Promise<string | null> {\n   560\t  try {\n   561\t    const outcome = await withDeadline(\n   562\t      issueOrReuseLicense(deps, {\n   563\t        accountId,\n   564\t        tier: \"pro\",\n   565\t        major: 0,\n   566\t        expiry: null,\n   567\t      }),\n   568\t      MINT_POST_COMMIT_TIMEOUT_MS,\n   569\t    );\n   570\t    if (outcome.kind === \"ok\") return outcome.token;\n   571\t    process.stderr.write(\n   572\t      `[service-license] ALERT: first-mint license failed (${outcome.kind}) for account ${accountId} — no automated license issued this delivery; the next grant/renewal or the admin first-mint lever recovers\\n`,\n   573\t    );\n   574\t    return null;\n   575\t  } catch (err) {\n   576\t    process.stderr.write(\n   577\t      `[service-license] ALERT: first-mint license threw for account ${accountId}: ${err instanceof Error ? err.message : String(err)} — no automated license issued this delivery; the next grant/renewal or the admin first-mint lever recovers\\n`,\n   578\t    );\n   579\t    return null;\n   580\t  }\n   581\t}\n   582\t\n   583\t/** Build the request handler. Async because /issue awaits the tenant read + the signer. */\n   584\texport function createApp(\n   585\t  deps: IssueAppDeps,\n   586\t): (req: Request) => Promise<Response> {\n   587\t  const originGate = deps.originGate ?? loadOriginGateConfig(process.env);\n   588\t  /** Per-IP rate gate. A real bucket denial is always 429. Infrastructure failure follows the\n   589\t   * caller's explicit route policy and emits a detached, redacted operational alert. */\n   590\t  const rateLimited = (\n   591\t    bucket: RateBucket,\n   592\t    req: Request,\n   593\t    failureMode: RateLimiterFailureMode,\n   594\t  ): Response | null => {\n   595\t    try {\n   596\t      // Per-IP FIRST, so per-IP abuse stays isolated to the abuser's own bucket. Only a per-IP-ALLOWED\n   597\t      // request then charges the header-independent service-wide ceiling (Strix vuln-0001 defense-in-\n   598\t      // depth) — charging global first would let one throttled IP drain it and 429 everyone else\n   599\t      // (self-DoS amplification). Deny if EITHER trips.\n   600\t      const decision = deps.limiter.check(bucket, clientIp(req));\n   601\t      if (!decision.allowed) {\n   602\t        return text(\"rate limit exceeded\", 429, {\n   603\t          \"Retry-After\": String(decision.retryAfterSec),\n   604\t        });\n   605\t      }\n   606\t      const global = deps.limiter.checkGlobal(bucket);\n   607\t      if (!global.allowed) {\n   608\t        return text(\"rate limit exceeded\", 429, {\n   609\t          \"Retry-After\": String(global.retryAfterSec),\n   610\t        });\n   611\t      }\n   612\t      return null;\n   613\t    } catch {\n   614\t      process.stderr.write(\n   615\t        `[service-license] ALERT: rate-limiter infrastructure failure; bucket=${bucket}; policy=fail-${failureMode}\\n`,\n   616\t      );\n   617\t      try {\n   618\t        void deps\n   619\t          .rateLimiterAlert({ bucket, failureMode })\n   620\t          .catch(() =>\n   621\t            process.stderr.write(\n   622\t              \"[service-license] rate-limiter alert rejected (ignored)\\n\",\n   623\t            ),\n   624\t          );\n   625\t      } catch {\n   626\t        process.stderr.write(\n   627\t          \"[service-license] rate-limiter alert threw (ignored)\\n\",\n   628\t        );\n   629\t      }\n   630\t      return failureMode === \"closed\"\n   631\t        ? json({ error: \"rate limiter unavailable\" }, 503)\n   632\t        : null;\n   633\t    }\n   634\t  };\n   635\t\n   636\t  return withRequestSpan(async (req: Request): Promise<Response> => {\n   637\t    const url = new URL(req.url);\n   638\t    const { pathname } = url;\n   639\t    const method = req.method.toUpperCase();\n   640\t\n   641\t    // Railway's platform healthcheck reaches the container internally and cannot carry the\n   642\t    // Worker-injected secret, so gating the probe path froze every deploy in the fleet (ADR-0416\n   643\t    // ruling 1). Exact equality, never a prefix — Railway probes the configured healthcheckPath\n   644\t    // and nothing else, so exempting more than the literal string widens the carve for no benefit.\n   645\t    const healthProbe = pathname === HEALTH_PROBE_PATH;\n   646\t    const originAuthorized = originRequestAuthorized(req, originGate);\n   647\t    if (!healthProbe && !originAuthorized) {\n   648\t      return json({ error: \"forbidden\" }, 403);\n   649\t    }\n   650\t\n   651\t    if (healthProbe) {\n   652\t      if (method !== \"GET\") return text(\"method not allowed\", 405);\n   653\t      // Additive: `ok` stays first + always present (existing probes grep it). The index digest +\n   654\t      // entry count ride alongside whenever server.ts supplies them, with no origin-secret gate\n   655\t      // (ADR-0417, superseding the gated half of ADR-0416 ruling 1). The gate never protected\n   656\t      // anything: originRequestAuthorized proves PROVENANCE (the request arrived through the\n   657\t      // Cloudflare Worker), not authentication of caller identity, and the Worker injects the\n   658\t      // secret into every edge request — so every public caller on license.caisson.sh is already\n   659\t      // \"authorized\" by construction. Gating on it withheld the field from exactly one class (a\n   660\t      // direct-to-origin *.up.railway.app caller) while the front door handed it to the entire\n   661\t      // internet. And there was no secret to protect in the first place: the digest is a\n   662\t      // sha256-first-12 of registry/index.json, a file the registry Worker already serves\n   663\t      // publicly at registry.caisson.sh. Measured 2026-09-01: the edge and the raw origin both\n   664\t      // reach this handler; only the edge path used to carry the fields. Publish unconditionally.\n   665\t      return json({\n   666\t        ok: true,\n   667\t        ...(deps.indexDigest !== undefined\n   668\t          ? { indexDigest: deps.indexDigest, indexEntries: deps.indexEntries }\n   669\t          : {}),\n   670\t      });\n   671\t    }\n   672\t\n   673\t    if (pathname === \"/issue\") {\n   674\t      if (method !== \"POST\") return text(\"method not allowed\", 405);\n   675\t      // Rate-gate BEFORE the bearer check (defense-in-depth) so an unauthenticated flood is capped too.\n   676\t      const limited = rateLimited(\"issue\", req, \"closed\");\n   677\t      if (limited !== null) return limited;\n   678\t      if (!authorized(req, deps.token, deps.adminToken ?? \"\"))\n   679\t        return json({ error: \"unauthorized\" }, 401);\n   680\t\n   681\t      let raw: unknown;\n   682\t      try {\n   683\t        raw = await req.json();\n   684\t      } catch {\n   685\t        return json({ error: \"invalid JSON body\" }, 400);\n   686\t      }\n   687\t      const parsed = IssueBody.safeParse(raw);\n   688\t      if (!parsed.success) {\n   689\t        return json(\n   690\t          { error: \"invalid issue request\", issues: parsed.error.issues },\n   691\t          400,\n   692\t        );\n   693\t      }\n   694\t      const { accountId, tier, major, expiry, rotate } = parsed.data;\n   695\t\n   696\t      // Idempotent re-serve (persist & reuse) with the ADR-0251 Decision 3 window-changed re-mint\n   697\t      // and the race-loser re-read -- the full behavior contract lives on issueOrReuseLicense\n   698\t      // above (extracted 2026-07-07, ADR-0292, so the webhook-push first-mint below shares this\n   699\t      // EXACT path rather than a second implementation). `rotate: true` (the admin rotation\n   700\t      // lever) forces a fresh mint instead of the re-serve — see IssueBody.\n   701\t      const outcome = await issueOrReuseLicense(deps, {\n   702\t        accountId,\n   703\t        tier,\n   704\t        major,\n   705\t        expiry,\n   706\t        forceRemint: rotate === true,\n   707\t      });\n   708\t      if (outcome.kind === \"unresolved\") {\n   709\t        // Fail-closed TM-E VALIDATION only (never the signed set): a stored purchased id absent\n   710\t        // from the index -- and not reserved -- throws inside issueOrReuseLicense; mapped here to\n   711\t        // a 422 with a GENERIC message (never echo internal ids).\n   712\t        return json({ error: \"could not resolve account entitlements\" }, 422);\n   713\t      }\n   714\t      if (outcome.kind === \"sign_failed\") {\n   715\t        // A signer failure (corrupted PKCS8 key, a future KMS adapter timeout) must surface as a\n   716\t        // structured 500 -- never an unhandled async rejection that Bun renders as a non-JSON body\n   717\t        // or leaks internal error detail.\n   718\t        return json({ error: \"signing failed\" }, 500);\n   719\t      }\n   720\t      return json({ token: outcome.token, licenseId: outcome.licenseId });\n   721\t    }\n   722\t\n   723\t    // ADR-0315/0320 — the admin-scoped affiliate discount mint. Server-to-server, bearer-gated (the\n   724\t    // apps/admin mint proxy holds the admin token), rate-limited under the same \"issue\" bucket. This\n   725\t    // endpoint holds `PADDLE_API_KEY` and calls the billing driver's `createDiscount` so that\n   726\t    // credential never enters the admin app; it does NOT touch the DB (the affiliate_code\n   727\t    // registration + dual-log run in apps/admin as `admin_write`). Returns only the minted\n   728\t    // `{ discountId, code }`.\n   729\t    if (pathname === \"/admin/affiliate/mint\") {\n   730\t      if (method !== \"POST\") return text(\"method not allowed\", 405);\n   731\t      const limited = rateLimited(\"issue\", req, \"closed\");\n   732\t      if (limited !== null) return limited;\n   733\t      if (!authorized(req, deps.token, deps.adminToken ?? \"\"))\n   734\t        return json({ error: \"unauthorized\" }, 401);\n   735\t      if (deps.provider === null || deps.provider.createDiscount === undefined)\n   736\t        return json({ error: \"affiliate minting not configured\" }, 501);\n   737\t\n   738\t      let raw: unknown;\n   739\t      try {\n   740\t        raw = await req.json();\n   741\t      } catch {\n   742\t        return json({ error: \"invalid JSON body\" }, 400);\n   743\t      }\n   744\t      const parsed = AffiliateMintBody.safeParse(raw);\n   745\t      if (!parsed.success) {\n   746\t        return json(\n   747\t          { error: \"invalid mint request\", issues: parsed.error.issues },\n   748\t          400,\n   749\t        );\n   750\t      }\n   751\t      try {\n   752\t        const minted = await deps.provider.createDiscount({\n   753\t          code: parsed.data.code,\n   754\t          description: parsed.data.description,\n   755\t        });\n   756\t        return json({ discountId: minted.discountId, code: minted.code });\n   757\t      } catch {\n   758\t        // createDiscount throws on any Paddle failure (bad key, duplicate code, network) — map to a\n   759\t        // generic 502 (never echo the provider's raw error). The admin orchestrator's proxy treats a\n   760\t        // non-2xx as a mint failure and writes no affiliate_code row.\n   761\t        return json({ error: \"discount creation failed\" }, 502);\n   762\t      }\n   763\t    }\n   764\t\n   765\t    // ADR-0274 §2 / ADR-0280 — the verified time-boxed eval-license surface. Both routes are\n   766\t    // bearer-gated (server-to-server; the apps/site \"request an evaluation\" surface proxies /apply,\n   767\t    // holding the bearer) and rate-limited under the same \"issue\" bucket. The store runs cross-tenant\n   768\t    // (`withAdminWrite`) because the anti-abuse invariants (one active eval per domain, a global cap,\n   769\t    // card-fingerprint reuse) are inherently cross-account.\n   770\t    if (pathname === \"/eval/apply\") {\n   771\t      if (method !== \"POST\") return text(\"method not allowed\", 405);\n   772\t      const evalDeps = deps.eval;\n   773\t      if (evalDeps === null || evalDeps === undefined)\n   774\t        return json({ error: \"not found\" }, 404);\n   775\t      const limited = rateLimited(\"issue\", req, \"closed\");\n   776\t      if (limited !== null) return limited;\n   777\t      if (!authorized(req, deps.token, deps.adminToken ?? \"\"))\n   778\t        return json({ error: \"unauthorized\" }, 401);\n   779\t\n   780\t      let raw: unknown;\n   781\t      try {\n   782\t        raw = await req.json();\n   783\t      } catch {\n   784\t        return json({ error: \"invalid JSON body\" }, 400);\n   785\t      }\n   786\t      const parsed = EvalApplyBody.safeParse(raw);\n   787\t      if (!parsed.success) {\n   788\t        return json(\n   789\t          { error: \"invalid eval application\", issues: parsed.error.issues },\n   790\t          400,\n   791\t        );\n   792\t      }\n   793\t      const { accountId, email, entitlements } = parsed.data;\n   794\t      // Scope ceiling (fail-closed shape check, before any signal lookup): an eval is never the full\n   795\t      // catalog or a multi-bundle grant — see validateEvalScope for the exact allowed shapes.\n   796\t      const scopeError = validateEvalScope(entitlements);\n   797\t      if (scopeError !== null) return json({ error: scopeError }, 400);\n   798\t      // Derive the domain server-side; a structurally invalid/unresolvable work email is a hard 400\n   799\t      // (no row) — extractDomain reduces to the REGISTRABLE domain (eTLD+1, F3), so a.corp.com and\n   800\t      // b.corp.com collide on the same one-active-eval-per-domain slot rather than each minting one.\n   801\t      const domain = extractDomain(email);\n   802\t      if (domain === null) return json({ error: \"invalid work email\" }, 400);\n   803\t\n   804\t      // Resolve signals (may hit the network — bounded by the resolver's own per-lookup timeout),\n   805\t      // then score. A resolver failure surfaces as an `undefined` signal (uncertainty → review),\n   806\t      // never a throw here (`resolveDomainSignals` never throws) — but guard anyway.\n   807\t      let signals: DomainSignals;\n   808\t      try {\n   809\t        signals = await evalDeps.resolveSignals(domain);\n   810\t      } catch {\n   811\t        signals = {\n   812\t          mx: undefined,\n   813\t          ageDays: undefined,\n   814\t          enrichmentRisk: undefined,\n   815\t        };\n   816\t      }\n   817\t      const score = scoreApplication(email, signals, evalDeps.config);\n   818\t      const status =\n   819\t        score.decision === \"auto_approve\"\n   820\t          ? \"approved\"\n   821\t          : score.decision === \"auto_reject\"\n   822\t            ? \"rejected\"\n   823\t            : \"pending_review\";\n   824\t\n   825\t      try {\n   826\t        const created = await withAdminWrite(deps.db, (tx) =>\n   827\t          createEvalApplication(\n   828\t            tx,\n   829\t            {\n   830\t              accountId,\n   831\t              email,\n   832\t              domain,\n   833\t              entitlements,\n   834\t              status,\n   835\t              risk: score.risk,\n   836\t              reason: score.reason,\n   837\t            },\n   838\t            evalDeps.config,\n   839\t          ),\n   840\t        );\n   841\t        return json({\n   842\t          evalId: created.id,\n   843\t          decision: score.decision,\n   844\t          status: created.status,\n   845\t          risk: score.risk,\n   846\t        });\n   847\t      } catch (err) {\n   848\t        if (err instanceof ConflictError) {\n   849\t          // domain-active / global-cap — a generic non-leaking message; 409.\n   850\t          return json(\n   851\t            {\n   852\t              error:\n   853\t                err.message === \"global-cap\"\n   854\t                  ? \"evaluation capacity reached — try again later\"\n   855\t                  : \"an active evaluation already exists for this domain\",\n   856\t            },\n   857\t            409,\n   858\t          );\n   859\t        }\n   860\t        process.stderr.write(\"[service-license] eval apply failed\\n\");\n   861\t        return json({ error: \"eval application failed\" }, 500);\n   862\t      }\n   863\t    }\n   864\t\n   865\t    if (pathname === \"/eval/issue\") {\n   866\t      if (method !== \"POST\") return text(\"method not allowed\", 405);\n   867\t      const evalDeps = deps.eval;\n   868\t      if (evalDeps === null || evalDeps === undefined)\n   869\t        return json({ error: \"not found\" }, 404);\n   870\t      const limited = rateLimited(\"issue\", req, \"closed\");\n   871\t      if (limited !== null) return limited;\n   872\t      if (!authorized(req, deps.token, deps.adminToken ?? \"\"))\n   873\t        return json({ error: \"unauthorized\" }, 401);\n   874\t\n   875\t      let raw: unknown;\n   876\t      try {\n   877\t        raw = await req.json();\n   878\t      } catch {\n   879\t        return json({ error: \"invalid JSON body\" }, 400);\n   880\t      }\n   881\t      const parsed = EvalIssueBody.safeParse(raw);\n   882\t      if (!parsed.success) {\n   883\t        return json(\n   884\t          { error: \"invalid eval issue request\", issues: parsed.error.issues },\n   885\t          400,\n   886\t        );\n   887\t      }\n   888\t      const { evalId, major } = parsed.data;\n   889\t\n   890\t      // TRUST BOUNDARY: like /issue, this is a server-to-server, bearer-gated contract — evalId is\n   891\t      // trusted as-is, with no independent evalId→session/account binding check here. When a public\n   892\t      // apps/site proxy surface fronts this route, it must bind the eval to the caller's session\n   893\t      // before forwarding evalId (mirroring /issue's own documented tier-trust boundary above).\n   894\t      const application = await withAdminWrite(deps.db, (tx) =>\n   895\t        readEvalApplication(tx, evalId),\n   896\t      );\n   897\t      if (application === null) return json({ error: \"eval not found\" }, 404);\n   898\t      // Idempotent re-serve: an already-issued eval returns its stored token byte-identical.\n   899\t      if (\n   900\t        application.status === \"issued\" &&\n   901\t        application.licenseToken !== null &&\n   902\t        application.licenseId !== null\n   903\t      ) {\n   904\t        return json({\n   905\t          token: application.licenseToken,\n   906\t          licenseId: application.licenseId,\n   907\t          expiry: application.windowEnd,\n   908\t        });\n   909\t      }\n   910\t      // FAIL-CLOSED: a license is minted ONLY for an operator/auto-approved eval whose card-on-file\n   911\t      // leg validated (ADR-0280). Anything else (pending_review, rejected, revoked, expired, or\n   912\t      // approved-but-card-unvalidated) is not issuable.\n   913\t      if (application.status !== \"approved\" || !application.cardValidated) {\n   914\t        return json({ error: \"eval not issuable\" }, 409);\n   915\t      }\n   916\t\n   917\t      // Validate the eval scope against the index (fail-closed, VALIDATION only — the SIGNED\n   918\t      // entitlements are the purchased ids, never the expansion, the repo invariant). A generic 422.\n   919\t      try {\n   920\t        expandEntitlements(deps.index, application.entitlements);\n   921\t      } catch {\n   922\t        return json({ error: \"could not resolve eval entitlements\" }, 422);\n   923\t      }\n   924\t\n   925\t      const windowEnd = new Date(\n   926\t        Date.now() + evalDeps.config.windowDays * 86_400_000,\n   927\t      ).toISOString();\n   928\t      const claims = {\n   929\t        licenseId: randomUUID(),\n   930\t        tier: \"pro\" as const,\n   931\t        entitlements: [...application.entitlements].sort(),\n   932\t        major,\n   933\t        // The eval's fail-closed lever: a short signed expiry the verifier enforces offline — an\n   934\t        // expired eval degrades to the community floor everywhere, no revocation round-trip needed.\n   935\t        expiry: windowEnd,\n   936\t        // Eval licenses carry no purchased-id windows/snapshots (those are one-time-grant concepts).\n   937\t        updatesWindows: {},\n   938\t        entitledSince: {},\n   939\t        // The anti-exfiltration discriminator (ADR-0274/0280) — THIS is the ONLY signer of `eval:\n   940\t        // true` anywhere in the service; the paid /issue path above never sets this key, so paid\n   941\t        // claims stay byte-for-byte unchanged. Downstream (tarball watermarking, no-redistribution\n   942\t        // enforcement) keys off this flag rather than inferring \"is this eval\" from expiry alone.\n   943\t        eval: true as const,\n   944\t      };\n   945\t      let token: string;\n   946\t      try {\n   947\t        token = await issueLicense(deps.signer, claims);\n   948\t      } catch {\n   949\t        return json({ error: \"signing failed\" }, 500);\n   950\t      }\n   951\t\n   952\t      try {\n   953\t        // Atomically transition approved+card-validated → issued. The UPDATE's WHERE re-checks the\n   954\t        // gate, so a concurrent revoke between the read above and here fails closed (ConflictError).\n   955\t        const issued = await withAdminWrite(deps.db, (tx) =>\n   956\t          recordIssuedEval(tx, {\n   957\t            evalId,\n   958\t            licenseId: claims.licenseId,\n   959\t            licenseToken: token,\n   960\t            windowEnd,\n   961\t          }),\n   962\t        );\n   963\t        return json({\n   964\t          token,\n   965\t          licenseId: claims.licenseId,\n   966\t          expiry: issued.windowEnd,\n   967\t        });\n   968\t      } catch (err) {\n   969\t        if (err instanceof ConflictError) {\n   970\t          return json({ error: \"eval not issuable\" }, 409);\n   971\t        }\n   972\t        process.stderr.write(\"[service-license] eval issue failed\\n\");\n   973\t        return json({ error: \"eval issue failed\" }, 500);\n   974\t      }\n   975\t    }\n   976\t\n   977\t    if (pathname === \"/webhook\") {\n   978\t      // The Paddle MoR webhook destination (license.caisson.sh/webhook, ADR-0108/0116). A real purchase\n   979\t      // lands here; this route provisions it. It runs BOTH the credit grant AND the entitlement grant in\n   980\t      // ONE tenant transaction (apply-billing-event.ts) — the seam the services-hardening audit (#3)\n   981\t      // flagged as bound to no server.\n   982\t      if (method !== \"POST\") return text(\"method not allowed\", 405);\n   983\t\n   984\t      // Rate-gate FIRST: /webhook is the public grey-origin (`*.up.railway.app`) surface, so an\n   985\t      // unsigned flood (each costs an HMAC compute) is capped before any verify/DB work.\n   986\t      const limited = rateLimited(\"webhook\", req, \"open\");\n   987\t      if (limited !== null) return limited;\n   988\t\n   989\t      // Fail closed when the webhook secret is unconfigured: a null provider cannot verify ANY signature,\n   990\t      // so an unverifiable payload must be rejected, never provisioned (security floor — fail-closed auth).\n   991\t      if (deps.provider === null) return json({ error: \"unauthorized\" }, 401);\n   992\t\n   993\t      const signature = req.headers.get(\"paddle-signature\") ?? \"\";\n   994\t      // Verify against the RAW request body — a parsed + re-serialized payload would not match Paddle's\n   995\t      // `ts:rawBody` HMAC. `req.text()` reads the bytes exactly as delivered.\n   996\t      const rawBody = await req.text();\n   997\t      let result: BillingWebhookResult;\n   998\t      try {\n   999\t        // handleBillingWebhook verifies the Paddle signature (throws AuthnError on a missing/invalid one\n  1000\t        // BEFORE any DB work) then applies the domain event inside `withTenant`: a one-time\n  1001\t        // purchase.completed grants its entitlements AND any credits; a subscription invoice.paid grants\n  1002\t        // the cycle credits AND the plan's entitlements — both in one RLS-scoped transaction (ADR-0071/\n  1003\t        // 0089/0113). The grant stores are idempotent on their natural keys (payment/invoice id), so a\n  1004\t        // Paddle retry of the same event_id re-applies as a no-op (ADR-0113) — no separate event-dedupe\n  1005\t        // table needed.\n  1006\t        result = await handleBillingWebhook(\n  1007\t          deps.db,\n  1008\t          deps.provider,\n  1009\t          rawBody,\n  1010\t          signature,\n  1011\t        );\n  1012\t      } catch (err) {\n  1013\t        if (err instanceof AuthnError) {\n  1014\t          // Missing/invalid signature — fail closed, never provision (no secret or body echoed back).\n  1015\t          return json({ error: \"unauthorized\" }, 401);\n  1016\t        }\n  1017\t        // A grant-time failure (unknown price id → fail-closed throw, or a DB error) MUST return non-2xx\n  1018\t        // so Paddle RETRIES the delivery — a 2xx here would silently drop a real, paid purchase.\n  1019\t        process.stderr.write(\"[service-license] webhook processing failed\\n\");\n  1020\t        return json({ error: \"webhook processing failed\" }, 500);\n  1021\t      }\n  1022\t      // ADR-0292 — license first-mint webhook-push. AWAITED here — unlike the Discord/PostHog/email\n  1023\t      // pushes below, which stay genuinely fire-and-forget — so the purchase-confirmation email\n  1024\t      // built further down can carry the freshly-minted token in THIS SAME delivery, synchronously,\n  1025\t      // rather than racing a detached mint against an already-fired email. Still strictly\n  1026\t      // post-commit: the grant's own `withTenant` transaction already committed inside\n  1027\t      // `handleBillingWebhook` above; the mint runs its OWN separate transaction(s) via\n  1028\t      // `issueOrReuseLicense`. NEVER throws (`mintLicensePostCommit` catches everything and logs an\n  1029\t      // operator ALERT on failure) — awaiting it can only ever add a few DB round trips to the\n  1030\t      // response, never turn a durable grant into a failed webhook. Mints on a GRANT (new\n  1031\t      // entitlements) or a RENEWAL (an updates-window extension, which grants nothing but still\n  1032\t      // needs a fresh signed window) — the same two triggers stage 5 and stage 7 of the\n  1033\t      // buyer-lifecycle audit named as the P0's root cause.\n  1034\t      const licenseToken: string | null =\n  1035\t        result.event !== null &&\n  1036\t        (result.grantedEntitlements.length > 0 ||\n  1037\t          result.renewedEntitlements.length > 0)\n  1038\t          ? await mintLicensePostCommit(deps, result.event.accountId)\n  1039\t          : null;\n  1040\t      // Post-commit Discord role push (ADR-0203): DETACHED, fired only after the grant durably\n  1041\t      // landed, and OUTSIDE the grant's try/catch — a misbehaving notifier (even one throwing\n  1042\t      // synchronously) must never convert a committed grant into a 500 (which would trigger a\n  1043\t      // pointless Paddle re-delivery). `notifyDiscordGrant` itself never throws; the guards here\n  1044\t      // are belt-and-braces for injected doubles. Paddle's 2xx never waits on Discord.\n  1045\t      if (\n  1046\t        deps.discordNotify !== null &&\n  1047\t        result.event !== null &&\n  1048\t        result.grantedEntitlements.length > 0\n  1049\t      ) {\n  1050\t        const push: DiscordGrantPush = {\n  1051\t          accountId: result.event.accountId,\n  1052\t          entitlements: result.grantedEntitlements,\n  1053\t        };\n  1054\t        try {\n  1055\t          void deps.discordNotify(push).catch(() => {\n  1056\t            process.stderr.write(\n  1057\t              \"[service-license] discord notify rejected (ignored)\\n\",\n  1058\t            );\n  1059\t          });\n  1060\t        } catch {\n  1061\t          process.stderr.write(\n  1062\t            \"[service-license] discord notify threw (ignored)\\n\",\n  1063\t          );\n  1064\t        }\n  1065\t      }\n  1066\t      // Post-commit PostHog purchase capture (ADR-0237 F8): same detached contract as the Discord\n  1067\t      // push — fired only on a durable grant, never delays or fails Paddle's 2xx. Re-deliveries\n  1068\t      // short-circuit on the grant claim with an empty grant list, so a purchase captures once.\n  1069\t      // `amountTotal` narrows the event union to the money-carrying kinds (purchase/invoice).\n  1070\t      if (\n  1071\t        deps.posthogCapture !== null &&\n  1072\t        result.event !== null &&\n  1073\t        \"amountTotal\" in result.event &&\n  1074\t        result.grantedEntitlements.length > 0\n  1075\t      ) {\n  1076\t        const capture: PurchaseCapture = {\n  1077\t          accountId: result.event.accountId,\n  1078\t          entitlements: result.grantedEntitlements,\n  1079\t          amountTotalMinor: result.event.amountTotal,\n  1080\t          currency: result.event.currency,\n  1081\t          sourceEventId: result.event.sourceEventId,\n  1082\t          skuLines: result.skuLines,\n  1083\t          // G33: the SAME subscription-cycle-vs-first-purchase computation the sibling email\n  1084\t          // notice makes, further down.\n  1085\t          subscriptionCycle:\n  1086\t            result.event.type === \"invoice.paid\" &&\n  1087\t            result.event.billingReason === \"subscription_cycle\",\n  1088\t          // ADR-0320: the `amountTotal` narrowing also admits refund/chargeback, which carry\n  1089\t          // no discountId — the `in` guard keeps this compiling across the whole union.\n  1090\t          discountId:\n  1091\t            \"discountId\" in result.event\n  1092\t              ? (result.event.discountId ?? null)\n  1093\t              : null,\n  1094\t        };\n  1095\t        try {\n  1096\t          void deps.posthogCapture(capture).catch(() => {\n  1097\t            process.stderr.write(\n  1098\t              \"[service-license] posthog capture rejected (ignored)\\n\",\n  1099\t            );\n  1100\t          });\n  1101\t        } catch {\n  1102\t          process.stderr.write(\n  1103\t            \"[service-license] posthog capture threw (ignored)\\n\",\n  1104\t          );\n  1105\t        }\n  1106\t      }\n  1107\t      // Post-commit abandoned-checkout conversion capture (SPEC-abandoned-checkout-email.md §e,\n  1108\t      // 2026-07-10 lock): same detached contract as the PostHog purchase capture above, gated\n  1109\t      // identically (a granting, non-re-delivery event only) — the injected implementation itself\n  1110\t      // decides whether this account actually has a recent abandoned-checkout notice before\n  1111\t      // firing anything.\n  1112\t      if (\n  1113\t        deps.abandonedCheckoutConverted !== undefined &&\n  1114\t        deps.abandonedCheckoutConverted !== null &&\n  1115\t        result.event !== null &&\n  1116\t        result.grantedEntitlements.length > 0\n  1117\t      ) {\n  1118\t        const accountId = result.event.accountId;\n  1119\t        try {\n  1120\t          void deps.abandonedCheckoutConverted(accountId).catch(() => {\n  1121\t            process.stderr.write(\n  1122\t              \"[service-license] abandoned checkout converted capture rejected (ignored)\\n\",\n  1123\t            );\n  1124\t          });\n  1125\t        } catch {\n  1126\t          process.stderr.write(\n  1127\t            \"[service-license] abandoned checkout converted capture threw (ignored)\\n\",\n  1128\t          );\n  1129\t        }\n  1130\t      }\n  1131\t      // Post-commit purchase-confirmation email: same detached, never-throw contract as the\n  1132\t      // Discord push / PostHog capture above, gated identically (a granting, money-carrying,\n  1133\t      // non-re-delivery event only). Unlike those two, `purchaseEmailNotify` is never null\n  1134\t      // (server.ts always wires a real-or-capture `@caisson/email` transport) — the gate below is\n  1135\t      // what decides WHEN to send, not whether email is configured.\n  1136\t      //\n  1137\t      // INFO (SHIP review 2026-07-08): a credit-pack-only purchase grants no entitlement\n  1138\t      // (`grantedEntitlements` stays empty), so it never trips this gate and gets no BRANDED\n  1139\t      // receipt from Caisson. Deliberate, not a gap — Paddle is the merchant of record and already\n  1140\t      // sends its own transactional payment receipt for every charge, branded or not.\n  1141\t      if (\n  1142\t        result.event !== null &&\n  1143\t        \"amountTotal\" in result.event &&\n  1144\t        result.grantedEntitlements.length > 0\n  1145\t      ) {\n  1146\t        // distinguish a subscription-CYCLE charge from a first purchase. A Paddle\n  1147\t        // `transaction.completed` carrying a subscription_id whose subscription already granted\n  1148\t        // maps to `invoice.paid` with `billingReason: \"subscription_cycle\"` (origin\n  1149\t        // `subscription_recurring`); `subscription_create` (the first charge) and every one-time\n  1150\t        // `purchase.completed` stay first-purchase receipts. The mixed-cart rule is unaffected: a\n  1151\t        // subscription invoice is single-line by design and never carries a renewal-book line, so\n  1152\t        // this receipt always states its own grand total.\n  1153\t        const notice: PurchaseEmailNotice = {\n  1154\t          accountId: result.event.accountId,\n  1155\t          orderId: result.event.sourceEventId,\n  1156\t          currency: result.event.currency,\n  1157\t          amountTotalMinor: result.event.amountTotal,\n  1158\t          lines: result.skuLines.map((line) => ({\n  1159\t            productSlug: line.productSlug,\n  1160\t          })),\n  1161\t          subscriptionCycle:\n  1162\t            result.event.type === \"invoice.paid\" &&\n  1163\t            result.event.billingReason === \"subscription_cycle\",\n  1164\t          // ADR-0292: the already-awaited first-mint result rides along when it succeeded. A mint\n  1165\t          // failure (`null`, already logged as an operator ALERT) sends the receipt WITHOUT a token\n  1166\t          // rather than not sending at all — a missing license is recoverable (the next event, or\n  1167\t          // the admin first-mint lever); a missing receipt is not.\n  1168\t          ...(licenseToken !== null ? { licenseToken } : {}),\n  1169\t        };\n  1170\t        try {\n  1171\t          void deps.purchaseEmailNotify(notice).catch(() => {\n  1172\t            process.stderr.write(\n  1173\t              \"[service-license] purchase confirmation email rejected (ignored)\\n\",\n  1174\t            );\n  1175\t          });\n  1176\t        } catch {\n  1177\t          process.stderr.write(\n  1178\t            \"[service-license] purchase confirmation email threw (ignored)\\n\",\n  1179\t          );\n  1180\t        }\n  1181\t      }\n  1182\t      // Post-commit renewal-confirmation email (ADR-0251): the SIBLING send for a RENEWAL_BOOK\n  1183\t      // line, which grants nothing so it never trips the `grantedEntitlements.length > 0` gate\n  1184\t      // above. Same detached, never-throw contract, gated on `renewedEntitlements` instead. A\n  1185\t      // mixed cart (a purchase line + a renewal line in one event) fires BOTH emails — the\n  1186\t      // purchase receipt states the whole-event total, so THIS notice omits it (two emails each\n  1187\t      // claiming the full cart total would read as a double charge).\n  1188\t      if (\n  1189\t        result.event !== null &&\n  1190\t        \"amountTotal\" in result.event &&\n  1191\t        result.renewedEntitlements.length > 0\n  1192\t      ) {\n  1193\t        const notice: RenewalEmailNotice = {\n  1194\t          accountId: result.event.accountId,\n  1195\t          orderId: result.event.sourceEventId,\n  1196\t          currency: result.event.currency,\n  1197\t          amountTotalMinor:\n  1198\t            result.grantedEntitlements.length > 0\n  1199\t              ? undefined\n  1200\t              : result.event.amountTotal,\n  1201\t          lines: result.renewedEntitlements.map((r) => ({\n  1202\t            entitlementId: r.entitlementId,\n  1203\t            newWindowEnd: r.newWindowEnd,\n  1204\t          })),\n  1205\t        };\n  1206\t        try {\n  1207\t          void deps.renewalEmailNotify(notice).catch(() => {\n  1208\t            process.stderr.write(\n  1209\t              \"[service-license] renewal confirmation email rejected (ignored)\\n\",\n  1210\t            );\n  1211\t          });\n  1212\t        } catch {\n  1213\t          process.stderr.write(\n  1214\t            \"[service-license] renewal confirmation email threw (ignored)\\n\",\n  1215\t          );\n  1216\t        }\n  1217\t      }\n  1218\t      // Post-commit revoke/refund notice (G27): same detached, never-throw contract as every\n  1219\t      // push above, gated on `revokeNotices` — populated ONLY when `applyBillingEvent` actually\n  1220\t      // revoked an active grant this delivery (a redelivery or a Resend of an already-revoked\n  1221\t      // purchase revokes nothing further, so this stays empty with no separate idempotency gate).\n  1222\t      for (const revoke of result.revokeNotices) {\n  1223\t        try {\n  1224\t          void deps.revokeEmailNotify(revoke).catch(() => {\n  1225\t            process.stderr.write(\n  1226\t              \"[service-license] revoke notice email rejected (ignored)\\n\",\n  1227\t            );\n  1228\t          });\n  1229\t        } catch {\n  1230\t          process.stderr.write(\n  1231\t            \"[service-license] revoke notice email threw (ignored)\\n\",\n  1232\t          );\n  1233\t        }\n  1234\t      }\n  1235\t      // Post-commit chargeback/dispute operator alert (ADR-0294): same detached, never-throw\n  1236\t      // contract as every push above, gated on `chargebackAlerts` (populated ONLY by the\n  1237\t      // ALERT-ONLY `chargeback.detected` case in apply-billing-event.ts — no grant/revoke/claw\n  1238\t      // runs for it). `deps.chargebackAlert` is never `null` (server.ts always wires it; the\n  1239\t      // stderr ALERT floor fires even with no Discord layer configured).\n  1240\t      for (const alert of result.chargebackAlerts) {\n  1241\t        try {\n  1242\t          void deps.chargebackAlert(alert).catch(() => {\n  1243\t            process.stderr.write(\n  1244\t              \"[service-license] chargeback alert rejected (ignored)\\n\",\n  1245\t            );\n  1246\t          });\n  1247\t        } catch {\n  1248\t          process.stderr.write(\n  1249\t            \"[service-license] chargeback alert threw (ignored)\\n\",\n  1250\t          );\n  1251\t        }\n  1252\t      }\n  1253\t      // 2xx ONLY after the grant commits, so Paddle stops retrying only on a durable success.\n  1254\t      return json({ ok: true });\n  1255\t    }\n  1256\t\n  1257\t    return json({ error: \"not found\" }, 404);\n  1258\t  });\n  1259\t}\n","exit_code":0,"status":"completed"}}
