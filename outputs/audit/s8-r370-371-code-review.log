{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba scripts/release-readiness.test.ts'","aggregated_output":"     1\t// Guards the required-check SET itself, not any one gate's logic. REQUIRED_CHECKS is a bare string\n     2\t// list that release-readiness.ts compares against the GitHub check-runs API: a name here that no\n     3\t// workflow defines makes every release \"missing\" that check forever, and a job here that can be\n     4\t// skipped reds readiness on every release whose diff happened not to reach it. Both failures are\n     5\t// silent until a release is already in flight, which is the wrong time to find out.\n     6\t//\n     7\t// Parsed with Bun.YAML, not regex. A first pass matched job KEYS with `^ {2}<name>:` and grepped\n     8\t// for a 4-space `paths:`; the SHIP review defeated it three ways that this repo could plausibly\n     9\t// produce — a `needs: changes` + `if: needs.changes.outputs.x` gate (quality.yml already has that\n    10\t// `changes` job), a `paths:` at 6-space indent under a nested `on:`, and flow-style\n    11\t// `push: { paths: [...] }`. A text heuristic over YAML is the wrong tool when a parser is in hand.\n    12\timport {\n    13\t  mkdtempSync,\n    14\t  mkdirSync,\n    15\t  readdirSync,\n    16\t  readFileSync,\n    17\t  rmSync,\n    18\t  writeFileSync,\n    19\t} from \"node:fs\";\n    20\timport { tmpdir } from \"node:os\";\n    21\timport { execFileSync, spawnSync } from \"node:child_process\";\n    22\timport { dirname, join } from \"node:path\";\n    23\t\n    24\timport { afterAll, describe, expect, test } from \"bun:test\";\n    25\t\n    26\timport {\n    27\t  auditArtifactIsValid,\n    28\t  auditSuccessorIsValid,\n    29\t  ATTESTATION_ONLY_PATHS,\n    30\t  REQUIRED_CHECKS,\n    31\t} from \"./release-readiness.ts\";\n    32\t\n    33\tdescribe(\"R4 audit attestation\", () => {\n    34\t  const dir = mkdtempSync(join(tmpdir(), \"caisson-r4-\"));\n    35\t  afterAll(() => rmSync(dir, { recursive: true, force: true }));\n    36\t  function git(repo: string, ...args: string[]): string {\n    37\t    return execFileSync(\"git\", args, {\n    38\t      cwd: repo,\n    39\t      env: {\n    40\t        ...process.env,\n    41\t        GIT_CONFIG_GLOBAL: \"/dev/null\",\n    42\t        GIT_CONFIG_NOSYSTEM: \"1\",\n    43\t      },\n    44\t      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    45\t    })\n    46\t      .toString()\n    47\t      .trim();\n    48\t  }\n    49\t  function scratch(): string {\n    50\t    const repo = mkdtempSync(join(dir, \"repo-\"));\n    51\t    git(repo, \"init\", \"--quiet\");\n    52\t    git(repo, \"config\", \"user.name\", \"R4 lifecycle fixture\");\n    53\t    git(repo, \"config\", \"user.email\", \"r4@example.invalid\");\n    54\t    writeFileSync(join(repo, \"product.ts\"), \"export const version = 1;\\n\");\n    55\t    commit(repo);\n    56\t    git(repo, \"tag\", \"v2026.08.18\");\n    57\t    writeFileSync(join(repo, \"product.ts\"), \"export const version = 2;\\n\");\n    58\t    commit(repo);\n    59\t    return repo;\n    60\t  }\n    61\t  function commit(repo: string): string {\n    62\t    git(repo, \"add\", \".\");\n    63\t    git(repo, \"commit\", \"--quiet\", \"-m\", \"test: lifecycle fixture\");\n    64\t    return git(repo, \"rev-parse\", \"HEAD\");\n    65\t  }\n    66\t  const fixtureRepo = scratch();\n    67\t  const binding = {\n    68\t    base: \"v2026.08.18\",\n    69\t    tag: \"v2026.09.16\",\n    70\t    reviewed_sha: git(fixtureRepo, \"rev-parse\", \"HEAD\"),\n    71\t  };\n    72\t  const clean = {\n    73\t    schema_version: 2,\n    74\t    ...binding,\n    75\t    status: \"clean\",\n    76\t    critical: 0,\n    77\t    reviewed_scope: [\"scripts/release-readiness.ts\"],\n    78\t    reviewers: [\n    79\t      {\n    80\t        role: \"code_review\",\n    81\t        identity: \"gw-code-reviewer\",\n    82\t        reviewed_at: \"2026-09-16T02:37:11Z\",\n    83\t      },\n    84\t      {\n    85\t        role: \"security_audit\",\n    86\t        identity: \"gw-security-auditor\",\n    87\t        reviewed_at: \"2026-09-16T02:37:11Z\",\n    88\t      },\n    89\t    ],\n    90\t  };\n    91\t  function fixture(text: string): string {\n    92\t    const path = join(dir, `${crypto.randomUUID()}.md`);\n    93\t    writeFileSync(path, text);\n    94\t    return path;\n    95\t  }\n    96\t  const document = (value: unknown) =>\n    97\t    `---\\n${JSON.stringify(value)}\\n---\\n# Audit\\n`;\n    98\t\n    99\t  function attestation(repo: string, reviewedSha: string): void {\n   100\t    mkdirSync(join(repo, \"outputs/audit\"), { recursive: true });\n   101\t    mkdirSync(join(repo, \"docs/releases\"), { recursive: true });\n   102\t    writeFileSync(\n   103\t      join(repo, `outputs/audit/release-audit-${binding.tag}.md`),\n   104\t      document({ ...clean, reviewed_sha: reviewedSha }),\n   105\t    );\n   106\t    writeFileSync(\n   107\t      join(repo, `docs/releases/${binding.tag}-checklist.md`),\n   108\t      \"- [x] fixture\\n\",\n   109\t    );\n   110\t  }\n   111\t\n   112\t  test(\"R4 real Git lifecycle accepts review A then attestation-only B\", () => {\n   113\t    const repo = scratch();\n   114\t    const a = git(repo, \"rev-parse\", \"HEAD\");\n   115\t    attestation(repo, a);\n   116\t    const b = commit(repo);\n   117\t    expect(a).not.toBe(b);\n   118\t    expect(auditSuccessorIsValid(repo, binding.tag, b)).toBe(true);\n   119\t    // Working-tree tampering cannot replace the committed attestation.\n   120\t    attestation(repo, git(repo, \"rev-parse\", \"HEAD^\"));\n   121\t    writeFileSync(\n   122\t      join(repo, `outputs/audit/release-audit-${binding.tag}.md`),\n   123\t      \"invalid\",\n   124\t    );\n   125\t    expect(auditSuccessorIsValid(repo, binding.tag, b)).toBe(true);\n   126\t  });\n   127\t  test.each([\n   128\t    \"product.ts\",\n   129\t    \"outputs/audit/unreviewed.md\",\n   130\t    \"docs/releases/other-checklist.md\",\n   131\t    \" outputs/audit/other.md\",\n   132\t  ])(\"R4 real Git lifecycle rejects unreviewed successor path %s\", (path) => {\n   133\t    const repo = scratch();\n   134\t    const a = git(repo, \"rev-parse\", \"HEAD\");\n   135\t    attestation(repo, a);\n   136\t    mkdirSync(dirname(join(repo, path)), { recursive: true });\n   137\t    writeFileSync(join(repo, path), \"unreviewed product or policy byte\\n\");\n   138\t    const b = commit(repo);\n   139\t    expect(auditSuccessorIsValid(repo, binding.tag, b)).toBe(false);\n   140\t  });\n   141\t  test(\"R4 real Git lifecycle rejects an audit naming C instead of parent A\", () => {\n   142\t    const repo = scratch();\n   143\t    const a = git(repo, \"rev-parse\", \"HEAD\");\n   144\t    // C is a real distinct existing commit, not an invented forty-character fixture.\n   145\t    const c = git(repo, \"rev-parse\", `${a}^`);\n   146\t    attestation(repo, c);\n   147\t    const b = commit(repo);\n   148\t    expect(auditSuccessorIsValid(repo, binding.tag, b)).toBe(false);\n   149\t  });\n   150\t  test(\"R4 attestation allowlist names exactly the audit and checklist\", () => {\n   151\t    expect(ATTESTATION_ONLY_PATHS).toEqual([\n   152\t      \"outputs/audit/release-audit-{tag}.md\",\n   153\t      \"docs/releases/{tag}-checklist.md\",\n   154\t    ]);\n   155\t  });\n   156\t\n   157\t  test(\"R4 rejects an existing empty audit instead of accepting its filename\", () => {\n   158\t    expect(auditArtifactIsValid(fixture(\"\"), binding)).toBe(false);\n   159\t  });\n   160\t  test(\"R4 accepts a clean audit bound to the exact base, tag and reviewed parent SHA\", () => {\n   161\t    expect(auditArtifactIsValid(fixture(document(clean)), binding)).toBe(true);\n   162\t  });\n   163\t  test.each([\n   164\t    [\"failed verdict\", { status: \"issues_found\" }],\n   165\t    [\"blocking finding\", { critical: 1 }],\n   166\t    [\"wrong SHA\", { reviewed_sha: git(fixtureRepo, \"rev-parse\", \"HEAD^\") }],\n   167\t    [\"wrong base\", { base: \"v2026.07.30\" }],\n   168\t    [\"wrong tag\", { tag: \"v2026.09.17\" }],\n   169\t    [\"empty scope\", { reviewed_scope: [] }],\n   170\t    [\"blank scope\", { reviewed_scope: [\"  \"] }],\n   171\t    [\"no reviewers\", { reviewers: [] }],\n   172\t    [\n   173\t      \"duplicate roles\",\n   174\t      { reviewers: [clean.reviewers[0], clean.reviewers[0]] },\n   175\t    ],\n   176\t    [\n   177\t      \"blank identity\",\n   178\t      {\n   179\t        reviewers: [\n   180\t          { ...clean.reviewers[0], identity: \" \" },\n   181\t          clean.reviewers[1],\n   182\t        ],\n   183\t      },\n   184\t    ],\n   185\t    [\n   186\t      \"invalid timestamp\",\n   187\t      {\n   188\t        reviewers: [\n   189\t          { ...clean.reviewers[0], reviewed_at: \"yesterday\" },\n   190\t          clean.reviewers[1],\n   191\t        ],\n   192\t      },\n   193\t    ],\n   194\t    [\"unknown metadata\", { bypass: true }],\n   195\t  ] as const)(\"R4 rejects %s\", (_label, patch) => {\n   196\t    expect(\n   197\t      auditArtifactIsValid(fixture(document({ ...clean, ...patch })), binding),\n   198\t    ).toBe(false);\n   199\t  });\n   200\t  test(\"R4 fails closed for absent, malformed and prose-only artifacts\", () => {\n   201\t    expect(auditArtifactIsValid(join(dir, \"absent.md\"), binding)).toBe(false);\n   202\t    expect(auditArtifactIsValid(fixture(\"---\\n[invalid\\n---\\n\"), binding)).toBe(\n   203\t      false,\n   204\t    );\n   205\t    expect(\n   206\t      auditArtifactIsValid(fixture(\"Reviewed and approved\"), binding),\n   207\t    ).toBe(false);\n   208\t  });\n   209\t});\n   210\t\n   211\tconst WORKFLOWS_DIR = join(import.meta.dir, \"..\", \".github\", \"workflows\");\n   212\t\n   213\t/** The ONE `if:` a required job may carry — the CAISSON-96 draft guard, per ci.yml's header. */\n   214\tconst DRAFT_GUARD =\n   215\t  \"github.event_name != 'pull_request' || github.event.pull_request.draft == false\";\n   216\t\n   217\tinterface Job {\n   218\t  name?: string;\n   219\t  if?: string;\n   220\t  needs?: string | string[];\n   221\t  \"continue-on-error\"?: boolean;\n   222\t  steps?: {\n   223\t    name?: string;\n   224\t    run?: string;\n   225\t    env?: Record<string, string>;\n   226\t    if?: string;\n   227\t    \"continue-on-error\"?: boolean;\n   228\t  }[];\n   229\t}\n   230\tinterface Trigger {\n   231\t  paths?: string[];\n   232\t  \"paths-ignore\"?: string[];\n   233\t}\n   234\tinterface Workflow {\n   235\t  on?: Record<string, Trigger | null>;\n   236\t  true?: Record<string, Trigger | null>; // YAML 1.1: a bare `on:` key parses as boolean true\n   237\t  jobs?: Record<string, Job>;\n   238\t}\n   239\t\n   240\tinterface Found {\n   241\t  file: string;\n   242\t  key: string;\n   243\t  job: Job;\n   244\t  triggers: Record<string, Trigger | null>;\n   245\t}\n   246\t\n   247\t/** Parse every workflow once, and index by the check-run NAME each job reports under — which is\n   248\t *  `name:` when present and the job key otherwise. release-readiness.ts matches on that reported\n   249\t *  name, so indexing by job key alone would go green while every release reported it missing. */\n   250\tconst unparsable: string[] = [];\n   251\t\n   252\tfunction jobsByReportedName(): Map<string, Found> {\n   253\t  const found = new Map<string, Found>();\n   254\t  for (const file of readdirSync(WORKFLOWS_DIR).filter(\n   255\t    (f) => f.endsWith(\".yml\") || f.endsWith(\".yaml\"),\n   256\t  )) {\n   257\t    let wf: Workflow;\n   258\t    try {\n   259\t      wf = Bun.YAML.parse(\n   260\t        readFileSync(join(WORKFLOWS_DIR, file), \"utf8\"),\n   261\t      ) as Workflow;\n   262\t    } catch (err) {\n   263\t      // Collected, not thrown. A parse error at module scope takes the whole suite down as\n   264\t      // \"0 pass / 0 fail\" — technically non-zero, but it reads as \"no tests ran\" rather than\n   265\t      // \"this workflow is malformed\", and it hides every other check in this file.\n   266\t      unparsable.push(`${file}: ${String(err)}`);\n   267\t      continue;\n   268\t    }\n   269\t    const triggers = wf.on ?? wf.true ?? {};\n   270\t    for (const [key, job] of Object.entries(wf.jobs ?? {})) {\n   271\t      found.set(job.name ?? key, { file, key, job, triggers });\n   272\t    }\n   273\t  }\n   274\t  return found;\n   275\t}\n   276\t\n   277\tdescribe(\"REQUIRED_CHECKS — the release-readiness gate's own input\", () => {\n   278\t  const byName = jobsByReportedName();\n   279\t\n   280\t  test(\"every workflow file parses — a throw here would blank the whole suite\", () => {\n   281\t    expect(unparsable).toEqual([]);\n   282\t  });\n   283\t\n   284\t  test(\"the set is non-empty, deduplicated, and at full strength\", () => {\n   285\t    // Guard the guard: a floor below the real size lets one silently drop out.\n   286\t    expect(REQUIRED_CHECKS.length).toBeGreaterThanOrEqual(7);\n   287\t    expect(new Set(REQUIRED_CHECKS).size).toBe(REQUIRED_CHECKS.length);\n   288\t    // And the parse itself must have found something, or every check below is vacuous.\n   289\t    expect(byName.size).toBeGreaterThan(10);\n   290\t  });\n   291\t\n   292\t  test(\"every required check is a job some workflow actually reports under that name\", () => {\n   293\t    expect(REQUIRED_CHECKS.filter((name) => !byName.has(name))).toEqual([]);\n   294\t  });\n   295\t\n   296\t  test(\"no required check is path-scoped — a skipped check never reports and reads as missing\", () => {\n   297\t    // ci.yml's header states the rule from the PR side (a path-skipped required job never reports\n   298\t    // and the PR blocks forever); release-readiness.ts enforces it from the release side, where a\n   299\t    // check with zero runs lands in `missing`. Same constraint, both directions.\n   300\t    const scoped = REQUIRED_CHECKS.flatMap((name) => {\n   301\t      const hit = byName.get(name);\n   302\t      if (!hit) return [];\n   303\t      return Object.entries(hit.triggers)\n   304\t        .filter(([, t]) => t?.paths ?? t?.[\"paths-ignore\"])\n   305\t        .map(([event]) => `${name} (${hit.file}, on.${event})`);\n   306\t    });\n   307\t    expect(scoped).toEqual([]);\n   308\t  });\n   309\t\n   310\t  test(\"no required check is conditionally skippable — only the CAISSON-96 draft guard is allowed\", () => {\n   311\t    // The other way a required job silently stops reporting: a job-level `if:` or a `needs:` on a\n   312\t    // path-filter job. quality.yml already has a `changes` job of exactly that shape, so this is a\n   313\t    // pattern the repo can produce, not a hypothetical.\n   314\t    const conditional = REQUIRED_CHECKS.flatMap((name) => {\n   315\t      // The fail-closed aggregate is tested structurally and behaviorally below.\n   316\t      if (name === \"runtime-images-gate\") return [];\n   317\t      const hit = byName.get(name);\n   318\t      if (!hit) return [];\n   319\t      const reasons: string[] = [];\n   320\t      if (hit.job.if !== undefined && hit.job.if.trim() !== DRAFT_GUARD) {\n   321\t        reasons.push(`if: ${hit.job.if}`);\n   322\t      }\n   323\t      if (hit.job.needs !== undefined) {\n   324\t        reasons.push(`needs: ${String(hit.job.needs)}`);\n   325\t      }\n   326\t      return reasons.map((r) => `${name} (${hit.file}) — ${r}`);\n   327\t    });\n   328\t    expect(conditional).toEqual([]);\n   329\t  });\n   330\t\n   331\t  test(\"support-bot is in the set — ADR-0414 promoted it before automating its deploy\", () => {\n   332\t    // Pinned by name, not just by the structural rules above: the promotion is the whole reason\n   333\t    // deploy-railway.yml is allowed to ship this service automatically. Dropping it back to\n   334\t    // advisory silently restores \"a red bot deploys anyway\", which no structural check would catch.\n   335\t    expect(REQUIRED_CHECKS).toContain(\"support-bot\");\n   336\t    expect(byName.get(\"support-bot\")?.file).toBe(\"support-bot.yml\");\n   337\t  });\n   338\t\n   339\t  test(\"runtime images aggregate is required by release readiness\", () => {\n   340\t    expect(REQUIRED_CHECKS).toContain(\"runtime-images-gate\");\n   341\t  });\n   342\t\n   343\t  test(\"runtime aggregate always consumes the selector and complete matrix\", () => {\n   344\t    const hit = byName.get(\"runtime-images-gate\");\n   345\t    expect(hit?.file).toBe(\"security-scan.yml\");\n   346\t    expect(hit?.job.if).toBe(\"always()\");\n   347\t    expect(hit?.job.needs).toEqual([\"runtime-select\", \"runtime-images\"]);\n   348\t    expect(hit?.job[\"continue-on-error\"]).not.toBe(true);\n   349\t    expect(hit?.job.steps).toHaveLength(1);\n   350\t    const step = hit?.job.steps?.[0];\n   351\t    expect(step?.if).toBeUndefined();\n   352\t    expect(step?.[\"continue-on-error\"]).not.toBe(true);\n   353\t    expect(step?.env).toEqual({\n   354\t      SELECT_RESULT: \"${{ needs.runtime-select.result }}\",\n   355\t      MATRIX_RESULT: \"${{ needs.runtime-images.result }}\",\n   356\t    });\n   357\t  });\n   358\t\n   359\t  function aggregate(select: string, matrix: string): number | null {\n   360\t    const script = byName.get(\"runtime-images-gate\")?.job.steps?.[0]?.run;\n   361\t    if (!script) throw new Error(\"runtime aggregate script missing\");\n   362\t    // Execute the actual workflow gate with synthetic outcomes; no scanners or credentials.\n   363\t    return spawnSync(\"bash\", [\"-c\", script], {\n   364\t      env: {\n   365\t        PATH: process.env.PATH,\n   366\t        SELECT_RESULT: select,\n   367\t        MATRIX_RESULT: matrix,\n   368\t      },\n   369\t    }).status;\n   370\t  }\n   371\t\n   372\t  test(\"runtime aggregate rejects a failed matrix member\", () => {\n   373\t    expect(aggregate(\"success\", \"failure\")).toBe(1);\n   374\t  });\n   375\t\n   376\t  test(\"runtime aggregate is green only when both dependencies succeed\", () => {\n   377\t    for (const select of [\"success\", \"failure\", \"cancelled\", \"skipped\", \"\"]) {\n   378\t      for (const matrix of [\"success\", \"failure\", \"cancelled\", \"skipped\", \"\"]) {\n   379\t        expect(aggregate(select, matrix)).toBe(\n   380\t          select === \"success\" && matrix === \"success\" ? 0 : 1,\n   381\t        );\n   382\t      }\n   383\t    }\n   384\t  });\n   385\t});\n","exit_code":0,"status":"completed"}}
