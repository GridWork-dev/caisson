{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/auth/src/membership.ts'","aggregated_output":"     1\t// Account membership resolution + authz (ADR-0176). Everything below the session layer already keys\n     2\t// on the opaque `account_id`; this module is the identity→account indirection that was 1:1 (personal)\n     3\t// and is now many-to-many (org). Pure selection logic + RLS-scoped stores over `account_member`\n     4\t// (schema.ts). No schema change anywhere else — withTenant/RLS/entitlements/licenses are untouched.\n     5\t//\n     6\t// SCOPE (ADR-0257 §1.3): this file keeps only the login-critical SESSION-RESOLUTION half\n     7\t// (`resolveUserAccounts` / `ensurePersonalAccount` / `selectActiveAccount`) — it runs on every buyer\n     8\t// login (apps/site getSession), so it stays in the open Apache-2.0 substrate. The owner-gated MANAGE\n     9\t// half (`listAccountMembers` / `addAccountMember` / `assertCanManageMembers`) moved to the commercial\n    10\t// `@caisson/org-controls`, which re-uses `AccountMembership` + `Role` from here.\n    11\timport { withTenant, withUser, type Transactor } from \"@caisson/tenancy-rls\";\n    12\t\n    13\timport type { Role } from \"./session.ts\";\n    14\t\n    15\texport interface AccountMembership {\n    16\t  accountId: string;\n    17\t  userId: string;\n    18\t  role: Role;\n    19\t}\n    20\t\n    21\tinterface MemberRow {\n    22\t  account_id: string;\n    23\t  user_id: string;\n    24\t  role: string;\n    25\t}\n    26\t\n    27\tfunction toMembership(r: MemberRow): AccountMembership {\n    28\t  // `role` is DB-constrained to owner|seat (schema.ts CHECK), so the cast is sound.\n    29\t  return { accountId: r.account_id, userId: r.user_id, role: r.role as Role };\n    30\t}\n    31\t\n    32\t/**\n    33\t * Every account a signed-in user belongs to (the login-resolution path — user-scoped RLS via\n    34\t * `withUser`, so a user reads ONLY their own memberships). Ordered oldest-first (personal account,\n    35\t * created at first sign-in, sorts first).\n    36\t */\n    37\texport async function resolveUserAccounts(\n    38\t  db: Transactor,\n    39\t  userId: string,\n    40\t): Promise<AccountMembership[]> {\n    41\t  return withUser(db, userId, async (tx) => {\n    42\t    const { rows } = await tx.query<MemberRow>(\n    43\t      `SELECT account_id, user_id, role FROM account_member WHERE user_id = $1 ORDER BY created_at`,\n    44\t      [userId],\n    45\t    );\n    46\t    return rows.map(toMembership);\n    47\t  });\n    48\t}\n    49\t\n    50\t/**\n    51\t * Guarantee a user has at least a personal account (account_id == user_id, role owner) — created on\n    52\t * first sign-in so an existing single-user tenant keeps working unchanged. Idempotent. Runs\n    53\t * account-scoped (withTenant on the user's own id) so the WITH CHECK is satisfied.\n    54\t */\n    55\texport async function ensurePersonalAccount(\n    56\t  db: Transactor,\n    57\t  userId: string,\n    58\t): Promise<void> {\n    59\t  await withTenant(db, userId, async (tx) => {\n    60\t    await tx.query(\n    61\t      `INSERT INTO account_member (account_id, user_id, role)\n    62\t       VALUES ($1, $1, 'owner') ON CONFLICT DO NOTHING`,\n    63\t      [userId],\n    64\t    );\n    65\t  });\n    66\t}\n    67\t\n    68\t/**\n    69\t * Pure: pick the active account from a user's memberships + an optional requested id (from a signed\n    70\t * active-account cookie/claim). Falls back to the personal account (account_id == user_id), else the\n    71\t * first (oldest) membership. `null` only when the user has no memberships.\n    72\t */\n    73\texport function selectActiveAccount(\n    74\t  memberships: readonly AccountMembership[],\n    75\t  requestedAccountId?: string,\n    76\t): AccountMembership | null {\n    77\t  if (memberships.length === 0) return null;\n    78\t  if (requestedAccountId !== undefined) {\n    79\t    const match = memberships.find((m) => m.accountId === requestedAccountId);\n    80\t    if (match) return match;\n    81\t  }\n    82\t  // length>0 is guaranteed above, but noUncheckedIndexedAccess types memberships[0] as possibly\n    83\t  // undefined — the trailing `?? null` satisfies the AccountMembership | null return.\n    84\t  return (\n    85\t    memberships.find((m) => m.accountId === m.userId) ?? memberships[0] ?? null\n    86\t  );\n    87\t}\n","exit_code":0,"status":"completed"}}
