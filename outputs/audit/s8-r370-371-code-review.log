{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/usr/bin/bash -lc 'rg -n \"function selectActiveAccount|selectActiveAccount\" packages/auth apps/site/lib/auth.ts'","aggregated_output":"apps/site/lib/auth.ts:19:  selectActiveAccount,\napps/site/lib/auth.ts:27: *  `getSession` should resolve to. Read-only signal, never a trust boundary — `selectActiveAccount`\napps/site/lib/auth.ts:86:  const active = selectActiveAccount(memberships, requestedAccountId);\napps/site/lib/auth.ts:125:    const active = selectActiveAccount(memberships, requestedAccountId);\npackages/auth/src/membership.ts:7:// (`resolveUserAccounts` / `ensurePersonalAccount` / `selectActiveAccount`) — it runs on every buyer\npackages/auth/src/membership.ts:73:export function selectActiveAccount(\npackages/auth/src/index.ts:11:  selectActiveAccount,\npackages/auth/src/membership.integration.test.ts:4:// / `selectActiveAccount`) — never the carved MANAGE surface — and every assertion is the exact\npackages/auth/src/membership.integration.test.ts:24:  selectActiveAccount,\npackages/auth/src/membership.integration.test.ts:68:    const active = selectActiveAccount(memberships);\npackages/auth/src/membership.integration.test.ts:84:  test(\"selectActiveAccount: a valid requested account wins\", () => {\npackages/auth/src/membership.integration.test.ts:86:    expect(selectActiveAccount(ms, \"org_1\")?.accountId).toBe(\"org_1\");\npackages/auth/src/membership.integration.test.ts:89:  test(\"selectActiveAccount: defaults to the personal account\", () => {\npackages/auth/src/membership.integration.test.ts:91:    expect(selectActiveAccount(ms)?.accountId).toBe(\"user_a\");\npackages/auth/src/membership.integration.test.ts:94:  test(\"selectActiveAccount: falls back to the first membership\", () => {\npackages/auth/src/membership.integration.test.ts:96:    expect(selectActiveAccount(ms, \"nope\")?.accountId).toBe(\"org_1\");\npackages/auth/src/membership.integration.test.ts:99:  test(\"selectActiveAccount: null when the user has no memberships\", () => {\npackages/auth/src/membership.integration.test.ts:100:    expect(selectActiveAccount([])).toBeNull();\npackages/auth/CHANGELOG.md:133:    (`resolveUserAccounts` / `ensurePersonalAccount` / `selectActiveAccount`) STAYS in open\npackages/auth/AGENTS.md:16:  `selectActiveAccount(memberships, requestedAccountId?)` / `listAccountMembers(db, accountId)` /\n","exit_code":0,"status":"completed"}}
