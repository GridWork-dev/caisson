{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/tool-exec/src/approval.ts'","aggregated_output":"     1\t// ADR-0423: server-owned records bind an external approval round-trip to immutable input.\n     2\t// A digest is not authentication of an untrusted store: adapters must keep this store private.\n     3\timport { createHash, timingSafeEqual } from \"node:crypto\";\n     4\timport { z } from \"zod\";\n     5\timport type { CommandSpec } from \"./propose.ts\";\n     6\t\n     7\t/** ADR-0427: pending approvals expire fifteen minutes after issuance, without renewal. */\n     8\texport const APPROVAL_TTL_MS = 15 * 60 * 1000;\n     9\t\n    10\texport const toolApprovalSchema = z\n    11\t  .object({\n    12\t    approvalId: z.uuid(),\n    13\t    expiresAt: z.number().int().nonnegative().safe(),\n    14\t    digest: z.string().regex(/^[a-f0-9]{64}$/),\n    15\t    policyVersion: z.string().min(1).max(200),\n    16\t    name: z.string().min(1).max(256),\n    17\t    command: z.string().min(1).max(4096),\n    18\t    args: z.array(z.string().max(32768)).max(256),\n    19\t    reason: z.string().max(4000).optional(),\n    20\t  })\n    21\t  .strict();\n    22\t\n    23\texport type ToolApproval = z.infer<typeof toolApprovalSchema>;\n    24\texport interface StoredToolApproval {\n    25\t  readonly proposal: ToolApproval;\n    26\t  /** Original input is retained to re-run object-to-argv transforms against the current schema. */\n    27\t  readonly input: unknown;\n    28\t  readonly policyFingerprint: string;\n    29\t}\n    30\t\n    31\texport interface ToolApprovalStore {\n    32\t  /** Create only: reject duplicate IDs. Do not expose this method to an approval client. */\n    33\t  put(record: StoredToolApproval): Promise<void>;\n    34\t  /** Atomically get-and-delete; missing/already consumed IDs return undefined. */\n    35\t  consume(approvalId: string): Promise<StoredToolApproval | undefined>;\n    36\t  /** Atomically delete without returning an executable record; true only when pending. */\n    37\t  reject(approvalId: string): Promise<boolean>;\n    38\t}\n    39\t\n    40\t/** Durable adapters must enforce expiry and mutually atomic consume/reject themselves. */\n    41\texport function createMemoryApprovalStore(\n    42\t  now: () => number = Date.now,\n    43\t): ToolApprovalStore {\n    44\t  const records = new Map<string, StoredToolApproval>();\n    45\t  const pruneExpired = () => {\n    46\t    const at = now();\n    47\t    for (const [id, record] of records) {\n    48\t      if (at >= record.proposal.expiresAt) records.delete(id);\n    49\t    }\n    50\t  };\n    51\t  return {\n    52\t    async put(record) {\n    53\t      pruneExpired();\n    54\t      if (now() >= record.proposal.expiresAt)\n    55\t        throw new Error(\"Approval already expired\");\n    56\t      const id = record.proposal.approvalId;\n    57\t      if (records.has(id) || records.size >= 1000) {\n    58\t        throw new Error(\n    59\t          \"Approval store refused duplicate or excess pending record\",\n    60\t        );\n    61\t      }\n    62\t      records.set(id, structuredClone(record));\n    63\t    },\n    64\t    async consume(id) {\n    65\t      const record = records.get(id);\n    66\t      records.delete(id); // Before yielding: concurrent executions have at most one winner.\n    67\t      return record && now() < record.proposal.expiresAt ? record : undefined;\n    68\t    },\n    69\t    async reject(id) {\n    70\t      pruneExpired();\n    71\t      return records.delete(id); // Competes atomically with consume; never spawns.\n    72\t    },\n    73\t  };\n    74\t}\n    75\t\n    76\texport function approvalDigest(proposal: Omit<ToolApproval, \"digest\">): string {\n    77\t  // Fixed tuple order, string-only argv, and explicit absent reason avoid object-order ambiguity.\n    78\t  return createHash(\"sha256\")\n    79\t    .update(\n    80\t      JSON.stringify([\n    81\t        proposal.approvalId,\n    82\t        proposal.expiresAt,\n    83\t        proposal.name,\n    84\t        proposal.command,\n    85\t        proposal.args,\n    86\t        proposal.reason ?? null,\n    87\t        proposal.policyVersion,\n    88\t      ]),\n    89\t    )\n    90\t    .digest(\"hex\");\n    91\t}\n    92\t\n    93\texport function commandPolicyFingerprint(spec: CommandSpec): string {\n    94\t  const env =\n    95\t    spec.env === undefined\n    96\t      ? null\n    97\t      : Object.entries(spec.env).sort(([a], [b]) => a.localeCompare(b));\n    98\t  return createHash(\"sha256\")\n    99\t    .update(JSON.stringify([spec.command, spec.policyVersion ?? \"1\", env]))\n   100\t    .digest(\"hex\");\n   101\t}\n   102\t\n   103\texport function equalApprovalDigest(left: string, right: string): boolean {\n   104\t  const hex = /^[a-f0-9]{64}$/;\n   105\t  return (\n   106\t    hex.test(left) &&\n   107\t    hex.test(right) &&\n   108\t    timingSafeEqual(Buffer.from(left, \"hex\"), Buffer.from(right, \"hex\"))\n   109\t  );\n   110\t}\n","exit_code":0,"status":"completed"}}
