{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/tool-exec/src/tool-exec.ts'","aggregated_output":"     1\t// @caisson/tool-exec — governed tool-call / sandboxed-exec primitive (ADR-0153). The security\n     2\t// floor is the whole point: a default-deny allowlist maps a logical command NAME to a real\n     3\t// executable + a Zod-`.strict()` argument schema; a call is validated against that schema BEFORE\n     4\t// spawn, and the validated result is used directly as an `execFile` argv array — never a shell\n     5\t// string, never concatenated. `execSync`/`exec`/`shell: true` are never used anywhere in this file.\n     6\t// ENV DEFAULT: an allowlist entry's optional `env` is absent by default, so a spawned process\n     7\t// inherits the parent's full environment (Node's `execFile` default) — unchanged today. Set\n     8\t// `env` on a `CommandSpec` to narrow a child to exactly the vars it needs (used verbatim, never\n     9\t// merged with `process.env`). Flipping the default to always-narrow is a separate major bump.\n    10\timport { execFile as execFileCb } from \"node:child_process\";\n    11\timport { NotFoundError, parseStrict, ValidationError } from \"@caisson/kernel\";\n    12\timport { createToolProposer } from \"./propose.ts\";\n    13\timport type { CommandSpec } from \"./propose.ts\";\n    14\timport {\n    15\t  APPROVAL_TTL_MS,\n    16\t  approvalDigest,\n    17\t  commandPolicyFingerprint,\n    18\t  createMemoryApprovalStore,\n    19\t  equalApprovalDigest,\n    20\t  toolApprovalSchema,\n    21\t  type ToolApproval,\n    22\t  type ToolApprovalStore,\n    23\t} from \"./approval.ts\";\n    24\t\n    25\t/** Structured argument provenance for one governed call. Plain data, not WORM. */\n    26\texport interface ExecResult {\n    27\t  readonly command: string;\n    28\t  readonly args: readonly string[];\n    29\t  readonly exitCode: number;\n    30\t  readonly stdout: string;\n    31\t  readonly stderr: string;\n    32\t  readonly ok: boolean;\n    33\t  /** Caller-supplied tag (e.g. why this call was made), carried through unmodified. */\n    34\t  readonly reason?: string;\n    35\t  readonly at: number;\n    36\t}\n    37\t\n    38\t/**\n    39\t * The spawn seam: `(command, args, opts) => { stdout, stderr, exitCode }`. Tests inject a double\n    40\t * so the suite never spawns a real process; the default drives `node:child_process.execFile` —\n    41\t * an argv ARRAY, no shell — with output captured and bounded.\n    42\t */\n    43\texport type ExecFn = (\n    44\t  command: string,\n    45\t  args: readonly string[],\n    46\t  opts: {\n    47\t    cwd: string;\n    48\t    timeoutMs: number;\n    49\t    /** Optional child environment. Absent → inherits the parent's full env (the default). */\n    50\t    env?: Readonly<Record<string, string>>;\n    51\t  },\n    52\t) => Promise<{ stdout: string; stderr: string; exitCode: number }>;\n    53\t\n    54\tconst DEFAULT_TIMEOUT_MS = 30_000;\n    55\tconst MAX_OUTPUT_BYTES = 64 * 1024;\n    56\t/** Generous vs. `MAX_OUTPUT_BYTES` — Node's own overflow error is avoided; OUR cap truncates below. */\n    57\tconst NODE_MAX_BUFFER = 10 * 1024 * 1024;\n    58\t\n    59\tfunction bound(output: string): string {\n    60\t  return output.length > MAX_OUTPUT_BYTES\n    61\t    ? output.slice(0, MAX_OUTPUT_BYTES)\n    62\t    : output;\n    63\t}\n    64\t\n    65\t/**\n    66\t * Default `ExecFn`. `execFile(command, argsArray, opts)` — never a shell string, `shell` is never\n    67\t * set. A non-zero exit resolves (not rejects) with that exit code; a spawn failure (e.g. ENOENT,\n    68\t * a non-numeric `error.code`) resolves with `exitCode: -1` — the caller always gets a provenance\n    69\t * record, never a thrown Error from the exec leg itself.\n    70\t */\n    71\tconst defaultExecFn: ExecFn = (command, args, opts) =>\n    72\t  new Promise((resolve) => {\n    73\t    const execOpts =\n    74\t      opts.env === undefined\n    75\t        ? { cwd: opts.cwd, timeout: opts.timeoutMs, maxBuffer: NODE_MAX_BUFFER }\n    76\t        : {\n    77\t            cwd: opts.cwd,\n    78\t            timeout: opts.timeoutMs,\n    79\t            maxBuffer: NODE_MAX_BUFFER,\n    80\t            env: opts.env,\n    81\t          };\n    82\t    execFileCb(command, [...args], execOpts, (error, stdout, stderr) => {\n    83\t      const out = bound(stdout);\n    84\t      const err = bound(stderr);\n    85\t      if (error === null) {\n    86\t        resolve({ stdout: out, stderr: err, exitCode: 0 });\n    87\t        return;\n    88\t      }\n    89\t      const code = (error as { code?: unknown }).code;\n    90\t      resolve({\n    91\t        stdout: out,\n    92\t        stderr: err,\n    93\t        exitCode: typeof code === \"number\" ? code : -1,\n    94\t      });\n    95\t    });\n    96\t  });\n    97\t\n    98\texport interface ToolExecConfig {\n    99\t  /** Default-deny registry. Empty/absent refuses every call (fail-closed). */\n   100\t  readonly allowlist: readonly CommandSpec[];\n   101\t  readonly cwd?: string;\n   102\t  readonly timeoutMs?: number;\n   103\t  /** Injectable spawn seam — tests supply a double so no real process is spawned. */\n   104\t  readonly execFn?: ExecFn;\n   105\t  /** Injectable clock — never `Date.now()` inline, so provenance timestamps are testable. */\n   106\t  readonly now?: () => number;\n   107\t  /** Private server-side record store; durable adapters must atomically consume records. */\n   108\t  readonly approvalStore?: ToolApprovalStore;\n   109\t}\n   110\t\n   111\texport interface ToolExec {\n   112\t  run(name: string, args: unknown, reason?: string): Promise<ExecResult>;\n   113\t  /**\n   114\t   * Two-phase gate, phase 1: validate `args` against the allowlisted command's schema WITHOUT\n   115\t   * spawning anything. Same fail-closed lookup/validation as `run` — unregistered `name` throws\n   116\t   * `NotFoundError`, a bad shape throws `ValidationError` — so a proposal that parks for external\n   117\t   * approval records exactly what was validated; execution still rechecks current policy.\n   118\t   */\n   119\t  propose(name: string, args: unknown, reason?: string): Promise<ToolApproval>;\n   120\t  /**\n   121\t   * Two-phase gate, phase 2: execute a call `propose` already validated (e.g. after an external\n   122\t   * approval decision). Consume the immutable stored record once, verify the canonical digest,\n   123\t   * revalidate original input under the current schema, and derive environment from current policy.\n   124\t   */\n   125\t  execute(proposed: unknown): Promise<ExecResult>;\n   126\t  /** Caller must authorize rejection; atomically discard a pending ID without spawning. */\n   127\t  reject(approvalId: string): Promise<boolean>;\n   128\t}\n   129\t\n   130\t/**\n   131\t * Build a governed tool-call gate over `config.allowlist`. `run(name, args, reason?)`:\n   132\t * 1. Look up `name` in the allowlist — unregistered throws `NotFoundError` (default-deny).\n   133\t * 2. Validate `args` against that command's `argsSchema` via `parseStrict` — a bad shape throws\n   134\t *    `ValidationError` (from `parseStrict`) BEFORE anything is spawned.\n   135\t * 3. Spawn via the injected `ExecFn` (defaults to `execFile`, argv array, no shell) and return the\n   136\t *    full provenance record.\n   137\t *\n   138\t * `propose`/`execute` (ADR-0360 S3) split steps 1-2 from step 3 — additive; `run`'s single-phase\n   139\t * path is unchanged for non-gated tools.\n   140\t */\n   141\texport function createToolExec(config: ToolExecConfig): ToolExec {\n   142\t  // The lookup + validation gate is the pure `./propose.ts` module — one implementation, shared by\n   143\t  // `run` and `propose` so the single-phase and two-phase paths can never drift apart.\n   144\t  const gate = createToolProposer(config.allowlist);\n   145\t  const cwd = config.cwd ?? process.cwd();\n   146\t  const timeoutMs = config.timeoutMs ?? DEFAULT_TIMEOUT_MS;\n   147\t  const execFn = config.execFn ?? defaultExecFn;\n   148\t  const now = config.now ?? Date.now;\n   149\t  const approvals = config.approvalStore ?? createMemoryApprovalStore(now);\n   150\t\n   151\t  const spawn = async (\n   152\t    command: string,\n   153\t    args: readonly string[],\n   154\t    reason: string | undefined,\n   155\t    env: Readonly<Record<string, string>> | undefined,\n   156\t  ): Promise<ExecResult> => {\n   157\t    const { stdout, stderr, exitCode } = await execFn(\n   158\t      command,\n   159\t      args,\n   160\t      env === undefined ? { cwd, timeoutMs } : { cwd, timeoutMs, env },\n   161\t    );\n   162\t    const result: ExecResult = {\n   163\t      command,\n   164\t      args,\n   165\t      exitCode,\n   166\t      stdout,\n   167\t      stderr,\n   168\t      ok: exitCode === 0,\n   169\t      at: now(),\n   170\t    };\n   171\t    return reason === undefined ? result : { ...result, reason };\n   172\t  };\n   173\t\n   174\t  return {\n   175\t    async run(\n   176\t      name: string,\n   177\t      args: unknown,\n   178\t      reason?: string,\n   179\t    ): Promise<ExecResult> {\n   180\t      const proposed = gate.propose(name, args, reason);\n   181\t      return spawn(proposed.command, proposed.args, reason, proposed.env);\n   182\t    },\n   183\t\n   184\t    async propose(\n   185\t      name: string,\n   186\t      args: unknown,\n   187\t      reason?: string,\n   188\t    ): Promise<ToolApproval> {\n   189\t      const input: unknown = structuredClone(args);\n   190\t      const validated = gate.propose(name, input, reason);\n   191\t      const spec = gate.lookup(name)!;\n   192\t      const unsigned = {\n   193\t        approvalId: crypto.randomUUID(),\n   194\t        expiresAt: now() + APPROVAL_TTL_MS,\n   195\t        name,\n   196\t        command: validated.command,\n   197\t        args: [...validated.args],\n   198\t        policyVersion: spec.policyVersion ?? \"1\",\n   199\t        ...(reason === undefined ? {} : { reason }),\n   200\t      };\n   201\t      const proposal = parseStrict(toolApprovalSchema, {\n   202\t        ...unsigned,\n   203\t        digest: approvalDigest(unsigned),\n   204\t      });\n   205\t      await approvals.put({\n   206\t        proposal,\n   207\t        input,\n   208\t        policyFingerprint: commandPolicyFingerprint(spec),\n   209\t      });\n   210\t      return structuredClone(proposal);\n   211\t    },\n   212\t\n   213\t    async reject(approvalId: string): Promise<boolean> {\n   214\t      return approvals.reject(\n   215\t        parseStrict(toolApprovalSchema.shape.approvalId, approvalId),\n   216\t      );\n   217\t    },\n   218\t\n   219\t    async execute(raw: unknown): Promise<ExecResult> {\n   220\t      const proposed = parseStrict(toolApprovalSchema, raw);\n   221\t      const stored = await approvals.consume(proposed.approvalId);\n   222\t      if (!stored)\n   223\t        throw new NotFoundError(\"Approval is unknown or already consumed\");\n   224\t      // Recheck after await even if a durable store returns a record just as it expires.\n   225\t      if (\n   226\t        !Number.isSafeInteger(stored.proposal.expiresAt) ||\n   227\t        now() >= stored.proposal.expiresAt\n   228\t      ) {\n   229\t        throw new NotFoundError(\"Approval expired\");\n   230\t      }\n   231\t      if (\n   232\t        !equalApprovalDigest(proposed.digest, stored.proposal.digest) ||\n   233\t        !equalApprovalDigest(approvalDigest(proposed), stored.proposal.digest)\n   234\t      ) {\n   235\t        throw new ValidationError(\n   236\t          \"Approval record does not match the approved proposal\",\n   237\t        );\n   238\t      }\n   239\t      const spec = gate.lookup(stored.proposal.name);\n   240\t      if (\n   241\t        !spec ||\n   242\t        !equalApprovalDigest(\n   243\t          commandPolicyFingerprint(spec),\n   244\t          stored.policyFingerprint,\n   245\t        )\n   246\t      ) {\n   247\t        throw new NotFoundError(\n   248\t          \"Command policy changed since approval was proposed\",\n   249\t        );\n   250\t      }\n   251\t      const current = gate.propose(\n   252\t        stored.proposal.name,\n   253\t        stored.input,\n   254\t        stored.proposal.reason,\n   255\t      );\n   256\t      const currentDigest = approvalDigest({\n   257\t        ...stored.proposal,\n   258\t        command: current.command,\n   259\t        args: [...current.args],\n   260\t      });\n   261\t      if (!equalApprovalDigest(currentDigest, stored.proposal.digest)) {\n   262\t        throw new ValidationError(\n   263\t          \"Current command validation differs from the approved proposal\",\n   264\t        );\n   265\t      }\n   266\t      // No environment is accepted from the public approval envelope or old stored proposal.\n   267\t      return spawn(\n   268\t        spec.command,\n   269\t        current.args,\n   270\t        current.reason,\n   271\t        spec.env === undefined ? undefined : { ...spec.env },\n   272\t      );\n   273\t    },\n   274\t  };\n   275\t}\n","exit_code":0,"status":"completed"}}
