{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba scripts/release-readiness.ts'","aggregated_output":"     1\t#!/usr/bin/env bun\n     2\t/**\n     3\t * release-readiness.ts — the ADR-0318 R3 gate. Every check must be GREEN before the release\n     4\t * train's propagation legs run; any red exits nonzero and the train stops before touching an\n     5\t * external surface. Run by .github/workflows/release-train.yml on the release SHA, and locally:\n     6\t *\n     7\t *   bun scripts/release-readiness.ts --tag v2026.07.30 [--sha <sha>] [--local]\n     8\t *\n     9\t * Checks (R3, locked; #0 added by ADR-0325):\n    10\t *   0. Release SHA on main — the tag targets a commit that is an ancestor of origin/main (the\n    11\t *      merged version-PR commit; a tag cut on a stray branch must never train).\n    12\t *   0b. Release tag signed (ADR-0382) — `git tag -v` verifies the tag against the allowed-signers\n    13\t *      file. ADVISORY for now: tags cut before the lock are unsigned and cannot become signed.\n    14\t *   1. CI green on the release SHA — all seven required checks, including the source security\n    15\t *      layer, support-bot and the R359 runtime-images-gate aggregate, completed successfully.\n    16\t *   2. Changesets drained — no pending .changeset/*.md (the version PR consumed them —\n    17\t *      version-pr.yml, ADR-0325; never a feature-branch or tag-path act).\n    18\t *   3. CHANGELOGs written — every non-private workspace package's CHANGELOG.md leads with its\n    19\t *      package.json version.\n    20\t *   4. `bun run sot` green — the SoT drift tool (ADR-ceiling parity, frontmatter/docs freshness,\n    21\t *      archive integrity, tracker-vs-PR reality, changeset preflight). Doubles as the R3\n    22\t *      docs-freshness check.\n    23\t *   4b. Registry coverage invariants (CAISSON-85/86) — every module's `latest` has a tarball row\n    24\t *      (hard), no advertised version outside the frozen pre-sidecar backlog is rowless, and every\n    25\t *      served member pin resolves served+tarball-backed (advertise-follows-upload, static half).\n    26\t *   5. R4 audit artifact on file — outputs/audit/release-audit-<tag>.md (the fresh full\n    27\t *      SHIP-audit-lane review of the cumulative diff since the last release tag).\n    28\t *   6. Per-release checklist complete — docs/releases/<tag>-checklist.md exists with ZERO\n    29\t *      unchecked boxes (the human items: marketing surfaces, announcement, live-leg attestations).\n    30\t *   7. (--local only) the live-hybrid retrieval golden leg — services/docs `bun run test:live`\n    31\t *      with real keys (Kickoff-M picker 2026-07-10: this leg gates at release readiness, not PR\n    32\t *      CI). In the train (no keys) the checklist attestation (#6) carries it instead.\n    33\t */\n    34\timport { execFileSync } from \"node:child_process\";\n    35\timport { existsSync, readdirSync, readFileSync } from \"node:fs\";\n    36\timport { join, resolve } from \"node:path\";\n    37\timport { z } from \"zod\";\n    38\timport { checkRegistryCoverage } from \"../registry/scripts/coverage-invariants\";\n    39\t\n    40\tconst REPO = resolve(import.meta.dir, \"..\");\n    41\texport const REQUIRED_CHECKS = [\n    42\t  \"check\",\n    43\t  \"standards-gate\",\n    44\t  \"registry-index\",\n    45\t  \"oscal-conformance\",\n    46\t  // ADR-0327 scan-gate flip (CAISSON-95): the deterministic security layer joins the required\n    47\t  // set once its installers are pinned — which landed in the same change as this line.\n    48\t  \"deterministic\",\n    49\t  // ADR-0414: the Python gate for services/support-bot, promoted out of advisory in the same\n    50\t  // change that gave that service an automated Railway deploy. Its paths filter was removed in\n    51\t  // the same commit — this list treats a check that never reported as `missing`, so a\n    52\t  // path-scoped required check would red readiness on every release that did not touch the bot.\n    53\t  \"support-bot\",\n    54\t  // R359 / CR-05: source scans cannot stand in for the enforcing runtime-image matrix.\n    55\t  \"runtime-images-gate\",\n    56\t] as const;\n    57\t\n    58\tinterface Args {\n    59\t  tag: string;\n    60\t  sha: string;\n    61\t  local: boolean;\n    62\t}\n    63\t\n    64\tfunction parseArgs(argv: readonly string[]): Args {\n    65\t  let tag = \"\";\n    66\t  let sha = \"\";\n    67\t  let local = false;\n    68\t  for (let i = 0; i < argv.length; i++) {\n    69\t    const a = argv[i];\n    70\t    if (a === \"--tag\") tag = argv[++i] ?? \"\";\n    71\t    else if (a === \"--sha\") sha = argv[++i] ?? \"\";\n    72\t    else if (a === \"--local\") local = true;\n    73\t  }\n    74\t  if (!tag) {\n    75\t    console.error(\"FATAL: --tag <release-tag> is required\");\n    76\t    process.exit(1);\n    77\t  }\n    78\t  if (!sha) {\n    79\t    sha = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: REPO })\n    80\t      .toString()\n    81\t      .trim();\n    82\t  }\n    83\t  return { tag, sha, local };\n    84\t}\n    85\t\n    86\ttype CheckResult = { name: string; ok: boolean; detail: string };\n    87\tconst results: CheckResult[] = [];\n    88\tfunction record(name: string, ok: boolean, detail: string): void {\n    89\t  results.push({ name, ok, detail });\n    90\t  console.log(`${ok ? \"  ✓\" : \"  ✗\"} ${name} — ${detail}`);\n    91\t}\n    92\t\n    93\tfunction run(cmd: string, args: readonly string[], cwd = REPO): string {\n    94\t  return execFileSync(cmd, [...args], {\n    95\t    cwd,\n    96\t    stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    97\t  })\n    98\t    .toString()\n    99\t    .trim();\n   100\t}\n   101\t\n   102\t// --- 0. release SHA on main (ADR-0325) -----------------------------------------------------------\n   103\tfunction checkTagOnMain(sha: string): void {\n   104\t  try {\n   105\t    // In CI the checkout is at the tag with full history; locally origin/main may be stale —\n   106\t    // refresh it quietly, tolerating offline runs (merge-base still answers from local refs).\n   107\t    try {\n   108\t      run(\"git\", [\"fetch\", \"origin\", \"main\", \"--quiet\"]);\n   109\t    } catch {\n   110\t      /* offline — check against the local origin/main ref */\n   111\t    }\n   112\t    run(\"git\", [\"merge-base\", \"--is-ancestor\", sha, \"origin/main\"]);\n   113\t    record(\n   114\t      \"release SHA on main\",\n   115\t      true,\n   116\t      `${sha.slice(0, 8)} is an ancestor of origin/main`,\n   117\t    );\n   118\t  } catch {\n   119\t    record(\n   120\t      \"release SHA on main\",\n   121\t      false,\n   122\t      `${sha.slice(0, 8)} is NOT on origin/main — the tag must target the merged version-PR commit`,\n   123\t    );\n   124\t  }\n   125\t}\n   126\t\n   127\t// --- 0b. release tag is signed (ADR-0382) -------------------------------------------------------\n   128\t// An annotated tag says WHO claims a release; a signed one proves it. Without a signature anyone\n   129\t// with push access can move or forge a tag onto a different commit and every downstream leg — the\n   130\t// registry publish, the mirror sync, the fleet redeploy — trusts it, because each of them resolves\n   131\t// the tag rather than a SHA. `git tag -v` verifies against the allowed-signers file; it fails on an\n   132\t// unsigned tag, an unknown signer, and a signature that does not match the tag's bytes.\n   133\t//\n   134\t// Tags cut before the signing lock are unsigned and cannot retroactively become signed, so this is\n   135\t// a WARNING here rather than a hard gate: it reports honestly on every release without failing the\n   136\t// train on history it cannot change. Promote it to a blocking check once the first signed tag has\n   137\t// trained end to end (that flip is a one-word change: `record(..., ok, ...)`).\n   138\tfunction checkTagSigned(tag: string): void {\n   139\t  try {\n   140\t    run(\"git\", [\"tag\", \"-v\", tag]);\n   141\t    record(\"release tag signed\", true, `${tag} carries a valid signature`);\n   142\t  } catch {\n   143\t    // Not fatal — see above. Surfaced so an unsigned tag is a visible choice, never an oversight.\n   144\t    console.log(\n   145\t      `  ! release tag signed — ${tag} is UNSIGNED or its signer is not in the allowed-signers file (advisory; see docs/ops/release-tag-signing.md)`,\n   146\t    );\n   147\t  }\n   148\t}\n   149\t\n   150\t// --- 1. CI green on the release SHA -------------------------------------------------------------\n   151\tfunction checkCi(sha: string): void {\n   152\t  try {\n   153\t    const raw = run(\"gh\", [\n   154\t      \"api\",\n   155\t      `repos/{owner}/{repo}/commits/${sha}/check-runs`,\n   156\t      \"--paginate\",\n   157\t      \"-q\",\n   158\t      \"[.check_runs[] | {name, status, conclusion}]\",\n   159\t    ]);\n   160\t    // --paginate emits one JSON array per page; normalize to a single list.\n   161\t    const runs = raw\n   162\t      .split(\"\\n\")\n   163\t      .filter(Boolean)\n   164\t      .flatMap(\n   165\t        (line) =>\n   166\t          JSON.parse(line) as {\n   167\t            name: string;\n   168\t            status: string;\n   169\t            conclusion: string | null;\n   170\t          }[],\n   171\t      );\n   172\t    const missing: string[] = [];\n   173\t    const red: string[] = [];\n   174\t    for (const required of REQUIRED_CHECKS) {\n   175\t      const match = runs.filter((r) => r.name === required);\n   176\t      if (match.length === 0) {\n   177\t        missing.push(required);\n   178\t        continue;\n   179\t      }\n   180\t      // A check re-run replaces its predecessor in the API answer set; any green instance passes.\n   181\t      if (\n   182\t        !match.some(\n   183\t          (r) => r.status === \"completed\" && r.conclusion === \"success\",\n   184\t        )\n   185\t      )\n   186\t        red.push(required);\n   187\t    }\n   188\t    const ok = missing.length === 0 && red.length === 0;\n   189\t    record(\n   190\t      \"CI green on release SHA\",\n   191\t      ok,\n   192\t      ok\n   193\t        ? `all ${String(REQUIRED_CHECKS.length)} required checks green at ${sha.slice(0, 8)}`\n   194\t        : `missing: [${missing.join(\", \")}] red: [${red.join(\", \")}]`,\n   195\t    );\n   196\t  } catch (err) {\n   197\t    record(\"CI green on release SHA\", false, `gh api failed: ${String(err)}`);\n   198\t  }\n   199\t}\n   200\t\n   201\t// --- 2. changesets drained -----------------------------------------------------------------------\n   202\tfunction checkChangesetsDrained(): void {\n   203\t  const pending = readdirSync(join(REPO, \".changeset\")).filter(\n   204\t    (f) => f.endsWith(\".md\") && f !== \"README.md\",\n   205\t  );\n   206\t  record(\n   207\t    \"changesets drained\",\n   208\t    pending.length === 0,\n   209\t    pending.length === 0\n   210\t      ? \"no pending changesets\"\n   211\t      : `${String(pending.length)} pending (version cut not consumed): ${pending.slice(0, 5).join(\", \")}${pending.length > 5 ? \", …\" : \"\"}`,\n   212\t  );\n   213\t}\n   214\t\n   215\t// --- 3. CHANGELOGs written -----------------------------------------------------------------------\n   216\tfunction checkChangelogs(): void {\n   217\t  const bad: string[] = [];\n   218\t  for (const group of [\"packages\", \"tooling\"]) {\n   219\t    const base = join(REPO, group);\n   220\t    if (!existsSync(base)) continue;\n   221\t    for (const slug of readdirSync(base)) {\n   222\t      const pj = join(base, slug, \"package.json\");\n   223\t      if (!existsSync(pj)) continue;\n   224\t      const pkg = JSON.parse(readFileSync(pj, \"utf8\")) as {\n   225\t        name: string;\n   226\t        version?: string;\n   227\t        private?: boolean;\n   228\t      };\n   229\t      if (pkg.private || !pkg.version) continue;\n   230\t      const changelog = join(base, slug, \"CHANGELOG.md\");\n   231\t      if (!existsSync(changelog)) {\n   232\t        bad.push(`${pkg.name} (no CHANGELOG.md)`);\n   233\t        continue;\n   234\t      }\n   235\t      if (!readFileSync(changelog, \"utf8\").includes(`## ${pkg.version}`))\n   236\t        bad.push(`${pkg.name} (no ## ${pkg.version} entry)`);\n   237\t    }\n   238\t  }\n   239\t  record(\n   240\t    \"CHANGELOGs written\",\n   241\t    bad.length === 0,\n   242\t    bad.length === 0\n   243\t      ? \"every versioned package's CHANGELOG leads with its current version\"\n   244\t      : bad.slice(0, 5).join(\"; \") + (bad.length > 5 ? \"; …\" : \"\"),\n   245\t  );\n   246\t}\n   247\t\n   248\t// --- 4. sot green (doubles as docs freshness) ----------------------------------------------------\n   249\tfunction checkSot(): void {\n   250\t  try {\n   251\t    run(\"bun\", [\"run\", \"sot\"]);\n   252\t    record(\"bun run sot\", true, \"SoT drift tool green (incl. docs freshness)\");\n   253\t  } catch (err) {\n   254\t    // Surface the captured drift report — a CI readiness red must not be blind (first ride:\n   255\t    // the only failure signal was this one-liner while sot's own output was swallowed).\n   256\t    const e = err as { stdout?: Buffer | string; stderr?: Buffer | string };\n   257\t    for (const chunk of [e.stdout, e.stderr]) {\n   258\t      const text = chunk?.toString().trim();\n   259\t      if (text) console.error(text);\n   260\t    }\n   261\t    record(\"bun run sot\", false, \"sot check failed — drift report above\");\n   262\t  }\n   263\t}\n   264\t\n   265\t// --- 4b. registry coverage invariants (CAISSON-85/86) --------------------------------------------\n   266\tfunction checkRegistryCoverageGate(): void {\n   267\t  // Static advertise-follows-upload proof: every module's latest has a tarball row (hard), no\n   268\t  // advertised version outside the frozen pre-sidecar backlog is rowless, and every served member\n   269\t  // pin resolves served+tarball-backed. Same invariants the registry-index CI job enforces via\n   270\t  // coverage-invariants.test.ts — re-run here so the train's readiness verdict is self-contained.\n   271\t  try {\n   272\t    const report = checkRegistryCoverage({\n   273\t      indexPath: join(REPO, \"registry/index.json\"),\n   274\t      sidecarPath: join(REPO, \"registry/tarballs.json\"),\n   275\t    });\n   276\t    const detail = report.ok\n   277\t      ? \"latest/version/pin coverage all green (advertise-follows-upload)\"\n   278\t      : `latest: [${report.latest.join(\", \")}] versions: [${report.versions\n   279\t          .slice(0, 3)\n   280\t          .join(\n   281\t            \", \",\n   282\t          )}${report.versions.length > 3 ? \", …\" : \"\"}] pins: [${report.pins\n   283\t          .slice(0, 3)\n   284\t          .join(\", \")}${report.pins.length > 3 ? \", …\" : \"\"}]`;\n   285\t    record(\"registry coverage (85/86)\", report.ok, detail);\n   286\t  } catch (err) {\n   287\t    record(\n   288\t      \"registry coverage (85/86)\",\n   289\t      false,\n   290\t      `coverage check failed to run: ${String(err)}`,\n   291\t    );\n   292\t  }\n   293\t}\n   294\t\n   295\t// --- 5. R4 audit artifact ------------------------------------------------------------------------\n   296\tconst releaseRef = z.string().regex(/^v[0-9][A-Za-z0-9._-]{0,100}$/);\n   297\tconst auditBindingSchema = z\n   298\t  .object({\n   299\t    base: releaseRef,\n   300\t    tag: releaseRef,\n   301\t    reviewed_sha: z.string().regex(/^[a-f0-9]{40}$/),\n   302\t  })\n   303\t  .strict();\n   304\tconst releaseAuditSchema = auditBindingSchema\n   305\t  .extend({\n   306\t    schema_version: z.literal(2),\n   307\t    status: z.literal(\"clean\"),\n   308\t    critical: z.literal(0),\n   309\t    reviewed_scope: z\n   310\t      .array(z.string().trim().min(1).max(512))\n   311\t      .min(1)\n   312\t      .max(10000),\n   313\t    reviewers: z\n   314\t      .array(\n   315\t        z\n   316\t          .object({\n   317\t            role: z.enum([\"code_review\", \"security_audit\"]),\n   318\t            identity: z.string().trim().min(1).max(200),\n   319\t            reviewed_at: z.iso.datetime({ offset: true }),\n   320\t          })\n   321\t          .strict(),\n   322\t      )\n   323\t      .length(2)\n   324\t      .refine(\n   325\t        (reviewers) =>\n   326\t          new Set(reviewers.map((reviewer) => reviewer.role)).size === 2,\n   327\t        \"Both code review and security audit must be completed\",\n   328\t      ),\n   329\t  })\n   330\t  .strict();\n   331\t\n   332\texport type AuditBinding = z.infer<typeof auditBindingSchema>;\n   333\t\n   334\t// R370: only these two tag-specific files may change after the reviewed commit.\n   335\t// No directory-wide docs exemption: a new policy, script or product byte needs review.\n   336\texport const ATTESTATION_ONLY_PATHS = [\n   337\t  \"outputs/audit/release-audit-{tag}.md\",\n   338\t  \"docs/releases/{tag}-checklist.md\",\n   339\t] as const;\n   340\t\n   341\t/** File-backed boundary: a filename alone is never an R4 attestation. */\n   342\texport function auditArtifactIsValid(\n   343\t  path: string,\n   344\t  expected: AuditBinding,\n   345\t): boolean {\n   346\t  try {\n   347\t    return auditSourceIsValid(readFileSync(path, \"utf8\"), expected);\n   348\t  } catch {\n   349\t    return false;\n   350\t  }\n   351\t}\n   352\t\n   353\tfunction auditSourceIsValid(source: string, expected: AuditBinding): boolean {\n   354\t  try {\n   355\t    const binding = auditBindingSchema.parse(expected);\n   356\t    const frontmatter = /^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?:\\r?\\n|$)/.exec(source);\n   357\t    if (!frontmatter || source.length > 1_000_000) return false;\n   358\t    const audit = releaseAuditSchema.parse(Bun.YAML.parse(frontmatter[1]!));\n   359\t    return (\n   360\t      audit.base === binding.base &&\n   361\t      audit.tag === binding.tag &&\n   362\t      audit.reviewed_sha === binding.reviewed_sha\n   363\t    );\n   364\t  } catch {\n   365\t    return false;\n   366\t  }\n   367\t}\n   368\t\n   369\t/** Read committed bytes, never a working-tree substitute for the tagged attestation. */\n   370\texport function auditSuccessorIsValid(\n   371\t  repo: string,\n   372\t  tag: string,\n   373\t  tagSha: string,\n   374\t): boolean {\n   375\t  try {\n   376\t    releaseRef.parse(tag);\n   377\t    z.string()\n   378\t      .regex(/^[a-f0-9]{40}$/)\n   379\t      .parse(tagSha);\n   380\t    const reviewedSha = run(\"git\", [\"rev-parse\", `${tagSha}^`], repo);\n   381\t    // A merge has several parents and cannot use an ambiguous first-parent review.\n   382\t    const parents = run(\n   383\t      \"git\",\n   384\t      [\"rev-list\", \"--parents\", \"-n\", \"1\", tagSha],\n   385\t      repo,\n   386\t    ).split(\" \");\n   387\t    if (parents.length !== 2 || parents[1] !== reviewedSha) return false;\n   388\t    const allowed = ATTESTATION_ONLY_PATHS.map((path) =>\n   389\t      path.replace(\"{tag}\", tag),\n   390\t    );\n   391\t    // Preserve all filename bytes: trimming could turn a leading-space path into an allowed one.\n   392\t    const changed = execFileSync(\n   393\t      \"git\",\n   394\t      [\"diff\", \"--name-only\", \"--no-renames\", \"-z\", reviewedSha, tagSha],\n   395\t      { cwd: repo },\n   396\t    )\n   397\t      .toString()\n   398\t      .split(\"\\0\")\n   399\t      .filter(Boolean);\n   400\t    if (changed.length === 0 || changed.some((path) => !allowed.includes(path)))\n   401\t      return false;\n   402\t    const base = run(\n   403\t      \"git\",\n   404\t      [\"describe\", \"--tags\", \"--abbrev=0\", \"--match\", \"v[0-9]*\", reviewedSha],\n   405\t      repo,\n   406\t    );\n   407\t    const auditPath = allowed[0]!;\n   408\t    // A symlink is not an audit/checklist file. Both must exist as regular blobs.\n   409\t    for (const path of allowed) {\n   410\t      const entry = run(\"git\", [\"ls-tree\", tagSha, \"--\", path], repo);\n   411\t      if (!entry.startsWith(\"100644 blob \")) return false;\n   412\t    }\n   413\t    return auditSourceIsValid(\n   414\t      run(\"git\", [\"show\", `${tagSha}:${auditPath}`], repo),\n   415\t      {\n   416\t        base,\n   417\t        tag,\n   418\t        reviewed_sha: reviewedSha,\n   419\t      },\n   420\t    );\n   421\t  } catch {\n   422\t    return false;\n   423\t  }\n   424\t}\n   425\t\n   426\tfunction checkAuditArtifact(tag: string, sha: string): void {\n   427\t  record(\n   428\t    \"R4 release audit on file\",\n   429\t    auditSuccessorIsValid(REPO, tag, sha),\n   430\t    `requires clean code/security audit of ${sha}^ and only the two ${tag} attestation paths in its successor; CI still binds ${sha}`,\n   431\t  );\n   432\t}\n   433\t\n   434\t// --- 6. per-release checklist --------------------------------------------------------------------\n   435\tfunction checkChecklist(tag: string): void {\n   436\t  const path = join(REPO, \"docs/releases\", `${tag}-checklist.md`);\n   437\t  if (!existsSync(path)) {\n   438\t    record(\n   439\t      \"per-release checklist\",\n   440\t      false,\n   441\t      `MISSING docs/releases/${tag}-checklist.md — copy docs/releases/TEMPLATE-checklist.md`,\n   442\t    );\n   443\t    return;\n   444\t  }\n   445\t  const unchecked = (readFileSync(path, \"utf8\").match(/^\\s*-\\s\\[\\s\\]/gm) ?? [])\n   446\t    .length;\n   447\t  record(\n   448\t    \"per-release checklist\",\n   449\t    unchecked === 0,\n   450\t    unchecked === 0\n   451\t      ? \"all boxes checked\"\n   452\t      : `${String(unchecked)} unchecked box(es)`,\n   453\t  );\n   454\t}\n   455\t\n   456\t// --- 7. live-hybrid golden leg (--local) ---------------------------------------------------------\n   457\tfunction checkLiveHybrid(): void {\n   458\t  const key =\n   459\t    process.env.CAISSON_DOCS__OPENROUTER_API_KEY ??\n   460\t    process.env.OPENROUTER_API_KEY ??\n   461\t    \"\";\n   462\t  if (key.length === 0) {\n   463\t    record(\n   464\t      \"live-hybrid golden leg\",\n   465\t      false,\n   466\t      \"no OpenRouter key in env — source the env and re-run, or drop --local and attest via the checklist\",\n   467\t    );\n   468\t    return;\n   469\t  }\n   470\t  try {\n   471\t    execFileSync(\"bun\", [\"run\", \"test:live\"], {\n   472\t      cwd: join(REPO, \"services/docs\"),\n   473\t      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n   474\t      env: { ...process.env, OPENROUTER_API_KEY: key },\n   475\t      timeout: 15 * 60_000,\n   476\t    });\n   477\t    record(\n   478\t      \"live-hybrid golden leg\",\n   479\t      true,\n   480\t      \"services/docs test:live green (real fusion path)\",\n   481\t    );\n   482\t  } catch {\n   483\t    record(\"live-hybrid golden leg\", false, \"services/docs test:live FAILED\");\n   484\t  }\n   485\t}\n   486\t\n   487\t// Entry point guard (ADR-0414). Everything above is importable; only a direct\n   488\t// `bun scripts/release-readiness.ts` runs the gate. Without this, importing the module to test\n   489\t// REQUIRED_CHECKS parses argv, prints \"FATAL: --tag is required\", and exits the test process.\n   490\t// release-train.yml's R3 job invokes this file directly, so `import.meta.main` is true there.\n   491\tif (import.meta.main) {\n   492\t  const { tag, sha, local } = parseArgs(Bun.argv.slice(2));\n   493\t  console.log(\n   494\t    `release-readiness — tag ${tag}, sha ${sha.slice(0, 12)}${local ? \", local\" : \"\"}\\n`,\n   495\t  );\n   496\t  checkTagOnMain(sha);\n   497\t  checkTagSigned(tag);\n   498\t  checkCi(sha);\n   499\t  checkChangesetsDrained();\n   500\t  checkChangelogs();\n   501\t  checkSot();\n   502\t  checkRegistryCoverageGate();\n   503\t  checkAuditArtifact(tag, sha);\n   504\t  checkChecklist(tag);\n   505\t  if (local) checkLiveHybrid();\n   506\t\n   507\t  const failed = results.filter((r) => !r.ok);\n   508\t  console.log(\n   509\t    `\\n${failed.length === 0 ? \"READY\" : \"NOT READY\"} — ${String(results.length - failed.length)}/${String(results.length)} checks green`,\n   510\t  );\n   511\t  process.exit(failed.length === 0 ? 0 : 1);\n   512\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"agent_message","text":"The release-attestation repair now avoids the self-referential SHA and correctly constrains the successor diff to a single parent plus a two-path allowlist. I’m tracing the gate’s committed-vs-working-tree reads and the workflow invocation next, because that distinction is the main remaining integrity boundary in this remedy."}}
