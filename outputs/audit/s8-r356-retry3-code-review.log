{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba registry/scripts/ci-publish-step.ts'","aggregated_output":"     1\t// registry/scripts/ci-publish-step.ts\n     2\t// CI ledger-append / index-rebuild / tarball-verify step (ADR-0021/0069, reworked by ADR-0325).\n     3\t// Two modes, matching the commit-addressable release flow:\n     4\t//\n     5\t//   --mode version  (version-pr.yml) — runs AFTER `changeset version` on the version-PR branch:\n     6\t//     appends new (id, version) pairs to the ledger, rebuilds index.json, packs each non-private\n     7\t//     package and records its hash row into tarballs.json. All of it lands IN the version PR, so\n     8\t//     the source truth (bumps + CHANGELOGs + ledger + index + sidecar) ships as ONE commit that\n     9\t//     the release tag is later cut on.\n    10\t//\n    11\t//   --mode publish  (publish.yml, checked out at the release tag) — ZERO source mutation:\n    12\t//     verifies every workspace version is ledgered + sidecar'd and index.json is a byte-identical\n    13\t//     rebuild, then re-packs each tarball and requires its bytes to hash to EXACTLY the sidecar\n    14\t//     row the version PR recorded (`bun pm pack` is byte-deterministic for identical source\n    15\t//     bytes — a mismatch means the tag does not match the version PR's source, and the release\n    16\t//     stops before any external write). Packing stages tarballs for the R2 upload step; no\n    17\t//     tracked file is written.\n    18\t//\n    19\t// In dry-run mode (default, CAISSON_PUBLISH_DRY_RUN=true), reports planned actions without\n    20\t// writing any files. publishedAt comes from the CI clock via --published-at — never derived\n    21\t// internally (determinism: no Date.now(), no new Date() here).\n    22\timport { spawnSync } from \"node:child_process\";\n    23\timport { createHash } from \"node:crypto\";\n    24\timport {\n    25\t  existsSync,\n    26\t  mkdirSync,\n    27\t  readFileSync,\n    28\t  readdirSync,\n    29\t  writeFileSync,\n    30\t} from \"node:fs\";\n    31\timport { dirname, join, resolve, sep } from \"node:path\";\n    32\timport { isDeepStrictEqual } from \"node:util\";\n    33\timport { gunzipSync } from \"node:zlib\";\n    34\timport { z } from \"zod\";\n    35\timport type { ModuleManifest } from \"../schema/module-manifest\";\n    36\timport { appendLedger } from \"./append-ledger\";\n    37\timport {\n    38\t  INDEX_PATH,\n    39\t  LEDGER_PATH,\n    40\t  buildIndexFromLedgerFile,\n    41\t  parseLedgerLines,\n    42\t} from \"./build-index\";\n    43\t\n    44\t// ---------------------------------------------------------------------------\n    45\t// Tarball sidecar (ADR-0223 Fork 1.1) — the CI writer half of the contract the\n    46\t// Worker reads (registry/worker/npm-routes.ts). Maps `<@caisson/module>@<version>`\n    47\t// → {key, shasum, integrity, size}: the R2 object key + npm's two integrity forms.\n    48\t// This step is the ONLY writer, in the same commit that writes ledger.jsonl + index.json.\n    49\t// ---------------------------------------------------------------------------\n    50\t\n    51\t/** registry/tarballs.json — git-tracked, inlined into the Worker bundle at build time like index.json. */\n    52\texport const SIDECAR_PATH = join(import.meta.dir, \"..\", \"tarballs.json\");\n    53\t/** Where `bun pm pack` output is staged for the R2 upload step (keyed dirs `<slug>/<slug>-<v>.tgz`). */\n    54\texport const STAGING_DIR = join(import.meta.dir, \"..\", \".tarball-staging\");\n    55\t/** Repo-root `bun.lock` — the dependency resolution every `bun pm pack` rewrite runs under. */\n    56\texport const LOCKFILE_PATH = join(import.meta.dir, \"..\", \"..\", \"bun.lock\");\n    57\t\n    58\t/**\n    59\t * SHA-256 of the lockfile governing this run's packs (ADR-0365 / CAISSON-127). Undefined when the\n    60\t * lockfile is absent (isolated test fixtures) — rows then record without provenance, keeping the\n    61\t * pre-ADR shape.\n    62\t */\n    63\texport function currentLockHash(\n    64\t  path: string = LOCKFILE_PATH,\n    65\t): string | undefined {\n    66\t  if (!existsSync(path)) return undefined;\n    67\t  return createHash(\"sha256\").update(readFileSync(path)).digest(\"hex\");\n    68\t}\n    69\t\n    70\t// Local strict schema (the write boundary). The Worker owns the READ schema; keeping the write\n    71\t// shape here avoids a scripts→worker layering dependency. Both mirror `{key,shasum,integrity,size,meta}`.\n    72\tconst DepMap = z.record(z.string(), z.string());\n    73\t// The abbreviated-packument install fields the client needs to build the dependency tree. Kept in\n    74\t// sync with the Worker's PackumentMeta (registry/worker/npm-routes.ts). npm resolves deps from the\n    75\t// packument, NOT the tarball — omitting these installs a package with zero dependencies.\n    76\t// ponytail: the 5 install fields real caisson packages carry; add os/cpu/peerDependenciesMeta here +\n    77\t// in the Worker if a native or peer-dep package ever ships.\n    78\tconst PackumentMeta = z\n    79\t  .object({\n    80\t    dependencies: DepMap.optional(),\n    81\t    optionalDependencies: DepMap.optional(),\n    82\t    peerDependencies: DepMap.optional(),\n    83\t    bin: z.union([z.string(), DepMap]).optional(),\n    84\t    engines: DepMap.optional(),\n    85\t  })\n    86\t  .strict();\n    87\texport type PackumentMeta = z.infer<typeof PackumentMeta>;\n    88\t\n    89\tconst SidecarDist = z\n    90\t  .object({\n    91\t    key: z.string().min(1),\n    92\t    shasum: z.string().min(1),\n    93\t    integrity: z.string().min(1),\n    94\t    size: z.number().int().nonnegative(),\n    95\t    meta: PackumentMeta.optional(),\n    96\t    /** SHA-256 of the repo-root `bun.lock` the row was recorded under (ADR-0365 / CAISSON-127).\n    97\t     *  `bun pm pack` rewrites resolved dependency versions into the packed package.json, so a row's\n    98\t     *  bytes are only reproducible under the same resolution. Provenance, not content: excluded\n    99\t     *  from the publish byte-equality compare. Absent on pre-ADR rows. */\n   100\t    lockHash: z\n   101\t      .string()\n   102\t      .regex(/^[0-9a-f]{64}$/)\n   103\t      .optional(),\n   104\t  })\n   105\t  .strict();\n   106\tconst Sidecar = z\n   107\t  .object({\n   108\t    $comment: z.string().optional(),\n   109\t    tarballs: z.record(z.string(), SidecarDist),\n   110\t  })\n   111\t  .strict();\n   112\texport type TarballDist = z.infer<typeof SidecarDist>;\n   113\texport type Sidecar = z.infer<typeof Sidecar>;\n   114\t\n   115\t/**\n   116\t * Read `package/package.json` out of a gzipped npm tarball's bytes (standard ustar, as `bun pm pack`\n   117\t * emits it). Pure — no temp files. Returns null when the bytes are not a valid gzip/tar (e.g. a test\n   118\t * stub) or carry no package.json, so a non-tarball input degrades to \"no meta\" instead of throwing.\n   119\t */\n   120\tfunction readPackedManifest(bytes: Uint8Array): Record<string, unknown> | null {\n   121\t  let tar: Buffer;\n   122\t  try {\n   123\t    tar = gunzipSync(Buffer.from(bytes));\n   124\t  } catch {\n   125\t    return null;\n   126\t  }\n   127\t  for (let off = 0; off + 512 <= tar.length;) {\n   128\t    const header = tar.subarray(off, off + 512);\n   129\t    if (header.every((b) => b === 0)) break; // end-of-archive\n   130\t    const name = (\n   131\t      header.subarray(0, 100).toString(\"utf8\").split(\"\\0\")[0] ?? \"\"\n   132\t    ).trim();\n   133\t    const sizeOctal = header\n   134\t      .subarray(124, 136)\n   135\t      .toString(\"utf8\")\n   136\t      .replace(/\\0.*$/, \"\")\n   137\t      .trim();\n   138\t    const size = Number.parseInt(sizeOctal, 8) || 0;\n   139\t    const body = off + 512;\n   140\t    if (name === \"package/package.json\") {\n   141\t      try {\n   142\t        return JSON.parse(\n   143\t          tar.subarray(body, body + size).toString(\"utf8\"),\n   144\t        ) as Record<string, unknown>;\n   145\t      } catch {\n   146\t        return null;\n   147\t      }\n   148\t    }\n   149\t    off = body + Math.ceil(size / 512) * 512;\n   150\t  }\n   151\t  return null;\n   152\t}\n   153\t\n   154\t/**\n   155\t * Lift the abbreviated-packument install fields from a packed tarball's package.json. Validated at the\n   156\t * boundary — a malformed field drops meta entirely rather than crashing the Worker's one-shot sidecar\n   157\t * parse. `devDependencies` are deliberately NOT captured (transitive dev deps are never installed).\n   158\t * Returns undefined when the package carries none of the install fields.\n   159\t */\n   160\texport function packumentMeta(bytes: Uint8Array): PackumentMeta | undefined {\n   161\t  const pkg = readPackedManifest(bytes);\n   162\t  if (pkg === null) return undefined;\n   163\t  const cleaned: Record<string, unknown> = {};\n   164\t  for (const field of [\n   165\t    \"dependencies\",\n   166\t    \"optionalDependencies\",\n   167\t    \"peerDependencies\",\n   168\t    \"bin\",\n   169\t    \"engines\",\n   170\t  ] as const) {\n   171\t    const v = pkg[field];\n   172\t    if (v === undefined || v === null) continue;\n   173\t    if (typeof v === \"object\" && Object.keys(v).length === 0) continue; // {} → omit\n   174\t    cleaned[field] = v;\n   175\t  }\n   176\t  if (Object.keys(cleaned).length === 0) return undefined;\n   177\t  const parsed = PackumentMeta.safeParse(cleaned);\n   178\t  return parsed.success ? parsed.data : undefined;\n   179\t}\n   180\t\n   181\t/**\n   182\t * Compute the npm dist metadata for a packed tarball's bytes. `shasum` = SHA-1 hex (npm's legacy\n   183\t * `dist.shasum`); `integrity` = sha512 Subresource-Integrity string (`sha512-<base64>`, npm's\n   184\t * `dist.integrity`). `key` = the R2 object key `<slug>/<slug>-<version>.tgz` — scope dropped, byte-for-byte\n   185\t * the key `registry/worker/npm-routes.ts` derives on the tarball GET. `meta` = the resolved install\n   186\t * fields lifted from the tarball's package.json (so the client resolves the dependency tree).\n   187\t * node:crypto only, no `ssri` dep.\n   188\t */\n   189\texport function computeTarballDist(\n   190\t  bytes: Uint8Array,\n   191\t  slug: string,\n   192\t  version: string,\n   193\t): TarballDist {\n   194\t  const buf = Buffer.from(bytes);\n   195\t  const meta = packumentMeta(bytes);\n   196\t  return {\n   197\t    key: `${slug}/${slug}-${version}.tgz`,\n   198\t    shasum: createHash(\"sha1\").update(buf).digest(\"hex\"),\n   199\t    integrity: `sha512-${createHash(\"sha512\").update(buf).digest(\"base64\")}`,\n   200\t    size: buf.length,\n   201\t    ...(meta ? { meta } : {}),\n   202\t  };\n   203\t}\n   204\t\n   205\t/** Read the sidecar (or an empty one if absent), parse-or-throw at the boundary. */\n   206\texport function readSidecar(path: string = SIDECAR_PATH): Sidecar {\n   207\t  const raw = existsSync(path) ? readFileSync(path, \"utf8\") : '{\"tarballs\":{}}';\n   208\t  return Sidecar.parse(JSON.parse(raw));\n   209\t}\n   210\t\n   211\t/**\n   212\t * Write the sidecar deterministically: keys sorted, `$comment` preserved first, 2-space JSON +\n   213\t * trailing newline (same discipline as index.json, so a rerun is byte-stable and diffs cleanly).\n   214\t */\n   215\texport function writeSidecar(\n   216\t  sidecar: Sidecar,\n   217\t  path: string = SIDECAR_PATH,\n   218\t): void {\n   219\t  const tarballs: Record<string, TarballDist> = {};\n   220\t  for (const k of Object.keys(sidecar.tarballs).sort()) {\n   221\t    tarballs[k] = sidecar.tarballs[k] as TarballDist;\n   222\t  }\n   223\t  const out =\n   224\t    sidecar.$comment !== undefined\n   225\t      ? { $comment: sidecar.$comment, tarballs }\n   226\t      : { tarballs };\n   227\t  writeFileSync(path, `${JSON.stringify(out, null, 2)}\\n`);\n   228\t}\n   229\t\n   230\t/** Pack a package into `<staging>/<slug>/<slug>-<version>.tgz` and return its bytes. Injectable for tests. */\n   231\texport type PackFn = (\n   232\t  packageDir: string,\n   233\t  slug: string,\n   234\t  version: string,\n   235\t  stagingDir: string,\n   236\t) => Uint8Array;\n   237\t\n   238\t/** Default pack: `bun pm pack` (execFile arg-array, no shell). Scope dropped via an explicit\n   239\t * --filename, passed as the FULL staged path — bun rejects --filename combined with\n   240\t * --destination (\"cannot use both filename and destination\"), so the path carries the dir.\n   241\t * Exported so the test suite can prove the byte-determinism the publish gate rests on. */\n   242\texport const defaultPack: PackFn = (packageDir, slug, version, stagingDir) => {\n   243\t  const outDir = join(stagingDir, slug);\n   244\t  mkdirSync(outDir, { recursive: true });\n   245\t  const filename = `${slug}-${version}.tgz`;\n   246\t  const res = spawnSync(\n   247\t    \"bun\",\n   248\t    [\n   249\t      \"pm\",\n   250\t      \"pack\",\n   251\t      \"--quiet\",\n   252\t      \"--ignore-scripts\",\n   253\t      \"--filename\",\n   254\t      join(outDir, filename),\n   255\t    ],\n   256\t    { cwd: packageDir, encoding: \"buffer\" },\n   257\t  );\n   258\t  if (res.status !== 0) {\n   259\t    throw new Error(\n   260\t      `bun pm pack failed for ${slug}@${version}: ${res.stderr?.toString() ?? \"unknown error\"}`,\n   261\t    );\n   262\t  }\n   263\t  return readFileSync(join(outDir, filename));\n   264\t};\n   265\t\n   266\texport interface RefreshVersionCandidateOpts {\n   267\t  /** PR-head checkout treated as data only; no source file under it is imported or executed. */\n   268\t  readonly candidateRoot: string;\n   269\t  /** Fork-point ledger materialized from the trusted merge base. */\n   270\t  readonly baseLedgerPath: string;\n   271\t  /** Fork-point sidecar materialized from the trusted merge base. */\n   272\t  readonly baseSidecarPath: string;\n   273\t  readonly dryRun?: boolean | undefined;\n   274\t  readonly stagingDir?: string | undefined;\n   275\t  readonly packFn?: PackFn | undefined;\n   276\t}\n   277\t\n   278\tconst CandidatePackage = z\n   279\t  .object({\n   280\t    name: z.string().regex(/^@caisson\\/[a-z0-9]+(?:-[a-z0-9]+)*$/),\n   281\t    version: z.string().regex(/^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$/),\n   282\t    private: z.boolean().optional(),\n   283\t  })\n   284\t  .strict();\n   285\t\n   286\tfunction candidatePackageKey(key: string): { slug: string; version: string } {\n   287\t  const match =\n   288\t    /^@caisson\\/([a-z0-9]+(?:-[a-z0-9]+)*)@(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)$/.exec(\n   289\t      key,\n   290\t    );\n   291\t  if (match?.[1] === undefined || match[2] === undefined) {\n   292\t    throw new Error(`invalid candidate tarball key: ${key}`);\n   293\t  }\n   294\t  return { slug: match[1], version: match[2] };\n   295\t}\n   296\t\n   297\tfunction pathInside(root: string, ...parts: string[]): string {\n   298\t  const path = resolve(root, ...parts);\n   299\t  if (!path.startsWith(`${root}${sep}`)) {\n   300\t    throw new Error(`candidate path escapes checkout root: ${path}`);\n   301\t  }\n   302\t  return path;\n   303\t}\n   304\t\n   305\t/**\n   306\t * Sibling-churn guard (CAISSON-124): every EXISTING sidecar row not in `skipKeys` (i.e. not freshly\n   307\t * (re-)recorded this run) whose package is still at that same version on this tree must still\n   308\t * re-pack to the bytes it advertises. When a consume bumps a `workspace:*` dependency, `bun pm\n   309\t * pack` rewrites that resolved version into an unchanged sibling's tarball — staling its row at\n   310\t * its own version. Shared by both call sites that can churn a sibling this way: the trusted\n   311\t * synchronize-refresh path (`refreshVersionCandidateTarballs`) and the initial dispatch\n   312\t * `--mode version` step (`runPublishStep`) — a single-shot version PR never fires a synchronize\n   313\t * event, so without this shared check that path skips the guard entirely (the bug this closes).\n   314\t * Superseded historical versions (package.json gone, or already bumped past the row) are\n   315\t * un-repackable from HEAD and out of scope — the live R2 probe (r2-parity-probe.ts) is their\n   316\t * integrity net.\n   317\t */\n   318\tfunction checkSiblingChurn(opts: {\n   319\t  sidecar: Sidecar;\n   320\t  skipKeys: ReadonlySet<string>;\n   321\t  packageDirFor: (slug: string) => string;\n   322\t  packFn: PackFn;\n   323\t  stagingDir: string;\n   324\t  lockfilePath: string;\n   325\t}): void {\n   326\t  const { sidecar, skipKeys, packageDirFor, packFn, stagingDir, lockfilePath } =\n   327\t    opts;\n   328\t  const runLockHash = currentLockHash(lockfilePath);\n   329\t  const siblingMismatches: string[] = [];\n   330\t  for (const key of Object.keys(sidecar.tarballs)) {\n   331\t    if (skipKeys.has(key)) continue; // freshly (re-)recorded this run\n   332\t    const { slug, version } = candidatePackageKey(key);\n   333\t    const packageDir = packageDirFor(slug);\n   334\t    const pkgJsonPath = join(packageDir, \"package.json\");\n   335\t    if (!existsSync(pkgJsonPath)) continue; // superseded — no longer on disk\n   336\t    const rawPackage = z\n   337\t      .record(z.string(), z.unknown())\n   338\t      .parse(JSON.parse(readFileSync(pkgJsonPath, \"utf8\")));\n   339\t    if (rawPackage.version !== version) continue; // superseded historical version\n   340\t    const recorded = sidecar.tarballs[key] as TarballDist;\n   341\t    // ADR-0365 / CAISSON-127 refinement (2026-07-19): the recorded lockHash covers the WHOLE\n   342\t    // bun.lock, and workspace version bumps legitimately change it every consume — so it can\n   343\t    // NEVER gate the re-pack (a short-circuit here mass-flags rows whose bytes are identical).\n   344\t    // Always re-pack and byte-compare; the hash's job is to make a REAL mismatch's cause\n   345\t    // legible (dependency-resolution drift vs a source edit).\n   346\t    const bytes = packFn(packageDir, slug, version, stagingDir);\n   347\t    const dist = computeTarballDist(bytes, slug, version);\n   348\t    if (dist.shasum !== recorded.shasum || dist.size !== recorded.size) {\n   349\t      const lockNote =\n   350\t        recorded.lockHash !== undefined &&\n   351\t        runLockHash !== undefined &&\n   352\t        recorded.lockHash !== runLockHash\n   353\t          ? ` — recorded under bun.lock sha256 ${recorded.lockHash.slice(0, 12)}…, this tree resolves ${runLockHash.slice(0, 12)}… (dependency-resolution drift)`\n   354\t          : \"\";\n   355\t      siblingMismatches.push(\n   356\t        `${key} (recorded=${recorded.shasum}/${String(recorded.size)}B, would-be=${dist.shasum}/${String(dist.size)}B)${lockNote}`,\n   357\t      );\n   358\t    }\n   359\t  }\n   360\t  if (siblingMismatches.length > 0) {\n   361\t    throw new Error(\n   362\t      `sibling-churn: these already-recorded rows no longer re-pack to their advertised bytes from this tree — a workspace dependency's resolved version changed since the row was recorded. Fix: add a changeset bumping each package's OWN version in this release so a fresh row is recorded, else the release fails at the publish/tag byte-gate:\\n  - ${siblingMismatches.join(\"\\n  - \")}`,\n   363\t    );\n   364\t  }\n   365\t}\n   366\t\n   367\t/**\n   368\t * Refresh an automation-authored version PR without executing PR-head code. The trusted base\n   369\t * workflow calls this function against a candidate checkout treated strictly as data: historical\n   370\t * ledger/sidecar material must be byte/deep-identical to the fork point, the new sidecar-key set\n   371\t * must exactly match appended publish rows, package identity comes from field-picked package.json,\n   372\t * and packing disables lifecycle scripts. Only candidate registry/tarballs.json is written.\n   373\t */\n   374\texport function refreshVersionCandidateTarballs(\n   375\t  opts: RefreshVersionCandidateOpts,\n   376\t): number {\n   377\t  const root = resolve(opts.candidateRoot);\n   378\t  const candidateLockfilePath = pathInside(root, \"bun.lock\");\n   379\t  const candidateLedgerPath = pathInside(root, \"registry\", \"ledger.jsonl\");\n   380\t  const candidateSidecarPath = pathInside(root, \"registry\", \"tarballs.json\");\n   381\t  const baseLedger = readFileSync(opts.baseLedgerPath, \"utf8\");\n   382\t  const candidateLedger = readFileSync(candidateLedgerPath, \"utf8\");\n   383\t  if (!candidateLedger.startsWith(baseLedger)) {\n   384\t    throw new Error(\n   385\t      \"version refresh rejected historical ledger drift from the fork point\",\n   386\t    );\n   387\t  }\n   388\t\n   389\t  const basePublishes = parseLedgerLines(baseLedger).publishes;\n   390\t  const candidatePublishes = parseLedgerLines(candidateLedger).publishes;\n   391\t  const basePublishKeys = new Set(\n   392\t    basePublishes.map((entry) => `${entry.id}@${entry.version}`),\n   393\t  );\n   394\t  const appendedPublishKeys = new Set(\n   395\t    candidatePublishes\n   396\t      .map((entry) => `${entry.id}@${entry.version}`)\n   397\t      .filter((key) => !basePublishKeys.has(key)),\n   398\t  );\n   399\t\n   400\t  const baseSidecar = readSidecar(opts.baseSidecarPath);\n   401\t  const candidateSidecar = readSidecar(candidateSidecarPath);\n   402\t  if (candidateSidecar.$comment !== baseSidecar.$comment) {\n   403\t    throw new Error(\n   404\t      \"version refresh rejected historical tarball row drift: sidecar comment changed\",\n   405\t    );\n   406\t  }\n   407\t  for (const [key, baseRow] of Object.entries(baseSidecar.tarballs)) {\n   408\t    const candidateRow = candidateSidecar.tarballs[key];\n   409\t    if (\n   410\t      candidateRow === undefined ||\n   411\t      !isDeepStrictEqual(candidateRow, baseRow)\n   412\t    ) {\n   413\t      throw new Error(\n   414\t        `version refresh rejected historical tarball row drift: ${key}`,\n   415\t      );\n   416\t    }\n   417\t  }\n   418\t\n   419\t  const candidateNewKeys = Object.keys(candidateSidecar.tarballs)\n   420\t    .filter((key) => baseSidecar.tarballs[key] === undefined)\n   421\t    .sort();\n   422\t  const unexpected = candidateNewKeys.filter(\n   423\t    (key) => !appendedPublishKeys.has(key),\n   424\t  );\n   425\t  const missing = [...appendedPublishKeys].filter(\n   426\t    (key) => !candidateNewKeys.includes(key),\n   427\t  );\n   428\t  if (unexpected.length > 0 || missing.length > 0) {\n   429\t    throw new Error(\n   430\t      `version refresh candidate rows do not exactly match appended ledger publishes (unexpected=${unexpected.join(\",\") || \"none\"}; missing=${missing.join(\",\") || \"none\"})`,\n   431\t    );\n   432\t  }\n   433\t\n   434\t  if (opts.dryRun === true) {\n   435\t    process.stdout.write(\n   436\t      `registry/ci-publish-step: dry-run — would securely re-pack ${candidateNewKeys.length} unmerged row(s)\\n`,\n   437\t    );\n   438\t    return 0;\n   439\t  }\n   440\t\n   441\t  const packFn = opts.packFn ?? defaultPack;\n   442\t  const stagingDir = opts.stagingDir ?? STAGING_DIR;\n   443\t  const newKeySet = new Set(candidateNewKeys);\n   444\t  const refreshLockHash = currentLockHash(candidateLockfilePath);\n   445\t  for (const key of candidateNewKeys) {\n   446\t    const { slug, version } = candidatePackageKey(key);\n   447\t    const packageDir = pathInside(root, \"packages\", slug);\n   448\t    const rawPackage = z\n   449\t      .record(z.string(), z.unknown())\n   450\t      .parse(\n   451\t        JSON.parse(readFileSync(join(packageDir, \"package.json\"), \"utf8\")),\n   452\t      );\n   453\t    const pkg = CandidatePackage.parse({\n   454\t      name: rawPackage.name,\n   455\t      version: rawPackage.version,\n   456\t      ...(rawPackage.private !== undefined\n   457\t        ? { private: rawPackage.private }\n   458\t        : {}),\n   459\t    });\n   460\t    if (\n   461\t      pkg.name !== `@caisson/${slug}` ||\n   462\t      pkg.version !== version ||\n   463\t      pkg.private === true\n   464\t    ) {\n   465\t      throw new Error(`candidate package identity does not match ${key}`);\n   466\t    }\n   467\t    const bytes = packFn(packageDir, slug, version, stagingDir);\n   468\t    candidateSidecar.tarballs[key] = {\n   469\t      ...computeTarballDist(bytes, slug, version),\n   470\t      ...(refreshLockHash !== undefined ? { lockHash: refreshLockHash } : {}),\n   471\t    };\n   472\t    process.stdout.write(\n   473\t      `registry/ci-publish-step: securely re-packed + re-recorded ${key}\\n`,\n   474\t    );\n   475\t  }\n   476\t\n   477\t  // Sibling-churn guard (shared with the dispatch --mode version step — CAISSON-124): catch it HERE,\n   478\t  // on the version PR, before merge, rather than hours later at the publish/tag byte-gate.\n   479\t  checkSiblingChurn({\n   480\t    sidecar: candidateSidecar,\n   481\t    skipKeys: newKeySet,\n   482\t    packageDirFor: (slug) => pathInside(root, \"packages\", slug),\n   483\t    packFn,\n   484\t    stagingDir,\n   485\t    lockfilePath: candidateLockfilePath,\n   486\t  });\n   487\t\n   488\t  if (candidateNewKeys.length > 0) {\n   489\t    writeSidecar(candidateSidecar, candidateSidecarPath);\n   490\t  }\n   491\t  return candidateNewKeys.length;\n   492\t}\n   493\t\n   494\texport type RecordTarballsOpts = {\n   495\t  dryRun: boolean;\n   496\t  sidecarPath?: string | undefined;\n   497\t  stagingDir?: string | undefined;\n   498\t  /**\n   499\t   * Existing keys that belong to an unmerged version PR and may therefore be re-packed. Historical\n   500\t   * rows remain append-only. The synchronize workflow derives this set by comparing with the branch\n   501\t   * fork point's sidecar.\n   502\t   */\n   503\t  replaceKeys?: ReadonlySet<string> | undefined;\n   504\t  /** Override the packer for isolated testing; defaults to a real `bun pm pack`. */\n   505\t  packFn?: PackFn | undefined;\n   506\t};\n   507\t\n   508\t/**\n   509\t * Pack + hash + record a sidecar row for each candidate package MISSING from the sidecar (already\n   510\t * filtered to non-private by `findManifestPaths`, so the `isPrivatePackage` exclusion is preserved —\n   511\t * a private package's manifest never reaches here). Append-only (ADR-0006): an existing historical\n   512\t * sidecar key is never overwritten (and never re-packed). The sole exception is an explicit\n   513\t * `replaceKeys` entry derived from rows introduced on an unmerged version branch; those bytes have not\n   514\t * shipped yet and must follow in-branch source edits. Callers pass the FULL current-workspace manifest\n   515\t * set, not just newly-ledgered versions, so a version ledgered before the sidecar existed still gets\n   516\t * backfilled (see runPublishStep). In dry-run nothing is packed or written. Returns rows recorded or\n   517\t * re-recorded.\n   518\t */\n   519\texport function recordTarballs(\n   520\t  candidates: { manifest: ModuleManifest; packageDir: string }[],\n   521\t  opts: RecordTarballsOpts,\n   522\t): number {\n   523\t  const {\n   524\t    dryRun,\n   525\t    sidecarPath = SIDECAR_PATH,\n   526\t    stagingDir = STAGING_DIR,\n   527\t    replaceKeys = new Set<string>(),\n   528\t    packFn = defaultPack,\n   529\t  } = opts;\n   530\t\n   531\t  if (candidates.length === 0) return 0;\n   532\t\n   533\t  if (dryRun) {\n   534\t    const sidecar = readSidecar(sidecarPath);\n   535\t    for (const { manifest } of candidates) {\n   536\t      const key = `${manifest.id}@${manifest.version}`;\n   537\t      if (sidecar.tarballs[key] !== undefined && !replaceKeys.has(key))\n   538\t        continue; // already packed — nothing to do\n   539\t      const slug = manifest.id.slice(\"@caisson/\".length);\n   540\t      process.stdout.write(\n   541\t        `registry/ci-publish-step: dry-run — would ${replaceKeys.has(key) ? \"re-pack\" : \"pack\"} ${key} → R2 key ${slug}/${slug}-${manifest.version}.tgz\\n`,\n   542\t      );\n   543\t    }\n   544\t    return 0;\n   545\t  }\n   546\t\n   547\t  const sidecar = readSidecar(sidecarPath);\n   548\t  let recorded = 0;\n   549\t  for (const { manifest, packageDir } of candidates) {\n   550\t    const key = `${manifest.id}@${manifest.version}`;\n   551\t    if (sidecar.tarballs[key] !== undefined && !replaceKeys.has(key)) {\n   552\t      process.stdout.write(\n   553\t        `registry/ci-publish-step: tarball already recorded — ${key} (append-only, kept)\\n`,\n   554\t      );\n   555\t      continue;\n   556\t    }\n   557\t    const slug = manifest.id.slice(\"@caisson/\".length);\n   558\t    const bytes = packFn(packageDir, slug, manifest.version, stagingDir);\n   559\t    const recordLockHash = currentLockHash();\n   560\t    sidecar.tarballs[key] = {\n   561\t      ...computeTarballDist(bytes, slug, manifest.version),\n   562\t      ...(recordLockHash !== undefined ? { lockHash: recordLockHash } : {}),\n   563\t    };\n   564\t    recorded++;\n   565\t    process.stdout.write(\n   566\t      `registry/ci-publish-step: ${replaceKeys.has(key) ? \"re-packed + re-recorded\" : \"packed + recorded\"} ${key} → ${sidecar.tarballs[key]?.key} (${sidecar.tarballs[key]?.size} bytes)\\n`,\n   567\t    );\n   568\t  }\n   569\t  if (recorded > 0) writeSidecar(sidecar, sidecarPath);\n   570\t  return recorded;\n   571\t}\n   572\t\n   573\t// ---------------------------------------------------------------------------\n   574\t// Types\n   575\t// ---------------------------------------------------------------------------\n   576\t\n   577\texport type PublishStepOpts = {\n   578\t  /** CI run identifier (e.g. github.run_id). Used in the gateAttestation. */\n   579\t  runId: string;\n   580\t  /**\n   581\t   * Full commit SHA of the run. In version mode: the main SHA the version PR was cut FROM,\n   582\t   * recorded in the gateAttestation (\"<run-id>@<sha>\") — the final version-commit SHA cannot\n   583\t   * be known while authoring its own content; the release tag anchors that (ADR-0325). In\n   584\t   * publish mode: the tag SHA (logging only; publish never writes an attestation).\n   585\t   */\n   586\t  sha: string;\n   587\t  /** ISO 8601 UTC timestamp from the CI clock — NEVER derived inside this function. */\n   588\t  publishedAt: string;\n   589\t  /** When true (default), reports what would happen without writing any files. */\n   590\t  dryRun: boolean;\n   591\t  /**\n   592\t   * ADR-0325 flow position. \"version\" (default): append ledger + rebuild index + pack/record\n   593\t   * sidecar rows — the version-PR writer. \"publish\": zero-mutation verify + stage at the\n   594\t   * release tag — every workspace version must already be ledgered + sidecar'd, index.json\n   595\t   * must be a byte-identical rebuild, and every re-packed tarball must hash to its recorded\n   596\t   * sidecar row. Any violation throws before the R2 upload step can run.\n   597\t   */\n   598\t  mode?: \"version\" | \"publish\" | undefined;\n   599\t  /** Override for isolated testing; defaults to the on-disk registry/ledger.jsonl. */\n   600\t  ledgerPath?: string | undefined;\n   601\t  /** Override for isolated testing; defaults to the on-disk registry/index.json. */\n   602\t  indexPath?: string | undefined;\n   603\t  /** Override for isolated testing; defaults to the monorepo packages/ dir. */\n   604\t  packagesDir?: string | undefined;\n   605\t  /** Override for isolated testing; defaults to the on-disk registry/tarballs.json. */\n   606\t  sidecarPath?: string | undefined;\n   607\t  /**\n   608\t   * Version mode only: sidecar from the release branch's fork point. Candidate keys absent there\n   609\t   * were introduced by the unmerged version PR and may be re-recorded after in-branch source edits.\n   610\t   */\n   611\t  refreshBaseSidecarPath?: string | undefined;\n   612\t  /** Override for isolated testing; defaults to registry/.tarball-staging. */\n   613\t  stagingDir?: string | undefined;\n   614\t  /** Override the packer for isolated testing; defaults to a real `bun pm pack`. */\n   615\t  packFn?: PackFn | undefined;\n   616\t};\n   617\t\n   618\texport type PublishStepResult = {\n   619\t  /** Entries actually appended to the ledger (always 0 in dry-run mode). */\n   620\t  appended: number;\n   621\t  /** Entries already recorded in the ledger (skipped as already published). */\n   622\t  skippedExisting: number;\n   623\t  /**\n   624\t   * Workspace manifests skipped because their id is delisted (ADR-0271) — split out from\n   625\t   * `skippedExisting` so the summary distinguishes \"already published\" from \"delisted, will\n   626\t   * never be (re-)published\" (a delisted id gets no tarball-sidecar reconcile either — see the\n   627\t   * loop below).\n   628\t   */\n   629\t  skippedDelisted: number;\n   630\t  /** New entries found but not appended due to dry-run mode. */\n   631\t  wouldAppend: number;\n   632\t  /** Tarball sidecar rows recorded (packed + hashed → tarballs.json; always 0 in dry-run). */\n   633\t  tarballsRecorded: number;\n   634\t  /**\n   635\t   * Publish mode only: workspace versions whose re-packed bytes hash-matched their sidecar row\n   636\t   * and are staged for the R2 upload step. Always 0 in version mode and in publish dry-run.\n   637\t   */\n   638\t  verifiedStaged: number;\n   639\t};\n   640\t\n   641\t// ---------------------------------------------------------------------------\n   642\t// Package manifest discovery\n   643\t// ---------------------------------------------------------------------------\n   644\t\n   645\t/** Absolute path to the monorepo root (two levels up from registry/scripts/). */\n   646\tconst DEFAULT_PACKAGES_DIR = join(import.meta.dir, \"..\", \"..\", \"packages\");\n   647\t\n   648\t/**\n   649\t * True when `<packageDir>/package.json` declares `private: true`. A private package (e.g.\n   650\t * `@caisson/license-issue`, ADR-0110 — the signing key must NEVER reach a buyer tarball) is\n   651\t * intentionally never published by changesets, so it must never be appended to the ledger\n   652\t * either — appending it would advertise an \"as if published\" version that npm never actually\n   653\t * carries (the inverse of ADR-0111's \"never-published = paid + no publishConfig\" invariant).\n   654\t * Data-driven off package.json, never a hardcoded package name. Missing/unparseable\n   655\t * package.json fails OPEN to \"not private\" — the standards-gate, not this script, is the\n   656\t * authority on manifest/package.json validity. Exported for isolated testing.\n   657\t */\n   658\texport function isPrivatePackage(packageDir: string): boolean {\n   659\t  const pkgJsonPath = join(packageDir, \"package.json\");\n   660\t  if (!existsSync(pkgJsonPath)) return false;\n   661\t  try {\n   662\t    const pkg = JSON.parse(readFileSync(pkgJsonPath, \"utf8\")) as {\n   663\t      private?: unknown;\n   664\t    };\n   665\t    return pkg.private === true;\n   666\t  } catch {\n   667\t    return false;\n   668\t  }\n   669\t}\n   670\t\n   671\t/**\n   672\t * Return absolute paths of every `packages/<name>/manifest.ts` that exists on disk, EXCLUDING\n   673\t * any package whose `package.json` declares `private: true` — a never-published package must\n   674\t * never reach the ledger/index (see `isPrivatePackage`). Exported for isolated testing.\n   675\t */\n   676\texport function findManifestPaths(\n   677\t  packagesDir: string = DEFAULT_PACKAGES_DIR,\n   678\t): string[] {\n   679\t  if (!existsSync(packagesDir)) return [];\n   680\t  return readdirSync(packagesDir, { withFileTypes: true })\n   681\t    .filter((d) => d.isDirectory())\n   682\t    .filter((d) => !isPrivatePackage(join(packagesDir, d.name)))\n   683\t    .map((d) => join(packagesDir, d.name, \"manifest.ts\"))\n   684\t    .filter((p) => existsSync(p));\n   685\t}\n   686\t\n   687\t// ---------------------------------------------------------------------------\n   688\t// Manifest loading\n   689\t// ---------------------------------------------------------------------------\n   690\t\n   691\t/**\n   692\t * Dynamically import a manifest.ts and return its default export.\n   693\t * The export is already a validated ModuleManifest — defineModule() runs Zod parse at module\n   694\t * load time, so a corrupt manifest throws on import. Exported for isolated testing.\n   695\t */\n   696\texport async function loadManifest(path: string): Promise<ModuleManifest> {\n   697\t  // Dynamic import; path is an absolute filesystem path resolved by the caller.\n   698\t  const mod = (await import(path)) as { default: ModuleManifest };\n   699\t  return mod.default;\n   700\t}\n   701\t\n   702\t// ---------------------------------------------------------------------------\n   703\t// Publish-mode verification (ADR-0325) — the zero-mutation release-tag path\n   704\t// ---------------------------------------------------------------------------\n   705\t\n   706\ttype VerifyForPublishOpts = {\n   707\t  loaded: { manifest: ModuleManifest; packageDir: string }[];\n   708\t  alreadyPublished: Set<string>;\n   709\t  skippedDelisted: number;\n   710\t  dryRun: boolean;\n   711\t  ledgerPath: string;\n   712\t  indexPath: string;\n   713\t  sidecarPath?: string | undefined;\n   714\t  stagingDir?: string | undefined;\n   715\t  packFn?: PackFn | undefined;\n   716\t};\n   717\t\n   718\t/**\n   719\t * ADR-0325 publish mode: the checked-out (tagged) tree must already BE the release. Verifies\n   720\t * every non-private workspace version is ledgered + sidecar'd and index.json is a byte-identical\n   721\t * ledger rebuild, then (live) re-packs each tarball and requires its bytes to hash to EXACTLY\n   722\t * the sidecar row the version PR recorded. Packing stages tarballs under stagingDir for the R2\n   723\t * upload step; NO tracked file is written on any path through this function. Failures are\n   724\t * collected so one run reports every problem, then thrown — the workflow stops before any\n   725\t * external write.\n   726\t */\n   727\tfunction verifyForPublish(opts: VerifyForPublishOpts): PublishStepResult {\n   728\t  const {\n   729\t    loaded,\n   730\t    alreadyPublished,\n   731\t    skippedDelisted,\n   732\t    dryRun,\n   733\t    ledgerPath,\n   734\t    indexPath,\n   735\t    sidecarPath = SIDECAR_PATH,\n   736\t    stagingDir = STAGING_DIR,\n   737\t    packFn = defaultPack,\n   738\t  } = opts;\n   739\t  const problems: string[] = [];\n   740\t  const sidecar = readSidecar(sidecarPath);\n   741\t\n   742\t  // 1) Every workspace version must already be ledgered AND sidecar'd — that was the version\n   743\t  //    PR's job; a miss means the tag was cut on a commit without (or before) the version PR.\n   744\t  for (const { manifest } of loaded) {\n   745\t    const key = `${manifest.id}@${manifest.version}`;\n   746\t    if (!alreadyPublished.has(key)) {\n   747\t      problems.push(\n   748\t        `${key}: not in the ledger — the tagged commit does not include its version PR`,\n   749\t      );\n   750\t    }\n   751\t    if (sidecar.tarballs[key] === undefined) {\n   752\t      problems.push(\n   753\t        `${key}: no tarballs.json row — the version PR did not record it`,\n   754\t      );\n   755\t    }\n   756\t  }\n   757\t\n   758\t  // 2) index.json must be a byte-identical rebuild of the ledger. Same proof as ci.yml's\n   759\t  //    registry-index check (already green on the version commit) — re-run here so a manual\n   760\t  //    publish dispatch is self-contained rather than trusting run ordering.\n   761\t  const rebuilt = Buffer.from(buildIndexFromLedgerFile(ledgerPath));\n   762\t  const onDisk = existsSync(indexPath)\n   763\t    ? readFileSync(indexPath)\n   764\t    : Buffer.alloc(0);\n   765\t  if (!rebuilt.equals(onDisk)) {\n   766\t    problems.push(\n   767\t      `index.json is not a byte-identical rebuild of the ledger at ${ledgerPath}`,\n   768\t    );\n   769\t  }\n   770\t\n   771\t  if (problems.length > 0) {\n   772\t    throw new Error(\n   773\t      `publish-mode verification failed (fix: merge a fresh version PR and cut the tag on its merge commit):\\n  - ${problems.join(\"\\n  - \")}`,\n   774\t    );\n   775\t  }\n   776\t\n   777\t  if (dryRun) {\n   778\t    process.stdout.write(\n   779\t      `registry/ci-publish-step: publish dry-run — ledger/sidecar/index consistent; would re-pack + hash-verify + stage ${loaded.length} tarball(s)\\n`,\n   780\t    );\n   781\t    return {\n   782\t      appended: 0,\n   783\t      skippedExisting: 0,\n   784\t      skippedDelisted,\n   785\t      wouldAppend: 0,\n   786\t      tarballsRecorded: 0,\n   787\t      verifiedStaged: 0,\n   788\t    };\n   789\t  }\n   790\t\n   791\t  // 3) Re-pack at the tagged source and require byte-equality with the recorded row. `bun pm\n   792\t  //    pack` is byte-deterministic for identical source bytes (mtimes are normalized), so a\n   793\t  //    mismatch means the tagged tree is NOT the source the version PR hashed — stop before any\n   794\t  //    external write. The R2 upload step then skips objects that already exist, so re-verified\n   795\t  //    old versions are never re-uploaded (rerun-safe, never-overwrite — ADR-0325 point 5).\n   796\t  // ponytail: rows are verified against a re-pack under the PINNED bun (1.4.2 everywhere). If a\n   797\t  // future bun bump changes the pack byte format, old unchanged versions will fail loudly here;\n   798\t  // the upgrade path is a one-off operator re-record of affected rows, not a silent skip.\n   799\t  const mismatches: string[] = [];\n   800\t  let staged = 0;\n   801\t  const publishLockHash = currentLockHash();\n   802\t  for (const { manifest, packageDir } of loaded) {\n   803\t    const key = `${manifest.id}@${manifest.version}`;\n   804\t    const row = sidecar.tarballs[key] as TarballDist; // presence proven in (1)\n   805\t    const slug = manifest.id.slice(\"@caisson/\".length);\n   806\t    const bytes = packFn(packageDir, slug, manifest.version, stagingDir);\n   807\t    const dist = computeTarballDist(bytes, slug, manifest.version);\n   808\t    // `lockHash` is record-time provenance, not tarball content — excluded from the byte-equality\n   809\t    // compare (ADR-0365). On a mismatch it names the cause when the resolutions differ.\n   810\t    const { lockHash: recordedLockHash, ...rowContent } = row;\n   811\t    if (!isDeepStrictEqual(dist, rowContent)) {\n   812\t      const lockNote =\n   813\t        recordedLockHash !== undefined &&\n   814\t        publishLockHash !== undefined &&\n   815\t        recordedLockHash !== publishLockHash\n   816\t          ? \" — recorded under a DIFFERENT bun.lock resolution (lock-hash drift); bump the package's own version to re-record\"\n   817\t          : \"\";\n   818\t      mismatches.push(\n   819\t        `${key}: packed distribution record does not exactly match sidecar (packed=${dist.shasum}/${dist.size}B, recorded=${row.shasum}/${row.size}B)${lockNote}`,\n   820\t      );\n   821\t      continue;\n   822\t    }\n   823\t    staged++;\n   824\t    process.stdout.write(\n   825\t      `registry/ci-publish-step: verified ${key} — packed bytes match the recorded row; staged ${row.key}\\n`,\n   826\t    );\n   827\t  }\n   828\t  if (mismatches.length > 0) {\n   829\t    throw new Error(\n   830\t      `publish-mode tarball verification failed — the tagged tree does not reproduce the recorded bytes. Rows are append-only, so a post-recording edit to packed files (CHANGELOG, package.json, src) goes permanently stale — a fresh version PR will NOT re-record an existing row. Fix: from a PRISTINE checkout of the intended tag commit, delete the stale rows and re-run --mode version to re-record them (first ride, 2026-07-12):\\n  - ${mismatches.join(\"\\n  - \")}`,\n   831\t    );\n   832\t  }\n   833\t  return {\n   834\t    appended: 0,\n   835\t    skippedExisting: 0,\n   836\t    skippedDelisted,\n   837\t    wouldAppend: 0,\n   838\t    tarballsRecorded: 0,\n   839\t    verifiedStaged: staged,\n   840\t  };\n   841\t}\n   842\t\n   843\t// ---------------------------------------------------------------------------\n   844\t// Core step logic\n   845\t// ---------------------------------------------------------------------------\n   846\t\n   847\t/**\n   848\t * Scan workspace manifests, compare against the on-disk ledger, and — in version mode (default,\n   849\t * live) — append new (id, version) pairs + rebuild index.json + pack/record sidecar rows. In\n   850\t * publish mode (ADR-0325), verify + stage only (see verifyForPublish). In dry-run mode reports\n   851\t * planned actions only; no file is written.\n   852\t */\n   853\texport async function runPublishStep(\n   854\t  opts: PublishStepOpts,\n   855\t): Promise<PublishStepResult> {\n   856\t  const {\n   857\t    runId,\n   858\t    sha,\n   859\t    publishedAt,\n   860\t    dryRun,\n   861\t    mode = \"version\",\n   862\t    ledgerPath = LEDGER_PATH,\n   863\t    indexPath = INDEX_PATH,\n   864\t    packagesDir = DEFAULT_PACKAGES_DIR,\n   865\t    sidecarPath,\n   866\t    refreshBaseSidecarPath,\n   867\t    stagingDir,\n   868\t    packFn,\n   869\t  } = opts;\n   870\t\n   871\t  const label = dryRun ? \"[dry-run]\" : \"[live]\";\n   872\t  process.stdout.write(\n   873\t    `registry/ci-publish-step: ${label} mode=${mode} run=${runId || \"??\"} sha=${sha.slice(0, 7) || \"??\"} at=${publishedAt || \"??\"}\\n`,\n   874\t  );\n   875\t\n   876\t  // Parse the existing ledger to identify already-recorded (id@version) pairs and the MODULE-level\n   877\t  // delisted ids (ADR-0271): a delisted module still has a workspace manifest, but appending a new\n   878\t  // publish for it would be a ledger error (delisting is terminal) — skip it loudly instead of\n   879\t  // failing the run. Filtered to `d.version === undefined` (ADR-0359) — a version-level delist\n   880\t  // marks only ONE historical version as unpublished, not the whole module; folding it into this\n   881\t  // set would wrongly treat every live module with a pruned old version as fully delisted and\n   882\t  // silently skip its next version bump from the ledger/index/tarballs (catalog-freeze bug).\n   883\t  const rawLedger = existsSync(ledgerPath)\n   884\t    ? readFileSync(ledgerPath, \"utf8\")\n   885\t    : \"\";\n   886\t  const { publishes: existingEntries, delists } = parseLedgerLines(rawLedger);\n   887\t  const alreadyPublished = new Set(\n   888\t    existingEntries.map((e) => `${e.id}@${e.version}`),\n   889\t  );\n   890\t  const delistedIds = new Set(\n   891\t    delists.filter((d) => d.version === undefined).map((d) => d.id),\n   892\t  );\n   893\t\n   894\t  // Discover all workspace package manifest.ts files.\n   895\t  const manifestPaths = findManifestPaths(packagesDir);\n   896\t  process.stdout.write(\n   897\t    `registry/ci-publish-step: found ${manifestPaths.length} manifest file(s) under ${packagesDir}\\n`,\n   898\t  );\n   899\t\n   900\t  // Every successfully-loaded, non-private workspace manifest (the current checkout's versions).\n   901\t  // The tarball sidecar is reconciled over this FULL set, not just `toAppend`, so a version that was\n   902\t  // ledgered before the sidecar mechanism existed still gets its tarball packed (the finding-2 backfill).\n   903\t  const loaded: { manifest: ModuleManifest; packageDir: string }[] = [];\n   904\t  const toAppend: { manifest: ModuleManifest; packageDir: string }[] = [];\n   905\t  let skippedExisting = 0;\n   906\t  let skippedDelisted = 0;\n   907\t\n   908\t  for (const p of manifestPaths) {\n   909\t    let manifest: ModuleManifest;\n   910\t    try {\n   911\t      manifest = await loadManifest(p);\n   912\t    } catch (err) {\n   913\t      process.stderr.write(\n   914\t        `registry/ci-publish-step: SKIP ${p} — load error: ${(err as Error).message}\\n`,\n   915\t      );\n   916\t      continue;\n   917\t    }\n   918\t    const key = `${manifest.id}@${manifest.version}`;\n   919\t    if (delistedIds.has(manifest.id)) {\n   920\t      // Not pushed to `loaded` either: a delisted module gets no tarball-sidecar reconcile — it has\n   921\t      // no index entry to serve from. Counted separately from `skippedExisting` (ADR-0271) — this\n   922\t      // id will NEVER be (re-)published, unlike an ordinary already-ledgered skip.\n   923\t      process.stdout.write(\n   924\t        `registry/ci-publish-step: delisted — skipped ${key}\\n`,\n   925\t      );\n   926\t      skippedDelisted++;\n   927\t      continue;\n   928\t    }\n   929\t    loaded.push({ manifest, packageDir: dirname(p) });\n   930\t    if (alreadyPublished.has(key)) {\n   931\t      process.stdout.write(\n   932\t        `registry/ci-publish-step: already in ledger — ${key}\\n`,\n   933\t      );\n   934\t      skippedExisting++;\n   935\t    } else {\n   936\t      process.stdout.write(\n   937\t        `registry/ci-publish-step: queued for append — ${key}\\n`,\n   938\t      );\n   939\t      toAppend.push({ manifest, packageDir: dirname(p) });\n   940\t    }\n   941\t  }\n   942\t\n   943\t  // ADR-0325 publish mode: the tagged tree must already BE the release — verify + stage,\n   944\t  // never write. Handles its own dry-run (metadata checks run; packing is skipped).\n   945\t  if (mode === \"publish\") {\n   946\t    return verifyForPublish({\n   947\t      loaded,\n   948\t      alreadyPublished,\n   949\t      skippedDelisted,\n   950\t      dryRun,\n   951\t      ledgerPath,\n   952\t      indexPath,\n   953\t      sidecarPath,\n   954\t      stagingDir,\n   955\t      packFn,\n   956\t    });\n   957\t  }\n   958\t\n   959\t  let replaceKeys: ReadonlySet<string> = new Set<string>();\n   960\t  if (refreshBaseSidecarPath !== undefined) {\n   961\t    if (!existsSync(refreshBaseSidecarPath)) {\n   962\t      throw new Error(\n   963\t        `version refresh base sidecar does not exist: ${refreshBaseSidecarPath}`,\n   964\t      );\n   965\t    }\n   966\t    const baseSidecar = readSidecar(refreshBaseSidecarPath);\n   967\t    replaceKeys = new Set(\n   968\t      loaded\n   969\t        .map(({ manifest }) => `${manifest.id}@${manifest.version}`)\n   970\t        .filter((key) => baseSidecar.tarballs[key] === undefined),\n   971\t    );\n   972\t    process.stdout.write(\n   973\t      `registry/ci-publish-step: version refresh — ${replaceKeys.size} unmerged row(s) may be re-recorded\\n`,\n   974\t    );\n   975\t  }\n   976\t\n   977\t  if (dryRun) {\n   978\t    process.stdout.write(\n   979\t      toAppend.length > 0\n   980\t        ? `registry/ci-publish-step: dry-run — ${toAppend.length} entry(s) would be appended; no writes performed\\n`\n   981\t        : \"registry/ci-publish-step: dry-run — nothing new to append; ledger/index unchanged\\n\",\n   982\t    );\n   983\t    // Log the planned tarball pack/upload set over the FULL workspace (backfill-aware); writes\n   984\t    // nothing (R2 upload gate stays closed).\n   985\t    recordTarballs(loaded, {\n   986\t      dryRun: true,\n   987\t      sidecarPath,\n   988\t      stagingDir,\n   989\t      replaceKeys,\n   990\t      packFn,\n   991\t    });\n   992\t    return {\n   993\t      appended: 0,\n   994\t      skippedExisting,\n   995\t      skippedDelisted,\n   996\t      wouldAppend: toAppend.length,\n   997\t      tarballsRecorded: 0,\n   998\t      verifiedStaged: 0,\n   999\t    };\n  1000\t  }\n  1001\t\n  1002\t  // Live mode — append each new entry to the ledger + rebuild index (only when there IS something\n  1003\t  // new; a steady-state run leaves ledger/index byte-identical). fail-closed: appendLedger throws\n  1004\t  // before any write on an invalid manifest.\n  1005\t  if (toAppend.length > 0) {\n  1006\t    // \"<run-id>@<base-sha>\" — the SHA the version PR was cut FROM, not the release SHA (a commit\n  1007\t    // cannot contain its own hash; the release tag anchors the final state). See PublishStepOpts.sha.\n  1008\t    const gateAttestation = `${runId}@${sha}`;\n  1009\t    for (const { manifest } of toAppend) {\n  1010\t      appendLedger({ manifest, publishedAt, gateAttestation, ledgerPath });\n  1011\t      process.stdout.write(\n  1012\t        `registry/ci-publish-step: appended ${manifest.id}@${manifest.version}\\n`,\n  1013\t      );\n  1014\t    }\n  1015\t    const bytes = buildIndexFromLedgerFile(ledgerPath);\n  1016\t    writeFileSync(indexPath, bytes);\n  1017\t    process.stdout.write(\n  1018\t      `registry/ci-publish-step: rebuilt index.json → ${indexPath} (${bytes.length} bytes)\\n`,\n  1019\t    );\n  1020\t  } else {\n  1021\t    process.stdout.write(\n  1022\t      \"registry/ci-publish-step: nothing new to append; ledger/index unchanged\\n\",\n  1023\t    );\n  1024\t  }\n  1025\t\n  1026\t  // Reconcile the tarball sidecar over EVERY current-workspace version (append-only; packs only the\n  1027\t  // versions missing a row). This backfills the catalog that was ledgered before the sidecar existed\n  1028\t  // — else a steady-state run packs nothing and every packument returns versions:{} (finding-2).\n  1029\t  // Snapshot which keys the sidecar already carried BEFORE this run packs anything — mirrors\n  1030\t  // recordTarballs' own pack condition exactly, so \"just (re-)recorded this run\" below can't drift\n  1031\t  // from what recordTarballs actually wrote.\n  1032\t  const sidecarBefore = readSidecar(sidecarPath).tarballs;\n  1033\t  const tarballsRecorded = recordTarballs(loaded, {\n  1034\t    dryRun: false,\n  1035\t    sidecarPath,\n  1036\t    stagingDir,\n  1037\t    replaceKeys,\n  1038\t    packFn,\n  1039\t  });\n  1040\t\n  1041\t  // Sibling-churn guard (CAISSON-124): run the same repack-and-compare check the synchronize\n  1042\t  // refresh job runs, but INSIDE this initial dispatch step — a single-shot version PR (created\n  1043\t  // here, merged with no follow-up push) never fires a synchronize event, so this was previously\n  1044\t  // the only place the check never ran, and a churned sibling row sailed through to the\n  1045\t  // publish-time byte gate instead.\n  1046\t  const justRecordedKeys = new Set(\n  1047\t    loaded\n  1048\t      .map(({ manifest }) => `${manifest.id}@${manifest.version}`)\n  1049\t      .filter(\n  1050\t        (key) => sidecarBefore[key] === undefined || replaceKeys.has(key),\n  1051\t      ),\n  1052\t  );\n  1053\t  checkSiblingChurn({\n  1054\t    sidecar: readSidecar(sidecarPath),\n  1055\t    skipKeys: justRecordedKeys,\n  1056\t    packageDirFor: (slug) => join(packagesDir, slug),\n  1057\t    packFn: packFn ?? defaultPack,\n  1058\t    stagingDir: stagingDir ?? STAGING_DIR,\n  1059\t    lockfilePath: LOCKFILE_PATH,\n  1060\t  });\n  1061\t\n  1062\t  return {\n  1063\t    appended: toAppend.length,\n  1064\t    skippedExisting,\n  1065\t    skippedDelisted,\n  1066\t    wouldAppend: 0,\n  1067\t    tarballsRecorded,\n  1068\t    verifiedStaged: 0,\n  1069\t  };\n  1070\t}\n  1071\t\n  1072\t// ---------------------------------------------------------------------------\n  1073\t// CLI entry point\n  1074\t// ---------------------------------------------------------------------------\n  1075\t\n  1076\ttype CliArgs = Omit<\n  1077\t  PublishStepOpts,\n  1078\t  \"ledgerPath\" | \"indexPath\" | \"packagesDir\"\n  1079\t> & {\n  1080\t  refreshCandidateRoot?: string | undefined;\n  1081\t  refreshBaseLedgerPath?: string | undefined;\n  1082\t};\n  1083\t\n  1084\tfunction parseCliArgs(): CliArgs {\n  1085\t  const argv = process.argv.slice(2);\n  1086\t  let runId = \"\";\n  1087\t  let sha = \"\";\n  1088\t  let publishedAt = \"\";\n  1089\t  let dryRun = true; // safe default: never publish unless the caller explicitly says \"false\"\n  1090\t  let mode: \"version\" | \"publish\" = \"version\";\n  1091\t  let refreshBaseSidecarPath: string | undefined;\n  1092\t  let refreshCandidateRoot: string | undefined;\n  1093\t  let refreshBaseLedgerPath: string | undefined;\n  1094\t\n  1095\t  for (let i = 0; i < argv.length; i++) {\n  1096\t    const flag = argv[i];\n  1097\t    if (flag === undefined) break;\n  1098\t    const val = argv[i + 1];\n  1099\t    if (flag === \"--run-id\" && val !== undefined) {\n  1100\t      runId = val;\n  1101\t      i++;\n  1102\t    } else if (flag === \"--sha\" && val !== undefined) {\n  1103\t      sha = val;\n  1104\t      i++;\n  1105\t    } else if (flag === \"--published-at\" && val !== undefined) {\n  1106\t      publishedAt = val;\n  1107\t      i++;\n  1108\t    } else if (flag === \"--dry-run\" && val !== undefined) {\n  1109\t      dryRun = val !== \"false\";\n  1110\t      i++;\n  1111\t    } else if (flag === \"--mode\" && val !== undefined) {\n  1112\t      if (val !== \"version\" && val !== \"publish\") {\n  1113\t        process.stderr.write(\n  1114\t          `registry/ci-publish-step: fatal: --mode must be \"version\" or \"publish\", got \"${val}\"\\n`,\n  1115\t        );\n  1116\t        process.exit(1);\n  1117\t      }\n  1118\t      mode = val;\n  1119\t      i++;\n  1120\t    } else if (flag === \"--refresh-base-sidecar\" && val !== undefined) {\n  1121\t      refreshBaseSidecarPath = val;\n  1122\t      i++;\n  1123\t    } else if (flag === \"--refresh-candidate-root\" && val !== undefined) {\n  1124\t      refreshCandidateRoot = val;\n  1125\t      i++;\n  1126\t    } else if (flag === \"--refresh-base-ledger\" && val !== undefined) {\n  1127\t      refreshBaseLedgerPath = val;\n  1128\t      i++;\n  1129\t    }\n  1130\t  }\n  1131\t\n  1132\t  return {\n  1133\t    runId,\n  1134\t    sha,\n  1135\t    publishedAt,\n  1136\t    dryRun,\n  1137\t    mode,\n  1138\t    refreshBaseSidecarPath,\n  1139\t    refreshCandidateRoot,\n  1140\t    refreshBaseLedgerPath,\n  1141\t  };\n  1142\t}\n  1143\t\n  1144\tif (import.meta.main) {\n  1145\t  const {\n  1146\t    refreshCandidateRoot,\n  1147\t    refreshBaseLedgerPath,\n  1148\t    refreshBaseSidecarPath,\n  1149\t    ...publishArgs\n  1150\t  } = parseCliArgs();\n  1151\t  if (refreshCandidateRoot !== undefined) {\n  1152\t    try {\n  1153\t      if (\n  1154\t        refreshBaseLedgerPath === undefined ||\n  1155\t        refreshBaseSidecarPath === undefined\n  1156\t      ) {\n  1157\t        throw new Error(\n  1158\t          \"--refresh-candidate-root requires --refresh-base-ledger and --refresh-base-sidecar\",\n  1159\t        );\n  1160\t      }\n  1161\t      refreshVersionCandidateTarballs({\n  1162\t        candidateRoot: refreshCandidateRoot,\n  1163\t        baseLedgerPath: refreshBaseLedgerPath,\n  1164\t        baseSidecarPath: refreshBaseSidecarPath,\n  1165\t        dryRun: publishArgs.dryRun,\n  1166\t      });\n  1167\t    } catch (err: unknown) {\n  1168\t      process.stderr.write(\n  1169\t        `registry/ci-publish-step: fatal: ${(err as Error).message}\\n`,\n  1170\t      );\n  1171\t      process.exit(1);\n  1172\t    }\n  1173\t  } else {\n  1174\t    runPublishStep({\n  1175\t      ...publishArgs,\n  1176\t      refreshBaseSidecarPath,\n  1177\t    }).catch((err: unknown) => {\n  1178\t      process.stderr.write(\n  1179\t        `registry/ci-publish-step: fatal: ${(err as Error).message}\\n`,\n  1180\t      );\n  1181\t      process.exit(1);\n  1182\t    });\n  1183\t  }\n  1184\t}\n","exit_code":0,"status":"completed"}}
