{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba services/support-bot/src/caisson_support_bot/__main__.py'","aggregated_output":"     1\t\"\"\"Entrypoint: wire the Discord worker and own its complete disposable lifecycle.\n     2\t\n     3\t``Settings`` fails closed before remote clients are created. SIGTERM closes the privileged-work\n     4\tgate before Discord and bounds every cleanup stage, so a supervisor can replace the process without\n     5\toverlapping role mutations or waiting indefinitely on a remote service.\n     6\t\"\"\"\n     7\t\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport asyncio\n    11\timport signal\n    12\timport sys\n    13\tfrom collections.abc import Awaitable\n    14\t\n    15\timport asyncpg\n    16\timport httpx\n    17\tfrom aiohttp import web\n    18\tfrom pydantic import ValidationError\n    19\t\n    20\tfrom .analytics import AnswerAnalytics\n    21\tfrom .billing_grant import serve_http\n    22\tfrom .bot import make_bot\n    23\tfrom .config import Settings\n    24\tfrom .docs_client import DocsClient\n    25\tfrom .escalation import PostgresTicketStore\n    26\tfrom .heartbeat import run_heartbeat\n    27\tfrom .inference import OpenRouterInference\n    28\tfrom .lifecycle import PrivilegedWorkGate, run_gateway\n    29\tfrom .rag import RagPipeline\n    30\tfrom .telemetry import init_telemetry\n    31\t\n    32\t\n    33\tasync def _create_database_pool(database_url: str) -> asyncpg.Pool:\n    34\t    return await asyncpg.create_pool(\n    35\t        database_url,\n    36\t        min_size=0,\n    37\t        max_size=2,\n    38\t        max_inactive_connection_lifetime=20.0,\n    39\t        timeout=4.0,\n    40\t        command_timeout=25.0,\n    41\t        server_settings={\n    42\t            \"statement_timeout\": \"25000\",\n    43\t            \"idle_in_transaction_session_timeout\": \"25000\",\n    44\t        },\n    45\t    )\n    46\t\n    47\t\n    48\tdef _install_shutdown_handlers(shutdown: asyncio.Event) -> tuple[signal.Signals, ...]:\n    49\t    \"\"\"Route SIGTERM/SIGINT into the async lifecycle (the Linux container path).\"\"\"\n    50\t    loop = asyncio.get_running_loop()\n    51\t    installed: list[signal.Signals] = []\n    52\t    for sig in (signal.SIGTERM, signal.SIGINT):\n    53\t        try:\n    54\t            loop.add_signal_handler(sig, shutdown.set)\n    55\t            installed.append(sig)\n    56\t        except NotImplementedError:  # pragma: no cover - Windows, not the production container.\n    57\t            continue\n    58\t    return tuple(installed)\n    59\t\n    60\t\n    61\tasync def _bounded_cleanup(label: str, operation: Awaitable[object], timeout_s: float) -> None:\n    62\t    \"\"\"Never let a remote client hold the disposable process beyond its cleanup deadline.\"\"\"\n    63\t    try:\n    64\t        await asyncio.wait_for(operation, timeout=timeout_s)\n    65\t    except TimeoutError:\n    66\t        sys.stderr.write(f\"[support-bot] {label} cleanup timed out\\n\")\n    67\t    except Exception as exc:  # noqa: BLE001 - independent cleanup stages must continue.\n    68\t        # Exception class only: remote SDK messages can include request metadata.\n    69\t        sys.stderr.write(f\"[support-bot] {label} cleanup failed ({type(exc).__name__})\\n\")\n    70\t\n    71\t\n    72\tasync def _run(settings: Settings) -> None:\n    73\t    shutdown = asyncio.Event()\n    74\t    installed_signals = _install_shutdown_handlers(shutdown)\n    75\t    init_telemetry()  # env-gated OTLP export; patch httpx/asyncpg before constructing clients.\n    76\t    try:\n    77\t        timeout = httpx.Timeout(settings.request_timeout_s)\n    78\t        async with httpx.AsyncClient(timeout=timeout) as http:\n    79\t            pool: asyncpg.Pool | None = None\n    80\t            http_runner: web.AppRunner | None = None\n    81\t            heartbeat_task: asyncio.Task[None] | None = None\n    82\t            try:\n    83\t                docs = DocsClient(\n    84\t                    query_url=settings.docs_query_url,\n    85\t                    token=settings.docs_service_token,\n    86\t                    client=http,\n    87\t                    default_k=settings.retrieval_k,\n    88\t                )\n    89\t                # Constructed first so capture_generation can observe the inference client.\n    90\t                analytics = (\n    91\t                    AnswerAnalytics(\n    92\t                        key=settings.posthog_capture_key,\n    93\t                        host=settings.posthog_capture_host,\n    94\t                        client=http,\n    95\t                    )\n    96\t                    if settings.posthog_capture_key\n    97\t                    else None\n    98\t                )\n    99\t                inference = OpenRouterInference(\n   100\t                    api_key=settings.openrouter_api_key,\n   101\t                    model=settings.openrouter_model,\n   102\t                    client=http,\n   103\t                    referer=settings.openrouter_referer,\n   104\t                    on_generation=(analytics.capture_generation if analytics is not None else None),\n   105\t                )\n   106\t                pipeline = RagPipeline(\n   107\t                    docs=docs,\n   108\t                    inference=inference,\n   109\t                    k=settings.retrieval_k,\n   110\t                    confidence_high=settings.support_confidence_high,\n   111\t                    confidence_low=settings.support_confidence_low,\n   112\t                )\n   113\t\n   114\t                store: PostgresTicketStore | None = None\n   115\t                if settings.database_url:\n   116\t                    pool = await _create_database_pool(settings.database_url)\n   117\t                    store = PostgresTicketStore(pool)\n   118\t                    await store.ensure_schema()\n   119\t\n   120\t                bot = make_bot(\n   121\t                    settings=settings,\n   122\t                    pipeline=pipeline,\n   123\t                    store=store,\n   124\t                    http_client=http,\n   125\t                    analytics=analytics,\n   126\t                )\n   127\t                work_gate = PrivilegedWorkGate()\n   128\t                http_runner = await serve_http(\n   129\t                    bot=bot,\n   130\t                    settings=settings,\n   131\t                    port=settings.health_port,\n   132\t                    store=store,\n   133\t                    http_client=http,\n   134\t                    work_gate=work_gate,\n   135\t                )\n   136\t\n   137\t                if settings.heartbeat_enabled:\n   138\t                    project_id = settings.google_cloud_project\n   139\t                    if project_id is None:  # Settings narrows this; guard survives optimized mode.\n   140\t                        raise RuntimeError(\n   141\t                            \"heartbeat project missing after configuration validation\"\n   142\t                        )\n   143\t                    heartbeat_task = asyncio.create_task(\n   144\t                        run_heartbeat(\n   145\t                            project_id=project_id,\n   146\t                            interval_s=settings.heartbeat_interval_s,\n   147\t                            stop=shutdown,\n   148\t                            is_gateway_ready=bot.is_ready,\n   149\t                        ),\n   150\t                        name=\"gcp-heartbeat\",\n   151\t                    )\n   152\t\n   153\t                await run_gateway(\n   154\t                    bot=bot,\n   155\t                    token=settings.discord_token,\n   156\t                    shutdown=shutdown,\n   157\t                    work_gate=work_gate,\n   158\t                    shutdown_grace_s=settings.shutdown_grace_s,\n   159\t                )\n   160\t            finally:\n   161\t                shutdown.set()\n   162\t                if heartbeat_task is not None:\n   163\t                    await _bounded_cleanup(\"heartbeat\", heartbeat_task, settings.shutdown_grace_s)\n   164\t                if http_runner is not None:\n   165\t                    await _bounded_cleanup(\n   166\t                        \"HTTP server\", http_runner.cleanup(), settings.shutdown_grace_s\n   167\t                    )\n   168\t                if pool is not None:\n   169\t                    await _bounded_cleanup(\"database pool\", pool.close(), settings.shutdown_grace_s)\n   170\t    finally:\n   171\t        loop = asyncio.get_running_loop()\n   172\t        for sig in installed_signals:\n   173\t            loop.remove_signal_handler(sig)\n   174\t\n   175\t\n   176\tdef main() -> None:\n   177\t    try:\n   178\t        settings = Settings()  # type: ignore[call-arg]  # values come from the environment.\n   179\t    except ValidationError as exc:\n   180\t        sys.stderr.write(\n   181\t            \"[support-bot] refusing to start — missing/invalid configuration:\\n\"\n   182\t            f\"{exc}\\n\"\n   183\t            \"Required env: DISCORD_TOKEN, OPENROUTER_API_KEY, DOCS_SERVICE_URL, DOCS_SERVICE_TOKEN.\\n\"\n   184\t        )\n   185\t        raise SystemExit(1) from exc\n   186\t    asyncio.run(_run(settings))\n   187\t\n   188\t\n   189\tif __name__ == \"__main__\":\n   190\t    main()\n","exit_code":0,"status":"completed"}}
