{"type":"item.completed","item":{"id":"item_82","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/app/api/cart/owned/route.ts'","aggregated_output":"     1\t// GET /api/cart/owned (G16) — the signed-in account's already-owned catalog cart-item ids, for the\n     2\t// add-to-cart button to disable/mark. Called client-side (not server-rendered) so the public\n     3\t// marketing pages that host add-to-cart buttons stay statically generated; a signed-out caller\n     4\t// gets an empty list, same as no ownership at all. Takes no body — everything derives from the\n     5\t// verified session cookie (never a request param, security floor).\n     6\timport { cookies } from \"next/headers\";\n     7\timport { NextResponse } from \"next/server\";\n     8\timport { getOwnedCartItemIds } from \"@/lib/owned-cart-items\";\n     9\timport { SESSION_HINT_COOKIE_NAME } from \"@/lib/session-hint-cookie\";\n    10\t\n    11\t// Tenant-scoped per-request read — never statically cached.\n    12\texport const dynamic = \"force-dynamic\";\n    13\t\n    14\texport async function GET(): Promise<NextResponse> {\n    15\t  // ADR-0418: an optimization, NOT a trust boundary. Only the cookie's ABSENCE is trusted — it\n    16\t  // short-circuits before resolving a session or touching the DB, for the common signed-out\n    17\t  // visitor on every marketing page. Its PRESENCE grants nothing: a request that carries it still\n    18\t  // falls through to the real session resolution below, so a stale/forged hint with no live\n    19\t  // session just costs one wasted read in `getOwnedCartItemIds()`, never a false \"owned\".\n    20\t  const jar = await cookies();\n    21\t  if (jar.get(SESSION_HINT_COOKIE_NAME) === undefined) {\n    22\t    return NextResponse.json(\n    23\t      { owned: [] },\n    24\t      { headers: { \"cache-control\": \"private, no-store\" } },\n    25\t    );\n    26\t  }\n    27\t  const owned = await getOwnedCartItemIds();\n    28\t  return NextResponse.json(\n    29\t    { owned: [...owned] },\n    30\t    { headers: { \"cache-control\": \"private, no-store\" } },\n    31\t  );\n    32\t}\n","exit_code":0,"status":"completed"}}
