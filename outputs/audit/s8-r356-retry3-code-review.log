{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba services/license/src/abandoned-checkout-job.ts'","aggregated_output":"     1\t// Replay-safe abandoned-checkout pass. Cloud Tasks invokes the Cloud Run Job execution; the\n     2\t// existing transactional claimed_at marker makes repeated deliveries a no-op.\n     3\timport { createInMemoryQueue, type JobAlertingDeps } from \"@caisson/jobs\";\n     4\timport {\n     5\t  createPgPool,\n     6\t  createPgTransactor,\n     7\t  type Transactor,\n     8\t} from \"@caisson/tenancy-rls\";\n     9\timport {\n    10\t  ABANDONED_CHECKOUT_TICK_TASK,\n    11\t  defineAbandonedCheckoutNoticeTask,\n    12\t  runAbandonedCheckoutTick,\n    13\t} from \"./abandoned-checkout-scheduler.ts\";\n    14\timport { createJobAlertingDeps, loadOpsAlertChannels } from \"./alerting.ts\";\n    15\timport { resolveEmailer } from \"./email-notify.ts\";\n    16\timport { requireJobDatabaseUrl, runAlertedFiniteJob } from \"./finite-job.ts\";\n    17\timport { loadPostHogCaptureConfig } from \"./posthog-capture.ts\";\n    18\t\n    19\texport interface AbandonedCheckoutJobDeps {\n    20\t  db: Transactor;\n    21\t  alerting: JobAlertingDeps;\n    22\t}\n    23\t\n    24\texport async function runAbandonedCheckoutJob(\n    25\t  deps: AbandonedCheckoutJobDeps,\n    26\t): Promise<void> {\n    27\t  const queue = createInMemoryQueue([\n    28\t    defineAbandonedCheckoutNoticeTask({\n    29\t      db: deps.db,\n    30\t      emailer: resolveEmailer(),\n    31\t      posthog: loadPostHogCaptureConfig(),\n    32\t    }),\n    33\t  ]);\n    34\t  await runAlertedFiniteJob(\n    35\t    ABANDONED_CHECKOUT_TICK_TASK,\n    36\t    deps.alerting,\n    37\t    async () => runAbandonedCheckoutTick(deps.db, queue),\n    38\t  );\n    39\t}\n    40\t\n    41\texport async function main(\n    42\t  env: Record<string, string | undefined> = process.env,\n    43\t): Promise<void> {\n    44\t  const pool = createPgPool(requireJobDatabaseUrl(env));\n    45\t  try {\n    46\t    await runAbandonedCheckoutJob({\n    47\t      db: createPgTransactor(pool),\n    48\t      alerting: createJobAlertingDeps(loadOpsAlertChannels(env)),\n    49\t    });\n    50\t  } finally {\n    51\t    await pool.end();\n    52\t  }\n    53\t}\n    54\t\n    55\tif (import.meta.main) await main();\n","exit_code":0,"status":"completed"}}
