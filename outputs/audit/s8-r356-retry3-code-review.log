{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/jobs/src/queue.ts'","aggregated_output":"     1\t// @caisson/jobs — provider-agnostic background-job queue PORT (ADR-0018). Billing/credit\n     2\t// side-effects are ENQUEUED through this port, never called inline: the credit/ledger write stays\n     3\t// synchronous + transactional while email/downstream side-effects run as durable retried jobs\n     4\t// (e.g. `credit.granted` → `send-receipt` task → Emailer.send). Payloads are Zod-`.strict()` typed.\n     5\t//\n     6\t// Drivers: this file ships the in-memory/synchronous driver (tests + the framework-agnostic\n     7\t// reference) — `enqueue` validates the payload then awaits the handler, so a unit test asserts\n     8\t// \"this event enqueued that task with that payload\" with no daemon or network. The production\n     9\t// driver is **Trigger.dev** (self-hostable; first-class retries, scheduling, observability) —\n    10\t// documented here, wired in a later phase. It implements the same `JobQueue` port, so enqueuing\n    11\t// callers never change when the driver is swapped.\n    12\timport type { ZodType } from \"zod\";\n    13\timport { parseStrict } from \"@caisson/kernel\";\n    14\timport { createTaskRegistry, requireRegisteredTask } from \"./task-registry.ts\";\n    15\t\n    16\t/** A typed task: a name, the `.strict()` payload schema, and the handler that runs the work. */\n    17\texport interface TaskDefinition<T> {\n    18\t  name: string;\n    19\t  schema: ZodType<T>;\n    20\t  handler: (payload: T) => Promise<void>;\n    21\t}\n    22\t\n    23\t/**\n    24\t * Options for `enqueue` (ADR-0211). `idempotencyKey` makes a retried call a no-op: the same key\n    25\t * on the same task name produces at most one job — see each driver for its dedupe mechanism\n    26\t * (pg-boss: a deterministic PK id; Trigger.dev: native `idempotencyKey`; in-memory: a keyed Set).\n    27\t */\n    28\texport interface EnqueueOptions {\n    29\t  idempotencyKey?: string;\n    30\t  /**\n    31\t   * Overlap-safety (ADR-0229 row 56, the APScheduler `max_instances=1`/`coalesce` pattern): at most\n    32\t   * one job with this key may be queued/active at once — a second enqueue while one is in flight is a\n    33\t   * no-op. The recurring-job default so a slow run never stacks a second instance. Distinct from\n    34\t   * `idempotencyKey` (which dedups a RETRY of one logical job); this suppresses concurrent OVERLAP.\n    35\t   */\n    36\t  singletonKey?: string;\n    37\t}\n    38\t\n    39\t/**\n    40\t * The queue port. Every driver (in-memory, Trigger.dev, pg-boss) implements this one method; the\n    41\t * credit / billing path depends only on this contract, so the side-effect stays decoupled +\n    42\t * swappable. `options` is optional — every existing 2-arg caller keeps compiling.\n    43\t */\n    44\texport interface JobQueue {\n    45\t  enqueue(\n    46\t    name: string,\n    47\t    payload: unknown,\n    48\t    options?: EnqueueOptions,\n    49\t  ): Promise<void>;\n    50\t}\n    51\t\n    52\t/** A running consumer's handle. `stop()` releases whatever `work()` claimed/subscribed. */\n    53\texport interface WorkHandle {\n    54\t  stop(): Promise<void>;\n    55\t}\n    56\t\n    57\t/**\n    58\t * The claim/worker port (ADR-0211). `work(name)` resolves against the SAME `TaskDefinition`\n    59\t * registry `enqueue` uses — no second handler, no drift — and 404s (`NotFoundError`) on an\n    60\t * unregistered name. pg-boss consumes for real (native SKIP LOCKED); in-memory and Trigger.dev\n    61\t * are honest no-ops (see each driver for why).\n    62\t */\n    63\texport interface JobConsumer {\n    64\t  work(name: string): Promise<WorkHandle>;\n    65\t}\n    66\t\n    67\t/** The smallest honest visibility read: driver-reported job counts for one queue name. */\n    68\texport interface QueueState {\n    69\t  queuedCount: number;\n    70\t  activeCount: number;\n    71\t  failedCount: number;\n    72\t}\n    73\t\n    74\t/**\n    75\t * The visibility-ledger port (ADR-0211). Not every driver can answer it truthfully — Trigger.dev\n    76\t * has no local read, so it does not implement this port at all (see `trigger-driver.ts`).\n    77\t */\n    78\texport interface JobLedger {\n    79\t  getQueueState(name: string): Promise<QueueState>;\n    80\t}\n    81\t\n    82\t/**\n    83\t * Define a typed task. `T` is inferred from `schema`, which pins the handler's payload type — a\n    84\t * schema/handler mismatch is a compile error. The returned task erases its generic to\n    85\t * `TaskDefinition<unknown>` so a registry array stays homogeneous; the schema remains the runtime\n    86\t * validator boundary (the queue parses against it before the handler runs).\n    87\t */\n    88\texport function defineTask<T>(\n    89\t  name: string,\n    90\t  schema: ZodType<T>,\n    91\t  handler: (payload: T) => Promise<void>,\n    92\t): TaskDefinition<unknown> {\n    93\t  return {\n    94\t    name,\n    95\t    schema,\n    96\t    handler: (payload: unknown): Promise<void> => handler(payload as T),\n    97\t  };\n    98\t}\n    99\t\n   100\t/**\n   101\t * The in-memory/synchronous driver. `enqueue` finds the task by name (404 if unregistered),\n   102\t * validates the payload against its `.strict()` schema (`ValidationError` on a bad payload), then\n   103\t * awaits the handler — synchronous execution is what makes side-effects assertable in a unit test.\n   104\t *\n   105\t * `idempotencyKey` dedupe is a `Set<\"name\\0key\">` on the closure: a repeat key is a no-op (the\n   106\t * handler is not re-invoked, no error). `singletonKey` overlap-safety is a second `Set` tracking\n   107\t * IN-FLIGHT keys: a same-key enqueue while its handler is still running is a no-op, then the key frees\n   108\t * on completion (so the next interval tick runs). A handler that throws increments a per-name failure\n   109\t * counter, read back via `getQueueState`.\n   110\t */\n   111\texport function createInMemoryQueue(\n   112\t  tasks: readonly TaskDefinition<unknown>[],\n   113\t): JobQueue & JobConsumer & JobLedger {\n   114\t  const registry = createTaskRegistry(tasks);\n   115\t  const seenIdempotencyKeys = new Set<string>();\n   116\t  const inFlightSingletonKeys = new Set<string>();\n   117\t  const failureCounts = new Map<string, number>();\n   118\t\n   119\t  return {\n   120\t    async enqueue(\n   121\t      name: string,\n   122\t      payload: unknown,\n   123\t      options?: EnqueueOptions,\n   124\t    ): Promise<void> {\n   125\t      const task = requireRegisteredTask(registry, name);\n   126\t      const validated = parseStrict(task.schema, payload);\n   127\t\n   128\t      // Overlap suppression FIRST — a run already in flight for this singletonKey drops this enqueue\n   129\t      // without recording anything (so it can't consume the idempotencyKey slot on the way out).\n   130\t      let singletonHeld: string | undefined;\n   131\t      if (options?.singletonKey !== undefined) {\n   132\t        const sk = `${name}\\0${options.singletonKey}`;\n   133\t        if (inFlightSingletonKeys.has(sk)) return;\n   134\t        inFlightSingletonKeys.add(sk);\n   135\t        singletonHeld = sk;\n   136\t      }\n   137\t\n   138\t      try {\n   139\t        if (options?.idempotencyKey !== undefined) {\n   140\t          const dedupeKey = `${name}\\0${options.idempotencyKey}`;\n   141\t          if (seenIdempotencyKeys.has(dedupeKey)) {\n   142\t            return;\n   143\t          }\n   144\t          seenIdempotencyKeys.add(dedupeKey);\n   145\t        }\n   146\t        await task.handler(validated);\n   147\t      } catch (error) {\n   148\t        failureCounts.set(name, (failureCounts.get(name) ?? 0) + 1);\n   149\t        throw error;\n   150\t      } finally {\n   151\t        // Release only once the handler settles — the window the overlap check guards.\n   152\t        if (singletonHeld !== undefined)\n   153\t          inFlightSingletonKeys.delete(singletonHeld);\n   154\t      }\n   155\t    },\n   156\t\n   157\t    async work(name: string): Promise<WorkHandle> {\n   158\t      requireRegisteredTask(registry, name);\n   159\t      // No backlog to poll in-memory — work() exists for port symmetry with the durable drivers.\n   160\t      return {\n   161\t        async stop(): Promise<void> {},\n   162\t      };\n   163\t    },\n   164\t\n   165\t    async getQueueState(name: string): Promise<QueueState> {\n   166\t      // An honest zero, not a fake pending-count — the in-memory driver has no backlog to report.\n   167\t      return {\n   168\t        queuedCount: 0,\n   169\t        activeCount: 0,\n   170\t        failedCount: failureCounts.get(name) ?? 0,\n   171\t      };\n   172\t    },\n   173\t  };\n   174\t}\n","exit_code":0,"status":"completed"}}
