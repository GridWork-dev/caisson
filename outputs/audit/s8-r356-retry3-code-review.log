\napps/site/lib/auth-server.ts-55- * client-side instead: the owned-items provider (`components/owned-items-provider.tsx`) read this\napps/site/lib/auth-server.ts-56- * cookie via `document.cookie` to skip its fetch entirely, which required the cookie to be\napps/site/lib/auth-server.ts-57- * readable by page JS — a same-origin auth SIGNAL any script on the page, including a third-party\napps/site/lib/auth-server.ts-58- * one, could then observe for the saving of one request. ADR-0418 moved the optimization\napps/site/lib/auth-server.ts-59- * server-side instead: the cookie is now `HttpOnly` (same as `SESSION_COOKIE_NAME` above — invisible\napps/site/lib/auth-server.ts-60- * to `document.cookie`), the client always fetches, and only the route handler reads it (via\napps/site/lib/auth-server.ts-61- * `cookies()`) to decide whether resolving a session is worth doing at all. It stays a fail-open\n--\napps/site/lib/auth-server.ts-72- * request — true for every sign-in method (magic link, password, OAuth) AND for better-auth's own\napps/site/lib/auth-server.ts-73- * updateAge-triggered session refresh (`api/routes/session.mjs`). Riding the refresh case means a\napps/site/lib/auth-server.ts-74- * session that predates this cookie (an already-signed-in buyer who never re-authenticates) still\napps/site/lib/auth-server.ts-75- * picks up the hint on its next natural refresh — normally within `session.updateAge` (default 1\napps/site/lib/auth-server.ts-76- * day) of any authed request — without forcing a re-sign-in. Mint always uses\napps/site/lib/auth-server.ts-77- * `newSession.session.expiresAt`, so the hint's expiry can never drift from the real cookie's.\napps/site/lib/auth-server.ts-78- * Sign-out (`POST /sign-out`, `api/routes/sign-out.ts`) deletes the session but does NOT go\napps/site/lib/auth-server.ts-79- * through `setSessionCookie`, so it's matched by path instead, clearing the hint alongside the\napps/site/lib/auth-server.ts-80- * real session cookie it deletes.\napps/site/lib/auth-server.ts-81- */\napps/site/lib/auth-server.ts:82:const sessionHintCookieHook = createAuthMiddleware(async (ctx) => {\napps/site/lib/auth-server.ts-83-  if (ctx.context.newSession) {\napps/site/lib/auth-server.ts-84-    // Unconditionally Secure (unlike the real session cookie, which only forces it in production —\napps/site/lib/auth-server.ts-85-    // see `advanced.cookies.session_token` below): this cookie carries no secret, so there's no\napps/site/lib/auth-server.ts-86-    // production/dev split to preserve, and modern browsers exempt `localhost` from the\napps/site/lib/auth-server.ts-87-    // https-only restriction on Secure cookies, so local dev keeps working.\napps/site/lib/auth-server.ts:88:    ctx.setCookie(SESSION_HINT_COOKIE_NAME, \"1\", {\napps/site/lib/auth-server.ts-89-      secure: true,\napps/site/lib/auth-server.ts-90-      sameSite: \"strict\",\napps/site/lib/auth-server.ts-91-      httpOnly: true,\napps/site/lib/auth-server.ts-92-      path: \"/\",\napps/site/lib/auth-server.ts-93-      expires: ctx.context.newSession.session.expiresAt,\napps/site/lib/auth-server.ts-94-    });\napps/site/lib/auth-server.ts-95-  } else if (ctx.path === \"/sign-out\") {\napps/site/lib/auth-server.ts-96-    // Fail-open in the other direction: a stray hint cookie left behind by a client that ignored\napps/site/lib/auth-server.ts-97-    // this Set-Cookie just costs one wasted `/api/cart/owned` fetch (the provider's own fail-open\napps/site/lib/auth-server.ts-98-    // contract), never a false \"owned\" marking.\napps/site/lib/auth-server.ts:99:    ctx.setCookie(SESSION_HINT_COOKIE_NAME, \"\", {\napps/site/lib/auth-server.ts-100-      secure: true,\napps/site/lib/auth-server.ts-101-      sameSite: \"strict\",\napps/site/lib/auth-server.ts-102-      httpOnly: true,\napps/site/lib/auth-server.ts-103-      path: \"/\",\napps/site/lib/auth-server.ts-104-      maxAge: 0,\napps/site/lib/auth-server.ts-105-    });\napps/site/lib/auth-server.ts-106-  }\napps/site/lib/auth-server.ts-107-});\napps/site/lib/auth-server.ts-108-\napps/site/lib/auth-server.ts-109-/**\n--\napps/site/lib/auth-server.ts-211-          to: user.email,\napps/site/lib/auth-server.ts-212-          template: \"verify-email\",\napps/site/lib/auth-server.ts-213-          data: { url },\napps/site/lib/auth-server.ts-214-        });\napps/site/lib/auth-server.ts-215-      },\napps/site/lib/auth-server.ts-216-      sendOnSignUp: true,\napps/site/lib/auth-server.ts-217-      autoSignInAfterVerification: true,\napps/site/lib/auth-server.ts-218-    },\napps/site/lib/auth-server.ts-219-    socialProviders: resolveSocialProviders(process.env),\napps/site/lib/auth-server.ts-220-    // ADR-0418: mint/refresh the HttpOnly hint cookie alongside every real session\napps/site/lib/auth-server.ts:221:    // create/refresh, clear it on sign-out. See `sessionHintCookieHook` above.\napps/site/lib/auth-server.ts:222:    hooks: { after: sessionHintCookieHook },\napps/site/lib/auth-server.ts-223-    advanced: {\napps/site/lib/auth-server.ts-224-      cookiePrefix: \"caisson\",\napps/site/lib/auth-server.ts-225-      cookies: {\napps/site/lib/auth-server.ts-226-        session_token: {\napps/site/lib/auth-server.ts-227-          // Security floor: the durable session cookie is Strict + HttpOnly. `Secure` is added by\napps/site/lib/auth-server.ts-228-          // better-auth in production (NODE_ENV=production).\napps/site/lib/auth-server.ts-229-          attributes: { sameSite: \"strict\", httpOnly: true, path: \"/\" },\napps/site/lib/auth-server.ts-230-        },\napps/site/lib/auth-server.ts-231-      },\napps/site/lib/auth-server.ts-232-    },\n","exit_code":0,"status":"completed"}}
