{"type":"item.completed","item":{"id":"item_75","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/agent-runner/src/engine-env.ts'","aggregated_output":"     1\t// The provider profile + the env scrub — the pure half of @caisson/agent-runner (ADR-0186 §4),\n     2\t// carved out of agent-runner.ts so it can be imported without dragging the spawn/run-registry\n     3\t// machinery (node:child_process, node:fs, node:path) behind it. Nothing here reaches a node\n     4\t// builtin: it is zod, the kernel barrel, `URL`, and string work. `@caisson/agent-runner/browser`\n     5\t// is exactly this module (ADR-0396); the `.` barrel re-exports every name below unchanged.\n     6\timport { z } from \"zod\";\n     7\timport { ValidationError, strictObject } from \"@caisson/kernel\";\n     8\t\n     9\t// ---------------------------------------------------------------------------\n    10\t// Provider config (ADR-0186 F2) — provider-agnostic { binary, baseUrlEnv, authEnv, model }.\n    11\t// ---------------------------------------------------------------------------\n    12\t\n    13\t/** Env-var NAME shape — `baseUrlEnv`/`authEnv` name variables, they never carry values. */\n    14\tconst envVarName = z\n    15\t  .string()\n    16\t  .regex(/^[A-Z][A-Z0-9_]*$/, \"must be an ENV_VAR-style name\");\n    17\t\n    18\t/**\n    19\t * A headless agent-CLI provider profile. `baseUrlEnv`/`authEnv` are the env-var NAMES the CLI\n    20\t * reads its endpoint + key from; the VALUES are supplied per spawn (the credential stays an\n    21\t * injected seam — this package never reads a dotenv/keychain itself). `args` is the argv template;\n    22\t * the literal tokens `{task}` and `{model}` are substituted WHOLE-TOKEN only, so a hostile task\n    23\t * string can never add, split, or merge argv entries (and there is no shell anywhere).\n    24\t */\n    25\texport const ProviderConfig = strictObject({\n    26\t  binary: z.string().trim().min(1).max(1024),\n    27\t  baseUrlEnv: envVarName,\n    28\t  authEnv: envVarName,\n    29\t  model: z.string().trim().min(1).max(128),\n    30\t  /** Env-var NAME for the CLI's isolated config dir (e.g. CLAUDE_CONFIG_DIR); omit if none. */\n    31\t  configDirEnv: envVarName.optional(),\n    32\t  /** Env-var NAME the CLI reads the model from; omit when the model travels via `args`. */\n    33\t  modelEnv: envVarName.optional(),\n    34\t  args: z.array(z.string().max(100_000)).max(64).default([]),\n    35\t});\n    36\texport type ProviderConfig = z.infer<typeof ProviderConfig>;\n    37\texport type ProviderConfigInput = z.input<typeof ProviderConfig>;\n    38\t\n    39\t/**\n    40\t * One worked provider profile (SPEC task 4): the Claude Code CLI in headless stream-json mode.\n    41\t * `--strict-mcp-config` with no `--mcp-config` means NO MCP servers — no credentialed side-effect\n    42\t * tool can be smuggled in via an operator-level config file (the isolated config dir closes the\n    43\t * user-level path too).\n    44\t */\n    45\texport const CLAUDE_CLI_PROFILE: ProviderConfig = ProviderConfig.parse({\n    46\t  binary: \"claude\",\n    47\t  baseUrlEnv: \"ANTHROPIC_BASE_URL\",\n    48\t  authEnv: \"ANTHROPIC_AUTH_TOKEN\",\n    49\t  model: \"sonnet\",\n    50\t  configDirEnv: \"CLAUDE_CONFIG_DIR\",\n    51\t  modelEnv: \"ANTHROPIC_MODEL\",\n    52\t  args: [\n    53\t    \"-p\",\n    54\t    \"{task}\",\n    55\t    \"--output-format\",\n    56\t    \"stream-json\",\n    57\t    \"--verbose\",\n    58\t    \"--model\",\n    59\t    \"{model}\",\n    60\t    \"--permission-mode\",\n    61\t    \"acceptEdits\",\n    62\t    \"--strict-mcp-config\",\n    63\t  ],\n    64\t});\n    65\t\n    66\t// ---------------------------------------------------------------------------\n    67\t// Env scrub — the security core (ADR-0186 §4). Build the child env FROM SCRATCH.\n    68\t// ---------------------------------------------------------------------------\n    69\t\n    70\t/** The ONLY parent-env keys forwarded to the child. Deliberately excludes HOME, USER, and every\n    71\t *  credential — secrets are kept out of a process that egresses to a model provider. */\n    72\texport const PASSTHROUGH_KEYS = [\n    73\t  \"PATH\",\n    74\t  \"LANG\",\n    75\t  \"LC_ALL\",\n    76\t  \"LC_CTYPE\",\n    77\t  \"TERM\",\n    78\t  \"TZ\",\n    79\t  \"TMPDIR\",\n    80\t] as const;\n    81\t\n    82\texport interface BuildEngineEnvOptions {\n    83\t  provider: ProviderConfig;\n    84\t  /** The ONE provider key placed into the child env (at `provider.authEnv`). Injected by the\n    85\t   *  caller — this package never resolves credentials from disk or `process.env` itself. */\n    86\t  authKey: string;\n    87\t  /** Value for `provider.baseUrlEnv` — the provider's API endpoint. */\n    88\t  baseUrl: string;\n    89\t  /** Isolated HOME for the subprocess (no operator dotfile/keychain leakage). */\n    90\t  home: string;\n    91\t  /** Isolated CLI config dir (no operator-level MCP/tool credentials). */\n    92\t  configDir: string;\n    93\t}\n    94\t\n    95\t/**\n    96\t * Build the SCRUBBED env for the agent subprocess. NEVER spreads `parentEnv`. Returns a fresh\n    97\t * object containing only the non-secret passthrough allowlist plus the provider routing vars.\n    98\t * This is the single place a secret could leak to the provider — the leak-guard test exercises it\n    99\t * with a polluted parentEnv AND end-to-end through a real spawn.\n   100\t *\n   101\t * `parentEnv` is typed structurally rather than as `NodeJS.ProcessEnv` so this module carries no\n   102\t * node ambient type: `process.env` still satisfies it, and a caller that already had a\n   103\t * `NodeJS.ProcessEnv`-typed reference is unaffected (the parameter only widened).\n   104\t */\n   105\texport function buildEngineEnv(\n   106\t  parentEnv: Readonly<Record<string, string | undefined>>,\n   107\t  opts: BuildEngineEnvOptions,\n   108\t): Record<string, string> {\n   109\t  if (opts.authKey.trim().length === 0) {\n   110\t    throw new ValidationError(\"buildEngineEnv: empty authKey\");\n   111\t  }\n   112\t  let protocol: string;\n   113\t  try {\n   114\t    protocol = new URL(opts.baseUrl).protocol;\n   115\t  } catch {\n   116\t    throw new ValidationError(\"buildEngineEnv: baseUrl is not a URL\");\n   117\t  }\n   118\t  // Both http and https are admitted, for ANY host — not just loopback. That is deliberate: the\n   119\t  // canonical local-first endpoints are named services (`http://ollama:11434` under compose/K8s),\n   120\t  // not literal loopback, so a loopback allowlist would reject the common case. It is also not a\n   121\t  // trust boundary to defend: the same options object carries `provider.binary`, which reaches\n   122\t  // `spawnChild` unchanged, so a caller who can set `baseUrl` already has arbitrary local\n   123\t  // execution. Narrow the caller, not this check.\n   124\t  if (protocol !== \"https:\" && protocol !== \"http:\") {\n   125\t    throw new ValidationError(\"buildEngineEnv: baseUrl must be http(s)\", {\n   126\t      protocol,\n   127\t    });\n   128\t  }\n   129\t  const env: Record<string, string> = {};\n   130\t  for (const key of PASSTHROUGH_KEYS) {\n   131\t    const value = parentEnv[key];\n   132\t    if (typeof value === \"string\" && value.length > 0) env[key] = value;\n   133\t  }\n   134\t  // Isolation + provider routing only — no secret beyond the one provider key.\n   135\t  env[\"HOME\"] = opts.home;\n   136\t  env[opts.provider.baseUrlEnv] = opts.baseUrl;\n   137\t  env[opts.provider.authEnv] = opts.authKey;\n   138\t  if (opts.provider.configDirEnv !== undefined) {\n   139\t    env[opts.provider.configDirEnv] = opts.configDir;\n   140\t  }\n   141\t  if (opts.provider.modelEnv !== undefined) {\n   142\t    env[opts.provider.modelEnv] = opts.provider.model;\n   143\t  }\n   144\t  // Hygiene for CLIs that honor these conventions: no self-update, no telemetry from the sandbox.\n   145\t  env[\"DISABLE_AUTOUPDATER\"] = \"1\";\n   146\t  env[\"DISABLE_TELEMETRY\"] = \"1\";\n   147\t  env[\"DISABLE_ERROR_REPORTING\"] = \"1\";\n   148\t  return env;\n   149\t}\n","exit_code":0,"status":"completed"}}
