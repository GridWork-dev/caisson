{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba services/license/src/finite-job.ts'","aggregated_output":"     1\timport type { JobAlertingDeps } from \"@caisson/jobs\";\n     2\t\n     3\texport function requireJobDatabaseUrl(\n     4\t  env: Record<string, string | undefined> = process.env,\n     5\t): string {\n     6\t  const url = env.DATABASE_URL?.trim() ?? \"\";\n     7\t  if (url === \"\") {\n     8\t    throw new Error(\n     9\t      \"DATABASE_URL is required for the finite license job — refusing to start.\",\n    10\t    );\n    11\t  }\n    12\t  return url;\n    13\t}\n    14\t\n    15\t/** Report a finite-job failure without changing Cloud Run Job failure semantics. */\n    16\texport async function runAlertedFiniteJob(\n    17\t  taskName: string,\n    18\t  alerting: JobAlertingDeps,\n    19\t  operation: () => Promise<void>,\n    20\t): Promise<void> {\n    21\t  try {\n    22\t    await operation();\n    23\t  } catch (error) {\n    24\t    await alerting.reportTaskFailure(taskName, error).catch(() => undefined);\n    25\t    throw error;\n    26\t  }\n    27\t}\n","exit_code":0,"status":"completed"}}
