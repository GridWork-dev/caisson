{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba tools/security/rescan_runtime_images.py'","aggregated_output":"     1\t\"\"\"Build matrix and enforcing scanner for actual first-party runtime images.\"\"\"\n     2\t\n     3\timport argparse\n     4\timport json\n     5\tfrom pathlib import Path\n     6\timport re\n     7\t\n     8\tfrom image_scan_policy import scan_image\n     9\tfrom rescan_base_images import census\n    10\t\n    11\t\n    12\tdef runtime_targets(root: Path) -> dict:\n    13\t    report = census(root)\n    14\t    targets = []\n    15\t    for path in report[\"dockerfiles\"]:\n    16\t        # census has already rejected unsupported FROM syntax and unpinned sources.\n    17\t        stages = []\n    18\t        for line in (root / path).read_text().splitlines():\n    19\t            if re.match(r\"^\\s*FROM\\s\", line, re.IGNORECASE):\n    20\t                parts = line.split()\n    21\t                stages.append(parts[-1] if len(parts) >= 4 and parts[-2].lower() == \"as\" else \"\")\n    22\t        if not stages:\n    23\t            raise ValueError(f\"{path}: no runtime stage\")\n    24\t        selected = list(dict.fromkeys([stages[-1], *[s for s in stages if s.lower() == \"migrate\"]]))\n    25\t        for stage in selected:\n    26\t            name = re.sub(r\"[^a-z0-9-]\", \"-\", path.lower()) + \"-\" + (stage or \"final\")\n    27\t            targets.append({\"name\": name, \"dockerfile\": path, \"target\": stage, \"context\": \".\"})\n    28\t    return {\"include\": targets}\n    29\t\n    30\t\n    31\tdef main() -> int:\n    32\t    parser = argparse.ArgumentParser(description=__doc__)\n    33\t    parser.add_argument(\"--matrix\", action=\"store_true\")\n    34\t    parser.add_argument(\"--image\")\n    35\t    parser.add_argument(\"--output\", type=Path)\n    36\t    args = parser.parse_args()\n    37\t    root = Path(__file__).resolve().parents[2]\n    38\t    if args.matrix:\n    39\t        print(json.dumps(runtime_targets(root)))\n    40\t        return 0\n    41\t    if not args.image or args.output is None:\n    42\t        parser.error(\"--image and --output are required for runtime scans\")\n    43\t    if not re.fullmatch(r\"caisson-runtime-rescan:[a-z0-9-]+\", args.image):\n    44\t        parser.error(\"runtime image must be a local caisson-runtime-rescan tag\")\n    45\t    return scan_image(args.image, args.output.resolve(), \"runtime\")\n    46\t\n    47\t\n    48\tif __name__ == \"__main__\":\n    49\t    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
