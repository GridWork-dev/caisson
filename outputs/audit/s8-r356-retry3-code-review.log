{"type":"item.completed","item":{"id":"item_81","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/components/cart-checkout-panel.tsx'","aggregated_output":"     1\t\"use client\";\n     2\t\n     3\timport { useEffect, useState } from \"react\";\n     4\timport Link from \"next/link\";\n     5\t// The /fetch subpath is the client-safe cut of the kernel (fetch.ts is pure, no server-only\n     6\t// imports) — mirrors `discord-connect.tsx`'s own client-side fetchWithTimeout usage.\n     7\timport { fetchWithTimeout } from \"@caisson/kernel/fetch\";\n     8\timport { Button, EmptyState } from \"@caisson/ui/components\";\n     9\t\n    10\timport { PADDLE_MOR_DISCLOSURE } from \"@/lib/legal\";\n    11\timport {\n    12\t  isPaddleConfigured,\n    13\t  onCheckoutCompleted,\n    14\t  openCartCheckout,\n    15\t} from \"@/lib/paddle-checkout\";\n    16\timport { formatUsd } from \"@/lib/pricing\";\n    17\t\n    18\timport { useCart } from \"./cart-provider\";\n    19\t\n    20\texport interface CartCheckoutPanelProps {\n    21\t  /** The buyer's account id, resolved server-side from the session cookie\n    22\t   *  (`requireDashboardSession` — never trusted from the client, security floor). */\n    23\t  accountId: string;\n    24\t  /** The validated `?promo=` search param (server-validated shape, `dashboard/cart/page.tsx`) —\n    25\t   *  threaded straight into `Paddle.Checkout.open({ discountCode })` when present. */\n    26\t  promoCode?: string;\n    27\t}\n    28\t\n    29\t/**\n    30\t * The authed pay screen: ONE Paddle overlay for every line in the cart (`openCartCheckout`,\n    31\t * `lib/paddle-checkout.ts`), stamped with the server-verified `accountId` as\n    32\t * `custom_data.account_id` — the same key the webhook's `parsePaddleEvent` already reads to\n    33\t * resolve the tenant (ADR-0116).\n    34\t */\n    35\texport function CartCheckoutPanel({\n    36\t  accountId,\n    37\t  promoCode,\n    38\t}: CartCheckoutPanelProps) {\n    39\t  const { items, subtotal, clear } = useCart();\n    40\t  const [opening, setOpening] = useState(false);\n    41\t  const [error, setError] = useState<string | null>(null);\n    42\t  const configured = isPaddleConfigured();\n    43\t\n    44\t  // G35: clear only when Paddle reports `checkout.completed` — payment actually succeeded — not\n    45\t  // the instant the overlay opens. A buyer who opens the overlay to review the total then cancels\n    46\t  // (or a card decline) now keeps their cart, instead of losing it to an optimistic pre-clear.\n    47\t  useEffect(() => onCheckoutCompleted(clear), [clear]);\n    48\t\n    49\t  async function pay() {\n    50\t    setOpening(true);\n    51\t    setError(null);\n    52\t    try {\n    53\t      // Abandoned-checkout capture (SPEC-abandoned-checkout-email.md §(a)): fire-and-forget, NEVER\n    54\t      // awaited into the checkout path — a slow or failed capture must not delay or block\n    55\t      // `Paddle.Checkout.open` below.\n    56\t      void fetchWithTimeout(\n    57\t        \"/api/checkout/started\",\n    58\t        {\n    59\t          method: \"POST\",\n    60\t          headers: { \"content-type\": \"application/json\" },\n    61\t          body: JSON.stringify({\n    62\t            items: items.map((item) => ({ id: item.id, label: item.label })),\n    63\t          }),\n    64\t        },\n    65\t        { timeoutMs: 5_000 },\n    66\t      ).catch(() => {\n    67\t        // Best-effort capture — a missed nudge email is not worth surfacing to the buyer.\n    68\t      });\n    69\t\n    70\t      const opened = await openCartCheckout(\n    71\t        items.map((item) => ({ priceId: item.priceId })),\n    72\t        accountId,\n    73\t        promoCode,\n    74\t      );\n    75\t      // The Paddle overlay owns the rest of the flow once it opens — the cart clears on the\n    76\t      // `checkout.completed` event (the useEffect above), not here.\n    77\t      if (!opened) {\n    78\t        setError(\"Checkout is unavailable right now. Please try again.\");\n    79\t      }\n    80\t    } catch {\n    81\t      // G6: getPaddle() now surfaces a load/init failure instead of silently poisoning the\n    82\t      // session — give the buyer a real, actionable message instead of a button that just reverts.\n    83\t      setError(\n    84\t        \"Checkout failed to load. Check your connection or ad-blocker, then try again.\",\n    85\t      );\n    86\t    } finally {\n    87\t      setOpening(false);\n    88\t    }\n    89\t  }\n    90\t\n    91\t  return (\n    92\t    <div\n    93\t      style={{ display: \"grid\", gap: \"var(--cs-space-6)\", maxWidth: \"36rem\" }}\n    94\t    >\n    95\t      <div>\n    96\t        <h1\n    97\t          className=\"cs-card-title\"\n    98\t          style={{ fontSize: \"var(--cs-text-2xl)\" }}\n    99\t        >\n   100\t          Checkout\n   101\t        </h1>\n   102\t        {items.length > 0 ? (\n   103\t          <p className=\"cs-muted\" style={{ marginTop: \"var(--cs-space-2)\" }}>\n   104\t            {items.length} item{items.length === 1 ? \"\" : \"s\"}. One Paddle\n   105\t            checkout for the whole cart.\n   106\t          </p>\n   107\t        ) : null}\n   108\t      </div>\n   109\t\n   110\t      {items.length === 0 ? (\n   111\t        <EmptyState\n   112\t          icon=\"cart\"\n   113\t          title=\"Your cart is empty\"\n   114\t          description=\"Add a bundle or a module from the marketplace to start a checkout.\"\n   115\t          action={\n   116\t            <Button asChild variant=\"primary\">\n   117\t              <Link href=\"/marketplace\">Browse the marketplace</Link>\n   118\t            </Button>\n   119\t          }\n   120\t        />\n   121\t      ) : (\n   122\t        <>\n   123\t          <ul\n   124\t            style={{\n   125\t              margin: 0,\n   126\t              padding: 0,\n   127\t              listStyle: \"none\",\n   128\t              display: \"grid\",\n   129\t              gap: \"var(--cs-space-2)\",\n   130\t            }}\n   131\t          >\n   132\t            {items.map((item) => (\n   133\t              <li\n   134\t                key={item.id}\n   135\t                style={{\n   136\t                  display: \"flex\",\n   137\t                  justifyContent: \"space-between\",\n   138\t                  fontSize: \"var(--cs-text-sm)\",\n   139\t                }}\n   140\t              >\n   141\t                <span>{item.label}</span>\n   142\t                <span\n   143\t                  className=\"cs-num\"\n   144\t                  style={{ fontFamily: \"var(--cs-font-mono)\" }}\n   145\t                >\n   146\t                  {formatUsd(item.amount)}\n   147\t                </span>\n   148\t              </li>\n   149\t            ))}\n   150\t          </ul>\n   151\t\n   152\t          <div\n   153\t            style={{\n   154\t              display: \"flex\",\n   155\t              justifyContent: \"space-between\",\n   156\t              borderTop: \"1px solid var(--cs-border)\",\n   157\t              paddingTop: \"var(--cs-space-3)\",\n   158\t            }}\n   159\t          >\n   160\t            <span className=\"cs-card-title\">Total</span>\n   161\t            <span\n   162\t              className=\"cs-num\"\n   163\t              style={{\n   164\t                fontFamily: \"var(--cs-font-mono)\",\n   165\t                fontSize: \"var(--cs-text-lg)\",\n   166\t              }}\n   167\t            >\n   168\t              {formatUsd(subtotal)}\n   169\t            </span>\n   170\t          </div>\n   171\t\n   172\t          <Button\n   173\t            type=\"button\"\n   174\t            variant=\"primary\"\n   175\t            disabled={!configured || opening}\n   176\t            onClick={() => void pay()}\n   177\t          >\n   178\t            {!configured\n   179\t              ? \"Checkout unavailable\"\n   180\t              : opening\n   181\t                ? \"Opening…\"\n   182\t                : \"Pay now\"}\n   183\t          </Button>\n   184\t\n   185\t          {error !== null && (\n   186\t            <p className=\"cs-footnote\" style={{ color: \"var(--cs-danger)\" }}>\n   187\t              {error}\n   188\t            </p>\n   189\t          )}\n   190\t\n   191\t          <p className=\"cs-footnote\">{PADDLE_MOR_DISCLOSURE}</p>\n   192\t        </>\n   193\t      )}\n   194\t    </div>\n   195\t  );\n   196\t}\n","exit_code":0,"status":"completed"}}
