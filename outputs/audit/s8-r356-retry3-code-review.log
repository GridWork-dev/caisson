{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba services/license/src/abandoned-checkout-scheduler.ts'","aggregated_output":"     1\t// The abandoned-checkout email scheduler (SPEC outputs/specs/deferred-respec/\n     2\t// SPEC-abandoned-checkout-email.md, operator-locked 2026-07-10). A single daily cron tick, cloned\n     3\t// from `credit-expiry-scheduler.ts`'s shape exactly: INERT UNTIL ARMED —\n     4\t// DEPLOY GATE: arm `ABANDONED_CHECKOUT_SCHEDULE` only AFTER `ADMIN_MUTATION_PROVISION_SQL` has\n     5\t// been re-run against the license DB — `listAbandonedCheckoutAccountIds` reads\n     6\t// `checkout_abandonment` as `admin_write`, whose SELECT policy ships in the admin provision\n     7\t// script, not migration 0024; armed-before-provisioned means every tick throws permission-denied\n     8\t// and no email ever sends (same dependency credit-expiry-scheduler carries).\n     9\t// `ABANDONED_CHECKOUT_SCHEDULE` (a cron expression) unset means `startAbandonedCheckoutScheduler`\n    10\t// returns immediately and no pg-boss connection is ever opened. When armed, a daily parent tick\n    11\t// enumerates every account holding a checkout_abandonment row old enough to be notice-eligible\n    12\t// (N=24h, LOCKED — no env override, this is a product decision not a deploy knob) and enqueues one\n    13\t// per-account notice job; the job's own `singletonKey` (the account id) is the double-enqueue\n    14\t// guard, not this module.\n    15\t//\n    16\t// Cross-tenant read: enumerating checkout_abandonment across every account is exactly what tenant\n    17\t// RLS forbids for the buyer `app` role — reused via the SAME already-provisioned `admin_write`\n    18\t// role `listAbandonedCheckoutAccountIds` reads through (see checkout-abandonment-store.ts).\n    19\t//\n    20\t// Boot failure posture: same as credit-expiry-scheduler.ts — a start failure logs one stderr line\n    21\t// and returns, never throws past `startAbandonedCheckoutScheduler`, so a misconfigured scheduler\n    22\t// can never take the license service down at boot.\n    23\timport {\n    24\t  createPgBossJobQueue,\n    25\t  defineTask,\n    26\t  type JobAlertingDeps,\n    27\t  type JobQueue,\n    28\t} from \"@caisson/jobs\";\n    29\timport { strictObject } from \"@caisson/kernel\";\n    30\timport type { Emailer } from \"@caisson/email\";\n    31\timport type { Transactor } from \"@caisson/tenancy-rls\";\n    32\timport { withTenant } from \"@caisson/tenancy-rls\";\n    33\timport { z } from \"zod\";\n    34\timport {\n    35\t  listAbandonedCheckoutAccountIds,\n    36\t  sweepEligibleAbandonedCheckout,\n    37\t} from \"./checkout-abandonment-store.ts\";\n    38\timport { notifyAbandonedCheckout } from \"./email-notify.ts\";\n    39\timport {\n    40\t  capturePostHogAbandonedCheckoutEmailSent,\n    41\t  type PostHogCaptureConfig,\n    42\t} from \"./posthog-capture.ts\";\n    43\t\n    44\t/** LOCKED send delay (operator, 2026-07-10 — SPEC open fork 1) — not env-configurable; this is a\n    45\t *  product decision, not a deploy knob. */\n    46\texport const ABANDONED_CHECKOUT_DELAY_HOURS = 24;\n    47\t\n    48\t/** The daily parent-tick task name. */\n    49\texport const ABANDONED_CHECKOUT_TICK_TASK = \"checkout.abandonment_tick\";\n    50\t/** The per-account notice task name. */\n    51\texport const ABANDONED_CHECKOUT_NOTICE_TASK = \"checkout.abandonment_notice\";\n    52\t\n    53\tconst tickPayloadSchema = strictObject({});\n    54\tconst noticePayloadSchema = strictObject({ accountId: z.string().min(1) });\n    55\ttype NoticePayload = z.infer<typeof noticePayloadSchema>;\n    56\t\n    57\texport interface AbandonedCheckoutNoticeTaskDeps {\n    58\t  db: Transactor;\n    59\t  emailer: Emailer | null;\n    60\t  posthog: PostHogCaptureConfig | null;\n    61\t}\n    62\t\n    63\t/** The reusable, idempotent per-account handler shared by the legacy scheduler and finite Job. */\n    64\texport function defineAbandonedCheckoutNoticeTask(\n    65\t  deps: AbandonedCheckoutNoticeTaskDeps,\n    66\t) {\n    67\t  return defineTask(\n    68\t    ABANDONED_CHECKOUT_NOTICE_TASK,\n    69\t    noticePayloadSchema,\n    70\t    async (payload: NoticePayload) => {\n    71\t      const result = await withTenant(deps.db, payload.accountId, (tx) =>\n    72\t        sweepEligibleAbandonedCheckout(\n    73\t          tx,\n    74\t          payload.accountId,\n    75\t          ABANDONED_CHECKOUT_DELAY_HOURS,\n    76\t        ),\n    77\t      );\n    78\t      if (result === null) return;\n    79\t\n    80\t      if (deps.emailer !== null) {\n    81\t        await notifyAbandonedCheckout(deps.db, deps.emailer, {\n    82\t          accountId: payload.accountId,\n    83\t          lines: result.lines,\n    84\t        });\n    85\t      }\n    86\t      if (deps.posthog !== null) {\n    87\t        await capturePostHogAbandonedCheckoutEmailSent(deps.posthog, {\n    88\t          accountId: payload.accountId,\n    89\t          itemCount: result.lines.length,\n    90\t        });\n    91\t      }\n    92\t    },\n    93\t  );\n    94\t}\n    95\t\n    96\t/** Resolve the arming cron expression from env; `null` (inert) unless a non-blank value is set —\n    97\t *  same shape as `loadCreditExpiryScheduleConfig`. */\n    98\texport function loadAbandonedCheckoutScheduleConfig(\n    99\t  env: Record<string, string | undefined> = process.env,\n   100\t): string | null {\n   101\t  const cron = env.ABANDONED_CHECKOUT_SCHEDULE?.trim() ?? \"\";\n   102\t  return cron === \"\" ? null : cron;\n   103\t}\n   104\t\n   105\t/** One daily tick: enumerate notice-eligible accounts, enqueue each account's notice job. */\n   106\texport async function runAbandonedCheckoutTick(\n   107\t  db: Transactor,\n   108\t  queue: JobQueue,\n   109\t): Promise<void> {\n   110\t  const accountIds = await listAbandonedCheckoutAccountIds(\n   111\t    db,\n   112\t    ABANDONED_CHECKOUT_DELAY_HOURS,\n   113\t  );\n   114\t  for (const accountId of accountIds) {\n   115\t    await queue.enqueue(\n   116\t      ABANDONED_CHECKOUT_NOTICE_TASK,\n   117\t      { accountId },\n   118\t      { singletonKey: accountId },\n   119\t    );\n   120\t  }\n   121\t}\n   122\t\n   123\texport interface AbandonedCheckoutSchedulerDeps {\n   124\t  db: Transactor;\n   125\t  connectionString: string;\n   126\t  /** `loadAbandonedCheckoutScheduleConfig`'s result — `null`/blank means inert. */\n   127\t  schedule: string | null | undefined;\n   128\t  /** `null` when email is unconfigured — the notice task still marks the row (so it is never\n   129\t   *  re-attempted once real email comes online mid-window) but sends nothing. `deploy.ts` wires\n   130\t   *  the real `email-notify.ts#resolveEmailer()` transport (Resend or capture, never actually\n   131\t   *  null in prod — mirrors every other notifier's driver-gated posture). */\n   132\t  emailer: Emailer | null;\n   133\t  /** `null` when POSTHOG_CAPTURE_KEY is unset — the `abandoned_checkout_email_sent` capture is\n   134\t   *  simply skipped. */\n   135\t  posthog: PostHogCaptureConfig | null;\n   136\t  alerting?: JobAlertingDeps;\n   137\t  createQueue?: typeof createPgBossJobQueue;\n   138\t  log?: (message: string) => void;\n   139\t}\n   140\t\n   141\t/**\n   142\t * Start the scheduler if armed. Returns immediately, constructing nothing, when `schedule` is\n   143\t * unset/blank. A start failure logs and returns rather than throwing — see module doc.\n   144\t */\n   145\texport async function startAbandonedCheckoutScheduler(\n   146\t  deps: AbandonedCheckoutSchedulerDeps,\n   147\t): Promise<void> {\n   148\t  const cron = deps.schedule?.trim();\n   149\t  if (cron === undefined || cron === \"\") return;\n   150\t\n   151\t  const log =\n   152\t    deps.log ??\n   153\t    ((message: string) => {\n   154\t      process.stderr.write(`${message}\\n`);\n   155\t    });\n   156\t  const createQueue = deps.createQueue ?? createPgBossJobQueue;\n   157\t\n   158\t  try {\n   159\t    // A boxed ref, not a reassigned `let` — same pattern as credit-expiry-scheduler.ts: the tick\n   160\t    // handler closes over `queueBox` (defined before `createQueue` exists) and reads `.queue` only\n   161\t    // once pg-boss actually claims a job, strictly after the synchronous assignment below.\n   162\t    const queueBox: { queue?: JobQueue } = {};\n   163\t    const tickTask = defineTask(\n   164\t      ABANDONED_CHECKOUT_TICK_TASK,\n   165\t      tickPayloadSchema,\n   166\t      async () => {\n   167\t        await runAbandonedCheckoutTick(deps.db, queueBox.queue as JobQueue);\n   168\t      },\n   169\t    );\n   170\t    const noticeTask = defineAbandonedCheckoutNoticeTask(deps);\n   171\t\n   172\t    const started = createQueue([tickTask, noticeTask], {\n   173\t      connectionString: deps.connectionString,\n   174\t      ...(deps.alerting !== undefined ? { alerting: deps.alerting } : {}),\n   175\t    });\n   176\t    queueBox.queue = started;\n   177\t    await started.work(ABANDONED_CHECKOUT_NOTICE_TASK);\n   178\t    await started.work(ABANDONED_CHECKOUT_TICK_TASK);\n   179\t    await started.schedule(ABANDONED_CHECKOUT_TICK_TASK, cron, {});\n   180\t  } catch (err) {\n   181\t    log(\n   182\t      `[service-license] abandoned-checkout scheduler failed to start: ${err instanceof Error ? err.message : String(err)}`,\n   183\t    );\n   184\t  }\n   185\t}\n","exit_code":0,"status":"completed"}}
