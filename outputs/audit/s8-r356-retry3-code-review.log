{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba tools/security/rescan_base_images.py'","aggregated_output":"     1\t#!/usr/bin/env python3\n     2\t\"\"\"Scan declared public base digests, without registry credentials or a daemon.\"\"\"\n     3\t\n     4\timport argparse\n     5\timport json\n     6\tfrom pathlib import Path\n     7\timport re\n     8\timport subprocess\n     9\timport image_scan_policy\n    10\t\n    11\t\n    12\tPIN = re.compile(r\"[a-zA-Z0-9][a-zA-Z0-9._/:+-]*@sha256:[0-9a-f]{64}\")\n    13\t\n    14\t\n    15\tdef from_images(text: str, path: str) -> list[dict]:\n    16\t    aliases = set()\n    17\t    images = []\n    18\t    count = 0\n    19\t    for number, line in enumerate(text.splitlines(), 1):\n    20\t        if not re.match(r\"^\\s*FROM(?:\\s|$)\", line, re.IGNORECASE):\n    21\t            continue\n    22\t        count += 1\n    23\t        parts = line.split()[1:]\n    24\t        if parts and parts[0] == \"--platform=linux/amd64\":\n    25\t            parts = parts[1:]\n    26\t        if not (len(parts) == 1 or (len(parts) == 3 and parts[1].lower() == \"as\")):\n    27\t            raise ValueError(f\"{path}:{number}: unsupported FROM syntax\")\n    28\t        image = parts[0]\n    29\t        if image.lower() not in aliases and image.lower() != \"scratch\":\n    30\t            if not PIN.fullmatch(image):\n    31\t                raise ValueError(f\"{path}:{number}: expected a literal sha256-pinned base\")\n    32\t            images.append({\"image\": image, \"path\": path, \"line\": number})\n    33\t        if len(parts) == 3:\n    34\t            if not re.fullmatch(r\"[a-zA-Z][a-zA-Z0-9_.-]*\", parts[2]):\n    35\t                raise ValueError(f\"{path}:{number}: unsupported stage alias\")\n    36\t            aliases.add(parts[2].lower())\n    37\t    if count == 0:\n    38\t        raise ValueError(f\"{path}: no FROM instructions\")\n    39\t    return images\n    40\t\n    41\t\n    42\tdef git(root: Path, *args: str) -> str:\n    43\t    return subprocess.check_output([\"git\", \"-C\", str(root), *args], text=True, timeout=30)\n    44\t\n    45\t\n    46\tdef census(root: Path, ref: str | None = None) -> dict:\n    47\t    tracked = git(root, \"ls-tree\", \"-rz\", \"--name-only\", ref) if ref else git(root, \"ls-files\", \"-z\")\n    48\t    paths = sorted(\n    49\t        path for path in tracked.split(\"\\0\") if path\n    50\t        and (Path(path).name == \"Dockerfile\" or Path(path).name.startswith(\"Dockerfile.\"))\n    51\t        and not path.startswith(\"packages/cli/templates/\")\n    52\t    )\n    53\t    records = []\n    54\t    for path in paths:\n    55\t        resolved = (root / path).resolve()\n    56\t        if not resolved.is_relative_to(root.resolve()):\n    57\t            raise ValueError(f\"{path}: Dockerfile escapes checkout\")\n    58\t        text = git(root, \"show\", f\"{ref}:{path}\") if ref else resolved.read_text()\n    59\t        records.extend(from_images(text, path))\n    60\t    if not records:\n    61\t        raise ValueError(\"no external base images found; refusing an empty scan\")\n    62\t    return {\n    63\t        \"source\": git(root, \"rev-parse\", ref or \"HEAD\").strip(),\n    64\t        \"dockerfiles\": paths,\n    65\t        \"references\": records,\n    66\t        \"images\": sorted({record[\"image\"] for record in records}),\n    67\t        \"platform\": \"linux/amd64\",\n    68\t    }\n    69\t\n    70\t\n    71\tdef scan(report: dict, output: Path) -> int:\n    72\t    output.mkdir(parents=True, exist_ok=True)\n    73\t    (output / \"base-images.json\").write_text(json.dumps(report, indent=2) + \"\\n\")\n    74\t    errors = []\n    75\t    for index, image in enumerate(report[\"images\"]):\n    76\t        try:\n    77\t            image_scan_policy.scan_image(image, output / f\"base-{index + 1}.json\", \"base\")\n    78\t        except (RuntimeError, ValueError, OSError, subprocess.SubprocessError) as error:\n    79\t            # R335: informational means operational failures are visible, not a gate.\n    80\t            errors.append({\"image\": image, \"error\": str(error)})\n    81\t            print(f\"::warning::raw base scan failed for image {index + 1}\", flush=True)\n    82\t    (output / \"base-scan-errors.json\").write_text(json.dumps(errors, indent=2) + \"\\n\")\n    83\t    return 0\n    84\t\n    85\t\n    86\tdef main() -> int:\n    87\t    parser = argparse.ArgumentParser(description=__doc__)\n    88\t    parser.add_argument(\"--list\", action=\"store_true\", help=\"print census without network access\")\n    89\t    parser.add_argument(\"--ref\", help=\"git ref for read-only census; requires --list\")\n    90\t    parser.add_argument(\"--output\", type=Path)\n    91\t    args = parser.parse_args()\n    92\t    if args.ref and not args.list:\n    93\t        parser.error(\"--ref requires --list; scans always use the checked-out source\")\n    94\t    root = Path(__file__).resolve().parents[2]\n    95\t    report = census(root, args.ref)\n    96\t    if args.list:\n    97\t        print(json.dumps(report, indent=2))\n    98\t        return 0\n    99\t    if args.output is None:\n   100\t        parser.error(\"--output is required for scanning\")\n   101\t    return scan(report, args.output.resolve())\n   102\t\n   103\t\n   104\tif __name__ == \"__main__\":\n   105\t    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
