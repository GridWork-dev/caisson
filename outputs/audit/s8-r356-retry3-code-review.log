spy: EmbedFetch = (url) => {\n94-      reached.push(String(url));\n95:      return Promise.resolve(okResponse([0.1, 0.2]));\n96-    };\n97-    for (const endpoint of [\n98-      \"https://169.254.169.254/latest/meta-data/\", // cloud metadata\n99-      \"https://127.0.0.1/v1\",\n100-      \"https://localhost/v1\",\n101-      \"https://10.0.0.5/v1\",\n102-      \"https://192.168.1.10/v1\",\n--\n113-    expect(reached).toEqual([]);\n114-  });\n115-\n116-  test(\"a public https endpoint still constructs and embeds\", async () => {\n117-    // The positive control. Without it the rejection sweep above passes just as well against a\n118-    // `createCloudEmbedder` that throws on everything.\n119-    const fetchDouble: EmbedFetch = () =>\n120:      Promise.resolve(okResponse([0.1, 0.2]));\n121-    const embedder = createCloudEmbedder(\n122-      {\n123-        endpoint: \"https://embed.example.com/v1\",\n124-        apiKey: \"key-123\",\n125-        model: \"m\",\n126-        dim: 2,\n127-      },\n128-      fetchDouble,\n129-    );\n130-    expect(await embedder.embed(\"hello\")).toEqual([0.1, 0.2]);\n131-  });\n132-\n133:  test(\"refuses to follow a redirect on the credential-bearing POST\", async () => {\n134-    // A 3xx would re-target the Bearer POST past the construction-time host check, which only\n135-    // ever saw the configured origin.\n136-    let init: RequestInit | undefined;\n137-    const fetchDouble: EmbedFetch = (_url, requestInit) => {\n138-      init = requestInit;\n139:      return Promise.resolve(okResponse([0.1, 0.2]));\n140-    };\n141-    const embedder = createCloudEmbedder(\n142-      {\n143-        endpoint: \"https://embed.example.com/v1\",\n144-        apiKey: \"key-123\",\n145-        model: \"m\",\n146-        dim: 2,\n147-      },\n148-      fetchDouble,\n149-    );\n150-    await embedder.embed(\"hello\");\n151:    expect(init?.redirect).toBe(\"error\");\n152-  });\n153-\n154-  test(\"scrubs content before the request body leaves the box\", async () => {\n155-    let sentBody = \"\";\n156-    const fetchDouble: EmbedFetch = (_url, init) => {\n157-      sentBody = String(init?.body ?? \"\");\n158:      return Promise.resolve(okResponse([0.1, 0.2]));\n159-    };\n160-    const embedder = createCloudEmbedder(\n161-      {\n162-        endpoint: \"https://embed.example.com/v1\",\n163-        apiKey: \"key-123\",\n164-        model: \"m\",\n165-        dim: 2,\n--\n195-        unexpected: true,\n196-      }),\n197-    ).toThrow(ValidationError);\n198-  });\n199-\n200-  test(\"a wrong-dim response throws fail-closed (never corrupts the index)\", async () => {\n201-    const fetchDouble: EmbedFetch = () =>\n202:      Promise.resolve(okResponse([0.1, 0.2, 0.3]));\n203-    const embedder = createCloudEmbedder(\n204-      {\n205-        endpoint: \"https://embed.example.com\",\n206-        apiKey: \"k\",\n207-        model: \"m\",\n208-        dim: 2,\n209-      },\n210-      fetchDouble,\n211-    );\n212-    await expect(embedder.embed(\"hello\")).rejects.toThrow(ValidationError);\n213-  });\n214-\n215-  test(\"a failed transport throws a redaction-safe error (no secret)\", async () => {\n216-    const fetchDouble: EmbedFetch = () =>\n217:      Promise.resolve(new Response(\"upstream detail\", { status: 500 }));\n218-    const embedder = createCloudEmbedder(\n219-      {\n220-        endpoint: \"https://embed.example.com\",\n221-        apiKey: \"super-secret-key\",\n222-        model: \"m\",\n223-        dim: 2,\n224-      },\n","exit_code":0,"status":"completed"}}
