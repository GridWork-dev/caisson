{"type":"item.completed","item":{"id":"item_88","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/local-store/src/embed-scrub-guard.ts'","aggregated_output":"     1\t// src/embed-scrub-guard.ts — the cloud-embed secret-scrub guard (ADR-0067, security-critical). The\n     2\t// Embedder PORT is the ONE path that can carry buyer content OFF the box (to a cloud embedder).\n     3\t// Before any such egress, credential-bearing spans MUST be scrubbed, and the embed transport stays a\n     4\t// TEST-DOUBLED seam — no live cloud call ever runs in CI (the live transport is the only\n     5\t// un-exercised path).\n     6\t//\n     7\t// Threats this guard models: (1) PII/credential content egressing to a cloud embedder —\n     8\t// every text is run through `scrubForEgress` BEFORE it leaves; (2) a secret landing in a log/sink —\n     9\t// nothing here logs the input, and thrown errors carry only a status/dim, never the content, the\n    10\t// `apiKey`, or the rejected value; (3) a live cloud call sneaking into CI — the transport defaults to\n    11\t// `fetchWithTimeout` but is an injectable seam tests replace with a double.\n    12\t//\n    13\t// `scrubForEgress`/`looksLikeSecret` moved to `@caisson/kernel` (`secret-scrub.ts`, ADR-0215) —\n    14\t// kernel is the lowest-license, zero-dep home both this package and `guardrails` already depend on,\n    15\t// so the scrub predicate has exactly ONE implementation. Re-exported here so this module's public\n    16\t// surface (and every existing import of it) stays unchanged. The scrub contract itself is still golden-pinned\n    17\t// at `src/__golden__/scrub.json` (applied in this fixed order, each secret span collapsing to the\n    18\t// constant sentinel `[REDACTED]` — no entropy is ever echoed):\n    19\t//   A. PEM private-key block  → the whole armored block to the sentinel.\n    20\t//   B. URL userinfo password  (`scheme://user:pass@host`) → `scheme://user:[REDACTED]@host`.\n    21\t//   C. Secret-NAMED assignment(`<key><=|: ><value>`, key in the secret-name set) → drop the value.\n    22\t//   D. Bare inline token shape (AWS / GitHub / OpenAI / JWT, no key=value context) → the sentinel.\n    23\t// Non-secret text passes through unchanged (no false-positive redaction).\n    24\timport { z } from \"zod\";\n    25\timport {\n    26\t  fetchWithTimeout,\n    27\t  InternalError,\n    28\t  looksLikeSecret,\n    29\t  parseStrict,\n    30\t  scrubForEgress,\n    31\t  strictObject,\n    32\t} from \"@caisson/kernel\";\n    33\t// The `/node` subpath, not the root: `ssrf.ts` reaches `node:dns/promises`. Safe here because\n    34\t// `createCloudEmbedder` is exported only from the node entry (`index.ts`) — never from\n    35\t// `./browser`, whose graph deliberately excludes this module.\n    36\timport { assertSafePublicUrl } from \"@caisson/kernel/node\";\n    37\timport { assertEmbeddingDim } from \"./embedder.ts\";\n    38\timport type { Embedder } from \"./embedder.ts\";\n    39\t\n    40\texport { scrubForEgress, looksLikeSecret };\n    41\t\n    42\t/**\n    43\t * Wrap ANY embedder so every text is scrubbed BEFORE it reaches the backend (the cloud-egress guard).\n    44\t * Engine-neutral — works for a local or cloud backend; the wrapped embedder never sees a raw secret,\n    45\t * and nothing here logs the input. This is the reusable primitive the cloud transport composes.\n    46\t */\n    47\texport function guardEmbedder(inner: Embedder): Embedder {\n    48\t  return {\n    49\t    dim: inner.dim,\n    50\t    embed: (text: string): Promise<number[]> =>\n    51\t      inner.embed(scrubForEgress(text)),\n    52\t  };\n    53\t}\n    54\t\n    55\t/** Buyer config for the reference guarded cloud embedder — validated `.strict()` at the boundary. */\n    56\tconst CloudEmbedConfigSchema = strictObject({\n    57\t  /** HTTPS embedding endpoint. Non-https (incl. `http:`/`file:`/`data:`) is rejected fail-closed. */\n    58\t  endpoint: z\n    59\t    .string()\n    60\t    .url()\n    61\t    .refine((u) => {\n    62\t      try {\n    63\t        return new URL(u).protocol === \"https:\";\n    64\t      } catch {\n    65\t        return false;\n    66\t      }\n    67\t    }, \"endpoint must be https\"),\n    68\t  /** Bearer credential for the endpoint — the legitimate egress credential; never logged. */\n    69\t  apiKey: z.string().min(1),\n    70\t  /** Model identifier forwarded to the endpoint. */\n    71\t  model: z.string().min(1),\n    72\t  /** Fixed embedding width; the returned vector is asserted to this dim (fail-closed). */\n    73\t  dim: z.number().int().positive(),\n    74\t  /** Optional request timeout (ms) for the embed fetch; absent ⇒ the `fetchWithTimeout` default. */\n    75\t  timeoutMs: z.number().int().positive().max(120_000).optional(),\n    76\t});\n    77\t\n    78\t/** Boundary-valid cloud-embedder config. */\n    79\texport type CloudEmbedConfig = z.infer<typeof CloudEmbedConfigSchema>;\n    80\t\n    81\t/**\n    82\t * The embed transport seam. Defaults to `fetchWithTimeout` (the only sanctioned outbound-fetch path\n    83\t * on Bun); tests inject a double with the same signature, so CI never makes a live cloud call.\n    84\t */\n    85\texport type EmbedFetch = typeof fetchWithTimeout;\n    86\t\n    87\t/** The canonical wire response `createCloudEmbedder`'s endpoint must return — strict boundary. */\n    88\tconst EmbedResponseSchema = strictObject({\n    89\t  embedding: z.array(z.number()),\n    90\t});\n    91\t\n    92\t/**\n    93\t * Build a reference guarded cloud embedder: it scrubs content (via `guardEmbedder`) BEFORE the body\n    94\t * leaves the box, POSTs the scrubbed text over `fetchWithTimeout` (injectable for tests — no live CI\n    95\t * call), and validates the response against `config.dim` (a wrong-width vector throws, never silently\n    96\t * corrupts the index). The endpoint's response contract is the strict `{ embedding: number[] }` shape;\n    97\t * a backend with a different response shape is wired through `guardEmbedder` around its own client.\n    98\t *\n    99\t * Redaction-safe throughout: nothing logs the content or the `apiKey`, and a failed transport throws\n   100\t * an `InternalError` carrying only the HTTP status — never the body, the key, or the input.\n   101\t */\n   102\texport function createCloudEmbedder(\n   103\t  rawConfig: unknown,\n   104\t  fetchImpl: EmbedFetch = fetchWithTimeout,\n   105\t): Embedder {\n   106\t  const config = parseStrict(CloudEmbedConfigSchema, rawConfig);\n   107\t  // The schema's `.refine` proves the SCHEME; it says nothing about the DESTINATION. Without this,\n   108\t  // `https://169.254.169.254/…` or any internal host is a valid config and `embed()` POSTs the\n   109\t  // Bearer credential there. Checked once at construction, not per-embed: `guardEmbedder` wraps\n   110\t  // per-text, so a resolving (DNS) guard on that path would cost a lookup per embedded string and\n   111\t  // break split-horizon deployments. Literal-host containment is what this seam can honestly claim.\n   112\t  assertSafePublicUrl(config.endpoint);\n   113\t  return guardEmbedder({\n   114\t    dim: config.dim,\n   115\t    // `text` is ALREADY scrubbed by the `guardEmbedder` wrapper — scrub-before-egress is structural.\n   116\t    embed: async (text: string): Promise<number[]> => {\n   117\t      // Omit `timeoutMs` entirely when unset (exactOptionalPropertyTypes) ⇒ the fetchWithTimeout default.\n   118\t      const timeout =\n   119\t        config.timeoutMs === undefined ? {} : { timeoutMs: config.timeoutMs };\n   120\t      const res = await fetchImpl(\n   121\t        config.endpoint,\n   122\t        {\n   123\t          method: \"POST\",\n   124\t          headers: {\n   125\t            \"content-type\": \"application/json\",\n   126\t            authorization: `Bearer ${config.apiKey}`,\n   127\t          },\n   128\t          body: JSON.stringify({ model: config.model, input: text }),\n   129\t          // A 3xx to a private host would otherwise re-target the credential-bearing POST past the\n   130\t          // construction-time check above, which only ever saw the configured origin.\n   131\t          redirect: \"error\",\n   132\t        },\n   133\t        timeout,\n   134\t      );\n   135\t      if (!res.ok) {\n   136\t        // Status only — never the response body, the key, or the content.\n   137\t        throw new InternalError(\"cloud embed request failed\", {\n   138\t          status: res.status,\n   139\t        });\n   140\t      }\n   141\t      const json: unknown = await res.json();\n   142\t      const { embedding } = parseStrict(EmbedResponseSchema, json);\n   143\t      assertEmbeddingDim(config.dim, embedding);\n   144\t      return embedding;\n   145\t    },\n   146\t  });\n   147\t}\n","exit_code":0,"status":"completed"}}
