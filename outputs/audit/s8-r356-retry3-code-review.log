{"type":"item.completed","item":{"id":"item_86","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/tool-exec/src/propose.ts'","aggregated_output":"     1\t// The validation gate — the pure half of @caisson/tool-exec (ADR-0153, ADR-0360 S3 phase 1),\n     2\t// carved out of tool-exec.ts so it can be imported without dragging `node:child_process` behind\n     3\t// it. Nothing here reaches a node builtin: it is a Map lookup, a Zod parse, and plain data.\n     4\t// `@caisson/tool-exec/browser` is exactly this module (ADR-0396); the `.` barrel re-exports it.\n     5\t//\n     6\t// This is the ONLY implementation of the gate — `createToolExec`'s `run` and `propose` both call\n     7\t// `propose()` below, so default-deny and schema-validation can never diverge between the\n     8\t// single-phase and two-phase paths.\n     9\timport type { ZodType } from \"zod\";\n    10\timport { NotFoundError, parseStrict } from \"@caisson/kernel\";\n    11\t\n    12\t/**\n    13\t * A registered allowlist entry: a logical name, the real executable, and its argv-array schema.\n    14\t *\n    15\t * `env` is OPTIONAL and additive: when absent, the spawned process inherits the parent's full\n    16\t * environment (Node's `execFile` default) — today's behavior, unchanged. Pass `env` to narrow the\n    17\t * child to exactly the vars it needs; the object is used VERBATIM (never merged with\n    18\t * `process.env`), so a caller that wants `PATH` must include it explicitly. Flipping the default\n    19\t * to always-narrow is a separate, deliberate major-version change — not made here.\n    20\t */\n    21\texport interface CommandSpec {\n    22\t  readonly name: string;\n    23\t  readonly command: string;\n    24\t  /** Validates the caller-supplied `args` INTO the exact argv array passed to `execFile`. */\n    25\t  readonly argsSchema: ZodType<string[]>;\n    26\t  /** Optional child environment. Absent → inherits the parent's full env (the default). */\n    27\t  readonly env?: Readonly<Record<string, string>>;\n    28\t}\n    29\t\n    30\t/**\n    31\t * A validated, not-yet-executed call (ADR-0360 S3 two-phase gate): the allowlist lookup + Zod\n    32\t * validation have already run, so `execute` never re-validates `args` — the recorded `args` here\n    33\t * ARE the exact argv `execute` will spawn. Serializable (plain data) so a caller can park it in an\n    34\t * external approval store between `propose` and `execute` without re-deriving anything.\n    35\t */\n    36\texport interface ProposedToolCall {\n    37\t  readonly name: string;\n    38\t  readonly command: string;\n    39\t  readonly args: readonly string[];\n    40\t  readonly reason?: string;\n    41\t  /** The allowlist entry's `env`, resolved at propose time and carried through unmodified. */\n    42\t  readonly env?: Readonly<Record<string, string>>;\n    43\t}\n    44\t\n    45\t/** The gate itself, with no spawn seam attached — safe to run anywhere, including a browser. */\n    46\texport interface ToolProposer {\n    47\t  /** The allowlist lookup, default-deny: an unregistered name resolves to `undefined`. */\n    48\t  lookup(name: string): CommandSpec | undefined;\n    49\t  /**\n    50\t   * Validate `args` against the allowlisted command's schema WITHOUT spawning anything.\n    51\t   * Unregistered `name` throws `NotFoundError`; a bad shape throws `ValidationError` (from\n    52\t   * `parseStrict`) — so a proposal that parks for external approval is already known-safe-to-\n    53\t   * execute the moment it exists.\n    54\t   */\n    55\t  propose(name: string, args: unknown, reason?: string): ProposedToolCall;\n    56\t}\n    57\t\n    58\t/**\n    59\t * Build the phase-1 gate over an allowlist. Default-deny by construction: the registry holds\n    60\t * exactly the entries handed in, and an empty/absent allowlist refuses every call.\n    61\t */\n    62\texport function createToolProposer(\n    63\t  allowlist: readonly CommandSpec[],\n    64\t): ToolProposer {\n    65\t  const registry = new Map<string, CommandSpec>(\n    66\t    allowlist.map((spec) => [spec.name, spec]),\n    67\t  );\n    68\t  return {\n    69\t    lookup(name: string): CommandSpec | undefined {\n    70\t      return registry.get(name);\n    71\t    },\n    72\t    propose(name: string, args: unknown, reason?: string): ProposedToolCall {\n    73\t      const spec = registry.get(name);\n    74\t      if (spec === undefined) {\n    75\t        throw new NotFoundError(`No command registered for \"${name}\"`, {\n    76\t          command: name,\n    77\t        });\n    78\t      }\n    79\t      const validatedArgs = parseStrict(spec.argsSchema, args);\n    80\t      const proposed: ProposedToolCall = {\n    81\t        name,\n    82\t        command: spec.command,\n    83\t        args: validatedArgs,\n    84\t      };\n    85\t      const withReason =\n    86\t        reason === undefined ? proposed : { ...proposed, reason };\n    87\t      return spec.env === undefined\n    88\t        ? withReason\n    89\t        : { ...withReason, env: spec.env };\n    90\t    },\n    91\t  };\n    92\t}\n","exit_code":0,"status":"completed"}}
