{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba services/license/src/deploy.ts'","aggregated_output":"     1\t// src/deploy.ts — the production deploy entrypoint (Stage-2, ADR-0110/0139). server.ts's\n     2\t// `import.meta.main` is a deliberate hard stop: `startServer(db)` takes the tenant Transactor as an\n     3\t// injected argument and the repo has no in-tree production Postgres pool. This file supplies one — a\n     4\t// node-postgres Pool over DATABASE_URL wrapped in a Transactor — and calls startServer(db).\n     5\t//\n     6\timport { createPgPool, createPgTransactor } from \"@caisson/tenancy-rls\";\n     7\timport { startServer } from \"./server.ts\";\n     8\t\n     9\tif (import.meta.main) {\n    10\t  // Fail closed: a production issuer must NEVER fall back to an in-memory PGlite double the way\n    11\t  // apps/site's dev-only getDb does. An unset DATABASE_URL aborts startup before the socket binds,\n    12\t  // matching server.ts's fail-closed posture on the token + signing key. Never log the URL.\n    13\t  const url = process.env.DATABASE_URL ?? \"\";\n    14\t  if (url.length === 0) {\n    15\t    throw new Error(\n    16\t      \"DATABASE_URL is required (the license issuer needs a Postgres Transactor) — refusing to start.\",\n    17\t    );\n    18\t  }\n    19\t  const pool = createPgPool(url);\n    20\t  const db = createPgTransactor(pool);\n    21\t  // Bun.serve inside startServer holds the event loop open — the process stays up serving.\n    22\t  startServer(db);\n    23\t}\n","exit_code":0,"status":"completed"}}
