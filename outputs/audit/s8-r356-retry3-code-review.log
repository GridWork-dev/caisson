{"type":"item.completed","item":{"id":"item_69","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/admin/src/proxy.ts'","aggregated_output":"     1\t// App-wide edge + auth gate. The Cloudflare origin secret and Access JWT layers are armed by\n     2\t// default; only exact development/test mode opt-outs disable them. Exact `/healthz` is the narrow\n     3\t// exception: it answers ahead of BOTH edge layers, because Railway's platform healthcheck reaches\n     4\t// the container internally and can carry neither the Worker-injected origin secret nor an Access\n     5\t// JWT (ADR-0416 ruling 1 — before this carve every deploy failed at admin's healthcheck and froze\n     6\t// the whole fleet). The route itself is status-only for unauthenticated callers, so the class the\n     7\t// carve admits — the raw *.up.railway.app origin the Worker never sees — gets a liveness ping and\n     8\t// nothing more. Better-auth plus the immutable numeric GitHub-ID allowlist remains the independent\n     9\t// application authorization layer for every non-bootstrap route.\n    10\t//\n    11\t// Named `proxy.ts` (not `middleware.ts`): Next 16 deprecated `middleware.ts` in favor of\n    12\t// `proxy.ts`, which defaults to the Node.js runtime (no `export const runtime` — Next throws if\n    13\t// one is set here). That default is load-bearing this time, unlike the old file: verifying a\n    14\t// better-auth session needs `pg`/`node:crypto`, which never ran in the old file's Edge runtime.\n    15\t//\n    16\t// Bootstrap/static routes bypass only the better-auth session check. They still pass through both\n    17\t// edge layers when armed, except for the exact origin-authenticated `/healthz` canary path above.\n    18\timport {\n    19\t  loadOriginGateConfig,\n    20\t  originRequestAuthorized,\n    21\t  servingRevision,\n    22\t  REVISION_HEADER,\n    23\t  type OriginGateConfig,\n    24\t} from \"@caisson/kernel/node\";\n    25\timport { NextResponse, type NextRequest } from \"next/server\";\n    26\timport {\n    27\t  loadCloudflareAccessConfig,\n    28\t  verifyCloudflareAccessRequest,\n    29\t  type CloudflareAccessConfig,\n    30\t} from \"@/lib/cloudflare-access\";\n    31\timport {\n    32\t  authenticateInternalProofRequest,\n    33\t  parseInternalProofAuthConfig,\n    34\t} from \"@/lib/internal-proof-auth\";\n    35\timport { verifyAdminSession } from \"@/lib/admin-session\";\n    36\t\n    37\texport const config = {\n    38\t  matcher: [\"/:path*\"],\n    39\t};\n    40\t\n    41\t// The edge layers never replace route authorization. Better-auth/internal-proof checks below stay\n    42\t// authoritative for app actions, including Server Function POSTs delivered to their host route.\n    43\t\n    44\t/** Header carrying the verified admin actor email to route handlers (ADR-0220 — unchanged shape;\n    45\t *  only the verification mechanism behind it moved from CF-Access-JWT to better-auth+allowlist). */\n    46\tconst ACTOR_HEADER = \"x-admin-actor\";\n    47\tconst INTERNAL_PROOF_PATH = \"/api/internal/audit/proof\";\n    48\t\n    49\t/** The one path exempt from both edge layers. MUST equal `healthcheckPath` in\n    50\t *  apps/admin/railway.toml — a test pins the pair, because a drift there silently re-freezes the\n    51\t *  fleet deploy with no local signal. */\n    52\texport const HEALTH_PROBE_PATH = \"/healthz\";\n    53\t\n    54\texport interface AdminProxyOptions {\n    55\t  originGate?: OriginGateConfig;\n    56\t  access?: CloudflareAccessConfig;\n    57\t}\n    58\t\n    59\tfunction edgeForbidden(): NextResponse {\n    60\t  return NextResponse.json(\n    61\t    { error: \"forbidden\" },\n    62\t    {\n    63\t      status: 403,\n    64\t      headers: {\n    65\t        \"Cache-Control\": \"no-store\",\n    66\t        \"X-Content-Type-Options\": \"nosniff\",\n    67\t        \"X-Frame-Options\": \"DENY\",\n    68\t        \"Strict-Transport-Security\":\n    69\t          \"max-age=63072000; includeSubDomains; preload\",\n    70\t      },\n    71\t    },\n    72\t  );\n    73\t}\n    74\t\n    75\tfunction sessionExempt(pathname: string): boolean {\n    76\t  return (\n    77\t    pathname.startsWith(\"/_next/\") ||\n    78\t    pathname === \"/favicon.ico\" ||\n    79\t    /^\\/healthz(?:\\/|$)/.test(pathname) ||\n    80\t    /^\\/login(?:\\/|$)/.test(pathname) ||\n    81\t    /^\\/api\\/auth(?:\\/|$)/.test(pathname)\n    82\t  );\n    83\t}\n    84\t\n    85\t// Duplicated from apps/site/proxy.ts rather than shared: @caisson/kernel is framework-agnostic\n    86\t// (services/docs and services/license run on Bun.serve) and must not import next/server.\n    87\texport function normalizeTrailingSlash(req: NextRequest): NextResponse | null {\n    88\t  const { pathname } = req.nextUrl;\n    89\t  if (pathname === \"/\" || !pathname.endsWith(\"/\")) return null;\n    90\t  // A plain URL, not nextUrl.clone(): NextURL re-serializes the pathname through its own\n    91\t  // formatter and hands back the trailing slash we just stripped.\n    92\t  const url = new URL(req.url);\n    93\t  url.pathname = pathname.replace(/\\/+$/, \"\") || \"/\";\n    94\t  return NextResponse.redirect(url, 308);\n    95\t}\n    96\t\n    97\tfunction deny(req: NextRequest): NextResponse {\n    98\t  if (req.nextUrl.pathname.startsWith(\"/api/\")) {\n    99\t    return new NextResponse(\"unauthorized\", {\n   100\t      status: 401,\n   101\t      headers: { \"Content-Type\": \"text/plain; charset=utf-8\" },\n   102\t    });\n   103\t  }\n   104\t  const url = new URL(\"/login\", req.url);\n   105\t  url.searchParams.set(\"next\", req.nextUrl.pathname);\n   106\t  const res = NextResponse.redirect(url);\n   107\t  // Best-effort: drop a stale/disallowed session cookie so a re-visit doesn't optimistically\n   108\t  // render authed chrome client-side before the next server check runs.\n   109\t  for (const cookie of req.cookies.getAll()) {\n   110\t    if (\n   111\t      cookie.name.endsWith(\"session_token\") ||\n   112\t      cookie.name.endsWith(\"session_data\")\n   113\t    ) {\n   114\t      res.cookies.delete(cookie.name);\n   115\t    }\n   116\t  }\n   117\t  return res;\n   118\t}\n   119\t\n   120\texport function createAdminProxy(\n   121\t  options: AdminProxyOptions = {},\n   122\t): (req: NextRequest) => Promise<NextResponse> {\n   123\t  // Resolve once per instance so jose's remote JWKS cache survives across requests. A required\n   124\t  // but malformed configuration throws while the proxy module loads, failing startup/readiness.\n   125\t  const originGate = options.originGate ?? loadOriginGateConfig(process.env);\n   126\t  const access = options.access ?? loadCloudflareAccessConfig(process.env);\n   127\t\n   128\t  const route = async (req: NextRequest): Promise<NextResponse> => {\n   129\t    // Exact equality, never a prefix: `/healthz/`, `/healthzz` and `/healthz/anything` are not the\n   130\t    // probe path and stay behind both gates. Railway probes the configured healthcheckPath and\n   131\t    // nothing else, so exempting more than the literal string widens the carve for no benefit.\n   132\t    if (req.nextUrl.pathname === HEALTH_PROBE_PATH) return NextResponse.next();\n   133\t    if (!originRequestAuthorized(req, originGate)) return edgeForbidden();\n   134\t    if (!(await verifyCloudflareAccessRequest(req, access))) {\n   135\t      return edgeForbidden();\n   136\t    }\n   137\t\n   138\t    // Behind BOTH edge gates by design — `skipTrailingSlashRedirect` in next.config.ts moved this\n   139\t    // off Next's pre-proxy redirect array, where `/healthz/` had been answering 308 without\n   140\t    // passing either. Normalizing here also keeps sessionExempt's anchored patterns honest.\n   141\t    const normalized = normalizeTrailingSlash(req);\n   142\t    if (normalized !== null) return normalized;\n   143\t\n   144\t    if (sessionExempt(req.nextUrl.pathname)) return NextResponse.next();\n   145\t\n   146\t    if (req.nextUrl.pathname === INTERNAL_PROOF_PATH) {\n   147\t      const proofConfig = parseInternalProofAuthConfig({\n   148\t        secret: process.env.CAISSON_PROOF_PROXY_SECRET,\n   149\t        internalHost: process.env.CAISSON_PROOF_PROXY_INTERNAL_HOST,\n   150\t      });\n   151\t      if (\n   152\t        proofConfig !== null &&\n   153\t        authenticateInternalProofRequest(req, proofConfig) !== null\n   154\t      ) {\n   155\t        return NextResponse.next();\n   156\t      }\n   157\t      return deny(req);\n   158\t    }\n   159\t\n   160\t    const actor = await verifyAdminSession(req);\n   161\t    if (actor === null) return deny(req);\n   162\t    // Thread the VERIFIED actor to route handlers. `set` REPLACES any inbound x-admin-actor, so a\n   163\t    // client cannot spoof the audit actor — the only value a route ever sees is this verified one.\n   164\t    const headers = new Headers(req.headers);\n   165\t    headers.set(ACTOR_HEADER, actor.email);\n   166\t    return NextResponse.next({ request: { headers } });\n   167\t  };\n   168\t\n   169\t  // Stamp the serving revision at the ONE exit point, so every branch above carries it — the\n   170\t  // health passthrough, both edge 403s, the 308, the session redirect, the authed pass-through.\n   171\t  // The 403 and the redirect matter most: admin is fronted by Cloudflare Access, so those are the\n   172\t  // responses an operator actually sees while diagnosing, and a body tells them nothing about\n   173\t  // which build produced it. Ungated for the same reason the site's is.\n   174\t  return async (req: NextRequest): Promise<NextResponse> => {\n   175\t    const response = await route(req);\n   176\t    response.headers.set(REVISION_HEADER, servingRevision());\n   177\t    return response;\n   178\t  };\n   179\t}\n   180\t\n   181\texport const proxy = createAdminProxy();\n","exit_code":0,"status":"completed"}}
