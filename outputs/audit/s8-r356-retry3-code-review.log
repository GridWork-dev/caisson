{"type":"item.completed","item":{"id":"item_85","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/tool-exec/src/tool-exec.ts'","aggregated_output":"     1\t// @caisson/tool-exec — governed tool-call / sandboxed-exec primitive (ADR-0153). The security\n     2\t// floor is the whole point: a default-deny allowlist maps a logical command NAME to a real\n     3\t// executable + a Zod-`.strict()` argument schema; a call is validated against that schema BEFORE\n     4\t// spawn, and the validated result is used directly as an `execFile` argv array — never a shell\n     5\t// string, never concatenated. `execSync`/`exec`/`shell: true` are never used anywhere in this file.\n     6\t// ENV DEFAULT: an allowlist entry's optional `env` is absent by default, so a spawned process\n     7\t// inherits the parent's full environment (Node's `execFile` default) — unchanged today. Set\n     8\t// `env` on a `CommandSpec` to narrow a child to exactly the vars it needs (used verbatim, never\n     9\t// merged with `process.env`). Flipping the default to always-narrow is a separate major bump.\n    10\timport { execFile as execFileCb } from \"node:child_process\";\n    11\timport { NotFoundError } from \"@caisson/kernel\";\n    12\timport { createToolProposer } from \"./propose.ts\";\n    13\timport type { CommandSpec, ProposedToolCall } from \"./propose.ts\";\n    14\t\n    15\t/** Structured argument provenance for one governed call. Plain data, not WORM. */\n    16\texport interface ExecResult {\n    17\t  readonly command: string;\n    18\t  readonly args: readonly string[];\n    19\t  readonly exitCode: number;\n    20\t  readonly stdout: string;\n    21\t  readonly stderr: string;\n    22\t  readonly ok: boolean;\n    23\t  /** Caller-supplied tag (e.g. why this call was made), carried through unmodified. */\n    24\t  readonly reason?: string;\n    25\t  readonly at: number;\n    26\t}\n    27\t\n    28\t/**\n    29\t * The spawn seam: `(command, args, opts) => { stdout, stderr, exitCode }`. Tests inject a double\n    30\t * so the suite never spawns a real process; the default drives `node:child_process.execFile` —\n    31\t * an argv ARRAY, no shell — with output captured and bounded.\n    32\t */\n    33\texport type ExecFn = (\n    34\t  command: string,\n    35\t  args: readonly string[],\n    36\t  opts: {\n    37\t    cwd: string;\n    38\t    timeoutMs: number;\n    39\t    /** Optional child environment. Absent → inherits the parent's full env (the default). */\n    40\t    env?: Readonly<Record<string, string>>;\n    41\t  },\n    42\t) => Promise<{ stdout: string; stderr: string; exitCode: number }>;\n    43\t\n    44\tconst DEFAULT_TIMEOUT_MS = 30_000;\n    45\tconst MAX_OUTPUT_BYTES = 64 * 1024;\n    46\t/** Generous vs. `MAX_OUTPUT_BYTES` — Node's own overflow error is avoided; OUR cap truncates below. */\n    47\tconst NODE_MAX_BUFFER = 10 * 1024 * 1024;\n    48\t\n    49\tfunction bound(output: string): string {\n    50\t  return output.length > MAX_OUTPUT_BYTES\n    51\t    ? output.slice(0, MAX_OUTPUT_BYTES)\n    52\t    : output;\n    53\t}\n    54\t\n    55\t/**\n    56\t * Default `ExecFn`. `execFile(command, argsArray, opts)` — never a shell string, `shell` is never\n    57\t * set. A non-zero exit resolves (not rejects) with that exit code; a spawn failure (e.g. ENOENT,\n    58\t * a non-numeric `error.code`) resolves with `exitCode: -1` — the caller always gets a provenance\n    59\t * record, never a thrown Error from the exec leg itself.\n    60\t */\n    61\tconst defaultExecFn: ExecFn = (command, args, opts) =>\n    62\t  new Promise((resolve) => {\n    63\t    const execOpts =\n    64\t      opts.env === undefined\n    65\t        ? { cwd: opts.cwd, timeout: opts.timeoutMs, maxBuffer: NODE_MAX_BUFFER }\n    66\t        : {\n    67\t            cwd: opts.cwd,\n    68\t            timeout: opts.timeoutMs,\n    69\t            maxBuffer: NODE_MAX_BUFFER,\n    70\t            env: opts.env,\n    71\t          };\n    72\t    execFileCb(command, [...args], execOpts, (error, stdout, stderr) => {\n    73\t      const out = bound(stdout);\n    74\t      const err = bound(stderr);\n    75\t      if (error === null) {\n    76\t        resolve({ stdout: out, stderr: err, exitCode: 0 });\n    77\t        return;\n    78\t      }\n    79\t      const code = (error as { code?: unknown }).code;\n    80\t      resolve({\n    81\t        stdout: out,\n    82\t        stderr: err,\n    83\t        exitCode: typeof code === \"number\" ? code : -1,\n    84\t      });\n    85\t    });\n    86\t  });\n    87\t\n    88\texport interface ToolExecConfig {\n    89\t  /** Default-deny registry. Empty/absent refuses every call (fail-closed). */\n    90\t  readonly allowlist: readonly CommandSpec[];\n    91\t  readonly cwd?: string;\n    92\t  readonly timeoutMs?: number;\n    93\t  /** Injectable spawn seam — tests supply a double so no real process is spawned. */\n    94\t  readonly execFn?: ExecFn;\n    95\t  /** Injectable clock — never `Date.now()` inline, so provenance timestamps are testable. */\n    96\t  readonly now?: () => number;\n    97\t}\n    98\t\n    99\texport interface ToolExec {\n   100\t  run(name: string, args: unknown, reason?: string): Promise<ExecResult>;\n   101\t  /**\n   102\t   * Two-phase gate, phase 1: validate `args` against the allowlisted command's schema WITHOUT\n   103\t   * spawning anything. Same fail-closed lookup/validation as `run` — unregistered `name` throws\n   104\t   * `NotFoundError`, a bad shape throws `ValidationError` — so a proposal that parks for external\n   105\t   * approval is already known-safe-to-execute the moment it exists.\n   106\t   */\n   107\t  propose(\n   108\t    name: string,\n   109\t    args: unknown,\n   110\t    reason?: string,\n   111\t  ): Promise<ProposedToolCall>;\n   112\t  /**\n   113\t   * Two-phase gate, phase 2: execute a call `propose` already validated (e.g. after an external\n   114\t   * approval decision). Re-checks the name is STILL allowlisted to the SAME command — defense\n   115\t   * against the allowlist changing between propose and execute — but never re-validates `args`,\n   116\t   * which were already validated at propose time.\n   117\t   */\n   118\t  execute(proposed: ProposedToolCall): Promise<ExecResult>;\n   119\t}\n   120\t\n   121\t/**\n   122\t * Build a governed tool-call gate over `config.allowlist`. `run(name, args, reason?)`:\n   123\t * 1. Look up `name` in the allowlist — unregistered throws `NotFoundError` (default-deny).\n   124\t * 2. Validate `args` against that command's `argsSchema` via `parseStrict` — a bad shape throws\n   125\t *    `ValidationError` (from `parseStrict`) BEFORE anything is spawned.\n   126\t * 3. Spawn via the injected `ExecFn` (defaults to `execFile`, argv array, no shell) and return the\n   127\t *    full provenance record.\n   128\t *\n   129\t * `propose`/`execute` (ADR-0360 S3) split steps 1-2 from step 3 — additive; `run`'s single-phase\n   130\t * path is unchanged for non-gated tools.\n   131\t */\n   132\texport function createToolExec(config: ToolExecConfig): ToolExec {\n   133\t  // The lookup + validation gate is the pure `./propose.ts` module — one implementation, shared by\n   134\t  // `run` and `propose` so the single-phase and two-phase paths can never drift apart.\n   135\t  const gate = createToolProposer(config.allowlist);\n   136\t  const cwd = config.cwd ?? process.cwd();\n   137\t  const timeoutMs = config.timeoutMs ?? DEFAULT_TIMEOUT_MS;\n   138\t  const execFn = config.execFn ?? defaultExecFn;\n   139\t  const now = config.now ?? Date.now;\n   140\t\n   141\t  const spawn = async (\n   142\t    command: string,\n   143\t    args: readonly string[],\n   144\t    reason: string | undefined,\n   145\t    env: Readonly<Record<string, string>> | undefined,\n   146\t  ): Promise<ExecResult> => {\n   147\t    const { stdout, stderr, exitCode } = await execFn(\n   148\t      command,\n   149\t      args,\n   150\t      env === undefined ? { cwd, timeoutMs } : { cwd, timeoutMs, env },\n   151\t    );\n   152\t    const result: ExecResult = {\n   153\t      command,\n   154\t      args,\n   155\t      exitCode,\n   156\t      stdout,\n   157\t      stderr,\n   158\t      ok: exitCode === 0,\n   159\t      at: now(),\n   160\t    };\n   161\t    return reason === undefined ? result : { ...result, reason };\n   162\t  };\n   163\t\n   164\t  return {\n   165\t    async run(\n   166\t      name: string,\n   167\t      args: unknown,\n   168\t      reason?: string,\n   169\t    ): Promise<ExecResult> {\n   170\t      const proposed = gate.propose(name, args, reason);\n   171\t      return spawn(proposed.command, proposed.args, reason, proposed.env);\n   172\t    },\n   173\t\n   174\t    async propose(\n   175\t      name: string,\n   176\t      args: unknown,\n   177\t      reason?: string,\n   178\t    ): Promise<ProposedToolCall> {\n   179\t      return gate.propose(name, args, reason);\n   180\t    },\n   181\t\n   182\t    async execute(proposed: ProposedToolCall): Promise<ExecResult> {\n   183\t      const spec = gate.lookup(proposed.name);\n   184\t      if (spec === undefined || spec.command !== proposed.command) {\n   185\t        throw new NotFoundError(\n   186\t          `No command registered for \"${proposed.name}\" matching its proposed command (allowlist changed since propose)`,\n   187\t          { command: proposed.name },\n   188\t        );\n   189\t      }\n   190\t      return spawn(spec.command, proposed.args, proposed.reason, proposed.env);\n   191\t    },\n   192\t  };\n   193\t}\n","exit_code":0,"status":"completed"}}
