{"type":"item.completed","item":{"id":"item_74","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/agent-kernel/src/hooks.ts'","aggregated_output":"     1\t// The hooks dispatcher (ADR-0065/0066). Engine-neutral: handlers observe — and may govern —\n     2\t// lifecycle act transitions at `${'before'|'after'}:${act}` points. The dispatcher NEVER runs an\n     3\t// engine and NEVER rewrites the FSM adjacency; it folds handler outcomes through the unified\n     4\t// `HookResult` shape and is hardened for buyer loops:\n     5\t//   - FAIL-OPEN on infra failure: a handler that THROWS, and a DOWN/slow sink, never block the loop\n     6\t//     and never veto — they are isolated, the loop continues (an observer crash is not a policy).\n     7\t//   - FAIL-CLOSED on an EXPLICIT veto: a handler that returns `deny(reason)` short-circuits dispatch\n     8\t//     (the first veto wins) — governance decisions are honored.\n     9\t//   - NO secret logging: nothing is ever `console.log`'d; the only thing emitted to the pluggable\n    10\t//     sink on a handler throw is the hook name + the error's TYPE name — never its message or stack,\n    11\t//     which may carry a secret. The emitted payload is secret-free by construction.\n    12\t//   - PLUGGABLE sink: an optional `@caisson/kernel` `EventSink` port (no tg-bridge / postgres\n    13\t//     coupling). The sink applies its own redaction; the dispatcher hands it nothing sensitive.\n    14\t//   - SHELL SAFETY: TS handlers are first-class. A shell-command hook is admitted ONLY through\n    15\t//     `commandHandler`, which spawns via `execFile` with an argv ARRAY — no shell, no interpolation,\n    16\t//     no `HookContext` value can reach argv (interpolation is structurally impossible).\n    17\t//   - ENV DEFAULT: a `CommandHookSpec` inherits the parent's full environment by default (Node's\n    18\t//     `execFile` default) — pass the optional `env` field to narrow the child to exactly the vars\n    19\t//     it needs (used verbatim, never merged with `process.env`). Flipping the default to\n    20\t//     always-narrow is a separate major-version change, not made here.\n    21\timport type { EventSink, OpsEvent } from \"@caisson/kernel\";\n    22\timport type { Act } from \"./lifecycle.ts\";\n    23\timport { allow, mutate } from \"./governance.ts\";\n    24\timport type { HookResult } from \"./governance.ts\";\n    25\timport { execFile } from \"node:child_process\";\n    26\t\n    27\texport type HookPhase = \"before\" | \"after\";\n    28\t/** A hook point — fired before/after an act, e.g. `before:execute`, `after:verify`. */\n    29\texport type HookName = `${HookPhase}:${Act}`;\n    30\t\n    31\t/** What a handler sees: the act being entered/left, the phase, and the governance context `C`. */\n    32\texport interface HookContext<C = unknown> {\n    33\t  readonly act: Act;\n    34\t  readonly phase: HookPhase;\n    35\t  /** The governance context a `mutate(ctx)` handler may replace for every downstream handler. */\n    36\t  readonly context: C;\n    37\t}\n    38\t\n    39\t/**\n    40\t * A hook handler. Returning `undefined` (an observe-only handler) is treated as `allow`; returning a\n    41\t * `HookResult<C>` participates in governance: `deny` vetoes (short-circuit), `mutate` threads context.\n    42\t */\n    43\texport type HookHandler<C = unknown> = (\n    44\t  ctx: HookContext<C>,\n    45\t) => void | HookResult<C> | Promise<void | HookResult<C>>;\n    46\t\n    47\t/** The outcome of a dispatch: how many handlers ran, how many threw (isolated), and the folded decision. */\n    48\texport interface HookDispatchResult<C> {\n    49\t  /** Handlers actually invoked (stops early on an explicit `deny`). */\n    50\t  readonly invoked: number;\n    51\t  /** Handlers that threw — isolated and fail-open (they did NOT veto the loop). */\n    52\t  readonly errors: number;\n    53\t  /** The folded governance decision: `allow`, the first `deny`, or `mutate(finalContext)`. */\n    54\t  readonly result: HookResult<C>;\n    55\t}\n    56\t\n    57\t/** Construction options. The sink is optional — with none, handler errors are silently isolated. */\n    58\texport interface HookDispatcherOptions {\n    59\t  /** Pluggable diagnostics sink (kernel `EventSink` port). Receives only secret-free error markers. */\n    60\t  readonly sink?: EventSink;\n    61\t}\n    62\t\n    63\texport class HookDispatcher<C = unknown> {\n    64\t  readonly #handlers = new Map<HookName, HookHandler<C>[]>();\n    65\t  readonly #sink: EventSink | undefined;\n    66\t\n    67\t  constructor(options?: HookDispatcherOptions) {\n    68\t    this.#sink = options?.sink;\n    69\t  }\n    70\t\n    71\t  /** Register `handler` at `name`. Returns `this` for chaining; registration order is preserved. */\n    72\t  on(name: HookName, handler: HookHandler<C>): this {\n    73\t    const list = this.#handlers.get(name);\n    74\t    if (list === undefined) this.#handlers.set(name, [handler]);\n    75\t    else list.push(handler);\n    76\t    return this;\n    77\t  }\n    78\t\n    79\t  /** How many handlers are registered at `name`. */\n    80\t  count(name: HookName): number {\n    81\t    return this.#handlers.get(name)?.length ?? 0;\n    82\t  }\n    83\t\n    84\t  /**\n    85\t   * Run every handler at `name` in registration order, awaiting each, folding the unified\n    86\t   * `HookResult`:\n    87\t   *   - a handler that THROWS is isolated (reported to the sink, secret-free) and treated as\n    88\t   *     fail-open `allow` — the loop continues, the throw never vetoes;\n    89\t   *   - a handler returning `deny(reason)` SHORT-CIRCUITS (the first veto wins, fail-closed);\n    90\t   *   - a handler returning `mutate(ctx)` threads `ctx` into every downstream handler's context;\n    91\t   *   - `undefined` / `allow` proceed. All-allow (or no handlers) → `allow`; any mutate, no\n    92\t   *     deny → `mutate(finalContext)`.\n    93\t   * An unregistered point is a no-op (`invoked: 0`, `allow`), never a throw.\n    94\t   */\n    95\t  async dispatch(\n    96\t    name: HookName,\n    97\t    ctx: HookContext<C>,\n    98\t  ): Promise<HookDispatchResult<C>> {\n    99\t    const list = this.#handlers.get(name);\n   100\t    if (list === undefined || list.length === 0) {\n   101\t      return { invoked: 0, errors: 0, result: allow<C>() };\n   102\t    }\n   103\t\n   104\t    let context = ctx.context;\n   105\t    let mutated = false;\n   106\t    let invoked = 0;\n   107\t    let errors = 0;\n   108\t\n   109\t    for (let i = 0; i < list.length; i++) {\n   110\t      const handler = list[i]!;\n   111\t      invoked++;\n   112\t      let outcome: void | HookResult<C>;\n   113\t      try {\n   114\t        outcome = await handler({ act: ctx.act, phase: ctx.phase, context });\n   115\t      } catch (err) {\n   116\t        // Per-handler isolation: a thrown observer never bleeds into the loop and never vetoes.\n   117\t        errors++;\n   118\t        this.#report(name, i, err);\n   119\t        continue; // fail-open\n   120\t      }\n   121\t      if (outcome === undefined) continue; // observe-only handler = allow\n   122\t      if (outcome.decision === \"deny\") {\n   123\t        return { invoked, errors, result: outcome }; // explicit veto wins (fail-closed)\n   124\t      }\n   125\t      if (outcome.decision === \"mutate\") {\n   126\t        context = outcome.context;\n   127\t        mutated = true;\n   128\t      }\n   129\t      // \"allow\" → proceed\n   130\t    }\n   131\t\n   132\t    return {\n   133\t      invoked,\n   134\t      errors,\n   135\t      result: mutated ? mutate(context) : allow<C>(),\n   136\t    };\n   137\t  }\n   138\t\n   139\t  /**\n   140\t   * Report a handler throw to the pluggable sink — secret-free by construction (hook name, handler\n   141\t   * index, and the error TYPE name only; never the message or stack). A down/slow sink must never\n   142\t   * block the loop nor surface an unhandled rejection, so a sync throw is swallowed and an async\n   143\t   * rejection is caught.\n   144\t   */\n   145\t  #report(hook: HookName, index: number, err: unknown): void {\n   146\t    const sink = this.#sink;\n   147\t    if (sink === undefined) return;\n   148\t    const event: OpsEvent = {\n   149\t      name: \"hook.handler.error\",\n   150\t      timestamp: new Date().toISOString(),\n   151\t      attributes: {\n   152\t        hook,\n   153\t        index,\n   154\t        error: err instanceof Error ? err.name : \"unknown\",\n   155\t      },\n   156\t    };\n   157\t    try {\n   158\t      const maybe = sink.emit(event);\n   159\t      if (maybe instanceof Promise) maybe.catch(() => undefined);\n   160\t    } catch {\n   161\t      // A down sink never blocks the loop (fail-open) — swallowed, never logged.\n   162\t    }\n   163\t  }\n   164\t}\n   165\t\n   166\t// --- Safe shell-command hooks -----------------------------------------------------------------\n   167\t\n   168\t/**\n   169\t * A shell-command hook spec. `args` is a FIXED argv array — never derived from a `HookContext`.\n   170\t *\n   171\t * `env` is OPTIONAL and additive: when absent, the spawned process inherits the parent's full\n   172\t * environment (Node's `execFile` default) — today's behavior, unchanged. Pass `env` to narrow the\n   173\t * child to exactly the vars it needs; the object is used VERBATIM (never merged with\n   174\t * `process.env`), so a caller that wants `PATH` must include it explicitly. Flipping the default\n   175\t * to always-narrow is a separate, deliberate major-version change — not made here.\n   176\t */\n   177\texport interface CommandHookSpec {\n   178\t  /** The executable to run — a program path/name, NEVER a shell string. */\n   179\t  readonly command: string;\n   180\t  /** Fixed argv. No interpolation: nothing from the hook context ever reaches here. */\n   181\t  readonly args?: readonly string[];\n   182\t  /** Per-invocation timeout (default 30s). */\n   183\t  readonly timeoutMs?: number;\n   184\t  /** Optional child environment. Absent → inherits the parent's full env (the default). */\n   185\t  readonly env?: Readonly<Record<string, string>>;\n   186\t}\n   187\t\n   188\t/**\n   189\t * The spawn seam: `(command, args, timeoutMs, env?) => exitCode`. Defaults to `execFile` with an\n   190\t * argv array; tests inject a double so CI never spawns a real process (the transport stays a\n   191\t * port). `env` is an OPTIONAL 4th parameter so every existing custom runner keeps compiling.\n   192\t */\n   193\texport type CommandRunner = (\n   194\t  command: string,\n   195\t  args: readonly string[],\n   196\t  timeoutMs: number,\n   197\t  env?: Readonly<Record<string, string>>,\n   198\t) => Promise<number>;\n   199\t\n   200\tconst defaultRunner: CommandRunner = (command, args, timeoutMs, env) =>\n   201\t  new Promise<number>((resolve, reject) => {\n   202\t    // `execFile` with an argv ARRAY — no shell is spawned, so there is no injection surface; the\n   203\t    // command and args are passed verbatim. Process output is intentionally NOT captured (it could\n   204\t    // carry a secret), so only the exit status is observed. `env`, when supplied, is passed exactly\n   205\t    // as given (never merged with `process.env`); absent, `execFile` inherits the parent env.\n   206\t    execFile(\n   207\t      command,\n   208\t      [...args],\n   209\t      env === undefined ? { timeout: timeoutMs } : { timeout: timeoutMs, env },\n   210\t      (error) => {\n   211\t        if (error === null) {\n   212\t          resolve(0);\n   213\t          return;\n   214\t        }\n   215\t        const code = (error as { code?: unknown }).code;\n   216\t        if (typeof code === \"number\") {\n   217\t          resolve(code); // a non-zero process exit\n   218\t          return;\n   219\t        }\n   220\t        // Spawn failure / timeout: reject with a marker carrying NO command output.\n   221\t        reject(new Error(\"command hook spawn failed\"));\n   222\t      },\n   223\t    );\n   224\t  });\n   225\t\n   226\t/**\n   227\t * Build a hook that runs a shell command SAFELY: via `execFile` with a fixed argv array (no shell,\n   228\t * no interpolation, no secret reachable in argv). The handler ignores the `HookContext` entirely —\n   229\t * by construction no context value can flow into the command — so it OBSERVES: exit 0 → `allow`\n   230\t * (returns nothing), a non-zero exit or spawn failure throws, which the dispatcher isolates\n   231\t * (fail-open) — a failing external command never vetoes the buyer's loop.\n   232\t */\n   233\texport function commandHandler<C = unknown>(\n   234\t  spec: CommandHookSpec,\n   235\t  runner: CommandRunner = defaultRunner,\n   236\t): HookHandler<C> {\n   237\t  const command = spec.command;\n   238\t  const args: readonly string[] = spec.args ?? [];\n   239\t  const timeoutMs = spec.timeoutMs ?? 30_000;\n   240\t  const env = spec.env;\n   241\t  return async () => {\n   242\t    const code = await runner(command, args, timeoutMs, env);\n   243\t    if (code !== 0) throw new Error(`command hook exited ${code}`);\n   244\t  };\n   245\t}\n","exit_code":0,"status":"completed"}}
