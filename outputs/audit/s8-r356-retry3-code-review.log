{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba scripts/release-readiness.ts'","aggregated_output":"     1\t#!/usr/bin/env bun\n     2\t/**\n     3\t * release-readiness.ts — the ADR-0318 R3 gate. Every check must be GREEN before the release\n     4\t * train's propagation legs run; any red exits nonzero and the train stops before touching an\n     5\t * external surface. Run by .github/workflows/release-train.yml on the release SHA, and locally:\n     6\t *\n     7\t *   bun scripts/release-readiness.ts --tag v2026.07.30 [--sha <sha>] [--local]\n     8\t *\n     9\t * Checks (R3, locked; #0 added by ADR-0325):\n    10\t *   0. Release SHA on main — the tag targets a commit that is an ancestor of origin/main (the\n    11\t *      merged version-PR commit; a tag cut on a stray branch must never train).\n    12\t *   0b. Release tag signed (ADR-0382) — `git tag -v` verifies the tag against the allowed-signers\n    13\t *      file. ADVISORY for now: tags cut before the lock are unsigned and cannot become signed.\n    14\t *   1. CI green on the release SHA — the five required checks (check, standards-gate,\n    15\t *      registry-index, oscal-conformance, deterministic — the last per the ADR-0327 scan-gate\n    16\t *      flip) completed successfully.\n    17\t *   2. Changesets drained — no pending .changeset/*.md (the version PR consumed them —\n    18\t *      version-pr.yml, ADR-0325; never a feature-branch or tag-path act).\n    19\t *   3. CHANGELOGs written — every non-private workspace package's CHANGELOG.md leads with its\n    20\t *      package.json version.\n    21\t *   4. `bun run sot` green — the SoT drift tool (ADR-ceiling parity, frontmatter/docs freshness,\n    22\t *      archive integrity, tracker-vs-PR reality, changeset preflight). Doubles as the R3\n    23\t *      docs-freshness check.\n    24\t *   4b. Registry coverage invariants (CAISSON-85/86) — every module's `latest` has a tarball row\n    25\t *      (hard), no advertised version outside the frozen pre-sidecar backlog is rowless, and every\n    26\t *      served member pin resolves served+tarball-backed (advertise-follows-upload, static half).\n    27\t *   5. R4 audit artifact on file — outputs/audit/release-audit-<tag>.md (the fresh full\n    28\t *      SHIP-audit-lane review of the cumulative diff since the last release tag).\n    29\t *   6. Per-release checklist complete — docs/releases/<tag>-checklist.md exists with ZERO\n    30\t *      unchecked boxes (the human items: marketing surfaces, announcement, live-leg attestations).\n    31\t *   7. (--local only) the live-hybrid retrieval golden leg — services/docs `bun run test:live`\n    32\t *      with real keys (Kickoff-M picker 2026-07-10: this leg gates at release readiness, not PR\n    33\t *      CI). In the train (no keys) the checklist attestation (#6) carries it instead.\n    34\t */\n    35\timport { execFileSync } from \"node:child_process\";\n    36\timport { existsSync, readdirSync, readFileSync } from \"node:fs\";\n    37\timport { join, resolve } from \"node:path\";\n    38\timport { checkRegistryCoverage } from \"../registry/scripts/coverage-invariants\";\n    39\t\n    40\tconst REPO = resolve(import.meta.dir, \"..\");\n    41\texport const REQUIRED_CHECKS = [\n    42\t  \"check\",\n    43\t  \"standards-gate\",\n    44\t  \"registry-index\",\n    45\t  \"oscal-conformance\",\n    46\t  // ADR-0327 scan-gate flip (CAISSON-95): the deterministic security layer joins the required\n    47\t  // set once its installers are pinned — which landed in the same change as this line.\n    48\t  \"deterministic\",\n    49\t  // ADR-0414: the Python gate for services/support-bot, promoted out of advisory in the same\n    50\t  // change that gave that service an automated Railway deploy. Its paths filter was removed in\n    51\t  // the same commit — this list treats a check that never reported as `missing`, so a\n    52\t  // path-scoped required check would red readiness on every release that did not touch the bot.\n    53\t  \"support-bot\",\n    54\t] as const;\n    55\t\n    56\tinterface Args {\n    57\t  tag: string;\n    58\t  sha: string;\n    59\t  local: boolean;\n    60\t}\n    61\t\n    62\tfunction parseArgs(argv: readonly string[]): Args {\n    63\t  let tag = \"\";\n    64\t  let sha = \"\";\n    65\t  let local = false;\n    66\t  for (let i = 0; i < argv.length; i++) {\n    67\t    const a = argv[i];\n    68\t    if (a === \"--tag\") tag = argv[++i] ?? \"\";\n    69\t    else if (a === \"--sha\") sha = argv[++i] ?? \"\";\n    70\t    else if (a === \"--local\") local = true;\n    71\t  }\n    72\t  if (!tag) {\n    73\t    console.error(\"FATAL: --tag <release-tag> is required\");\n    74\t    process.exit(1);\n    75\t  }\n    76\t  if (!sha) {\n    77\t    sha = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: REPO })\n    78\t      .toString()\n    79\t      .trim();\n    80\t  }\n    81\t  return { tag, sha, local };\n    82\t}\n    83\t\n    84\ttype CheckResult = { name: string; ok: boolean; detail: string };\n    85\tconst results: CheckResult[] = [];\n    86\tfunction record(name: string, ok: boolean, detail: string): void {\n    87\t  results.push({ name, ok, detail });\n    88\t  console.log(`${ok ? \"  ✓\" : \"  ✗\"} ${name} — ${detail}`);\n    89\t}\n    90\t\n    91\tfunction run(cmd: string, args: readonly string[], cwd = REPO): string {\n    92\t  return execFileSync(cmd, [...args], {\n    93\t    cwd,\n    94\t    stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    95\t  })\n    96\t    .toString()\n    97\t    .trim();\n    98\t}\n    99\t\n   100\t// --- 0. release SHA on main (ADR-0325) -----------------------------------------------------------\n   101\tfunction checkTagOnMain(sha: string): void {\n   102\t  try {\n   103\t    // In CI the checkout is at the tag with full history; locally origin/main may be stale —\n   104\t    // refresh it quietly, tolerating offline runs (merge-base still answers from local refs).\n   105\t    try {\n   106\t      run(\"git\", [\"fetch\", \"origin\", \"main\", \"--quiet\"]);\n   107\t    } catch {\n   108\t      /* offline — check against the local origin/main ref */\n   109\t    }\n   110\t    run(\"git\", [\"merge-base\", \"--is-ancestor\", sha, \"origin/main\"]);\n   111\t    record(\n   112\t      \"release SHA on main\",\n   113\t      true,\n   114\t      `${sha.slice(0, 8)} is an ancestor of origin/main`,\n   115\t    );\n   116\t  } catch {\n   117\t    record(\n   118\t      \"release SHA on main\",\n   119\t      false,\n   120\t      `${sha.slice(0, 8)} is NOT on origin/main — the tag must target the merged version-PR commit`,\n   121\t    );\n   122\t  }\n   123\t}\n   124\t\n   125\t// --- 0b. release tag is signed (ADR-0382) -------------------------------------------------------\n   126\t// An annotated tag says WHO claims a release; a signed one proves it. Without a signature anyone\n   127\t// with push access can move or forge a tag onto a different commit and every downstream leg — the\n   128\t// registry publish, the mirror sync, the fleet redeploy — trusts it, because each of them resolves\n   129\t// the tag rather than a SHA. `git tag -v` verifies against the allowed-signers file; it fails on an\n   130\t// unsigned tag, an unknown signer, and a signature that does not match the tag's bytes.\n   131\t//\n   132\t// Tags cut before the signing lock are unsigned and cannot retroactively become signed, so this is\n   133\t// a WARNING here rather than a hard gate: it reports honestly on every release without failing the\n   134\t// train on history it cannot change. Promote it to a blocking check once the first signed tag has\n   135\t// trained end to end (that flip is a one-word change: `record(..., ok, ...)`).\n   136\tfunction checkTagSigned(tag: string): void {\n   137\t  try {\n   138\t    run(\"git\", [\"tag\", \"-v\", tag]);\n   139\t    record(\"release tag signed\", true, `${tag} carries a valid signature`);\n   140\t  } catch {\n   141\t    // Not fatal — see above. Surfaced so an unsigned tag is a visible choice, never an oversight.\n   142\t    console.log(\n   143\t      `  ! release tag signed — ${tag} is UNSIGNED or its signer is not in the allowed-signers file (advisory; see docs/ops/release-tag-signing.md)`,\n   144\t    );\n   145\t  }\n   146\t}\n   147\t\n   148\t// --- 1. CI green on the release SHA -------------------------------------------------------------\n   149\tfunction checkCi(sha: string): void {\n   150\t  try {\n   151\t    const raw = run(\"gh\", [\n   152\t      \"api\",\n   153\t      `repos/{owner}/{repo}/commits/${sha}/check-runs`,\n   154\t      \"--paginate\",\n   155\t      \"-q\",\n   156\t      \"[.check_runs[] | {name, status, conclusion}]\",\n   157\t    ]);\n   158\t    // --paginate emits one JSON array per page; normalize to a single list.\n   159\t    const runs = raw\n   160\t      .split(\"\\n\")\n   161\t      .filter(Boolean)\n   162\t      .flatMap(\n   163\t        (line) =>\n   164\t          JSON.parse(line) as {\n   165\t            name: string;\n   166\t            status: string;\n   167\t            conclusion: string | null;\n   168\t          }[],\n   169\t      );\n   170\t    const missing: string[] = [];\n   171\t    const red: string[] = [];\n   172\t    for (const required of REQUIRED_CHECKS) {\n   173\t      const match = runs.filter((r) => r.name === required);\n   174\t      if (match.length === 0) {\n   175\t        missing.push(required);\n   176\t        continue;\n   177\t      }\n   178\t      // A check re-run replaces its predecessor in the API answer set; any green instance passes.\n   179\t      if (\n   180\t        !match.some(\n   181\t          (r) => r.status === \"completed\" && r.conclusion === \"success\",\n   182\t        )\n   183\t      )\n   184\t        red.push(required);\n   185\t    }\n   186\t    const ok = missing.length === 0 && red.length === 0;\n   187\t    record(\n   188\t      \"CI green on release SHA\",\n   189\t      ok,\n   190\t      ok\n   191\t        ? `all ${String(REQUIRED_CHECKS.length)} required checks green at ${sha.slice(0, 8)}`\n   192\t        : `missing: [${missing.join(\", \")}] red: [${red.join(\", \")}]`,\n   193\t    );\n   194\t  } catch (err) {\n   195\t    record(\"CI green on release SHA\", false, `gh api failed: ${String(err)}`);\n   196\t  }\n   197\t}\n   198\t\n   199\t// --- 2. changesets drained -----------------------------------------------------------------------\n   200\tfunction checkChangesetsDrained(): void {\n   201\t  const pending = readdirSync(join(REPO, \".changeset\")).filter(\n   202\t    (f) => f.endsWith(\".md\") && f !== \"README.md\",\n   203\t  );\n   204\t  record(\n   205\t    \"changesets drained\",\n   206\t    pending.length === 0,\n   207\t    pending.length === 0\n   208\t      ? \"no pending changesets\"\n   209\t      : `${String(pending.length)} pending (version cut not consumed): ${pending.slice(0, 5).join(\", \")}${pending.length > 5 ? \", …\" : \"\"}`,\n   210\t  );\n   211\t}\n   212\t\n   213\t// --- 3. CHANGELOGs written -----------------------------------------------------------------------\n   214\tfunction checkChangelogs(): void {\n   215\t  const bad: string[] = [];\n   216\t  for (const group of [\"packages\", \"tooling\"]) {\n   217\t    const base = join(REPO, group);\n   218\t    if (!existsSync(base)) continue;\n   219\t    for (const slug of readdirSync(base)) {\n   220\t      const pj = join(base, slug, \"package.json\");\n   221\t      if (!existsSync(pj)) continue;\n   222\t      const pkg = JSON.parse(readFileSync(pj, \"utf8\")) as {\n   223\t        name: string;\n   224\t        version?: string;\n   225\t        private?: boolean;\n   226\t      };\n   227\t      if (pkg.private || !pkg.version) continue;\n   228\t      const changelog = join(base, slug, \"CHANGELOG.md\");\n   229\t      if (!existsSync(changelog)) {\n   230\t        bad.push(`${pkg.name} (no CHANGELOG.md)`);\n   231\t        continue;\n   232\t      }\n   233\t      if (!readFileSync(changelog, \"utf8\").includes(`## ${pkg.version}`))\n   234\t        bad.push(`${pkg.name} (no ## ${pkg.version} entry)`);\n   235\t    }\n   236\t  }\n   237\t  record(\n   238\t    \"CHANGELOGs written\",\n   239\t    bad.length === 0,\n   240\t    bad.length === 0\n   241\t      ? \"every versioned package's CHANGELOG leads with its current version\"\n   242\t      : bad.slice(0, 5).join(\"; \") + (bad.length > 5 ? \"; …\" : \"\"),\n   243\t  );\n   244\t}\n   245\t\n   246\t// --- 4. sot green (doubles as docs freshness) ----------------------------------------------------\n   247\tfunction checkSot(): void {\n   248\t  try {\n   249\t    run(\"bun\", [\"run\", \"sot\"]);\n   250\t    record(\"bun run sot\", true, \"SoT drift tool green (incl. docs freshness)\");\n   251\t  } catch (err) {\n   252\t    // Surface the captured drift report — a CI readiness red must not be blind (first ride:\n   253\t    // the only failure signal was this one-liner while sot's own output was swallowed).\n   254\t    const e = err as { stdout?: Buffer | string; stderr?: Buffer | string };\n   255\t    for (const chunk of [e.stdout, e.stderr]) {\n   256\t      const text = chunk?.toString().trim();\n   257\t      if (text) console.error(text);\n   258\t    }\n   259\t    record(\"bun run sot\", false, \"sot check failed — drift report above\");\n   260\t  }\n   261\t}\n   262\t\n   263\t// --- 4b. registry coverage invariants (CAISSON-85/86) --------------------------------------------\n   264\tfunction checkRegistryCoverageGate(): void {\n   265\t  // Static advertise-follows-upload proof: every module's latest has a tarball row (hard), no\n   266\t  // advertised version outside the frozen pre-sidecar backlog is rowless, and every served member\n   267\t  // pin resolves served+tarball-backed. Same invariants the registry-index CI job enforces via\n   268\t  // coverage-invariants.test.ts — re-run here so the train's readiness verdict is self-contained.\n   269\t  try {\n   270\t    const report = checkRegistryCoverage({\n   271\t      indexPath: join(REPO, \"registry/index.json\"),\n   272\t      sidecarPath: join(REPO, \"registry/tarballs.json\"),\n   273\t    });\n   274\t    const detail = report.ok\n   275\t      ? \"latest/version/pin coverage all green (advertise-follows-upload)\"\n   276\t      : `latest: [${report.latest.join(\", \")}] versions: [${report.versions\n   277\t          .slice(0, 3)\n   278\t          .join(\n   279\t            \", \",\n   280\t          )}${report.versions.length > 3 ? \", …\" : \"\"}] pins: [${report.pins\n   281\t          .slice(0, 3)\n   282\t          .join(\", \")}${report.pins.length > 3 ? \", …\" : \"\"}]`;\n   283\t    record(\"registry coverage (85/86)\", report.ok, detail);\n   284\t  } catch (err) {\n   285\t    record(\n   286\t      \"registry coverage (85/86)\",\n   287\t      false,\n   288\t      `coverage check failed to run: ${String(err)}`,\n   289\t    );\n   290\t  }\n   291\t}\n   292\t\n   293\t// --- 5. R4 audit artifact ------------------------------------------------------------------------\n   294\tfunction checkAuditArtifact(tag: string): void {\n   295\t  const path = join(REPO, \"outputs/audit\", `release-audit-${tag}.md`);\n   296\t  record(\n   297\t    \"R4 release audit on file\",\n   298\t    existsSync(path),\n   299\t    existsSync(path)\n   300\t      ? `outputs/audit/release-audit-${tag}.md`\n   301\t      : `MISSING outputs/audit/release-audit-${tag}.md — run the full SHIP-audit-lane review of the diff since the last release tag`,\n   302\t  );\n   303\t}\n   304\t\n   305\t// --- 6. per-release checklist --------------------------------------------------------------------\n   306\tfunction checkChecklist(tag: string): void {\n   307\t  const path = join(REPO, \"docs/releases\", `${tag}-checklist.md`);\n   308\t  if (!existsSync(path)) {\n   309\t    record(\n   310\t      \"per-release checklist\",\n   311\t      false,\n   312\t      `MISSING docs/releases/${tag}-checklist.md — copy docs/releases/TEMPLATE-checklist.md`,\n   313\t    );\n   314\t    return;\n   315\t  }\n   316\t  const unchecked = (readFileSync(path, \"utf8\").match(/^\\s*-\\s\\[\\s\\]/gm) ?? [])\n   317\t    .length;\n   318\t  record(\n   319\t    \"per-release checklist\",\n   320\t    unchecked === 0,\n   321\t    unchecked === 0\n   322\t      ? \"all boxes checked\"\n   323\t      : `${String(unchecked)} unchecked box(es)`,\n   324\t  );\n   325\t}\n   326\t\n   327\t// --- 7. live-hybrid golden leg (--local) ---------------------------------------------------------\n   328\tfunction checkLiveHybrid(): void {\n   329\t  const key =\n   330\t    process.env.CAISSON_DOCS__OPENROUTER_API_KEY ??\n   331\t    process.env.OPENROUTER_API_KEY ??\n   332\t    \"\";\n   333\t  if (key.length === 0) {\n   334\t    record(\n   335\t      \"live-hybrid golden leg\",\n   336\t      false,\n   337\t      \"no OpenRouter key in env — source the env and re-run, or drop --local and attest via the checklist\",\n   338\t    );\n   339\t    return;\n   340\t  }\n   341\t  try {\n   342\t    execFileSync(\"bun\", [\"run\", \"test:live\"], {\n   343\t      cwd: join(REPO, \"services/docs\"),\n   344\t      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n   345\t      env: { ...process.env, OPENROUTER_API_KEY: key },\n   346\t      timeout: 15 * 60_000,\n   347\t    });\n   348\t    record(\n   349\t      \"live-hybrid golden leg\",\n   350\t      true,\n   351\t      \"services/docs test:live green (real fusion path)\",\n   352\t    );\n   353\t  } catch {\n   354\t    record(\"live-hybrid golden leg\", false, \"services/docs test:live FAILED\");\n   355\t  }\n   356\t}\n   357\t\n   358\t// Entry point guard (ADR-0414). Everything above is importable; only a direct\n   359\t// `bun scripts/release-readiness.ts` runs the gate. Without this, importing the module to test\n   360\t// REQUIRED_CHECKS parses argv, prints \"FATAL: --tag is required\", and exits the test process.\n   361\t// release-train.yml's R3 job invokes this file directly, so `import.meta.main` is true there.\n   362\tif (import.meta.main) {\n   363\t  const { tag, sha, local } = parseArgs(Bun.argv.slice(2));\n   364\t  console.log(\n   365\t    `release-readiness — tag ${tag}, sha ${sha.slice(0, 12)}${local ? \", local\" : \"\"}\\n`,\n   366\t  );\n   367\t  checkTagOnMain(sha);\n   368\t  checkTagSigned(tag);\n   369\t  checkCi(sha);\n   370\t  checkChangesetsDrained();\n   371\t  checkChangelogs();\n   372\t  checkSot();\n   373\t  checkRegistryCoverageGate();\n   374\t  checkAuditArtifact(tag);\n   375\t  checkChecklist(tag);\n   376\t  if (local) checkLiveHybrid();\n   377\t\n   378\t  const failed = results.filter((r) => !r.ok);\n   379\t  console.log(\n   380\t    `\\n${failed.length === 0 ? \"READY\" : \"NOT READY\"} — ${String(results.length - failed.length)}/${String(results.length)} checks green`,\n   381\t  );\n   382\t  process.exit(failed.length === 0 ? 0 : 1);\n   383\t}\n","exit_code":0,"status":"completed"}}
