{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/admin/src/lib/cloudflare-access.ts'","aggregated_output":"     1\timport { z } from \"zod\";\n     2\timport { ConfigError } from \"@caisson/kernel\";\n     3\timport { fetchWithTimeout } from \"@caisson/kernel/fetch\";\n     4\timport {\n     5\t  createRemoteJWKSet,\n     6\t  customFetch,\n     7\t  jwtVerify,\n     8\t  type JWTVerifyGetKey,\n     9\t} from \"jose\";\n    10\t\n    11\tconst teamDomainSchema = z\n    12\t  .string()\n    13\t  .trim()\n    14\t  .toLowerCase()\n    15\t  .max(253)\n    16\t  .regex(/^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+cloudflareaccess\\.com$/);\n    17\t\n    18\tconst accessEnvSchema = z\n    19\t  .object({\n    20\t    runtime: z.string().optional(),\n    21\t    mode: z.string().optional(),\n    22\t    teamDomain: teamDomainSchema.optional(),\n    23\t    audience: z\n    24\t      .string()\n    25\t      .regex(/^[a-f0-9]{64}$/)\n    26\t      .optional(),\n    27\t  })\n    28\t  .strict();\n    29\t\n    30\tconst identityClaimsSchema = z\n    31\t  .object({\n    32\t    type: z.literal(\"app\"),\n    33\t    email: z.string().trim().email().max(320),\n    34\t    subject: z.string().trim().min(1).max(256),\n    35\t    identityNonce: z.string().trim().min(1).max(256),\n    36\t    issuedAt: z.number().int().nonnegative(),\n    37\t    notBefore: z.number().int().nonnegative(),\n    38\t    expiresAt: z.number().int().positive(),\n    39\t  })\n    40\t  .strict();\n    41\t\n    42\tconst serviceTokenClaimsSchema = z\n    43\t  .object({\n    44\t    type: z.literal(\"app\"),\n    45\t    commonName: z\n    46\t      .string()\n    47\t      .trim()\n    48\t      .min(8)\n    49\t      .max(256)\n    50\t      .regex(/^[A-Za-z0-9_-]+\\.access$/),\n    51\t    subject: z.literal(\"\"),\n    52\t    issuedAt: z.number().int().nonnegative(),\n    53\t    expiresAt: z.number().int().positive(),\n    54\t  })\n    55\t  .strict();\n    56\t\n    57\texport interface CloudflareAccessEnv {\n    58\t  readonly [key: string]: string | undefined;\n    59\t  NODE_ENV?: string;\n    60\t  CF_ACCESS_MODE?: string;\n    61\t  CF_ACCESS_TEAM_DOMAIN?: string;\n    62\t  CF_ACCESS_AUD?: string;\n    63\t}\n    64\t\n    65\texport type CloudflareAccessConfig =\n    66\t  | { required: false }\n    67\t  | {\n    68\t      required: true;\n    69\t      issuer: string;\n    70\t      audience: string;\n    71\t      jwks: JWTVerifyGetKey;\n    72\t    };\n    73\t\n    74\tfunction remoteJwks(issuer: string): JWTVerifyGetKey {\n    75\t  const certsUrl = new URL(\"/cdn-cgi/access/certs\", issuer);\n    76\t  return createRemoteJWKSet(certsUrl, {\n    77\t    timeoutDuration: 6_000,\n    78\t    [customFetch]: (url, { headers, method, redirect }) =>\n    79\t      fetchWithTimeout(\n    80\t        url,\n    81\t        { headers, method, redirect },\n    82\t        { timeoutMs: 5_000 },\n    83\t      ),\n    84\t  });\n    85\t}\n    86\t\n    87\texport function loadCloudflareAccessConfig(\n    88\t  env: CloudflareAccessEnv,\n    89\t): CloudflareAccessConfig {\n    90\t  const parsed = accessEnvSchema.safeParse({\n    91\t    runtime: env.NODE_ENV,\n    92\t    mode: env.CF_ACCESS_MODE,\n    93\t    teamDomain: env.CF_ACCESS_TEAM_DOMAIN,\n    94\t    audience: env.CF_ACCESS_AUD,\n    95\t  });\n    96\t  if (!parsed.success) {\n    97\t    throw new ConfigError(\"Invalid Cloudflare Access configuration\");\n    98\t  }\n    99\t  // Mirror the origin gate's fail-closed arming semantics. An absent mode stays armed, and no\n   100\t  // production value can disable Access. Only an exact local/test opt-out bypasses it.\n   101\t  if (\n   102\t    parsed.data.mode === \"disabled\" &&\n   103\t    (parsed.data.runtime === \"development\" || parsed.data.runtime === \"test\")\n   104\t  ) {\n   105\t    return { required: false };\n   106\t  }\n   107\t\n   108\t  if (\n   109\t    parsed.data.teamDomain === undefined ||\n   110\t    parsed.data.audience === undefined\n   111\t  ) {\n   112\t    throw new ConfigError(\n   113\t      \"Cloudflare Access requires a team domain and application audience\",\n   114\t    );\n   115\t  }\n   116\t\n   117\t  const issuer = new URL(`https://${parsed.data.teamDomain}`).origin;\n   118\t  return {\n   119\t    required: true,\n   120\t    issuer,\n   121\t    audience: parsed.data.audience,\n   122\t    jwks: remoteJwks(issuer),\n   123\t  };\n   124\t}\n   125\t\n   126\texport async function verifyCloudflareAccessRequest(\n   127\t  request: Request,\n   128\t  config: CloudflareAccessConfig,\n   129\t): Promise<boolean> {\n   130\t  if (!config.required) return true;\n   131\t\n   132\t  const token = request.headers.get(\"cf-access-jwt-assertion\");\n   133\t  if (token === null || token.length === 0) return false;\n   134\t\n   135\t  try {\n   136\t    const { payload } = await jwtVerify(token, config.jwks, {\n   137\t      algorithms: [\"RS256\"],\n   138\t      issuer: config.issuer,\n   139\t      audience: config.audience,\n   140\t    });\n   141\t    const identityClaimsValid = identityClaimsSchema.safeParse({\n   142\t      type: payload.type,\n   143\t      email: payload.email,\n   144\t      subject: payload.sub,\n   145\t      identityNonce: payload.identity_nonce,\n   146\t      issuedAt: payload.iat,\n   147\t      notBefore: payload.nbf,\n   148\t      expiresAt: payload.exp,\n   149\t    }).success;\n   150\t    const serviceTokenClaimsValid = serviceTokenClaimsSchema.safeParse({\n   151\t      type: payload.type,\n   152\t      commonName: payload.common_name,\n   153\t      subject: payload.sub,\n   154\t      issuedAt: payload.iat,\n   155\t      expiresAt: payload.exp,\n   156\t    }).success;\n   157\t    return identityClaimsValid || serviceTokenClaimsValid;\n   158\t  } catch {\n   159\t    return false;\n   160\t  }\n   161\t}\n","exit_code":0,"status":"completed"}}
