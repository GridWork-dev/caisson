DK set proven by PR 483. This job needs its own cleanup\n255-          # before that sibling PR merges; neither PR may merge independently (R336).\n--\n284-        env:\n285-          DOCKERFILE: ${{ matrix.dockerfile }}\n286-          TARGET: ${{ matrix.target }}\n287-        run: |\n288-          mkdir -p \"$RUNNER_TEMP/runtime-scan\"\n289-          git rev-parse HEAD > \"$RUNNER_TEMP/runtime-scan/source-sha.txt\"\n290-          printf '%s\\n' \"$DOCKERFILE\" \"$TARGET\" > \"$RUNNER_TEMP/runtime-scan/build-target.txt\"\n291-          docker image inspect \"$IMAGE\" > \"$RUNNER_TEMP/runtime-scan/image-inspect.json\"\n292-          df -B1 / \"$RUNNER_TEMP\" > \"$RUNNER_TEMP/runtime-scan/disk-before.txt\"\n293-      - name: enforce runtime OS vulnerabilities and report application residual\n294:        run: python3 -B tools/security/rescan_runtime_images.py --image \"$IMAGE\" --output \"$RUNNER_TEMP/runtime-scan/image.json\"\n295-      - name: upload runtime reports and application/unfixed residuals\n296-        if: always()\n297-        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7\n298-        with:\n299-          name: runtime-rescan-${{ matrix.name }}\n300-          path: ${{ runner.temp }}/runtime-scan\n301-          if-no-files-found: error\n302-          retention-days: 30\n","exit_code":0,"status":"completed"}}
