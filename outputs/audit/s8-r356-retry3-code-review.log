{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba services/license/src/license-expiry-job.ts'","aggregated_output":"     1\t// Finite, replay-safe Cloud Run Job for credit and updates-window expiry. Cloud Scheduler invokes\n     2\t// this process; it performs one complete pass, closes its pool, and exits non-zero on any failure.\n     3\timport { createInMemoryQueue, type JobAlertingDeps } from \"@caisson/jobs\";\n     4\timport {\n     5\t  createPgPool,\n     6\t  createPgTransactor,\n     7\t  type Transactor,\n     8\t} from \"@caisson/tenancy-rls\";\n     9\timport {\n    10\t  defineCreditExpiryNoticeTask,\n    11\t  defineCreditExpirySweepTask,\n    12\t} from \"@caisson/credits\";\n    13\timport { createJobAlertingDeps, loadOpsAlertChannels } from \"./alerting.ts\";\n    14\timport {\n    15\t  CREDIT_EXPIRY_TICK_TASK,\n    16\t  runCreditExpiryTick,\n    17\t  runUpdatesWindowExpiryTick,\n    18\t} from \"./credit-expiry-scheduler.ts\";\n    19\timport { recipientFor, resolveEmailer } from \"./email-notify.ts\";\n    20\timport { requireJobDatabaseUrl, runAlertedFiniteJob } from \"./finite-job.ts\";\n    21\timport { defineUpdatesWindowExpiryNoticeTask } from \"./updates-window-expiry-task.ts\";\n    22\t\n    23\texport interface LicenseExpiryJobDeps {\n    24\t  db: Transactor;\n    25\t  alerting: JobAlertingDeps;\n    26\t}\n    27\t\n    28\texport async function runLicenseExpiryJob(\n    29\t  deps: LicenseExpiryJobDeps,\n    30\t): Promise<void> {\n    31\t  const emailer = resolveEmailer();\n    32\t  const queue = createInMemoryQueue([\n    33\t    defineCreditExpirySweepTask({ db: deps.db }),\n    34\t    defineCreditExpiryNoticeTask({\n    35\t      db: deps.db,\n    36\t      emailer,\n    37\t      recipientFor: (accountId) => recipientFor(deps.db, accountId),\n    38\t      dashboardUrl: \"https://caisson.sh/dashboard/credits\",\n    39\t    }),\n    40\t    defineUpdatesWindowExpiryNoticeTask({\n    41\t      db: deps.db,\n    42\t      emailer,\n    43\t      recipientFor: (accountId) => recipientFor(deps.db, accountId),\n    44\t      dashboardUrl: \"https://caisson.sh/dashboard/license\",\n    45\t    }),\n    46\t  ]);\n    47\t\n    48\t  await runAlertedFiniteJob(\n    49\t    CREDIT_EXPIRY_TICK_TASK,\n    50\t    deps.alerting,\n    51\t    async () => {\n    52\t      await runCreditExpiryTick(deps.db, queue);\n    53\t      await runUpdatesWindowExpiryTick(deps.db, queue);\n    54\t    },\n    55\t  );\n    56\t}\n    57\t\n    58\texport async function main(\n    59\t  env: Record<string, string | undefined> = process.env,\n    60\t): Promise<void> {\n    61\t  const pool = createPgPool(requireJobDatabaseUrl(env));\n    62\t  try {\n    63\t    await runLicenseExpiryJob({\n    64\t      db: createPgTransactor(pool),\n    65\t      alerting: createJobAlertingDeps(loadOpsAlertChannels(env)),\n    66\t    });\n    67\t  } finally {\n    68\t    await pool.end();\n    69\t  }\n    70\t}\n    71\t\n    72\tif (import.meta.main) await main();\n","exit_code":0,"status":"completed"}}
