{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/lib/ask-ai/handler.ts'","aggregated_output":"     1\t// The /api/ask orchestration (ADR-0234). Pure of I/O wiring: every side-effecting seam (turnstile,\n     2\t// session, retrieval, generation, spend) is injected as a dep so the whole flow is exercised\n     3\t// hermetically with fakes. route.ts builds the real deps. The flow mirrors rag.py's retrieve → ground →\n     4\t// generate → decide, adapted to two model lanes (F2), a fail-closed HARD per-lane spend cap (F2 rider,\n     5\t// reserve-before-generate, extended to the premium lane), a day-one Turnstile gate (F5), and SSE\n     6\t// streaming.\n     7\t//\n     8\t// Response contract:\n     9\t//   413 application/json {error:\"payload_too_large\"} — body exceeds the pre-parse size cap\n    10\t//   400 application/json {error:\"invalid_request\"}   — malformed body / Zod .strict() reject\n    11\t//   403 application/json {error:\"challenge_failed\"}  — Turnstile missing/invalid (fail closed)\n    12\t//   200 text/event-stream                            — SSE; every admitted request streams, incl. escalations\n    13\t// SSE events (each `event: <name>\\ndata: <json>\\n\\n`):\n    14\t//   token      {delta:string}                        — 0+ incremental answer slices (resolved answers only)\n    15\t//   citations  {citations:[{source,url}]}            — terminal, resolved answer\n    16\t//   escalation {reason:EscalationReason}             — terminal, any fail-safe outcome (UI renders the CTA)\n    17\t//   done       {}                                    — stream end\n    18\timport { z } from \"zod\";\n    19\timport { readBodyBounded } from \"../bounded-body.ts\";\n    20\timport {\n    21\t  buildContext,\n    22\t  composeSystem,\n    23\t  isSentinelLead,\n    24\t  leaksFraming,\n    25\t} from \"./rag.ts\";\n    26\timport { type Citation, type ScoredChunk, toCitations } from \"./retrieve.ts\";\n    27\timport type { StreamEvent } from \"./openrouter.ts\";\n    28\timport type { AiGeneration } from \"./ai-capture.ts\";\n    29\timport { dollarsToMicro } from \"./spend.ts\";\n    30\t\n    31\t/** POST /api/ask body — `.strict()` at the trust boundary. `question` mirrors the docs contract bounds. */\n    32\texport const AskBody = z\n    33\t  .object({\n    34\t    question: z.string().trim().min(1).max(2000),\n    35\t    // The Cloudflare Turnstile client token. Bounded; verified server-side (F5).\n    36\t    turnstileToken: z.string().max(2048).optional(),\n    37\t  })\n    38\t  .strict();\n    39\texport type AskBody = z.infer<typeof AskBody>;\n    40\t\n    41\t// Request-body byte cap enforced by a STREAMING bounded read (CWE-770, Kickoff-K). /api/ask is public +\n    42\t// unauthenticated and its body read runs ahead of the Turnstile gate, so an unbounded POST would buffer\n    43\t// fully in memory pre-auth; a self-hosted Next App Router route handler imposes no body limit of its\n    44\t// own, and a content-length precheck alone is skippable (chunked / NaN-length requests). 16 KiB is\n    45\t// generous for AskBody (question ≤2000, turnstileToken ≤2048). Shared reader: lib/bounded-body.ts.\n    46\tconst MAX_ASK_BODY_BYTES = 16_384;\n    47\t\n    48\texport type Lane = \"public\" | \"premium\";\n    49\t\n    50\t/** Machine-readable escalation reasons the UI branches on (all render the same contact/Discord CTA). */\n    51\texport type EscalationReason =\n    52\t  | \"spend_cap\"\n    53\t  | \"retrieval_unavailable\"\n    54\t  | \"no_match\"\n    55\t  | \"insufficient_context\"\n    56\t  | \"leaked_framing\"\n    57\t  | \"generation_failed\";\n    58\t\n    59\texport interface SpendSeam {\n    60\t  /** Atomically reserve one request's worst-case cost against `lane`'s daily cap (ADR-0234 F2 rider,\n    61\t   * hardened + extended to both lanes). `false` means the reservation itself would breach the cap —\n    62\t   * escalate WITHOUT any paid work; `true` means the reservation is held and MUST be settled below. */\n    63\t  reserve: (lane: Lane) => Promise<boolean>;\n    64\t  /** Settle a granted reservation with the real generation cost in micro-dollars (0 when no generation\n    65\t   * happened at all). Best-effort; never throws into the response. */\n    66\t  settle: (lane: Lane, actualMicro: number) => Promise<void>;\n    67\t}\n    68\t\n    69\texport interface AskDeps {\n    70\t  /** Turnstile verification (F5, fail-closed). */\n    71\t  verifyTurnstile: (token: string | undefined, ip: string) => Promise<boolean>;\n    72\t  /** True when a valid better-auth session is present → premium lane (F1/F2). */\n    73\t  isAuthed: () => Promise<boolean>;\n    74\t  /** Retrieve grounding chunks; throws to signal retrieval-unavailable. */\n    75\t  retrieve: (question: string) => Promise<ScoredChunk[]>;\n    76\t  /** Stream a grounded completion (delta events + a terminal cost event). */\n    77\t  stream: (args: {\n    78\t    model: string;\n    79\t    system: string;\n    80\t    user: string;\n    81\t  }) => AsyncIterable<StreamEvent>;\n    82\t  spend: SpendSeam;\n    83\t  /** The two model lanes (F2). */\n    84\t  models: { public: string; premium: string };\n    85\t  /** Question-text capture (ADR-0236, consent-noticed). Called once per admitted request with the\n    86\t   * terminal outcome; best-effort — a capture failure never reaches the response. Optional so the\n    87\t   * hermetic fixtures and any capture-less deployment stay valid. */\n    88\t  capture?: (\n    89\t    lane: Lane,\n    90\t    question: string,\n    91\t    outcome: \"answered\" | \"escalated\",\n    92\t  ) => Promise<void>;\n    93\t  /** File a support ticket for a question the assistant could not answer (G21 parity — the Discord\n    94\t   * bot's own unresolved questions already get this treatment). Called once per genuinely-unanswered\n    95\t   * request (never on `spend_cap`, a capacity signal, not a question a human needs to see — see the\n    96\t   * call site). Best-effort; a failure never reaches the response. Optional for the same reason as\n    97\t   * `capture`. */\n    98\t  escalate?: (question: string, reason: EscalationReason) => Promise<void>;\n    99\t  /** Emit one `$ai_generation` LLM-observability event (CAISSON-120 / audit M4). Called once per\n   100\t   * request that ACTUALLY invoked the model — a resolved answer, a business escalation on a successful\n   101\t   * generation (sentinel/leak), OR a generation failure — but NEVER on a pre-generation escalation\n   102\t   * (`spend_cap` / retrieval, which never reached the model). Fire-and-forget; never throws into the\n   103\t   * response. No prompt/completion text is ever passed. Optional for the same reason as `capture`. */\n   104\t  captureGeneration?: (gen: AiGeneration) => Promise<void>;\n   105\t}\n   106\t\n   107\tconst SECURITY_HEADERS: Record<string, string> = {\n   108\t  \"X-Content-Type-Options\": \"nosniff\",\n   109\t  \"X-Frame-Options\": \"DENY\",\n   110\t  \"Strict-Transport-Security\": \"max-age=63072000; includeSubDomains\",\n   111\t  \"Referrer-Policy\": \"no-referrer\",\n   112\t};\n   113\t\n   114\tfunction jsonError(error: string, status: number): Response {\n   115\t  return new Response(JSON.stringify({ error }), {\n   116\t    status,\n   117\t    headers: {\n   118\t      ...SECURITY_HEADERS,\n   119\t      \"Content-Type\": \"application/json; charset=utf-8\",\n   120\t      \"Cache-Control\": \"no-store\",\n   121\t    },\n   122\t  });\n   123\t}\n   124\t\n   125\t/** Prefer the Railway-set X-Real-IP (not spoofable by the client, unlike XFF), fall back to XFF's first hop. */\n   126\tfunction clientIp(req: Request): string {\n   127\t  const realIp = req.headers.get(\"x-real-ip\")?.trim();\n   128\t  if (realIp !== undefined && realIp.length > 0) return realIp;\n   129\t  const xff = req.headers.get(\"x-forwarded-for\")?.split(\",\")[0]?.trim();\n   130\t  return xff !== undefined && xff.length > 0 ? xff : \"\";\n   131\t}\n   132\t\n   133\t// ponytail: emit the guarded answer in fixed slices — token-GRANULAR live passthrough is deferred. The\n   134\t// sentinel + leak guards must see the WHOLE reply (rag.py semantics, intact), so the answer is buffered,\n   135\t// guarded, then streamed out as slices. An 800-token completion buffers within the model's own\n   136\t// generation time; upgrade path = a sentinel/leak-safe hold-back window if first-token latency matters.\n   137\tconst SLICE = 180;\n   138\tfunction* sliceAnswer(answer: string): Generator<string> {\n   139\t  for (let i = 0; i < answer.length; i += SLICE) {\n   140\t    yield answer.slice(i, i + SLICE);\n   141\t  }\n   142\t}\n   143\t\n   144\t/** Handle one POST /api/ask. Never throws — every failure is a status code or a streamed escalation. */\n   145\texport async function handleAsk(\n   146\t  req: Request,\n   147\t  deps: AskDeps,\n   148\t): Promise<Response> {\n   149\t  // 1. body — read through the streaming size cap (never fully buffered first, CWE-770), then a bad\n   150\t  //    body dies here, not at OpenRouter.\n   151\t  const body = await readBodyBounded(req, MAX_ASK_BODY_BYTES);\n   152\t  if (!body.ok) return jsonError(\"payload_too_large\", 413);\n   153\t  let rawBody: unknown;\n   154\t  try {\n   155\t    rawBody = JSON.parse(body.text);\n   156\t  } catch {\n   157\t    return jsonError(\"invalid_request\", 400);\n   158\t  }\n   159\t  const parsed = AskBody.safeParse(rawBody);\n   160\t  if (!parsed.success) return jsonError(\"invalid_request\", 400);\n   161\t  const question = parsed.data.question;\n   162\t\n   163\t  // 2. Turnstile gate (F5, fail closed) — before any paid work.\n   164\t  const ip = clientIp(req);\n   165\t  const passed = await deps.verifyTurnstile(parsed.data.turnstileToken, ip);\n   166\t  if (!passed) return jsonError(\"challenge_failed\", 403);\n   167\t\n   168\t  // 3. lane selection (F1/F2): a valid session → premium; anonymous → public (spend-capped).\n   169\t  const authed = await deps.isAuthed();\n   170\t  const lane: Lane = authed ? \"premium\" : \"public\";\n   171\t  const model = authed ? deps.models.premium : deps.models.public;\n   172\t\n   173\t  // 4. stream. Everything admitted responds 200 SSE — including escalations (the honest fail-safe).\n   174\t  const encoder = new TextEncoder();\n   175\t  const stream = new ReadableStream<Uint8Array>({\n   176\t    async start(controller) {\n   177\t      const emit = (event: string, data: unknown): void => {\n   178\t        controller.enqueue(\n   179\t          encoder.encode(`event: ${event}\\ndata: ${JSON.stringify(data)}\\n\\n`),\n   180\t        );\n   181\t      };\n   182\t      let escalationReason: EscalationReason | undefined;\n   183\t      const escalate = (reason: EscalationReason): void => {\n   184\t        escalationReason = reason;\n   185\t        emit(\"escalation\", { reason });\n   186\t      };\n   187\t\n   188\t      let costUsd: number | undefined;\n   189\t      let reserved = false;\n   190\t      // ADR-0236: every terminal path below is either a resolved answer or an escalation — the\n   191\t      // assignment to \"answered\" happens only after all guards pass.\n   192\t      let outcome: \"answered\" | \"escalated\" = \"escalated\";\n   193\t      // M4 (CAISSON-120) $ai_generation telemetry — only emitted when the model was actually invoked\n   194\t      // (genAttempted). costUsd (above) carries the USD cost; these carry the rest.\n   195\t      let genAttempted = false;\n   196\t      let genLatencyMs = 0;\n   197\t      let genInputTokens = 0;\n   198\t      let genOutputTokens = 0;\n   199\t      let genError: string | undefined;\n   200\t      try {\n   201\t        // 4a. hard per-lane spend cap (F2 rider, hardened + extended to both lanes) — reserve BEFORE\n   202\t        // any paid work, atomically, so two concurrent requests near the cap can never both pass (closes\n   203\t        // the check-then-charge race). Fails CLOSED to escalation.\n   204\t        reserved = await deps.spend.reserve(lane);\n   205\t        if (!reserved) {\n   206\t          escalate(\"spend_cap\");\n   207\t          return;\n   208\t        }\n   209\t\n   210\t        // 4b. retrieve — a failure or empty result escalates rather than answering ungrounded.\n   211\t        let chunks: ScoredChunk[];\n   212\t        try {\n   213\t          chunks = await deps.retrieve(question);\n   214\t        } catch {\n   215\t          escalate(\"retrieval_unavailable\");\n   216\t          return;\n   217\t        }\n   218\t        if (chunks.length === 0) {\n   219\t          escalate(\"no_match\");\n   220\t          return;\n   221\t        }\n   222\t\n   223\t        // 4c. ground + generate. Retrieved context is fenced in the SYSTEM turn (untrusted data); the\n   224\t        // USER turn carries only the question.\n   225\t        const system = composeSystem(buildContext(chunks));\n   226\t        let full = \"\";\n   227\t        genAttempted = true;\n   228\t        const genStartMs = Date.now();\n   229\t        try {\n   230\t          for await (const ev of deps.stream({\n   231\t            model,\n   232\t            system,\n   233\t            user: question,\n   234\t          })) {\n   235\t            if (ev.type === \"delta\") full += ev.text;\n   236\t            else {\n   237\t              costUsd = ev.usd;\n   238\t              if (ev.inputTokens !== undefined) genInputTokens = ev.inputTokens;\n   239\t              if (ev.outputTokens !== undefined)\n   240\t                genOutputTokens = ev.outputTokens;\n   241\t            }\n   242\t          }\n   243\t        } catch {\n   244\t          genLatencyMs = Date.now() - genStartMs;\n   245\t          genError = \"generation_failed\";\n   246\t          escalate(\"generation_failed\");\n   247\t          return;\n   248\t        }\n   249\t        genLatencyMs = Date.now() - genStartMs;\n   250\t\n   251\t        // 4d. decide (guards on the FULL reply — intact rag.py semantics).\n   252\t        const answer = full.trim();\n   253\t        if (answer.length === 0) {\n   254\t          escalate(\"generation_failed\");\n   255\t          return;\n   256\t        }\n   257\t        if (isSentinelLead(answer)) {\n   258\t          escalate(\"insufficient_context\");\n   259\t          return;\n   260\t        }\n   261\t        if (leaksFraming(answer)) {\n   262\t          escalate(\"leaked_framing\");\n   263\t          return;\n   264\t        }\n   265\t\n   266\t        // 4e. resolved answer — stream it, then the deduped citations.\n   267\t        outcome = \"answered\";\n   268\t        for (const piece of sliceAnswer(answer))\n   269\t          emit(\"token\", { delta: piece });\n   270\t        const citations: Citation[] = toCitations(chunks);\n   271\t        emit(\"citations\", { citations });\n   272\t      } finally {\n   273\t        // ADR-0236 capture — after the Turnstile gate by construction (this stream only exists for\n   274\t        // admitted requests). Best-effort: never turn a capture failure into a user-facing error.\n   275\t        try {\n   276\t          await deps.capture?.(lane, question, outcome);\n   277\t        } catch {\n   278\t          /* best-effort */\n   279\t        }\n   280\t        // Settle the reservation with the real cost (0 when no generation happened at all — e.g.\n   281\t        // retrieval failed after the reservation was granted, fully releasing it). Only when a\n   282\t        // reservation was actually granted above (never after a spend_cap escalation, which reserved\n   283\t        // nothing). A metering write must never fail the user's response — swallow.\n   284\t        if (reserved) {\n   285\t          const actualMicro =\n   286\t            costUsd !== undefined ? dollarsToMicro(costUsd) : 0;\n   287\t          try {\n   288\t            await deps.spend.settle(lane, actualMicro);\n   289\t          } catch {\n   290\t            /* best-effort: never turn a metering-write failure into a user-facing error */\n   291\t          }\n   292\t        }\n   293\t        emit(\"done\", {});\n   294\t        controller.close();\n   295\t\n   296\t        // M4 (CAISSON-120): one $ai_generation event per real model call — a resolved answer, a\n   297\t        // business escalation on a successful generation (sentinel/leak), OR a generation failure —\n   298\t        // never a pre-generation escalation (spend_cap / retrieval never set genAttempted). Fired\n   299\t        // detached after close, like the escalate push below: fire-and-forget, a PostHog failure never\n   300\t        // touches the answer path (the seam itself never throws; `.catch` is defense-in-depth, and the\n   301\t        // whole `?.(...).catch` chain short-circuits to undefined when the dep is unset).\n   302\t        if (genAttempted) {\n   303\t          const gen: AiGeneration = {\n   304\t            model,\n   305\t            inputTokens: genInputTokens,\n   306\t            outputTokens: genOutputTokens,\n   307\t            totalCostUsd: costUsd ?? 0,\n   308\t            latencySeconds: genLatencyMs / 1000,\n   309\t            isError: genError !== undefined,\n   310\t            ...(genError === undefined\n   311\t              ? { httpStatus: 200 }\n   312\t              : { error: genError }),\n   313\t          };\n   314\t          void deps.captureGeneration?.(gen).catch(() => {\n   315\t            /* best-effort */\n   316\t          });\n   317\t        }\n   318\t\n   319\t        // G21: file a support ticket for a genuinely-unanswered question — never for `spend_cap`,\n   320\t        // which is a capacity signal (a traffic burst tripping the daily budget), not a question a\n   321\t        // human needs to follow up on; ticketing every cap-hit would flood Triage during a burst.\n   322\t        // SHIP review WR-02: fired AFTER close, detached (never awaited) — a cross-service push (up\n   323\t        // to a 10s timeout in the real deps) must never hold the buyer's socket open, which matters\n   324\t        // most exactly when it would trip most often: a docs-service outage that escalates every\n   325\t        // question. `.catch` is defense-in-depth (deps.escalate is documented best-effort already).\n   326\t        if (\n   327\t          outcome === \"escalated\" &&\n   328\t          escalationReason !== undefined &&\n   329\t          escalationReason !== \"spend_cap\"\n   330\t        ) {\n   331\t          void deps.escalate?.(question, escalationReason).catch(() => {\n   332\t            /* best-effort */\n   333\t          });\n   334\t        }\n   335\t      }\n   336\t    },\n   337\t  });\n   338\t\n   339\t  return new Response(stream, {\n   340\t    status: 200,\n   341\t    headers: {\n   342\t      ...SECURITY_HEADERS,\n   343\t      \"Content-Type\": \"text/event-stream; charset=utf-8\",\n   344\t      \"Cache-Control\": \"no-store, no-transform\",\n   345\t      Connection: \"keep-alive\",\n   346\t      // Disable proxy/Next buffering so SSE flushes incrementally through CF + Railway.\n   347\t      \"X-Accel-Buffering\": \"no\",\n   348\t    },\n   349\t  });\n   350\t}\n","exit_code":0,"status":"completed"}}
