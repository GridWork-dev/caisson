{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba services/license/src/checkout-abandonment-store.ts'","aggregated_output":"     1\t// The abandoned-checkout email feature's storage (SPEC outputs/specs/deferred-respec/\n     2\t// SPEC-abandoned-checkout-email.md, operator-locked 2026-07-10: N=24h delay, implicit consent,\n     3\t// env-gated discount). Two append-only tables:\n     4\t//   • checkout_abandonment — one row per `POST /api/checkout/started` (apps/site), fed the moment a\n     5\t//     signed-in buyer opens the Paddle overlay. Tenant-owned (ADR-0005).\n     6\t//   • checkout_abandonment_notice — the per-row already-notified marker (ON CONFLICT DO NOTHING),\n     7\t//     mirroring `@caisson/credits`'s `credit_expiry_notice` shape exactly: PK is the SUBJECT id\n     8\t//     (the checkout_abandonment row this notice covers), account_id carried for the tenant policy\n     9\t//     + the 30-day cross-row suppression read.\n    10\t//\n    11\t// Both tenant-owned + fail-closed RLS via @caisson/tenancy-rls (ADR-0005). Ships as the checksum-\n    12\t// pinned platform migration `0024_checkout_abandonment.sql` (@caisson/platform-migrations) —\n    13\t// SEPARATE migration from any future change here (ADR-0006 append-only).\n    14\timport { buildTenantPolicySql } from \"@caisson/tenancy-rls\";\n    15\timport type { TenantExecutor, Transactor } from \"@caisson/tenancy-rls\";\n    16\timport { withAdminWrite } from \"@caisson/org-controls\";\n    17\t\n    18\texport const CHECKOUT_ABANDONMENT_SCHEMA_SQL = `\n    19\tCREATE TABLE checkout_abandonment (\n    20\t  id text PRIMARY KEY,\n    21\t  account_id text NOT NULL,\n    22\t  items jsonb NOT NULL,\n    23\t  started_at timestamptz NOT NULL DEFAULT now()\n    24\t);\n    25\tCREATE INDEX checkout_abandonment_account_started_idx ON checkout_abandonment (account_id, started_at);\n    26\t\n    27\t${buildTenantPolicySql(\"checkout_abandonment\")}\n    28\t`;\n    29\t\n    30\texport const CHECKOUT_ABANDONMENT_NOTICE_SCHEMA_SQL = `\n    31\tCREATE TABLE checkout_abandonment_notice (\n    32\t  id text PRIMARY KEY,\n    33\t  account_id text NOT NULL,\n    34\t  created_at timestamptz NOT NULL DEFAULT now()\n    35\t);\n    36\tCREATE INDEX checkout_abandonment_notice_account_created_idx ON checkout_abandonment_notice (account_id, created_at);\n    37\t\n    38\t${buildTenantPolicySql(\"checkout_abandonment_notice\")}\n    39\t`;\n    40\t\n    41\t/** One cart line as captured at checkout-start (id + label only — `apps/site/lib/cart.ts`'s\n    42\t *  `CartItem` also carries priceId/amount/kind, but the email only ever displays the label). */\n    43\texport interface CheckoutAbandonmentLine {\n    44\t  id: string;\n    45\t  label: string;\n    46\t}\n    47\t\n    48\texport interface RecordCheckoutAbandonmentInput {\n    49\t  id: string;\n    50\t  accountId: string;\n    51\t  items: readonly CheckoutAbandonmentLine[];\n    52\t}\n    53\t\n    54\t/** Insert one checkout-started row. Run inside `withTenant` (apps/site's `readScoped`). */\n    55\texport async function recordCheckoutAbandonment(\n    56\t  tx: TenantExecutor,\n    57\t  input: RecordCheckoutAbandonmentInput,\n    58\t): Promise<void> {\n    59\t  await tx.query(\n    60\t    `INSERT INTO checkout_abandonment (id, account_id, items) VALUES ($1, $2, $3::jsonb)`,\n    61\t    [input.id, input.accountId, JSON.stringify(input.items)],\n    62\t  );\n    63\t}\n    64\t\n    65\t/**\n    66\t * Every distinct account holding a checkout_abandonment row old enough to be notice-eligible\n    67\t * (`started_at <= now() - delayHours`), read cross-tenant via the already-provisioned\n    68\t * `admin_write` role's SELECT-only policy on this table (mirrors `listWalletAccountIds`/\n    69\t * `listUpdatesWindowAccountIds` in credit-expiry-scheduler.ts — the daily tick has no account\n    70\t * context yet). Deterministic order so a test asserting the list needs no sort.\n    71\t */\n    72\texport async function listAbandonedCheckoutAccountIds(\n    73\t  db: Transactor,\n    74\t  delayHours: number,\n    75\t): Promise<string[]> {\n    76\t  const cutoff = new Date(Date.now() - delayHours * 60 * 60 * 1000);\n    77\t  return withAdminWrite(db, async (tx) => {\n    78\t    const r = await tx.query<{ account_id: string }>(\n    79\t      `SELECT DISTINCT account_id FROM checkout_abandonment WHERE started_at <= $1 ORDER BY account_id`,\n    80\t      [cutoff.toISOString()],\n    81\t    );\n    82\t    return r.rows.map((row) => row.account_id);\n    83\t  });\n    84\t}\n    85\t\n    86\tfunction parseItems(raw: unknown): CheckoutAbandonmentLine[] {\n    87\t  if (!Array.isArray(raw)) return [];\n    88\t  const lines: CheckoutAbandonmentLine[] = [];\n    89\t  for (const entry of raw) {\n    90\t    if (typeof entry !== \"object\" || entry === null) continue;\n    91\t    const { id, label } = entry as Record<string, unknown>;\n    92\t    if (typeof id === \"string\" && typeof label === \"string\") {\n    93\t      lines.push({ id, label });\n    94\t    }\n    95\t  }\n    96\t  return lines;\n    97\t}\n    98\t\n    99\texport interface SweepAbandonedCheckoutResult {\n   100\t  lines: readonly CheckoutAbandonmentLine[];\n   101\t}\n   102\t\n   103\t/**\n   104\t * Per-account sweep: find the OLDEST checkout_abandonment row that is (1) past the delay window,\n   105\t * (2) not converted since (no `order_record` row for this account created after `started_at` — the\n   106\t * same \"a purchase landed\" signal apply-billing-event's grant path writes for every granting\n   107\t * invoice/one-time transaction, G26; entitlement_grant alone would miss a zero-entitlement\n   108\t * Developer-plan conversion), and (3) suppressed by NEITHER a prior notice for the SAME row NOR any\n   109\t * notice for this account within the last 30 days (spec §c: one nudge per rolling month). On a hit,\n   110\t * marks it via an append-only marker row keyed on the SUBJECT id (ON CONFLICT DO NOTHING,\n   111\t * `credit_expiry_notice`'s shape) so a concurrent or replayed sweep never double-marks the same\n   112\t * row; returns `null` when nothing is eligible or the marker insert lost the race. Run inside\n   113\t * `withTenant`.\n   114\t *\n   115\t * // ponytail: the marker commits in THIS function's own statement; the caller sends the email\n   116\t * // AFTER this returns (detached, mirroring `notifyPurchaseEmail`'s post-commit contract) rather\n   117\t * // than nesting the send inside this same SQL transaction the way\n   118\t * // `sweepUpdatesWindowExpiryNotices` does — a send failure after this commits is a silent miss,\n   119\t * // not a retry. Acceptable for a one-time, low-stakes nudge (not a money path); thread a\n   120\t * // structural emailer through here instead if guaranteed delivery ever matters.\n   121\t */\n   122\texport async function sweepEligibleAbandonedCheckout(\n   123\t  tx: TenantExecutor,\n   124\t  accountId: string,\n   125\t  delayHours: number,\n   126\t): Promise<SweepAbandonedCheckoutResult | null> {\n   127\t  const recentNotice = await tx.query<{ id: string }>(\n   128\t    `SELECT id FROM checkout_abandonment_notice\n   129\t      WHERE account_id = $1 AND created_at > now() - interval '30 days'\n   130\t      LIMIT 1`,\n   131\t    [accountId],\n   132\t  );\n   133\t  if (recentNotice.rows.length > 0) return null;\n   134\t\n   135\t  const cutoff = new Date(Date.now() - delayHours * 60 * 60 * 1000);\n   136\t  const due = await tx.query<{ id: string; items: unknown }>(\n   137\t    `SELECT ca.id, ca.items\n   138\t       FROM checkout_abandonment ca\n   139\t      WHERE ca.account_id = $1\n   140\t        AND ca.started_at <= $2\n   141\t        AND NOT EXISTS (\n   142\t          SELECT 1 FROM order_record o\n   143\t           WHERE o.account_id = ca.account_id AND o.created_at > ca.started_at\n   144\t        )\n   145\t        AND NOT EXISTS (\n   146\t          SELECT 1 FROM checkout_abandonment_notice n WHERE n.id = ca.id\n   147\t        )\n   148\t      ORDER BY ca.started_at ASC\n   149\t      LIMIT 1`,\n   150\t    [accountId, cutoff.toISOString()],\n   151\t  );\n   152\t  const row = due.rows[0];\n   153\t  if (row === undefined) return null;\n   154\t\n   155\t  const marked = await tx.query<{ id: string }>(\n   156\t    `INSERT INTO checkout_abandonment_notice (id, account_id) VALUES ($1, $2)\n   157\t     ON CONFLICT DO NOTHING RETURNING id`,\n   158\t    [row.id, accountId],\n   159\t  );\n   160\t  if (marked.rows.length === 0) return null; // raced/replayed — someone else already sent it\n   161\t\n   162\t  return { lines: parseItems(row.items) };\n   163\t}\n   164\t\n   165\t/**\n   166\t * Whether `accountId` has a checkout_abandonment_notice within the last `withinDays` days — the\n   167\t * `abandoned_checkout_converted` PostHog event's grant-time precondition (spec §e: \"read at grant\n   168\t * time, not a new counter\"), reading back the SAME marker table the sweep writes. Run inside\n   169\t * `withTenant`.\n   170\t */\n   171\texport async function hasRecentAbandonedCheckoutNotice(\n   172\t  tx: TenantExecutor,\n   173\t  accountId: string,\n   174\t  withinDays = 14,\n   175\t): Promise<boolean> {\n   176\t  const cutoff = new Date(Date.now() - withinDays * 24 * 60 * 60 * 1000);\n   177\t  const r = await tx.query<{ id: string }>(\n   178\t    `SELECT id FROM checkout_abandonment_notice WHERE account_id = $1 AND created_at > $2 LIMIT 1`,\n   179\t    [accountId, cutoff.toISOString()],\n   180\t  );\n   181\t  return r.rows.length > 0;\n   182\t}\n","exit_code":0,"status":"completed"}}
