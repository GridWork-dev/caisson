{"type":"item.completed","item":{"id":"item_71","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/app/api/cart/owned/route.test.ts'","aggregated_output":"     1\t// Regression coverage for ADR-0418: GET /api/cart/owned short-circuits on the hint cookie's\n     2\t// ABSENCE before ever calling getOwnedCartItemIds() — the server-side half of the optimization a\n     3\t// prior revision did client-side (skipping the fetch itself via a client-readable hint cookie).\n     4\t// This route takes no params and has no dependency-injection seam (unlike\n     5\t// `app/api/audit/proof/route.ts`'s `createTenantProofRoute(dependencies)` factory), so — per the\n     6\t// existing `mock.module(\"next/headers\", ...)` idiom already used by `lib/auth.test.ts` and\n     7\t// `lib/auth-account.test.ts` for the same reason (this runs outside a real Next request scope) —\n     8\t// `cookies()` is stubbed here rather than inventing a new mocking layer. `@/lib/owned-cart-items`\n     9\t// is stubbed too, purely to observe whether it was ever called; the cookie's PRESENCE case below\n    10\t// proves it still IS called — the hint is a fail-open optimization, never a trust boundary.\n    11\timport { expect, mock, test } from \"bun:test\";\n    12\timport { SESSION_HINT_COOKIE_NAME } from \"@/lib/session-hint-cookie\";\n    13\t\n    14\tlet hintCookiePresent = false;\n    15\tlet getOwnedCartItemIdsCalls = 0;\n    16\t\n    17\tmock.module(\"next/headers\", () => ({\n    18\t  cookies: async () => ({\n    19\t    get: (name: string) =>\n    20\t      name === SESSION_HINT_COOKIE_NAME && hintCookiePresent\n    21\t        ? { name, value: \"1\" }\n    22\t        : undefined,\n    23\t  }),\n    24\t}));\n    25\t\n    26\tmock.module(\"@/lib/owned-cart-items\", () => ({\n    27\t  getOwnedCartItemIds: async (): Promise<Set<string>> => {\n    28\t    getOwnedCartItemIdsCalls++;\n    29\t    return new Set([\"module:audit-worm\"]);\n    30\t  },\n    31\t}));\n    32\t\n    33\ttest(\"no hint cookie: returns {owned: []} without ever calling getOwnedCartItemIds\", async () => {\n    34\t  hintCookiePresent = false;\n    35\t  getOwnedCartItemIdsCalls = 0;\n    36\t  const { GET } = await import(\"./route.ts\");\n    37\t\n    38\t  const response = await GET();\n    39\t\n    40\t  expect(await response.json()).toEqual({ owned: [] });\n    41\t  expect(getOwnedCartItemIdsCalls).toBe(0);\n    42\t  expect(response.headers.get(\"cache-control\")).toBe(\"private, no-store\");\n    43\t});\n    44\t\n    45\ttest(\"hint cookie present: falls through to the real session resolution (a hint is a fail-open optimization, not a grant)\", async () => {\n    46\t  hintCookiePresent = true;\n    47\t  getOwnedCartItemIdsCalls = 0;\n    48\t  const { GET } = await import(\"./route.ts\");\n    49\t\n    50\t  const response = await GET();\n    51\t\n    52\t  expect(await response.json()).toEqual({ owned: [\"module:audit-worm\"] });\n    53\t  expect(getOwnedCartItemIdsCalls).toBe(1);\n    54\t});\n","exit_code":0,"status":"completed"}}
