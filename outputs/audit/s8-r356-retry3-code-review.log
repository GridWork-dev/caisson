{"type":"item.completed","item":{"id":"item_65","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/tenancy-rls/src/supabase.ts'","aggregated_output":"     1\t// Supabase `Transactor` driver for the `withTenant` seam (rls.ts:21,31) — ADR-0174. A thin\n     2\t// `Pool` wiring over the canonical node-postgres adapter (`createPgTransactor`, node-pg.ts).\n     3\t//\n     4\t// BINDING CONSTRAINT: `withTenant` does `SET LOCAL ROLE app` + `set_config(..., true)` and needs\n     5\t// BOTH to hold for the life of ONE real transaction on ONE real TCP connection. Supabase's\n     6\t// TRANSACTION-mode pooler (Supavisor, default port 6543) hands a *different* physical backend\n     7\t// connection to each statement even inside what looks like one logical transaction from the\n     8\t// app's side — `SET LOCAL` silently evaporates between statements and RLS quietly stops being\n     9\t// tenant-scoped. A serverless-HTTP path (the Data API / PostgREST) has no session/transaction\n    10\t// concept at all and can't run this driver's raw SQL either way. This driver therefore accepts\n    11\t// ONLY a session-mode pooler or a direct connection (both default to port 5432) and fails closed\n    12\t// at CONSTRUCTION — never at the first silently-unscoped query — when the connection string is\n    13\t// shaped like the transaction-mode pooler.\n    14\timport { ConfigError } from \"@caisson/kernel\";\n    15\timport { createPgTransactor } from \"./node-pg.ts\";\n    16\timport { createPgPool } from \"./pool.ts\";\n    17\timport type { Transactor } from \"./rls.ts\";\n    18\t\n    19\t/** Supavisor's transaction-mode pooler defaults to this port; `SET LOCAL` cannot survive it. */\n    20\tconst TRANSACTION_MODE_POOLER_PORT = \"6543\";\n    21\t\n    22\texport interface SupabaseTransactorConfig {\n    23\t  /** A Postgres wire-protocol connection string — session-mode pooler or direct connection ONLY. */\n    24\t  connectionString: string;\n    25\t  /**\n    26\t   * Override the underlying `Transactor`. Tests inject a PGlite-backed `Transactor` here instead\n    27\t   * of a real Supabase connection, so `createSupabaseTransactor` never opens a socket in `bun\n    28\t   * test` — the same override shape as `@caisson/jobs`'s `TriggerJobQueueConfig.client`.\n    29\t   */\n    30\t  driver?: Transactor;\n    31\t}\n    32\t\n    33\tfunction assertSessionModeConnection(connectionString: string): void {\n    34\t  if (connectionString.length === 0) {\n    35\t    throw new ConfigError(\n    36\t      \"createSupabaseTransactor requires a non-empty `connectionString`\",\n    37\t    );\n    38\t  }\n    39\t  let url: URL;\n    40\t  try {\n    41\t    url = new URL(connectionString);\n    42\t  } catch {\n    43\t    throw new ConfigError(\n    44\t      \"createSupabaseTransactor received an unparseable `connectionString`\",\n    45\t    );\n    46\t  }\n    47\t  if (url.port === TRANSACTION_MODE_POOLER_PORT) {\n    48\t    throw new ConfigError(\n    49\t      \"createSupabaseTransactor refuses Supabase's transaction-mode pooler (port 6543) — \" +\n    50\t        \"SET LOCAL cannot survive it. Point `connectionString` at the session-mode pooler or a \" +\n    51\t        \"direct connection (port 5432) instead.\",\n    52\t    );\n    53\t  }\n    54\t}\n    55\t\n    56\t/**\n    57\t * The Supabase `Transactor` driver. Fails closed at construction (`ConfigError`) when\n    58\t * `connectionString` is empty, unparseable, or shaped like Supabase's transaction-mode pooler —\n    59\t * never at the first query that would otherwise leak across tenants. Dormant: no `Pool`, no\n    60\t * socket, is created until this factory runs with a real `connectionString` and no injected\n    61\t * `driver`.\n    62\t */\n    63\texport function createSupabaseTransactor(\n    64\t  config: SupabaseTransactorConfig,\n    65\t): Transactor {\n    66\t  assertSessionModeConnection(config.connectionString);\n    67\t  if (config.driver !== undefined) {\n    68\t    return config.driver;\n    69\t  }\n    70\t  const pool = createPgPool(config.connectionString);\n    71\t  return createPgTransactor(pool);\n    72\t}\n","exit_code":0,"status":"completed"}}
