{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba services/support-bot/src/caisson_support_bot/lifecycle.py'","aggregated_output":"     1\t\"\"\"Bounded shutdown primitives for the disposable GCE worker.\n     2\t\n     3\tThe process has one dangerous inbound mutation: a callback can grant Discord roles.  Shutdown\n     4\ttherefore closes this gate before closing the Gateway, waits a bounded interval for in-flight work,\n     5\tand cancels anything that cannot finish inside the container grace period.\n     6\t\"\"\"\n     7\t\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport asyncio\n    11\tfrom collections.abc import AsyncIterator\n    12\tfrom contextlib import asynccontextmanager\n    13\t\n    14\tfrom discord.ext import commands\n    15\t\n    16\t\n    17\tclass PrivilegedWorkClosed(RuntimeError):\n    18\t    \"\"\"Raised when a mutating request arrives after graceful shutdown has begun.\"\"\"\n    19\t\n    20\t\n    21\tclass PrivilegedWorkGate:\n    22\t    \"\"\"Track privileged mutations so shutdown can reject new work and drain active work.\"\"\"\n    23\t\n    24\t    def __init__(self) -> None:\n    25\t        self._accepting = True\n    26\t        self._active: set[asyncio.Task[object]] = set()\n    27\t        self._empty = asyncio.Event()\n    28\t        self._empty.set()\n    29\t\n    30\t    @property\n    31\t    def accepting(self) -> bool:\n    32\t        return self._accepting\n    33\t\n    34\t    def stop_accepting(self) -> None:\n    35\t        \"\"\"Atomically close the gate. The event loop cannot interleave before ``track`` registers.\"\"\"\n    36\t        self._accepting = False\n    37\t\n    38\t    @asynccontextmanager\n    39\t    async def track(self) -> AsyncIterator[None]:\n    40\t        \"\"\"Register the current task as active, or reject it after the gate closes.\"\"\"\n    41\t        if not self._accepting:\n    42\t            raise PrivilegedWorkClosed(\"privileged work gate is closed\")\n    43\t        task = asyncio.current_task()\n    44\t        # An async context always runs inside a Task in practice.\n    45\t        if task is None:  # pragma: no cover\n    46\t            raise RuntimeError(\"privileged work must run inside an asyncio task\")\n    47\t        self._active.add(task)\n    48\t        self._empty.clear()\n    49\t        try:\n    50\t            yield\n    51\t        finally:\n    52\t            self._active.discard(task)\n    53\t            if not self._active:\n    54\t                self._empty.set()\n    55\t\n    56\t    async def drain(self, *, timeout_s: float) -> bool:\n    57\t        \"\"\"Stop new mutations and wait for active ones; cancel stragglers at the deadline.\n    58\t\n    59\t        Returns ``True`` when all work completed naturally. A ``False`` result means one or more\n    60\t        tasks were cancelled. Role grants remain retry-safe because the handler applies only roles\n    61\t        absent from the member when a caller retries after replacement.\n    62\t        \"\"\"\n    63\t        self.stop_accepting()\n    64\t        try:\n    65\t            await asyncio.wait_for(self._empty.wait(), timeout=timeout_s)\n    66\t            return True\n    67\t        except TimeoutError:\n    68\t            active = tuple(self._active)\n    69\t            for task in active:\n    70\t                task.cancel()\n    71\t            await asyncio.gather(*active, return_exceptions=True)\n    72\t            return False\n    73\t\n    74\t\n    75\tasync def run_gateway(\n    76\t    *,\n    77\t    bot: commands.Bot,\n    78\t    token: str,\n    79\t    shutdown: asyncio.Event,\n    80\t    work_gate: PrivilegedWorkGate,\n    81\t    shutdown_grace_s: float,\n    82\t) -> None:\n    83\t    \"\"\"Run Discord until SIGTERM, then close the mutation gate and Gateway within a deadline.\n    84\t\n    85\t    ``discord.py`` 2.7's reconnect loop owns the protocol state: ``reconnect=True`` uses its\n    86\t    exponential full-jitter backoff and preserves sequence/session/gateway fields for RESUME before\n    87\t    falling back to a fresh session. Keeping that behavior in the library avoids a competing outer\n    88\t    retry loop that would discard resumable state.\n    89\t    \"\"\"\n    90\t    gateway_task = asyncio.create_task(bot.start(token, reconnect=True), name=\"discord-gateway\")\n    91\t    shutdown_task = asyncio.create_task(shutdown.wait(), name=\"shutdown-signal\")\n    92\t    done, _ = await asyncio.wait({gateway_task, shutdown_task}, return_when=asyncio.FIRST_COMPLETED)\n    93\t\n    94\t    unexpected_exit = gateway_task in done and not shutdown.is_set()\n    95\t    gateway_error: BaseException | None = None\n    96\t    if gateway_task.done():\n    97\t        try:\n    98\t            await gateway_task\n    99\t        except BaseException as exc:  # preserve the exact gateway failure after cleanup.\n   100\t            gateway_error = exc\n   101\t\n   102\t    # Ordering is load-bearing: reject a new grant, let an in-flight Discord REST mutation settle,\n   103\t    # then close the Gateway/HTTP client it depends on. A stalled mutation is cancelled at the\n   104\t    # drain deadline, so this cannot hold the disposable worker open indefinitely.\n   105\t    work_gate.stop_accepting()\n   106\t    await work_gate.drain(timeout_s=shutdown_grace_s)\n   107\t\n   108\t    close_error: Exception | None = None\n   109\t    try:\n   110\t        await asyncio.wait_for(bot.close(), timeout=shutdown_grace_s)\n   111\t    except TimeoutError:\n   112\t        # The supervisor will replace this disposable process; do not hang past its grace window.\n   113\t        pass\n   114\t    # Drain first, then preserve the exact close failure for the supervisor.\n   115\t    except Exception as exc:\n   116\t        close_error = exc\n   117\t\n   118\t    shutdown_task.cancel()\n   119\t    await asyncio.gather(shutdown_task, return_exceptions=True)\n   120\t    if not gateway_task.done():\n   121\t        try:\n   122\t            await asyncio.wait_for(gateway_task, timeout=shutdown_grace_s)\n   123\t        except TimeoutError:\n   124\t            gateway_task.cancel()\n   125\t            await asyncio.gather(gateway_task, return_exceptions=True)\n   126\t\n   127\t    if gateway_error is not None:\n   128\t        raise gateway_error\n   129\t    if close_error is not None:\n   130\t        raise close_error\n   131\t    if unexpected_exit:\n   132\t        raise RuntimeError(\"Discord Gateway exited without a shutdown signal\")\n","exit_code":0,"status":"completed"}}
