{"type":"item.completed","item":{"id":"item_64","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba services/license/src/anchor-checkpoint-job.ts'","aggregated_output":"     1\t// Replay-safe audit-anchor checkpoint pass. Cloud Tasks invokes this finite Cloud Run Job; the\n     2\t// durable outbox/receipt state prevents a replay from publishing the same anchor twice.\n     3\timport { S3Client } from \"@aws-sdk/client-s3\";\n     4\timport {\n     5\t  AnchorOutbox,\n     6\t  AuditChainStore,\n     7\t  defineAnchorCheckpointTask,\n     8\t  S3ArtifactStore,\n     9\t  TsaAnchorLog,\n    10\t  type AnchorCheckpointDeps,\n    11\t} from \"@caisson/audit-worm\";\n    12\timport { createInMemoryQueue, type JobAlertingDeps } from \"@caisson/jobs\";\n    13\timport {\n    14\t  createPgPool,\n    15\t  createPgTransactor,\n    16\t  type Transactor,\n    17\t} from \"@caisson/tenancy-rls\";\n    18\timport {\n    19\t  ANCHOR_CHECKPOINT_TICK_TASK,\n    20\t  runAnchorCheckpointTick,\n    21\t} from \"./anchoring-scheduler.ts\";\n    22\timport { createJobAlertingDeps, loadOpsAlertChannels } from \"./alerting.ts\";\n    23\timport { requireJobDatabaseUrl, runAlertedFiniteJob } from \"./finite-job.ts\";\n    24\t\n    25\texport interface AnchorCheckpointJobDeps {\n    26\t  db: Transactor;\n    27\t  checkpoint: AnchorCheckpointDeps;\n    28\t  alerting: JobAlertingDeps;\n    29\t}\n    30\t\n    31\texport async function runAnchorCheckpointJob(\n    32\t  deps: AnchorCheckpointJobDeps,\n    33\t): Promise<void> {\n    34\t  const queue = createInMemoryQueue([\n    35\t    defineAnchorCheckpointTask(deps.checkpoint),\n    36\t  ]);\n    37\t  await runAlertedFiniteJob(\n    38\t    ANCHOR_CHECKPOINT_TICK_TASK,\n    39\t    deps.alerting,\n    40\t    async () => runAnchorCheckpointTick(deps.db, queue),\n    41\t  );\n    42\t}\n    43\t\n    44\tfunction createCheckpointDeps(\n    45\t  db: Transactor,\n    46\t  env: Record<string, string | undefined>,\n    47\t): AnchorCheckpointDeps {\n    48\t  const target = (env.CAISSON_ANCHOR_TARGET?.trim() || \"tsa\").toLowerCase();\n    49\t  if (target !== \"tsa\") {\n    50\t    throw new Error(\n    51\t      \"CAISSON_ANCHOR_TARGET must be tsa until the public-log deployment gate is wired\",\n    52\t    );\n    53\t  }\n    54\t  const bucket = env.CAISSON_WORM_BUCKET?.trim() ?? \"\";\n    55\t  const tsaUrl = env.CAISSON_TSA_URL?.trim() ?? \"\";\n    56\t  if (bucket === \"\" || tsaUrl === \"\") {\n    57\t    throw new Error(\n    58\t      \"CAISSON_WORM_BUCKET and CAISSON_TSA_URL are required for the anchor-checkpoint job\",\n    59\t    );\n    60\t  }\n    61\t  const store = new S3ArtifactStore({\n    62\t    client: new S3Client({ region: env.AWS_REGION ?? \"us-east-1\" }),\n    63\t    bucket,\n    64\t  });\n    65\t  return {\n    66\t    store,\n    67\t    outbox: new AnchorOutbox(db),\n    68\t    log: new TsaAnchorLog({ url: tsaUrl }),\n    69\t    reader: new AuditChainStore({ db, store }),\n    70\t    target: { kind: \"tsa\", url: tsaUrl, grade: \"trusted-timestamped\" },\n    71\t  };\n    72\t}\n    73\t\n    74\texport async function main(\n    75\t  env: Record<string, string | undefined> = process.env,\n    76\t): Promise<void> {\n    77\t  const pool = createPgPool(requireJobDatabaseUrl(env));\n    78\t  const db = createPgTransactor(pool);\n    79\t  try {\n    80\t    await runAnchorCheckpointJob({\n    81\t      db,\n    82\t      checkpoint: createCheckpointDeps(db, env),\n    83\t      alerting: createJobAlertingDeps(loadOpsAlertChannels(env)),\n    84\t    });\n    85\t  } finally {\n    86\t    await pool.end();\n    87\t  }\n    88\t}\n    89\t\n    90\tif (import.meta.main) await main();\n","exit_code":0,"status":"completed"}}
