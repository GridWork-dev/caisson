{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba .github/workflows/publish.yml'","aggregated_output":"     1\tname: publish\n     2\t# The ADR-0325 zero-mutation publish leg: checkout EXACTLY the release tag, verify the tagged\n     3\t# tree already IS the release (every workspace version ledgered + sidecar'd, index.json a\n     4\t# byte-identical rebuild), re-pack every tarball and require byte-equality with the hashes the\n     5\t# version PR recorded, then upload to R2 — skipping any object that already exists (rerun-safe,\n     6\t# never overwrite a version-keyed object). NO step on this path mutates source: `changeset\n     7\t# version`, the ledger append, the index rebuild, and the commit-back all moved to\n     8\t# version-pr.yml (the automation-authored version PR, ADR-0325 point 1). One SHA — the tagged\n     9\t# version commit — anchors source, ledger, tarballs, and evidence.\n    10\t#\n    11\t# ORDERING (structural, not `needs:` — GitHub Actions `needs:` cannot cross workflow files):\n    12\t# this workflow only runs via workflow_dispatch (the release train's leg 1, or a manual operator\n    13\t# dispatch), and the train's readiness job has already verified ci.yml's required checks green\n    14\t# on the release SHA before dispatching. Main-only (ADR-0021); the tag must be an ancestor of\n    15\t# origin/main (verified below).\n    16\t#\n    17\t# Buyer delivery = self-hosted npm registry (registry.caisson.sh, ADR-0223). Auth: R2 writes use\n    18\t# S3-compatible scoped R2 access keys (R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_ACCOUNT_ID\n    19\t# repo secrets, bucket caisson-registry-tarballs). contents:write is GONE — this job pushes\n    20\t# nothing anywhere (the old commit-back was the ADR-0325 provenance defect).\n    21\t#\n    22\t# Everything is guarded by CAISSON_PUBLISH_DRY_RUN (default \"true\"): dry-run verifies the\n    23\t# ledger/sidecar/index consistency at the tag and logs the upload plan, writing NOTHING to R2.\n    24\t# Dispatch with dry_run=false (the train passes it) for a live publish.\n    25\t#\n    26\t# P5-25: GHEC provenance attestation = DECLINED. Lightweight provenance is already embedded in\n    27\t#        each LedgerEntry's gateAttestation field; a full SLSA/GHEC attestation blob is deferred\n    28\t#        (re-raised by the 2026-07-11 Codex audit as a possible rider — still deferred, the\n    29\t#        version-PR + tag-anchored flow closes the gap it targeted).\n    30\ton:\n    31\t  workflow_dispatch:\n    32\t    inputs:\n    33\t      tag:\n    34\t        description: \"The release tag to publish (checked out, verified, and published byte-exact)\"\n    35\t        required: true\n    36\t      dry_run:\n    37\t        description: \"Set to 'false' to run a LIVE publish (verify at the tag + upload missing tarballs to R2)\"\n    38\t        required: false\n    39\t        default: \"true\"\n    40\t\n    41\tpermissions:\n    42\t  contents: read\n    43\t\n    44\t# cancel-in-progress: false (not true) — an in-flight run uploads tarballs, so it must finish\n    45\t# rather than be killed mid-step; a second dispatch queues behind it.\n    46\tconcurrency:\n    47\t  group: publish-and-index\n    48\t  cancel-in-progress: false\n    49\t\n    50\tjobs:\n    51\t  publish-and-index:\n    52\t    if: github.ref == 'refs/heads/main'\n    53\t    # Blacksmith per ADR-0365 (fleet-only sweep; R2 write creds accepted on VM-per-job runners). Write/publish privilege belongs\n    54\t    # on a clean hosted runner, not third-party compute (ADR-0326). `aws` CLI is preinstalled.\n    55\t    runs-on: ${{ vars.CI_RUNNER_LINUX || 'ubuntu-latest' }}\n    56\t    timeout-minutes: 15\n    57\t    environment: release # ADR-0327 rider 2 (definition-first; free-plan protection rules can't enforce yet)\n    58\t    env:\n    59\t      # Operator publish gate (ADR-0069/0223). Default is dry-run; the release train dispatches\n    60\t      # with dry_run=false.\n    61\t      CAISSON_PUBLISH_DRY_RUN: ${{ github.event.inputs.dry_run || 'true' }}\n    62\t      RELEASE_TAG: ${{ github.event.inputs.tag }}\n    63\t    steps:\n    64\t      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7\n    65\t        with:\n    66\t          # Checkout EXACTLY the tagged bytes (ADR-0325 point 4). Full history so the\n    67\t          # tag-on-main ancestry check below can resolve origin/main.\n    68\t          ref: ${{ github.event.inputs.tag }}\n    69\t          fetch-depth: 0\n    70\t      # A tag not on main must never publish — the readiness gate checks this too, but a manual\n    71\t      # dispatch can reach this workflow without the train.\n    72\t      - name: verify the tag is an ancestor of origin/main\n    73\t        run: |\n    74\t          git fetch origin main --quiet\n    75\t          if ! git merge-base --is-ancestor HEAD origin/main; then\n    76\t            echo \"::error::tag ${RELEASE_TAG} ($(git rev-parse --short HEAD)) is not an ancestor of origin/main — refusing to publish\"\n    77\t            exit 1\n    78\t          fi\n    79\t          echo \"[publish-and-index] tag ${RELEASE_TAG} -> $(git rev-parse HEAD) (on main)\"\n    80\t      # Keep setup inline here: this workflow checks out the requested historical release tag, and\n    81\t      # tags predating the local composite action cannot resolve ./.github/actions/setup-bun.\n    82\t      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0\n    83\t        with:\n    84\t          bun-version: \"1.4.2\"\n    85\t      - name: cache bun install\n    86\t        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6\n    87\t        with:\n    88\t          path: ~/.bun/install/cache\n    89\t          key: ${{ runner.os }}-bun-${{ hashFiles('bun.lock') }}\n    90\t          restore-keys: ${{ runner.os }}-bun-\n    91\t      - run: bun install --frozen-lockfile\n    92\t      # Zero-mutation verify + stage (ADR-0325): every workspace version must be ledgered +\n    93\t      # sidecar'd, index.json must be a byte-identical ledger rebuild, and every re-packed\n    94\t      # tarball must hash to EXACTLY the sidecar row the version PR recorded. Any violation\n    95\t      # fails here, before the R2 step. Dry-run verifies metadata and skips packing.\n    96\t      - name: verify tagged bytes + stage tarballs (publish mode)\n    97\t        run: |\n    98\t          bun registry/scripts/ci-publish-step.ts \\\n    99\t            --mode publish \\\n   100\t            --run-id \"${{ github.run_id }}\" \\\n   101\t            --sha \"$(git rev-parse HEAD)\" \\\n   102\t            --published-at \"$(date -u '+%Y-%m-%dT%H:%M:%S.000Z')\" \\\n   103\t            --dry-run \"${CAISSON_PUBLISH_DRY_RUN}\"\n   104\t      # Upload staged tarballs to R2 — per-object head-object first: an existing version-keyed\n   105\t      # object is NEVER overwritten (ADR-0325 point 5); reruns upload only what is missing.\n   106\t      - name: upload missing tarballs to R2 (live only, never overwrite)\n   107\t        env:\n   108\t          AWS_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}\n   109\t          AWS_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}\n   110\t          R2_ACCOUNT_ID: ${{ secrets.R2_ACCOUNT_ID }}\n   111\t          R2_BUCKET: caisson-registry-tarballs\n   112\t        run: |\n   113\t          set -euo pipefail\n   114\t          STAGING=\"registry/.tarball-staging\"\n   115\t          ENDPOINT=\"https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com\"\n   116\t          if [ \"${CAISSON_PUBLISH_DRY_RUN}\" != \"false\" ]; then\n   117\t            echo \"[publish-and-index] dry-run: R2 upload skipped (CAISSON_PUBLISH_DRY_RUN=${CAISSON_PUBLISH_DRY_RUN})\"\n   118\t            exit 0\n   119\t          fi\n   120\t          # A live publish with no R2 credentials fails LOUD and self-describing — never a green\n   121\t          # no-op (that would mark a release done while buyers 404 on the tarballs).\n   122\t          if [ -z \"${AWS_ACCESS_KEY_ID}\" ] || [ -z \"${R2_ACCOUNT_ID}\" ]; then\n   123\t            echo \"::error::live publish but R2 credentials are not set (R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY/R2_ACCOUNT_ID repo secrets) — arm R2 before a live dispatch\"\n   124\t            exit 1\n   125\t          fi\n   126\t          if [ ! -d \"$STAGING\" ] || [ -z \"$(ls -A \"$STAGING\" 2>/dev/null)\" ]; then\n   127\t            echo \"[publish-and-index] no staged tarballs to upload\"\n   128\t            exit 0\n   129\t          fi\n   130\t          uploaded=0; skipped=0\n   131\t          while IFS= read -r -d '' f; do\n   132\t            key=\"${f#\"$STAGING\"/}\"\n   133\t            # Only a definite 404 may fall through to upload — any OTHER head-object failure\n   134\t            # (403, throttle, network) fails the step, since \"assume absent\" would turn a\n   135\t            # transient error into a PUT against a possibly-existing version-keyed object.\n   136\t            if head_out=\"$(aws s3api head-object --bucket \"$R2_BUCKET\" --key \"$key\" \\\n   137\t                 --endpoint-url \"$ENDPOINT\" 2>&1)\"; then\n   138\t              echo \"[publish-and-index] exists, skipping (never overwrite): $key\"\n   139\t              skipped=$((skipped + 1))\n   140\t            elif echo \"$head_out\" | grep -qE '\\(404\\)|Not Found'; then\n   141\t              # ponytail: aws s3 cp (preinstalled). If R2 rejects the default integrity headers,\n   142\t              # export AWS_REQUEST_CHECKSUM_CALCULATION=when_required — a deploy-time tune.\n   143\t              aws s3 cp \"$f\" \"s3://${R2_BUCKET}/${key}\" \\\n   144\t                --endpoint-url \"$ENDPOINT\" --no-progress\n   145\t              uploaded=$((uploaded + 1))\n   146\t            else\n   147\t              echo \"::error::head-object failed for ${key} with a non-404 error — refusing to assume absent: ${head_out}\"\n   148\t              exit 1\n   149\t            fi\n   150\t          done < <(find \"$STAGING\" -type f -name '*.tgz' -print0)\n   151\t          echo \"[publish-and-index] R2 upload complete: ${uploaded} uploaded, ${skipped} already present (tag ${RELEASE_TAG})\"\n","exit_code":0,"status":"completed"}}
