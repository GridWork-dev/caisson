{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba tools/security/image_scan_policy.py'","aggregated_output":"     1\t\"\"\"R344: retain full reports; gate only fixable HIGH/CRITICAL runtime OS rows.\"\"\"\n     2\t\n     3\timport html\n     4\timport json\n     5\timport os\n     6\tfrom pathlib import Path\n     7\timport subprocess\n     8\timport tempfile\n     9\t\n    10\t\n    11\tdef evaluate(report: dict, kind: str) -> dict:\n    12\t    if kind not in {\"runtime\", \"base\"}:\n    13\t        raise ValueError(\"unknown image policy\")\n    14\t    if report.get(\"SchemaVersion\") != 2 or not isinstance(report.get(\"Results\"), list):\n    15\t        raise ValueError(\"missing or unsupported Trivy report\")\n    16\t    metadata = report.get(\"Metadata\", {})\n    17\t    if not metadata.get(\"OS\") or not any(r.get(\"Class\") == \"os-pkgs\" for r in report[\"Results\"]):\n    18\t        raise ValueError(\"expected OS package scan; refusing empty coverage\")\n    19\t    findings = []\n    20\t    for result in report[\"Results\"]:\n    21\t        vulnerabilities = result.get(\"Vulnerabilities\") or []\n    22\t        if not isinstance(vulnerabilities, list):\n    23\t            raise ValueError(\"invalid vulnerability list\")\n    24\t        for row in vulnerabilities:\n    25\t            if not all(isinstance(row.get(key), str) and row[key] for key in\n    26\t                       [\"VulnerabilityID\", \"PkgName\", \"InstalledVersion\", \"Severity\"]):\n    27\t                raise ValueError(\"invalid vulnerability row\")\n    28\t            fixed = row.get(\"FixedVersion\", \"\")\n    29\t            if not isinstance(fixed, str) or row[\"Severity\"] not in {\n    30\t                \"UNKNOWN\", \"LOW\", \"MEDIUM\", \"HIGH\", \"CRITICAL\"\n    31\t            }:\n    32\t                raise ValueError(\"invalid severity or fixed version\")\n    33\t            findings.append({\n    34\t                \"target\": result.get(\"Target\"), \"class\": result.get(\"Class\"),\n    35\t                \"type\": result.get(\"Type\"),\n    36\t                \"id\": row[\"VulnerabilityID\"], \"package\": row[\"PkgName\"],\n    37\t                \"installed\": row[\"InstalledVersion\"], \"fixed\": fixed,\n    38\t                \"severity\": row[\"Severity\"], \"status\": row.get(\"Status\"),\n    39\t            })\n    40\t    fixable = [row for row in findings if row[\"fixed\"].strip()\n    41\t                and row[\"severity\"] in {\"HIGH\", \"CRITICAL\"}]\n    42\t    blocking = [row for row in fixable if row[\"class\"] == \"os-pkgs\"]\n    43\t    return {\"kind\": kind, \"artifact\": report.get(\"ArtifactName\"),\n    44\t            \"os\": metadata[\"OS\"], \"imageId\": metadata.get(\"ImageID\"),\n    45\t            \"fixableHighCritical\": fixable, \"fixableOSHighCritical\": blocking,\n    46\t            \"applicationFindings\": [row for row in findings if row[\"class\"] != \"os-pkgs\"],\n    47\t            \"unfixed\": [row for row in findings if not row[\"fixed\"].strip()],\n    48\t            \"findings\": findings, \"exitCode\": 1 if kind == \"runtime\" and blocking else 0}\n    49\t\n    50\t\n    51\tdef write_job_summary(summary: dict) -> None:\n    52\t    path = os.environ.get(\"GITHUB_STEP_SUMMARY\")\n    53\t    if not path:\n    54\t        return\n    55\t\n    56\t    def cell(value):\n    57\t        return html.escape(str(value or \"—\")).replace(\"|\", \"&#124;\").replace(\"\\n\", \" \").replace(\"\\r\", \" \")\n    58\t\n    59\t    lines = [f\"\\n### Image scan: {cell(summary['artifact'])}\",\n    60\t             \"Runtime policy: only fixable HIGH/CRITICAL OS rows enforce. Raw bases report only.\",\n    61\t             f\"Fixable HIGH/CRITICAL OS rows: {len(summary['fixableOSHighCritical'])}. \"\n    62\t             f\"Unfixed rows (all classes): {len(summary['unfixed'])}. Policy exit: {summary['exitCode']}.\",\n    63\t             \"\\nApplication residual — report only (all severities, including fixable rows):\",\n    64\t             \"\\n| Target | Type | ID | Package | Installed | Fixed | Severity |\",\n    65\t             \"| --- | --- | --- | --- | --- | --- | --- |\"]\n    66\t    for row in summary[\"applicationFindings\"]:\n    67\t        lines.append(\"| \" + \" | \".join(cell(row.get(key)) for key in\n    68\t                     [\"target\", \"type\", \"id\", \"package\", \"installed\", \"fixed\", \"severity\"]) + \" |\")\n    69\t    if not summary[\"applicationFindings\"]:\n    70\t        lines.append(\"\\nNo application findings in this report.\")\n    71\t    with Path(path).open(\"a\") as output:\n    72\t        output.write(\"\\n\".join(lines) + \"\\n\")\n    73\t\n    74\t\n    75\tdef scan_image(image: str, output: Path, kind: str) -> int:\n    76\t    output.parent.mkdir(parents=True, exist_ok=True)\n    77\t    # No inherited registry login/cloud/scanner settings. Local runtime scans use only\n    78\t    # the disposable runner's default Docker socket; base reads are anonymous remote.\n    79\t    with tempfile.TemporaryDirectory(prefix=\"caisson-image-scan-\") as temporary:\n    80\t        clean = Path(temporary)\n    81\t        (clean / \"config.yaml\").write_text(\"{}\\n\")\n    82\t        (clean / \"ignore\").write_text(\"\")\n    83\t        env = {\"PATH\": os.environ.get(\"PATH\", os.defpath), \"HOME\": temporary,\n    84\t               \"DOCKER_CONFIG\": str(clean / \"docker\"), \"XDG_CONFIG_HOME\": temporary,\n    85\t               \"TRIVY_CACHE_DIR\": str(clean / \"cache\")}\n    86\t        result = subprocess.run([\n    87\t            \"trivy\", \"image\", \"--image-src\", \"docker\" if kind == \"runtime\" else \"remote\",\n    88\t            \"--platform\", \"linux/amd64\", \"--config\", str(clean / \"config.yaml\"),\n    89\t            \"--ignorefile\", str(clean / \"ignore\"), \"--scanners\", \"vuln\",\n    90\t            \"--severity\", \"UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL\", \"--exit-code\", \"0\",\n    91\t            \"--timeout\", \"10m\", \"--format\", \"json\", \"--output\", str(output), image,\n    92\t        ], env=env, check=False, timeout=660)\n    93\t        if result.returncode != 0:\n    94\t            raise RuntimeError(f\"Trivy scan failed with status {result.returncode}\")\n    95\t    summary = evaluate(json.loads(output.read_text()), kind)\n    96\t    output.with_suffix(\".summary.json\").write_text(json.dumps(summary, indent=2) + \"\\n\")\n    97\t    write_job_summary(summary)\n    98\t    print(json.dumps({\"image\": image, \"kind\": kind,\n    99\t                      \"fixableHighCritical\": len(summary[\"fixableHighCritical\"]),\n   100\t                      \"fixableOSHighCritical\": len(summary[\"fixableOSHighCritical\"]),\n   101\t                      \"applicationFindings\": len(summary[\"applicationFindings\"]),\n   102\t                      \"unfixed\": len(summary[\"unfixed\"]), \"exitCode\": summary[\"exitCode\"]}), flush=True)\n   103\t    return summary[\"exitCode\"]\n","exit_code":0,"status":"completed"}}
