{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/app/demos/[[...path]]/route.ts'","aggregated_output":"     1\timport { parseDemosOrigin, proxyDemosRequest } from \"@/lib/demos-proxy\";\n     2\t\n     3\texport const runtime = \"nodejs\";\n     4\texport const dynamic = \"force-dynamic\";\n     5\t\n     6\ttype Context = { params: Promise<{ path?: string[] }> };\n     7\t\n     8\tasync function handle(\n     9\t  request: Request,\n    10\t  { params }: Context,\n    11\t): Promise<Response> {\n    12\t  const { path = [] } = await params;\n    13\t  try {\n    14\t    return await proxyDemosRequest(\n    15\t      request,\n    16\t      path,\n    17\t      parseDemosOrigin(process.env.DEMOS_ORIGIN_URL),\n    18\t    );\n    19\t  } catch {\n    20\t    return new Response(\"Demos service unavailable\", { status: 502 });\n    21\t  }\n    22\t}\n    23\t\n    24\texport const GET = handle;\n    25\texport const HEAD = handle;\n","exit_code":0,"status":"completed"}}
