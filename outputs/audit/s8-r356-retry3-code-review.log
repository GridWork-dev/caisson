{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba services/betterstack-adapter/handler.ts'","aggregated_output":"     1\t// Better Stack → Discord reshaper (CAISSON-53). Better Stack's Uptime plan alerts natively to\n     2\t// email/Slack only; this is a minimal, stateless Cloudflare Worker that receives Better Stack's\n     3\t// \"Incident\" outgoing webhook, validates + optionally authenticates it, and reshapes it into a\n     4\t// Discord embed POST — unifying uptime alerts into the same ops Discord channel as the\n     5\t// job/watcher alerting wired the same wave (packages/alerting's createDiscordChannel).\n     6\t//\n     7\t// Payload shape confirmed against Better Stack's own docs (get_code_context_exa, 2026-07-09):\n     8\t//   https://betterstack.com/docs/uptime/api/create-outgoing-webhook-integration/ (the worked\n     9\t//   `incident_change` example) + https://betterstack.com/docs/uptime/api/incidents-api-response-params/\n    10\t//   (the full attributes table). The confirmed default `incident_change` webhook body:\n    11\t//     { event?: string, data: { id, type: \"incident\",\n    12\t//         attributes: { name, url, http_method, cause, started_at, acknowledged_at, resolved_at,\n    13\t//                        response_content, response_url, screenshot_url, ...many more },\n    14\t//         relationships?: { monitor?: { data: { id } } } },\n    15\t//       comment?: {...} }  // present only when event === \"comment\"\n    16\t// The `attributes` object carries MANY more fields than this adapter reads (team_name,\n    17\t// incident_group_id, metadata, screenshot_url, ...) — the inner schema below is DELIBERATELY NOT\n    18\t// `.strict()`. A `.strict()` provider-webhook envelope has broken every real delivery before in\n    19\t// this repo (a hard-won P0 lesson — see PR #114 / knowledge memory\n    20\t// \"remediation-closeout-live-proofs\": \"never .strict() a provider webhook envelope\"). Better\n    21\t// Stack's payload evolves independent of what this adapter needs; only the outer route/response\n    22\t// contract this Worker itself owns is strict.\n    23\t//\n    24\t// Auth: Better Stack does not sign outgoing webhooks — confirmed via\n    25\t// https://betterstack.com/docs/errors/integrations/outgoing-webhooks/: \"Webhook requests are not\n    26\t// signed. Set up Basic HTTP authentication or add a custom header with a secret value and check\n    27\t// it on your server.\" This Worker expects the operator to configure a custom header\n    28\t// (`X-Betterstack-Secret: <value>`, via Better Stack's outgoing-webhook \"Headers\" advanced\n    29\t// setting) carrying the same value as `BETTERSTACK_WEBHOOK_SECRET`. FAIL CLOSED: a public\n    30\t// `workers_dev` endpoint with `BETTERSTACK_WEBHOOK_SECRET` unset rejects every request (401) —\n    31\t// there is no unauthenticated mode; local dev sets a throwaway secret.\n    32\timport { z } from \"zod\";\n    33\timport { fetchWithTimeout } from \"@caisson/kernel\";\n    34\t// The narrow `./crypto` subpath, NOT `./node`: the wide node barrel re-exports ssrf.ts and pulls\n    35\t// `node:dns/promises` (and whatever lands on it next) into this Worker's bundle, which has no CI\n    36\t// build leg to catch a builtin nodejs_compat doesn't ship. crypto.ts's graph is node:crypto only.\n    37\timport { safeEqualVariable } from \"@caisson/kernel/crypto\";\n    38\t\n    39\texport type Fetcher = typeof fetchWithTimeout;\n    40\t\n    41\tconst HEADER_NAME = \"x-betterstack-secret\";\n    42\t// The security-floor headers ride every response, including the 401 — `jsonResponse` is the sole\n    43\t// constructor for all of this Worker's return paths, so setting them here covers the surface by\n    44\t// construction. HSTS matches the sibling Worker (registry/worker/handler.ts) rather than the Node\n    45\t// services' longer max-age: both run on the same runtime behind the same edge.\n    46\tconst JSON_HEADERS = {\n    47\t  \"content-type\": \"application/json; charset=utf-8\",\n    48\t  \"x-content-type-options\": \"nosniff\",\n    49\t  \"x-frame-options\": \"DENY\",\n    50\t  \"strict-transport-security\": \"max-age=31536000; includeSubDomains\",\n    51\t};\n    52\t\n    53\tfunction jsonResponse(body: unknown, status: number): Response {\n    54\t  return new Response(JSON.stringify(body), { status, headers: JSON_HEADERS });\n    55\t}\n    56\t\n    57\t// Secret comparison is the kernel's `safeEqualVariable` (SHA-256-then-`timingSafeEqual`, the\n    58\t// variable-length-secret posture in `identity/security.md`) — the operator-set header value is\n    59\t// arbitrary length. The non-empty `secret` guard in `handleRequest` stays load-bearing:\n    60\t// `safeEqualVariable(\"\", \"\")` is true by construction.\n    61\t\n    62\t// Not `.strict()` — see the module doc. Only the fields this adapter reads are declared.\n    63\tconst IncidentAttributesSchema = z.object({\n    64\t  name: z.string().trim().min(1).max(500),\n    65\t  url: z.string().trim().min(1).max(2000).optional(),\n    66\t  http_method: z.string().trim().max(20).optional(),\n    67\t  cause: z.string().trim().max(2000).optional(),\n    68\t});\n    69\t\n    70\t// The outer envelope IS strict about the shape it requires (`data`/`data.type`), but not about\n    71\t// extra sibling keys Better Stack may add (e.g. `comment`, present only on comment events) — those\n    72\t// are simply ignored, not rejected, since a real Better Stack payload always ships more top-level\n    73\t// context than this adapter reads.\n    74\tconst IncidentWebhookBodySchema = z.object({\n    75\t  event: z.string().trim().min(1).max(50).optional(),\n    76\t  data: z.object({\n    77\t    id: z.string().trim().min(1),\n    78\t    type: z.literal(\"incident\"),\n    79\t    attributes: IncidentAttributesSchema,\n    80\t    relationships: z\n    81\t      .object({\n    82\t        monitor: z\n    83\t          .object({ data: z.object({ id: z.string().trim().min(1) }) })\n    84\t          .optional(),\n    85\t      })\n    86\t      .optional(),\n    87\t  }),\n    88\t});\n    89\texport type IncidentWebhookBody = z.infer<typeof IncidentWebhookBodySchema>;\n    90\t\n    91\tconst RESOLVED_COLOR = 0x2ecc71; // green\n    92\tconst TRIGGERED_COLOR = 0xe74c3c; // red\n    93\tconst INFO_COLOR = 0x3498db; // blue — acknowledged/reopened/comment: informational, not an outage\n    94\t\n    95\t/**\n    96\t * Better Stack's `event` field (`created`/`acknowledged`/`resolved`/`reopened`/`comment` per\n    97\t * their docs) is treated permissively (substring match, not a strict enum) — the exact literal\n    98\t * spelling isn't pinned by any example this adapter's research turned up beyond `comment`, and a\n    99\t * permissive classifier degrading to TRIGGERED on an unrecognized value is the safer default\n   100\t * direction (never silently swallowing a real incident under an unfamiliar event name).\n   101\t */\n   102\texport function classifyEvent(event: string | undefined): {\n   103\t  label: string;\n   104\t  color: number;\n   105\t} {\n   106\t  const e = (event ?? \"\").toLowerCase();\n   107\t  if (e.includes(\"resolved\"))\n   108\t    return { label: \"RESOLVED\", color: RESOLVED_COLOR };\n   109\t  if (e.includes(\"comment\")) return { label: \"COMMENT\", color: INFO_COLOR };\n   110\t  if (e.includes(\"acknowledged\"))\n   111\t    return { label: \"ACKNOWLEDGED\", color: INFO_COLOR };\n   112\t  return { label: \"TRIGGERED\", color: TRIGGERED_COLOR };\n   113\t}\n   114\t\n   115\t// Discord's hard per-embed caps (title 256, field value 1024) — the schema above allows a `name`\n   116\t// up to 500 and a `url`/`cause` up to 2000, both of which can exceed these, so a truncation-free\n   117\t// embed can 400 at Discord and silently drop the alert. Mirrors the same slice-before-send intent\n   118\t// as the sibling channel in packages/alerting/src/channels.ts (Discord description cap).\n   119\tconst DISCORD_TITLE_LIMIT = 256;\n   120\tconst DISCORD_FIELD_VALUE_LIMIT = 1024;\n   121\t\n   122\texport function toDiscordEmbed(body: IncidentWebhookBody): unknown {\n   123\t  const { attributes } = body.data;\n   124\t  const { label, color } = classifyEvent(body.event);\n   125\t  const fields: Array<{ name: string; value: string; inline: boolean }> = [];\n   126\t  if (attributes.url !== undefined) {\n   127\t    fields.push({\n   128\t      name: \"Monitor\",\n   129\t      value: attributes.url.slice(0, DISCORD_FIELD_VALUE_LIMIT),\n   130\t      inline: true,\n   131\t    });\n   132\t  }\n   133\t  if (attributes.cause !== undefined) {\n   134\t    fields.push({\n   135\t      name: \"Cause\",\n   136\t      value: attributes.cause.slice(0, DISCORD_FIELD_VALUE_LIMIT),\n   137\t      inline: true,\n   138\t    });\n   139\t  }\n   140\t  return {\n   141\t    embeds: [\n   142\t      {\n   143\t        title: `[${label}] ${attributes.name}`.slice(0, DISCORD_TITLE_LIMIT),\n   144\t        color,\n   145\t        fields,\n   146\t      },\n   147\t    ],\n   148\t  };\n   149\t}\n   150\t\n   151\texport interface Env {\n   152\t  /** The operator's Discord ops-channel webhook. Required — a 500 with no delivery attempted\n   153\t   *  while unset (never silently drop an incident). */\n   154\t  DISCORD_OPS_WEBHOOK_URL?: string;\n   155\t  /** The shared secret — see the module doc's Auth section. Required: an endpoint with no\n   156\t   *  secret configured fails closed (401) rather than accepting unauthenticated POSTs. */\n   157\t  BETTERSTACK_WEBHOOK_SECRET?: string;\n   158\t}\n   159\t\n   160\t/**\n   161\t * The route handler: `Fetcher`-injectable so tests never touch the network (mirrors this repo's\n   162\t * `services/intel` `Fetcher` DI convention). Fail-closed on a bad signature (401) or a malformed\n   163\t * body (400); the Discord destination is operator-configured (a Worker secret, not\n   164\t * buyer/attacker-supplied), so — like `services/intel/src/sinks.ts`'s tg-bridge/Linear\n   165\t * channels — this deliberately skips the buyer-facing SSRF resolve-guard `@caisson/alerting`'s\n   166\t * channels run.\n   167\t */\n   168\texport async function handleRequest(\n   169\t  request: Request,\n   170\t  env: Env,\n   171\t  fetchImpl: Fetcher = fetchWithTimeout,\n   172\t): Promise<Response> {\n   173\t  if (request.method !== \"POST\") {\n   174\t    return jsonResponse({ error: \"method_not_allowed\" }, 405);\n   175\t  }\n   176\t\n   177\t  const secret = env.BETTERSTACK_WEBHOOK_SECRET;\n   178\t  if (secret === undefined || secret.length === 0) {\n   179\t    // Fail closed: a public workers_dev endpoint with no shared secret must refuse traffic, not\n   180\t    // silently accept it — mirrors services/license/src/deploy.ts's fail-closed posture on a\n   181\t    // missing DATABASE_URL. There is no unauthenticated mode.\n   182\t    return jsonResponse({ error: \"unauthorized\" }, 401);\n   183\t  }\n   184\t  const provided = request.headers.get(HEADER_NAME) ?? \"\";\n   185\t  if (provided === \"\" || !safeEqualVariable(provided, secret)) {\n   186\t    return jsonResponse({ error: \"unauthorized\" }, 401);\n   187\t  }\n   188\t\n   189\t  let raw: unknown;\n   190\t  try {\n   191\t    raw = await request.json();\n   192\t  } catch {\n   193\t    return jsonResponse({ error: \"invalid_json\" }, 400);\n   194\t  }\n   195\t\n   196\t  const parsed = IncidentWebhookBodySchema.safeParse(raw);\n   197\t  if (!parsed.success) {\n   198\t    return jsonResponse({ error: \"unexpected_payload_shape\" }, 400);\n   199\t  }\n   200\t\n   201\t  const webhookUrl = env.DISCORD_OPS_WEBHOOK_URL;\n   202\t  if (webhookUrl === undefined || webhookUrl.length === 0) {\n   203\t    return jsonResponse({ error: \"not_configured\" }, 500);\n   204\t  }\n   205\t\n   206\t  try {\n   207\t    const res = await fetchImpl(webhookUrl, {\n   208\t      method: \"POST\",\n   209\t      headers: { \"content-type\": \"application/json\" },\n   210\t      body: JSON.stringify(toDiscordEmbed(parsed.data)),\n   211\t      // No redirect-follow: the destination is a fixed operator secret, a real Discord webhook\n   212\t      // never legitimately redirects. \"manual\" not \"error\" — workerd's fetch supports only\n   213\t      // follow/manual and THROWS on \"error\" (every delivery 502'd on the deployed Worker);\n   214\t      // a manual 3xx is !res.ok, so the fail-closed semantics are identical.\n   215\t      redirect: \"manual\",\n   216\t    });\n   217\t    if (!res.ok) {\n   218\t      return jsonResponse({ error: \"discord_delivery_failed\" }, 502);\n   219\t    }\n   220\t  } catch {\n   221\t    return jsonResponse({ error: \"discord_delivery_failed\" }, 502);\n   222\t  }\n   223\t\n   224\t  return jsonResponse({ ok: true }, 200);\n   225\t}\n   226\t\n   227\texport default {\n   228\t  fetch(request: Request, env: Env): Promise<Response> {\n   229\t    return handleRequest(request, env);\n   230\t  },\n   231\t};\n","exit_code":0,"status":"completed"}}
