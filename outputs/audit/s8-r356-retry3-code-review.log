{"type":"item.completed","item":{"id":"item_78","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/observability/src/scrub.ts'","aggregated_output":"     1\t// Span-attribute scrubbing (ADR-0117). A conservative key-based deny-list: secrets, `Authorization`,\n     2\t// cookies, tokens, `*-key` material, and a small PII key set are dropped — not partially masked —\n     3\t// before a span ever leaves the process. Key-based (not value-based) by design: it cannot tell apart\n     4\t// a legitimate numeric ID from a sensitive one, but it never lets a header/attribute NAMED like a\n     5\t// secret slip through, which is the failure mode that matters here.\n     6\t//\n     7\t// This is deliberately NOT a re-export of @caisson/kernel's `redactEvent` (ADR-0075): that function\n     8\t// redacts the `OpsEvent` envelope, a separate operational-telemetry event stream (ADR-0117); this one\n     9\t// mutates a span's flat `attributes` record in place, which is the shape `SpanProcessor#onEnd` hands\n    10\t// back. The two paths intentionally never share a write path.\n    11\timport type { Context } from \"@opentelemetry/api\";\n    12\timport type {\n    13\t  ReadableSpan,\n    14\t  Span,\n    15\t  SpanProcessor,\n    16\t} from \"@opentelemetry/sdk-trace-base\";\n    17\t// The incubating entry-point on purpose: it re-exports the stable names AND carries the\n    18\t// experimental ones (`gen_ai.*`, `session.id`, `mcp.session.id`) that instrumentation actually\n    19\t// emits today. Its constants are not semver-stable, but only their string VALUES are read here, via\n    20\t// `Object.entries` — a renamed or removed constant changes the allowlist, never the build.\n    21\timport * as semconv from \"@opentelemetry/semantic-conventions/incubating\";\n    22\t\n    23\t/**\n    24\t * The deny-list's term sources, as strings, so the union regex and its two arms below are all\n    25\t * DERIVED from one place: a term added or dropped here changes every consumer together, and no\n    26\t * hand-synchronised copy exists to drift. (An earlier revision kept three literal copies; a\n    27\t * one-term drift between them shipped green because the tests could only see the union.)\n    28\t */\n    29\tconst CREDENTIAL_TERMS =\n    30\t  \"secret|token|password|passwd|api[_-]?key|authoriz|bearer|credential|cookie|session|private[_-]?key|access[_-]?key|signing[_-]?key|encryption[_-]?key\";\n    31\tconst PII_TERMS =\n    32\t  \"(?<![a-z])ssns?|ssns?(?![a-z])|social[_-]?security|e[_.-]?mail|date[_-]?of[_-]?birth|birth[_-]?date|(?<![a-z])dobs?(?![a-z])|(?<![a-z])mrns?(?![a-z])|medical[_-]?record|phone|first[_-]?name(?![a-z])|last[_-]?name(?![a-z])|full[_-]?name(?![a-z])|(?<![a-z])patient\";\n    33\t\n    34\t/**\n    35\t * Span attribute / header KEY deny-list. Matches loosely on purpose — a key that merely LOOKS\n    36\t * sensitive is redacted rather than risk a false negative. Extend this list, don't replace it.\n    37\t *\n    38\t * Anchoring, per term: the long words (`email`, `phone`, `password`, …) are unanchored — no common\n    39\t * attribute name contains them by accident, and unanchored is what catches fused/plural/numbered\n    40\t * forms (`homephone`, `emails`, `email2`). The SHORT tokens need guards because they hide inside\n    41\t * ordinary words: `dob` in `adobe`, `mrn` in `mrna`, `ssn` in `className`/`businessName`/\n    42\t * `processName`, `patient` in `outpatient`/`impatient`, `lastName` in `lastNameserver`. Those use\n    43\t * `(?<![a-z])` / `(?![a-z])` letter-lookarounds rather than `\\b`, because `\\b` treats `_` and a\n    44\t * case change as NON-boundaries (`user_dob`, `userDob`) while a lookaround sees the space that\n    45\t * {@link splitKeyWords} inserts. `ssn` is anchored on ONE side only so `userssn`/`SSNVALUE` still\n    46\t * hit while a mid-word `ssN` does not.\n    47\t *\n    48\t * Deliberately NOT included: `address`. The sibling deep scrubber (`@caisson/kernel` `PHI_KEY`)\n    49\t * accepts `ipAddress` over-redaction as fail-safe for compliance-evidence egress; on a span it would\n    50\t * drop `net.peer.address` / `server.address` / `client.address` and blind tracing. Value-level\n    51\t * scrubbing is the right tool for an address, not a key match.\n    52\t *\n    53\t * @deprecated for direct `.test()` use — call {@link isSensitiveAttributeKey}, which normalizes the\n    54\t * key (NFKC + camelCase/snake_case word split) first. Tested raw, this regex misses `userEmail`,\n    55\t * `user_email`, and a fullwidth `ｅmail` (audit finding 19d1af0e70d0c2d7). Export kept for back-compat.\n    56\t */\n    57\texport const SENSITIVE_ATTRIBUTE_KEY = new RegExp(\n    58\t  `(?:${CREDENTIAL_TERMS}|${PII_TERMS})`,\n    59\t  \"i\",\n    60\t);\n    61\t\n    62\t/**\n    63\t * The deny-list's two arms, derived from the same term sources as the union above. They stay\n    64\t * separate because {@link isSensitiveAttributeKey} treats them differently: the PII arm is\n    65\t * unconditional; the credential arm yields to an exact OTel semantic-convention name.\n    66\t */\n    67\tconst CREDENTIAL_KEY = new RegExp(`(?:${CREDENTIAL_TERMS})`, \"i\");\n    68\tconst PII_KEY = new RegExp(`(?:${PII_TERMS})`, \"i\");\n    69\t\n    70\t/**\n    71\t * Every attribute NAME `@opentelemetry/semantic-conventions` exports (stable + incubating, ~890).\n    72\t * Read from the package, never hand-copied, so the set follows the pinned version. Exact-match\n    73\t * only: template attributes (`http.request.header.<key>`) are exported as functions, not strings,\n    74\t * so `http.request.header.authorization` is NOT a member and still redacts.\n    75\t */\n    76\tconst SEMCONV_ATTRIBUTE_NAMES: ReadonlySet<string> = new Set(\n    77\t  Object.entries(semconv as Record<string, unknown>)\n    78\t    .filter(\n    79\t      (entry): entry is [string, string] =>\n    80\t        entry[0].startsWith(\"ATTR_\") && typeof entry[1] === \"string\",\n    81\t    )\n    82\t    .map(([, name]) => name),\n    83\t);\n    84\t\n    85\t/**\n    86\t * Split camelCase/PascalCase runs and `_`/`-` separators into space-delimited words, so the\n    87\t * lookaround-guarded deny-list terms above see a real boundary. `userEmail` -> `user Email`,\n    88\t * `user_email` -> `user email`, `userDOBValue` -> `user DOB Value`. Deliberately does NOT lowercase\n    89\t * (the deny-list is already `/i`) and does NOT strip separators — stripping would re-fuse\n    90\t * `user_dob` into `userdob` and lose the boundary this exists to create.\n    91\t *\n    92\t * Both replaces are linear: single-character groups only. The acronym split MUST stay `([A-Z])`,\n    93\t * not `([A-Z]+)` — the greedy form backtracks quadratically on a long all-caps key (~850 ms at 32k\n    94\t * chars, attacker-controlled attribute names reach this from any instrumented request).\n    95\t */\n    96\tfunction splitKeyWords(key: string): string {\n    97\t  return key\n    98\t    .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n    99\t    .replace(/([A-Z])([A-Z][a-z])/g, \"$1 $2\")\n   100\t    .replace(/[_-]/g, \" \");\n   101\t}\n   102\t\n   103\t/**\n   104\t * The real key predicate: NFKC-normalizes the key (a fullwidth `ｅmail` folds to `email`), then\n   105\t * tests the deny-list against BOTH the raw key and its word-split form. Testing both is monotone —\n   106\t * it can only ever redact MORE keys than the raw regex alone, never fewer — so it cannot regress an\n   107\t * already-redacted key. The raw arm keeps terms whose own optional separator already spans the case\n   108\t * change (`api[_-]?key` matches `apiKey` directly, but would NOT match the split form `api Key`);\n   109\t * the split arm adds the lookaround-guarded PII terms. Over-redaction is the fail-safe direction\n   110\t * here, per this module's stated philosophy.\n   111\t *\n   112\t * Semantic-convention exemption: the credential terms `token` / `session` /\n   113\t * `authoriz` / `password` / `secret` also sit inside 19 real OTel attribute names —\n   114\t * `gen_ai.usage.input_tokens`, `session.id`, `mcp.session.id`, `aspnetcore.authorization.policy`,\n   115\t * … — none of which carries a credential, so redacting them blanked LLM usage and session\n   116\t * correlation on every span. A key that is an EXACT member of {@link SEMCONV_ATTRIBUTE_NAMES}\n   117\t * skips the credential arm. It never skips the PII arm: `user.email` and `user.full_name` are\n   118\t * semconv names too, and they stay redacted. Anything not an exact member — `Session.Id`, a\n   119\t * `session.token` that merely looks conventional, the `http.request.header.authorization`\n   120\t * template — goes through both arms as before.\n   121\t *\n   122\t * Known residual (accepted, no clean regex answer): a 3-letter token fused lowercase in the MIDDLE\n   123\t * of a key (`userdob`, `recdob`), and homoglyph / invisible-character spellings (Cyrillic `е`,\n   124\t * soft hyphen, ZWJ) that NFKC does not fold — an attacker names attributes only on their own\n   125\t * requests, so that bypass exfiltrates their own data. Enumerated in\n   126\t * `outputs/audit/2026-08-25-false-close-19d1af0e.md`.\n   127\t */\n   128\texport function isSensitiveAttributeKey(key: string): boolean {\n   129\t  const normalized = key.normalize(\"NFKC\");\n   130\t  const split = splitKeyWords(normalized);\n   131\t  if (PII_KEY.test(normalized) || PII_KEY.test(split)) return true;\n   132\t  if (SEMCONV_ATTRIBUTE_NAMES.has(normalized)) return false;\n   133\t  return CREDENTIAL_KEY.test(normalized) || CREDENTIAL_KEY.test(split);\n   134\t}\n   135\t\n   136\t/** A value-level backstop: a raw `Authorization: Bearer <token>` string under an unsuspicious key. */\n   137\tconst BEARER_VALUE = /^bearer\\s+\\S+/i;\n   138\t\n   139\t/** In-line (non-anchored) form of the same backstop, for raw log-line bodies. */\n   140\tconst BEARER_INLINE = /bearer\\s+\\S+/gi;\n   141\t\n   142\t/**\n   143\t * Scrub a raw log line before it leaves the process as an OTLP log record: the bearer-token\n   144\t * value backstop, applied in-line. Deliberately the same conservative philosophy as\n   145\t * `scrubAttributes` — these lines already reach the host's log drain verbatim; this is the\n   146\t * export-boundary backstop, not a PII filter.\n   147\t */\n   148\texport function scrubLogLine(line: string): string {\n   149\t  return line.replace(BEARER_INLINE, \"Bearer [REDACTED]\");\n   150\t}\n   151\t\n   152\tconst REDACTED = \"[REDACTED]\";\n   153\tconst PATH_ID_PLACEHOLDER = \":id\";\n   154\t\n   155\tconst UUID_SEGMENT =\n   156\t  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n   157\tconst EMAIL_SEGMENT = /^[^\\s@/]+@[^\\s@/]+\\.[^\\s@/]+$/;\n   158\tconst NUMERIC_SEGMENT = /^\\d+$/;\n   159\t/** Long opaque hex/base64-ish token — a bare id/secret, never a route template segment. */\n   160\tconst TOKEN_SEGMENT = /^[A-Za-z0-9+/_-]{16,}=*$/;\n   161\t\n   162\t/**\n   163\t * True for a path segment that is a dynamic/sensitive value rather than part of a static route\n   164\t * template: a UUID, an email, a pure-numeric id, or a long hex/base64-ish token.\n   165\t */\n   166\tfunction isSensitiveSegment(segment: string): boolean {\n   167\t  if (segment === \"\") return false;\n   168\t  if (UUID_SEGMENT.test(segment)) return true;\n   169\t  if (EMAIL_SEGMENT.test(segment)) return true;\n   170\t  if (NUMERIC_SEGMENT.test(segment)) return true;\n   171\t  // Requires a digit so a long static English route word (e.g. \"responsibilities\") isn't mistaken\n   172\t  // for an opaque token; a pure-letter token of 16+ chars would slip through — tighten with an\n   173\t  // entropy check if that becomes an issue in practice.\n   174\t  return TOKEN_SEGMENT.test(segment) && /\\d/.test(segment);\n   175\t}\n   176\t\n   177\t/**\n   178\t * Redact a URL pathname's dynamic segments (UUIDs, emails, numeric ids, long hex/base64-ish\n   179\t * tokens) with `:id`, leaving static route segments untouched. Pure and side-effect-free — used\n   180\t * to keep a request span's name and `http.route` attribute low-cardinality and free of raw\n   181\t * client-controlled path data (PII, secrets, arbitrary values) when no route template is known\n   182\t * at the call site.\n   183\t */\n   184\texport function scrubPath(path: string): string {\n   185\t  return path\n   186\t    .split(\"/\")\n   187\t    .map((segment) =>\n   188\t      isSensitiveSegment(segment) ? PATH_ID_PLACEHOLDER : segment,\n   189\t    )\n   190\t    .join(\"/\");\n   191\t}\n   192\t\n   193\t/**\n   194\t * Redact `attributes` IN PLACE: any key matching {@link isSensitiveAttributeKey}, or any string value\n   195\t * shaped like a raw bearer token, is replaced with `\"[REDACTED]\"`. Mutating in place (rather than\n   196\t * returning a copy) is required by the `SpanProcessor#onEnd` seam below — `ReadableSpan.attributes`\n   197\t * is the live object the next processor in the chain reads.\n   198\t */\n   199\texport function scrubAttributes(attributes: Record<string, unknown>): void {\n   200\t  for (const key of Object.keys(attributes)) {\n   201\t    if (isSensitiveAttributeKey(key)) {\n   202\t      attributes[key] = REDACTED;\n   203\t      continue;\n   204\t    }\n   205\t    const value = attributes[key];\n   206\t    if (typeof value === \"string\" && BEARER_VALUE.test(value)) {\n   207\t      attributes[key] = REDACTED;\n   208\t    }\n   209\t  }\n   210\t}\n   211\t\n   212\t/**\n   213\t * A `SpanProcessor` decorator: scrubs every span's attributes at `onEnd` — AFTER the span is\n   214\t * complete (so every attribute any instrumentation added is visible) but BEFORE it reaches the\n   215\t * wrapped processor (so a scrubbed span is the only thing ever batched/exported). `onStart` and\n   216\t * `forceFlush`/`shutdown` pass straight through.\n   217\t */\n   218\texport class ScrubbingSpanProcessor implements SpanProcessor {\n   219\t  readonly #next: SpanProcessor;\n   220\t\n   221\t  constructor(next: SpanProcessor) {\n   222\t    this.#next = next;\n   223\t  }\n   224\t\n   225\t  onStart(span: Span, parentContext: Context): void {\n   226\t    this.#next.onStart(span, parentContext);\n   227\t  }\n   228\t\n   229\t  onEnd(span: ReadableSpan): void {\n   230\t    scrubAttributes(span.attributes);\n   231\t    this.#next.onEnd(span);\n   232\t  }\n   233\t\n   234\t  forceFlush(): Promise<void> {\n   235\t    return this.#next.forceFlush();\n   236\t  }\n   237\t\n   238\t  shutdown(): Promise<void> {\n   239\t    return this.#next.shutdown();\n   240\t  }\n   241\t}\n","exit_code":0,"status":"completed"}}
