{"type":"item.completed","item":{"id":"item_115","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba deploy/smoke.ts'","aggregated_output":"     1\timport {\n     2\t  fetchWithTimeout,\n     3\t  type FetchTimeoutOptions,\n     4\t} from \"../packages/kernel/src/fetch.ts\";\n     5\timport { ORIGIN_SECRET_HEADER } from \"../packages/kernel/src/origin-gate.ts\";\n     6\timport { z } from \"zod\";\n     7\timport { reportCliError } from \"./manifest.ts\";\n     8\t\n     9\tconst REQUEST_TIMEOUT_MS = 10_000;\n    10\tconst CANARY_TAG = /^r[0-9]{1,20}$/;\n    11\tconst HEADER_VALUE = /^[^\\r\\n]+$/;\n    12\tconst ID_TOKEN = /^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/;\n    13\tconst ENCODED_ORIGIN_SECRET = /^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$/;\n    14\tconst REQUIRED_HEADERS = [\n    15\t  \"strict-transport-security\",\n    16\t  \"x-content-type-options\",\n    17\t  \"x-frame-options\",\n    18\t] as const;\n    19\t\n    20\tconst ServiceKeySchema = z.enum([\n    21\t  \"caisson-site\",\n    22\t  \"caisson-admin\",\n    23\t  \"caisson-license\",\n    24\t  \"caisson-docs\",\n    25\t  \"caisson-demos\",\n    26\t]);\n    27\tconst ServiceMapSchema = z.record(\n    28\t  z.string().min(1).max(128),\n    29\t  z.string().min(1).max(2_048),\n    30\t);\n    31\tconst SmokeConfigSchema = z\n    32\t  .object({\n    33\t    environment: z.enum([\"staging\", \"production\"]),\n    34\t    mode: z.enum([\n    35\t      \"staging\",\n    36\t      \"pre-migration\",\n    37\t      \"post-migration\",\n    38\t      \"post-deploy\",\n    39\t      \"rollback\",\n    40\t    ]),\n    41\t    canaryTag: z.string().trim().regex(CANARY_TAG).optional(),\n    42\t    canaryUrls: ServiceMapSchema.optional(),\n    43\t    originSecrets: ServiceMapSchema.optional(),\n    44\t    service: ServiceKeySchema.optional(),\n    45\t    accessClientId: z.string().min(1).max(2_048).regex(HEADER_VALUE).optional(),\n    46\t    accessClientSecret: z\n    47\t      .string()\n    48\t      .min(1)\n    49\t      .max(2_048)\n    50\t      .regex(HEADER_VALUE)\n    51\t      .optional(),\n    52\t  })\n    53\t  .strict();\n    54\t\n    55\texport type SmokeConfig = {\n    56\t  environment: string;\n    57\t  mode: string;\n    58\t  canaryTag?: string | undefined;\n    59\t  canaryUrls?: Record<string, string> | undefined;\n    60\t  originSecrets?: Record<string, string> | undefined;\n    61\t  service?: string | undefined;\n    62\t  accessClientId?: string | undefined;\n    63\t  accessClientSecret?: string | undefined;\n    64\t};\n    65\t\n    66\texport type TimedFetcher = (\n    67\t  input: string | URL | Request,\n    68\t  init?: RequestInit,\n    69\t  options?: FetchTimeoutOptions,\n    70\t) => Promise<Response>;\n    71\t\n    72\texport type IdentityTokenProvider = (audience: string) => Promise<string>;\n    73\t\n    74\ttype Environment = \"staging\" | \"production\";\n    75\ttype ServiceKey = z.infer<typeof ServiceKeySchema>;\n    76\ttype Target = {\n    77\t  key: ServiceKey;\n    78\t  origin: string;\n    79\t  healthPath: string;\n    80\t  canaryHealthPath: string;\n    81\t  originProtected: boolean;\n    82\t  accessProtected: boolean;\n    83\t};\n    84\t\n    85\tconst TARGETS: Record<Environment, Target[]> = {\n    86\t  production: [\n    87\t    {\n    88\t      key: \"caisson-site\",\n    89\t      origin: \"https://caisson.sh\",\n    90\t      healthPath: \"/healthz\",\n    91\t      canaryHealthPath: \"/healthz\",\n    92\t      originProtected: true,\n    93\t      accessProtected: false,\n    94\t    },\n    95\t    {\n    96\t      key: \"caisson-admin\",\n    97\t      origin: \"https://admin.caisson.sh\",\n    98\t      healthPath: \"/healthz\",\n    99\t      canaryHealthPath: \"/healthz\",\n   100\t      originProtected: true,\n   101\t      accessProtected: true,\n   102\t    },\n   103\t    {\n   104\t      key: \"caisson-license\",\n   105\t      origin: \"https://license.caisson.sh\",\n   106\t      healthPath: \"/health\",\n   107\t      canaryHealthPath: \"/health\",\n   108\t      originProtected: true,\n   109\t      accessProtected: false,\n   110\t    },\n   111\t    {\n   112\t      key: \"caisson-docs\",\n   113\t      origin: \"https://docs-api.caisson.sh\",\n   114\t      healthPath: \"/health\",\n   115\t      canaryHealthPath: \"/health\",\n   116\t      originProtected: true,\n   117\t      accessProtected: false,\n   118\t    },\n   119\t    // caisson-demos deliberately has no hostname. The site proxy is its only\n   120\t    // public contract and acquires the IAM identity before forwarding.\n   121\t    {\n   122\t      key: \"caisson-demos\",\n   123\t      origin: \"https://caisson.sh\",\n   124\t      healthPath: \"/demos/healthz\",\n   125\t      canaryHealthPath: \"/demos/healthz\",\n   126\t      originProtected: false,\n   127\t      accessProtected: false,\n   128\t    },\n   129\t  ],\n   130\t  staging: [\n   131\t    {\n   132\t      key: \"caisson-site\",\n   133\t      origin: \"https://caisson.gwstg.dev\",\n   134\t      healthPath: \"/healthz\",\n   135\t      canaryHealthPath: \"/healthz\",\n   136\t      originProtected: true,\n   137\t      accessProtected: true,\n   138\t    },\n   139\t    {\n   140\t      key: \"caisson-admin\",\n   141\t      origin: \"https://caisson-admin.gwstg.dev\",\n   142\t      healthPath: \"/healthz\",\n   143\t      canaryHealthPath: \"/healthz\",\n   144\t      originProtected: true,\n   145\t      accessProtected: true,\n   146\t    },\n   147\t    {\n   148\t      key: \"caisson-license\",\n   149\t      origin: \"https://caisson-license.gwstg.dev\",\n   150\t      healthPath: \"/health\",\n   151\t      canaryHealthPath: \"/health\",\n   152\t      originProtected: true,\n   153\t      accessProtected: true,\n   154\t    },\n   155\t    {\n   156\t      key: \"caisson-docs\",\n   157\t      origin: \"https://caisson-docs.gwstg.dev\",\n   158\t      healthPath: \"/health\",\n   159\t      canaryHealthPath: \"/health\",\n   160\t      originProtected: true,\n   161\t      accessProtected: true,\n   162\t    },\n   163\t    {\n   164\t      key: \"caisson-demos\",\n   165\t      origin: \"https://caisson.gwstg.dev\",\n   166\t      healthPath: \"/demos/healthz\",\n   167\t      canaryHealthPath: \"/demos/healthz\",\n   168\t      originProtected: false,\n   169\t      accessProtected: true,\n   170\t    },\n   171\t  ],\n   172\t};\n   173\t\n   174\tfunction selectedTargets(\n   175\t  environment: Environment,\n   176\t  service: ServiceKey | undefined,\n   177\t): Target[] {\n   178\t  const targets = TARGETS[environment];\n   179\t  if (!service) return targets;\n   180\t  const selected = targets.find((target) => target.key === service);\n   181\t  if (!selected) throw new Error(`unknown service ${service}`);\n   182\t  return [selected];\n   183\t}\n   184\t\n   185\tfunction isCanaryMode(mode: string): boolean {\n   186\t  return mode === \"pre-migration\" || mode === \"post-migration\";\n   187\t}\n   188\t\n   189\tfunction normalizeCanaryUrls(\n   190\t  values: Record<string, string>,\n   191\t): Record<string, string> {\n   192\t  const entries = Object.entries(values);\n   193\t  if (\n   194\t    entries.length === 0 ||\n   195\t    entries.length > ServiceKeySchema.options.length\n   196\t  ) {\n   197\t    throw new Error(\"CANARY_URLS is invalid\");\n   198\t  }\n   199\t\n   200\t  const origins = new Set<string>();\n   201\t  const normalized: Array<[string, string]> = [];\n   202\t  for (const [service, value] of entries) {\n   203\t    if (!ServiceKeySchema.safeParse(service).success) {\n   204\t      throw new Error(\"CANARY_URLS is invalid\");\n   205\t    }\n   206\t    let url: URL;\n   207\t    try {\n   208\t      url = new URL(value);\n   209\t    } catch {\n   210\t      throw new Error(\"CANARY_URLS is invalid\");\n   211\t    }\n   212\t    if (\n   213\t      url.protocol !== \"https:\" ||\n   214\t      url.username !== \"\" ||\n   215\t      url.password !== \"\" ||\n   216\t      url.port !== \"\" ||\n   217\t      url.pathname !== \"/\" ||\n   218\t      url.search !== \"\" ||\n   219\t      url.hash !== \"\" ||\n   220\t      !url.hostname.endsWith(\".run.app\") ||\n   221\t      url.hostname === \"run.app\" ||\n   222\t      origins.has(url.origin)\n   223\t    ) {\n   224\t      throw new Error(\"CANARY_URLS is invalid\");\n   225\t    }\n   226\t    origins.add(url.origin);\n   227\t    normalized.push([service, url.origin]);\n   228\t  }\n   229\t  return Object.fromEntries(normalized);\n   230\t}\n   231\t\n   232\tfunction validateOriginSecrets(\n   233\t  values: Record<string, string>,\n   234\t): Record<string, string> {\n   235\t  const entries = Object.entries(values);\n   236\t  if (entries.length > ServiceKeySchema.options.length) {\n   237\t    throw new Error(\"ORIGIN_SECRETS is invalid\");\n   238\t  }\n   239\t  for (const [service, value] of entries) {\n   240\t    if (\n   241\t      !ServiceKeySchema.safeParse(service).success ||\n   242\t      !ENCODED_ORIGIN_SECRET.test(value)\n   243\t    ) {\n   244\t      throw new Error(\"ORIGIN_SECRETS is invalid\");\n   245\t    }\n   246\t  }\n   247\t  return Object.fromEntries(entries);\n   248\t}\n   249\t\n   250\tfunction validateConfig(\n   251\t  config: SmokeConfig,\n   252\t): z.infer<typeof SmokeConfigSchema> {\n   253\t  const result = SmokeConfigSchema.safeParse(config);\n   254\t  if (!result.success) {\n   255\t    if (\n   256\t      config.environment !== \"staging\" &&\n   257\t      config.environment !== \"production\"\n   258\t    ) {\n   259\t      throw new Error(\"ENVIRONMENT must be staging or production\");\n   260\t    }\n   261\t    if (\n   262\t      config.mode !== \"staging\" &&\n   263\t      config.mode !== \"pre-migration\" &&\n   264\t      config.mode !== \"post-migration\" &&\n   265\t      config.mode !== \"post-deploy\" &&\n   266\t      config.mode !== \"rollback\"\n   267\t    ) {\n   268\t      throw new Error(\"MODE is invalid\");\n   269\t    }\n   270\t    if (config.canaryTag !== undefined && !CANARY_TAG.test(config.canaryTag)) {\n   271\t      throw new Error(\"CANARY_TAG is invalid\");\n   272\t    }\n   273\t    throw new Error(\"smoke configuration is invalid\");\n   274\t  }\n   275\t\n   276\t  const parsed = result.data;\n   277\t  const canaryMode = isCanaryMode(parsed.mode);\n   278\t  if (parsed.mode === \"staging\" && parsed.environment !== \"staging\") {\n   279\t    throw new Error(\"staging smoke requires staging\");\n   280\t  }\n   281\t  if (canaryMode && !parsed.canaryTag)\n   282\t    throw new Error(\"CANARY_TAG is required\");\n   283\t  if (canaryMode && parsed.environment !== \"production\") {\n   284\t    throw new Error(\"canary smoke requires production\");\n   285\t  }\n   286\t  if (canaryMode && !parsed.canaryUrls) {\n   287\t    throw new Error(\"CANARY_URLS is required for canary smoke\");\n   288\t  }\n   289\t  if (canaryMode && !parsed.originSecrets) {\n   290\t    throw new Error(\"ORIGIN_SECRETS is required for canary smoke\");\n   291\t  }\n   292\t  if (!canaryMode && (parsed.canaryUrls || parsed.originSecrets)) {\n   293\t    throw new Error(`canary inputs are forbidden for ${parsed.mode} smoke`);\n   294\t  }\n   295\t  if (parsed.mode === \"rollback\" && !parsed.service) {\n   296\t    throw new Error(\"SERVICE is required for rollback smoke\");\n   297\t  }\n   298\t\n   299\t  if (canaryMode) {\n   300\t    const canaryUrls = normalizeCanaryUrls(parsed.canaryUrls!);\n   301\t    const originSecrets = validateOriginSecrets(parsed.originSecrets!);\n   302\t    const targets = TARGETS.production.filter((target) =>\n   303\t      Object.hasOwn(canaryUrls, target.key),\n   304\t    );\n   305\t    for (const target of targets) {\n   306\t      if (target.originProtected && !Object.hasOwn(originSecrets, target.key)) {\n   307\t        throw new Error(`ORIGIN_SECRETS is missing ${target.key}`);\n   308\t      }\n   309\t    }\n   310\t    return { ...parsed, canaryUrls, originSecrets };\n   311\t  }\n   312\t\n   313\t  const targets = selectedTargets(parsed.environment, parsed.service);\n   314\t  if (\n   315\t    targets.some((target) => target.accessProtected) &&\n   316\t    (!parsed.accessClientId || !parsed.accessClientSecret)\n   317\t  ) {\n   318\t    throw new Error(\"Cloudflare Access service credentials are required\");\n   319\t  }\n   320\t  return parsed;\n   321\t}\n   322\t\n   323\tfunction canaryServiceAudience(\n   324\t  config: ReturnType<typeof validateConfig>,\n   325\t  target: Target,\n   326\t): string {\n   327\t  const url = new URL(config.canaryUrls![target.key]!);\n   328\t  const prefix = `${config.canaryTag!}---`;\n   329\t  if (!url.hostname.startsWith(prefix)) {\n   330\t    throw new Error(`CANARY_URLS tag does not match ${target.key}`);\n   331\t  }\n   332\t  url.hostname = url.hostname.slice(prefix.length);\n   333\t  return url.origin;\n   334\t}\n   335\t\n   336\tasync function gcloudIdentityToken(audience: string): Promise<string> {\n   337\t  const result = Bun.spawnSync([\n   338\t    \"gcloud\",\n   339\t    \"auth\",\n   340\t    \"print-identity-token\",\n   341\t    `--audiences=${audience}`,\n   342\t  ]);\n   343\t  if (result.exitCode !== 0) {\n   344\t    throw new Error(\"gcloud failed to mint the demos canary identity token\");\n   345\t  }\n   346\t  const token = new TextDecoder().decode(result.stdout).trim();\n   347\t  if (token.length > 8_192 || !ID_TOKEN.test(token)) {\n   348\t    throw new Error(\"gcloud returned an invalid demos canary identity token\");\n   349\t  }\n   350\t  return token;\n   351\t}\n   352\t\n   353\tasync function requestHeaders(\n   354\t  config: ReturnType<typeof validateConfig>,\n   355\t  target: Target,\n   356\t  identityTokenProvider: IdentityTokenProvider,\n   357\t): Promise<Headers> {\n   358\t  const headers = new Headers({ accept: \"application/json\" });\n   359\t  if (isCanaryMode(config.mode)) {\n   360\t    if (target.originProtected) {\n   361\t      headers.set(ORIGIN_SECRET_HEADER, config.originSecrets![target.key]!);\n   362\t    }\n   363\t    if (target.key === \"caisson-demos\") {\n   364\t      const token = await identityTokenProvider(\n   365\t        canaryServiceAudience(config, target),\n   366\t      );\n   367\t      if (token.length > 8_192 || !HEADER_VALUE.test(token)) {\n   368\t        throw new Error(\"demos canary identity token is invalid\");\n   369\t      }\n   370\t      headers.set(\"X-Serverless-Authorization\", `Bearer ${token}`);\n   371\t    }\n   372\t  } else if (target.accessProtected) {\n   373\t    headers.set(\"CF-Access-Client-Id\", config.accessClientId!);\n   374\t    headers.set(\"CF-Access-Client-Secret\", config.accessClientSecret!);\n   375\t  }\n   376\t  return headers;\n   377\t}\n   378\t\n   379\tfunction requestOrigin(\n   380\t  config: ReturnType<typeof validateConfig>,\n   381\t  target: Target,\n   382\t): string {\n   383\t  return isCanaryMode(config.mode)\n   384\t    ? config.canaryUrls![target.key]!\n   385\t    : target.origin;\n   386\t}\n   387\t\n   388\tfunction assertSecurityHeaders(response: Response, label: string): void {\n   389\t  for (const header of REQUIRED_HEADERS) {\n   390\t    if (!response.headers.has(header)) {\n   391\t      throw new Error(`${label} is missing ${header}`);\n   392\t    }\n   393\t  }\n   394\t  if (response.headers.has(\"x-powered-by\")) {\n   395\t    throw new Error(`${label} exposes x-powered-by`);\n   396\t  }\n   397\t}\n   398\t\n   399\tasync function getTarget(\n   400\t  config: ReturnType<typeof validateConfig>,\n   401\t  target: Target,\n   402\t  path: string,\n   403\t  label: string,\n   404\t  transport: TimedFetcher,\n   405\t  identityTokenProvider: IdentityTokenProvider,\n   406\t): Promise<void> {\n   407\t  const response = await transport(\n   408\t    `${requestOrigin(config, target)}${path}`,\n   409\t    {\n   410\t      method: \"GET\",\n   411\t      redirect: \"manual\",\n   412\t      headers: await requestHeaders(config, target, identityTokenProvider),\n   413\t    },\n   414\t    { timeoutMs: REQUEST_TIMEOUT_MS },\n   415\t  );\n   416\t  if (response.status !== 200) {\n   417\t    throw new Error(`${label} returned ${response.status}`);\n   418\t  }\n   419\t  assertSecurityHeaders(response, label);\n   420\t}\n   421\t\n   422\tasync function assertWriteBoundary(\n   423\t  config: ReturnType<typeof validateConfig>,\n   424\t  target: Target,\n   425\t  path: string,\n   426\t  body: object,\n   427\t  transport: TimedFetcher,\n   428\t  identityTokenProvider: IdentityTokenProvider,\n   429\t): Promise<void> {\n   430\t  const headers = await requestHeaders(config, target, identityTokenProvider);\n   431\t  headers.set(\"content-type\", \"application/json\");\n   432\t  const response = await transport(\n   433\t    `${requestOrigin(config, target)}${path}`,\n   434\t    {\n   435\t      method: \"POST\",\n   436\t      redirect: \"manual\",\n   437\t      headers,\n   438\t      body: JSON.stringify(body),\n   439\t    },\n   440\t    { timeoutMs: REQUEST_TIMEOUT_MS },\n   441\t  );\n   442\t  if (response.status !== 401) {\n   443\t    throw new Error(\n   444\t      `${target.key} write auth boundary returned ${response.status}`,\n   445\t    );\n   446\t  }\n   447\t  assertSecurityHeaders(response, `${target.key} write auth boundary`);\n   448\t}\n   449\t\n   450\texport async function runSmoke(\n   451\t  rawConfig: SmokeConfig,\n   452\t  transport: TimedFetcher = fetchWithTimeout,\n   453\t  identityTokenProvider: IdentityTokenProvider = gcloudIdentityToken,\n   454\t): Promise<void> {\n   455\t  const config = validateConfig(rawConfig);\n   456\t  const canaryMode = isCanaryMode(config.mode);\n   457\t  const targets = canaryMode\n   458\t    ? TARGETS.production.filter((target) =>\n   459\t        Object.hasOwn(config.canaryUrls!, target.key),\n   460\t      )\n   461\t    : selectedTargets(config.environment, config.service);\n   462\t\n   463\t  // The workflow resolves tag URLs with gcloud; this code never synthesizes one.\n   464\t  // Pre/post-migration calls the zero-traffic revision directly with its origin\n   465\t  // credential. The IAM-only demos service additionally receives a Google ID token whose\n   466\t  // audience is the untagged service URL. Post-deploy and rollback remain public Cloudflare checks.\n   467\t  for (const target of targets) {\n   468\t    await getTarget(\n   469\t      config,\n   470\t      target,\n   471\t      canaryMode ? target.canaryHealthPath : target.healthPath,\n   472\t      `${target.key} health`,\n   473\t      transport,\n   474\t      identityTokenProvider,\n   475\t    );\n   476\t    if (target.key === \"caisson-site\") {\n   477\t      await getTarget(\n   478\t        config,\n   479\t        target,\n   480\t        \"/\",\n   481\t        \"caisson-site page\",\n   482\t        transport,\n   483\t        identityTokenProvider,\n   484\t      );\n   485\t    }\n   486\t  }\n   487\t\n   488\t  if (config.mode === \"pre-migration\") return;\n   489\t\n   490\t  const license = targets.find((target) => target.key === \"caisson-license\");\n   491\t  if (license) {\n   492\t    await assertWriteBoundary(\n   493\t      config,\n   494\t      license,\n   495\t      \"/issue\",\n   496\t      {},\n   497\t      transport,\n   498\t      identityTokenProvider,\n   499\t    );\n   500\t  }\n   501\t  const docs = targets.find((target) => target.key === \"caisson-docs\");\n   502\t  if (docs) {\n   503\t    await assertWriteBoundary(\n   504\t      config,\n   505\t      docs,\n   506\t      \"/query\",\n   507\t      { query: \"deployment smoke\", k: 1 },\n   508\t      transport,\n   509\t      identityTokenProvider,\n   510\t    );\n   511\t  }\n   512\t}\n   513\t\n   514\tfunction serviceMapFromEnvironment(\n   515\t  name: \"CANARY_URLS\" | \"ORIGIN_SECRETS\",\n   516\t  value: string | undefined,\n   517\t): Record<string, string> | undefined {\n   518\t  const source = value?.trim();\n   519\t  if (!source) return undefined;\n   520\t  if (source.length > 32_768) throw new Error(`${name} is too large`);\n   521\t\n   522\t  let parsed: unknown;\n   523\t  try {\n   524\t    parsed = JSON.parse(source) as unknown;\n   525\t  } catch {\n   526\t    throw new Error(`${name} must be valid JSON`);\n   527\t  }\n   528\t  if (typeof parsed !== \"object\" || parsed === null || Array.isArray(parsed)) {\n   529\t    throw new Error(`${name} must be a JSON object`);\n   530\t  }\n   531\t  const result = ServiceMapSchema.safeParse(parsed);\n   532\t  if (!result.success) throw new Error(`${name} must map services to strings`);\n   533\t  return Object.fromEntries(Object.entries(result.data));\n   534\t}\n   535\t\n   536\texport function smokeConfigFromEnvironment(\n   537\t  environmentVariables: Record<string, string | undefined>,\n   538\t): SmokeConfig {\n   539\t  const environment = environmentVariables.ENVIRONMENT?.trim();\n   540\t  if (!environment) throw new Error(\"ENVIRONMENT is required\");\n   541\t  const mode = environmentVariables.MODE?.trim();\n   542\t  if (!mode) throw new Error(\"MODE is required\");\n   543\t\n   544\t  return {\n   545\t    environment,\n   546\t    mode,\n   547\t    canaryTag: environmentVariables.CANARY_TAG?.trim(),\n   548\t    canaryUrls: serviceMapFromEnvironment(\n   549\t      \"CANARY_URLS\",\n   550\t      environmentVariables.CANARY_URLS,\n   551\t    ),\n   552\t    originSecrets: serviceMapFromEnvironment(\n   553\t      \"ORIGIN_SECRETS\",\n   554\t      environmentVariables.ORIGIN_SECRETS,\n   555\t    ),\n   556\t    service: environmentVariables.SERVICE?.trim(),\n   557\t    accessClientId: environmentVariables.CF_ACCESS_CLIENT_ID,\n   558\t    accessClientSecret: environmentVariables.CF_ACCESS_CLIENT_SECRET,\n   559\t  };\n   560\t}\n   561\t\n   562\tasync function main(): Promise<void> {\n   563\t  const config = smokeConfigFromEnvironment(process.env);\n   564\t  await runSmoke(config);\n   565\t  process.stdout.write(\n   566\t    `smoke environment=${config.environment} mode=${config.mode} passed\\n`,\n   567\t  );\n   568\t}\n   569\t\n   570\tif (import.meta.main) main().catch(reportCliError);\n","exit_code":0,"status":"completed"}}
