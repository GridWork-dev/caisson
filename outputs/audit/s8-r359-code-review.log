{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/lib/paddle-checkout.test.ts'","aggregated_output":"     1\t// G6 (init-failure poisons checkout for the session) + G35 (cart cleared on overlay-open, not on\n     2\t// payment) over `lib/paddle-checkout.ts`. `@paddle/paddle-js` is mocked so `initializePaddle`'s\n     3\t// resolve/reject is fully controlled and its `eventCallback` is captured for direct invocation —\n     4\t// the real Paddle.js runs in the browser only. Sequential by design: `paddle-checkout.ts` is a\n     5\t// module-level singleton (memoized `paddleInstance`/`paddleInitPromise`), so this file's two\n     6\t// describe blocks run as one continuous scenario (init failure → retry → success → completed\n     7\t// event), not independent cases.\n     8\timport { describe, expect, mock, test } from \"bun:test\";\n     9\t\n    10\tlet initCalls = 0;\n    11\tlet shouldReject = false;\n    12\tlet capturedEventCallback: ((event: { name?: string }) => void) | undefined;\n    13\t\n    14\tconst fakeCheckoutOpen = mock((_opts: Record<string, unknown>) => undefined);\n    15\t\n    16\tmock.module(\"@paddle/paddle-js\", () => ({\n    17\t  CheckoutEventNames: { CHECKOUT_COMPLETED: \"checkout.completed\" },\n    18\t  initializePaddle: (opts: {\n    19\t    eventCallback?: (event: { name?: string }) => void;\n    20\t  }) => {\n    21\t    initCalls += 1;\n    22\t    capturedEventCallback = opts.eventCallback;\n    23\t    if (shouldReject) return Promise.reject(new Error(\"paddle init failed\"));\n    24\t    return Promise.resolve({\n    25\t      Checkout: {\n    26\t        open: fakeCheckoutOpen,\n    27\t        updateCheckout: mock(() => undefined),\n    28\t        updateItems: mock(() => undefined),\n    29\t        close: mock(() => undefined),\n    30\t      },\n    31\t    });\n    32\t  },\n    33\t}));\n    34\t\n    35\tprocess.env.NEXT_PUBLIC_PADDLE_CLIENT_TOKEN = \"test_token\";\n    36\t\n    37\tdescribe(\"G6 — an init failure does not poison checkout for the rest of the session\", () => {\n    38\t  test(\"a rejected initializePaddle() propagates, and the NEXT call retries fresh\", async () => {\n    39\t    const { openCheckout } = await import(\"./paddle-checkout.ts\");\n    40\t\n    41\t    shouldReject = true;\n    42\t    await expect(\n    43\t      openCheckout({ priceId: \"pri_x\", accountId: \"acct_1\" }),\n    44\t    ).rejects.toThrow(\"paddle init failed\");\n    45\t    expect(initCalls).toBe(1);\n    46\t\n    47\t    // Before the G6 fix, `paddleInitPromise` stayed memoized as the same rejected promise forever\n    48\t    // — a second call would reuse it (and reject again) instead of trying again.\n    49\t    shouldReject = false;\n    50\t    const opened = await openCheckout({\n    51\t      priceId: \"pri_x\",\n    52\t      accountId: \"acct_1\",\n    53\t    });\n    54\t    expect(opened).toBe(true);\n    55\t    expect(initCalls).toBe(2); // proves initializePaddle() ran again, not a cached dead promise\n    56\t  });\n    57\t});\n    58\t\n    59\tdescribe(\"abandoned-checkout discount fork (SPEC-abandoned-checkout-email.md, 2026-07-10 lock)\", () => {\n    60\t  test(\"a discount code is threaded into Checkout.open's discountCode option\", async () => {\n    61\t    const { openCartCheckout } = await import(\"./paddle-checkout.ts\");\n    62\t    fakeCheckoutOpen.mockClear();\n    63\t\n    64\t    await openCartCheckout([{ priceId: \"pri_x\" }], \"acct_1\", \"SAVE10\");\n    65\t\n    66\t    expect(fakeCheckoutOpen).toHaveBeenCalledTimes(1);\n    67\t    const openArgs = fakeCheckoutOpen.mock.calls[0]?.[0] as\n    68\t      | { discountCode?: string }\n    69\t      | undefined;\n    70\t    expect(openArgs?.discountCode).toBe(\"SAVE10\");\n    71\t  });\n    72\t\n    73\t  test(\"an omitted discount code is never passed as an explicit key\", async () => {\n    74\t    const { openCartCheckout } = await import(\"./paddle-checkout.ts\");\n    75\t    fakeCheckoutOpen.mockClear();\n    76\t\n    77\t    await openCartCheckout([{ priceId: \"pri_x\" }], \"acct_1\");\n    78\t\n    79\t    const openArgs = fakeCheckoutOpen.mock.calls[0]?.[0] as\n    80\t      | Record<string, unknown>\n    81\t      | undefined;\n    82\t    expect(openArgs).toBeDefined();\n    83\t    expect(\"discountCode\" in (openArgs ?? {})).toBe(false);\n    84\t  });\n    85\t});\n    86\t\n    87\tdescribe(\"G35 — the cart clears on checkout.completed, not on overlay-open\", () => {\n    88\t  test(\"onCheckoutCompleted fires only for the checkout.completed event, until unregistered\", async () => {\n    89\t    const { onCheckoutCompleted } = await import(\"./paddle-checkout.ts\");\n    90\t    expect(capturedEventCallback).toBeDefined();\n    91\t\n    92\t    let fired = 0;\n    93\t    const unregister = onCheckoutCompleted(() => {\n    94\t      fired += 1;\n    95\t    });\n    96\t\n    97\t    // A different event (e.g. the overlay merely loading) must NOT fire the listener — the exact\n    98\t    // behavior G35 fixes (the old code cleared on open, not on completion).\n    99\t    capturedEventCallback?.({ name: \"checkout.loaded\" });\n   100\t    expect(fired).toBe(0);\n   101\t\n   102\t    capturedEventCallback?.({ name: \"checkout.completed\" });\n   103\t    expect(fired).toBe(1);\n   104\t\n   105\t    unregister();\n   106\t    capturedEventCallback?.({ name: \"checkout.completed\" });\n   107\t    expect(fired).toBe(1); // unregistered — no further calls\n   108\t  });\n   109\t});\n   110\t\n   111\ttest(\"server cart opens only the validated transaction id, without overriding lines or account\", async () => {\n   112\t  const { openCartTransaction } = await import(\"./paddle-checkout.ts\");\n   113\t  fakeCheckoutOpen.mockClear();\n   114\t  const transactionId = `txn_${\"a\".repeat(26)}`;\n   115\t  expect(await openCartTransaction(transactionId)).toBe(true);\n   116\t  expect(fakeCheckoutOpen.mock.calls[0]?.[0]).toEqual({\n   117\t    transactionId,\n   118\t    settings: { showAddTaxId: true },\n   119\t  });\n   120\t  expect(await openCartTransaction(\"forged\")).toBe(false);\n   121\t  expect(fakeCheckoutOpen).toHaveBeenCalledTimes(1);\n   122\t});\n","exit_code":0,"status":"completed"}}
