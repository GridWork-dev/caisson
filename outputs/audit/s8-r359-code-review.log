{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/app/api/cart/owned/route.test.ts'","aggregated_output":"     1\t// ADR-0424 regression: real Better Auth durable cookies, optional hint independently absent.\n     2\timport { expect, test } from \"bun:test\";\n     3\timport { Database } from \"bun:sqlite\";\n     4\timport { getMigrations } from \"better-auth/db/migration\";\n     5\timport { createCaptureEmailer } from \"@caisson/email\";\n     6\timport type { Pool } from \"pg\";\n     7\timport { createAuth, SESSION_HINT_COOKIE_NAME } from \"@/lib/auth-server\";\n     8\timport { cartOwnedHandler } from \"@/lib/cart-routes\";\n     9\t\n    10\tasync function fixture() {\n    11\t  const database = new Database(\":memory:\");\n    12\t  const emailer = createCaptureEmailer();\n    13\t  const auth = await createAuth({\n    14\t    database: database as unknown as Pool,\n    15\t    secret: \"test-secret-value-at-least-32-characters-long\",\n    16\t    hmacKey: \"test-hmac-key-value-at-least-32-characters-long\",\n    17\t    emailer,\n    18\t    baseURL: \"http://localhost:3030\",\n    19\t  });\n    20\t  const { runMigrations } = await getMigrations({ ...auth.options, database });\n    21\t  await runMigrations();\n    22\t  await auth.api.signInMagicLink({\n    23\t    body: { email: \"buyer@example.com\" },\n    24\t    headers: new Headers(),\n    25\t  });\n    26\t  const url = String((emailer.sent[0]!.data as { url: string }).url);\n    27\t  const verified = await auth.handler(new Request(url));\n    28\t  const cookies = verified.headers\n    29\t    .getSetCookie()\n    30\t    .map((cookie) => cookie.split(\";\")[0]!);\n    31\t  let reads = 0;\n    32\t  const handler = cartOwnedHandler({\n    33\t    session: async (request) => {\n    34\t      const session = await auth.api.getSession({ headers: request.headers });\n    35\t      return session\n    36\t        ? { userId: session.user.id, accountId: session.user.id, role: \"owner\" }\n    37\t        : null;\n    38\t    },\n    39\t    owned: async () => {\n    40\t      reads++;\n    41\t      return new Set([\"module:field-crypto\"]);\n    42\t    },\n    43\t  });\n    44\t  const request = (values: string[]) =>\n    45\t    new Request(\"http://localhost:3030/api/cart/owned\", {\n    46\t      headers: { cookie: values.join(\"; \") },\n    47\t    });\n    48\t  return { database, handler, cookies, request, reads: () => reads };\n    49\t}\n    50\t\n    51\ttest(\"valid durable session without a hint returns owned items\", async () => {\n    52\t  const f = await fixture();\n    53\t  try {\n    54\t    const response = await f.handler(\n    55\t      f.request(\n    56\t        f.cookies.filter((c) => !c.startsWith(`${SESSION_HINT_COOKIE_NAME}=`)),\n    57\t      ),\n    58\t    );\n    59\t    expect(await response.json()).toEqual({ owned: [\"module:field-crypto\"] });\n    60\t    expect(f.reads()).toBe(1);\n    61\t    expect(response.headers.get(\"cache-control\")).toBe(\"private, no-store\");\n    62\t  } finally {\n    63\t    f.database.close();\n    64\t  }\n    65\t});\n    66\t\n    67\ttest(\"independently evicting the hint leaves a durable session ownership read intact\", async () => {\n    68\t  const f = await fixture();\n    69\t  try {\n    70\t    expect(await (await f.handler(f.request(f.cookies))).json()).toEqual({\n    71\t      owned: [\"module:field-crypto\"],\n    72\t    });\n    73\t    // Browser evicts an expired optional hint while retaining the still-valid session token.\n    74\t    const withoutHint = f.cookies.filter(\n    75\t      (c) => !c.startsWith(`${SESSION_HINT_COOKIE_NAME}=`),\n    76\t    );\n    77\t    expect(await (await f.handler(f.request(withoutHint))).json()).toEqual({\n    78\t      owned: [\"module:field-crypto\"],\n    79\t    });\n    80\t    expect(f.reads()).toBe(2);\n    81\t  } finally {\n    82\t    f.database.close();\n    83\t  }\n    84\t});\n    85\t\n    86\ttest(\"forged hint without a durable session grants no ownership\", async () => {\n    87\t  const f = await fixture();\n    88\t  try {\n    89\t    expect(\n    90\t      await (\n    91\t        await f.handler(f.request([`${SESSION_HINT_COOKIE_NAME}=1`]))\n    92\t      ).json(),\n    93\t    ).toEqual({ owned: [] });\n    94\t    expect(f.reads()).toBe(0);\n    95\t  } finally {\n    96\t    f.database.close();\n    97\t  }\n    98\t});\n    99\t\n   100\ttest(\"production owned route binds the real session and scoped entitlement reader\", async () => {\n   101\t  const source = await Bun.file(new URL(\"./route.ts\", import.meta.url)).text();\n   102\t  expect(source).toContain(\"session: getSession\");\n   103\t  expect(source).toContain(\"owned: getOwnedCartItemIdsForAccount\");\n   104\t  expect(source).not.toContain(\"SESSION_HINT_COOKIE_NAME\");\n   105\t});\n","exit_code":0,"status":"completed"}}
