{"type":"item.completed","item":{"id":"item_73","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/demos/components/poke/tool-exec-poke.test.ts'","aggregated_output":"     1\t// The tool-exec poke's checkable claims, now that it drives the REAL package through its browser\n     2\t// entry (ADR-0396) and the hand-ported mirror (tool-exec-logic.ts) is deleted:\n     3\t//\n     4\t//   1. The poke's client graph is browser-safe — a STATIC SOURCE-GRAPH WALK, never a build. A\n     5\t//      bundler does not fail on `node:child_process`, it substitutes a polyfill and exits 0.\n     6\t//   2. The poke's gate IS the package's gate: `createToolProposer` (browser entry) and\n     7\t//      `createToolExec(...).propose()` (node entry) agree on every verdict, because they are the\n     8\t//      same module — pinned here so a future re-fork of the two paths fails loudly.\n     9\t//   3. The sample allowlist is genuinely gating (default-deny + the stricter schema), and a\n    10\t//      proposal's args are always an argv array, never a concatenated shell string.\n    11\timport { join } from \"node:path\";\n    12\timport { describe, expect, test } from \"bun:test\";\n    13\timport { nodeBuiltinTaint } from \"@caisson/testing/module-graph\";\n    14\timport { NotFoundError, ValidationError } from \"@caisson/kernel\";\n    15\timport { createToolExec } from \"@caisson/tool-exec\";\n    16\t\n    17\timport {\n    18\t  SAMPLE_ALLOWED,\n    19\t  SAMPLE_ALLOWLIST,\n    20\t  SAMPLE_DENIED,\n    21\t  proposeSample,\n    22\t} from \"./tool-exec-poke\";\n    23\t\n    24\tconst WORKSPACE_ROOT = join(import.meta.dir, \"../../../..\");\n    25\tconst POKE_ENTRY = join(import.meta.dir, \"tool-exec-poke.tsx\");\n    26\t\n    27\tdescribe(\"the poke's client graph is browser-safe (static source walk, NOT a build)\", () => {\n    28\t  const walk = nodeBuiltinTaint(POKE_ENTRY, { workspaceRoot: WORKSPACE_ROOT });\n    29\t\n    30\t  test(\"no module reachable from the client entry imports a node builtin (transitive)\", () => {\n    31\t    expect(walk.offenders).toEqual([]);\n    32\t    expect(walk.unresolved).toEqual([]);\n    33\t  });\n    34\t\n    35\t  test(\"the walk really crossed into the package's browser entry, never the spawn half\", () => {\n    36\t    expect(walk.files).toContain(\"packages/tool-exec/src/browser.ts\");\n    37\t    expect(walk.files).toContain(\"packages/tool-exec/src/propose.ts\");\n    38\t    expect(walk.files).not.toContain(\"packages/tool-exec/src/tool-exec.ts\");\n    39\t  });\n    40\t\n    41\t  test(\"positive control: the package's `.` barrel DOES taint, so the walker is not blind\", () => {\n    42\t    const tainted = nodeBuiltinTaint(\n    43\t      join(WORKSPACE_ROOT, \"packages/tool-exec/src/index.ts\"),\n    44\t      { workspaceRoot: WORKSPACE_ROOT },\n    45\t    );\n    46\t    expect(tainted.offenders.some((o) => o.spec === \"node:child_process\")).toBe(\n    47\t      true,\n    48\t    );\n    49\t  });\n    50\t});\n    51\t\n    52\tdescribe(\"the poke's gate IS the package's gate\", () => {\n    53\t  // The node-entry gate, built over the SAME sample allowlist. Bun's runtime is node-like, so\n    54\t  // node:child_process resolves fine here even though it can never reach a browser bundle. No\n    55\t  // process is ever spawned: propose() is phase 1, and execute() is never called.\n    56\t  const real = createToolExec({ allowlist: SAMPLE_ALLOWLIST });\n    57\t\n    58\t  test(\"a valid browser proposal matches validated fields but cannot mint approval authority\", async () => {\n    59\t    const args = SAMPLE_ALLOWED.argv.split(\" \");\n    60\t    const verdict = proposeSample(SAMPLE_ALLOWED.name, args);\n    61\t    if (verdict.outcome !== \"proposed\") throw new Error(\"expected proposed\");\n    62\t    const approved = await real.propose(SAMPLE_ALLOWED.name, args);\n    63\t    expect(approved).toMatchObject(verdict.proposed);\n    64\t    expect(\"approvalId\" in verdict.proposed).toBe(false);\n    65\t    await expect(real.execute(verdict.proposed)).rejects.toThrow(\n    66\t      ValidationError,\n    67\t    );\n    68\t  });\n    69\t\n    70\t  test(\"reason is omitted when not supplied, matching the package\", async () => {\n    71\t    const proposed = await real.propose(SAMPLE_ALLOWED.name, [\"hi\"]);\n    72\t    expect(\"reason\" in proposed).toBe(false);\n    73\t    const verdict = proposeSample(SAMPLE_ALLOWED.name, [\"hi\"]);\n    74\t    if (verdict.outcome !== \"proposed\") throw new Error(\"expected proposed\");\n    75\t    expect(\"reason\" in verdict.proposed).toBe(false);\n    76\t  });\n    77\t\n    78\t  test(\"an unregistered name is denied with the package's own NotFoundError instance\", async () => {\n    79\t    const args = SAMPLE_DENIED.argv.split(\" \");\n    80\t    const verdict = proposeSample(SAMPLE_DENIED.name, args);\n    81\t    if (verdict.outcome !== \"denied\") throw new Error(\"expected denied\");\n    82\t    expect(verdict.error).toBeInstanceOf(NotFoundError);\n    83\t    expect(verdict.error.code).toBe(\"not_found\");\n    84\t    expect(verdict.error.httpStatus).toBe(404);\n    85\t    expect(verdict.error.details).toEqual({ command: SAMPLE_DENIED.name });\n    86\t    await expect(real.propose(SAMPLE_DENIED.name, args)).rejects.toThrow(\n    87\t      verdict.error.message,\n    88\t    );\n    89\t  });\n    90\t});\n    91\t\n    92\tdescribe(\"the sample allowlist actually gates\", () => {\n    93\t  test(\"git-status accepts only the exact argv its schema names\", () => {\n    94\t    expect(proposeSample(\"git-status\", [\"status\", \"--short\"]).outcome).toBe(\n    95\t      \"proposed\",\n    96\t    );\n    97\t    const denied = proposeSample(\"git-status\", [\"status\", \"--verbose\"]);\n    98\t    if (denied.outcome !== \"denied\") throw new Error(\"expected denied\");\n    99\t    expect(denied.error).toBeInstanceOf(ValidationError);\n   100\t    expect(denied.error.code).toBe(\"validation_error\");\n   101\t  });\n   102\t\n   103\t  test(\"a proposed call's args is always a string array, never a concatenated command\", () => {\n   104\t    const verdict = proposeSample(SAMPLE_ALLOWED.name, [\n   105\t      \"hello\",\n   106\t      \"world; rm -rf /\",\n   107\t    ]);\n   108\t    if (verdict.outcome !== \"proposed\") throw new Error(\"expected proposed\");\n   109\t    expect(Array.isArray(verdict.proposed.args)).toBe(true);\n   110\t    expect(verdict.proposed.args).toEqual([\"hello\", \"world; rm -rf /\"]);\n   111\t  });\n   112\t});\n","exit_code":0,"status":"completed"}}
