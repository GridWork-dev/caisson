{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/tool-exec/src/tool-exec.test.ts'","aggregated_output":"     1\timport { describe, expect, test } from \"bun:test\";\n     2\timport { z } from \"zod\";\n     3\timport { NotFoundError, ValidationError } from \"@caisson/kernel\";\n     4\timport {\n     5\t  createMemoryApprovalStore,\n     6\t  createToolExec,\n     7\t  type ExecFn,\n     8\t} from \"./index.ts\";\n     9\t\n    10\t/** A hermetic double: records every call and returns a canned result. No process ever spawns. */\n    11\tfunction fakeExecFn(): {\n    12\t  fn: ExecFn;\n    13\t  calls: Array<{ command: string; args: readonly string[] }>;\n    14\t} {\n    15\t  const calls: Array<{ command: string; args: readonly string[] }> = [];\n    16\t  const fn: ExecFn = async (command, args) => {\n    17\t    calls.push({ command, args });\n    18\t    return { stdout: \"hello\\n\", stderr: \"\", exitCode: 0 };\n    19\t  };\n    20\t  return { fn, calls };\n    21\t}\n    22\t\n    23\tconst echoSpec = {\n    24\t  name: \"echo\",\n    25\t  command: \"/bin/echo\",\n    26\t  argsSchema: z.array(z.string()),\n    27\t};\n    28\t\n    29\tdescribe(\"createToolExec — default-deny allowlist\", () => {\n    30\t  test(\"an unregistered command name is refused\", async () => {\n    31\t    const { fn } = fakeExecFn();\n    32\t    const toolExec = createToolExec({ allowlist: [echoSpec], execFn: fn });\n    33\t    await expect(toolExec.run(\"rm\", [\"-rf\", \"/\"])).rejects.toThrow(\n    34\t      NotFoundError,\n    35\t    );\n    36\t  });\n    37\t\n    38\t  test(\"an empty allowlist refuses everything\", async () => {\n    39\t    const { fn, calls } = fakeExecFn();\n    40\t    const toolExec = createToolExec({ allowlist: [], execFn: fn });\n    41\t    await expect(toolExec.run(\"echo\", [\"hi\"])).rejects.toThrow(NotFoundError);\n    42\t    expect(calls).toHaveLength(0);\n    43\t  });\n    44\t});\n    45\t\n    46\tdescribe(\"createToolExec — schema-validated args, no exec on failure\", () => {\n    47\t  test(\"args failing the schema are rejected BEFORE any exec\", async () => {\n    48\t    const { fn, calls } = fakeExecFn();\n    49\t    const toolExec = createToolExec({ allowlist: [echoSpec], execFn: fn });\n    50\t    // argsSchema is z.array(z.string()) — a plain object fails the shape.\n    51\t    await expect(toolExec.run(\"echo\", { not: \"an array\" })).rejects.toThrow(\n    52\t      ValidationError,\n    53\t    );\n    54\t    expect(calls).toHaveLength(0);\n    55\t  });\n    56\t});\n    57\t\n    58\tdescribe(\"createToolExec — a valid call\", () => {\n    59\t  test(\"returns a provenance record with exit code, output, resolved args\", async () => {\n    60\t    const { fn, calls } = fakeExecFn();\n    61\t    const now = () => 1_700_000_000_000;\n    62\t    const toolExec = createToolExec({\n    63\t      allowlist: [echoSpec],\n    64\t      execFn: fn,\n    65\t      now,\n    66\t    });\n    67\t    const result = await toolExec.run(\"echo\", [\"hello\", \"world\"], \"smoke\");\n    68\t\n    69\t    expect(result).toEqual({\n    70\t      command: \"/bin/echo\",\n    71\t      args: [\"hello\", \"world\"],\n    72\t      exitCode: 0,\n    73\t      stdout: \"hello\\n\",\n    74\t      stderr: \"\",\n    75\t      ok: true,\n    76\t      reason: \"smoke\",\n    77\t      at: 1_700_000_000_000,\n    78\t    });\n    79\t    // structural proof: the exec fn received (command: string, argsArray: string[]) — never a\n    80\t    // shell string. Nothing here ever builds a single concatenated command string.\n    81\t    expect(calls).toHaveLength(1);\n    82\t    expect(typeof calls[0]?.command).toBe(\"string\");\n    83\t    expect(Array.isArray(calls[0]?.args)).toBe(true);\n    84\t    expect(calls[0]?.args.every((a) => typeof a === \"string\")).toBe(true);\n    85\t  });\n    86\t\n    87\t  test(\"reason is omitted from the record when not supplied\", async () => {\n    88\t    const { fn } = fakeExecFn();\n    89\t    const toolExec = createToolExec({ allowlist: [echoSpec], execFn: fn });\n    90\t    const result = await toolExec.run(\"echo\", [\"x\"]);\n    91\t    expect(result.reason).toBeUndefined();\n    92\t    expect(\"reason\" in result).toBe(false);\n    93\t  });\n    94\t});\n    95\t\n    96\tdescribe(\"createToolExec — a non-zero exit / spawn failure\", () => {\n    97\t  test(\"a non-zero exit is captured, not thrown\", async () => {\n    98\t    const failFn: ExecFn = async () => ({\n    99\t      stdout: \"\",\n   100\t      stderr: \"boom\\n\",\n   101\t      exitCode: 2,\n   102\t    });\n   103\t    const toolExec = createToolExec({\n   104\t      allowlist: [echoSpec],\n   105\t      execFn: failFn,\n   106\t    });\n   107\t    const result = await toolExec.run(\"echo\", [\"x\"]);\n   108\t    expect(result.ok).toBe(false);\n   109\t    expect(result.exitCode).toBe(2);\n   110\t    expect(result.stderr).toBe(\"boom\\n\");\n   111\t  });\n   112\t});\n   113\t\n   114\tdescribe(\"createToolExec — real spawn (default ExecFn), a safe binary\", () => {\n   115\t  test(\"actually execs node -e and captures bounded stdout\", async () => {\n   116\t    const toolExec = createToolExec({\n   117\t      allowlist: [\n   118\t        {\n   119\t          name: \"node-eval\",\n   120\t          command: process.execPath,\n   121\t          argsSchema: z.array(z.string()),\n   122\t        },\n   123\t      ],\n   124\t    });\n   125\t    const result = await toolExec.run(\"node-eval\", [\n   126\t      \"-e\",\n   127\t      \"process.stdout.write('ok')\",\n   128\t    ]);\n   129\t    expect(result.ok).toBe(true);\n   130\t    expect(result.exitCode).toBe(0);\n   131\t    expect(result.stdout).toBe(\"ok\");\n   132\t  });\n   133\t});\n   134\t\n   135\tdescribe(\"createToolExec — env leak guard (THREAT: parent-secret inheritance), real default execFn\", () => {\n   136\t  const CANARY_KEY = \"CAISSON_LEAK_CANARY\";\n   137\t\n   138\t  test(\"with env supplied on the allowlist entry, the child does NOT see the canary and DOES see PATH\", async () => {\n   139\t    process.env[CANARY_KEY] = \"leak\";\n   140\t    try {\n   141\t      const toolExec = createToolExec({\n   142\t        allowlist: [\n   143\t          {\n   144\t            name: \"node-eval\",\n   145\t            command: process.execPath,\n   146\t            argsSchema: z.array(z.string()),\n   147\t            env: { PATH: process.env.PATH ?? \"\" },\n   148\t          },\n   149\t        ],\n   150\t      });\n   151\t      const result = await toolExec.run(\"node-eval\", [\n   152\t        \"-e\",\n   153\t        `process.stdout.write(process.env.${CANARY_KEY} ? \"leaked\" : (process.env.PATH ? \"clean\" : \"no-path\"))`,\n   154\t      ]);\n   155\t      expect(result.stdout).toBe(\"clean\");\n   156\t    } finally {\n   157\t      delete process.env[CANARY_KEY];\n   158\t    }\n   159\t  });\n   160\t\n   161\t  test(\"with no env on the allowlist entry (today's default), the child DOES see the canary — pins the inherit-everything default so a future flip shows up in CI\", async () => {\n   162\t    process.env[CANARY_KEY] = \"leak\";\n   163\t    try {\n   164\t      const toolExec = createToolExec({\n   165\t        allowlist: [\n   166\t          {\n   167\t            name: \"node-eval\",\n   168\t            command: process.execPath,\n   169\t            argsSchema: z.array(z.string()),\n   170\t          },\n   171\t        ],\n   172\t      });\n   173\t      const result = await toolExec.run(\"node-eval\", [\n   174\t        \"-e\",\n   175\t        `process.stdout.write(process.env.${CANARY_KEY} ? \"leaked\" : \"clean\")`,\n   176\t      ]);\n   177\t      expect(result.stdout).toBe(\"leaked\");\n   178\t    } finally {\n   179\t      delete process.env[CANARY_KEY];\n   180\t    }\n   181\t  });\n   182\t});\n   183\t\n   184\tdescribe(\"createToolExec — two-phase gate (ADR-0360 S3): propose() then execute()\", () => {\n   185\t  test(\"propose validates + parks without spawning; execute later runs the SAME validated argv\", async () => {\n   186\t    const { fn, calls } = fakeExecFn();\n   187\t    const toolExec = createToolExec({ allowlist: [echoSpec], execFn: fn });\n   188\t\n   189\t    const proposed = await toolExec.propose(\n   190\t      \"echo\",\n   191\t      [\"hello\", \"world\"],\n   192\t      \"smoke\",\n   193\t    );\n   194\t    expect(proposed).toMatchObject({\n   195\t      name: \"echo\",\n   196\t      command: \"/bin/echo\",\n   197\t      args: [\"hello\", \"world\"],\n   198\t      reason: \"smoke\",\n   199\t    });\n   200\t    expect(calls).toHaveLength(0); // propose never spawns\n   201\t\n   202\t    const result = await toolExec.execute(proposed);\n   203\t    expect(result).toMatchObject({\n   204\t      command: \"/bin/echo\",\n   205\t      args: [\"hello\", \"world\"],\n   206\t      ok: true,\n   207\t      reason: \"smoke\",\n   208\t    });\n   209\t    expect(calls).toHaveLength(1);\n   210\t  });\n   211\t\n   212\t  test(\"propose rejects an unregistered command BEFORE anything is parked\", async () => {\n   213\t    const { fn, calls } = fakeExecFn();\n   214\t    const toolExec = createToolExec({ allowlist: [echoSpec], execFn: fn });\n   215\t    await expect(toolExec.propose(\"rm\", [\"-rf\", \"/\"])).rejects.toThrow(\n   216\t      NotFoundError,\n   217\t    );\n   218\t    expect(calls).toHaveLength(0);\n   219\t  });\n   220\t\n   221\t  test(\"propose rejects args failing the schema, BEFORE anything is parked\", async () => {\n   222\t    const { fn, calls } = fakeExecFn();\n   223\t    const toolExec = createToolExec({ allowlist: [echoSpec], execFn: fn });\n   224\t    await expect(toolExec.propose(\"echo\", { not: \"an array\" })).rejects.toThrow(\n   225\t      ValidationError,\n   226\t    );\n   227\t    expect(calls).toHaveLength(0);\n   228\t  });\n   229\t\n   230\t  test(\"execute rejects a hand-built proposal without a stored approval\", async () => {\n   231\t    const { fn, calls } = fakeExecFn();\n   232\t    const toolExec = createToolExec({ allowlist: [echoSpec], execFn: fn });\n   233\t    await expect(\n   234\t      toolExec.execute({\n   235\t        name: \"echo\",\n   236\t        command: \"/bin/echo\",\n   237\t        args: [\"already\", \"validated\"],\n   238\t      }),\n   239\t    ).rejects.toThrow(ValidationError);\n   240\t    expect(calls).toHaveLength(0);\n   241\t  });\n   242\t\n   243\t  test(\"execute refuses a proposal whose command no longer matches the allowlist (drift defense)\", async () => {\n   244\t    const { fn, calls } = fakeExecFn();\n   245\t    const spec = { ...echoSpec };\n   246\t    const toolExec = createToolExec({ allowlist: [spec], execFn: fn });\n   247\t    const proposed = await toolExec.propose(\"echo\", [\"hi\"]);\n   248\t    spec.command = \"/bin/other\";\n   249\t    await expect(toolExec.execute(proposed)).rejects.toThrow(NotFoundError);\n   250\t    expect(calls).toHaveLength(0);\n   251\t  });\n   252\t\n   253\t  test(\"execute refuses a proposal for a name removed from the allowlist since propose\", async () => {\n   254\t    const { fn, calls } = fakeExecFn();\n   255\t    const approvalStore = createMemoryApprovalStore();\n   256\t    const issuer = createToolExec({\n   257\t      allowlist: [echoSpec],\n   258\t      execFn: fn,\n   259\t      approvalStore,\n   260\t    });\n   261\t    const proposed = await issuer.propose(\"echo\", [\"x\"]);\n   262\t    const toolExec = createToolExec({\n   263\t      allowlist: [],\n   264\t      execFn: fn,\n   265\t      approvalStore,\n   266\t    });\n   267\t    await expect(toolExec.execute(proposed)).rejects.toThrow(NotFoundError);\n   268\t    expect(calls).toHaveLength(0);\n   269\t  });\n   270\t\n   271\t  test(\"the existing single-phase run() path is untouched by the two-phase addition\", async () => {\n   272\t    const { fn, calls } = fakeExecFn();\n   273\t    const toolExec = createToolExec({ allowlist: [echoSpec], execFn: fn });\n   274\t    const result = await toolExec.run(\"echo\", [\"still\", \"works\"]);\n   275\t    expect(result.ok).toBe(true);\n   276\t    expect(calls).toHaveLength(1);\n   277\t  });\n   278\t});\n   279\t\n   280\tdescribe(\"ADR-0423 — stored approval integrity\", () => {\n   281\t  test(\"mutated approved arguments never spawn\", async () => {\n   282\t    const { fn, calls } = fakeExecFn();\n   283\t    const gate = createToolExec({ allowlist: [echoSpec], execFn: fn });\n   284\t    const proposal = await gate.propose(\"echo\", [\"approved\"]);\n   285\t    await expect(\n   286\t      gate.execute({ ...proposal, args: [\"changed\"] }),\n   287\t    ).rejects.toThrow(ValidationError);\n   288\t    expect(calls).toHaveLength(0);\n   289\t  });\n   290\t\n   291\t  test(\"forged IDs, digests, reasons and policy versions are rejected\", async () => {\n   292\t    const { fn, calls } = fakeExecFn();\n   293\t    const gate = createToolExec({ allowlist: [echoSpec], execFn: fn });\n   294\t    for (const patch of [\n   295\t      { approvalId: crypto.randomUUID() },\n   296\t      { digest: \"0\".repeat(64) },\n   297\t      { reason: \"not approved\" },\n   298\t      { policyVersion: \"forged\" },\n   299\t    ]) {\n   300\t      const proposal = await gate.propose(\"echo\", [\"approved\"], \"reason\");\n   301\t      await expect(gate.execute({ ...proposal, ...patch })).rejects.toThrow();\n   302\t    }\n   303\t    expect(calls).toHaveLength(0);\n   304\t  });\n   305\t\n   306\t  test(\"altered proposal environment is rejected and current spec owns child env\", async () => {\n   307\t    const seen: unknown[] = [];\n   308\t    const gate = createToolExec({\n   309\t      allowlist: [{ ...echoSpec, env: { PATH: \"/safe/bin\" } }],\n   310\t      execFn: async (_command, _args, opts) => {\n   311\t        seen.push(opts.env);\n   312\t        return { stdout: \"\", stderr: \"\", exitCode: 0 };\n   313\t      },\n   314\t    });\n   315\t    const proposal = await gate.propose(\"echo\", [\"approved\"]);\n   316\t    expect(\"env\" in proposal).toBe(false);\n   317\t    await expect(\n   318\t      gate.execute({ ...proposal, env: { PATH: \"/hostile/bin\" } }),\n   319\t    ).rejects.toThrow(ValidationError);\n   320\t    expect(seen).toEqual([]);\n   321\t    await gate.execute(proposal);\n   322\t    expect(seen).toEqual([{ PATH: \"/safe/bin\" }]);\n   323\t  });\n   324\t\n   325\t  test(\"environment and policy-version rotation invalidate outstanding approvals\", async () => {\n   326\t    const { fn, calls } = fakeExecFn();\n   327\t    const spec = {\n   328\t      ...echoSpec,\n   329\t      env: { PATH: \"/old/bin\" },\n   330\t      policyVersion: \"v1\",\n   331\t    };\n   332\t    const gate = createToolExec({ allowlist: [spec], execFn: fn });\n   333\t    const oldEnv = await gate.propose(\"echo\", [\"approved\"]);\n   334\t    spec.env.PATH = \"/new/bin\";\n   335\t    await expect(gate.execute(oldEnv)).rejects.toThrow(NotFoundError);\n   336\t    const oldVersion = await gate.propose(\"echo\", [\"approved\"]);\n   337\t    spec.policyVersion = \"v2\";\n   338\t    await expect(gate.execute(oldVersion)).rejects.toThrow(NotFoundError);\n   339\t    expect(calls).toHaveLength(0);\n   340\t  });\n   341\t\n   342\t  test(\"current schema revalidates saved original input, including object-to-argv transforms\", async () => {\n   343\t    const { fn, calls } = fakeExecFn();\n   344\t    let allowed = true;\n   345\t    const spec = {\n   346\t      ...echoSpec,\n   347\t      argsSchema: z\n   348\t        .object({ text: z.string() })\n   349\t        .strict()\n   350\t        .refine(() => allowed, \"policy narrowed\")\n   351\t        .transform(({ text }) => [text]),\n   352\t    };\n   353\t    const gate = createToolExec({ allowlist: [spec], execFn: fn });\n   354\t    const input = { text: \"approved\" };\n   355\t    const first = await gate.propose(\"echo\", input);\n   356\t    input.text = \"caller mutated original\";\n   357\t    await gate.execute(first);\n   358\t    expect(calls[0]?.args).toEqual([\"approved\"]);\n   359\t    const second = await gate.propose(\"echo\", { text: \"another\" });\n   360\t    allowed = false;\n   361\t    await expect(gate.execute(second)).rejects.toThrow(ValidationError);\n   362\t    expect(calls).toHaveLength(1);\n   363\t  });\n   364\t\n   365\t  test(\"a changed schema transform cannot alter the approved argv\", async () => {\n   366\t    const { fn, calls } = fakeExecFn();\n   367\t    let suffix = \"old\";\n   368\t    const gate = createToolExec({\n   369\t      allowlist: [\n   370\t        {\n   371\t          ...echoSpec,\n   372\t          argsSchema: z\n   373\t            .array(z.string())\n   374\t            .transform((args) => [...args, suffix]),\n   375\t        },\n   376\t      ],\n   377\t      execFn: fn,\n   378\t    });\n   379\t    const proposal = await gate.propose(\"echo\", [\"approved\"]);\n   380\t    suffix = \"new\";\n   381\t    await expect(gate.execute(proposal)).rejects.toThrow(ValidationError);\n   382\t    expect(calls).toHaveLength(0);\n   383\t  });\n   384\t\n   385\t  test(\"atomic consumption prevents replay and concurrent double execution\", async () => {\n   386\t    const { fn, calls } = fakeExecFn();\n   387\t    const gate = createToolExec({ allowlist: [echoSpec], execFn: fn });\n   388\t    const proposal = JSON.parse(\n   389\t      JSON.stringify(await gate.propose(\"echo\", [\"approved\"])),\n   390\t    ) as unknown;\n   391\t    const results = await Promise.allSettled([\n   392\t      gate.execute(proposal),\n   393\t      gate.execute(proposal),\n   394\t    ]);\n   395\t    expect(results.map((r) => r.status).sort()).toEqual([\n   396\t      \"fulfilled\",\n   397\t      \"rejected\",\n   398\t    ]);\n   399\t    expect(calls).toHaveLength(1);\n   400\t    await expect(gate.execute(proposal)).rejects.toThrow(NotFoundError);\n   401\t  });\n   402\t});\n","exit_code":0,"status":"completed"}}
