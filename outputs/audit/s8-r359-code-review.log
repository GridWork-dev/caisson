{"type":"item.completed","item":{"id":"item_77","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/lib/auth-account.test.ts'","aggregated_output":"     1\t// D4 (ADR-0176): getSession resolves the tenant accountId via account_member. With no membership\n     2\t// row a fresh signed-in user gets a personal account (accountId == userId) created idempotently on\n     3\t// first resolve — the path every existing single-user tenant takes. better-auth is mocked to a\n     4\t// fixed session; the DB is the PGlite double (DATABASE_URL unset), which now bootstraps the\n     5\t// account_member table (lib/db.ts). A separate file from auth.test.ts because the auth-server mock\n     6\t// here is the opposite of that file's \"unavailable runtime\" setup.\n     7\timport { expect, mock, test } from \"bun:test\";\n     8\timport * as realAuthServer from \"./auth-server.ts\";\n     9\t\n    10\tconst USER_ID = \"user_d4_test\";\n    11\t\n    12\t// The active-account cookie (G8) — no cookie set in these tests unless a case overrides this mock,\n    13\t// so `requestedAccountId` resolves to `undefined` and every test below keeps its pre-G8 behavior.\n    14\tlet activeAccountCookie: string | undefined;\n    15\t\n    16\tmock.module(\"next/headers\", () => ({\n    17\t  headers: async (): Promise<Headers> => new Headers(),\n    18\t  cookies: async () => ({\n    19\t    get: (name: string) =>\n    20\t      name === \"cs_active_account\" && activeAccountCookie !== undefined\n    21\t        ? { name, value: activeAccountCookie }\n    22\t        : undefined,\n    23\t  }),\n    24\t}));\n    25\t\n    26\t// `mock.module` is process-wide and never torn down, so this factory MUST return the module's\n    27\t// full export surface — a partial `{ SESSION_COOKIE_NAME, getAuth }` object gutted `createAuth`/\n    28\t// `SESSION_HINT_COOKIE_NAME` for every later-loaded file (auth-server.test.ts's static import\n    29\t// then throws \"Export named ... not found\"; file order is machine-dependent, so it only broke on\n    30\t// CI). Spread the real module and override only `getAuth`. If a sibling's mock loaded first,\n    31\t// `realAuthServer` IS that mock — safe, because every mocker of this module spreads the same way.\n    32\tmock.module(\"./auth-server.ts\", () => ({\n    33\t  ...realAuthServer,\n    34\t  getAuth: () => ({\n    35\t    api: {\n    36\t      getSession: async (): Promise<{ user: { id: string } }> => ({\n    37\t        user: { id: USER_ID },\n    38\t      }),\n    39\t    },\n    40\t  }),\n    41\t}));\n    42\t\n    43\ttest(\"getSession resolves a fresh user to their personal account (accountId == userId)\", async () => {\n    44\t  delete process.env.DATABASE_URL; // PGlite double — bootstraps account_member\n    45\t\n    46\t  const { getSession } = await import(\"./auth.ts\");\n    47\t  const session = await getSession();\n    48\t\n    49\t  expect(session).not.toBeNull();\n    50\t  expect(session?.userId).toBe(USER_ID);\n    51\t  expect(session?.accountId).toBe(USER_ID); // personal-default via ensurePersonalAccount\n    52\t  expect(session?.role).toBe(\"owner\");\n    53\t});\n    54\t\n    55\ttest(\"G8: the active-account cookie switches an invited seat to the org account\", async () => {\n    56\t  delete process.env.DATABASE_URL;\n    57\t  const { ensurePersonalAccount } = await import(\"@caisson/auth\");\n    58\t  const { addAccountMember } = await import(\"@caisson/org-controls\");\n    59\t  const { getDb } = await import(\"./db.ts\");\n    60\t  const { getSession } = await import(\"./auth.ts\");\n    61\t\n    62\t  const ORG_ACCOUNT_ID = \"org_owner_g8\";\n    63\t  const db = await getDb();\n    64\t  await ensurePersonalAccount(db, ORG_ACCOUNT_ID);\n    65\t  await addAccountMember(db, \"owner\", ORG_ACCOUNT_ID, USER_ID, \"seat\");\n    66\t\n    67\t  activeAccountCookie = ORG_ACCOUNT_ID;\n    68\t  try {\n    69\t    const session = await getSession();\n    70\t    expect(session?.accountId).toBe(ORG_ACCOUNT_ID);\n    71\t    expect(session?.role).toBe(\"seat\");\n    72\t  } finally {\n    73\t    activeAccountCookie = undefined;\n    74\t  }\n    75\t});\n    76\t\n    77\ttest(\"G8: a cookie naming an account the user does NOT belong to falls back to personal\", async () => {\n    78\t  delete process.env.DATABASE_URL;\n    79\t  const { getSession } = await import(\"./auth.ts\");\n    80\t\n    81\t  activeAccountCookie = \"some_other_account_never_joined\";\n    82\t  try {\n    83\t    const session = await getSession();\n    84\t    expect(session?.accountId).toBe(USER_ID); // fell back — never crossed tenants\n    85\t  } finally {\n    86\t    activeAccountCookie = undefined;\n    87\t  }\n    88\t});\n    89\t\n    90\ttest(\"G16: getOwnedCartItemIds maps an active entitlement grant to its catalog cart id\", async () => {\n    91\t  delete process.env.DATABASE_URL;\n    92\t  const { getDb } = await import(\"./db.ts\");\n    93\t  const { getOwnedCartItemIds } = await import(\"./owned-cart-items.ts\");\n    94\t\n    95\t  // USER_ID's personal account (bootstrapped by the first test above) owns field-crypto — seeded\n    96\t  // directly (bypasses RLS, same pattern as members-gate.test.ts's seedGrant) since this is a\n    97\t  // fixture write, not the code path under test.\n    98\t  const db = await getDb();\n    99\t  await db.transaction((tx) =>\n   100\t    tx.exec(\n   101\t      `INSERT INTO entitlement_grant\n   102\t         (id, account_id, entitlement_id, source_kind, purchase_id, source_event_id, status)\n   103\t       VALUES\n   104\t         ('grant_g16_test', '${USER_ID}', 'field-crypto', 'one_time', 'pi_g16', 'evt_g16', 'active')\n   105\t       ON CONFLICT (id) DO NOTHING`,\n   106\t    ),\n   107\t  );\n   108\t\n   109\t  const owned = await getOwnedCartItemIds();\n   110\t  expect(owned.has(\"module:field-crypto\")).toBe(true);\n   111\t  expect(owned.has(\"module:audit-worm\")).toBe(false); // not granted — stays un-owned\n   112\t});\n","exit_code":0,"status":"completed"}}
