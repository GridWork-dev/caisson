{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/lib/cart-routes.test.ts'","aggregated_output":"     1\timport { expect, test } from \"bun:test\";\n     2\timport {\n     3\t  cartCheckoutHandler,\n     4\t  type CartRouteDependencies,\n     5\t} from \"./cart-routes.ts\";\n     6\timport { MODULE_CATALOG } from \"./catalog.ts\";\n     7\t\n     8\tconst ownedItem = MODULE_CATALOG[0]!;\n     9\tconst newItem = MODULE_CATALOG[1]!;\n    10\tconst transactionId = `txn_${\"a\".repeat(26)}`;\n    11\tfunction fixture(overrides: Partial<CartRouteDependencies> = {}) {\n    12\t  const calls: Parameters<CartRouteDependencies[\"createTransaction\"]>[0][] = [];\n    13\t  const accounts: string[] = [];\n    14\t  const handler = cartCheckoutHandler({\n    15\t    session: async () => ({\n    16\t      accountId: \"verified-account\",\n    17\t      userId: \"buyer\",\n    18\t      role: \"owner\",\n    19\t    }),\n    20\t    owned: async (id) => {\n    21\t      accounts.push(id);\n    22\t      return new Set([ownedItem.id]);\n    23\t    },\n    24\t    createTransaction: async (input) => {\n    25\t      calls.push(input);\n    26\t      return transactionId;\n    27\t    },\n    28\t    ...overrides,\n    29\t  });\n    30\t  return { handler, calls, accounts };\n    31\t}\n    32\tconst request = (body: unknown, origin = \"https://caisson.sh\") =>\n    33\t  new Request(\"https://caisson.sh/api/cart/checkout\", {\n    34\t    method: \"POST\",\n    35\t    headers: { origin, \"content-type\": \"application/json\" },\n    36\t    body: JSON.stringify(body),\n    37\t  });\n    38\t\n    39\ttest(\"already-owned checkout lines are dropped before Paddle receives current catalog prices\", async () => {\n    40\t  const f = fixture();\n    41\t  const response = await f.handler(\n    42\t    request({\n    43\t      itemIds: [ownedItem.id, newItem.id, newItem.id],\n    44\t      promoCode: \"SAVE10\",\n    45\t    }),\n    46\t  );\n    47\t  expect(response.status).toBe(200);\n    48\t  expect(await response.json()).toEqual({\n    49\t    transactionId,\n    50\t    removed: [ownedItem.id],\n    51\t  });\n    52\t  expect(f.accounts).toEqual([\"verified-account\"]);\n    53\t  expect(f.calls).toEqual([\n    54\t    {\n    55\t      accountId: \"verified-account\",\n    56\t      priceIds: [newItem.priceId],\n    57\t      promoCode: \"SAVE10\",\n    58\t    },\n    59\t  ]);\n    60\t});\n    61\t\n    62\ttest(\"an all-owned cart never reaches Paddle\", async () => {\n    63\t  const f = fixture();\n    64\t  expect((await f.handler(request({ itemIds: [ownedItem.id] }))).status).toBe(\n    65\t    409,\n    66\t  );\n    67\t  expect(f.calls).toEqual([]);\n    68\t});\n    69\t\n    70\ttest(\"forged hint without a session cannot create checkout\", async () => {\n    71\t  const f = fixture({ session: async () => null });\n    72\t  const req = request({ itemIds: [newItem.id] });\n    73\t  req.headers.set(\"cookie\", \"caisson_sess_hint=1\");\n    74\t  expect((await f.handler(req)).status).toBe(401);\n    75\t  expect(f.calls).toEqual([]);\n    76\t  expect(f.accounts).toEqual([]);\n    77\t});\n    78\t\n    79\ttest(\"client account, price and quantity injection and unknown catalog items fail before Paddle\", async () => {\n    80\t  const f = fixture();\n    81\t  for (const body of [\n    82\t    { itemIds: [newItem.id], accountId: \"other\" },\n    83\t    { itemIds: [newItem.id], priceIds: [ownedItem.priceId] },\n    84\t    { itemIds: [newItem.id], quantity: 2 },\n    85\t    { itemIds: [\"module:unknown\"] },\n    86\t    { itemIds: [] },\n    87\t    { itemIds: [newItem.id], promoCode: \"bad&query\" },\n    88\t  ])\n    89\t    expect((await f.handler(request(body))).status).toBe(400);\n    90\t  expect(f.calls).toEqual([]);\n    91\t});\n    92\t\n    93\ttest(\"failed entitlement read blocks transaction creation\", async () => {\n    94\t  const f = fixture({\n    95\t    owned: async () => {\n    96\t      throw new Error(\"DB unavailable\");\n    97\t    },\n    98\t  });\n    99\t  expect((await f.handler(request({ itemIds: [newItem.id] }))).status).toBe(\n   100\t    503,\n   101\t  );\n   102\t  expect(f.calls).toEqual([]);\n   103\t});\n   104\t\n   105\ttest(\"cross-origin checkout is rejected before session or payment work\", async () => {\n   106\t  const f = fixture({\n   107\t    session: async () => {\n   108\t      throw new Error(\"must not read\");\n   109\t    },\n   110\t  });\n   111\t  expect(\n   112\t    (\n   113\t      await f.handler(\n   114\t        request({ itemIds: [newItem.id] }, \"https://attacker.example\"),\n   115\t      )\n   116\t    ).status,\n   117\t  ).toBe(403);\n   118\t  expect(f.calls).toEqual([]);\n   119\t});\n   120\t\n   121\ttest(\"production checkout route binds session, scoped ownership and server transaction creation\", async () => {\n   122\t  const source = await Bun.file(\n   123\t    new URL(\"../app/api/cart/checkout/route.ts\", import.meta.url),\n   124\t  ).text();\n   125\t  for (const binding of [\n   126\t    \"session: getSession\",\n   127\t    \"owned: getOwnedCartItemIdsForAccount\",\n   128\t    \"createTransaction: createPaddleCartTransaction\",\n   129\t  ])\n   130\t    expect(source).toContain(binding);\n   131\t  const panel = await Bun.file(\n   132\t    new URL(\"../components/cart-checkout-panel.tsx\", import.meta.url),\n   133\t  ).text();\n   134\t  expect(panel).toContain('\"/api/cart/checkout\"');\n   135\t  expect(panel).toContain(\"openCartTransaction(parsed.data.transactionId)\");\n   136\t  expect(panel).not.toContain(\"openCartCheckout(\");\n   137\t});\n","exit_code":0,"status":"completed"}}
