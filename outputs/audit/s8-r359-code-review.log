{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba knowledge/decisions/ADR-0423-bind-tool-approvals-to-private-records.md'","aggregated_output":"     1\t# ADR-0423 — Bind tool approvals to private records\n     2\t\n     3\t- Date: 2026-09-16\n     4\t- Status: Accepted — operator R359 / EST-ASK-317\n     5\t- Scope: `@caisson/tool-exec` two-phase approval execution\n     6\t- Supersedes: ADR-0360 S3 acceptance of caller-owned validated proposals\n     7\t\n     8\t## Context\n     9\t\n    10\tCR-01 demonstrated that a serialized caller-owned proposal could alter validated argv\n    11\tor child environment before execution. A command-name check alone did not bind approval\n    12\tto the action that was originally validated.\n    13\t\n    14\t## Decision\n    15\t\n    16\tThe server creates a private immutable record and a public strict `ToolApproval` envelope.\n    17\tIts SHA-256 digest uses a fixed JSON tuple of approval ID, name, executable, validated argv,\n    18\treason (explicit null when absent), and policy version. Execution atomically consumes the\n    19\trecord once and compares both the claimed and recomputed digest in constant time. It\n    20\trevalidates saved original input against the current CommandSpec and requires identical\n    21\tvalidated argv. Command, explicit environment and policy-version changes invalidate the\n    22\trecord. Environment is copied solely from the current spec, never from the public proposal.\n    23\t\n    24\tThe default bounded in-memory store snapshots records. An injected durable store must\n    25\tremain server-private, enforce create-only IDs and atomically consume records. The caller\n    26\tmust authenticate and authorize the approving actor before invoking execute; neither the\n    27\tdigest nor possession of an ID is a replacement for application authorization. Pure browser\n    28\tvalidation continues to return ProposedToolCall, which carries no execution authority.\n    29\t\n    30\t## Consequences\n    31\t\n    32\tTwo-phase callers must retain the server record (or provide a durable adapter); hand-built\n    33\tand old serialized proposals fail closed. Replayed, modified and rotated approvals require\n    34\ta fresh proposal. Run remains single-phase. The inherited environment default of ADR-0420\n    35\tis unchanged; callers needing isolation still set an explicit spec environment. There is no\n    36\tapproval-expiry policy in this lock; the default store bounds pending record count to 1,000.\n    37\t\n    38\tTests cover input mutation, forged fields, environment injection, policy rotation, current\n    39\tschema transformations, replay and concurrent consumption. Guard-removal mutations and\n    40\tbyte-identical restoration are recorded in the S8 RUN-NOTES.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/tool-exec/src/approval.ts'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/tool-exec/src/approval.ts'","aggregated_output":"     1\t// ADR-0423: server-owned records bind an external approval round-trip to immutable input.\n     2\t// A digest is not authentication of an untrusted store: adapters must keep this store private.\n     3\timport { createHash, timingSafeEqual } from \"node:crypto\";\n     4\timport { z } from \"zod\";\n     5\timport type { CommandSpec } from \"./propose.ts\";\n     6\t\n     7\texport const toolApprovalSchema = z\n     8\t  .object({\n     9\t    approvalId: z.uuid(),\n    10\t    digest: z.string().regex(/^[a-f0-9]{64}$/),\n    11\t    policyVersion: z.string().min(1).max(200),\n    12\t    name: z.string().min(1).max(256),\n    13\t    command: z.string().min(1).max(4096),\n    14\t    args: z.array(z.string().max(32768)).max(256),\n    15\t    reason: z.string().max(4000).optional(),\n    16\t  })\n    17\t  .strict();\n    18\t\n    19\texport type ToolApproval = z.infer<typeof toolApprovalSchema>;\n    20\texport interface StoredToolApproval {\n    21\t  readonly proposal: ToolApproval;\n    22\t  /** Original input is retained to re-run object-to-argv transforms against the current schema. */\n    23\t  readonly input: unknown;\n    24\t  readonly policyFingerprint: string;\n    25\t}\n    26\t\n    27\texport interface ToolApprovalStore {\n    28\t  /** Create only: reject duplicate IDs. Do not expose this method to an approval client. */\n    29\t  put(record: StoredToolApproval): Promise<void>;\n    30\t  /** Atomically get-and-delete; missing/already consumed IDs return undefined. */\n    31\t  consume(approvalId: string): Promise<StoredToolApproval | undefined>;\n    32\t}\n    33\t\n    34\t/** Bounded process-local default. Durable adapters must implement atomic consume themselves. */\n    35\texport function createMemoryApprovalStore(): ToolApprovalStore {\n    36\t  const records = new Map<string, StoredToolApproval>();\n    37\t  return {\n    38\t    async put(record) {\n    39\t      const id = record.proposal.approvalId;\n    40\t      if (records.has(id) || records.size >= 1000) {\n    41\t        throw new Error(\n    42\t          \"Approval store refused duplicate or excess pending record\",\n    43\t        );\n    44\t      }\n    45\t      records.set(id, structuredClone(record));\n    46\t    },\n    47\t    async consume(id) {\n    48\t      const record = records.get(id);\n    49\t      records.delete(id); // Before yielding: concurrent executions have at most one winner.\n    50\t      return record;\n    51\t    },\n    52\t  };\n    53\t}\n    54\t\n    55\texport function approvalDigest(proposal: Omit<ToolApproval, \"digest\">): string {\n    56\t  // Fixed tuple order, string-only argv, and explicit absent reason avoid object-order ambiguity.\n    57\t  return createHash(\"sha256\")\n    58\t    .update(\n    59\t      JSON.stringify([\n    60\t        proposal.approvalId,\n    61\t        proposal.name,\n    62\t        proposal.command,\n    63\t        proposal.args,\n    64\t        proposal.reason ?? null,\n    65\t        proposal.policyVersion,\n    66\t      ]),\n    67\t    )\n    68\t    .digest(\"hex\");\n    69\t}\n    70\t\n    71\texport function commandPolicyFingerprint(spec: CommandSpec): string {\n    72\t  const env =\n    73\t    spec.env === undefined\n    74\t      ? null\n    75\t      : Object.entries(spec.env).sort(([a], [b]) => a.localeCompare(b));\n    76\t  return createHash(\"sha256\")\n    77\t    .update(JSON.stringify([spec.command, spec.policyVersion ?? \"1\", env]))\n    78\t    .digest(\"hex\");\n    79\t}\n    80\t\n    81\texport function equalApprovalDigest(left: string, right: string): boolean {\n    82\t  const hex = /^[a-f0-9]{64}$/;\n    83\t  return (\n    84\t    hex.test(left) &&\n    85\t    hex.test(right) &&\n    86\t    timingSafeEqual(Buffer.from(left, \"hex\"), Buffer.from(right, \"hex\"))\n    87\t  );\n    88\t}\n","exit_code":0,"status":"completed"}}
