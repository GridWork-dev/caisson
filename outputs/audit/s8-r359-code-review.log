exec/src/tool-exec.test.ts:333:    const oldEnv = await gate.propose(\"echo\", [\"approved\"]);\npackages/tool-exec/src/tool-exec.test.ts:335:    await expect(gate.execute(oldEnv)).rejects.toThrow(NotFoundError);\npackages/tool-exec/src/tool-exec.test.ts:336:    const oldVersion = await gate.propose(\"echo\", [\"approved\"]);\npackages/tool-exec/src/tool-exec.test.ts:338:    await expect(gate.execute(oldVersion)).rejects.toThrow(NotFoundError);\npackages/tool-exec/src/tool-exec.test.ts:355:    const first = await gate.propose(\"echo\", input);\npackages/tool-exec/src/tool-exec.test.ts:357:    await gate.execute(first);\npackages/tool-exec/src/tool-exec.test.ts:359:    const second = await gate.propose(\"echo\", { text: \"another\" });\npackages/tool-exec/src/tool-exec.test.ts:361:    await expect(gate.execute(second)).rejects.toThrow(ValidationError);\npackages/tool-exec/src/tool-exec.test.ts:379:    const proposal = await gate.propose(\"echo\", [\"approved\"]);\npackages/tool-exec/src/tool-exec.test.ts:381:    await expect(gate.execute(proposal)).rejects.toThrow(ValidationError);\npackages/tool-exec/src/tool-exec.test.ts:389:      JSON.stringify(await gate.propose(\"echo\", [\"approved\"])),\npackages/tool-exec/src/tool-exec.test.ts:392:      gate.execute(proposal),\npackages/tool-exec/src/tool-exec.test.ts:393:      gate.execute(proposal),\npackages/tool-exec/src/tool-exec.test.ts:400:    await expect(gate.execute(proposal)).rejects.toThrow(NotFoundError);\npackages/tool-exec/src/tool-exec.ts:177:      const proposed = gate.propose(name, args, reason);\npackages/tool-exec/src/tool-exec.ts:187:      const validated = gate.propose(name, input, reason);\npackages/tool-exec/src/tool-exec.ts:234:      const current = gate.propose(\npackages/tool-exec/README.md:64:`await tool.propose(name, input, reason)` returns a serializable `ToolApproval`:\napps/demos/components/poke/tool-exec-poke.test.ts:7://      `createToolExec(...).propose()` (node entry) agree on every verdict, because they are the\napps/demos/components/poke/tool-exec-poke.test.ts:62:    const approved = await real.propose(SAMPLE_ALLOWED.name, args);\napps/demos/components/poke/tool-exec-poke.test.ts:65:    await expect(real.execute(verdict.proposed)).rejects.toThrow(\napps/demos/components/poke/tool-exec-poke.test.ts:71:    const proposed = await real.propose(SAMPLE_ALLOWED.name, [\"hi\"]);\napps/demos/components/poke/tool-exec-poke.test.ts:86:    await expect(real.propose(SAMPLE_DENIED.name, args)).rejects.toThrow(\napps/demos/components/poke/tool-exec-poke.tsx:6:// `createToolExec.propose()` runs, imported through the package's browser-safe `./browser` entry\napps/demos/components/poke/tool-exec-poke.tsx:67:    return { outcome: \"proposed\", proposed: GATE.propose(name, [...args]) };\n","exit_code":0,"status":"completed"}}
