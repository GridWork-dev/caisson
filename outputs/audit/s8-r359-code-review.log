{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/lib/auth.ts'","aggregated_output":"     1\t// The dashboard auth seam (ADR-0015). better-auth is the self-hosted SessionProvider; for a\n     2\t// SAME-PROCESS read (the dashboard) `resolveSession` returns `{ userId, accountId, role }`\n     3\t// straight from the better-auth server session (its `Secure; HttpOnly; SameSite=Strict` cookie,\n     4\t// configured in `lib/auth-server.ts`). `requireDashboardSession` is the ONE call every dashboard\n     5\t// route makes before any tenant read; its signature is unchanged so no route had to change.\n     6\t//\n     7\t// This supersedes the earlier placeholder that read a self-minted EdDSA `caisson_session` cookie:\n     8\t// that cookie was a stand-in until the real sign-in flow existed. The EdDSA account JWT\n     9\t// (`@caisson/auth`'s `jwt.ts`) remains the CROSS-SERVICE seam (execution-plane / buyer MCP), a\n    10\t// separate concern from this same-process read.\n    11\timport { cookies, headers } from \"next/headers\";\n    12\timport { redirect } from \"next/navigation\";\n    13\timport {\n    14\t  type AccountMembership,\n    15\t  type Role,\n    16\t  type SessionContext,\n    17\t  ensurePersonalAccount,\n    18\t  resolveUserAccounts,\n    19\t  selectActiveAccount,\n    20\t} from \"@caisson/auth\";\n    21\timport { getAuth } from \"./auth-server.ts\";\n    22\timport { getDb } from \"./db.ts\";\n    23\t\n    24\texport { SESSION_COOKIE_NAME } from \"./auth-server.ts\";\n    25\t\n    26\t/** The active-account preference cookie (G8): which of the signed-in user's memberships\n    27\t *  `getSession` should resolve to. Read-only signal, never a trust boundary — `selectActiveAccount`\n    28\t *  only ever matches an id against the user's OWN verified memberships (`resolveUserAccounts`,\n    29\t *  user-scoped RLS), so a tampered/stale value just falls back to the personal account rather than\n    30\t *  crossing tenants. HttpOnly (server-read only, no client JS needs it) + Secure + SameSite=Strict\n    31\t *  per the cookie security floor. */\n    32\texport const ACTIVE_ACCOUNT_COOKIE = \"cs_active_account\";\n    33\t\n    34\t/**\n    35\t * Resolve the current request's session from better-auth, mapped to the base `SessionContext`, or\n    36\t * `null`. Never throws — an unconfigured runtime (no DB/secret), no cookie, or an expired/forged\n    37\t * session all collapse to \"no session\" (fail closed): the caller redirects to `/login`.\n    38\t *\n    39\t * ACCOUNT RESOLUTION (D4, ADR-0176): the tenant `accountId` is resolved from `account_member` — a\n    40\t * user with no membership row gets a personal account (account_id == user_id) created idempotently\n    41\t * on first resolution; org members resolve to their selected/oldest account. The account id is\n    42\t * still sourced solely from the verified better-auth session's user id (never a request param), so\n    43\t * a forged account id cannot cross tenants — `resolveActiveAccount` only ever reads accounts the\n    44\t * verified `userId` belongs to (user-scoped RLS via `withUser`). It is the ONLY value the data\n    45\t * layer trusts for RLS (`withTenant`, ADR-0005).\n    46\t */\n    47\texport async function getSession(): Promise<SessionContext | null> {\n    48\t  const auth = await getAuth();\n    49\t  if (auth === null) return null;\n    50\t  try {\n    51\t    const result = await auth.api.getSession({ headers: await headers() });\n    52\t    if (result === null) return null;\n    53\t    const userId = result.user.id;\n    54\t    const requestedAccountId = (await cookies()).get(\n    55\t      ACTIVE_ACCOUNT_COOKIE,\n    56\t    )?.value;\n    57\t    const { accountId, role } = await resolveActiveAccount(\n    58\t      userId,\n    59\t      requestedAccountId,\n    60\t    );\n    61\t    return { userId, accountId, role };\n    62\t  } catch {\n    63\t    return null;\n    64\t  }\n    65\t}\n    66\t\n    67\t/** Every account the signed-in user belongs to (bootstraps the personal account on first read,\n    68\t *  same as `resolveActiveAccount`) — throws on a DB error; callers fail-safe individually. */\n    69\tasync function listMyAccounts(userId: string): Promise<AccountMembership[]> {\n    70\t  const db = await getDb();\n    71\t  let memberships = await resolveUserAccounts(db, userId);\n    72\t  if (memberships.length === 0) {\n    73\t    await ensurePersonalAccount(db, userId);\n    74\t    memberships = await resolveUserAccounts(db, userId);\n    75\t  }\n    76\t  return memberships;\n    77\t}\n    78\t\n    79\t/**\n    80\t * Resolve the signed-in user's active account via `account_member` (D4, ADR-0176), honoring an\n    81\t * explicit `requestedAccountId` (the active-account cookie, G8) when it names one of the user's\n    82\t * OWN memberships. FAIL-SAFE: any DB error — the table not yet migrated on this deploy, the pool\n    83\t * down — falls back to the personal account (account_id == user_id, role owner) so an authed\n    84\t * dashboard render never breaks. Existing single-user tenants (no membership row) resolve to\n    85\t * exactly that personal account, unchanged.\n    86\t */\n    87\tasync function resolveActiveAccount(\n    88\t  userId: string,\n    89\t  requestedAccountId?: string,\n    90\t): Promise<{ accountId: string; role: Role }> {\n    91\t  const personal = { accountId: userId, role: \"owner\" as Role };\n    92\t  try {\n    93\t    const memberships = await listMyAccounts(userId);\n    94\t    const active = selectActiveAccount(memberships, requestedAccountId);\n    95\t    return active\n    96\t      ? { accountId: active.accountId, role: active.role }\n    97\t      : personal;\n    98\t  } catch {\n    99\t    return personal;\n   100\t  }\n   101\t}\n   102\t\n   103\t/**\n   104\t * The account-switcher UI's option list (G8): every account the given user belongs to, or just\n   105\t * their personal account on a DB error (mirrors `resolveActiveAccount`'s fail-safe — a switcher\n   106\t * that can't reach the DB degrades to \"no other accounts\" rather than breaking the page).\n   107\t */\n   108\texport async function getAccountMemberships(\n   109\t  userId: string,\n   110\t): Promise<AccountMembership[]> {\n   111\t  try {\n   112\t    return await listMyAccounts(userId);\n   113\t  } catch {\n   114\t    return [{ accountId: userId, userId, role: \"owner\" }];\n   115\t  }\n   116\t}\n   117\t\n   118\t/**\n   119\t * Owner-only gate for org-mutating writes (CWE-863 broken-access-control — ADR-0208 decision 1).\n   120\t * BYOK provider-key rotation and compliance-attestation writes require the account OWNER role:\n   121\t * a seat member must not rotate the org's provider keys or rewrite the attestations that feed\n   122\t * the SAR/POA&M export. Reads (masked key metadata, attestation state) stay seat-visible — gate\n   123\t * only the writes. Roles are `owner | seat` (`account_member`, ADR-0176); the role comes from\n   124\t * the verified session, never a request param. Mirrors the members-page owner gate.\n   125\t */\n   126\texport function isOwner(session: SessionContext): boolean {\n   127\t  return session.role === \"owner\";\n   128\t}\n   129\t\n   130\t/**\n   131\t * Require a session for an authed dashboard route; redirects to `/login?next=<pathname>` when\n   132\t * absent (never throws a 401 into a page render). `pathname` is the route requiring auth, used\n   133\t * only to return the buyer to where they started after sign-in.\n   134\t */\n   135\texport async function requireDashboardSession(\n   136\t  pathname: string,\n   137\t): Promise<SessionContext> {\n   138\t  const session = await getSession();\n   139\t  if (session === null) {\n   140\t    redirect(`/login?next=${encodeURIComponent(pathname)}`);\n   141\t  }\n   142\t  return session;\n   143\t}\n","exit_code":0,"status":"completed"}}
