{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/app/dashboard/cart/page.tsx'","aggregated_output":"     1\t// The authed checkout surface for the marketing site's cart. The cart itself lives in\n     2\t// `localStorage` on this SAME origin (this app is the one unified Railway Next app, ADR-0114) —\n     3\t// `CartProvider` re-reads it here, so a visitor who built a cart on the public `/pricing` page\n     4\t// sees the same lines here. The checkout API independently resolves the session and current\n     5\t// entitlements before creating a Paddle transaction (ADR-0424).\n     6\timport type { Metadata } from \"next\";\n     7\t\n     8\timport { CartCheckoutPanel } from \"@/components/cart-checkout-panel\";\n     9\timport { requireDashboardSession } from \"@/lib/auth\";\n    10\t\n    11\texport const metadata: Metadata = { title: \"Cart checkout\" };\n    12\t\n    13\t// The abandoned-checkout email's `?promo=<code>` link (SPEC-abandoned-checkout-email.md, discount\n    14\t// fork, 2026-07-10 lock) — bounded + shape-checked server-side before it ever reaches Paddle.js.\n    15\tconst PROMO_CODE_RE = /^[A-Za-z0-9_-]+$/;\n    16\t\n    17\tfunction parsePromoCode(raw: string | undefined): string | undefined {\n    18\t  if (raw === undefined) return undefined;\n    19\t  const trimmed = raw.trim();\n    20\t  if (trimmed.length === 0 || trimmed.length > 64) return undefined;\n    21\t  return PROMO_CODE_RE.test(trimmed) ? trimmed : undefined;\n    22\t}\n    23\t\n    24\texport default async function DashboardCartPage({\n    25\t  searchParams,\n    26\t}: {\n    27\t  searchParams: Promise<{ promo?: string }>;\n    28\t}) {\n    29\t  await requireDashboardSession(\"/dashboard/cart\");\n    30\t  const { promo } = await searchParams;\n    31\t  const promoCode = parsePromoCode(promo);\n    32\t\n    33\t  // The cart context is provided by the root layout (app/layout.tsx) and reads the SAME\n    34\t  // localStorage the public /pricing page wrote to — so the buyer's cart follows them here.\n    35\t  // `exactOptionalPropertyTypes`-safe: spread the prop in only when set, never pass an explicit\n    36\t  // `undefined` for an optional string prop.\n    37\t  return (\n    38\t    <CartCheckoutPanel {...(promoCode !== undefined ? { promoCode } : {})} />\n    39\t  );\n    40\t}\n","exit_code":0,"status":"completed"}}
