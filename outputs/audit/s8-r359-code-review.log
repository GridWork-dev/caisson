ts:145:      healthPath: \"/healthz\",\ndeploy/smoke.ts:146:      canaryHealthPath: \"/healthz\",\ndeploy/smoke.ts:169:      healthPath: \"/demos/healthz\",\ndeploy/smoke.ts:170:      canaryHealthPath: \"/demos/healthz\",\napps/demos/Dockerfile:34:# for the `.caisson-revision` carrier would miss the repo-root file /demos/healthz reports from.\napps/demos/Dockerfile:57:# /demos/healthz, not /healthz: next.config.ts sets `basePath: \"/demos\"`, which prefixes every\napps/demos/Dockerfile:60:  CMD bun -e \"fetch('http://127.0.0.1:'+(process.env.PORT||3040)+'/demos/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"\ndeploy/observe.test.ts:60:      \"https://caisson.sh/healthz?observe=25-0\",\ndeploy/observe.test.ts:61:      \"https://admin.caisson.sh/healthz?observe=25-1\",\ndeploy/observe.test.ts:64:      \"https://caisson.sh/demos/healthz?observe=25-4\",\ndeploy/observe.test.ts:90:      \"https://caisson.sh/healthz?observe=25-0\",\napps/demos/next.config.ts:20:  // The consequence to know: EVERY route here is served under /demos, including /healthz, which\napps/demos/next.config.ts:21:  // is why railway.toml probes `/demos/healthz`.\napps/demos/railway.toml:6:# and answers /demos/healthz behind apps/site's rewrite. Creating it was an operator-gated\napps/demos/railway.toml:40:# /demos/healthz, not /healthz: next.config.ts sets `basePath: \"/demos\"`, which prefixes every\napps/demos/railway.toml:43:healthcheckPath = \"/demos/healthz\"\napps/demos/app/healthz/route.ts:1:// Railway readiness probe (ADR-0400). Mirrors apps/site's `/healthz` shape — a plain\napps/demos/app/healthz/route.ts:4:// SERVED AT /demos/healthz, not /healthz: next.config.ts sets `basePath: \"/demos\"`, which\napps/demos/app/healthz/route.ts:9:// header probe-only on this service: `/demos/healthz` reports the revision, other demo routes do\n","exit_code":0,"status":"completed"}}
