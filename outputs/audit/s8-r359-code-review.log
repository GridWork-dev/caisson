{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba .github/workflows/deploy-staging.yml'","aggregated_output":"     1\t# T28 reference: stable staging flow (doc 07 §5).\n     2\t#\n     3\t# COPY VERBATIM into each app repo as `.github/workflows/deploy-staging.yml`.\n     4\t#\n     5\t# The ordering here is the whole point and it is not stylistic:\n     6\t#\n     7\t#   publish digest -> record the rollback revision -> update the migration Job TO that\n     8\t#   digest -> execute the Job -> deploy the same digest to the services -> smoke\n     9\t#   -> record evidence\n    10\t#\n    11\t# The Job definition is updated BEFORE it is executed. `gcloud run jobs execute` has no\n    12\t# way to select an image ad hoc, so an execute against a stale Job definition silently\n    13\t# runs last release's migration and reports success (doc 07 §5, and the linked gcloud\n    14\t# reference). That is the failure this ordering exists to prevent.\n    15\t\n    16\tname: deploy staging\n    17\t\n    18\ton:\n    19\t  workflow_dispatch:\n    20\t    inputs:\n    21\t      digests:\n    22\t        description: 'JSON: {\"<service>\": \"sha256:...\"} — from a publish run'\n    23\t        required: true\n    24\t        type: string\n    25\t  workflow_call:\n    26\t    inputs:\n    27\t      digests:\n    28\t        required: true\n    29\t        type: string\n    30\t\n    31\t# doc 07 §8 rule 2: serialize against any other deploy or rollback touching this\n    32\t# environment. Two concurrent traffic mutations produce a state neither run intended.\n    33\tconcurrency:\n    34\t  group: deploy-staging\n    35\t  cancel-in-progress: false\n    36\t\n    37\tpermissions:\n    38\t  contents: read\n    39\t\n    40\tjobs:\n    41\t  deploy:\n    42\t    runs-on: ${{ vars.CI_RUNNER_LINUX || 'ubuntu-latest' }}\n    43\t    timeout-minutes: 45\n    44\t    environment: staging\n    45\t    permissions:\n    46\t      contents: read\n    47\t      id-token: write\n    48\t    steps:\n    49\t      # See publish.yml's `select` job for why an unset repository variable is a\n    50\t      # vendor-chosen value rather than a failure — an empty `BUN_VERSION_FILE` installs the\n    51\t      # newest Bun on a green run instead of erroring. First step, before any credential.\n    52\t      - name: assert the repository variables are set\n    53\t        env:\n    54\t          BUN_VERSION_FILE: ${{ vars.BUN_VERSION_FILE }}\n    55\t          GCP_NONPROD_PROJECT: ${{ vars.GCP_NONPROD_PROJECT }}\n    56\t          GCP_REGION: ${{ vars.GCP_REGION }}\n    57\t          GCP_REGISTRY: ${{ vars.GCP_REGISTRY }}\n    58\t          GCP_STAGING_DEPLOYER_SA: ${{ vars.GCP_STAGING_DEPLOYER_SA }}\n    59\t          GCP_WIF_PROVIDER: ${{ vars.GCP_WIF_PROVIDER }}\n    60\t        run: |\n    61\t          set -euo pipefail\n    62\t          missing=\"\"\n    63\t          for v in BUN_VERSION_FILE GCP_NONPROD_PROJECT GCP_REGION GCP_REGISTRY GCP_STAGING_DEPLOYER_SA GCP_WIF_PROVIDER; do\n    64\t            [ -n \"${!v:-}\" ] || missing=\"$missing $v\"\n    65\t          done\n    66\t          if [ -n \"$missing\" ]; then\n    67\t            echo \"::error::unset repository variables:$missing\"\n    68\t            exit 1\n    69\t          fi\n    70\t\n    71\t      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n    72\t\n    73\t      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0\n    74\t        with:\n    75\t          bun-version-file: ${{ vars.BUN_VERSION_FILE }}\n    76\t\n    77\t      # See publish.yml for why this is not an unconditional `bun install` and what the\n    78\t      # `exit 1` arm catches. The bodies must not drift.\n    79\t      - name: install the deploy scripts' dependencies\n    80\t        run: |\n    81\t          set -euo pipefail\n    82\t          if [ -f bun.lock ]; then\n    83\t            bun install --frozen-lockfile\n    84\t          elif grep -hoE 'from \"[^\"]+\"' deploy/*.ts | grep -qvE 'from \"(\\.|node:|bun:)'; then\n    85\t            echo \"::error::deploy/*.ts imports a package but this repo has no root bun.lock\"\n    86\t            exit 1\n    87\t          fi\n    88\t\n    89\t      # Every service key and every digest is validated against the repo's own manifest\n    90\t      # before a single gcloud call. doc 07 §8 rule 1 asks for strict allowlists on\n    91\t      # rollback inputs; the same reasoning applies to a deploy — `gcloud run services\n    92\t      # update` will cheerfully point a service at any digest string you hand it.\n    93\t      - name: validate inputs against the manifest\n    94\t        id: plan\n    95\t        env:\n    96\t          DIGESTS: ${{ inputs.digests }}\n    97\t          ENVIRONMENT: staging\n    98\t          # plan.ts emits fully-qualified image references and cannot build one without\n    99\t          # the registry prefix. Omitted in the first cut of this template; caught by the\n   100\t          # gridwork adoption, which had to add it locally to make plan.ts implementable.\n   101\t          GCP_REGISTRY: ${{ vars.GCP_REGISTRY }}\n   102\t        run: bun run deploy/plan.ts >> \"$GITHUB_OUTPUT\"\n   103\t\n   104\t      - uses: google-github-actions/auth@7c6bc770dae815cd3e89ee6cdf493a5fab2cc093 # v3.0.0\n   105\t        with:\n   106\t          workload_identity_provider: ${{ vars.GCP_WIF_PROVIDER }}\n   107\t          service_account: ${{ vars.GCP_STAGING_DEPLOYER_SA }}\n   108\t          create_credentials_file: true\n   109\t\n   110\t      - uses: google-github-actions/setup-gcloud@aa5489c8933f4cc7a4f7d45035b3b1440c9c10db # v3.0.1\n   111\t\n   112\t      # Recorded BEFORE anything changes — before the migration Job runs, not after it,\n   113\t      # which is where this step sat in the first cut of the fix and is why the comment\n   114\t      # claiming parity with deploy-production.yml was untrue. Production records at this\n   115\t      # same point (immediately after setup-gcloud) and for the same reason: if the\n   116\t      # migration fails, the run must still have published a rollback target.\n   117\t      #\n   118\t      # Staging previously recorded nothing at all, so a staging rollback had no\n   119\t      # provenance source — rollback.yml accepts `staging` as an environment and its\n   120\t      # revision check had nothing to validate the operator's input against, which makes a\n   121\t      # staging rollback unauthorizable even when it is the correct move.\n   122\t      #\n   123\t      # The `echo '${{ ... }}'` shape used elsewhere is not repeated here: a single quote\n   124\t      # anywhere in the value ends the quoting and the rest of the value is parsed as\n   125\t      # script. `printf '%s' \"$SERVICES\"` reads the value from the environment instead.\n   126\t      - name: record the rollback revision\n   127\t        env:\n   128\t          SERVICES: ${{ steps.plan.outputs.services }}\n   129\t          PROJECT: ${{ vars.GCP_NONPROD_PROJECT }}\n   130\t          REGION: ${{ vars.GCP_REGION }}\n   131\t        run: |\n   132\t          set -euo pipefail\n   133\t          # `status.traffic[0]` was an array POSITION, and the array keeps every zero-percent\n   134\t          # tagged canary this template leaves behind. gcloud happens to serialise\n   135\t          # percent-bearing targets first, which is the only reason index 0 was right: an\n   136\t          # undocumented tool-side ordering holding up the sole restore target. Select by\n   137\t          # percent, and refuse on a split — a stranded 5/95 from a failed run wants\n   138\t          # rollback.yml first, not a deploy on top of it. A jq `error()` exits non-zero with\n   139\t          # an EMPTY describe-err.txt and takes the loud branch below; jq's own message is on\n   140\t          # this step's stderr.\n   141\t          serving='[.status.traffic[]? | select((.percent // 0) > 0) | .revisionName]\n   142\t            | if length == 1 then .[0] else error(\"expected exactly one serving revision, got \\(length)\") end'\n   143\t          printf '%s' \"$SERVICES\" | jq -r '.[].service' |\n   144\t          while read -r svc; do\n   145\t            # `2>/dev/null || true` was the first shape here and it was wrong in a way\n   146\t            # that is invisible: it swallowed EVERY non-zero exit, not just the one the\n   147\t            # comment claimed. An expired credential, a wrong GCP_REGION, a missing\n   148\t            # run.viewer binding on one service, a 429 — each produced an empty revision,\n   149\t            # a green run, and a release with no rollback target, with the error text\n   150\t            # thrown away. Discriminate instead: a service absent from Cloud Run records\n   151\t            # nothing; anything else fails the deploy loudly. Absent is NOT a first-deploy\n   152\t            # path — the stacks bootstrap every service with a serving revision, and\n   153\t            # `services update` below cannot create one, so an absent service fails there.\n   154\t            if ! rev=\"$(gcloud run services describe \"$svc\" \\\n   155\t              --project \"$PROJECT\" \\\n   156\t              --region \"$REGION\" \\\n   157\t              --format json 2>describe-err.txt | jq -r \"$serving\")\"; then\n   158\t              if ! grep -qi 'NOT_FOUND\\|not found' describe-err.txt; then\n   159\t                cat describe-err.txt >&2\n   160\t                echo \"::error::could not read the serving revision of ${svc} — refusing to deploy without a rollback target\"\n   161\t                exit 1\n   162\t              fi\n   163\t              rev=\"\"\n   164\t            fi\n   165\t            # A line with no revision names nothing, and rollback.yml's gate is\n   166\t            # `grep -Fxq \"$SERVICE $REVISION\"` — so \"svc \" is an exact whole-line match\n   167\t            # for an EMPTY revision input, and the gate whose whole purpose is proving a\n   168\t            # revision once held traffic would approve one that never existed. Omit the\n   169\t            # line rather than write an unmatchable one.\n   170\t            [ -n \"$rev\" ] || continue\n   171\t            # Appended per line, not `done | tee file`: the loop's `::error::` annotation is\n   172\t            # stdout too, and through a trailing tee it became a LINE IN THE ROLLBACK FILE —\n   173\t            # which the restore step then fed to update-traffic as a service name, so a\n   174\t            # record-step failure (zero traffic touched) ended in a red \"TRAFFIC RESTORE\n   175\t            # FAILED\" page. No pre-truncate either: the file exists only once a real line\n   176\t            # was written, so the hashFiles guards stay inert on an early failure.\n   177\t            printf '%s %s\\n' \"$svc\" \"$rev\" | tee -a rollback-revisions.txt\n   178\t          done\n   179\t\n   180\t      # Uploaded immediately, not batched with the evidence at the end of the job. The\n   181\t      # run this file matters most for is the one where the deploy or the smoke fails —\n   182\t      # a rollback target that only ships on a green run is not a rollback target, and\n   183\t      # position alone did not buy that: with no `if:` the default is `success()`, so the\n   184\t      # upload was skipped on exactly the runs it exists for. `overwrite: true` because\n   185\t      # artifact names are unique per RUN, not per attempt — without it \"Re-run failed\n   186\t      # jobs\" 409s here and can never reach the deploy step it was re-run to retry.\n   187\t      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1\n   188\t        if: always() && hashFiles('rollback-revisions.txt') != ''\n   189\t        with:\n   190\t          name: staging-rollback-revisions\n   191\t          path: rollback-revisions.txt\n   192\t          if-no-files-found: error\n   193\t          overwrite: true\n   194\t\n   195\t      # Step 1 of §5. The direct Neon URL, never the pooled one: a migration takes\n   196\t      # session-scoped locks and advisory state that a transaction pooler discards\n   197\t      # between statements (doc 02, doc 01 §6).\n   198\t      # Every value this script needs arrives through `env:` and is read as \"$VAR\". No\n   199\t      # ${{ }} appears in a `run:` body anywhere in this file, and that is a hard rule,\n   200\t      # not a style: the runner substitutes ${{ }} TEXTUALLY into the script source\n   201\t      # before any shell parses it, so a value containing $(...) lands as executable\n   202\t      # source and runs — here, holding the staging deployer credential, because this\n   203\t      # step is after google-github-actions/auth. Quoting does not fix it; a value\n   204\t      # carrying a quote character closes the quoting it was meant to be inside. An\n   205\t      # `env:` mapping puts the value in the process environment, never in the script\n   206\t      # text, which is why it is the only shape that holds. `if:`, `with:`, `uses:` and\n   207\t      # the right-hand side of `env:` are not shell and keep their expressions.\n   208\t      - name: point the migration Job at this digest\n   209\t        if: steps.plan.outputs.migration_job != ''\n   210\t        env:\n   211\t          MIGRATION_JOB: ${{ steps.plan.outputs.migration_job }}\n   212\t          MIGRATION_IMAGE: ${{ steps.plan.outputs.migration_image }}\n   213\t          PROJECT: ${{ vars.GCP_NONPROD_PROJECT }}\n   214\t          REGION: ${{ vars.GCP_REGION }}\n   215\t        run: |\n   216\t          set -euo pipefail\n   217\t          gcloud run jobs update \"$MIGRATION_JOB\" \\\n   218\t            --project \"$PROJECT\" \\\n   219\t            --region \"$REGION\" \\\n   220\t            --image \"$MIGRATION_IMAGE\"\n   221\t\n   222\t      # Same routing, same reason as the step above.\n   223\t      - name: execute the migration Job\n   224\t        if: steps.plan.outputs.migration_job != ''\n   225\t        env:\n   226\t          MIGRATION_JOB: ${{ steps.plan.outputs.migration_job }}\n   227\t          PROJECT: ${{ vars.GCP_NONPROD_PROJECT }}\n   228\t          REGION: ${{ vars.GCP_REGION }}\n   229\t        run: |\n   230\t          set -euo pipefail\n   231\t          gcloud run jobs execute \"$MIGRATION_JOB\" \\\n   232\t            --project \"$PROJECT\" \\\n   233\t            --region \"$REGION\" \\\n   234\t            --wait\n   235\t\n   236\t      - name: deploy each service to its digest\n   237\t        env:\n   238\t          SERVICES: ${{ steps.plan.outputs.services }}\n   239\t          PROJECT: ${{ vars.GCP_NONPROD_PROJECT }}\n   240\t          REGION: ${{ vars.GCP_REGION }}\n   241\t        run: |\n   242\t          set -euo pipefail\n   243\t          printf '%s' \"$SERVICES\" | jq -r '.[] | \"\\(.service) \\(.image)\"' |\n   244\t          while read -r svc image; do\n   245\t            echo \"::group::$svc\"\n   246\t            gcloud run services update \"$svc\" \\\n   247\t              --project \"$PROJECT\" \\\n   248\t              --region \"$REGION\" \\\n   249\t              --image \"$image\"\n   250\t            # A prior staging rollback pins traffic to a revision NAME (rollback.yml's\n   251\t            # `--to-revisions`), and `services update` does not unpin it: the next deploy\n   252\t            # creates a 0% revision, the smoke below proves the OLD one, and the evidence\n   253\t            # records a digest that never served — which production then promotes. A no-op\n   254\t            # when traffic is already LATEST. Production deliberately does not get this\n   255\t            # line: it shifts by `--to-tags`.\n   256\t            gcloud run services update-traffic \"$svc\" \\\n   257\t              --project \"$PROJECT\" \\\n   258\t              --region \"$REGION\" \\\n   259\t              --to-latest\n   260\t            echo \"::endgroup::\"\n   261\t          done\n   262\t\n   263\t      # doc 04 §4 + the T30 bypass suite. A staging deploy that does not re-prove the\n   264\t      # origin gate is how the gate silently regresses: nothing else in the pipeline\n   265\t      # touches it, and the first place you would notice is production.\n   266\t      - name: resolve raw staging origins through the governed argv gate\n   267\t        id: staging-origins\n   268\t        env:\n   269\t          GCP_NONPROD_PROJECT: ${{ vars.GCP_NONPROD_PROJECT }}\n   270\t          GCP_REGION: ${{ vars.GCP_REGION }}\n   271\t        run: bun run deploy/staging-origins.ts >> \"$GITHUB_OUTPUT\"\n   272\t\n   273\t      - name: origin + Access bypass suite\n   274\t        env:\n   275\t          ENVIRONMENT: staging\n   276\t          # Every other caller of smoke.ts passes a MODE and this one passed none, so\n   277\t          # smoke.ts saw it undefined and had to guess. `staging` is its own mode: unlike\n   278\t          # production's pre/post-migration modes there is no tagged revision to address\n   279\t          # here, and unlike post-deploy this run must also exercise the origin + Access\n   280\t          # bypass suite rather than only the happy path.\n   281\t          MODE: staging\n   282\t          STAGING_ORIGIN_URLS: ${{ steps.staging-origins.outputs.staging_origin_urls }}\n   283\t          # Empty on repos with no Cloudflare Access app. smoke.ts calls the public\n   284\t          # hostname through Cloudflare, and an Access-protected hostname answers 302 to\n   285\t          # the login page without a service token — indistinguishable from a broken\n   286\t          # deploy. Never echo either value.\n   287\t          CF_ACCESS_CLIENT_ID: ${{ secrets.CF_ACCESS_CLIENT_ID }}\n   288\t          CF_ACCESS_CLIENT_SECRET: ${{ secrets.CF_ACCESS_CLIENT_SECRET }}\n   289\t        run: bun run deploy/smoke.ts\n   290\t\n   291\t      # This step used to build the JSON with `cat > … <<JSON` — an UNQUOTED heredoc\n   292\t      # delimiter — with ${{ toJSON(inputs.digests) }} and the plan outputs interpolated\n   293\t      # into the body. That was a working remote-execution path, and the route through it\n   294\t      # is worth stating exactly, because it defeats the validation step above rather\n   295\t      # than evading it:\n   296\t      #\n   297\t      #   an attacker dispatches digests with a DUPLICATE key, e.g.\n   298\t      #     {\"svc\":\"$(payload)\",\"svc\":\"sha256:<a real digest>\"}\n   299\t      #   plan.ts calls JSON.parse, which keeps the LAST value for a duplicate key, so\n   300\t      #   validation sees only the clean digest and passes. toJSON() then embeds the RAW\n   301\t      #   input string — still carrying the earlier $(payload) — into the heredoc body,\n   302\t      #   the unquoted delimiter makes the shell perform command substitution, and the\n   303\t      #   payload runs after google-github-actions/auth, holding the staging deployer\n   304\t      #   credential. Validate one thing, execute another.\n   305\t      #\n   306\t      # Quoting the delimiter <<'JSON' is NOT the fix and was rejected: a value carrying\n   307\t      # the delimiter line still terminates the heredoc early, and this step also has to\n   308\t      # write values into surrounding quotes elsewhere. jq -n with every value arriving\n   309\t      # through `env:` is the fix — nothing reaches the script text.\n   310\t      #\n   311\t      # jq --arg also does the JSON escaping the heredoc never did. A digest or service\n   312\t      # name containing a quote character previously produced malformed evidence: a\n   313\t      # promotion record that no consumer can parse, discovered at the moment someone\n   314\t      # needs it.\n   315\t      #\n   316\t      # `digests` stays a JSON STRING, matching what toJSON() produced, and stays the RAW\n   317\t      # input rather than plan.ts's parsed view — so a duplicate-key payload is preserved\n   318\t      # verbatim in the evidence instead of being silently collapsed to its last value.\n   319\t      # `workflow_commit`, not `commit`: this is the DISPATCHER's checkout, i.e. which copy\n   320\t      # of this file and of deploy/*.ts ran. The digests were built from whatever commit\n   321\t      # publish ran on, and that binding lives in publish's image-manifest artifact — a\n   322\t      # manual promote of an older digest must not record a commit the image was never\n   323\t      # built from under a name that says it was.\n   324\t      - name: promotion evidence\n   325\t        env:\n   326\t          COMMIT: ${{ github.sha }}\n   327\t          RUN_ID: ${{ github.run_id }}\n   328\t          DIGESTS: ${{ inputs.digests }}\n   329\t          MIGRATION_JOB: ${{ steps.plan.outputs.migration_job }}\n   330\t          SERVICES: ${{ steps.plan.outputs.services }}\n   331\t        run: |\n   332\t          set -euo pipefail\n   333\t          # Captured, then written (T28-AUDIT-3, same as production and rollback): the\n   334\t          # upload here is `success()`-gated so a zero-byte file could not publish, but\n   335\t          # one template carrying the direct redirect is the copy the next evidence step\n   336\t          # gets pasted from. Uniform on purpose.\n   337\t          evidence=\"$(jq -n \\\n   338\t            --arg workflow_commit \"$COMMIT\" \\\n   339\t            --arg run_id \"$RUN_ID\" \\\n   340\t            --arg digests \"$DIGESTS\" \\\n   341\t            --arg migration_job \"$MIGRATION_JOB\" \\\n   342\t            --argjson services \"$SERVICES\" \\\n   343\t            --rawfile rollback rollback-revisions.txt \\\n   344\t            '{environment:\"staging\", workflow_commit:$workflow_commit, run_id:$run_id, digests:$digests,\n   345\t              migration_job:$migration_job, services:$services,\n   346\t              rollback_revisions:$rollback}')\"\n   347\t          printf '%s\\n' \"$evidence\" > staging-evidence.json\n   348\t\n   349\t      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1\n   350\t        with:\n   351\t          name: staging-evidence\n   352\t          path: staging-evidence.json\n   353\t          if-no-files-found: error\n   354\t          overwrite: true\n","exit_code":0,"status":"completed"}}
