{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/local-store/src/embed-scrub-guard.ts'","aggregated_output":"     1\t// src/embed-scrub-guard.ts — the cloud-embed secret-scrub guard (ADR-0067, security-critical). The\n     2\t// Embedder PORT is the ONE path that can carry buyer content OFF the box (to a cloud embedder).\n     3\t// Before any such egress, credential-bearing spans MUST be scrubbed, and the embed transport stays a\n     4\t// TEST-DOUBLED seam — no live cloud call ever runs in CI (the live transport is the only\n     5\t// un-exercised path).\n     6\t//\n     7\t// Threats this guard models: (1) PII/credential content egressing to a cloud embedder —\n     8\t// every text is run through `scrubForEgress` BEFORE it leaves; (2) a secret landing in a log/sink —\n     9\t// nothing here logs the input, and thrown errors carry only a status/dim, never the content, the\n    10\t// `apiKey`, or the rejected value; (3) a live cloud call sneaking into CI — the transport defaults to\n    11\t// `fetchWithTimeout` but is an injectable seam tests replace with a double.\n    12\t//\n    13\t// `scrubForEgress`/`looksLikeSecret` moved to `@caisson/kernel` (`secret-scrub.ts`, ADR-0215) —\n    14\t// kernel is the lowest-license, zero-dep home both this package and `guardrails` already depend on,\n    15\t// so the scrub predicate has exactly ONE implementation. Re-exported here so this module's public\n    16\t// surface (and every existing import of it) stays unchanged. The scrub contract itself is still golden-pinned\n    17\t// at `src/__golden__/scrub.json` (applied in this fixed order, each secret span collapsing to the\n    18\t// constant sentinel `[REDACTED]` — no entropy is ever echoed):\n    19\t//   A. PEM private-key block  → the whole armored block to the sentinel.\n    20\t//   B. URL userinfo password  (`scheme://user:pass@host`) → `scheme://user:[REDACTED]@host`.\n    21\t//   C. Secret-NAMED assignment(`<key><=|: ><value>`, key in the secret-name set) → drop the value.\n    22\t//   D. Bare inline token shape (AWS / GitHub / OpenAI / JWT, no key=value context) → the sentinel.\n    23\t// Non-secret text passes through unchanged (no false-positive redaction).\n    24\timport { z } from \"zod\";\n    25\timport {\n    26\t  fetchWithTimeout,\n    27\t  InternalError,\n    28\t  looksLikeSecret,\n    29\t  parseStrict,\n    30\t  scrubForEgress,\n    31\t  strictObject,\n    32\t} from \"@caisson/kernel\";\n    33\t// The `/node` subpath, not the root: `ssrf.ts` reaches `node:dns/promises`. Safe here because\n    34\t// `createCloudEmbedder` is exported only from the node entry (`index.ts`) — never from\n    35\t// `./browser`, whose graph deliberately excludes this module.\n    36\timport {\n    37\t  assertSafePublicUrl,\n    38\t  assertSafePublicUrlResolved,\n    39\t} from \"@caisson/kernel/node\";\n    40\timport { assertEmbeddingDim } from \"./embedder.ts\";\n    41\timport type { Embedder } from \"./embedder.ts\";\n    42\t\n    43\texport { scrubForEgress, looksLikeSecret };\n    44\t\n    45\t/**\n    46\t * Wrap ANY embedder so every text is scrubbed BEFORE it reaches the backend (the cloud-egress guard).\n    47\t * Engine-neutral — works for a local or cloud backend; the wrapped embedder never sees a raw secret,\n    48\t * and nothing here logs the input. This is the reusable primitive the cloud transport composes.\n    49\t */\n    50\texport function guardEmbedder(inner: Embedder): Embedder {\n    51\t  return {\n    52\t    dim: inner.dim,\n    53\t    embed: (text: string): Promise<number[]> =>\n    54\t      inner.embed(scrubForEgress(text)),\n    55\t  };\n    56\t}\n    57\t\n    58\t/** Buyer config for the reference guarded cloud embedder — validated `.strict()` at the boundary. */\n    59\tconst CloudEmbedConfigSchema = strictObject({\n    60\t  /** HTTPS embedding endpoint. Non-https (incl. `http:`/`file:`/`data:`) is rejected fail-closed. */\n    61\t  endpoint: z\n    62\t    .string()\n    63\t    .url()\n    64\t    .refine((u) => {\n    65\t      try {\n    66\t        return new URL(u).protocol === \"https:\";\n    67\t      } catch {\n    68\t        return false;\n    69\t      }\n    70\t    }, \"endpoint must be https\"),\n    71\t  /** Bearer credential for the endpoint — the legitimate egress credential; never logged. */\n    72\t  apiKey: z.string().min(1),\n    73\t  /** Model identifier forwarded to the endpoint. */\n    74\t  model: z.string().min(1),\n    75\t  /** Fixed embedding width; the returned vector is asserted to this dim (fail-closed). */\n    76\t  dim: z.number().int().positive(),\n    77\t  /** Optional request timeout (ms) for the embed fetch; absent ⇒ the `fetchWithTimeout` default. */\n    78\t  timeoutMs: z.number().int().positive().max(120_000).optional(),\n    79\t});\n    80\t\n    81\t/** Boundary-valid cloud-embedder config. */\n    82\texport type CloudEmbedConfig = z.infer<typeof CloudEmbedConfigSchema>;\n    83\t\n    84\t/**\n    85\t * The embed transport seam. Defaults to `fetchWithTimeout` (the only sanctioned outbound-fetch path\n    86\t * on Bun); tests inject a double with the same signature, so CI never makes a live cloud call.\n    87\t */\n    88\texport type EmbedFetch = typeof fetchWithTimeout;\n    89\t\n    90\t/** The canonical wire response `createCloudEmbedder`'s endpoint must return — strict boundary. */\n    91\tconst EmbedResponseSchema = strictObject({\n    92\t  embedding: z.array(z.number()),\n    93\t});\n    94\t\n    95\t/**\n    96\t * Build a reference guarded cloud embedder: it scrubs content (via `guardEmbedder`) BEFORE the body\n    97\t * leaves the box, POSTs the scrubbed text over `fetchWithTimeout` (injectable for tests — no live CI\n    98\t * call), and validates the response against `config.dim` (a wrong-width vector throws, never silently\n    99\t * corrupts the index). The endpoint's response contract is the strict `{ embedding: number[] }` shape;\n   100\t * a backend with a different response shape is wired through `guardEmbedder` around its own client.\n   101\t *\n   102\t * Redaction-safe throughout: nothing logs the content or the `apiKey`, and a failed transport throws\n   103\t * an `InternalError` carrying only the HTTP status — never the body, the key, or the input.\n   104\t */\n   105\texport function createCloudEmbedder(\n   106\t  rawConfig: unknown,\n   107\t  fetchImpl: EmbedFetch = fetchWithTimeout,\n   108\t): Embedder {\n   109\t  const config = parseStrict(CloudEmbedConfigSchema, rawConfig);\n   110\t  // Reject literal-private destinations synchronously, then resolve again at EVERY request.\n   111\t  // R359 / CR-02: configuration-time validation cannot certify a hostname's current addresses.\n   112\t  assertSafePublicUrl(config.endpoint);\n   113\t  return guardEmbedder({\n   114\t    dim: config.dim,\n   115\t    // `text` is ALREADY scrubbed by the `guardEmbedder` wrapper — scrub-before-egress is structural.\n   116\t    embed: async (text: string): Promise<number[]> => {\n   117\t      // Omit `timeoutMs` entirely when unset (exactOptionalPropertyTypes) ⇒ the fetchWithTimeout default.\n   118\t      const timeout =\n   119\t        config.timeoutMs === undefined ? {} : { timeoutMs: config.timeoutMs };\n   120\t      await assertSafePublicUrlResolved(config.endpoint);\n   121\t      const res = await fetchImpl(\n   122\t        config.endpoint,\n   123\t        {\n   124\t          method: \"POST\",\n   125\t          headers: {\n   126\t            \"content-type\": \"application/json\",\n   127\t            authorization: `Bearer ${config.apiKey}`,\n   128\t          },\n   129\t          body: JSON.stringify({ model: config.model, input: text }),\n   130\t          // A 3xx to a private host would otherwise re-target the credential-bearing POST past the\n   131\t          // construction-time check above, which only ever saw the configured origin.\n   132\t          redirect: \"error\",\n   133\t        },\n   134\t        timeout,\n   135\t      );\n   136\t      if (!res.ok) {\n   137\t        // Status only — never the response body, the key, or the content.\n   138\t        throw new InternalError(\"cloud embed request failed\", {\n   139\t          status: res.status,\n   140\t        });\n   141\t      }\n   142\t      const json: unknown = await res.json();\n   143\t      const { embedding } = parseStrict(EmbedResponseSchema, json);\n   144\t      assertEmbeddingDim(config.dim, embedding);\n   145\t      return embedding;\n   146\t    },\n   147\t  });\n   148\t}\n","exit_code":0,"status":"completed"}}
