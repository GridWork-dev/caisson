{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/lib/paddle-cart-transaction.test.ts'","aggregated_output":"     1\timport { afterEach, expect, test } from \"bun:test\";\n     2\timport { createPaddleCartTransaction } from \"./paddle-cart-transaction.ts\";\n     3\timport { MODULE_CATALOG } from \"./catalog.ts\";\n     4\tconst previousKey = process.env.PADDLE_API_KEY;\n     5\tconst previousEnv = process.env.PADDLE_ENV;\n     6\tafterEach(() => {\n     7\t  if (previousKey === undefined) delete process.env.PADDLE_API_KEY;\n     8\t  else process.env.PADDLE_API_KEY = previousKey;\n     9\t  if (previousEnv === undefined) delete process.env.PADDLE_ENV;\n    10\t  else process.env.PADDLE_ENV = previousEnv;\n    11\t});\n    12\tconst txn = `txn_${\"a\".repeat(26)}`;\n    13\tconst discount = `dsc_${\"b\".repeat(26)}`;\n    14\tconst input = {\n    15\t  priceIds: [MODULE_CATALOG[0]!.priceId],\n    16\t  accountId: \"verified-account\",\n    17\t};\n    18\t\n    19\ttest(\"Paddle receives server-selected lines and account with bounded redirect-free requests\", async () => {\n    20\t  process.env.PADDLE_API_KEY = \"test-only-fake-key\";\n    21\t  process.env.PADDLE_ENV = \"sandbox\";\n    22\t  const calls: { url: string; init?: RequestInit }[] = [];\n    23\t  const result = await createPaddleCartTransaction(\n    24\t    { ...input, promoCode: \"SAVE10\" },\n    25\t    async (url, init, opts) => {\n    26\t      calls.push({ url: String(url), ...(init ? { init } : {}) });\n    27\t      expect(opts?.timeoutMs).toBe(15_000);\n    28\t      expect(init?.redirect).toBe(\"error\");\n    29\t      return Response.json(\n    30\t        calls.length === 1\n    31\t          ? {\n    32\t              data: [\n    33\t                {\n    34\t                  id: discount,\n    35\t                  code: \"save10\",\n    36\t                  status: \"active\",\n    37\t                  enabled_for_checkout: true,\n    38\t                },\n    39\t              ],\n    40\t            }\n    41\t          : { data: { id: txn } },\n    42\t      );\n    43\t    },\n    44\t  );\n    45\t  expect(result).toBe(txn);\n    46\t  expect(calls[0]!.url).toBe(\n    47\t    \"https://sandbox-api.paddle.com/discounts?code=SAVE10&status=active\",\n    48\t  );\n    49\t  expect(calls[1]!.url).toBe(\"https://sandbox-api.paddle.com/transactions\");\n    50\t  expect(JSON.parse(String(calls[1]!.init?.body))).toEqual({\n    51\t    collection_mode: \"automatic\",\n    52\t    items: [{ price_id: input.priceIds[0], quantity: 1 }],\n    53\t    custom_data: { account_id: \"verified-account\" },\n    54\t    discount_id: discount,\n    55\t  });\n    56\t});\n    57\t\n    58\ttest(\"unavailable or private discount never creates a transaction\", async () => {\n    59\t  process.env.PADDLE_API_KEY = \"test-only-fake-key\";\n    60\t  let calls = 0;\n    61\t  await expect(\n    62\t    createPaddleCartTransaction({ ...input, promoCode: \"SAVE10\" }, async () => {\n    63\t      calls++;\n    64\t      return Response.json({\n    65\t        data: [\n    66\t          {\n    67\t            id: discount,\n    68\t            code: \"SAVE10\",\n    69\t            status: \"active\",\n    70\t            enabled_for_checkout: false,\n    71\t          },\n    72\t        ],\n    73\t      });\n    74\t    }),\n    75\t  ).rejects.toThrow(\"Discount unavailable\");\n    76\t  expect(calls).toBe(1);\n    77\t});\n    78\t\n    79\ttest(\"missing server key fails closed before egress\", async () => {\n    80\t  delete process.env.PADDLE_API_KEY;\n    81\t  await expect(\n    82\t    createPaddleCartTransaction(input, async () => {\n    83\t      throw new Error(\"must not fetch\");\n    84\t    }),\n    85\t  ).rejects.toThrow(\"not configured\");\n    86\t});\n    87\t\n    88\ttest(\"provider errors and malformed transaction ids fail closed\", async () => {\n    89\t  process.env.PADDLE_API_KEY = \"test-only-fake-key\";\n    90\t  for (const response of [\n    91\t    new Response(\"private provider detail\", { status: 503 }),\n    92\t    Response.json({ data: { id: \"not-a-transaction\" } }),\n    93\t  ]) {\n    94\t    await expect(\n    95\t      createPaddleCartTransaction(input, async () => response),\n    96\t    ).rejects.toThrow();\n    97\t  }\n    98\t});\n","exit_code":0,"status":"completed"}}
