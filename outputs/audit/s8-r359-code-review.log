{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/components/cart-checkout-panel.tsx'","aggregated_output":"     1\t\"use client\";\n     2\t\n     3\timport { useEffect, useState } from \"react\";\n     4\timport Link from \"next/link\";\n     5\timport { z } from \"zod\";\n     6\t// The /fetch subpath is the client-safe cut of the kernel (fetch.ts is pure, no server-only\n     7\t// imports) — mirrors `discord-connect.tsx`'s own client-side fetchWithTimeout usage.\n     8\timport { fetchWithTimeout } from \"@caisson/kernel/fetch\";\n     9\timport { Button, EmptyState } from \"@caisson/ui/components\";\n    10\t\n    11\timport { PADDLE_MOR_DISCLOSURE } from \"@/lib/legal\";\n    12\timport {\n    13\t  isPaddleConfigured,\n    14\t  onCheckoutCompleted,\n    15\t  openCartTransaction,\n    16\t} from \"@/lib/paddle-checkout\";\n    17\timport { formatUsd } from \"@/lib/pricing\";\n    18\t\n    19\timport { useCart } from \"./cart-provider\";\n    20\t\n    21\tconst checkoutResponseSchema = z\n    22\t  .object({\n    23\t    transactionId: z.string().regex(/^txn_[a-z0-9]{26}$/),\n    24\t    removed: z.array(z.string().max(128)).max(50),\n    25\t  })\n    26\t  .strict();\n    27\t\n    28\texport interface CartCheckoutPanelProps {\n    29\t  /** The validated `?promo=` search param (server-validated shape, `dashboard/cart/page.tsx`) —\n    30\t   *  threaded straight into `Paddle.Checkout.open({ discountCode })` when present. */\n    31\t  promoCode?: string;\n    32\t}\n    33\t\n    34\t/** The server filters current entitlements and creates the Paddle transaction (ADR-0424). */\n    35\texport function CartCheckoutPanel({ promoCode }: CartCheckoutPanelProps) {\n    36\t  const { items, subtotal, clear } = useCart();\n    37\t  const [notice, setNotice] = useState<string | null>(null);\n    38\t  const [opening, setOpening] = useState(false);\n    39\t  const [error, setError] = useState<string | null>(null);\n    40\t  const configured = isPaddleConfigured();\n    41\t\n    42\t  // G35: clear only when Paddle reports `checkout.completed` — payment actually succeeded — not\n    43\t  // the instant the overlay opens. A buyer who opens the overlay to review the total then cancels\n    44\t  // (or a card decline) now keeps their cart, instead of losing it to an optimistic pre-clear.\n    45\t  useEffect(() => onCheckoutCompleted(clear), [clear]);\n    46\t\n    47\t  async function pay() {\n    48\t    setOpening(true);\n    49\t    setError(null);\n    50\t    setNotice(null);\n    51\t    try {\n    52\t      // Abandoned-checkout capture (SPEC-abandoned-checkout-email.md §(a)): fire-and-forget, NEVER\n    53\t      // awaited into the checkout path — a slow or failed capture must not delay or block\n    54\t      // `Paddle.Checkout.open` below.\n    55\t      void fetchWithTimeout(\n    56\t        \"/api/checkout/started\",\n    57\t        {\n    58\t          method: \"POST\",\n    59\t          headers: { \"content-type\": \"application/json\" },\n    60\t          body: JSON.stringify({\n    61\t            items: items.map((item) => ({ id: item.id, label: item.label })),\n    62\t          }),\n    63\t        },\n    64\t        { timeoutMs: 5_000 },\n    65\t      ).catch(() => {\n    66\t        // Best-effort capture — a missed nudge email is not worth surfacing to the buyer.\n    67\t      });\n    68\t\n    69\t      const response = await fetchWithTimeout(\n    70\t        \"/api/cart/checkout\",\n    71\t        {\n    72\t          method: \"POST\",\n    73\t          headers: { \"content-type\": \"application/json\" },\n    74\t          body: JSON.stringify({\n    75\t            itemIds: items.map((item) => item.id),\n    76\t            ...(promoCode === undefined ? {} : { promoCode }),\n    77\t          }),\n    78\t        },\n    79\t        { timeoutMs: 35_000 },\n    80\t      );\n    81\t      const result: unknown = await response.json();\n    82\t      const parsed = checkoutResponseSchema.safeParse(result);\n    83\t      if (!response.ok || !parsed.success) {\n    84\t        setError(\n    85\t          response.status === 409\n    86\t            ? \"You already own these items. No checkout was created.\"\n    87\t            : \"Checkout is unavailable right now. Please try again.\",\n    88\t        );\n    89\t        return;\n    90\t      }\n    91\t      if (parsed.data.removed.length > 0)\n    92\t        setNotice(\n    93\t          \"Already-owned items were removed from checkout. Review the updated total in Paddle before paying.\",\n    94\t        );\n    95\t      const opened = await openCartTransaction(parsed.data.transactionId);\n    96\t      // The Paddle overlay owns the rest of the flow once it opens — the cart clears on the\n    97\t      // `checkout.completed` event (the useEffect above), not here.\n    98\t      if (!opened) {\n    99\t        setError(\"Checkout is unavailable right now. Please try again.\");\n   100\t      }\n   101\t    } catch {\n   102\t      // G6: getPaddle() now surfaces a load/init failure instead of silently poisoning the\n   103\t      // session — give the buyer a real, actionable message instead of a button that just reverts.\n   104\t      setError(\n   105\t        \"Checkout failed to load. Check your connection or ad-blocker, then try again.\",\n   106\t      );\n   107\t    } finally {\n   108\t      setOpening(false);\n   109\t    }\n   110\t  }\n   111\t\n   112\t  return (\n   113\t    <div\n   114\t      style={{ display: \"grid\", gap: \"var(--cs-space-6)\", maxWidth: \"36rem\" }}\n   115\t    >\n   116\t      <div>\n   117\t        <h1\n   118\t          className=\"cs-card-title\"\n   119\t          style={{ fontSize: \"var(--cs-text-2xl)\" }}\n   120\t        >\n   121\t          Checkout\n   122\t        </h1>\n   123\t        {items.length > 0 ? (\n   124\t          <p className=\"cs-muted\" style={{ marginTop: \"var(--cs-space-2)\" }}>\n   125\t            {items.length} item{items.length === 1 ? \"\" : \"s\"}. One Paddle\n   126\t            checkout for the whole cart.\n   127\t          </p>\n   128\t        ) : null}\n   129\t      </div>\n   130\t\n   131\t      {items.length === 0 ? (\n   132\t        <EmptyState\n   133\t          icon=\"cart\"\n   134\t          title=\"Your cart is empty\"\n   135\t          description=\"Add a bundle or a module from the marketplace to start a checkout.\"\n   136\t          action={\n   137\t            <Button asChild variant=\"primary\">\n   138\t              <Link href=\"/marketplace\">Browse the marketplace</Link>\n   139\t            </Button>\n   140\t          }\n   141\t        />\n   142\t      ) : (\n   143\t        <>\n   144\t          <ul\n   145\t            style={{\n   146\t              margin: 0,\n   147\t              padding: 0,\n   148\t              listStyle: \"none\",\n   149\t              display: \"grid\",\n   150\t              gap: \"var(--cs-space-2)\",\n   151\t            }}\n   152\t          >\n   153\t            {items.map((item) => (\n   154\t              <li\n   155\t                key={item.id}\n   156\t                style={{\n   157\t                  display: \"flex\",\n   158\t                  justifyContent: \"space-between\",\n   159\t                  fontSize: \"var(--cs-text-sm)\",\n   160\t                }}\n   161\t              >\n   162\t                <span>{item.label}</span>\n   163\t                <span\n   164\t                  className=\"cs-num\"\n   165\t                  style={{ fontFamily: \"var(--cs-font-mono)\" }}\n   166\t                >\n   167\t                  {formatUsd(item.amount)}\n   168\t                </span>\n   169\t              </li>\n   170\t            ))}\n   171\t          </ul>\n   172\t\n   173\t          <div\n   174\t            style={{\n   175\t              display: \"flex\",\n   176\t              justifyContent: \"space-between\",\n   177\t              borderTop: \"1px solid var(--cs-border)\",\n   178\t              paddingTop: \"var(--cs-space-3)\",\n   179\t            }}\n   180\t          >\n   181\t            <span className=\"cs-card-title\">Total</span>\n   182\t            <span\n   183\t              className=\"cs-num\"\n   184\t              style={{\n   185\t                fontFamily: \"var(--cs-font-mono)\",\n   186\t                fontSize: \"var(--cs-text-lg)\",\n   187\t              }}\n   188\t            >\n   189\t              {formatUsd(subtotal)}\n   190\t            </span>\n   191\t          </div>\n   192\t\n   193\t          <Button\n   194\t            type=\"button\"\n   195\t            variant=\"primary\"\n   196\t            disabled={!configured || opening}\n   197\t            onClick={() => void pay()}\n   198\t          >\n   199\t            {!configured\n   200\t              ? \"Checkout unavailable\"\n   201\t              : opening\n   202\t                ? \"Opening…\"\n   203\t                : \"Pay now\"}\n   204\t          </Button>\n   205\t\n   206\t          {notice !== null && (\n   207\t            <p role=\"status\" className=\"cs-footnote\">\n   208\t              {notice}\n   209\t            </p>\n   210\t          )}\n   211\t          {error !== null && (\n   212\t            <p className=\"cs-footnote\" style={{ color: \"var(--cs-danger)\" }}>\n   213\t              {error}\n   214\t            </p>\n   215\t          )}\n   216\t\n   217\t          <p className=\"cs-footnote\">{PADDLE_MOR_DISCLOSURE}</p>\n   218\t        </>\n   219\t      )}\n   220\t    </div>\n   221\t  );\n   222\t}\n","exit_code":0,"status":"completed"}}
