{"type":"item.completed","item":{"id":"item_76","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/lib/catalog.ts'","aggregated_output":"     1\t// Bridges the marketing PRICE DISPLAY (`lib/pricing.ts`) to a cart/checkout-ready catalog: every\n     2\t// sellable one-time item (the 6 bundles and the 27 à-la-carte modules) carries the Paddle price id\n     3\t// the cart's multi-item checkout passes to `Paddle.Checkout.open()`.\n     4\t//\n     5\t// CART IDS ARE KIND-NAMESPACED (`bundle:<slug>` / `module:<slug>`). A bundle id can collide with a\n     6\t// module-adjacent name, so the namespace keeps the cart's id-dedup and the grid lookups kind-scoped\n     7\t// by construction (`bundleCatalogItem` / `moduleCatalogItem`), never a bare-slug search.\n     8\t//\n     9\t// Bundles + modules map to the REAL Paddle sandbox price ids `@caisson/pricebook`'s PURCHASE_BOOK\n    10\t// carries (the W7 catalog big-bang section; the original 11 modules from the 2026-07-02 module-SKU\n    11\t// wiring). `resolvePurchase` throws fail-closed on an unresolved id (ADR-0089 §6 / ADR-0113), so a\n    12\t// mismatched id reaching production grants nothing rather than silently succeeding. The retired\n    13\t// edition-era ids (4 editions + the legacy $1,499 bundle) are absent — their Paddle products are\n    14\t// archived, and `pruneCart` drops any persisted cart line still carrying one. This file is\n    15\t// display + cart wiring only, not a source of commerce truth.\n    16\timport type { CartItem } from \"./cart\";\n    17\timport { type BundleId, BUNDLE_PRICES, MODULE_PRICES } from \"./pricing\";\n    18\t\n    19\texport type CatalogKind = \"module\" | \"bundle\";\n    20\t\n    21\texport interface CatalogItem {\n    22\t  /** Stable, KIND-NAMESPACED cart key (`bundle:<slug>` / `module:<slug>`) — also the Plausible\n    23\t   *  event prop and the React list key. */\n    24\t  id: string;\n    25\t  kind: CatalogKind;\n    26\t  label: string;\n    27\t  /** Integer display USD. */\n    28\t  amount: number;\n    29\t  /** The real Paddle sandbox price id the pricebook's PURCHASE_BOOK resolves this item against\n    30\t   *  (see the file header). */\n    31\t  priceId: string;\n    32\t  blurb: string;\n    33\t}\n    34\t\n    35\t/** Bundle id -> the pricebook's REAL Paddle price id (`purchases.ts`, W7 catalog big-bang rows —\n    36\t *  each grants the CANONICAL bundle entitlement id). A `Record` over the closed `BundleId` union,\n    37\t *  not an open index signature — every bundle MUST resolve, so a future 7th bundle added to\n    38\t *  `pricing.ts` without a row here is a compile error, not a silent `undefined` at checkout time. */\n    39\tconst BUNDLE_PRICE_IDS: Record<BundleId, string> = {\n    40\t  compliance: \"pri_01kyeczreqq58ze5en0p3f0jkc\",\n    41\t  \"ai-production\": \"pri_01kwwqa2rcxtn8pt3dr3jdnnf0\",\n    42\t  \"local-first\": \"pri_01kwwqa2xp3jp1qww2j5ya0meh\",\n    43\t  \"agentic-dev\": \"pri_01kwwqa332mweg8veaarkygbae\",\n    44\t  provenance: \"pri_01kwwqa3872cs4c53w8qhhz31k\",\n    45\t  everything: \"pri_01kyeczrjj0tzpwg7tv752e42s\",\n    46\t};\n    47\t\n    48\t/** À-la-carte module slug -> the pricebook's REAL Paddle price id (`purchases.ts`'s per-module REAL\n    49\t *  section, module-SKU wiring 2026-07-02). MUST match the same slug's row there EXACTLY — the cart\n    50\t *  passes this `priceId` to Paddle, and the webhook resolves that same id in PURCHASE_BOOK to grant\n    51\t *  the entitlement (ADR-0071/0113); a mismatch fails resolvePurchase closed and a module purchase\n    52\t *  grants NOTHING. Keyed by every id `pricing.ts`'s MODULE_PRICES carries; `moduleRealPriceId` below\n    53\t *  throws if a future module is added there without a matching row here — the runtime mirror of the\n    54\t *  `BUNDLE_PRICE_IDS` `Record<BundleId, string>` compile-time guard above (module ids aren't a\n    55\t *  closed union, so the check runs at catalog build time instead of at `tsc`). (catalog.test.ts pins\n    56\t *  the cross-package invariant against PURCHASE_BOOK.) */\n    57\tconst MODULE_PRICE_IDS: Record<string, string> = {\n    58\t  // The four dropped edition-core rows' sandbox price ids (pri_01kwj6m31f…, pri_01kwj6m55y…,\n    59\t  // pri_01kwj6m5mz…, pri_01kwj6m6cb…) are retired with their rows (ADR-0238) — the products sit\n    60\t  // orphaned in the Paddle SANDBOX, which never ports to production (ADR-0227).\n    61\t  \"field-crypto\": \"pri_01kwj6m3cwez98t45jzwsqb250\",\n    62\t  \"audit-worm\": \"pri_01kwj6m3mjq4rpv7918rhfhrhw\",\n    63\t  \"retention-runner\": \"pri_01kwj6m3x1cw1k54tcdhsc6pgj\",\n    64\t  \"ai-meter\": \"pri_01kwj6m45zeqyxgad3f32x1b30\",\n    65\t  \"ai-evals\": \"pri_01kwj6m4d3npk8sszerx7fek7w\",\n    66\t  guardrails: \"pri_01kwj6m4n105qe80fapw9sk5xc\",\n    67\t  \"prompt-registry\": \"pri_01kwj6m4whyw1stbej2qk8q0bg\",\n    68\t  alerting: \"pri_01kwj6m5da9ay3z85b6qwtjcpe\",\n    69\t  \"local-store\": \"pri_01kwj6m5w3s4fmvseap7zmp5yf\",\n    70\t  \"agent-kernel\": \"pri_01kwj6m63qpt52489tq5a3v6q3\",\n    71\t  \"agent-runner\": \"pri_01kwj71a53hycbspsfv8pck5vc\",\n    72\t  // agent-trajectory joined the catalog 2026-07-18 (agent-runtime wave) — created via\n    73\t  // tools/paddle-catalog-recreate.ts against the sandbox, marker custom_data.caisson_id.\n    74\t  \"agent-trajectory\": \"pri_01kxvpjjx55q4cf21cwjbjhwv5\",\n    75\t  // The compliance-gap trio joined the catalog 2026-07-20 (SKU-arming wave) — created via\n    76\t  // tools/paddle-catalog-recreate.ts against the sandbox, marker custom_data.caisson_key.\n    77\t  \"access-review\": \"pri_01ky0fgqdwpf6yaxzeef03q88e\",\n    78\t  \"risk-register\": \"pri_01ky0fgqk5d855hfjdngjrvj89\",\n    79\t  \"trust-page\": \"pri_01ky0fgqqzmfbm2406q4rys44e\",\n    80\t  // Twelve rows: the 11 carve/standalone SKUs from the W7 catalog big-bang, each matched\n    81\t  // one-for-one against the pricebook's W7 PURCHASE_BOOK rows, plus the later oscal-spine carve.\n    82\t  \"compliance-core\": \"pri_01kwwqa0k69m965tx8hgsv904h\",\n    83\t  \"frameworks-pack\": \"pri_01kwwqa0rkz3etv2yfd6c7jjad\",\n    84\t  \"oscal-spine\": \"pri_01kye9597z46149qg5xfrqxybk\",\n    85\t  \"signing-primitive\": \"pri_01kwwqa0y1hn63taahdh7y03vf\",\n    86\t  credits: \"pri_01kwwqa1413c33yfsrvjb4r34a\",\n    87\t  \"local-sync\": \"pri_01kwwqa1b33ycmh114440xc6re\",\n    88\t  \"local-inference\": \"pri_01kwwqa1gvkpj7g0jfna7h2qcr\",\n    89\t  \"local-privacy\": \"pri_01kwwqa1p152hskczw7daszzgn\",\n    90\t  \"tool-exec\": \"pri_01kwwqa1v2gm7cr5g1rpzyk522\",\n    91\t  \"org-controls\": \"pri_01kwwqa20m42dmedx9mprk085k\",\n    92\t  \"billing-orchestration\": \"pri_01kwwqa266p6smw4yaanxg1n5j\",\n    93\t  \"ui-pro\": \"pri_01kwwqa2c799fpe1af76p75r7r\",\n    94\t};\n    95\t\n    96\tfunction bundleCartId(slug: string): string {\n    97\t  return `bundle:${slug}`;\n    98\t}\n    99\t\n   100\tfunction moduleCartId(slug: string): string {\n   101\t  return `module:${slug}`;\n   102\t}\n   103\t\n   104\tfunction moduleRealPriceId(moduleId: string): string {\n   105\t  const priceId = MODULE_PRICE_IDS[moduleId];\n   106\t  if (!priceId) {\n   107\t    throw new Error(\n   108\t      `catalog.ts: no Paddle price id wired in MODULE_PRICE_IDS for module \"${moduleId}\"`,\n   109\t    );\n   110\t  }\n   111\t  return priceId;\n   112\t}\n   113\t\n   114\t/** The six bundles as cart-ready catalog items, each carrying its real Paddle price id. */\n   115\texport const BUNDLE_CATALOG: readonly CatalogItem[] = BUNDLE_PRICES.map((p) => {\n   116\t  if (p.amount === null) {\n   117\t    throw new Error(`catalog.ts: bundle \"${p.id}\" has no committed amount`);\n   118\t  }\n   119\t  return {\n   120\t    id: bundleCartId(p.id),\n   121\t    kind: \"bundle\" as const,\n   122\t    label: p.label,\n   123\t    amount: p.amount,\n   124\t    priceId: BUNDLE_PRICE_IDS[p.id],\n   125\t    blurb: p.note,\n   126\t  };\n   127\t});\n   128\t\n   129\t/** Every à-la-carte module as a cart-ready catalog item. Post-W7 every sellable SKU is\n   130\t *  Paddle-wired, so this is a straight map — a module added to `pricing.ts` without a\n   131\t *  `MODULE_PRICE_IDS` row fails the build via `moduleRealPriceId`'s fail-closed throw (never a\n   132\t *  silently unpurchasable card). */\n   133\texport const MODULE_CATALOG: readonly CatalogItem[] = MODULE_PRICES.map(\n   134\t  (m) => ({\n   135\t    id: moduleCartId(m.id),\n   136\t    kind: \"module\" as const,\n   137\t    label: m.label,\n   138\t    amount: m.amount,\n   139\t    priceId: moduleRealPriceId(m.id),\n   140\t    blurb: m.blurb,\n   141\t  }),\n   142\t);\n   143\t\n   144\t/** Every Paddle price id the live catalog can sell — the hydration allowlist for\n   145\t *  `lib/cart.ts` `pruneCart` (a persisted cart line carrying a retired id — the four ADR-0238\n   146\t *  edition-core rows, the 4 archived editions, or the legacy $1,499 bundle — is dropped before it\n   147\t *  can reach checkout). */\n   148\texport const LIVE_PRICE_IDS: ReadonlySet<string> = new Set(\n   149\t  [...BUNDLE_CATALOG, ...MODULE_CATALOG].map((c) => c.priceId),\n   150\t);\n   151\t\n   152\t/** The cart-ready catalog item for a bundle slug (`compliance`, `everything`, …). */\n   153\texport function bundleCatalogItem(slug: string): CatalogItem | undefined {\n   154\t  return BUNDLE_CATALOG.find((c) => c.id === bundleCartId(slug));\n   155\t}\n   156\t\n   157\t/** The cart-ready catalog item for a module slug (`field-crypto`, `ai-meter`, …). */\n   158\texport function moduleCatalogItem(slug: string): CatalogItem | undefined {\n   159\t  return MODULE_CATALOG.find((c) => c.id === moduleCartId(slug));\n   160\t}\n   161\t\n   162\t/** Project a catalog item down to the `CartItem` shape the cart persists (drops `blurb`). */\n   163\texport function toCartItem(item: CatalogItem): CartItem {\n   164\t  return {\n   165\t    id: item.id,\n   166\t    priceId: item.priceId,\n   167\t    label: item.label,\n   168\t    amount: item.amount,\n   169\t    kind: item.kind,\n   170\t  };\n   171\t}\n","exit_code":0,"status":"completed"}}
