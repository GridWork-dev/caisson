{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/lib/paddle-checkout.ts'","aggregated_output":"     1\t// Client-side Paddle.js checkout (ADR-0116). Opens the Paddle overlay for a given price id;\n     2\t// env-gated on `NEXT_PUBLIC_PADDLE_CLIENT_TOKEN` + `NEXT_PUBLIC_PADDLE_ENV` — ONLY the client\n     3\t// token is ever exposed here, never the server API key (that stays server-side, in the future\n     4\t// `services/license` webhook driver). The grant itself is server-side via the existing webhook ->\n     5\t// services/license -> pricebook path (apply-billing-event.ts); this module's job ends at opening\n     6\t// checkout. \"use client\" — Paddle.js runs in the browser only.\n     7\t\"use client\";\n     8\t\n     9\timport {\n    10\t  CheckoutEventNames,\n    11\t  type Paddle,\n    12\t  type PaddleEventData,\n    13\t  initializePaddle,\n    14\t} from \"@paddle/paddle-js\";\n    15\t\n    16\timport { trackEvent } from \"./analytics\";\n    17\t\n    18\tlet paddleInstance: Paddle | undefined;\n    19\tlet paddleInitPromise: Promise<Paddle | undefined> | undefined;\n    20\t\n    21\t// G35: fired only once payment actually succeeds (never on overlay-open, never on cancel).\n    22\t// Paddle.js accepts exactly ONE `eventCallback` per `Initialize()` call (a global slot, not\n    23\t// per-`Checkout.open()`), so this module fans that single callback out to N listeners.\n    24\tconst completedListeners = new Set<() => void>();\n    25\t\n    26\tfunction handlePaddleEvent(event: PaddleEventData): void {\n    27\t  if (event.name === CheckoutEventNames.CHECKOUT_COMPLETED) {\n    28\t    for (const listener of completedListeners) listener();\n    29\t  }\n    30\t}\n    31\t\n    32\t/**\n    33\t * Register a callback for the Paddle `checkout.completed` event (G35 — the cart previously\n    34\t * cleared the instant the overlay OPENED, losing the buyer's lines on a cancel too). Returns an\n    35\t * unregister function; safe to call before Paddle has initialized — the listener just waits.\n    36\t */\n    37\texport function onCheckoutCompleted(listener: () => void): () => void {\n    38\t  completedListeners.add(listener);\n    39\t  return () => completedListeners.delete(listener);\n    40\t}\n    41\t\n    42\tfunction paddleEnv(): \"sandbox\" | \"production\" {\n    43\t  return process.env.NEXT_PUBLIC_PADDLE_ENV === \"production\"\n    44\t    ? \"production\"\n    45\t    : \"sandbox\";\n    46\t}\n    47\t\n    48\t/**\n    49\t * Lazily initialize the Paddle.js instance once per page load. Returns `undefined` when\n    50\t * `NEXT_PUBLIC_PADDLE_CLIENT_TOKEN` is unset (inert seam, same pattern as every other\n    51\t * provider port — Resend, Plausible, OTel) so a checkout button can no-op gracefully rather than\n    52\t * throw in an environment with no Paddle account configured yet.\n    53\t *\n    54\t * G6: a load/init failure (ad-blocker, network, bad token) used to memoize the REJECTED promise\n    55\t * forever — a `Promise` is truthy regardless of settled state, so `if (!paddleInitPromise)` never\n    56\t * re-ran `initializePaddle()` again, permanently poisoning checkout for the rest of the session.\n    57\t * The `.catch()` below resets the memo to `undefined` on failure (so the NEXT call gets a fresh\n    58\t * `initializePaddle()`) and re-throws so a caller can surface a real error instead of silently\n    59\t * reverting.\n    60\t */\n    61\tasync function getPaddle(): Promise<Paddle | undefined> {\n    62\t  if (paddleInstance) return paddleInstance;\n    63\t  const token = process.env.NEXT_PUBLIC_PADDLE_CLIENT_TOKEN;\n    64\t  if (token === undefined || token.length === 0) return undefined;\n    65\t  if (!paddleInitPromise) {\n    66\t    paddleInitPromise = initializePaddle({\n    67\t      token,\n    68\t      environment: paddleEnv(),\n    69\t      eventCallback: handlePaddleEvent,\n    70\t    })\n    71\t      .then((paddle) => {\n    72\t        paddleInstance = paddle;\n    73\t        return paddle;\n    74\t      })\n    75\t      .catch((err: unknown) => {\n    76\t        paddleInitPromise = undefined;\n    77\t        throw err;\n    78\t      });\n    79\t  }\n    80\t  return paddleInitPromise;\n    81\t}\n    82\t\n    83\texport interface OpenCheckoutOptions {\n    84\t  /** A real Paddle price id (`pri_…`), e.g. from `@caisson/pricebook`'s PURCHASE_BOOK/PLAN_BOOK keys. */\n    85\t  priceId: string;\n    86\t  /** The buyer's account id — stamped as `custom_data.account_id`, the SAME key the webhook's\n    87\t   * `parsePaddleEvent` reads (paddle-events.ts `readAccountId`) so the grant resolves the tenant. */\n    88\t  accountId: string;\n    89\t}\n    90\t\n    91\t/** One line of a multi-item checkout — quantity defaults to 1 (every SKU this site sells is a\n    92\t *  perpetual per-buyer license, never a stackable quantity). */\n    93\texport interface CartCheckoutItem {\n    94\t  priceId: string;\n    95\t  quantity?: number;\n    96\t}\n    97\t\n    98\t/**\n    99\t * Open ONE Paddle.js checkout overlay for every line passed in `items` (confirmed against the\n   100\t * Paddle.js docs: `Checkout.open({ items: [...] })` already accepts a multi-item list — this is\n   101\t * the same call `openCheckout` makes below with a single-entry array, just generalized). A buyer\n   102\t * with N cart lines pays once, not N times. Same no-op-when-unconfigured contract as\n   103\t * `openCheckout`, and the same `custom_data.account_id` convention the webhook's\n   104\t * `parsePaddleEvent` reads to resolve the tenant.\n   105\t *\n   106\t * `discountCode` (SPEC-abandoned-checkout-email.md's discount fork, 2026-07-10 lock) is the\n   107\t * caller-validated `?promo=` search param — passed straight through to Paddle.js's own\n   108\t * `discountCode` checkout-open option (confirmed against developer.paddle.com: `Checkout.open`\n   109\t * accepts `discountCode` as a top-level option alongside `items`/`customData`). Omitted when\n   110\t * `undefined` — an unset discount is simply not part of the call, never a stray empty string.\n   111\t */\n   112\texport async function openCartCheckout(\n   113\t  items: readonly CartCheckoutItem[],\n   114\t  accountId: string,\n   115\t  discountCode?: string,\n   116\t): Promise<boolean> {\n   117\t  if (items.length === 0) return false;\n   118\t  const paddle = await getPaddle();\n   119\t  if (!paddle) return false;\n   120\t  // begin_checkout (ADR-0237 F8) — fired only after the two no-op guards, so the funnel never\n   121\t  // counts a click Paddle ignored.\n   122\t  trackEvent(\"begin_checkout\", { items: String(items.length) });\n   123\t  paddle.Checkout.open({\n   124\t    items: items.map((item) => ({\n   125\t      priceId: item.priceId,\n   126\t      quantity: item.quantity ?? 1,\n   127\t    })),\n   128\t    customData: { account_id: accountId },\n   129\t    // Surface the business-name + tax/VAT-ID field so EU B2B buyers can enter a VAT number and get\n   130\t    // the reverse-charge treatment at checkout rather than a post-purchase revision. `showAddTaxId`\n   131\t    // defaults to `true` in Paddle.js, but we set it explicitly so the behaviour is pinned here and\n   132\t    // survives a future default change (Paddle checkout settings, `showAddTaxId`).\n   133\t    settings: { showAddTaxId: true },\n   134\t    ...(discountCode !== undefined ? { discountCode } : {}),\n   135\t  });\n   136\t  return true;\n   137\t}\n   138\t\n   139\t/**\n   140\t * Open the Paddle.js checkout overlay for a single `priceId`. A no-op (resolves `false`) when\n   141\t * Paddle is not configured for this environment — callers should disable/hide the buy button in\n   142\t * that case rather than rely on this throwing. A thin single-item convenience over\n   143\t * `openCartCheckout`.\n   144\t */\n   145\texport async function openCheckout(\n   146\t  options: OpenCheckoutOptions,\n   147\t): Promise<boolean> {\n   148\t  return openCartCheckout(\n   149\t    [{ priceId: options.priceId, quantity: 1 }],\n   150\t    options.accountId,\n   151\t  );\n   152\t}\n   153\t\n   154\t/** Whether Paddle checkout is configured in this environment (for conditionally rendering CTAs). */\n   155\texport function isPaddleConfigured(): boolean {\n   156\t  return (process.env.NEXT_PUBLIC_PADDLE_CLIENT_TOKEN?.length ?? 0) > 0;\n   157\t}\n   158\t\n   159\t/** Open only the transaction whose lines/account the server validated (ADR-0424). */\n   160\texport async function openCartTransaction(\n   161\t  transactionId: string,\n   162\t): Promise<boolean> {\n   163\t  if (!/^txn_[a-z0-9]{26}$/.test(transactionId)) return false;\n   164\t  const paddle = await getPaddle();\n   165\t  if (!paddle) return false;\n   166\t  trackEvent(\"begin_checkout\", { source: \"server-cart\" });\n   167\t  paddle.Checkout.open({ transactionId, settings: { showAddTaxId: true } });\n   168\t  return true;\n   169\t}\n","exit_code":0,"status":"completed"}}
