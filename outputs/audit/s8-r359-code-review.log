{"type":"item.completed","item":{"id":"item_72","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/components/schematic-sheets-guard.tsx'","aggregated_output":"     1\timport { Boundary, Flow, Sheet, SNode, TitleBlock } from \"./schematics\";\n     2\timport styles from \"./schematics.module.css\";\n     3\t\n     4\t// Guard-surface blueprint sheets (ADR-0377, executing ADR-0378 lock 1 migrate-all). Same hairline\n     5\t// blueprint-linework register as FieldCryptoSheet / AuditWormSheet in ./schematics.tsx: every\n     6\t// name is verbatim from the package it depicts, drawn subsets are declared on-sheet where a\n     7\t// package exposes more than is drawn, and each sheet carries exactly ONE semantic accent element\n     8\t// (the Boundary — the fail-closed gate the sheet is about). These four replace the legacy\n     9\t// marketplace-diagrams.tsx mechanism diagrams for the same packages (ToolExecGate, PrivacyGate,\n    10\t// OrgControlsMutation, RetentionErasure).\n    11\t\n    12\t// ===== module:tool-exec — the default-deny allowlist gate before execFile spawns anything =====\n    13\t// Names from src/tool-exec.ts: run(name, args, reason?) looks the name up in the registry (a\n    14\t// Map<name, CommandSpec> built from ToolExecConfig.allowlist) — an unregistered name throws\n    15\t// NotFoundError. The matched CommandSpec's argsSchema validates args via parseStrict BEFORE\n    16\t// anything spawns — a bad shape throws ValidationError. Only then does execFile(command, argv)\n    17\t// run — never execSync, never shell:true, the validated args ARE the argv array. propose()/\n    18\t// execute() (ADR-0360 S3) split that same lookup+validate from the actual spawn: propose() parks\n    19\t// a digest-bound ToolApproval backed by a private record (ADR-0423); execute() consumes it once,\n    20\t// checks current policy, revalidates the original input, and checks the resulting argv digest.\n    21\texport function ToolExecSheet() {\n    22\t  return (\n    23\t    <Sheet\n    24\t      title=\"tool-exec: a default-deny allowlist validates argv against a Zod-strict schema before execFile ever spawns it, and propose/execute splits that validation from the actual spawn\"\n    25\t      bar=\"packages/tool-exec · allowlist gate, execFile argv, propose/execute\"\n    26\t    >\n    27\t      <SNode x={8} y={10} w={92} h={26} head=\"run(name, args)\" sub=\"reason?\" />\n    28\t      <Flow x1={100} y1={23} x2={114} y2={23} />\n    29\t      <SNode\n    30\t        x={114}\n    31\t        y={10}\n    32\t        w={100}\n    33\t        h={26}\n    34\t        head=\"registry.get\"\n    35\t        sub=\"CommandSpec\"\n    36\t      />\n    37\t      <Flow x1={214} y1={23} x2={228} y2={23} />\n    38\t      <SNode\n    39\t        x={228}\n    40\t        y={10}\n    41\t        w={104}\n    42\t        h={26}\n    43\t        head=\"parseStrict\"\n    44\t        sub=\"argsSchema\"\n    45\t      />\n    46\t      <text x={8} y={48} className={styles.noteDanger}>\n    47\t        no entry ⇒ NotFoundError\n    48\t      </text>\n    49\t      <text x={8} y={58} className={styles.noteDanger}>\n    50\t        bad shape ⇒ ValidationError\n    51\t      </text>\n    52\t      {/* the ONE accent element: the actual spawn gate */}\n    53\t      <Flow x1={280} y1={36} x2={280} y2={66} />\n    54\t      <Boundary x={148} y={66} w={182} h={48} label=\"execFile · argv array\" />\n    55\t      <SNode\n    56\t        x={164}\n    57\t        y={84}\n    58\t        w={150}\n    59\t        h={24}\n    60\t        head=\"execFile(cmd, argv)\"\n    61\t        sub=\"never a shell\"\n    62\t      />\n    63\t      <text x={8} y={130} className={styles.note}>\n    64\t        never execSync or shell:true, argv only\n    65\t      </text>\n    66\t      <SNode x={8} y={138} w={78} h={26} head=\"propose()\" sub=\"validate only\" />\n    67\t      <Flow x1={86} y1={151} x2={100} y2={151} />\n    68\t      <SNode\n    69\t        x={100}\n    70\t        y={136}\n    71\t        w={134}\n    72\t        h={30}\n    73\t        head=\"ToolApproval\"\n    74\t        sub=\"digest · stored\"\n    75\t      />\n    76\t      <Flow x1={234} y1={151} x2={248} y2={151} />\n    77\t      <SNode x={248} y={138} w={80} h={26} head=\"execute()\" sub=\"revalidates\" />\n    78\t      <TitleBlock x={198} y={168} w={130} text=\"TOOL-EXEC · 1/1\" />\n    79\t    </Sheet>\n    80\t  );\n    81\t}\n    82\t\n    83\t// ===== module:local-privacy — the default-deny egress gate, fail-closed to offline =====\n    84\t// Names from src/egress-guard.ts + src/policy.ts: EgressGuard.assertAllowed(url) is the one check\n    85\t// every outbound request crosses before fetch()/fetchAs() ever reaches fetchWithTimeout — the\n    86\t// kernel's single audited outbound chokepoint. It fails closed on a non-https scheme (AuthzError)\n    87\t// and on a host absent from the PrivacyPolicy allowlist (AuthzError; an empty allowlist means the\n    88\t// branch always fires, so zero egress is the default, not a config choice). assertAllowedFor(url,\n    89\t// kind) adds purpose-binding: a host must be allowlisted for one of the two closed\n    90\t// SANCTIONED_SINK_KINDS specifically, so a key sanctioned for one sink can never reach the other.\n    91\texport function LocalPrivacySheet() {\n    92\t  return (\n    93\t    <Sheet\n    94\t      title=\"local-privacy: assertAllowed enforces https and an allowlisted host before any request crosses fetchWithTimeout; an empty allowlist blocks every host by construction\"\n    95\t      bar=\"packages/local-privacy · egress-guard, allowlist, sanctioned sinks\"\n    96\t    >\n    97\t      <SNode\n    98\t        x={8}\n    99\t        y={10}\n   100\t        w={110}\n   101\t        h={26}\n   102\t        head=\"fetch(url, init)\"\n   103\t        sub=\"or fetchAs(kind)\"\n   104\t      />\n   105\t      <Flow x1={118} y1={23} x2={132} y2={23} />\n   106\t      {/* the ONE accent element: the egress gate itself */}\n   107\t      <Boundary x={132} y={8} w={196} h={54} label=\"assertAllowed(url)\" />\n   108\t      <SNode x={144} y={26} w={80} h={22} head=\"https: only\" />\n   109\t      <SNode x={232} y={26} w={88} h={22} head=\"host allowlisted\" />\n   110\t      <Flow x1={230} y1={62} x2={230} y2={98} />\n   111\t      <text x={8} y={76} className={styles.noteDanger}>\n   112\t        non-https ⇒ AuthzError\n   113\t      </text>\n   114\t      <text x={8} y={86} className={styles.noteDanger}>\n   115\t        host not allowlisted ⇒ AuthzError\n   116\t      </text>\n   117\t      <SNode\n   118\t        x={150}\n   119\t        y={98}\n   120\t        w={180}\n   121\t        h={24}\n   122\t        head=\"fetchWithTimeout\"\n   123\t        sub=\"the ONE outbound seam\"\n   124\t      />\n   125\t      <text x={8} y={134} className={styles.note}>\n   126\t        empty allowlist ⇒ zero egress, no fallback\n   127\t      </text>\n   128\t      <SNode\n   129\t        x={8}\n   130\t        y={140}\n   131\t        w={150}\n   132\t        h={24}\n   133\t        head=\"model-fetch\"\n   134\t        sub=\"ONNX host, hash-pinned\"\n   135\t      />\n   136\t      <SNode\n   137\t        x={166}\n   138\t        y={140}\n   139\t        w={160}\n   140\t        h={24}\n   141\t        head=\"rented-backend\"\n   142\t        sub=\"opt-in, off by default\"\n   143\t      />\n   144\t      <TitleBlock x={190} y={168} w={140} text=\"LOCAL-PRIVACY · 1/1\" />\n   145\t    </Sheet>\n   146\t  );\n   147\t}\n   148\t\n   149\t// ===== module:org-controls — the owner-gated cross-tenant write role, plus WorkOS SSO =====\n   150\t// Names from src/admin-write.ts + src/workos.ts + src/membership.ts: assertCanManageMembers\n   151\t// throws AuthzError unless the caller's role is \"owner\". withAdminWrite opens a transaction and\n   152\t// SET LOCAL ROLE admin_write for its life, but only after a fail-closed pre-flight refuses a\n   153\t// SUPERUSER or BYPASSRLS role (the same class of bug FORCE ROW LEVEL SECURITY guards against).\n   154\t// The role's own RLS policy (buildAdminWritePolicySql) is `TO admin_write USING (true) WITH CHECK\n   155\t// (true)`, granting SELECT/INSERT/UPDATE only, never DELETE — the mutation surface soft-revokes.\n   156\t// createWorkosSsoProvider's authorizationUrl/exchangeCode drive the sign-in half of SSO only.\n   157\texport function OrgControlsSheet() {\n   158\t  return (\n   159\t    <Sheet\n   160\t      title=\"org-controls: assertCanManageMembers gates every seat mutation on the caller's role; withAdminWrite crosses into a role-scoped RLS policy only after a SUPERUSER or BYPASSRLS role is refused\"\n   161\t      bar=\"packages/org-controls · admin-write RLS, role guard, WorkOS SSO\"\n   162\t    >\n   163\t      <SNode\n   164\t        x={8}\n   165\t        y={10}\n   166\t        w={132}\n   167\t        h={26}\n   168\t        head=\"assertCanManageMembers\"\n   169\t        sub=\"role === owner?\"\n   170\t      />\n   171\t      <Flow x1={140} y1={23} x2={154} y2={23} />\n   172\t      {/* the ONE accent element: the cross-tenant write role gate */}\n   173\t      <Boundary x={154} y={8} w={176} h={58} label=\"withAdminWrite(db, fn)\" />\n   174\t      <SNode\n   175\t        x={166}\n   176\t        y={24}\n   177\t        w={152}\n   178\t        h={24}\n   179\t        head=\"SET LOCAL ROLE\"\n   180\t        sub=\"admin_write\"\n   181\t      />\n   182\t      <text x={8} y={48} className={styles.noteDanger}>\n   183\t        not owner ⇒ AuthzError\n   184\t      </text>\n   185\t      <text x={8} y={76} className={styles.noteDanger}>\n   186\t        SUPERUSER / BYPASSRLS ⇒ refused\n   187\t      </text>\n   188\t      <Flow x1={242} y1={66} x2={242} y2={90} />\n   189\t      <SNode\n   190\t        x={158}\n   191\t        y={90}\n   192\t        w={168}\n   193\t        h={24}\n   194\t        head=\"TO admin_write\"\n   195\t        sub=\"USING(true) WITH CHECK(true)\"\n   196\t      />\n   197\t      <text x={8} y={128} className={styles.note}>\n   198\t        GRANT SELECT/INSERT/UPDATE, no DELETE\n   199\t      </text>\n   200\t      <SNode\n   201\t        x={8}\n   202\t        y={136}\n   203\t        w={104}\n   204\t        h={26}\n   205\t        head=\"authorizationUrl\"\n   206\t        sub=\"AuthKit / connection\"\n   207\t      />\n   208\t      <Flow x1={112} y1={149} x2={126} y2={149} />\n   209\t      <SNode\n   210\t        x={126}\n   211\t        y={136}\n   212\t        w={100}\n   213\t        h={26}\n   214\t        head=\"exchangeCode\"\n   215\t        sub=\"POST /sso/token\"\n   216\t      />\n   217\t      <Flow x1={226} y1={149} x2={240} y2={149} />\n   218\t      <SNode\n   219\t        x={240}\n   220\t        y={134}\n   221\t        w={88}\n   222\t        h={30}\n   223\t        head=\"WorkosSsoProfile\"\n   224\t        sub=\"userId · email\"\n   225\t      />\n   226\t      <TitleBlock x={198} y={168} w={132} text=\"ORG-CONTROLS · 1/1\" />\n   227\t    </Sheet>\n   228\t  );\n   229\t}\n   230\t\n   231\t// ===== module:retention-runner — per-target error isolation, one reason-tagged audit row =====\n   232\t// Names from src/run-erasure.ts + src/types.ts + src/targets.ts: runErasure validates the request\n   233\t// with parseStrict(erasureRequestSchema) before anything runs (an unknown field or an\n   234\t// unrecognized reason throws ValidationError). eraseOne (drawn as the boundary's caption) wraps\n   235\t// each target.erase() call in a try/catch, so one target's throw lands in its own TargetResult\n   236\t// rather than aborting the run or the sibling targets. The three reference targets are drawn\n   237\t// exactly as named: object-storage-purge, cascade-db-delete, orphan-record-sweep. sink.record(row)\n   238\t// then writes exactly one row, tagged with one of the three closed ERASURE_REASONS.\n   239\texport function RetentionRunnerSheet() {\n   240\t  return (\n   241\t    <Sheet\n   242\t      title=\"retention-runner: runErasure fans a validated request out to every registered target with per-target error isolation, a throw is caught, not propagated, then writes exactly one reason-tagged audit row\"\n   243\t      bar=\"packages/retention-runner · runErasure, target isolation, audit sink\"\n   244\t    >\n   245\t      <SNode\n   246\t        x={8}\n   247\t        y={12}\n   248\t        w={160}\n   249\t        h={26}\n   250\t        head=\"runErasure(req)\"\n   251\t        sub=\"parseStrict · strict req\"\n   252\t      />\n   253\t      <text x={8} y={50} className={styles.noteDanger}>\n   254\t        unknown field / bad reason ⇒ ValidationError\n   255\t      </text>\n   256\t      <Flow x1={88} y1={38} x2={88} y2={64} />\n   257\t      {/* the ONE accent element: per-target error isolation */}\n   258\t      <Boundary\n   259\t        x={8}\n   260\t        y={64}\n   261\t        w={324}\n   262\t        h={58}\n   263\t        label=\"eraseOne · a throw is caught, not thrown\"\n   264\t      />\n   265\t      <SNode x={18} y={82} w={100} h={26} head=\"object-storage-purge\" />\n   266\t      <SNode\n   267\t        x={126}\n   268\t        y={82}\n   269\t        w={100}\n   270\t        h={26}\n   271\t        head=\"cascade-db-delete\"\n   272\t        sub=\"a throw lands here\"\n   273\t      />\n   274\t      <SNode x={234} y={82} w={90} h={26} head=\"orphan-record-sweep\" />\n   275\t      <Flow x1={170} y1={122} x2={170} y2={138} />\n   276\t      <SNode\n   277\t        x={92}\n   278\t        y={138}\n   279\t        w={156}\n   280\t        h={28}\n   281\t        head=\"sink.record(row)\"\n   282\t        sub=\"auto_90d · ccpa_request · operator_manual\"\n   283\t      />\n   284\t      <TitleBlock x={198} y={168} w={132} text=\"RETENTION-RUNNER · 1/1\" />\n   285\t    </Sheet>\n   286\t  );\n   287\t}\n","exit_code":0,"status":"completed"}}
