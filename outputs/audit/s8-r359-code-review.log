{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/tool-exec/src/propose.ts'","aggregated_output":"     1\t// The validation gate — the pure half of @caisson/tool-exec (ADR-0153, ADR-0360 S3 phase 1),\n     2\t// carved out of tool-exec.ts so it can be imported without dragging `node:child_process` behind\n     3\t// it. Nothing here reaches a node builtin: it is a Map lookup, a Zod parse, and plain data.\n     4\t// `@caisson/tool-exec/browser` is exactly this module (ADR-0396); the `.` barrel re-exports it.\n     5\t//\n     6\t// This is the ONLY implementation of the gate — `createToolExec`'s `run` and `propose` both call\n     7\t// `propose()` below, so default-deny and schema-validation can never diverge between the\n     8\t// single-phase and two-phase paths.\n     9\timport type { ZodType } from \"zod\";\n    10\timport { NotFoundError, parseStrict } from \"@caisson/kernel\";\n    11\t\n    12\t/**\n    13\t * A registered allowlist entry: a logical name, the real executable, and its argv-array schema.\n    14\t *\n    15\t * `env` is OPTIONAL and additive: when absent, the spawned process inherits the parent's full\n    16\t * environment (Node's `execFile` default) — today's behavior, unchanged. Pass `env` to narrow the\n    17\t * child to exactly the vars it needs; the object is used VERBATIM (never merged with\n    18\t * `process.env`), so a caller that wants `PATH` must include it explicitly. Flipping the default\n    19\t * to always-narrow is a separate, deliberate major-version change — not made here.\n    20\t */\n    21\texport interface CommandSpec {\n    22\t  readonly name: string;\n    23\t  readonly command: string;\n    24\t  /** Validates the caller-supplied `args` INTO the exact argv array passed to `execFile`. */\n    25\t  readonly argsSchema: ZodType<string[]>;\n    26\t  /** Bump when approval semantics change. Outstanding approvals for another version are rejected. */\n    27\t  readonly policyVersion?: string;\n    28\t  /** Optional child environment. Absent → inherits the parent's full env (the default). */\n    29\t  readonly env?: Readonly<Record<string, string>>;\n    30\t}\n    31\t\n    32\t/**\n    33\t * A validated, not-yet-executed call (ADR-0360 S3 two-phase gate): the allowlist lookup + Zod\n    34\t * validation have already run. This pure/browser proposal is NOT execution authority.\n    35\t * createToolExec.propose issues a separate server-stored, digest-bound ToolApproval; execute\n    36\t * consumes that record and re-validates original input under the current command policy.\n    37\t */\n    38\texport interface ProposedToolCall {\n    39\t  readonly name: string;\n    40\t  readonly command: string;\n    41\t  readonly args: readonly string[];\n    42\t  readonly reason?: string;\n    43\t  /** The allowlist entry's `env`, resolved at propose time and carried through unmodified. */\n    44\t  readonly env?: Readonly<Record<string, string>>;\n    45\t}\n    46\t\n    47\t/** The gate itself, with no spawn seam attached — safe to run anywhere, including a browser. */\n    48\texport interface ToolProposer {\n    49\t  /** The allowlist lookup, default-deny: an unregistered name resolves to `undefined`. */\n    50\t  lookup(name: string): CommandSpec | undefined;\n    51\t  /**\n    52\t   * Validate `args` against the allowlisted command's schema WITHOUT spawning anything.\n    53\t   * Unregistered `name` throws `NotFoundError`; a bad shape throws `ValidationError` (from\n    54\t   * `parseStrict`) — so a proposal that parks for external approval is already known-safe-to-\n    55\t   * execute the moment it exists.\n    56\t   */\n    57\t  propose(name: string, args: unknown, reason?: string): ProposedToolCall;\n    58\t}\n    59\t\n    60\t/**\n    61\t * Build the phase-1 gate over an allowlist. Default-deny by construction: the registry holds\n    62\t * exactly the entries handed in, and an empty/absent allowlist refuses every call.\n    63\t */\n    64\texport function createToolProposer(\n    65\t  allowlist: readonly CommandSpec[],\n    66\t): ToolProposer {\n    67\t  const registry = new Map<string, CommandSpec>(\n    68\t    allowlist.map((spec) => [spec.name, spec]),\n    69\t  );\n    70\t  return {\n    71\t    lookup(name: string): CommandSpec | undefined {\n    72\t      return registry.get(name);\n    73\t    },\n    74\t    propose(name: string, args: unknown, reason?: string): ProposedToolCall {\n    75\t      const spec = registry.get(name);\n    76\t      if (spec === undefined) {\n    77\t        throw new NotFoundError(`No command registered for \"${name}\"`, {\n    78\t          command: name,\n    79\t        });\n    80\t      }\n    81\t      const validatedArgs = parseStrict(spec.argsSchema, args);\n    82\t      const proposed: ProposedToolCall = {\n    83\t        name,\n    84\t        command: spec.command,\n    85\t        args: validatedArgs,\n    86\t      };\n    87\t      const withReason =\n    88\t        reason === undefined ? proposed : { ...proposed, reason };\n    89\t      return spec.env === undefined\n    90\t        ? withReason\n    91\t        : { ...withReason, env: spec.env };\n    92\t    },\n    93\t  };\n    94\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/tool-exec/src/tool-exec.ts'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/tool-exec/src/tool-exec.ts'","aggregated_output":"     1\t// @caisson/tool-exec — governed tool-call / sandboxed-exec primitive (ADR-0153). The security\n     2\t// floor is the whole point: a default-deny allowlist maps a logical command NAME to a real\n     3\t// executable + a Zod-`.strict()` argument schema; a call is validated against that schema BEFORE\n     4\t// spawn, and the validated result is used directly as an `execFile` argv array — never a shell\n     5\t// string, never concatenated. `execSync`/`exec`/`shell: true` are never used anywhere in this file.\n     6\t// ENV DEFAULT: an allowlist entry's optional `env` is absent by default, so a spawned process\n     7\t// inherits the parent's full environment (Node's `execFile` default) — unchanged today. Set\n     8\t// `env` on a `CommandSpec` to narrow a child to exactly the vars it needs (used verbatim, never\n     9\t// merged with `process.env`). Flipping the default to always-narrow is a separate major bump.\n    10\timport { execFile as execFileCb } from \"node:child_process\";\n    11\timport { NotFoundError, parseStrict, ValidationError } from \"@caisson/kernel\";\n    12\timport { createToolProposer } from \"./propose.ts\";\n    13\timport type { CommandSpec } from \"./propose.ts\";\n    14\timport {\n    15\t  approvalDigest,\n    16\t  commandPolicyFingerprint,\n    17\t  createMemoryApprovalStore,\n    18\t  equalApprovalDigest,\n    19\t  toolApprovalSchema,\n    20\t  type ToolApproval,\n    21\t  type ToolApprovalStore,\n    22\t} from \"./approval.ts\";\n    23\t\n    24\t/** Structured argument provenance for one governed call. Plain data, not WORM. */\n    25\texport interface ExecResult {\n    26\t  readonly command: string;\n    27\t  readonly args: readonly string[];\n    28\t  readonly exitCode: number;\n    29\t  readonly stdout: string;\n    30\t  readonly stderr: string;\n    31\t  readonly ok: boolean;\n    32\t  /** Caller-supplied tag (e.g. why this call was made), carried through unmodified. */\n    33\t  readonly reason?: string;\n    34\t  readonly at: number;\n    35\t}\n    36\t\n    37\t/**\n    38\t * The spawn seam: `(command, args, opts) => { stdout, stderr, exitCode }`. Tests inject a double\n    39\t * so the suite never spawns a real process; the default drives `node:child_process.execFile` —\n    40\t * an argv ARRAY, no shell — with output captured and bounded.\n    41\t */\n    42\texport type ExecFn = (\n    43\t  command: string,\n    44\t  args: readonly string[],\n    45\t  opts: {\n    46\t    cwd: string;\n    47\t    timeoutMs: number;\n    48\t    /** Optional child environment. Absent → inherits the parent's full env (the default). */\n    49\t    env?: Readonly<Record<string, string>>;\n    50\t  },\n    51\t) => Promise<{ stdout: string; stderr: string; exitCode: number }>;\n    52\t\n    53\tconst DEFAULT_TIMEOUT_MS = 30_000;\n    54\tconst MAX_OUTPUT_BYTES = 64 * 1024;\n    55\t/** Generous vs. `MAX_OUTPUT_BYTES` — Node's own overflow error is avoided; OUR cap truncates below. */\n    56\tconst NODE_MAX_BUFFER = 10 * 1024 * 1024;\n    57\t\n    58\tfunction bound(output: string): string {\n    59\t  return output.length > MAX_OUTPUT_BYTES\n    60\t    ? output.slice(0, MAX_OUTPUT_BYTES)\n    61\t    : output;\n    62\t}\n    63\t\n    64\t/**\n    65\t * Default `ExecFn`. `execFile(command, argsArray, opts)` — never a shell string, `shell` is never\n    66\t * set. A non-zero exit resolves (not rejects) with that exit code; a spawn failure (e.g. ENOENT,\n    67\t * a non-numeric `error.code`) resolves with `exitCode: -1` — the caller always gets a provenance\n    68\t * record, never a thrown Error from the exec leg itself.\n    69\t */\n    70\tconst defaultExecFn: ExecFn = (command, args, opts) =>\n    71\t  new Promise((resolve) => {\n    72\t    const execOpts =\n    73\t      opts.env === undefined\n    74\t        ? { cwd: opts.cwd, timeout: opts.timeoutMs, maxBuffer: NODE_MAX_BUFFER }\n    75\t        : {\n    76\t            cwd: opts.cwd,\n    77\t            timeout: opts.timeoutMs,\n    78\t            maxBuffer: NODE_MAX_BUFFER,\n    79\t            env: opts.env,\n    80\t          };\n    81\t    execFileCb(command, [...args], execOpts, (error, stdout, stderr) => {\n    82\t      const out = bound(stdout);\n    83\t      const err = bound(stderr);\n    84\t      if (error === null) {\n    85\t        resolve({ stdout: out, stderr: err, exitCode: 0 });\n    86\t        return;\n    87\t      }\n    88\t      const code = (error as { code?: unknown }).code;\n    89\t      resolve({\n    90\t        stdout: out,\n    91\t        stderr: err,\n    92\t        exitCode: typeof code === \"number\" ? code : -1,\n    93\t      });\n    94\t    });\n    95\t  });\n    96\t\n    97\texport interface ToolExecConfig {\n    98\t  /** Default-deny registry. Empty/absent refuses every call (fail-closed). */\n    99\t  readonly allowlist: readonly CommandSpec[];\n   100\t  readonly cwd?: string;\n   101\t  readonly timeoutMs?: number;\n   102\t  /** Injectable spawn seam — tests supply a double so no real process is spawned. */\n   103\t  readonly execFn?: ExecFn;\n   104\t  /** Injectable clock — never `Date.now()` inline, so provenance timestamps are testable. */\n   105\t  readonly now?: () => number;\n   106\t  /** Private server-side record store; durable adapters must atomically consume records. */\n   107\t  readonly approvalStore?: ToolApprovalStore;\n   108\t}\n   109\t\n   110\texport interface ToolExec {\n   111\t  run(name: string, args: unknown, reason?: string): Promise<ExecResult>;\n   112\t  /**\n   113\t   * Two-phase gate, phase 1: validate `args` against the allowlisted command's schema WITHOUT\n   114\t   * spawning anything. Same fail-closed lookup/validation as `run` — unregistered `name` throws\n   115\t   * `NotFoundError`, a bad shape throws `ValidationError` — so a proposal that parks for external\n   116\t   * approval records exactly what was validated; execution still rechecks current policy.\n   117\t   */\n   118\t  propose(name: string, args: unknown, reason?: string): Promise<ToolApproval>;\n   119\t  /**\n   120\t   * Two-phase gate, phase 2: execute a call `propose` already validated (e.g. after an external\n   121\t   * approval decision). Consume the immutable stored record once, verify the canonical digest,\n   122\t   * revalidate original input under the current schema, and derive environment from current policy.\n   123\t   */\n   124\t  execute(proposed: unknown): Promise<ExecResult>;\n   125\t}\n   126\t\n   127\t/**\n   128\t * Build a governed tool-call gate over `config.allowlist`. `run(name, args, reason?)`:\n   129\t * 1. Look up `name` in the allowlist — unregistered throws `NotFoundError` (default-deny).\n   130\t * 2. Validate `args` against that command's `argsSchema` via `parseStrict` — a bad shape throws\n   131\t *    `ValidationError` (from `parseStrict`) BEFORE anything is spawned.\n   132\t * 3. Spawn via the injected `ExecFn` (defaults to `execFile`, argv array, no shell) and return the\n   133\t *    full provenance record.\n   134\t *\n   135\t * `propose`/`execute` (ADR-0360 S3) split steps 1-2 from step 3 — additive; `run`'s single-phase\n   136\t * path is unchanged for non-gated tools.\n   137\t */\n   138\texport function createToolExec(config: ToolExecConfig): ToolExec {\n   139\t  // The lookup + validation gate is the pure `./propose.ts` module — one implementation, shared by\n   140\t  // `run` and `propose` so the single-phase and two-phase paths can never drift apart.\n   141\t  const gate = createToolProposer(config.allowlist);\n   142\t  const cwd = config.cwd ?? process.cwd();\n   143\t  const timeoutMs = config.timeoutMs ?? DEFAULT_TIMEOUT_MS;\n   144\t  const execFn = config.execFn ?? defaultExecFn;\n   145\t  const now = config.now ?? Date.now;\n   146\t  const approvals = config.approvalStore ?? createMemoryApprovalStore();\n   147\t\n   148\t  const spawn = async (\n   149\t    command: string,\n   150\t    args: readonly string[],\n   151\t    reason: string | undefined,\n   152\t    env: Readonly<Record<string, string>> | undefined,\n   153\t  ): Promise<ExecResult> => {\n   154\t    const { stdout, stderr, exitCode } = await execFn(\n   155\t      command,\n   156\t      args,\n   157\t      env === undefined ? { cwd, timeoutMs } : { cwd, timeoutMs, env },\n   158\t    );\n   159\t    const result: ExecResult = {\n   160\t      command,\n   161\t      args,\n   162\t      exitCode,\n   163\t      stdout,\n   164\t      stderr,\n   165\t      ok: exitCode === 0,\n   166\t      at: now(),\n   167\t    };\n   168\t    return reason === undefined ? result : { ...result, reason };\n   169\t  };\n   170\t\n   171\t  return {\n   172\t    async run(\n   173\t      name: string,\n   174\t      args: unknown,\n   175\t      reason?: string,\n   176\t    ): Promise<ExecResult> {\n   177\t      const proposed = gate.propose(name, args, reason);\n   178\t      return spawn(proposed.command, proposed.args, reason, proposed.env);\n   179\t    },\n   180\t\n   181\t    async propose(\n   182\t      name: string,\n   183\t      args: unknown,\n   184\t      reason?: string,\n   185\t    ): Promise<ToolApproval> {\n   186\t      const input: unknown = structuredClone(args);\n   187\t      const validated = gate.propose(name, input, reason);\n   188\t      const spec = gate.lookup(name)!;\n   189\t      const unsigned = {\n   190\t        approvalId: crypto.randomUUID(),\n   191\t        name,\n   192\t        command: validated.command,\n   193\t        args: [...validated.args],\n   194\t        policyVersion: spec.policyVersion ?? \"1\",\n   195\t        ...(reason === undefined ? {} : { reason }),\n   196\t      };\n   197\t      const proposal = parseStrict(toolApprovalSchema, {\n   198\t        ...unsigned,\n   199\t        digest: approvalDigest(unsigned),\n   200\t      });\n   201\t      await approvals.put({\n   202\t        proposal,\n   203\t        input,\n   204\t        policyFingerprint: commandPolicyFingerprint(spec),\n   205\t      });\n   206\t      return structuredClone(proposal);\n   207\t    },\n   208\t\n   209\t    async execute(raw: unknown): Promise<ExecResult> {\n   210\t      const proposed = parseStrict(toolApprovalSchema, raw);\n   211\t      const stored = await approvals.consume(proposed.approvalId);\n   212\t      if (!stored)\n   213\t        throw new NotFoundError(\"Approval is unknown or already consumed\");\n   214\t      if (\n   215\t        !equalApprovalDigest(proposed.digest, stored.proposal.digest) ||\n   216\t        !equalApprovalDigest(approvalDigest(proposed), stored.proposal.digest)\n   217\t      ) {\n   218\t        throw new ValidationError(\n   219\t          \"Approval record does not match the approved proposal\",\n   220\t        );\n   221\t      }\n   222\t      const spec = gate.lookup(stored.proposal.name);\n   223\t      if (\n   224\t        !spec ||\n   225\t        !equalApprovalDigest(\n   226\t          commandPolicyFingerprint(spec),\n   227\t          stored.policyFingerprint,\n   228\t        )\n   229\t      ) {\n   230\t        throw new NotFoundError(\n   231\t          \"Command policy changed since approval was proposed\",\n   232\t        );\n   233\t      }\n   234\t      const current = gate.propose(\n   235\t        stored.proposal.name,\n   236\t        stored.input,\n   237\t        stored.proposal.reason,\n   238\t      );\n   239\t      const currentDigest = approvalDigest({\n   240\t        ...stored.proposal,\n   241\t        command: current.command,\n   242\t        args: [...current.args],\n   243\t      });\n   244\t      if (!equalApprovalDigest(currentDigest, stored.proposal.digest)) {\n   245\t        throw new ValidationError(\n   246\t          \"Current command validation differs from the approved proposal\",\n   247\t        );\n   248\t      }\n   249\t      // No environment is accepted from the public approval envelope or old stored proposal.\n   250\t      return spawn(\n   251\t        spec.command,\n   252\t        current.args,\n   253\t        current.reason,\n   254\t        spec.env === undefined ? undefined : { ...spec.env },\n   255\t      );\n   256\t    },\n   257\t  };\n   258\t}\n","exit_code":0,"status":"completed"}}
