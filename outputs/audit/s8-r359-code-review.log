{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba scripts/release-readiness.test.ts'","aggregated_output":"     1\t// Guards the required-check SET itself, not any one gate's logic. REQUIRED_CHECKS is a bare string\n     2\t// list that release-readiness.ts compares against the GitHub check-runs API: a name here that no\n     3\t// workflow defines makes every release \"missing\" that check forever, and a job here that can be\n     4\t// skipped reds readiness on every release whose diff happened not to reach it. Both failures are\n     5\t// silent until a release is already in flight, which is the wrong time to find out.\n     6\t//\n     7\t// Parsed with Bun.YAML, not regex. A first pass matched job KEYS with `^ {2}<name>:` and grepped\n     8\t// for a 4-space `paths:`; the SHIP review defeated it three ways that this repo could plausibly\n     9\t// produce — a `needs: changes` + `if: needs.changes.outputs.x` gate (quality.yml already has that\n    10\t// `changes` job), a `paths:` at 6-space indent under a nested `on:`, and flow-style\n    11\t// `push: { paths: [...] }`. A text heuristic over YAML is the wrong tool when a parser is in hand.\n    12\timport {\n    13\t  mkdtempSync,\n    14\t  readdirSync,\n    15\t  readFileSync,\n    16\t  rmSync,\n    17\t  writeFileSync,\n    18\t} from \"node:fs\";\n    19\timport { tmpdir } from \"node:os\";\n    20\timport { spawnSync } from \"node:child_process\";\n    21\timport { join } from \"node:path\";\n    22\t\n    23\timport { afterAll, describe, expect, test } from \"bun:test\";\n    24\t\n    25\timport { auditArtifactIsValid, REQUIRED_CHECKS } from \"./release-readiness.ts\";\n    26\t\n    27\tdescribe(\"R4 audit attestation\", () => {\n    28\t  const dir = mkdtempSync(join(tmpdir(), \"caisson-r4-\"));\n    29\t  afterAll(() => rmSync(dir, { recursive: true, force: true }));\n    30\t  const binding = {\n    31\t    base: \"v2026.08.18\",\n    32\t    tag: \"v2026.09.16\",\n    33\t    sha: \"a\".repeat(40),\n    34\t  };\n    35\t  const clean = {\n    36\t    schema_version: 1,\n    37\t    ...binding,\n    38\t    status: \"clean\",\n    39\t    critical: 0,\n    40\t    reviewed_scope: [\"scripts/release-readiness.ts\"],\n    41\t    reviewers: [\n    42\t      {\n    43\t        role: \"code_review\",\n    44\t        identity: \"gw-code-reviewer\",\n    45\t        reviewed_at: \"2026-09-16T02:37:11Z\",\n    46\t      },\n    47\t      {\n    48\t        role: \"security_audit\",\n    49\t        identity: \"gw-security-auditor\",\n    50\t        reviewed_at: \"2026-09-16T02:37:11Z\",\n    51\t      },\n    52\t    ],\n    53\t  };\n    54\t  function fixture(text: string): string {\n    55\t    const path = join(dir, `${crypto.randomUUID()}.md`);\n    56\t    writeFileSync(path, text);\n    57\t    return path;\n    58\t  }\n    59\t  const document = (value: unknown) =>\n    60\t    `---\\n${JSON.stringify(value)}\\n---\\n# Audit\\n`;\n    61\t\n    62\t  test(\"R4 rejects an existing empty audit instead of accepting its filename\", () => {\n    63\t    expect(auditArtifactIsValid(fixture(\"\"), binding)).toBe(false);\n    64\t  });\n    65\t  test(\"R4 accepts a clean audit bound to the exact base, tag and final SHA\", () => {\n    66\t    expect(auditArtifactIsValid(fixture(document(clean)), binding)).toBe(true);\n    67\t  });\n    68\t  test.each([\n    69\t    [\"failed verdict\", { status: \"issues_found\" }],\n    70\t    [\"blocking finding\", { critical: 1 }],\n    71\t    [\"wrong SHA\", { sha: \"b\".repeat(40) }],\n    72\t    [\"wrong base\", { base: \"v2026.07.30\" }],\n    73\t    [\"wrong tag\", { tag: \"v2026.09.17\" }],\n    74\t    [\"empty scope\", { reviewed_scope: [] }],\n    75\t    [\"blank scope\", { reviewed_scope: [\"  \"] }],\n    76\t    [\"no reviewers\", { reviewers: [] }],\n    77\t    [\n    78\t      \"duplicate roles\",\n    79\t      { reviewers: [clean.reviewers[0], clean.reviewers[0]] },\n    80\t    ],\n    81\t    [\n    82\t      \"blank identity\",\n    83\t      {\n    84\t        reviewers: [\n    85\t          { ...clean.reviewers[0], identity: \" \" },\n    86\t          clean.reviewers[1],\n    87\t        ],\n    88\t      },\n    89\t    ],\n    90\t    [\n    91\t      \"invalid timestamp\",\n    92\t      {\n    93\t        reviewers: [\n    94\t          { ...clean.reviewers[0], reviewed_at: \"yesterday\" },\n    95\t          clean.reviewers[1],\n    96\t        ],\n    97\t      },\n    98\t    ],\n    99\t    [\"unknown metadata\", { bypass: true }],\n   100\t  ] as const)(\"R4 rejects %s\", (_label, patch) => {\n   101\t    expect(\n   102\t      auditArtifactIsValid(fixture(document({ ...clean, ...patch })), binding),\n   103\t    ).toBe(false);\n   104\t  });\n   105\t  test(\"R4 fails closed for absent, malformed and prose-only artifacts\", () => {\n   106\t    expect(auditArtifactIsValid(join(dir, \"absent.md\"), binding)).toBe(false);\n   107\t    expect(auditArtifactIsValid(fixture(\"---\\n[invalid\\n---\\n\"), binding)).toBe(\n   108\t      false,\n   109\t    );\n   110\t    expect(\n   111\t      auditArtifactIsValid(fixture(\"Reviewed and approved\"), binding),\n   112\t    ).toBe(false);\n   113\t  });\n   114\t});\n   115\t\n   116\tconst WORKFLOWS_DIR = join(import.meta.dir, \"..\", \".github\", \"workflows\");\n   117\t\n   118\t/** The ONE `if:` a required job may carry — the CAISSON-96 draft guard, per ci.yml's header. */\n   119\tconst DRAFT_GUARD =\n   120\t  \"github.event_name != 'pull_request' || github.event.pull_request.draft == false\";\n   121\t\n   122\tinterface Job {\n   123\t  name?: string;\n   124\t  if?: string;\n   125\t  needs?: string | string[];\n   126\t  \"continue-on-error\"?: boolean;\n   127\t  steps?: {\n   128\t    name?: string;\n   129\t    run?: string;\n   130\t    env?: Record<string, string>;\n   131\t    if?: string;\n   132\t    \"continue-on-error\"?: boolean;\n   133\t  }[];\n   134\t}\n   135\tinterface Trigger {\n   136\t  paths?: string[];\n   137\t  \"paths-ignore\"?: string[];\n   138\t}\n   139\tinterface Workflow {\n   140\t  on?: Record<string, Trigger | null>;\n   141\t  true?: Record<string, Trigger | null>; // YAML 1.1: a bare `on:` key parses as boolean true\n   142\t  jobs?: Record<string, Job>;\n   143\t}\n   144\t\n   145\tinterface Found {\n   146\t  file: string;\n   147\t  key: string;\n   148\t  job: Job;\n   149\t  triggers: Record<string, Trigger | null>;\n   150\t}\n   151\t\n   152\t/** Parse every workflow once, and index by the check-run NAME each job reports under — which is\n   153\t *  `name:` when present and the job key otherwise. release-readiness.ts matches on that reported\n   154\t *  name, so indexing by job key alone would go green while every release reported it missing. */\n   155\tconst unparsable: string[] = [];\n   156\t\n   157\tfunction jobsByReportedName(): Map<string, Found> {\n   158\t  const found = new Map<string, Found>();\n   159\t  for (const file of readdirSync(WORKFLOWS_DIR).filter(\n   160\t    (f) => f.endsWith(\".yml\") || f.endsWith(\".yaml\"),\n   161\t  )) {\n   162\t    let wf: Workflow;\n   163\t    try {\n   164\t      wf = Bun.YAML.parse(\n   165\t        readFileSync(join(WORKFLOWS_DIR, file), \"utf8\"),\n   166\t      ) as Workflow;\n   167\t    } catch (err) {\n   168\t      // Collected, not thrown. A parse error at module scope takes the whole suite down as\n   169\t      // \"0 pass / 0 fail\" — technically non-zero, but it reads as \"no tests ran\" rather than\n   170\t      // \"this workflow is malformed\", and it hides every other check in this file.\n   171\t      unparsable.push(`${file}: ${String(err)}`);\n   172\t      continue;\n   173\t    }\n   174\t    const triggers = wf.on ?? wf.true ?? {};\n   175\t    for (const [key, job] of Object.entries(wf.jobs ?? {})) {\n   176\t      found.set(job.name ?? key, { file, key, job, triggers });\n   177\t    }\n   178\t  }\n   179\t  return found;\n   180\t}\n   181\t\n   182\tdescribe(\"REQUIRED_CHECKS — the release-readiness gate's own input\", () => {\n   183\t  const byName = jobsByReportedName();\n   184\t\n   185\t  test(\"every workflow file parses — a throw here would blank the whole suite\", () => {\n   186\t    expect(unparsable).toEqual([]);\n   187\t  });\n   188\t\n   189\t  test(\"the set is non-empty, deduplicated, and at full strength\", () => {\n   190\t    // Guard the guard: a floor below the real size lets one silently drop out.\n   191\t    expect(REQUIRED_CHECKS.length).toBeGreaterThanOrEqual(7);\n   192\t    expect(new Set(REQUIRED_CHECKS).size).toBe(REQUIRED_CHECKS.length);\n   193\t    // And the parse itself must have found something, or every check below is vacuous.\n   194\t    expect(byName.size).toBeGreaterThan(10);\n   195\t  });\n   196\t\n   197\t  test(\"every required check is a job some workflow actually reports under that name\", () => {\n   198\t    expect(REQUIRED_CHECKS.filter((name) => !byName.has(name))).toEqual([]);\n   199\t  });\n   200\t\n   201\t  test(\"no required check is path-scoped — a skipped check never reports and reads as missing\", () => {\n   202\t    // ci.yml's header states the rule from the PR side (a path-skipped required job never reports\n   203\t    // and the PR blocks forever); release-readiness.ts enforces it from the release side, where a\n   204\t    // check with zero runs lands in `missing`. Same constraint, both directions.\n   205\t    const scoped = REQUIRED_CHECKS.flatMap((name) => {\n   206\t      const hit = byName.get(name);\n   207\t      if (!hit) return [];\n   208\t      return Object.entries(hit.triggers)\n   209\t        .filter(([, t]) => t?.paths ?? t?.[\"paths-ignore\"])\n   210\t        .map(([event]) => `${name} (${hit.file}, on.${event})`);\n   211\t    });\n   212\t    expect(scoped).toEqual([]);\n   213\t  });\n   214\t\n   215\t  test(\"no required check is conditionally skippable — only the CAISSON-96 draft guard is allowed\", () => {\n   216\t    // The other way a required job silently stops reporting: a job-level `if:` or a `needs:` on a\n   217\t    // path-filter job. quality.yml already has a `changes` job of exactly that shape, so this is a\n   218\t    // pattern the repo can produce, not a hypothetical.\n   219\t    const conditional = REQUIRED_CHECKS.flatMap((name) => {\n   220\t      // The fail-closed aggregate is tested structurally and behaviorally below.\n   221\t      if (name === \"runtime-images-gate\") return [];\n   222\t      const hit = byName.get(name);\n   223\t      if (!hit) return [];\n   224\t      const reasons: string[] = [];\n   225\t      if (hit.job.if !== undefined && hit.job.if.trim() !== DRAFT_GUARD) {\n   226\t        reasons.push(`if: ${hit.job.if}`);\n   227\t      }\n   228\t      if (hit.job.needs !== undefined) {\n   229\t        reasons.push(`needs: ${String(hit.job.needs)}`);\n   230\t      }\n   231\t      return reasons.map((r) => `${name} (${hit.file}) — ${r}`);\n   232\t    });\n   233\t    expect(conditional).toEqual([]);\n   234\t  });\n   235\t\n   236\t  test(\"support-bot is in the set — ADR-0414 promoted it before automating its deploy\", () => {\n   237\t    // Pinned by name, not just by the structural rules above: the promotion is the whole reason\n   238\t    // deploy-railway.yml is allowed to ship this service automatically. Dropping it back to\n   239\t    // advisory silently restores \"a red bot deploys anyway\", which no structural check would catch.\n   240\t    expect(REQUIRED_CHECKS).toContain(\"support-bot\");\n   241\t    expect(byName.get(\"support-bot\")?.file).toBe(\"support-bot.yml\");\n   242\t  });\n   243\t\n   244\t  test(\"runtime images aggregate is required by release readiness\", () => {\n   245\t    expect(REQUIRED_CHECKS).toContain(\"runtime-images-gate\");\n   246\t  });\n   247\t\n   248\t  test(\"runtime aggregate always consumes the selector and complete matrix\", () => {\n   249\t    const hit = byName.get(\"runtime-images-gate\");\n   250\t    expect(hit?.file).toBe(\"security-scan.yml\");\n   251\t    expect(hit?.job.if).toBe(\"always()\");\n   252\t    expect(hit?.job.needs).toEqual([\"runtime-select\", \"runtime-images\"]);\n   253\t    expect(hit?.job[\"continue-on-error\"]).not.toBe(true);\n   254\t    expect(hit?.job.steps).toHaveLength(1);\n   255\t    const step = hit?.job.steps?.[0];\n   256\t    expect(step?.if).toBeUndefined();\n   257\t    expect(step?.[\"continue-on-error\"]).not.toBe(true);\n   258\t    expect(step?.env).toEqual({\n   259\t      SELECT_RESULT: \"${{ needs.runtime-select.result }}\",\n   260\t      MATRIX_RESULT: \"${{ needs.runtime-images.result }}\",\n   261\t    });\n   262\t  });\n   263\t\n   264\t  function aggregate(select: string, matrix: string): number | null {\n   265\t    const script = byName.get(\"runtime-images-gate\")?.job.steps?.[0]?.run;\n   266\t    if (!script) throw new Error(\"runtime aggregate script missing\");\n   267\t    // Execute the actual workflow gate with synthetic outcomes; no scanners or credentials.\n   268\t    return spawnSync(\"bash\", [\"-c\", script], {\n   269\t      env: {\n   270\t        PATH: process.env.PATH,\n   271\t        SELECT_RESULT: select,\n   272\t        MATRIX_RESULT: matrix,\n   273\t      },\n   274\t    }).status;\n   275\t  }\n   276\t\n   277\t  test(\"runtime aggregate rejects a failed matrix member\", () => {\n   278\t    expect(aggregate(\"success\", \"failure\")).toBe(1);\n   279\t  });\n   280\t\n   281\t  test(\"runtime aggregate is green only when both dependencies succeed\", () => {\n   282\t    for (const select of [\"success\", \"failure\", \"cancelled\", \"skipped\", \"\"]) {\n   283\t      for (const matrix of [\"success\", \"failure\", \"cancelled\", \"skipped\", \"\"]) {\n   284\t        expect(aggregate(select, matrix)).toBe(\n   285\t          select === \"success\" && matrix === \"success\" ? 0 : 1,\n   286\t        );\n   287\t      }\n   288\t    }\n   289\t  });\n   290\t});\n","exit_code":0,"status":"completed"}}
