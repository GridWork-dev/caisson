{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba packages/local-store/src/egress-guard.test.ts'","aggregated_output":"     1\t// Unit tests for the cloud-egress secret-scrub guard (ADR-0067, security-critical). Offline + engine-\n     2\t// neutral: the embed transport is a TEST-DOUBLE (no live cloud call in CI). Proves the scrub contract,\n     3\t// scrub-before-egress (the backend never sees a raw secret), the fail-closed https + dimension gates,\n     4\t// and that a failed transport throws a redaction-safe error carrying no secret.\n     5\timport { beforeEach, describe, expect, mock, test } from \"bun:test\";\n     6\timport { InternalError, ValidationError } from \"@caisson/kernel\";\n     7\timport type { EmbedFetch } from \"./embed-scrub-guard.ts\";\n     8\timport type { Embedder } from \"./embedder.ts\";\n     9\t\n    10\t// Resolver seam, not a replacement of the security guard. The real kernel guard inspects\n    11\t// these synthetic DNS answers; neither DNS nor the transport reaches a live service.\n    12\tconst dns: { addresses: { address: string }[]; calls: number } = {\n    13\t  addresses: [{ address: \"93.184.216.34\" }],\n    14\t  calls: 0,\n    15\t};\n    16\tmock.module(\"node:dns/promises\", () => ({\n    17\t  lookup: async () => {\n    18\t    dns.calls++;\n    19\t    return dns.addresses;\n    20\t  },\n    21\t}));\n    22\tconst { createCloudEmbedder, guardEmbedder, looksLikeSecret, scrubForEgress } =\n    23\t  await import(\"./embed-scrub-guard.ts\");\n    24\tbeforeEach(() => {\n    25\t  dns.addresses = [{ address: \"93.184.216.34\" }];\n    26\t  dns.calls = 0;\n    27\t});\n    28\t\n    29\tdescribe(\"scrubForEgress (secret-scrub contract)\", () => {\n    30\t  test(\"C — drops a secret-named assignment value, keeps key + separator\", () => {\n    31\t    expect(scrubForEgress(\"OPENAI_API_KEY=sk-proj-AAAABBBBCCCCDDDD\")).toBe(\n    32\t      \"OPENAI_API_KEY=[REDACTED]\",\n    33\t    );\n    34\t    expect(scrubForEgress(\"auth_token: ghp_0123456789ABCDEFabcdef0123\")).toBe(\n    35\t      \"auth_token: [REDACTED]\",\n    36\t    );\n    37\t  });\n    38\t\n    39\t  test(\"B — drops only the URL password, keeps scheme/user/host\", () => {\n    40\t    expect(\n    41\t      scrubForEgress(\"postgres://app:s3cr3t-p4ss@db.example.com/main\"),\n    42\t    ).toBe(\"postgres://app:[REDACTED]@db.example.com/main\");\n    43\t  });\n    44\t\n    45\t  test(\"D — redacts a bare inline token, surrounding text intact\", () => {\n    46\t    expect(\n    47\t      scrubForEgress(\"Rotate AKIAIOSFODNN7EXAMPLE before the audit.\"),\n    48\t    ).toBe(\"Rotate [REDACTED] before the audit.\");\n    49\t  });\n    50\t\n    51\t  test(\"A — collapses a PEM private-key block whole\", () => {\n    52\t    const pem =\n    53\t      \"-----BEGIN RSA PRIVATE KEY-----\\nMIIEowIBAAKCAQEAFAKE\\n-----END RSA PRIVATE KEY-----\";\n    54\t    expect(scrubForEgress(pem)).toBe(\"[REDACTED]\");\n    55\t  });\n    56\t\n    57\t  test(\"clean text passes through unchanged (no false positive)\", () => {\n    58\t    const clean =\n    59\t      \"Refactor the RRF ranker so the FTS leg rescues a vec-weak doc.\";\n    60\t    expect(scrubForEgress(clean)).toBe(clean);\n    61\t  });\n    62\t\n    63\t  test(\"idempotent — re-scrubbing already-scrubbed text is a no-op\", () => {\n    64\t    const once = scrubForEgress(\"token: ghp_0123456789ABCDEFabcdef0123\");\n    65\t    expect(scrubForEgress(once)).toBe(once);\n    66\t  });\n    67\t});\n    68\t\n    69\tdescribe(\"looksLikeSecret\", () => {\n    70\t  test(\"true when the text carries a redactable span\", () => {\n    71\t    expect(looksLikeSecret(\"AKIAIOSFODNN7EXAMPLE\")).toBe(true);\n    72\t  });\n    73\t  test(\"false for clean text\", () => {\n    74\t    expect(looksLikeSecret(\"just an ordinary sentence\")).toBe(false);\n    75\t  });\n    76\t});\n    77\t\n    78\tdescribe(\"guardEmbedder (scrub-before-egress)\", () => {\n    79\t  test(\"the wrapped backend never receives a raw secret\", async () => {\n    80\t    const seen: string[] = [];\n    81\t    const inner: Embedder = {\n    82\t      dim: 2,\n    83\t      embed: (t) => {\n    84\t        seen.push(t);\n    85\t        return Promise.resolve([0, 0]);\n    86\t      },\n    87\t    };\n    88\t    await guardEmbedder(inner).embed(\"leaked AKIAIOSFODNN7EXAMPLE here\");\n    89\t    expect(seen[0]).toBe(\"leaked [REDACTED] here\");\n    90\t    expect(seen[0]).not.toContain(\"AKIAIOSFODNN7EXAMPLE\");\n    91\t  });\n    92\t});\n    93\t\n    94\tdescribe(\"createCloudEmbedder (test-doubled transport — no live call)\", () => {\n    95\t  function okResponse(vector: number[]): Response {\n    96\t    return new Response(JSON.stringify({ embedding: vector }), {\n    97\t      status: 200,\n    98\t      headers: { \"content-type\": \"application/json\" },\n    99\t    });\n   100\t  }\n   101\t\n   102\t  test(\"rejects a public hostname resolving to private space before fetch\", async () => {\n   103\t    dns.addresses = [\n   104\t      { address: \"93.184.216.34\" },\n   105\t      { address: \"169.254.169.254\" },\n   106\t    ];\n   107\t    const fetchImpl = mock<EmbedFetch>(() =>\n   108\t      Promise.resolve(okResponse([0.1, 0.2])),\n   109\t    );\n   110\t    const embedder = createCloudEmbedder(\n   111\t      {\n   112\t        endpoint: \"https://embed.example.com/v1\",\n   113\t        apiKey: \"test-key\",\n   114\t        model: \"m\",\n   115\t        dim: 2,\n   116\t      },\n   117\t      fetchImpl,\n   118\t    );\n   119\t    await expect(embedder.embed(\"buyer content\")).rejects.toThrow(\n   120\t      /private address/,\n   121\t    );\n   122\t    expect(fetchImpl).not.toHaveBeenCalled();\n   123\t    expect(dns.calls).toBe(1);\n   124\t  });\n   125\t\n   126\t  test(\"resolves immediately before every request including a changed DNS answer\", async () => {\n   127\t    const order: string[] = [];\n   128\t    const fetchImpl: EmbedFetch = (_url, init) => {\n   129\t      order.push(`fetch-after-resolution-${dns.calls}`);\n   130\t      expect(init?.redirect).toBe(\"error\");\n   131\t      return Promise.resolve(okResponse([0.1, 0.2]));\n   132\t    };\n   133\t    const embedder = createCloudEmbedder(\n   134\t      {\n   135\t        endpoint: \"https://embed.example.com/v1\",\n   136\t        apiKey: \"test-key\",\n   137\t        model: \"m\",\n   138\t        dim: 2,\n   139\t      },\n   140\t      fetchImpl,\n   141\t    );\n   142\t    await embedder.embed(\"first\");\n   143\t    dns.addresses = [{ address: \"127.0.0.1\" }];\n   144\t    await expect(embedder.embed(\"second\")).rejects.toThrow(/private address/);\n   145\t    expect(order).toEqual([\"fetch-after-resolution-1\"]);\n   146\t    expect(dns.calls).toBe(2);\n   147\t  });\n   148\t\n   149\t  test(\"rejects a private, loopback or metadata endpoint at construction\", () => {\n   150\t    // The schema's `.refine` proves only the SCHEME. Every host below is valid https, so a\n   151\t    // scheme-only check admits all of them and `embed()` would POST the Bearer credential there.\n   152\t    const reached: string[] = [];\n   153\t    const spy: EmbedFetch = (url) => {\n   154\t      reached.push(String(url));\n   155\t      return Promise.resolve(okResponse([0.1, 0.2]));\n   156\t    };\n   157\t    for (const endpoint of [\n   158\t      \"https://169.254.169.254/latest/meta-data/\", // cloud metadata\n   159\t      \"https://127.0.0.1/v1\",\n   160\t      \"https://localhost/v1\",\n   161\t      \"https://10.0.0.5/v1\",\n   162\t      \"https://192.168.1.10/v1\",\n   163\t      \"https://user:pw@embed.example.com/v1\", // credentials in URL\n   164\t    ]) {\n   165\t      expect(() =>\n   166\t        createCloudEmbedder(\n   167\t          { endpoint, apiKey: \"key-123\", model: \"m\", dim: 2 },\n   168\t          spy,\n   169\t        ),\n   170\t      ).toThrow();\n   171\t    }\n   172\t    // Nothing was attempted: the guard runs at construction, before any transport exists.\n   173\t    expect(reached).toEqual([]);\n   174\t  });\n   175\t\n   176\t  test(\"a public https endpoint still constructs and embeds\", async () => {\n   177\t    // The positive control. Without it the rejection sweep above passes just as well against a\n   178\t    // `createCloudEmbedder` that throws on everything.\n   179\t    const fetchDouble: EmbedFetch = () =>\n   180\t      Promise.resolve(okResponse([0.1, 0.2]));\n   181\t    const embedder = createCloudEmbedder(\n   182\t      {\n   183\t        endpoint: \"https://embed.example.com/v1\",\n   184\t        apiKey: \"key-123\",\n   185\t        model: \"m\",\n   186\t        dim: 2,\n   187\t      },\n   188\t      fetchDouble,\n   189\t    );\n   190\t    expect(await embedder.embed(\"hello\")).toEqual([0.1, 0.2]);\n   191\t  });\n   192\t\n   193\t  test(\"refuses to follow a redirect on the credential-bearing POST\", async () => {\n   194\t    // A 3xx would re-target the Bearer POST past the construction-time host check, which only\n   195\t    // ever saw the configured origin.\n   196\t    let init: RequestInit | undefined;\n   197\t    const fetchDouble: EmbedFetch = (_url, requestInit) => {\n   198\t      init = requestInit;\n   199\t      return Promise.resolve(okResponse([0.1, 0.2]));\n   200\t    };\n   201\t    const embedder = createCloudEmbedder(\n   202\t      {\n   203\t        endpoint: \"https://embed.example.com/v1\",\n   204\t        apiKey: \"key-123\",\n   205\t        model: \"m\",\n   206\t        dim: 2,\n   207\t      },\n   208\t      fetchDouble,\n   209\t    );\n   210\t    await embedder.embed(\"hello\");\n   211\t    expect(init?.redirect).toBe(\"error\");\n   212\t  });\n   213\t\n   214\t  test(\"scrubs content before the request body leaves the box\", async () => {\n   215\t    let sentBody = \"\";\n   216\t    const fetchDouble: EmbedFetch = (_url, init) => {\n   217\t      sentBody = String(init?.body ?? \"\");\n   218\t      return Promise.resolve(okResponse([0.1, 0.2]));\n   219\t    };\n   220\t    const embedder = createCloudEmbedder(\n   221\t      {\n   222\t        endpoint: \"https://embed.example.com/v1\",\n   223\t        apiKey: \"key-123\",\n   224\t        model: \"m\",\n   225\t        dim: 2,\n   226\t      },\n   227\t      fetchDouble,\n   228\t    );\n   229\t    const vector = await embedder.embed(\n   230\t      \"DATABASE_URL=postgres://app:s3cr3t-p4ss@db.example.com/main\",\n   231\t    );\n   232\t    expect(vector).toEqual([0.1, 0.2]);\n   233\t    expect(sentBody).toContain(\"[REDACTED]\");\n   234\t    expect(sentBody).not.toContain(\"s3cr3t-p4ss\");\n   235\t  });\n   236\t\n   237\t  test(\"rejects a non-https endpoint (fail-closed)\", () => {\n   238\t    expect(() =>\n   239\t      createCloudEmbedder({\n   240\t        endpoint: \"http://embed.example.com\",\n   241\t        apiKey: \"k\",\n   242\t        model: \"m\",\n   243\t        dim: 2,\n   244\t      }),\n   245\t    ).toThrow(ValidationError);\n   246\t  });\n   247\t\n   248\t  test(\"rejects an unknown config field (strict boundary)\", () => {\n   249\t    expect(() =>\n   250\t      createCloudEmbedder({\n   251\t        endpoint: \"https://embed.example.com\",\n   252\t        apiKey: \"k\",\n   253\t        model: \"m\",\n   254\t        dim: 2,\n   255\t        unexpected: true,\n   256\t      }),\n   257\t    ).toThrow(ValidationError);\n   258\t  });\n   259\t\n   260\t  test(\"a wrong-dim response throws fail-closed (never corrupts the index)\", async () => {\n   261\t    const fetchDouble: EmbedFetch = () =>\n   262\t      Promise.resolve(okResponse([0.1, 0.2, 0.3]));\n   263\t    const embedder = createCloudEmbedder(\n   264\t      {\n   265\t        endpoint: \"https://embed.example.com\",\n   266\t        apiKey: \"k\",\n   267\t        model: \"m\",\n   268\t        dim: 2,\n   269\t      },\n   270\t      fetchDouble,\n   271\t    );\n   272\t    await expect(embedder.embed(\"hello\")).rejects.toThrow(ValidationError);\n   273\t  });\n   274\t\n   275\t  test(\"a failed transport throws a redaction-safe error (no secret)\", async () => {\n   276\t    const fetchDouble: EmbedFetch = () =>\n   277\t      Promise.resolve(new Response(\"upstream detail\", { status: 500 }));\n   278\t    const embedder = createCloudEmbedder(\n   279\t      {\n   280\t        endpoint: \"https://embed.example.com\",\n   281\t        apiKey: \"super-secret-key\",\n   282\t        model: \"m\",\n   283\t        dim: 2,\n   284\t      },\n   285\t      fetchDouble,\n   286\t    );\n   287\t    const err = (await embedder\n   288\t      .embed(\"hello\")\n   289\t      .catch((e: unknown) => e)) as InternalError;\n   290\t    expect(err).toBeInstanceOf(InternalError);\n   291\t    expect(JSON.stringify(err.details ?? {})).not.toContain(\"super-secret-key\");\n   292\t  });\n   293\t});\n","exit_code":0,"status":"completed"}}
