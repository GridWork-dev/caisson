{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba apps/site/lib/db.ts'","aggregated_output":"     1\t// The platform DB seam (ADR-0115). Resolves a `Transactor` (@caisson/tenancy-rls) behind\n     2\t// `DATABASE_URL` — a node-postgres pool (Railway Postgres / any TCP Postgres) when set, an\n     3\t// in-memory PGlite double when unset (dev / local preview / `bun test`). `DATABASE_URL` is\n     4\t// NEVER hardcoded (security floor, identity/security.md). `readScoped` is the one seam every\n     5\t// `/dashboard` view reads through: it wraps `withTenant` (fail-closed RLS, ADR-0005) so a route\n     6\t// that forgets to scope its read sees nothing rather than another tenant's rows.\n     7\t//\n     8\t// Drizzle (`drizzle-orm/node-postgres`, ADR-0115's named driver) constructs the canonical `db`\n     9\t// handle over the pool — the forward seam any future Drizzle-schema read hangs off. The actual\n    10\t// tenant-scoped transaction below still talks to the SAME pool via raw positional SQL\n    11\t// (`query(text, params)`), because every existing `TenantExecutor` consumer in this repo\n    12\t// (`@caisson/credits`, the entitlement/license-grant stores) is written against that raw\n    13\t// contract, not a Drizzle query builder — and `drizzle-orm`'s `db.transaction()` callback does\n    14\t// not expose the underlying `PoolClient` (only the top-level `db.$client` does), so a manual\n    15\t// BEGIN/COMMIT/ROLLBACK over `pool.connect()` is the only way to hand `withTenant` a real,\n    16\t// transaction-scoped `SET LOCAL ROLE` connection.\n    17\t//\n    18\t// The PGlite double applies the REAL platform migration chain (@caisson/platform-migrations,\n    19\t// CAISSON-21) — the SAME shared chain apps/site/lib/deploy-migrate.ts applies to a live Postgres\n    20\t// and apps/admin/src/lib/admin-db.ts applies to its own double — PLUS this app's own local extras\n    21\t// (BYOK metadata, compliance attestations, the Ask-AI counters), now the SAME\n    22\t// `SITE_LOCAL_MIGRATIONS` list `deploy-migrate.ts` applies (`./site-migrations.ts`, CAISSON-64).\n    23\t// This used to be a hand-copied, differently-ordered, and (worse) DIFFERENT-CONTENT list from\n    24\t// deploy-migrate.ts's — this double ran 3 migrations the real-Postgres deploy apply never learned\n    25\t// about, so `byok_key_meta` was never created in prod and /dashboard/ai-keys crashed for every\n    26\t// account. Routing both consumers through one shared list closes that drift class for good.\n    27\timport { PGlite } from \"@electric-sql/pglite\";\n    28\timport { applyAll } from \"@caisson/platform-migrations\";\n    29\timport { pgliteMigrationApplier } from \"@caisson/platform-migrations/pglite\";\n    30\timport {\n    31\t  createPgPool,\n    32\t  createPgTransactor,\n    33\t  type TenantExecutor,\n    34\t  type Transactor,\n    35\t  withTenant,\n    36\t} from \"@caisson/tenancy-rls\";\n    37\timport { drizzle } from \"drizzle-orm/node-postgres\";\n    38\timport { SITE_LOCAL_MIGRATIONS } from \"./site-migrations.ts\";\n    39\t\n    40\texport type { TenantExecutor, Transactor };\n    41\texport { withTenant };\n    42\t\n    43\t// HMR-safe module singletons (Next dev re-evaluates this module on every edit; stashing on\n    44\t// `globalThis` keeps one pool / one in-memory PGlite across reloads instead of leaking a fresh\n    45\t// one per hot-reload — the same pattern every Drizzle-on-Next guide uses for the Pool itself).\n    46\tinterface PlatformDbGlobal {\n    47\t  caissonTransactor?: Transactor;\n    48\t  caissonPglite?: PGlite;\n    49\t}\n    50\tconst globalDb = globalThis as unknown as PlatformDbGlobal;\n    51\t\n    52\tasync function bootstrapPglite(): Promise<PGlite> {\n    53\t  if (globalDb.caissonPglite) return globalDb.caissonPglite;\n    54\t  const pg = new PGlite();\n    55\t  await applyAll(pgliteMigrationApplier(pg), SITE_LOCAL_MIGRATIONS);\n    56\t  globalDb.caissonPglite = pg;\n    57\t  return pg;\n    58\t}\n    59\t\n    60\t/**\n    61\t * Resolve the platform `Transactor`: node-postgres over `DATABASE_URL` when set (Railway\n    62\t * Postgres in prod, or any TCP Postgres in a developer's own environment), an in-memory PGlite\n    63\t * double otherwise. The PGlite path is NEVER a production fallback by itself — `/dashboard` is\n    64\t * authed + force-dynamic (ADR-0114), so an unset `DATABASE_URL` in a real deployment means no\n    65\t * session cookie can resolve either; this only ever serves `bun dev` / `bun test` with no\n    66\t * Postgres configured.\n    67\t */\n    68\texport async function getDb(): Promise<Transactor> {\n    69\t  if (globalDb.caissonTransactor) return globalDb.caissonTransactor;\n    70\t  const url = process.env.DATABASE_URL;\n    71\t  if (url !== undefined && url.length > 0) {\n    72\t    const pool = createPgPool(url);\n    73\t    // The canonical Drizzle handle (ADR-0115's named driver) — unused by the raw-SQL Transactor\n    74\t    // below, kept as the forward seam for a future schema-based read. Constructing it eagerly\n    75\t    // also fails fast on a malformed `DATABASE_URL` shape at boot rather than at first query.\n    76\t    drizzle(pool);\n    77\t    globalDb.caissonTransactor = createPgTransactor(pool);\n    78\t    return globalDb.caissonTransactor;\n    79\t  }\n    80\t  process.stderr.write(\n    81\t    \"[apps/site] DATABASE_URL unset — using an in-memory PGlite double (dev only).\\n\",\n    82\t  );\n    83\t  const pg = await bootstrapPglite();\n    84\t  // PGlite satisfies `Transactor` directly (`.transaction()` matches the interface byte-for-byte)\n    85\t  // — the same pattern `tooling/testing/src/pg.ts`'s `newTestPg()` uses, passing its raw `PGlite`\n    86\t  // instance straight into `withTenant`.\n    87\t  globalDb.caissonTransactor = pg as unknown as Transactor;\n    88\t  return globalDb.caissonTransactor;\n    89\t}\n    90\t\n    91\t/**\n    92\t * Run `fn` tenant-scoped for `accountId` against the resolved platform DB (ADR-0005 fail-closed\n    93\t * RLS via `withTenant`). The ONE seam every `/dashboard` view reads through — never query the\n    94\t * pool/PGlite directly from a route.\n    95\t */\n    96\texport async function readScoped<T>(\n    97\t  accountId: string,\n    98\t  fn: (tx: TenantExecutor) => Promise<T>,\n    99\t): Promise<T> {\n   100\t  const db = await getDb();\n   101\t  return withTenant(db, accountId, fn);\n   102\t}\n","exit_code":0,"status":"completed"}}
