{
  "name": "@caisson/registry",
  "version": "0.0.26",
  "private": true,
  "description": "Registry SERVICE (commercial, ADR-0097): the CI index builder + gated publish + Cloudflare worker read-path (ADR-0021/0047). Re-exports the open @caisson/registry-schema contract.",
  "license": "LicenseRef-Caisson-Commercial",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./schema/index.ts",
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./build-index": {
      "bun": "./scripts/build-index.ts",
      "types": "./dist/scripts/build-index.d.ts",
      "default": "./dist/scripts/build-index.js"
    }
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint schema scripts worker",
    "test": "bun test ./schema ./scripts ./worker"
  },
  "dependencies": {
    "@caisson/license-verify": "workspace:*",
    "@caisson/pricebook": "workspace:*",
    "@caisson/registry-schema": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson/license-issue": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "wrangler": "4.119.0"
  }
}
