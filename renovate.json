{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Low-maintenance dependency updates: one monthly batch, non-major updates automerge on green CI, majors wait on the Dependency Dashboard, security fixes arrive any time.",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "timezone": "America/New_York",
  "schedule": ["* 0-6 1 * *"],
  "minimumReleaseAge": "7 days",
  "dependencyDashboard": true,
  "rangeStrategy": "replace",
  "commitMessagePrefix": "chore(deps):",
  "labels": ["dependencies"],
  "prConcurrentLimit": 3,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "packages/cli/templates/**"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-6 1 * *"],
    "automerge": true,
    "automergeType": "pr"
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "addLabels": ["security"]
  },
  "packageRules": [
    {
      "description": "Every non-major update shares one monthly branch and merges its PR when CI is green.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "monthly non-major updates",
      "groupSlug": "monthly-non-major",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Majors never merge on their own; approve them from the Dependency Dashboard.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "addLabels": ["major-bump"]
    },
    {
      "description": "Generator templates pin versions deliberately and are golden-file-tested; they move by hand with a golden re-record.",
      "matchFileNames": ["packages/cli/templates/**"],
      "enabled": false
    },
    {
      "description": "Never propose Python pre-releases for .python-version.",
      "matchManagers": ["pyenv"],
      "allowedVersions": "!/[ab]\\d*$|rc\\d*$/"
    },
    {
      "description": "typescript-eslint pins the typescript API dependency below 7. The tsc-native alias (npm:typescript@7) is matched by depName and stays free.",
      "matchDepNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    }
  ]
}
