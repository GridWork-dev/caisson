{
  "name": "@caisson/demo-registry",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "LicenseRef-Caisson-Commercial",
  "description": "A private cross-package component-demo registry: one Zod-typed catalog of every @caisson/ui, @caisson/ui-pro, and per-package ./ui surface, with sample data and a live demo renderer per entry. Never published; apps/admin's catalog reads it now, apps/site's /ui gallery repoints to it later. Kept out of the sold registry index.",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "bun test ./src"
  },
  "dependencies": {
    "@caisson/ai-meter": "workspace:*",
    "@caisson/audit-harness": "workspace:*",
    "@caisson/audit-worm": "workspace:*",
    "@caisson/license-issue": "workspace:*",
    "@caisson/local-store": "workspace:*",
    "@caisson/prompt-registry": "workspace:*",
    "@caisson/ui": "workspace:*",
    "@caisson/ui-pro": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@caisson/eslint-config": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
