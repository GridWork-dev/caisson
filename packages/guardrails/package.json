{
  "name": "@caisson-sh/guardrails",
  "version": "0.5.1",
  "description": "Content-safety layer: swappable Moderator port (local | provider | custom) + TS-native PII engine (mask / hash / reversible-tokenize via field-crypto) behind a fail-closed input/output guard.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "bun": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src",
    "eval": "bun test ./src/pii.eval.test.ts"
  },
  "dependencies": {
    "@caisson-sh/field-crypto": "workspace:*",
    "@caisson-sh/kernel": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson-sh/ai-evals": "workspace:*",
    "@caisson-sh/testing": "workspace:*",
    "@caisson-sh/tsconfig": "workspace:*",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
