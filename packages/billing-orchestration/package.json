{
  "name": "@caisson-sh/billing-orchestration",
  "version": "0.4.3",
  "description": "Billing orchestration: Stripe/Paddle/LemonSqueezy/Polar checkout drivers + provider->DomainBillingEvent parsers + dual-layer webhook idempotency. Raw-body signature verification lives in @caisson-sh/billing.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GridWork-dev/caisson.git",
    "directory": "packages/billing-orchestration"
  },
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "bun": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src",
    "test:live": "bun test ./live"
  },
  "dependencies": {
    "@caisson-sh/billing": "workspace:*",
    "@caisson-sh/kernel": "workspace:*",
    "@caisson-sh/tenancy-rls": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson-sh/testing": "workspace:*",
    "@caisson-sh/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
