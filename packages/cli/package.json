{
  "name": "@caisson-sh/cli",
  "version": "0.9.0",
  "description": "create-caisson generator: composes a tailored repo from the versioned module catalog; agent-drivable.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GridWork-dev/caisson.git",
    "directory": "packages/cli"
  },
  "bin": {
    "caisson": "./dist/caisson.js",
    "create-caisson": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "manifest.ts",
    "AGENTS.md",
    "CHANGELOG.md",
    "templates",
    "registry-index.json",
    "!dist/**/*.test.*",
    "!dist/**/*.stories.*",
    "!dist/**/__golden__",
    "!dist/**/__fixtures__",
    "!src/**/*.test.*",
    "!src/**/*.stories.*",
    "!src/**/__golden__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__"
  ],
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun run scripts/bundle-registry-index.ts && tscn -p tsconfig.json && tscn -p tsconfig.scripts.json && bun run scripts/add-shebang.ts",
    "lint": "oxlint src scripts",
    "test": "bun test --timeout 60000 ./src ./scripts"
  },
  "dependencies": {
    "@caisson-sh/ds-manifest": "workspace:*",
    "@caisson-sh/jobs": "workspace:*",
    "@caisson-sh/kernel": "workspace:*",
    "@caisson-sh/migrate": "workspace:*",
    "@caisson-sh/registry-schema": "workspace:*",
    "@caisson-sh/tenancy-rls": "workspace:*",
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson-sh/agent-trajectory": "workspace:*",
    "@caisson-sh/ai-config": "workspace:*",
    "@caisson-sh/auth": "workspace:*",
    "@caisson-sh/billing": "workspace:*",
    "@caisson-sh/credits": "workspace:*",
    "@caisson-sh/email": "workspace:*",
    "@caisson-sh/mcp-server": "workspace:*",
    "@caisson-sh/testing": "workspace:*",
    "@caisson-sh/tsconfig": "workspace:*",
    "@caisson-sh/ui": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
