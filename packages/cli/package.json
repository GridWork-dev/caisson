{
  "name": "@caisson/cli",
  "version": "0.7.4",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "create-caisson generator: composes a tailored repo from the versioned registry; agent-drivable; codegen-credit metered.",
  "engines": {
    "node": ">=20.12.0"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "create-caisson": "./dist/cli.js",
    "caisson": "./dist/caisson.js"
  },
  "files": [
    "dist",
    "templates",
    "migrations-bundle",
    "registry-index.json"
  ],
  "scripts": {
    "build": "bun run scripts/bundle-migrations.ts && bun run scripts/bundle-registry-index.ts && tscn -p tsconfig.json && tscn -p tsconfig.scripts.json && bun run scripts/add-shebang.ts",
    "lint": "eslint src scripts",
    "test": "bun test ./src ./scripts"
  },
  "dependencies": {
    "@caisson/ds-manifest": "workspace:*",
    "@caisson/jobs": "workspace:*",
    "@caisson/kernel": "workspace:*",
    "@caisson/migrate": "workspace:*",
    "@caisson/registry-schema": "workspace:*",
    "@caisson/tenancy-rls": "workspace:*",
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson/agent-trajectory": "workspace:*",
    "@caisson/ai-config": "workspace:*",
    "@caisson/auth": "workspace:*",
    "@caisson/billing": "workspace:*",
    "@caisson/credits": "workspace:*",
    "@caisson/email": "workspace:*",
    "@caisson/eslint-config": "workspace:*",
    "@caisson/mcp-server": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "@caisson/ui": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
