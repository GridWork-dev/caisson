{
  "name": "@caisson/cli",
  "version": "0.3.0",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "create-caisson generator: composes a tailored repo from the versioned registry; agent-drivable; codegen-credit metered.",
  "engines": {
    "node": ">=20.12.0"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "create-caisson": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "migrations-bundle"
  ],
  "scripts": {
    "build": "bun run scripts/bundle-migrations.ts && tsc -p tsconfig.json && tsc -p tsconfig.scripts.json && bun run scripts/add-shebang.ts",
    "lint": "eslint src scripts",
    "test": "bun test ./src ./scripts"
  },
  "dependencies": {
    "@caisson/kernel": "workspace:*",
    "@caisson/migrate": "workspace:*",
    "@caisson/registry-schema": "workspace:*",
    "@clack/prompts": "^1.7.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson/credits": "workspace:*",
    "@caisson/eslint-config": "workspace:*",
    "@caisson/tenancy-rls": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
