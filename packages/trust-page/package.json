{
  "name": "@caisson-sh/trust-page",
  "version": "0.3.6",
  "description": "Trust-page generator: a self-contained static HTML + JSON page, built from an evidence pack + its crosswalk rollup through allowlist-based redaction, that you host anywhere to show your own customers your compliance posture.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GridWork-dev/caisson.git",
    "directory": "packages/trust-page"
  },
  "files": [
    "dist",
    "src",
    "manifest.ts",
    "AGENTS.md",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/**/*.stories.*",
    "!dist/**/__golden__",
    "!dist/**/__fixtures__",
    "!src/**/*.test.*",
    "!src/**/*.stories.*",
    "!src/**/__golden__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__"
  ],
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson-sh/artifact-render": "workspace:*",
    "@caisson-sh/compliance-core": "workspace:*",
    "@caisson-sh/kernel": "workspace:*"
  },
  "devDependencies": {
    "@caisson-sh/testing": "workspace:*",
    "@caisson-sh/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
