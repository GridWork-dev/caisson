{
  "name": "@caisson/frameworks-pack",
  "version": "0.8.0",
  "type": "module",
  "license": "LicenseRef-Caisson-Commercial",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Compliance framework catalogs as config-as-code: the typed canonical-control model plus own-authored SOC2-TSC, HIPAA-Security, and EU-AI-Act control packs with crosswalk references to each framework's requirement ids.",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "bun": "./src/registry/control.ts",
      "types": "./dist/registry/control.d.ts",
      "default": "./dist/registry/control.js"
    },
    "./browser": {
      "bun": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "eslint src scripts",
    "test": "bun test --timeout 60000 ./src ./scripts"
  },
  "dependencies": {
    "@caisson/kernel": "workspace:*",
    "@caisson/oscal-spine": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson/eslint-config": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
