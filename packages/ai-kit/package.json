{
  "name": "@caisson-sh/ai-kit",
  "version": "0.6.5",
  "description": "AI Production Kit package: metered inference, streaming, and embeddings composing prompt-registry + ai-meter + guardrails + ai-config behind Vercel AI SDK v7.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GridWork-dev/caisson.git",
    "directory": "packages/ai-kit"
  },
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src",
    "test:live": "bun test ./live"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.17",
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/azure": "^4.0.11",
    "@ai-sdk/google": "^4.0.12",
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@ai-sdk/provider": "^4.0.3",
    "@caisson-sh/agent-trajectory": "workspace:*",
    "@caisson-sh/ai-config": "workspace:*",
    "@caisson-sh/ai-meter": "workspace:*",
    "@caisson-sh/credits": "workspace:*",
    "@caisson-sh/field-crypto": "workspace:*",
    "@caisson-sh/guardrails": "workspace:*",
    "@caisson-sh/jobs": "workspace:*",
    "@caisson-sh/kernel": "workspace:*",
    "@caisson-sh/prompt-registry": "workspace:*",
    "@caisson-sh/tenancy-rls": "workspace:*",
    "ai": "^7.0.22",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson-sh/ai-evals": "workspace:*",
    "@caisson-sh/cli": "workspace:*",
    "@caisson-sh/mcp-server": "workspace:*",
    "@caisson-sh/registry-schema": "workspace:*",
    "@caisson-sh/testing": "workspace:*",
    "@caisson-sh/tsconfig": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "msw": "^2.14.6",
    "typescript": "catalog:"
  }
}
