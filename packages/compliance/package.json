{
  "name": "@caisson-sh/compliance",
  "version": "2.0.1",
  "description": "Compliance evidence kit: tenant-scoped field crypto, a WORM audit chain, own-authored SOC2-TSC and HIPAA control packs, and a deterministic, signed control-to-evidence-pack generator.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GridWork-dev/caisson.git",
    "directory": "packages/compliance"
  },
  "files": [
    "dist",
    "src",
    "manifest.ts",
    "AGENTS.md",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/**/*.stories.*",
    "!dist/**/__golden__",
    "!dist/**/__fixtures__",
    "!src/**/*.test.*",
    "!src/**/*.stories.*",
    "!src/**/__golden__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__"
  ],
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson-sh/audit-worm": "workspace:*",
    "@caisson-sh/compliance-core": "workspace:*",
    "@caisson-sh/field-crypto": "workspace:*",
    "@caisson-sh/frameworks-pack": "workspace:*",
    "@caisson-sh/kernel": "workspace:*",
    "@caisson-sh/migrate": "workspace:*",
    "@caisson-sh/signing-primitive": "workspace:*",
    "@caisson-sh/tenancy-rls": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson-sh/testing": "workspace:*",
    "@caisson-sh/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
