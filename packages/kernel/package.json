{
  "name": "@caisson/kernel",
  "version": "0.8.0",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Governance kernel: typed config loader, the CaissonError model, security primitives (constant-time compare, SSRF guard), and the standards gate.",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "bun": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "bun": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./crypto": {
      "bun": "./src/crypto.ts",
      "types": "./dist/crypto.d.ts",
      "default": "./dist/crypto.js"
    },
    "./fetch": {
      "bun": "./src/fetch.ts",
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./audit-verify": {
      "bun": "./src/audit-verify.ts",
      "types": "./dist/audit-verify.d.ts",
      "default": "./dist/audit-verify.js"
    },
    "./redact": {
      "bun": "./src/redact.ts",
      "types": "./dist/redact.d.ts",
      "default": "./dist/redact.js"
    },
    "./evidence": {
      "bun": "./src/evidence/index.ts",
      "types": "./dist/evidence/index.d.ts",
      "default": "./dist/evidence/index.js"
    }
  },
  "bin": {
    "caisson-gate": "./src/gate.ts"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "eslint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson/eslint-config": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
