{
  "name": "@caisson/kernel",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Governance kernel: typed config loader, the CaissonError model (ADR-0019), security primitives, and the standards gate (ADR-0016).",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fetch": {
      "bun": "./src/fetch.ts",
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    }
  },
  "bin": {
    "caisson-gate": "./src/gate.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "bun test ./src"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@caisson/eslint-config": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "eslint": "^9.13.0",
    "typescript": "^5.6.0"
  }
}
