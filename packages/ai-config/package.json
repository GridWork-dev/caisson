{
  "name": "@caisson/ai-config",
  "version": "0.3.10",
  "description": "Provider-agnostic AI config resolver (OpenAI, Anthropic, Google, OpenRouter, local, Bedrock, Azure OpenAI, Ollama, Groq, Mistral, Together) + the app settings file.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson/kernel": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
