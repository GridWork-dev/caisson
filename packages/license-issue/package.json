{
  "name": "@caisson/license-issue",
  "version": "1.0.9",
  "private": true,
  "description": "Ed25519 offline-license issuer: the private counterpart to @caisson/license-verify. Holds the signing key behind a Signer port (default Ed25519Signer over a node:crypto PKCS8 env key; KMS is an un-wired seam) and mints signed license tokens by signing exactly canonicalize(parse(claims)) - the byte-identical payload @caisson/license-verify re-derives. Never published; the signing code lives only with the issuer service.",
  "license": "LicenseRef-Caisson-Commercial",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": "./src/ui/index.ts"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json && tscn -p tsconfig.ui.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson/kernel": "workspace:*",
    "@caisson/license-verify": "workspace:*"
  },
  "devDependencies": {
    "@caisson/registry-schema": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "@caisson/ui": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@caisson/ui": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@caisson/ui": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
