{
  "name": "@caisson-sh/auth",
  "version": "0.4.5",
  "description": "Provider-agnostic authentication: EdDSA-JWT account tokens, a session contract, and multi-user account membership over row-level security. better-auth is the reference session provider.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson-sh/kernel": "workspace:*",
    "@caisson-sh/tenancy-rls": "workspace:*"
  },
  "devDependencies": {
    "@caisson-sh/testing": "workspace:*",
    "@caisson-sh/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
