{
  "name": "@caisson-sh/mcp-server",
  "version": "1.0.0",
  "description": "MCP server for the Caisson module catalog: timing-safe Bearer auth, catalog read tools, catalog-validated project generation, and opt-in design-system, setup-coach, compliance-prompt and agent-run tools.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GridWork-dev/caisson.git",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson-sh/ai-config": "workspace:*",
    "@caisson-sh/ds-manifest": "workspace:*",
    "@caisson-sh/kernel": "workspace:*",
    "@caisson-sh/registry-schema": "workspace:*",
    "@caisson-sh/ui": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson-sh/auth": "workspace:*",
    "@caisson-sh/billing": "workspace:*",
    "@caisson-sh/billing-orchestration": "workspace:*",
    "@caisson-sh/credits": "workspace:*",
    "@caisson-sh/tenancy-rls": "workspace:*",
    "@caisson-sh/testing": "workspace:*",
    "@caisson-sh/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
