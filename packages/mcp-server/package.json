{
  "name": "@caisson/mcp-server",
  "version": "0.6.11",
  "description": "MCP server for the Caisson module catalog: timing-safe Bearer auth, catalog read tools, catalog-validated project generation, and opt-in design-system, setup-coach, compliance-prompt and agent-run tools.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson/ai-config": "workspace:*",
    "@caisson/ds-manifest": "workspace:*",
    "@caisson/kernel": "workspace:*",
    "@caisson/registry-schema": "workspace:*",
    "@caisson/ui": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson/auth": "workspace:*",
    "@caisson/billing": "workspace:*",
    "@caisson/billing-orchestration": "workspace:*",
    "@caisson/credits": "workspace:*",
    "@caisson/tenancy-rls": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
