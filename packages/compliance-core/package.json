{
  "name": "@caisson-sh/compliance-core",
  "version": "0.7.3",
  "description": "The compliance evidence engine: typed collectors and a deterministic canonical evidence-pack format and generator with flag-never-guess blocking, with the complete @caisson-sh/oscal-spine surface re-exported for compatibility.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GridWork-dev/caisson.git",
    "directory": "packages/compliance-core"
  },
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "bun": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson-sh/field-crypto": "workspace:*",
    "@caisson-sh/frameworks-pack": "workspace:*",
    "@caisson-sh/kernel": "workspace:*",
    "@caisson-sh/oscal-spine": "workspace:*",
    "@caisson-sh/risk-register": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson-sh/alerting": "workspace:*",
    "@caisson-sh/jobs": "workspace:*",
    "@caisson-sh/testing": "workspace:*",
    "@caisson-sh/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
