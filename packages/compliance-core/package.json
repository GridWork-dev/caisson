{
  "name": "@caisson/compliance-core",
  "version": "0.7.2",
  "description": "The compliance evidence engine: typed collectors and a deterministic canonical evidence-pack format and generator with flag-never-guess blocking, with the complete @caisson/oscal-spine surface re-exported for compatibility.",
  "license": "LicenseRef-Caisson-Commercial",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "bun": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson/field-crypto": "workspace:*",
    "@caisson/frameworks-pack": "workspace:*",
    "@caisson/kernel": "workspace:*",
    "@caisson/oscal-spine": "workspace:*",
    "@caisson/risk-register": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson/alerting": "workspace:*",
    "@caisson/jobs": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
