{
  "name": "@caisson/compliance-core",
  "version": "0.3.1",
  "type": "module",
  "license": "LicenseRef-Caisson-Commercial",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "description": "The compliance evidence engine: typed collectors, a deterministic canonical evidence-pack format and generator with flag-never-guess blocking, and OSCAL exports (assessment plan, assessment results, plan of action and milestones, XML round-trip).",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src scripts",
    "test": "bun test ./src ./scripts"
  },
  "dependencies": {
    "@caisson/field-crypto": "workspace:*",
    "@caisson/frameworks-pack": "workspace:*",
    "@caisson/kernel": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson/eslint-config": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
