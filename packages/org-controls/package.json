{
  "name": "@caisson/org-controls",
  "version": "0.3.6",
  "type": "module",
  "license": "LicenseRef-Caisson-Commercial",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Org & operator controls (commercial): WorkOS SSO sign-in, a Clerk session-verification driver, the owner-gated multi-user membership surface, and the cross-tenant admin-write RLS layer the operator control plane mutates through. The open @caisson/auth keeps buyer session resolution; @caisson/tenancy-rls keeps buyer tenant isolation.",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "bun": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "eslint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson/auth": "workspace:*",
    "@caisson/kernel": "workspace:*",
    "@caisson/tenancy-rls": "workspace:*",
    "@clerk/backend": "^3.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson/eslint-config": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
