    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "bun test ./src",
    "test:live": "bun test ./live"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1075.0",
    "@caisson/kernel": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@caisson/eslint-config": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "@caisson/tenancy-rls": "workspace:*",
    "eslint": "^9.13.0",
    "typescript": "^5.6.0"
  }
}
