{
  "name": "@caisson/field-crypto",
  "version": "1.1.0",
  "type": "module",
  "license": "LicenseRef-Caisson-Commercial",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Per-tenant authenticated field encryption: HKDF key derivation, AES-256-GCM, a versioned envelope, a Drizzle column type, and a pluggable FieldKeyProvider with a KMS seam.",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "bun": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "eslint src",
    "test": "bun test --timeout 60000 ./src",
    "test:live": "bun test ./live"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1075.0",
    "@azure/keyvault-keys": "^4",
    "@caisson/kernel": "workspace:*",
    "@google-cloud/kms": "^5.5.1",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson/eslint-config": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "@caisson/tenancy-rls": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
