{
  "name": "@caisson-sh/ui",
  "version": "0.6.8",
  "description": "Caisson design-system kit — a typed OKLCH token floor plus a consistent component recipe: Radix behavior + co-located CSS + data-* variants, shipped as framework-agnostic raw .tsx.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GridWork-dev/caisson.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src",
    "manifest.ts",
    "AGENTS.md",
    "CHANGELOG.md",
    "styles",
    "!dist/**/*.test.*",
    "!dist/**/*.stories.*",
    "!dist/**/__golden__",
    "!dist/**/__fixtures__",
    "!src/**/*.test.*",
    "!src/**/*.stories.*",
    "!src/**/__golden__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!dist/components"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "bun": "./src/tokens/index.ts",
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./theme": {
      "bun": "./src/theme/index.ts",
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*",
    "./styles/base.css": "./styles/base.css",
    "./styles/tokens.css": "./styles/tokens.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json && tscn -p tsconfig.scripts.json",
    "lint": "oxlint src scripts",
    "test": "bun test --timeout 60000 ./src ./scripts",
    "check:manifest": "bun run scripts/gen-manifest.ts --check",
    "gen:manifest": "bun run scripts/gen-manifest.ts",
    "gen:tokens": "bun run scripts/gen-tokens-css.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run"
  },
  "dependencies": {
    "radix-ui": "^1.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson-sh/ds-manifest": "workspace:*",
    "@caisson-sh/testing": "workspace:*",
    "@caisson-sh/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/builder-vite": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "eslint-plugin-storybook": "10.6.2",
    "lucide-react": "catalog:",
    "playwright": "1.62.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "10.6.2",
    "typescript": "catalog:",
    "vite": "8.2.4",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "lucide-react": "^1.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
