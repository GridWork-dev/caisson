{
  "name": "@caisson/ui",
  "version": "0.6.0",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Caisson design-system kit — a typed OKLCH token floor plus a consistent component recipe: Radix behavior + co-located CSS + data-* variants, shipped as framework-agnostic raw .tsx.",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "bun": "./src/tokens/index.ts",
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./theme": {
      "bun": "./src/theme/index.ts",
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*",
    "./styles/base.css": "./styles/base.css",
    "./styles/tokens.css": "./styles/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "bun test ./src",
    "gen:tokens": "bun run scripts/gen-tokens-css.ts"
  },
  "dependencies": {
    "radix-ui": "^1.6.0",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "lucide-react": "^1.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@caisson/eslint-config": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "@types/culori": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "culori": "catalog:",
    "eslint": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
