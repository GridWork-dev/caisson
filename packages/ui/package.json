{
  "name": "@caisson/ui",
  "version": "0.6.4",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Caisson design-system kit — a typed OKLCH token floor plus a consistent component recipe: Radix behavior + co-located CSS + data-* variants, shipped as framework-agnostic raw .tsx.",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "bun": "./src/tokens/index.ts",
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./theme": {
      "bun": "./src/theme/index.ts",
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*",
    "./styles/base.css": "./styles/base.css",
    "./styles/tokens.css": "./styles/tokens.css"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json && tscn -p tsconfig.scripts.json",
    "lint": "eslint src scripts",
    "test": "bun test --timeout 60000 ./src ./scripts",
    "check:manifest": "bun run scripts/gen-manifest.ts --check",
    "gen:manifest": "bun run scripts/gen-manifest.ts",
    "gen:tokens": "bun run scripts/gen-tokens-css.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run"
  },
  "dependencies": {
    "radix-ui": "^1.6.0",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "lucide-react": "^1.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@caisson/ds-manifest": "workspace:*",
    "@caisson/eslint-config": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "10.5.0",
    "@storybook/addon-docs": "10.5.0",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-vitest": "10.5.0",
    "@storybook/builder-vite": "10.5.0",
    "@storybook/react-vite": "10.5.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "catalog:",
    "eslint-plugin-storybook": "10.5.0",
    "lucide-react": "catalog:",
    "playwright": "1.62.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "10.5.0",
    "typescript": "catalog:",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
