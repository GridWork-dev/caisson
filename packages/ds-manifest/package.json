{
  "name": "@caisson-sh/ds-manifest",
  "version": "0.3.4",
  "description": "Shared data + analysis layer for the agent-ready design-system surface: a typed component-manifest schema, a reader for the committed base/pro manifests, and pure static-check functions (contrast, usage doctor) any of the CLI, MCP, and build-time generator fronts can import.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GridWork-dev/caisson.git",
    "directory": "packages/ds-manifest"
  },
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json && cp src/base-manifest.json dist/base-manifest.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "culori": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson-sh/testing": "workspace:*",
    "@caisson-sh/tsconfig": "workspace:*",
    "@types/culori": "catalog:",
    "typescript": "catalog:"
  }
}
