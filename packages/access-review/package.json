{
  "name": "@caisson/access-review",
  "version": "0.3.5",
  "description": "Audit-prep access-review campaigns: a WORM-logged, per-reviewee attested approve/revoke decision record over an imported membership snapshot, opened on a jobs-riding cadence and closed on completion or deadline.",
  "license": "LicenseRef-Caisson-Commercial",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson/jobs": "workspace:*",
    "@caisson/kernel": "workspace:*",
    "@caisson/tenancy-rls": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson/audit-worm": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
