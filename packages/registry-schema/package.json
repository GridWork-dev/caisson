{
  "name": "@caisson/registry-schema",
  "version": "0.5.9",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Open registry contract (Apache-2.0): module-manifest schema + index schema + allowlist helpers + feature-tags + entitlement-expansion. zod/fs-only. The commercial @caisson/registry service re-exports this.",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "eslint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson/eslint-config": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
