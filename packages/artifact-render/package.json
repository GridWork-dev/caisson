{
  "name": "@caisson/artifact-render",
  "version": "0.2.1",
  "type": "module",
  "license": "LicenseRef-Caisson-Commercial",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Shared render primitive for buyer-facing compliance artifacts: a readiness-language claim filter, allowlist-based field redaction, and citation-row rendering — the seam the ISO 27001 SoA generator and the buyer trust-page generator both render through.",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "eslint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson/kernel": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson/eslint-config": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
