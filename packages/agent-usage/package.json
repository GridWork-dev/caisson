{
  "name": "@caisson/agent-usage",
  "version": "0.2.9",
  "type": "module",
  "license": "LicenseRef-Caisson-Commercial",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Usage adapters for the agent-trajectory contract: a Codex rollout scanner (the honesty-gated stateful reader) and price normalization that upgrades adapter-estimated model.usage events to pricebook-computed priced credits via a dated-model-id alias map.",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "eslint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson/agent-trajectory": "workspace:*",
    "@caisson/ai-meter": "workspace:*",
    "@caisson/kernel": "workspace:*"
  },
  "devDependencies": {
    "@caisson/eslint-config": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
