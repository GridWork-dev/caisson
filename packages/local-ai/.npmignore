# @caisson/local-ai — published-tarball excludes (the on-device ONNX model cache).
#
# The local embedding model is FIRST-RUN-FETCHED + cached at runtime (OnnxEmbeddingBackend), never
# shipped in the package. These globs keep any downloaded model cache, ONNX weights, or runtime
# artifacts out of the published tarball — wherever the deployer points `cacheDir`, plus the common
# in-package cache locations.
.cache/
models/
**/*.onnx
**/*.onnx_data
**/*.bin
**/*.safetensors

# Tests, golden fixtures, and build intermediates (only dist/ + the published src ship).
**/*.test.ts
**/*.integration.test.ts
**/__golden__/
*.tsbuildinfo
