{
  "name": "@caisson-sh/agent-dev",
  "version": "0.6.10",
  "description": "Agentic-Dev package: the composition of the governed engine-neutral agent kernel + local hybrid memory + a thin multi-harness emitter. Composes base seams down-only — no vendor SDK, no LLM call, no harness substrate.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GridWork-dev/caisson.git",
    "directory": "packages/agent-dev"
  },
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson-sh/agent-kernel": "workspace:*",
    "@caisson-sh/agent-runner": "workspace:*",
    "@caisson-sh/ai-config": "workspace:*",
    "@caisson-sh/kernel": "workspace:*",
    "@caisson-sh/local-store": "workspace:*",
    "@caisson-sh/tool-exec": "workspace:*"
  },
  "devDependencies": {
    "@caisson-sh/testing": "workspace:*",
    "@caisson-sh/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
