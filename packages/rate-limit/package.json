{
  "name": "@caisson-sh/rate-limit",
  "version": "0.2.2",
  "description": "Shared abuse-throttle primitives: an in-memory per-IP token-bucket limiter for unauthenticated surfaces, and a Postgres-backed per-account token-bucket store for authenticated ones.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GridWork-dev/caisson.git",
    "directory": "packages/rate-limit"
  },
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson-sh/kernel": "workspace:*",
    "@caisson-sh/mcp-server": "workspace:*",
    "@caisson-sh/tenancy-rls": "workspace:*"
  },
  "devDependencies": {
    "@caisson-sh/registry-schema": "workspace:*",
    "@caisson-sh/testing": "workspace:*",
    "@caisson-sh/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
