{
  "name": "@caisson-sh/oscal-spine",
  "version": "0.2.4",
  "description": "The complete Caisson OSCAL surface: deterministic assessment-plan, assessment-results, POA&M, catalog, XML, and ISO 27001 SoA exports plus the pinned NIST 800-53 catalog and OLIR relationship mapping.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GridWork-dev/caisson.git",
    "directory": "packages/oscal-spine"
  },
  "files": [
    "dist",
    "src",
    "manifest.ts",
    "AGENTS.md",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/**/*.stories.*",
    "!dist/**/__golden__",
    "!dist/**/__fixtures__",
    "!src/**/*.test.*",
    "!src/**/*.stories.*",
    "!src/**/__golden__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__"
  ],
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "bun": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src scripts",
    "test": "bun test --timeout 60000 ./src ./scripts"
  },
  "dependencies": {
    "@caisson-sh/artifact-render": "workspace:*",
    "@caisson-sh/kernel": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson-sh/testing": "workspace:*",
    "@caisson-sh/tsconfig": "workspace:*",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
