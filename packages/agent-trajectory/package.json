{
  "name": "@caisson-sh/agent-trajectory",
  "version": "0.6.3",
  "description": "Engine-neutral trajectory contract: an append-only, replayable event log (runs, steps, model calls, tool proposals/approvals, usage, checkpoints) with digest-ref payload discipline — the observation substrate the governed agent runtime records into.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GridWork-dev/caisson.git",
    "directory": "packages/agent-trajectory"
  },
  "files": [
    "dist",
    "src",
    "manifest.ts",
    "AGENTS.md",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/**/*.stories.*",
    "!dist/**/__golden__",
    "!dist/**/__fixtures__",
    "!src/**/*.test.*",
    "!src/**/*.stories.*",
    "!src/**/__golden__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__"
  ],
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "bun": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./usage": {
      "bun": "./src/usage/index.ts",
      "types": "./dist/usage/index.d.ts",
      "default": "./dist/usage/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson-sh/ai-meter": "workspace:*",
    "@caisson-sh/field-crypto": "workspace:*",
    "@caisson-sh/kernel": "workspace:*",
    "@caisson-sh/tenancy-rls": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson-sh/testing": "workspace:*",
    "@caisson-sh/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
