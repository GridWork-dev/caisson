{
  "name": "@caisson/retention-runner",
  "version": "0.2.2",
  "description": "CCPA/GDPR right-to-erasure runner: pluggable multi-store erasure (object-storage purge, cascade DB delete, orphan sweep) with per-target error isolation and a reason-tagged audit row, scheduled via @caisson/jobs.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "bun": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test --timeout 60000 ./src"
  },
  "dependencies": {
    "@caisson/jobs": "workspace:*",
    "@caisson/kernel": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
