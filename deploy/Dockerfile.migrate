# caisson-migrate — finite Cloud Run Job image. The locked infrastructure contract exposes one
# singleton job, so this image owns both forward-only schema entrypoints in fail-fast order.
FROM oven/bun:1.4.2-slim@sha256:cb3bbbb08e13a4a2ff400f24c7a2a1d5efa83f6ef8544d52d95a519631e2fc61
# R333: patch fixable OS CVEs while retaining the audited base digest.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Both migration entrypoints import workspace packages from source. Keep the full reviewed tree and
# the frozen dependency graph; no standalone web runtime is used and no credentials enter the build.
COPY . .
RUN bun install --frozen-lockfile

ENV NODE_ENV=production
USER bun
CMD ["bun", "deploy/migrate.ts"]
