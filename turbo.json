{
  "$schema": "https://turbo.build/schema.json",
  "cacheMaxAge": "2w",
  "cacheMaxSize": "1GB",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "registry-index.json",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {},
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "test:e2e": { "dependsOn": ["build"], "cache": false },
    "test:live": { "cache": false },
    "eval": {}
  }
}
