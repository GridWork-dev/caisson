# services/intel — env template. Copy to .env (gitignored) on the deploy host; docker-compose.yml
# reads it via env_file. NEVER commit real values — placeholders only. Every var is documented in
# README.md; this file mirrors that list without prose.

# ── required ─────────────────────────────────────────────────────────────────────────────────
INTEL_DATABASE_URL=postgres://intel_role:REPLACE_ME@REPLACE_ME.railway.app:5432/railway

# ── ops ──────────────────────────────────────────────────────────────────────────────────────
INTEL_HEALTHZ_PORT=8791
# 0.0.0.0 is required IN-CONTAINER (config.ts's own default is 127.0.0.1 for a bare local run) —
# this is the compose env, so it must stay explicit.
INTEL_HEALTHZ_HOST=0.0.0.0
INTEL_SCHEDULER_ENABLED=true
# Leave this false/unset in production — the runtime role (provision-role.sql) is DML-only and
# can't run the schema DDL migrate() issues. Applying the migration is an operator step (see
# README.md "Deploying"), not a boot step. true is a local/dev convenience only.
INTEL_MIGRATE_ON_BOOT=false

# ── cadences (ms; defaults shown — omit to use them) ────────────────────────────────────────
# INTEL_CADENCE_COMPLIANCE_MS=86400000
# INTEL_CADENCE_SOC2_MS=2592000000
# INTEL_CADENCE_COMPETITOR_MS=86400000
# INTEL_CADENCE_GITHUB_MS=43200000
# INTEL_CADENCE_ANALYTICS_MS=86400000
# INTEL_CADENCE_ERROR_MS=900000

# ── sources (optional — absent legs self-skip) ──────────────────────────────────────────────
INTEL_COMPETITOR_URLS=https://competitor-a.example.com/pricing,https://competitor-b.example.com/changelog
INTEL_GITHUB_ORG=caisson-sh
GITHUB_TOKEN=REPLACE_ME

POSTHOG_API_KEY=REPLACE_ME
POSTHOG_API_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=493539

PLAUSIBLE_API_KEY=REPLACE_ME
PLAUSIBLE_API_HOST=https://plausible.io
PLAUSIBLE_SITE_ID=caisson.sh

TG_BRIDGE_ALERT_URL=http://<redacted-ip>:PORT/alert
TG_BRIDGE_ALERT_TOKEN=REPLACE_ME

LINEAR_API_KEY=REPLACE_ME
LINEAR_TEAM_ID=REPLACE_ME

# ── alerting policy ──────────────────────────────────────────────────────────────────────────
# INTEL_ALERT_RATE_MAX_PER_WINDOW=3
# INTEL_ALERT_TZ=UTC
# INTEL_ALERT_QUIET_START=0
# INTEL_ALERT_QUIET_END=0

# ── LLM enrichment seam (off by default) ────────────────────────────────────────────────────
INTEL_LLM_ENABLED=false
OPENROUTER_API_KEY=REPLACE_ME
# INTEL_LLM_MODEL=anthropic/claude-3.5-haiku

# ── observability (optional) ────────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
