#!/usr/bin/env bash
# caisson pre-push — optional local Greptile review of the outgoing branch (advisory;
# never blocks the push). Skips cleanly when greptile is absent or not signed in, so CI
# and fresh clones are unaffected. The GitHub app still reviews the opened PR regardless.
# Opt out: `GREPTILE_PREPUSH=0 git push`  or  `git push --no-verify`.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

[ "${GREPTILE_PREPUSH:-1}" = "0" ] && exit 0
command -v greptile >/dev/null 2>&1 || exit 0

# pre-push receives "<localref> <localsha> <remoteref> <remotesha>" lines on stdin.
# Skip branch-deletes (all-zero local sha) and pushes that carry nothing new.
have_work=0
while read -r _localref localsha _remoteref _remotesha; do
  case "$localsha" in "" | 0000000000000000000000000000000000000000) continue ;; esac
  have_work=1
done
[ "$have_work" = "1" ] || exit 0

# Needs auth; degrade to a one-line hint rather than block. Prefer an exit-code signal over scraping a
# localized message. A GREPTILE_API_KEY in the env authenticates directly; otherwise a non-zero
# `whoami` means logged out. (greptile 3.1.1 `whoami` exits 0 even when logged out, so the advisory
# review below self-skips on a real auth miss — `|| true` keeps the push non-blocking either way.)
if [ -z "${GREPTILE_API_KEY:-}" ] && ! greptile whoami >/dev/null 2>&1; then
  echo "pre-push: greptile not signed in - skipping review (run: greptile login --api-key)" >&2
  exit 0
fi

# Review against the branch's upstream tracking base (strip the remote prefix), not a hard-coded main —
# a branch tracking a non-main upstream gets the right diff. Fall back to main when no upstream is set.
upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
base="${upstream#*/}"
[ -n "$base" ] || base="main"

echo "pre-push: greptile review (advisory; GREPTILE_PREPUSH=0 or --no-verify to skip)..." >&2
if command -v timeout >/dev/null 2>&1; then
  timeout 180 greptile review --agent -b "$base" || true
else
  greptile review --agent -b "$base" || true
fi
exit 0
