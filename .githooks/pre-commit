#!/usr/bin/env bash
# stack pre-commit — fast slice of the CI `check` gate: prettier + eslint on staged
# files, then a project-wide tsc. The slow golden-file / testcontainers matrices stay
# CI-only (see .github/workflows/ci.yml). Bypass with: git commit --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

mapfile -d '' staged < <(git diff --cached --name-only --diff-filter=ACM -z)
[ ${#staged[@]} -eq 0 ] && exit 0

# Prettier on understood staged files (no-op until tooling/ is wired).
fmt=()
for f in "${staged[@]}"; do
  case "$f" in *.ts | *.tsx | *.js | *.mjs | *.json | *.md | *.css)
    [ -f "$f" ] && fmt+=("$f") ;;
  esac
done
if [ ${#fmt[@]} -gt 0 ] && command -v bunx >/dev/null 2>&1; then
  bunx prettier --check "${fmt[@]}" 2>/dev/null || {
    echo "pre-commit: prettier check failed (run: bunx prettier --write)"; exit 1; }
fi

# eslint + tsc run once packages have code + tooling/ is wired; guarded until then.
if [ -f tooling/eslint-config/package.json ] && command -v bunx >/dev/null 2>&1 && \
   bunx tsc --version >/dev/null 2>&1; then
  ts=(); for f in "${fmt[@]}"; do case "$f" in *.ts|*.tsx) ts+=("$f");; esac; done
  [ ${#ts[@]} -gt 0 ] && bunx tsc --noEmit 2>/dev/null || true
fi
exit 0
