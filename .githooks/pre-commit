#!/usr/bin/env bash
# stack pre-commit — fast slice of the CI `check` gate: oxfmt on staged files, then a
# project-wide tsc. The slow golden-file / testcontainers matrices stay
# CI-only (see .github/workflows/ci.yml). Bypass with: git commit --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

mapfile -d '' staged < <(git diff --cached --name-only --diff-filter=ACM -z)
[ ${#staged[@]} -eq 0 ] && exit 0

# oxfmt on understood staged files (ADR-0408; was prettier).
fmt=()
for f in "${staged[@]}"; do
  case "$f" in *.ts | *.tsx | *.js | *.mjs | *.json | *.md | *.css)
    # skip symlinks (AGENTS.md -> CLAUDE.md): the formatter errors on them
    [ -f "$f" ] && [ ! -L "$f" ] && fmt+=("$f") ;;
  esac
done
if [ ${#fmt[@]} -gt 0 ] && [ -x node_modules/.bin/oxfmt ]; then
  node_modules/.bin/oxfmt --check --no-error-on-unmatched-pattern "${fmt[@]}" >/dev/null 2>&1 || {
    echo "pre-commit: oxfmt check failed (run: bun run format)"; exit 1; }
fi

# tsc runs once packages have code + tooling/ is wired; guarded until then.
if [ -f tooling/lint-policy/package.json ] && command -v bunx >/dev/null 2>&1 && \
   bunx tsc --version >/dev/null 2>&1; then
  ts=(); for f in "${fmt[@]}"; do case "$f" in *.ts|*.tsx) ts+=("$f");; esac; done
  [ ${#ts[@]} -gt 0 ] && bunx tsc --noEmit 2>/dev/null || true
fi
exit 0
