node_modules/
dist/
.turbo/
mirror-out/
.next/
*.tsbuildinfo

# CLI compose-time migration bundle (ADR-0091): a BUILD ARTIFACT regenerated from each module's
# canonical src/migrations/ by packages/cli/scripts/bundle-migrations.ts — never hand-edited, never
# committed (the source packages stay the single source of truth).
packages/cli/migrations-bundle/

# CLI registry-index snapshot: a BUILD ARTIFACT copied from registry/index.json by
# packages/cli/scripts/bundle-registry-index.ts so a published install ships a usable snapshot
# (delivery-path fix G3) — never hand-edited, never committed (registry/index.json stays the
# single source of truth, ADR-0047).
packages/cli/registry-index.json
.env
.env.*
!.env.example
coverage/
.DS_Store

# gw session-stream telemetry (hook-generated, not source)
outputs/streams/

# registry/index.json IS tracked (ADR-0047): it must be committed so the CI registry-index job can
# `git diff --exit-code` a fresh rebuild against it and fail on drift. "Never hand-edited" is
# enforced by that byte-identical check + CODEOWNERS — NOT by gitignoring it (which would hide drift).

# local design / test artifacts + hook session logs
.playwright-mcp/
studio-*.png
docs/session-logs/

# Local verification artifacts (screenshots, playwright output)
/*.png
/*.jpeg
.playwright-mcp/
# visual-harness run output (scripts/visual-harness.ts — local tool, never committed)
outputs/visual-audit/
outputs/screenshots/
# W1 remediation review/proof screenshots (session-local, never committed)
outputs/w1-proof/
outputs/review-g1/
# Agent-driven Codex Browser audit evidence (screenshots, journals, reports, candidates).
# Runs are local/advisory and may contain production state; only schemas/rubrics are tracked.
outputs/browser-audit/

# ADR-0223: CI-only tarball staging for R2 upload (never committed)
registry/.tarball-staging/

# ADR-0275 CI build-evidence pack output (assembled fresh each run, uploaded as an artifact)
evidence-pack/
outputs/w3-proof/

# security tooling (tools/security/*) — local scan artifacts + throwaway admin-harness state +
# OpenAPI specs regenerated fresh from Zod on every schemathesis run (never a stale committed copy)
.security-out/
apps/admin/.harness/
tools/security/openapi/
