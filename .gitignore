# CLI registry-index snapshot: a BUILD ARTIFACT copied from registry/index.json by
# packages/cli/scripts/bundle-registry-index.ts so a published install ships a usable snapshot
# (delivery-path fix G3) — never hand-edited, never committed (registry/index.json stays the
# single source of truth, ADR-0047).
packages/cli/registry-index.json

# Docs retrieval index: versioned/checksummed build output, rebuilt by services/docs build:index.
services/docs/artifact/
.env
.env.*
!.env.example
coverage/
.DS_Store

# gw session-stream telemetry (hook-generated, not source)
outputs/streams/

# graphify knowledge-graph build output (Kickoff T task 16 — served by the graphify MCP from the
# MAIN checkout; regenerated on demand, never committed)
graphify-out/

# registry/index.json IS tracked (ADR-0047): it must be committed so the CI registry-index job can
# `git diff --exit-code` a fresh rebuild against it and fail on drift. "Never hand-edited" is
# enforced by that byte-identical check + CODEOWNERS — NOT by gitignoring it (which would hide drift).

