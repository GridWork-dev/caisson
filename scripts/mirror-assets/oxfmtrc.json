{
  // The public mirror's formatter config (ADR-0409) — copied verbatim into the export by
  // export-public-mirror.ts. It MUST ship: the exporter formats the tree with the source repo's
  // oxfmt at these settings, and the mirror's own CI then runs `oxfmt --check .`. Without this
  // file the mirror would check at oxfmt's wider default width against a tree written at 80 and
  // fail on every file. Kept in step with the root .oxfmtrc.json by export-public-mirror.test.ts.
  "ignorePatterns": [
    "**/*.mdx",
    "**/*.html",
    "**/*.htm",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "**/*.graphql",
    "**/*.gql",
    "**/*.vue",
    "**/*.svelte",
    "**/*.hbs"
  ],
  "printWidth": 80,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "proseWrap": "preserve",
  "endOfLine": "lf"
}
