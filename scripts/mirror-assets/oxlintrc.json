{
  // The public mirror's lint config (ADR-0408) — copied verbatim into the export by
  // export-public-mirror.ts (MIRROR_ASSET_FILES), same mechanism as README/CONTRIBUTING.
  //
  // DERIVED, NOT DUPLICATED: the rule floor below is the source repo's root .oxlintrc.json with
  // the overrides whose targets do not ship stripped — no packages/ui means no caisson-slop scope
  // and no stories, no packages/ai-kit means no provider-SDK exemption. The provider-SDK denylist
  // itself is kept in full: a base package reaching an SDK directly is exactly as wrong in the
  // mirror. export-public-mirror.test.ts pins that this file's `rules` still match the root's.
  "plugins": ["eslint", "typescript", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "eslint/no-console": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-require-imports": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "openai",
              "openai/*",
              "@azure/openai",
              "@azure/openai/*",
              "@anthropic-ai/sdk",
              "@anthropic-ai/sdk/*",
              "@anthropic-ai/bedrock",
              "@anthropic-ai/bedrock/*",
              "@anthropic-ai/vertex-sdk",
              "@anthropic-ai/vertex-sdk/*",
              "@google/genai",
              "@google/genai/*",
              "@google/generative-ai",
              "@google/generative-ai/*",
              "@aws-sdk/client-bedrock-runtime",
              "@aws-sdk/client-bedrock-runtime/*",
              "@mistralai/mistralai",
              "@mistralai/mistralai/*",
              "cohere-ai",
              "cohere-ai/*",
              "groq-sdk",
              "groq-sdk/*",
              "replicate",
              "replicate/*",
              "together-ai",
              "together-ai/*",
              "ollama",
              "ollama/*",
              "ai",
              "ai/*",
              "@ai-sdk/openai",
              "@ai-sdk/openai/*",
              "@ai-sdk/openai-compatible",
              "@ai-sdk/openai-compatible/*",
              "@ai-sdk/anthropic",
              "@ai-sdk/anthropic/*",
              "@ai-sdk/google",
              "@ai-sdk/google/*",
              "@ai-sdk/openrouter",
              "@ai-sdk/openrouter/*",
              "@ai-sdk/amazon-bedrock",
              "@ai-sdk/amazon-bedrock/*",
              "@ai-sdk/azure",
              "@ai-sdk/azure/*"
            ],
            "message": "Provider SDKs may only be imported by @caisson/ai-config and @caisson/ai-kit (ADR-0011). Route inference through @caisson/ai-config. (dependency-cruiser backstops dynamic/transitive imports.)"
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.turbo/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/out/**",
    "**/.source/**",
    "**/coverage/**",
    "**/.venv/**",
    "**/.pytest_cache/**",
    "**/*.d.ts",
    "**/*.cjs",
    "**/__fixtures__/**",
    "**/migrations/**",
    "**/__golden__/**"
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.integration.test.ts"],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      "files": [
        "**/gate.ts",
        "**/bin/**",
        "**/*.cli.ts",
        "**/scripts/**",
        "tooling/scripts/**",
        "registry/scripts/**"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      "files": ["**/*.tsx", "**/*.jsx"],
      "rules": {
        "jsx-a11y/alt-text": "warn",
        "jsx-a11y/anchor-has-content": "warn",
        "jsx-a11y/anchor-is-valid": "warn",
        "jsx-a11y/aria-activedescendant-has-tabindex": "warn",
        "jsx-a11y/aria-props": "warn",
        "jsx-a11y/aria-proptypes": "warn",
        "jsx-a11y/aria-role": "warn",
        "jsx-a11y/aria-unsupported-elements": "warn",
        "jsx-a11y/autocomplete-valid": "warn",
        "jsx-a11y/click-events-have-key-events": "warn",
        "jsx-a11y/heading-has-content": "warn",
        "jsx-a11y/html-has-lang": "warn",
        "jsx-a11y/iframe-has-title": "warn",
        "jsx-a11y/img-redundant-alt": "warn",
        "jsx-a11y/interactive-supports-focus": "warn",
        "jsx-a11y/label-has-associated-control": "warn",
        "jsx-a11y/media-has-caption": "warn",
        "jsx-a11y/mouse-events-have-key-events": "warn",
        "jsx-a11y/no-access-key": "warn",
        "jsx-a11y/no-autofocus": "warn",
        "jsx-a11y/no-distracting-elements": "warn",
        "jsx-a11y/no-interactive-element-to-noninteractive-role": "warn",
        "jsx-a11y/no-noninteractive-element-interactions": "warn",
        "jsx-a11y/no-noninteractive-element-to-interactive-role": "warn",
        "jsx-a11y/no-noninteractive-tabindex": "warn",
        "jsx-a11y/no-redundant-roles": "warn",
        "jsx-a11y/no-static-element-interactions": "warn",
        "jsx-a11y/role-has-required-aria-props": "warn",
        "jsx-a11y/role-supports-aria-props": "warn",
        "jsx-a11y/scope": "warn",
        "jsx-a11y/tabindex-no-positive": "warn",
        "jsx-a11y/anchor-ambiguous-text": "off",
        "jsx-a11y/control-has-associated-label": "off",
        "jsx-a11y/lang": "off",
        "jsx-a11y/no-aria-hidden-on-focusable": "off",
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    }
  ]
}
