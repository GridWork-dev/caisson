# Build-context excludes for the services/docs image (its build context = the repo root).
# Keep dist/ (workspace deps may resolve to it); keep source dirs the corpus reads (apps/site/content,
# packages/**/README.md). Excludes below are runtime-irrelevant or heavy.
node_modules
**/node_modules
.git
.github
.turbo
**/.turbo
.next
**/.next
coverage
**/coverage
*.log
.DS_Store
graphify-out
outputs
.changeset
services/docs/artifact

# Secrets: every image below (site/admin/docs/license/support-bot) builds from this root context
# with `COPY . .` — a stray credential file must never bake into a published layer.
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
