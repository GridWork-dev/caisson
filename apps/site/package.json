  "type": "module",
  "scripts": {
    "dev": "next dev -p 3030",
    "build": "next build && cp -R ../demos/out out/demos",
    "lint": "oxlint .",
    "typecheck": "fumadocs-mdx && next typegen && tscn -p tsconfig.json",
    "test": "fumadocs-mdx && bun test --timeout 60000 ./lib ./emails ./components ./app ./scripts",
    "test:e2e": "bun test ./e2e",
    "test:live": "bun test ./live",
    "remotion:render": "node node_modules/.bin/remotion render remotion/index.ts AuditWormDemo public/videos/audit-worm-demo.mp4 --codec=h264"
  },
