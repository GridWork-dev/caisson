    "@caisson-sh/email": "workspace:*",
    "@caisson-sh/kernel": "workspace:*",
    "@caisson-sh/local-store": "workspace:*",
    "@caisson-sh/prompt-registry": "workspace:*",
    "@caisson-sh/ui": "workspace:*",
    "@caisson-sh/ui-pro": "workspace:*",
    "@orama/orama": "^3.1.18",
    "@plausible-analytics/tracker": "^0.4.6",
    "css-select": "^7.0.0",
    "css-tree": "^3.2.1",
    "culori": "catalog:",
    "domutils": "^4.0.2",
    "fumadocs-core": "^16.12.1",
    "fumadocs-mdx": "^15.0.13",
    "fumadocs-ui": "^16.12.1",
