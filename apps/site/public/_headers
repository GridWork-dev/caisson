# Response headers for the static export, applied by the Cloudflare Worker's asset handler.
# Pinned by lib/security-headers.test.ts (the /* block) and
# apps/demos/lib/security-headers.test.ts (the /demos/* block). ADR-0079 §5 Content-Signal is
# LOCKED: do not change its value.

/*
  Content-Signal: search=yes, ai-input=yes, ai-train=yes
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src 'self'; connect-src 'self'

# The demo zone (ADR-0400): a module page frames /demos/embed/<module> on this same origin.
# Cloudflare comma-joins a header set by two matching rules, so each override detaches the /*
# value first. frame-ancestors 'self' supersedes X-Frame-Options where both are present.
/demos/*
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'

# Extensionless exports. The asset handler infers Content-Type from the file extension, so these
# route-handler outputs need theirs named (nosniff above forbids the browser from guessing). One
# splat per rule, so per-route OG images use a placeholder for their directory.
/opengraph-image*
  Content-Type: image/png

/:section/opengraph-image*
  Content-Type: image/png

/apple-icon*
  Content-Type: image/png

/api/search
  Content-Type: application/json

# Content-hashed build output: a changed file gets a new name, so browsers may keep these for a
# year without revalidating. The asset handler's default is max-age=0, must-revalidate.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
