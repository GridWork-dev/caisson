{
  "ci": {
    "collect": {
      "staticDistDir": "out",
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1800 }],
        "interactive": ["warn", { "maxNumericValue": 3800 }],
        "uses-text-compression": ["warn", { "minScore": 0 }],
        "uses-responsive-images": ["warn", { "minScore": 0 }],
        "image-alt": ["warn", { "minScore": 1 }],
        "meta-description": ["warn", { "minScore": 1 }],
        "document-title": ["warn", { "minScore": 1 }],
        "html-has-lang": ["warn", { "minScore": 1 }],
        "canonical": ["warn", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
