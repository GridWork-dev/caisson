{
  "name": "@caisson/app-base",
  "version": "0.0.17",
  "private": true,
  "type": "module",
  "license": "LicenseRef-Caisson-Commercial",
  "description": "Framework-agnostic reference wiring the base packages over Bun.serve. App framework per edition is deferred.",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tscn -p tsconfig.json",
    "lint": "eslint src",
    "test": "bun test ./src"
  },
  "dependencies": {
    "@caisson/auth": "workspace:*",
    "@caisson/billing": "workspace:*",
    "@caisson/credits": "workspace:*",
    "@caisson/kernel": "workspace:*",
    "@caisson/mcp-server": "workspace:*",
    "@caisson/rate-limit": "workspace:*",
    "@caisson/tenancy-rls": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@caisson/billing-orchestration": "workspace:*",
    "@caisson/cli": "workspace:*",
    "@caisson/eslint-config": "workspace:*",
    "@caisson/registry": "workspace:*",
    "@caisson/testing": "workspace:*",
    "@caisson/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
